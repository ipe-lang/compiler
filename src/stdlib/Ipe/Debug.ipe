-- | Ipe.Debug — development-only escape hatches.
--
-- Every member of this module is rejected by `ipe release` (IPE-L0140).
-- Use `ipe dev build` or `ipe dev run` during development.
--
-- ## `log`
--
--     import Ipe.Debug as Debug
--
--     total =
--         Debug.log "subtotal" subtotal + tax
--
-- `log label value` prints `"label: value"` to stderr and returns `value`
-- unchanged. The value is rendered by the total debug stringifier (the one
-- behind `Error.toString`), so any non-function value renders.
--
-- ## `todo`
--
--     import Ipe.Debug as Debug
--
--     describeShape : Shape -> String
--     describeShape shape =
--         case shape of
--             Circle r ->
--                 "circle with radius " ++ String.fromFloat r
--
--             Rectangle _ _ ->
--                 Debug.todo "rectangle case not implemented yet"
--
-- `todo note` marks an unfinished code path. The module still compiles so
-- the finished branches can be run and tested. Reaching a `todo` at runtime
-- aborts with `TODO at <location>: <note>` on stderr and exits non-zero. A
-- `todo` in a `case` arm does NOT satisfy exhaustiveness — a `case` missing
-- an arm is still an error even if another arm contains a `todo`.
--
-- ## `explain`
--
--     import Ipe.Debug as Debug
--     import Ipe.Ui as Ui
--
--     view model =
--         Ui.column
--             [ Debug.explain ]
--             [ Ui.text "hello" ]
--
-- `explain` is an `Attribute msg` that draws visible outlines around the
-- element it is applied to and every descendant, making the invisible box
-- tree visible without changing layout. Distinct colours distinguish element
-- bounds from padding. Applies to the Web shape (served or webview-hosted).
module Ipe.Debug exposing
    ( log
    , todo
    , explain
    )


import Ipe.Ffi.Kernel as Kernel


-- | `log label value` — print `"label: value"` to stderr, return `value`.
-- The value is rendered by the total debug stringifier (the one behind
-- `Error.toString`), so any non-function value renders.
log : String -> a -> a
log = Kernel.kernel "Debug_log"


-- | `todo note` — mark an unfinished code path.
-- The module compiles; reaching this at runtime aborts with
-- `TODO at <location>: <note>` on stderr and a non-zero exit.
-- A `todo` in a `case` arm does NOT satisfy exhaustiveness.
todo : String -> a
todo = Kernel.kernel "Debug_todo"


-- | `explain` — draw visible outlines on an element and all its descendants.
-- Applies to the Web shape (served or webview-hosted). Does not change layout.
explain : Attribute msg
explain = Kernel.kernel "Debug_explain"
