-- | Ipe.Browser.Clipboard.Internals — the low-level clipboard port surface: the
-- closed outbound/inbound ADTs and the raw `Ipe.Ffi.Js` request/subscribe wiring the
-- high-level `Ipe.Browser.Clipboard` layer wraps.
--
-- Importing this submodule discloses the same `js-port:clipboard` axis as the
-- top-level module (the disclosure is keyed on the `Ipe.Browser.Clipboard` path
-- prefix), so the raw port surface cannot be reached undisclosed.
module Ipe.Browser.Clipboard.Internals exposing
    ( JsCmd(..)
    , JsMsg(..)
    , request
    , requestOne
    , subscribe
    , inbound
    )

import Ipe.Error as Error exposing (Error)
import Ipe.Ffi.Js as Js
import Ipe.Json.Decode as Decode
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub


-- | The ONE closed OUTBOUND port type. `WriteText text` requests a clipboard write;
-- `ReadText` requests the current clipboard contents.
type JsCmd
    = WriteText String
    | ReadText


-- | The NARROW closed INBOUND port type — NOT the app's internal `Msg`. Every
-- variant the browser can push is enumerated, so the fold in the high-level layer
-- is EXHAUSTIVE and a permission denial becomes a typed `Err`, never a silent drop.
--
--   * `Written` — a write completed.
--   * `Read text` — a read returned `text`.
--   * `Denied` — the host refused the clipboard permission.
--   * `Unavailable` — the Clipboard API is absent in this context.
type JsMsg
    = Written
    | Read String
    | Denied
    | Unavailable


-- | `request cmd` — hand a closed outbound `JsCmd` to the raw port transport. The
-- served first-party JS sink reaches `navigator.clipboard.*`; a read's result and
-- any denial arrive inbound as a `JsMsg`.
request : JsCmd -> Cmd.Cmd msg
request cmd =
    Js.send cmd


-- | `requestOne cmd` — correlated one-shot `JsCmd` → `Task Error JsMsg`.
-- Routes through `Js.request` with the `inbound` decoder so the correlated
-- reply is decoded fail-closed by the same gate the `subscribe` path uses.
requestOne : JsCmd -> Task Error JsMsg
requestOne cmd =
    Js.request cmd inbound


-- | `subscribe toMsg` — the inbound subscription over the fail-closed seal
-- decoder. `inbound` IS the security gate; a malformed / mismatched frame is
-- dropped whole.
subscribe : (JsMsg -> msg) -> Sub.Sub msg
subscribe toMsg =
    Js.subscribe inbound toMsg


-- | The total, fail-closed decoder for a `JsMsg` frame of this capability.
--
-- It first requires the frame's `tag` to be `portTag`, so a frame of another
-- capability, or an untagged one, fails closed; the rest decodes as `inboundBody`.
inbound : Decode.Decoder JsMsg
inbound =
    Decode.andThen (gateTag inboundBody) (Decode.field "tag" Decode.string)


-- | The frame body of the inbound `JsMsg`. It reads `ok` first: a
-- true flag decodes a `write` acknowledgement or a `read` result by its `event`;
-- a false flag decodes the closed `error` vocabulary into a denial variant. An
-- unrecognised token fails the decode closed (the frame is dropped).
inboundBody : Decode.Decoder JsMsg
inboundBody =
    Decode.andThen decodeByOk (Decode.field "ok" Decode.bool)


decodeByOk : Bool -> Decode.Decoder JsMsg
decodeByOk ok =
    if ok then
        Decode.andThen decodeEvent (Decode.field "event" Decode.string)

    else
        Decode.andThen decodeError (Decode.field "error" Decode.string)


decodeEvent : String -> Decode.Decoder JsMsg
decodeEvent event =
    case event of
        "write" ->
            Decode.succeed Written

        "read" ->
            Decode.map Read (Decode.field "text" Decode.string)

        _ ->
            Decode.fail ("unknown clipboard event: " ++ event)


decodeError : String -> Decode.Decoder JsMsg
decodeError token =
    case token of
        "denied" ->
            Decode.succeed Denied

        "unavailable" ->
            Decode.succeed Unavailable

        _ ->
            Decode.fail ("unknown clipboard error variant: " ++ token)


-- | This module's frame tag: its capability's `js-port:` wire name.
--
-- The first-party sink stamps it on every frame it replies with.
portTag : String
portTag =
    "clipboard"


-- | `gateTag body tag` runs `body` only on a frame tagged with this module's `portTag`.
--
-- A frame of any other capability fails closed; the failure names no tag.
gateTag : Decode.Decoder a -> String -> Decode.Decoder a
gateTag body tag =
    if tag == portTag then
        body

    else
        Decode.fail "frame for another capability"
