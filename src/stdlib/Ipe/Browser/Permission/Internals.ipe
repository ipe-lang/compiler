-- | Ipe.Browser.Permission.Internals — the low-level Permissions API port
-- surface: the closed outbound/inbound ADTs and the raw `Ipe.Ffi.Js`
-- request/subscribe wiring the high-level `Ipe.Browser.Permission` layer wraps.
--
-- Importing this submodule discloses the same `js-port:permission` axis as the
-- top-level module (the disclosure is keyed on the `Ipe.Browser.Permission` path
-- prefix), so the raw port surface cannot be reached undisclosed.
module Ipe.Browser.Permission.Internals exposing
    ( JsCmd(..)
    , JsMsg(..)
    , PermissionName(..)
    , request
    , requestOne
    , subscribe
    , subscribeFor
    , inbound
    , inboundFor
    , nameToken
    )

import Ipe.Error as Error exposing (Error)
import Ipe.Ffi.Js as Js
import Ipe.Json.Decode as Decode
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub


-- | The closed set of queryable permission names.
--
-- Each constructor maps to its W3C Permissions API name string; only the
-- Baseline-supported names are covered.
type PermissionName
    = Camera
    | Microphone
    | Geolocation
    | Notifications
    | PersistentStorage
    | ClipboardRead
    | ClipboardWrite
    | MidiSysex


-- | The ONE closed OUTBOUND port type.
--
--   * `Query name` — one-shot: query the current state of a single permission.
--   * `Watch name` — begin a continuous stream; each state change event
--     delivers a fresh reading on the inbound subscription.
type JsCmd
    = Query PermissionName
    | Watch PermissionName


-- | The NARROW closed INBOUND port type — NOT the app's internal `Msg`. Every
-- variant the browser can push is enumerated, so the fold in the high-level
-- layer is EXHAUSTIVE and a denial becomes a typed `Err`, never a silent drop.
--
--   * `StateGranted` — the permission is currently granted.
--   * `StateDenied` — the permission is currently denied; querying it again without a
--     user gesture yields the same result.
--   * `StatePrompt` — the browser will prompt the user on the next relevant API call.
--   * `StateUnavailable` — the Permissions API is absent in this context.
--
-- Variants are prefixed with `State` to avoid clashing with the public
-- `PermissionState` constructors (`Granted`, `Denied`, `Prompt`) in modules
-- that import both.
type JsMsg
    = StateGranted
    | StateDenied
    | StatePrompt
    | StateUnavailable


-- | `request cmd` — hand a closed outbound `JsCmd` to the raw port transport.
-- The served first-party JS sink reaches `navigator.permissions.query`; the
-- reply arrives inbound as a `JsMsg`.
request : JsCmd -> Cmd.Cmd msg
request cmd =
    Js.send cmd


-- | `requestOne cmd` — correlated one-shot `JsCmd` → `Task Error JsMsg`.
-- Routes through `Js.request` with the `inbound` decoder so the correlated
-- reply is decoded fail-closed by the same gate the `subscribe` path uses.
requestOne : JsCmd -> Task Error JsMsg
requestOne cmd =
    Js.request cmd inbound


-- | `subscribe toMsg` — the inbound subscription over the fail-closed seal
-- decoder. `inbound` IS the security gate; a malformed / mismatched frame is
-- dropped whole.
subscribe : (JsMsg -> msg) -> Sub.Sub msg
subscribe toMsg =
    Js.subscribe inbound toMsg


-- | `subscribeFor name toMsg` — the inbound subscription scoped to a SINGLE
-- permission. The gate is `inboundFor name`: a frame is decoded only when its
-- `name` field matches `name`'s canonical token; a frame for any OTHER
-- permission fails the decode closed and is dropped whole, exactly as a
-- malformed frame is. The subscription therefore delivers ONLY `name`'s change
-- frames — the per-name contract the signature advertises, enforced at the
-- trust boundary (parse-don't-validate), never by a downstream comparison a
-- caller could omit.
subscribeFor : PermissionName -> (JsMsg -> msg) -> Sub.Sub msg
subscribeFor name toMsg =
    Js.subscribe (inboundFor name) toMsg


-- | The canonical wire token for each permission name — the single source of
-- truth shared by the outbound request and the inbound frame's `name` field.
-- These are the W3C Permissions API `PermissionDescriptor.name` strings, so the
-- served first-party JS echoes the same token it received.
nameToken : PermissionName -> String
nameToken name =
    case name of
        Camera ->
            "camera"

        Microphone ->
            "microphone"

        Geolocation ->
            "geolocation"

        Notifications ->
            "notifications"

        PersistentStorage ->
            "persistent-storage"

        ClipboardRead ->
            "clipboard-read"

        ClipboardWrite ->
            "clipboard-write"

        MidiSysex ->
            "midi"


-- | The total, fail-closed decoder for a `JsMsg` frame of this capability.
--
-- It first requires the frame's `tag` to be `portTag`, so a frame of another
-- capability, or an untagged one, fails closed; the rest decodes as `inboundBody`.
inbound : Decode.Decoder JsMsg
inbound =
    Decode.andThen (gateTag inboundBody) (Decode.field "tag" Decode.string)


-- | The frame body of the inbound `JsMsg`. It reads the `ok`
-- flag: a true flag decodes a `state` string into the closed state vocabulary;
-- a false flag decodes the closed `error` vocabulary. An unrecognised token
-- fails the decode closed (the frame is dropped).
inboundBody : Decode.Decoder JsMsg
inboundBody =
    Decode.andThen decodeByOk (Decode.field "ok" Decode.bool)


-- | `inboundFor name` — the name-scoped variant of `inbound`.
--
-- It first requires the frame's `tag` to be `portTag`, then reads the frame's
-- `name` field and requires it to equal `name`'s canonical token; a mismatch
-- fails the decode closed, so a change frame for a DIFFERENT permission is
-- dropped rather than folded into this subscription. On a match the frame
-- decodes exactly as `inbound` does.
inboundFor : PermissionName -> Decode.Decoder JsMsg
inboundFor name =
    Decode.andThen (gateTag (Decode.andThen (gateName name) (Decode.field "name" Decode.string))) (Decode.field "tag" Decode.string)


gateName : PermissionName -> String -> Decode.Decoder JsMsg
gateName name token =
    if token == nameToken name then
        inboundBody

    else
        Decode.fail "permission change frame for another permission"


decodeByOk : Bool -> Decode.Decoder JsMsg
decodeByOk ok =
    if ok then
        Decode.andThen decodeState (Decode.field "state" Decode.string)

    else
        Decode.andThen decodeError (Decode.field "error" Decode.string)


decodeState : String -> Decode.Decoder JsMsg
decodeState state =
    case state of
        "granted" ->
            Decode.succeed StateGranted

        "denied" ->
            Decode.succeed StateDenied

        "prompt" ->
            Decode.succeed StatePrompt

        _ ->
            Decode.fail ("unknown permission state: " ++ state)


decodeError : String -> Decode.Decoder JsMsg
decodeError token =
    case token of
        "unavailable" ->
            Decode.succeed StateUnavailable

        _ ->
            Decode.fail ("unknown permission error variant: " ++ token)


-- | This module's frame tag: its capability's `js-port:` wire name.
--
-- The first-party sink stamps it on every frame it replies with.
portTag : String
portTag =
    "permission"


-- | `gateTag body tag` runs `body` only on a frame tagged with this module's `portTag`.
--
-- A frame of any other capability fails closed; the failure names no tag.
gateTag : Decode.Decoder a -> String -> Decode.Decoder a
gateTag body tag =
    if tag == portTag then
        body

    else
        Decode.fail "frame for another capability"
