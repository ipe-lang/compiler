-- | Ipe.Browser.WebAuthn.Internals — the low-level Web Authentication port
-- surface: the closed outbound/inbound ADTs and the raw `Ipe.Ffi.Js`
-- request/subscribe wiring the high-level `Ipe.Browser.WebAuthn` layer wraps.
--
-- Importing this submodule discloses the same `js-port:web-authn` axis as the
-- top-level module (the disclosure is keyed on the `Ipe.Browser.WebAuthn` path
-- prefix), so the raw port surface cannot be reached undisclosed.
--
-- Credential material never crosses this port as a readable structure. A
-- registration or an assertion returns an opaque, base64url-encoded envelope of
-- fields — never a plaintext key. The inbound decoder is total and fail-closed:
-- an unrecognised token, a `NotAllowedError`, or an absent API becomes a typed
-- inbound variant, never a silent-accept and never a throw.
module Ipe.Browser.WebAuthn.Internals exposing
    ( JsCmd(..)
    , JsMsg(..)
    , request
    , requestOne
    , subscribe
    , inbound
    )

import Ipe.Ffi.Js as Js
import Ipe.Json.Decode as Decode
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub


-- | The ONE closed OUTBOUND port type — the two ceremonies of Web
-- Authentication.
--
--   * `Create opts` — a registration ceremony: `navigator.credentials.create`
--     with `opts` as the `publicKey` creation options. `opts` carries the
--     relying party, the user, the base64url `challenge`, and the algorithm
--     preferences. A success returns an attestation envelope inbound; a host
--     refusal or an absent API traps to a typed inbound variant.
--   * `Get opts` — an authentication ceremony: `navigator.credentials.get`
--     with `opts` as the `publicKey` request options. `opts` carries the
--     base64url `challenge`, the relying-party id, and the allowed credential
--     ids. A success returns an assertion envelope inbound; a host refusal or
--     an absent API traps to a typed inbound variant.
--
-- Every buffer-shaped field (`challenge`, credential `id`) crosses as a
-- base64url `String`, never as raw bytes: the JS sink decodes it to an
-- `ArrayBuffer` at the boundary and re-encodes every returned buffer to
-- base64url, so no raw key material is ever representable in the port frame.
type JsCmd
    = Create
        { rpId : String
        , rpName : String
        , userId : String
        , userName : String
        , userDisplayName : String
        , challenge : String
        , algorithms : List Int
        , timeoutMs : Int
        , userVerification : String
        }
    | Get
        { rpId : String
        , challenge : String
        , allowCredentials : List String
        , timeoutMs : Int
        , userVerification : String
        }


-- | The NARROW closed INBOUND port type — deliberately NOT the app's internal
-- `Msg`. Every variant the ceremony can push is enumerated, so the fold in the
-- high-level layer is EXHAUSTIVE and a refusal, an absent API, or a malformed
-- ceremony can never be silently mis-mapped: each becomes a typed value.
--
--   * `Registered { id, rawId, clientDataJson, attestationObject }` — a
--     registration ceremony completed. Every field is a base64url `String`
--     envelope of an opaque buffer; the module NEVER exposes decoded key bytes.
--   * `Asserted { id, rawId, clientDataJson, authenticatorData, signature, userHandle }`
--     — an authentication ceremony completed. Every field is a base64url
--     `String` envelope; `userHandle` is `""` when the authenticator returned
--     none. The `signature` is opaque — the module carries it, never inspects it.
--   * `Denied` — the host refused the ceremony (`NotAllowedError`, a user
--     cancellation, or a security refusal). Terminal, fail-closed.
--   * `Unavailable` — the Web Authentication API is absent in this context (no
--     `navigator.credentials` or no `PublicKeyCredential`). Terminal.
type JsMsg
    = Registered
        { id : String
        , rawId : String
        , clientDataJson : String
        , attestationObject : String
        }
    | Asserted
        { id : String
        , rawId : String
        , clientDataJson : String
        , authenticatorData : String
        , signature : String
        , userHandle : String
        }
    | Denied
    | Unavailable


-- | `request cmd` — hand a closed outbound `JsCmd` to the raw port transport.
-- The served first-party JS sink runs the ceremony; its result arrives inbound
-- as a `JsMsg` frame on the `subscribe` path.
request : JsCmd -> Cmd.Cmd msg
request cmd =
    Js.send cmd


-- | `requestOne cmd` — correlated one-shot `JsCmd` → `Task Error JsMsg`. Routes
-- through `Js.request` with the `inbound` decoder so the correlated reply is
-- decoded fail-closed by the same gate the `subscribe` path uses. A ceremony is
-- one-shot by nature, so this is the primary path.
requestOne : JsCmd -> Task Error JsMsg
requestOne cmd =
    Js.request cmd inbound


-- | `subscribe toMsg` — the inbound subscription over the fail-closed seal
-- decoder. `inbound` IS the security gate; a malformed / mismatched frame is
-- dropped whole. A decoded `JsMsg` is handed to `toMsg`.
subscribe : (JsMsg -> msg) -> Sub.Sub msg
subscribe toMsg =
    Js.subscribe inbound toMsg


-- | The total, fail-closed decoder for a `JsMsg` frame of this capability.
--
-- It first requires the frame's `tag` to be `portTag`, so a frame of another
-- capability, or an untagged one, fails closed; the rest decodes as `inboundBody`.
inbound : Decode.Decoder JsMsg
inbound =
    Decode.andThen (gateTag inboundBody) (Decode.field "tag" Decode.string)


-- | The frame body of the inbound `JsMsg`. It reads `ok` first:
-- a true flag decodes a ceremony result by its `event`; a false flag decodes the
-- closed `error` vocabulary into a denial variant. An unrecognised token fails
-- the decode closed (the frame is dropped) — never a silent-accept.
inboundBody : Decode.Decoder JsMsg
inboundBody =
    Decode.andThen decodeByOk (Decode.field "ok" Decode.bool)


decodeByOk : Bool -> Decode.Decoder JsMsg
decodeByOk ok =
    if ok then
        Decode.andThen decodeEvent (Decode.field "event" Decode.string)

    else
        Decode.andThen decodeError (Decode.field "error" Decode.string)


decodeEvent : String -> Decode.Decoder JsMsg
decodeEvent event =
    case event of
        "registered" ->
            Decode.map4 registered
                (Decode.field "id" Decode.string)
                (Decode.field "rawId" Decode.string)
                (Decode.field "clientDataJson" Decode.string)
                (Decode.field "attestationObject" Decode.string)

        "asserted" ->
            decodeAsserted

        _ ->
            Decode.fail ("unknown web-authn event: " ++ event)


-- | Decode the six base64url fields of an assertion into an `Asserted`. Json
-- `Decode` exposes `map`..`map4` only, so the six fields are combined by
-- decoding the first four with `map4` and threading the remaining two through
-- `andThen` — a total composition, no partial decode.
decodeAsserted : Decode.Decoder JsMsg
decodeAsserted =
    Decode.map4 assertedHead
        (Decode.field "id" Decode.string)
        (Decode.field "rawId" Decode.string)
        (Decode.field "clientDataJson" Decode.string)
        (Decode.field "authenticatorData" Decode.string)
        |> Decode.andThen
            (\head ->
                Decode.map2 (assertedTail head)
                    (Decode.field "signature" Decode.string)
                    (Decode.field "userHandle" Decode.string)
            )


decodeError : String -> Decode.Decoder JsMsg
decodeError token =
    case token of
        "denied" ->
            Decode.succeed Denied

        "unavailable" ->
            Decode.succeed Unavailable

        _ ->
            Decode.fail ("unknown web-authn error variant: " ++ token)


registered : String -> String -> String -> String -> JsMsg
registered id rawId clientDataJson attestationObject =
    Registered
        { id = id
        , rawId = rawId
        , clientDataJson = clientDataJson
        , attestationObject = attestationObject
        }


-- | The first four assertion fields, gathered before the remaining two are
-- threaded in. A plain record so the `andThen` tail can complete the `Asserted`.
assertedHead :
    String
    -> String
    -> String
    -> String
    -> { id : String, rawId : String, clientDataJson : String, authenticatorData : String }
assertedHead id rawId clientDataJson authenticatorData =
    { id = id
    , rawId = rawId
    , clientDataJson = clientDataJson
    , authenticatorData = authenticatorData
    }


-- | Complete the `Asserted` value from the four gathered head fields plus the
-- `signature` and `userHandle` tail fields.
assertedTail :
    { id : String, rawId : String, clientDataJson : String, authenticatorData : String }
    -> String
    -> String
    -> JsMsg
assertedTail head signature userHandle =
    Asserted
        { id = head.id
        , rawId = head.rawId
        , clientDataJson = head.clientDataJson
        , authenticatorData = head.authenticatorData
        , signature = signature
        , userHandle = userHandle
        }


-- | This module's frame tag: its capability's `js-port:` wire name.
--
-- The first-party sink stamps it on every frame it replies with.
portTag : String
portTag =
    "web-authn"


-- | `gateTag body tag` runs `body` only on a frame tagged with this module's `portTag`.
--
-- A frame of any other capability fails closed; the failure names no tag.
gateTag : Decode.Decoder a -> String -> Decode.Decoder a
gateTag body tag =
    if tag == portTag then
        body

    else
        Decode.fail "frame for another capability"
