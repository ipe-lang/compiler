-- | Ipe.Uuid — UUID generation and parsing.
--
-- `v4` and `v7` draw fresh entropy on each call, so they return
-- `Task Error String` — the same effect tier as `Time.now ()`.
-- `parse` is pure: it validates an existing string without drawing
-- entropy and returns `Nothing` when the input is not a well-formed
-- UUID.
module Ipe.Uuid exposing
    ( v4, v7, parse
    )


import Ipe.Error exposing (Error)
import Ipe.Ffi.Kernel as Kernel


-- | `v4 ()` — generate a random UUID (version 4) as a canonical
-- lowercase hyphenated string (`xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx`).
-- Fails with an `Unavailable` error when the OS random source is unavailable.
v4 : () -> Task Error String
v4 = Kernel.kernel "Uuid_v4"


-- | `v7 ()` — generate a time-ordered UUID (version 7) as a canonical
-- lowercase hyphenated string. Monotonically increasing within a
-- millisecond on the same node.
-- Fails with an `Unavailable` error when the OS random source is unavailable.
v7 : () -> Task Error String
v7 = Kernel.kernel "Uuid_v7"


-- | `parse s` — validate that `s` is a well-formed UUID string in any
-- standard textual form.  Returns `Just s` on success, `Nothing` on
-- any malformed input.
parse : String -> Maybe String
parse = Kernel.kernel "Uuid_parse"
