-- | Ipe.System -- process environment + args + termination
--.
--
-- Most reads / writes are effectful (`Task Error _`) since they
-- touch process-global state that can change between invocations.
-- `getenvOr` is the exception -- when a default is supplied at the
-- call site, the operation can't fail, so the return is bare
-- `String`.
--
-- The OS temp-root names (`TMPDIR`, `TMP`, `TEMP`) always read as
-- unset: temporary files live in the runtime's private scratch space,
-- never under a base taken from the environment.
--
-- The runtime reads its own settings through the same view, so a value
-- set with `setenv`, removed with `unsetenv`, or loaded with `loadEnv`
-- is what the runtime observes too: `NO_COLOR` for colour output,
-- `IPE_EXPLAIN_VERBOSE` for the `Debug.explain` overlay, and
-- `IPE_DEBUGGER_RECORD` / `IPE_DEBUGGER_REPLAY` for the debugger follow
-- the program's writes, not only the environment the process started
-- with.
module Ipe.System exposing
    ( args, getArg
    , getenv, getenvOr, getenvInt, getenvBool
    , setenv, unsetenv
    , cwd, getcwd
    , loadEnv
    , exit
    )


import Ipe.Ffi.Kernel as Kernel
import Ipe.Error exposing (Error)


-- Command-line arguments


-- | `args ()` -- the command-line arguments after the program name.
-- Fails with `InvalidInput` when an argument is not valid UTF-8; the
-- error names the argument's position, never its bytes.
args : () -> Task Error (List String)
args = Kernel.kernel "System_args"


-- | `getArg n` -- zero-indexed positional arg lookup over the whole
-- argument vector (index 0 is the program name).  `Nothing` if `n` is
-- negative or past the end; fails with `InvalidInput` when that
-- argument is not valid UTF-8.
getArg : Int -> Task Error (Maybe String)
getArg = Kernel.kernel "System_getArg"


-- Environment variables


-- | `getenv key` -- the value of the environment variable `key`.
-- Fails with `NotFound` when the variable is not set (a temp-root name
-- is never set), and with `InvalidInput` when it is set to a value that
-- is not valid Unicode.  A message names the variable, never its value.
getenv : String -> Task Error String
getenv = Kernel.kernel "System_getenv"


-- | `getenvOr key default` -- returns the env value if present,
-- otherwise the supplied default.  Sync (no Task) because the
-- default handles the missing case.
--
-- A variable set to a value that is not valid Unicode answers the
-- default too, as an unset one does: the bare `String` return has no
-- failure to report it through.  Do not use `getenvOr` for a security
-- setting whose default is the permissive branch; read it with `getenv`
-- and refuse on `InvalidInput`.
getenvOr : String -> String -> String
getenvOr = Kernel.kernel "System_getenvOr"


-- | `getenvInt key` -- the environment variable `key` as an integer.
-- Fails with `NotFound` when the variable is not set, and with
-- `InvalidInput` when it is not valid Unicode or does not parse as an
-- integer.  A message names the variable, never its value.
getenvInt : String -> Task Error Int
getenvInt = Kernel.kernel "System_getenvInt"


-- | `getenvBool key` -- the environment variable `key` as a boolean.
-- Case and surrounding whitespace are ignored: `true`, `yes`, `1`, `on`, `y` and `t` read as `True`; `false`, `no`,
-- `0`, `off`, `n`, `f` and the empty value read as `False`.  Fails
-- with `NotFound` when the variable is not set, and with `InvalidInput`
-- when it is not valid Unicode or is any other value.  A message names
-- the variable, never its value.
getenvBool : String -> Task Error Bool
getenvBool = Kernel.kernel "System_getenvBool"


setenv : String -> String -> Task Error ()
setenv = Kernel.kernel "System_setenv"


unsetenv : String -> Task Error ()
unsetenv = Kernel.kernel "System_unsetenv"


-- Working directory


cwd : () -> Task Error String
cwd = Kernel.kernel "System_cwd"


-- | Alias for `cwd` -- kept for backward compatibility.
getcwd : () -> Task Error String
getcwd = Kernel.kernel "System_getcwd"


-- .env loading


-- | Load environment variables from `./.env` (the `.env` file in the
-- process's current working directory).  Each `KEY=VALUE` line is
-- parsed; `#` lines and empty lines are skipped; optional surrounding
-- single or double quotes are stripped.  Already-set variables take
-- precedence — the process environment wins.  A missing or unreadable
-- `.env` is silently a no-op.
loadEnv : () -> Task Error ()
loadEnv = Kernel.kernel "System_loadEnv"


-- Process termination


-- | Terminate the process with the given exit code.  Polymorphic
-- return type so this can be the last expression in any case
-- branch (it never returns to the caller).
exit : Int -> a
exit = Kernel.kernel "System_exit"
