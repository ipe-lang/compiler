iframe = node "iframe"


progress : List (Attribute msg) -> List (Html msg) -> Html msg
progress = node "progress"


meter : List (Attribute msg) -> List (Html msg) -> Html msg
meter = node "meter"


-- | `script attrs children` — a `<script>` element. It renders only over a
-- trusted body (`Ipe.Html.Unsafe.unsafeRaw`, or use `unsafeScript`); a text,
-- element or empty body is refused and renders nothing, so data never runs.
script : List (Attribute msg) -> List (Html msg) -> Html msg
script = node "script"


-- ── Headings ─────────────────────────────────────────────────────────────────

h1 : List (Attribute msg) -> List (Html msg) -> Html msg
h1 = node "h1"


h2 : List (Attribute msg) -> List (Html msg) -> Html msg
h2 = node "h2"


h3 : List (Attribute msg) -> List (Html msg) -> Html msg
h3 = node "h3"


h4 : List (Attribute msg) -> List (Html msg) -> Html msg
h4 = node "h4"


h5 : List (Attribute msg) -> List (Html msg) -> Html msg
h5 = node "h5"


h6 : List (Attribute msg) -> List (Html msg) -> Html msg
h6 = node "h6"


-- ── Document elements ────────────────────────────────────────────────────────

body : List (Attribute msg) -> List (Html msg) -> Html msg
body = node "body"


-- | `htmlNode` — the root `<html>` element.
htmlNode : List (Attribute msg) -> List (Html msg) -> Html msg
htmlNode = node "html"


-- | `headNode` — the `<head>` element.
headNode : List (Attribute msg) -> List (Html msg) -> Html msg
headNode = node "head"


title : List (Attribute msg) -> List (Html msg) -> Html msg
title = node "title"


-- ── Legacy compat aliases ────────────────────────────────────────────────────

headerNode : List (Attribute msg) -> List (Html msg) -> Html msg
headerNode = node "header"


codeNode : List (Attribute msg) -> List (Html msg) -> Html msg
codeNode = node "code"


mainNode : List (Attribute msg) -> List (Html msg) -> Html msg
mainNode = node "main"


footerNode : List (Attribute msg) -> List (Html msg) -> Html msg
footerNode = node "footer"


linkNode : List (Attribute msg) -> Html msg
linkNode = voidNode "link"


-- ── Void elements ────────────────────────────────────────────────────────────
-- `<tag> : List (Attribute msg) -> Html msg` (no children), pure sugar over
-- `voidNode` with the fixed tag literal.

img : List (Attribute msg) -> Html msg
img = voidNode "img"


input : List (Attribute msg) -> Html msg
input = voidNode "input"


br : List (Attribute msg) -> Html msg
br = voidNode "br"


hr : List (Attribute msg) -> Html msg
hr = voidNode "hr"


meta : List (Attribute msg) -> Html msg
meta = voidNode "meta"


link : List (Attribute msg) -> Html msg
link = voidNode "link"


area : List (Attribute msg) -> Html msg
area = voidNode "area"


base : List (Attribute msg) -> Html msg
base = voidNode "base"


col : List (Attribute msg) -> Html msg
col = voidNode "col"


embed : List (Attribute msg) -> Html msg
embed = voidNode "embed"


source : List (Attribute msg) -> Html msg
source = voidNode "source"


track : List (Attribute msg) -> Html msg
track = voidNode "track"


wbr : List (Attribute msg) -> Html msg
wbr = voidNode "wbr"
