-- | Ipe.Html — HTML element builders.
--
-- Every element builder (`div` / `nav` / `table` / `br` / …) is ordinary Ipê
-- over two retained native primitives: `node` (a container element) and
-- `voidNode` (a childless void element). Those two, plus `text` / `doctype` /
-- `titleNode` / `styleNode`, are the irreducible `Html`-value constructors,
-- reached through point-free `Kernel.kernel "Html_*"` aliases. The un-escaped raw
-- escape hatch lives in `Ipe.Html.Unsafe.unsafeRaw`, not here.
--
-- The serialiser (`render` / `toString` / `escapeHtml` / `escapeAttr` /
-- `attrToString`) and `renderStatic` stay native — they are the XSS barrier and
-- the render sink — and are re-exposed here through the same alias mechanism so
-- `Html.render` / `Html.escapeHtml` keep resolving from user code. Event
-- attributes live in `Ipe.Html.Events`, not here.
module Ipe.Html exposing
    ( Html, Attribute
    , node, voidNode, text, doctype, titleNode, styleNode
    , render, renderStatic, toString, escapeHtml, escapeAttr, attrToString
    , htmlRender, htmlEscapeText, htmlEscapeAttr, htmlAttrToString
    , div, span, p, a, button, form, label
    , nav, section, article, header, footer, main, aside
    , ul, ol, li
    , table, thead, tbody, tfoot, tr, th, td
    , textarea, select, option
    , pre, code, strong, em, small
    , fieldset, legend, blockquote, figure, figcaption
    , details, summary, dialog
    , video, audio, canvas, iframe, progress, meter, script
    , h1, h2, h3, h4, h5, h6
    , img, input, br, hr, meta, link
    , area, base, col, embed, source, track, wbr
    , body, htmlNode, headNode, title
    , headerNode, codeNode, mainNode, footerNode, linkNode
    )


import Ipe.Ffi.Kernel as Kernel


-- ── Retained native primitives ───────────────────────────────────────────────
-- The irreducible `Html`-value constructors. Every element builder below is
-- pure Ipê over `node` / `voidNode`; these five carry the values the render
-- sink recognises directly.

-- | `node tag attrs children` — a container element `<tag …>children</tag>`.
-- A `script` or `style` tag renders only over trusted raw children (see
-- `Ipe.Html.Unsafe` and `styleNode`), and `plaintext` or an unsafe tag name
-- never renders: a refused element renders nothing.
node : String -> List (Attribute msg) -> List (Html msg) -> Html msg
node = Kernel.kernel "Html_node"


-- | `voidNode tag attrs` — a childless void element `<tag …>` (self-closed by
-- the render sink for any void tag).
voidNode : String -> List (Attribute msg) -> Html msg
voidNode = Kernel.kernel "Html_voidNode"


-- | `text s` — an escaped text node. The value is escaped at the render sink,
-- so this is the safe-by-construction way to embed user content.
text : String -> Html msg
text = Kernel.kernel "Html_text"


-- | `doctype children` — wraps children in the document `<!DOCTYPE html>`
-- preamble emitted by the render sink.
doctype : List (Html msg) -> Html msg
doctype = Kernel.kernel "Html_doctype"


-- | `titleNode s` — `<title>` wrapping a raw string directly.
titleNode : String -> Html msg
titleNode = Kernel.kernel "Html_titleNode"


-- | `styleNode attrs css` — a `<style>` element whose CSS body is
-- neutralised once at construction so it can open or close no markup: every
-- `</style` is removed, and a space follows every `<` that comes before a
-- letter, `/`, `!` or `?`. CSS reads that space as whitespace, but inside a
-- CSS string or `url(...)` it is kept, so
-- `url("data:image/svg+xml,<svg ...>")` arrives as `< svg` and a string
-- holding `</style>` loses that run.
styleNode : List (Attribute msg) -> String -> Html msg
styleNode = Kernel.kernel "Html_styleNode"


-- ── Retained native serialiser (the XSS barrier) ─────────────────────────────
-- These stay native — the escaping/serialisation sink — and are re-exposed here
-- so `Html.render` / `Html.escapeHtml` keep resolving from user code.

-- | `render html` — serialise an `Html` tree to a `String`, escaping text and
-- attribute values at the sink.
render : Html msg -> String
render = Kernel.kernel "Html_render"


-- | `renderStatic view model` — render a `model -> Html msg` view once to a
-- static HTML string, as a `Task`.
renderStatic : (model -> Html msg) -> model -> Task Error ()
renderStatic = Kernel.kernel "Html_renderStatic"


-- | `toString html` — an alias of `render`.
toString : Html msg -> String
toString = Kernel.kernel "Html_toString"


-- | `escapeHtml s` — escape a string for safe inclusion in text content.
escapeHtml : String -> String
escapeHtml = Kernel.kernel "Html_escapeHtml"


-- | `escapeAttr s` — escape a string for safe inclusion in an attribute value.
escapeAttr : String -> String
escapeAttr = Kernel.kernel "Html_escapeAttr"


-- | `attrToString attr` — serialise a single `Attribute` to its ` key="value"`
-- wire form.
attrToString : Attribute msg -> String
attrToString = Kernel.kernel "Html_attrToString"


-- | `htmlRender` — pipeline-readable spelling of `render`.
htmlRender : Html msg -> String
htmlRender = Kernel.kernel "Html_render"


-- | `htmlEscapeText` — pipeline-readable spelling of `escapeHtml`.
htmlEscapeText : String -> String
htmlEscapeText = Kernel.kernel "Html_escapeHtml"


-- | `htmlEscapeAttr` — pipeline-readable spelling of `escapeAttr`.
htmlEscapeAttr : String -> String
htmlEscapeAttr = Kernel.kernel "Html_escapeAttr"


-- | `htmlAttrToString` — pipeline-readable spelling of `attrToString`.
htmlAttrToString : Attribute msg -> String
htmlAttrToString = Kernel.kernel "Html_attrToString"


-- ── Container elements ───────────────────────────────────────────────────────
-- `<tag> : List (Attribute msg) -> List (Html msg) -> Html msg`, pure sugar over
-- `node` with the fixed tag literal.

div : List (Attribute msg) -> List (Html msg) -> Html msg
div = node "div"


span : List (Attribute msg) -> List (Html msg) -> Html msg
span = node "span"


p : List (Attribute msg) -> List (Html msg) -> Html msg
p = node "p"


a : List (Attribute msg) -> List (Html msg) -> Html msg
a = node "a"


button : List (Attribute msg) -> List (Html msg) -> Html msg
button = node "button"


form : List (Attribute msg) -> List (Html msg) -> Html msg
form = node "form"


label : List (Attribute msg) -> List (Html msg) -> Html msg
label = node "label"


nav : List (Attribute msg) -> List (Html msg) -> Html msg
nav = node "nav"


section : List (Attribute msg) -> List (Html msg) -> Html msg
section = node "section"


article : List (Attribute msg) -> List (Html msg) -> Html msg
article = node "article"


header : List (Attribute msg) -> List (Html msg) -> Html msg
header = node "header"


footer : List (Attribute msg) -> List (Html msg) -> Html msg
footer = node "footer"


main : List (Attribute msg) -> List (Html msg) -> Html msg
main = node "main"


aside : List (Attribute msg) -> List (Html msg) -> Html msg
aside = node "aside"


ul : List (Attribute msg) -> List (Html msg) -> Html msg
ul = node "ul"


ol : List (Attribute msg) -> List (Html msg) -> Html msg
ol = node "ol"


li : List (Attribute msg) -> List (Html msg) -> Html msg
li = node "li"


table : List (Attribute msg) -> List (Html msg) -> Html msg
table = node "table"


thead : List (Attribute msg) -> List (Html msg) -> Html msg
thead = node "thead"


tbody : List (Attribute msg) -> List (Html msg) -> Html msg
tbody = node "tbody"


tfoot : List (Attribute msg) -> List (Html msg) -> Html msg
tfoot = node "tfoot"


tr : List (Attribute msg) -> List (Html msg) -> Html msg
tr = node "tr"


th : List (Attribute msg) -> List (Html msg) -> Html msg
th = node "th"


td : List (Attribute msg) -> List (Html msg) -> Html msg
td = node "td"


textarea : List (Attribute msg) -> List (Html msg) -> Html msg
textarea = node "textarea"


select : List (Attribute msg) -> List (Html msg) -> Html msg
select = node "select"


option : List (Attribute msg) -> List (Html msg) -> Html msg
option = node "option"


pre : List (Attribute msg) -> List (Html msg) -> Html msg
pre = node "pre"


code : List (Attribute msg) -> List (Html msg) -> Html msg
code = node "code"


strong : List (Attribute msg) -> List (Html msg) -> Html msg
strong = node "strong"


em : List (Attribute msg) -> List (Html msg) -> Html msg
em = node "em"


small : List (Attribute msg) -> List (Html msg) -> Html msg
small = node "small"


fieldset : List (Attribute msg) -> List (Html msg) -> Html msg
fieldset = node "fieldset"


legend : List (Attribute msg) -> List (Html msg) -> Html msg
legend = node "legend"


blockquote : List (Attribute msg) -> List (Html msg) -> Html msg
blockquote = node "blockquote"


figure : List (Attribute msg) -> List (Html msg) -> Html msg
figure = node "figure"


figcaption : List (Attribute msg) -> List (Html msg) -> Html msg
figcaption = node "figcaption"


details : List (Attribute msg) -> List (Html msg) -> Html msg
details = node "details"


summary : List (Attribute msg) -> List (Html msg) -> Html msg
summary = node "summary"


dialog : List (Attribute msg) -> List (Html msg) -> Html msg
dialog = node "dialog"


video : List (Attribute msg) -> List (Html msg) -> Html msg
video = node "video"


audio : List (Attribute msg) -> List (Html msg) -> Html msg
audio = node "audio"


canvas : List (Attribute msg) -> List (Html msg) -> Html msg
