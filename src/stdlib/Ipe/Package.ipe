-- | Ipe.Package — the schema of a `package.ipe` project manifest.
--
-- A `package.ipe` binds one value, `package : Package`, to a record literal.
-- The manifest is INERT: every field is data — a string, a `Bool`, a list, a
-- closed-set constructor, or a nested record — and no field may hold a function,
-- a `Task`, or any effect. There is nothing in a manifest to run, which is
-- exactly what lets the toolchain read a project's manifest before it has
-- resolved (or compiled) any dependency.
--
-- The toolchain reads the manifest SYNTACTICALLY (it walks the record's AST and
-- never evaluates it), yet the same record type-checks against this schema the
-- ordinary way: a mistyped field (`database = "sqlite"` where a `Database` is
-- wanted) is a type error, and a closed-set typo (`Postgress`) is a name error.
--
-- Closed choices are unions (`Database`, `Shape`, `Allocator`, `Target`,
-- `WasmClient`, `WasmMode`, `WrapperSpec`, `Capability`); open text is `String`,
-- parsed at the read boundary (semver, module path, path jail, secret denylist);
-- a plain boolean setting is `Bool`.


module Ipe.Package exposing
    ( Package
    , Capabilities
    , Program
    , Dependency
    , RustDependency
    , DependencySource(..)
    , Database(..)
    , Shape(..)
    , Allocator(..)
    , Target(..)
    , WasmClient(..)
    , WasmMode(..)
    , WasmOptions
    , WrapperSpec(..)
    , WrapperOptions
    , Build
    , Delivery
    , Ship
    , binary
    , staticBinary
    , crossBinary
    , desktop
    , client
    , clientDesktop
    , clientIos
    , clientAndroid
    , DesktopConfig
    , MobileConfig
    , PushConfig
    , ApnsEnvironment(..)
    , FcmConfig
    , BrowserConfig
    , Orientation(..)
    , Capability(..)
    , WebCapability(..)
    , dep
    , depGit
    , depGitRev
    , depPath
    , rustDep
    , rustDepWith
    )


-- | The whole manifest. Only `name` is strictly required; every other field
-- defaults to its absent-section default when omitted (see each field's type).
--
-- `icon` is the app icon, a path relative to the project root that must stay
-- inside it. An installable `web served` app (`installable` in
-- `BrowserConfig`) requires it, as a square PNG of at least 192 by 192 px.
type alias Package =
    { name : String
    , version : String
    , sourceRoot : String
    , icon : String
    , dependencies : List Dependency
    , rustDependencies : List RustDependency
    , capabilities : Capabilities
    , exposedModules : List String
    , programs : List Program
    , wasm : WasmClient
    , wrapper : WrapperSpec
    , build : Build
    , delivery : Delivery
    }


-- | Per-host delivery configuration.
--
-- All three sections are present and live — the active target is the CLI's
-- resolved shape+runtime+host, not a field here. `ipe dev build` reads only the
-- section matching the resolved target; the others are inert at that run.
--
-- `servers` lists the origins a client bundle may reach: its
-- Content-Security-Policy allows `connect-src` to `'self'` plus each listed
-- origin over `https://` and `wss://`, and nothing else. An omitted or empty
-- list is an offline bundle. Each entry is exactly `https://` followed by a
-- lowercase host of `a-z 0-9 -` labels (each 1 to 63 bytes, not starting or
-- ending with `-`, at most 253 bytes in all) and an optional `:port` (1 to
-- 65535, no leading zero, never `:443`), with nothing after it. An IP address,
-- a `user@` part, a `*` wildcard, uppercase and non-ASCII are refused. At most
-- 16 origins are listed, each once.
type alias Delivery =
    { ships : List Ship
    , desktop : DesktopConfig
    , mobile : MobileConfig
    , browser : BrowserConfig
    , servers : List String
    }


-- | One delivery `ipe release` produces. The `ships` list declares *what* a
-- project releases; the host config sections below declare *how* each looks.
-- Every entry is one of the closed builder vocabulary — a typo is an unknown
-- name at read time, never a string compared at build time. Each builder maps
-- one-to-one onto the CLI delivery grammar (`binary` is the shape's co-located
-- artifact; `clientIos` is `web client ios`), so the manifest stores the same
-- sentences the CLI accepts. An omitted `ships` field means the implicit
-- `[ binary ]` singleton — the shape's default delivery.
type Ship
    = ShipBinary
    | ShipStaticBinary
    | ShipCross String
    | ShipDesktop
    | ShipClient
    | ShipClientDesktop
    | ShipClientIos
    | ShipClientAndroid


-- | The shape's own co-located artifact on the host triple (for `web`,
-- served). Meaningful for every shape.
binary : Ship
binary =
    ShipBinary


-- | The musl static binary (`--static`). Co-located shapes only.
staticBinary : Ship
staticBinary =
    ShipStaticBinary


-- | A cross-compiled co-located binary for a Rust target triple, validated at
-- read time against the supported target set.
crossBinary : String -> Ship
crossBinary triple =
    ShipCross triple


-- | The `web desktop` webview-native desktop bundle. Web shape only.
desktop : Ship
desktop =
    ShipDesktop


-- | The `web client` browser wasm bundle. Web shape only.
client : Ship
client =
    ShipClient


-- | The `web client desktop` wasm bundle plus a native webview shell.
clientDesktop : Ship
clientDesktop =
    ShipClientDesktop


-- | The `web client ios` wasm bundle plus an iOS shell.
clientIos : Ship
clientIos =
    ShipClientIos


-- | The `web client android` wasm bundle plus an Android shell.
clientAndroid : Ship
clientAndroid =
    ShipClientAndroid


-- | Configuration for the `web desktop` (webview-native) host.
--
-- `title` is the native window title. `width` and `height` are the initial
-- inner dimensions in logical pixels; the user may resize afterwards.
type alias DesktopConfig =
    { title : String
    , width : Int
    , height : Int
    }


-- | Configuration for the `web client ios` / `web client android` mobile hosts.
--
-- `bundleId` is the reverse-DNS application identifier required by both
-- platforms (`com.example.myapp`). `orientation` locks the device orientation
-- on launch; the host's native shell enforces it. `push` names the identifiers
-- the shells register for push messages with; it is refused unless
-- `capabilities.accepts` lists `JsPort Push`, and an iOS or Android pack of an
-- app that accepts `JsPort Push` is refused without it.
type alias MobileConfig =
    { bundleId : String
    , orientation : Orientation
    , push : PushConfig
    }


-- | `delivery.mobile.push`: the APNs environment and the Firebase client
-- identifiers. Both fields are required.
type alias PushConfig =
    { apns : ApnsEnvironment
    , fcm : FcmConfig
    }


-- | The APNs environment an iOS shell registers in: `Development` for a
-- development-signed build, `Production` for a distribution-signed one.
type ApnsEnvironment
    = Development
    | Production


-- | The Firebase client identifiers the Android shell registers with. They are
-- public client identifiers, never server credentials. Every field is
-- required; each is 1 to 128 bytes of `A-Z a-z 0-9 : _ . -`.
type alias FcmConfig =
    { projectId : String
    , applicationId : String
    , apiKey : String
    , senderId : String
    }


-- | The allowed screen orientations for a mobile host.
type Orientation
    = Portrait
    | Landscape
    | Any


-- | Configuration for the browser host.
--
-- `basePath` is the URL path the client bundle is served at: the `web client`
-- host, static hosts, and mobile shells all serve the bundle under it. Use
-- `"/"` (or `""`) for the root and `"/app"` when the client lives at a sub-path
-- behind a reverse proxy. Any other value is one or more `/segment` parts, each
-- made only of the bytes `A-Z a-z 0-9 - . _ ~`, with no trailing `/`, no empty,
-- `.`, or `..` segment, and at most 1024 bytes in all. The manifest refuses any
-- other value.
--
-- `installable` (default `False`): when `True`, a `web served` app offers
-- browser install (a web app manifest, a home-screen icon, a standalone window)
-- and an offline notice page. It requires the top-level `icon`: a PNG, square,
-- at least 192 by 192 px, at most 2 MiB; anything else stops the build with an
-- error naming the rule. The app still needs a connection to work; offline it
-- shows a notice and nothing else. The served base path comes from the server
-- (`IPE_WEB_BASE_PATH` or `Server.mountApp`), not from `basePath`.
--
-- ```
-- package =
--     { name = "todo"
--     , icon = "assets/icon-512.png"
--     , delivery = { browser = { basePath = "/", installable = True } }
--     }
-- ```
type alias BrowserConfig =
    { basePath : String
    , installable : Bool
    }


-- | The security capabilities a package declares and pre-accepts.
--
-- `declares` is the set of effects the author asserts the program exercises
-- (verified against the compiler's inferred set). `accepts` is a durable,
-- reviewable pre-acceptance of a disclosed risk — today only `Unsafe`, whose
-- presence pre-accepts the `.Unsafe`-import acknowledgment so a repeatedly built
-- project never re-prompts.
type alias Capabilities =
    { declares : List Capability
    , accepts : List Capability
    }


-- | One named build target: an entry module file (relative to the source root)
-- and a declared `Shape`. A declared shape is validated against the compiler's
-- inferred shape, never used to override it.
type alias Program =
    { name : String
    , entry : String
    , shape : Shape
    }


-- | One Ipê dependency: its name and its source. Constructed with the `dep` /
-- `depGit` / `depGitRev` / `depPath` builders so a dependency's source is
-- exactly one of index / git / path, never a bag of optional keys.
type alias Dependency =
    { name : String
    , source : DependencySource
    }


-- | The source of a `Dependency`: index by semver requirement, a git repository
-- (optionally pinned to a revision), or a local path relative to the manifest.
type DependencySource
    = FromIndex String
    | FromGit String (Maybe String)
    | FromPath String


-- | One crates.io crate bound as a foreign-function dependency, with its version
-- requirement and requested feature list. Constructed with `rustDep` (no extra
-- features) or `rustDepWith` (with a feature list).
type alias RustDependency =
    { name : String
    , version : String
    , features : List String
    }


-- | The SQL driver the emitted project targets. Defaults to `Sqlite`.
type Database
    = Sqlite
    | Postgres


-- | The declared shape of a program's entry: a `Web` server, a `WebView`
-- desktop app, a `Terminal` app, or a plain `Program`.
type Shape
    = Web
    | WebView
    | Terminal
    | Program


-- | The static-link allocator. Defaults to `AutoAlloc` (resolve by target).
type Allocator
    = AutoAlloc
    | System
    | Dlmalloc
    | Talc
    | Mimalloc


-- | The build target: the host, or a cross-compile rustc triple. The triple is
-- open text, parsed into the closed target set at the read boundary.
type Target
    = HostTarget
    | Cross String


-- | The wasm client target. `Off` (the default) builds no wasm bundle; `On`
-- carries the bundle's options.
type WasmClient
    = Off
    | On WasmOptions


-- | The rendering strategy of a wasm client bundle.
type WasmMode
    = Render
    | Hydrate


-- | The options of an active wasm client bundle. `publicEnv` is a default-deny
-- allowlist of environment-variable names the bundle may read at build time;
-- listing a secret-pattern name, a temp-root or home variable (`TMPDIR`,
-- `HOME`, …), a malformed name, or one name twice is a read-time build error.
type alias WasmOptions =
    { mode : WasmMode
    , entry : String
    , mount : String
    , publicEnv : List String
    , optLevel : String
    }


-- | A local Rust-crate wrapper binding. `NoWrapper` (the default) declares none.
type WrapperSpec
    = NoWrapper
    | Wrapper WrapperOptions


-- | A wrapper's package-jailed local path, the functions it exposes, and the
-- capabilities the wrapper is granted.
type alias WrapperOptions =
    { path : String
    , expose : List String
    , capabilities : List Capability
    }


-- | The build settings. Every field defaults to its unset value when omitted:
-- `database = Sqlite`, each `Bool` `False`, `target = HostTarget`,
-- `allocator = AutoAlloc`.
type alias Build =
    { database : Database
    , static : Bool
    , target : Target
    , allocator : Allocator
    , cFree : Bool
    }


-- | The security-capability vocabulary a manifest may name in `declares` /
-- `accepts` and in a wrapper's `capabilities`. Mirrors the kernel capability set.
type Capability
    = Network
    | Filesystem
    | Database
    | Env
    | Subprocess
    | Clock
    | Random
    | NativeFfi
    | FfiRaw
    | Unsafe
    | CustomElement
    | JsPort WebCapability


-- | The closed per-Web-API sub-axis a `JsPort` capability discloses. A browser
-- port reaches exactly one Web API; this names which. `Raw` is the explicit axis
-- for an uncharacterised hand-rolled port — the coarsest grantable web axis, which
-- reaches nothing specific. There is no bare `JsPort`; every port names an axis.
type WebCapability
    = Geolocation
    | Clipboard
    | Notification
    | Storage
    | Vibration
    | Share
    | Battery
    | NetworkInfo
    | File
    | Camera
    | Microphone
    | Visibility
    | MediaQuery
    | Connectivity
    | Raw


-- | An index dependency: resolved from the package index by a semver
-- requirement string (`dep "ipe-http" "^1.2"`).
dep : String -> String -> Dependency
dep name requirement =
    { name = name, source = FromIndex requirement }


-- | A git dependency with no pinned revision.
depGit : String -> String -> Dependency
depGit name url =
    { name = name, source = FromGit url Nothing }


-- | A git dependency pinned to a revision (commit, tag, or branch).
depGitRev : String -> String -> String -> Dependency
depGitRev name url rev =
    { name = name, source = FromGit url (Just rev) }


-- | A local-path dependency, relative to the manifest.
depPath : String -> String -> Dependency
depPath name path =
    { name = name, source = FromPath path }


-- | A Rust dependency with no extra features.
rustDep : String -> String -> RustDependency
rustDep name version =
    { name = name, version = version, features = [] }


-- | A Rust dependency with a feature list.
rustDepWith : String -> String -> List String -> RustDependency
rustDepWith name version features =
    { name = name, version = version, features = features }
