-- | `Ipe.String` — build, slice, search, and transform text.
--
-- A `String` is immutable UTF-8 text; every function here returns a NEW string
-- rather than changing its argument. The functions cluster into families:
-- construction (`fromInt`, `fromFloat`, `fromBool`, `fromChar`, `repeat`), shape (`length`, `isEmpty`),
-- combining (`join`, `append`, `concat`), splitting (`split`, `words`, `lines`),
-- slicing (`slice`, `left`, `right`, `dropLeft`, `padLeft`), case
-- (`toUpper`, `toLower`, and the locale-aware `*In` / `casefold` variants),
-- searching (`contains`, `startsWith`, `indexes`), parsing (`toInt`, `toFloat`,
-- `isEmail`, `isUrl`), and character-wise transforms (`map`, `filter`, `foldl`).
--
-- Parsers return an `Ipe.Maybe`: `toInt "12"` is `Just 12`, `toInt "x"` is
-- `Nothing` — so a caller handles the un-parsable case in the type. The String
-- guide (`ipe doc guide:string`) walks the mental model and a worked example;
-- this module is the per-symbol reference.
module Ipe.String exposing
    ( String
    , fromInt, fromFloat
    , length, isEmpty
    , join, split, replace, slice, dropLeft, dropRight
    , toInt, toFloat
    , toUpper, toLower, trim, trimStart, trimEnd
    , toUpperIn, toLowerIn
    , reverse, append, concat
    , contains, startsWith, endsWith
    , containsIn, startsWithIn, endsWithIn
    , casefold, equalFold
    , isEmail, isUrl
    , words, lines
    , fromBool, fromChar, toList, fromList
    , repeat, padLeft, padRight
    , left, right, cons, uncons, pad, indexes
    , map, filter, foldl, foldr, any, all
    )


import Ipe.Ffi.Kernel as Kernel


-- ─── Construction ──────────────────────────────────────────────────


{-| `fromInt n` — the decimal string representation of an integer.

```ipe
fromInt 42 --> "42"
fromInt (-7) --> "-7"
fromInt 0 --> "0"
```
-}
fromInt : Int -> String
fromInt = Kernel.kernel "String_fromInt"


{-| `fromFloat n` — the string representation of a float.

```ipe
fromFloat 3.14 --> "3.14"
fromFloat (-0.5) --> "-0.5"
```
-}
fromFloat : Float -> String
fromFloat = Kernel.kernel "String_fromFloat"


{-| `fromBool b` — the canonical text of a `Bool`: lowercase `"true"` or
`"false"`. `{{flag}}` interpolation renders a `Bool` the same way.

```ipe
fromBool True --> "true"
fromBool False --> "false"
```
-}
fromBool : Bool -> String
fromBool = Kernel.kernel "String_fromBool"


{-| `fromChar c` — a one-character string from a `Char`.

```ipe
fromChar 'A' --> "A"
fromChar '\n' --> "\n"
```
-}
fromChar : Char -> String
fromChar = Kernel.kernel "String_fromChar"


{-| `fromList chars` — build a `String` from a list of characters.

```ipe
fromList [ 'h', 'i' ] --> "hi"
fromList [] --> ""
fromList [ 'a', 'b', 'c' ] --> "abc"
```
-}
fromList : List Char -> String
fromList = Kernel.kernel "String_fromList"


-- ─── Sizes + predicates ────────────────────────────────────────────


{-| `length s` — the number of Unicode code points in `s`.

```ipe
length "hello" --> 5
length "" --> 0
length "café" --> 4
```
-}
length : String -> Int
length = Kernel.kernel "String_length"


{-| `isEmpty s` — `True` when `s` is the empty string.

```ipe
isEmpty "" --> True
isEmpty "a" --> False
isEmpty "  " --> False
```
-}
isEmpty : String -> Bool
isEmpty = Kernel.kernel "String_isEmpty"


{-| `contains needle haystack` — `True` when `needle` appears inside `haystack`.

```ipe
contains "ell" "hello" --> True
contains "xyz" "hello" --> False
contains "" "anything" --> True
```
-}
contains : String -> String -> Bool
contains = Kernel.kernel "String_contains"


{-| `startsWith prefix s` — `True` when `s` begins with `prefix`.

```ipe
startsWith "he" "hello" --> True
startsWith "lo" "hello" --> False
startsWith "" "hello" --> True
```
-}
startsWith : String -> String -> Bool
startsWith = Kernel.kernel "String_startsWith"


{-| `endsWith suffix s` — `True` when `s` ends with `suffix`.

```ipe
endsWith "lo" "hello" --> True
endsWith "he" "hello" --> False
endsWith "" "hello" --> True
```
-}
endsWith : String -> String -> Bool
endsWith = Kernel.kernel "String_endsWith"


-- | Haystack-first companion to `contains` — built for pipelines.
--
--     "hello world" |> String.containsIn "world"   -- True
--
-- Equivalent to `\\haystack needle -> contains needle haystack`.
{-| `containsIn needle haystack` — `True` when `needle` appears in `haystack`.
Haystack-first for pipeline use.

```ipe
containsIn "world" "hello world" --> True
containsIn "xyz" "hello" --> False
"hello world" |> containsIn "world" --> True
```
-}
containsIn : String -> String -> Bool
containsIn = Kernel.kernel "String_containsIn"


-- | Haystack-first companion to `startsWith`.
--
--     "/api/users" |> String.startsWithIn "/api"  -- True
{-| `startsWithIn prefix haystack` — `True` when `haystack` starts with `prefix`.

```ipe
startsWithIn "/api" "/api/users" --> True
startsWithIn "/v2" "/api/users" --> False
"/api/users" |> startsWithIn "/api" --> True
```
-}
startsWithIn : String -> String -> Bool
startsWithIn = Kernel.kernel "String_startsWithIn"


-- | Haystack-first companion to `endsWith`.
--
--     "image.png" |> String.endsWithIn ".png"  -- True
{-| `endsWithIn suffix haystack` — `True` when `haystack` ends with `suffix`.

```ipe
endsWithIn ".png" "image.png" --> True
endsWithIn ".jpg" "image.png" --> False
"image.png" |> endsWithIn ".png" --> True
```
-}
endsWithIn : String -> String -> Bool
endsWithIn = Kernel.kernel "String_endsWithIn"


{-| `isEmail s` — `True` when `s` looks like a valid email address.

```ipe
isEmail "user@example.com" --> True
isEmail "not-an-email" --> False
```
-}
isEmail : String -> Bool
isEmail = Kernel.kernel "String_isEmail"


{-| `isUrl s` — `True` when `s` looks like a valid URL.

```ipe
isUrl "https://example.com" --> True
isUrl "not a url" --> False
```
-}
isUrl : String -> Bool
isUrl = Kernel.kernel "String_isUrl"


{-| `equalFold s1 s2` — case-insensitive equality comparison.

```ipe
equalFold "Hello" "hello" --> True
equalFold "Hello" "world" --> False
equalFold "ABC" "abc" --> True
```
-}
equalFold : String -> String -> Bool
equalFold = Kernel.kernel "String_equalFold"


-- ─── Parsing ───────────────────────────────────────────────────────


{-| `toInt s` — parse `s` as a decimal integer; `Nothing` if not valid.

```ipe
toInt "42" --> Just 42
toInt "-7" --> Just -7
toInt "abc" --> Nothing
```
-}
toInt : String -> Maybe Int
toInt = Kernel.kernel "String_toInt"


{-| `toFloat s` — parse `s` as a floating-point number; `Nothing` if not valid.

```ipe
toFloat "3.14" --> Just 3.14
toFloat "-0.5" --> Just -0.5
toFloat "abc" --> Nothing
```
-}
toFloat : String -> Maybe Float
toFloat = Kernel.kernel "String_toFloat"


-- ─── Case + whitespace ─────────────────────────────────────────────


{-| `toUpper s` — convert all letters in `s` to upper case.

```ipe
toUpper "hello" --> "HELLO"
toUpper "Café" --> "CAFÉ"
```
-}
toUpper : String -> String
toUpper = Kernel.kernel "String_toUpper"


{-| `toLower s` — convert all letters in `s` to lower case.

```ipe
toLower "HELLO" --> "hello"
toLower "Café" --> "café"
```
-}
toLower : String -> String
toLower = Kernel.kernel "String_toLower"


{-| `casefold s` — case-fold `s` for case-insensitive comparison.

```ipe
casefold "HELLO" --> "hello"
casefold "Straße" --> "strasse"
```
-}
casefold : String -> String
casefold = Kernel.kernel "String_casefold"


-- | `toUpperIn locale s` — locale-correct upper-case conversion.
--
-- For most scripts this matches `toUpper`.  The motivating difference is
-- Turkish/Azerbaijani: `toUpperIn tr "i"` yields `"İ"` (capital dotted I,
-- U+0130), whereas `toUpper "i"` yields `"I"`.  Construct `locale` via
-- `Locale.fromTag`; an invalid tag produces `Nothing` at the parse
-- boundary so it can never reach this function.
--
-- Requires the `locale` runtime feature; programs that never call this
-- function pay no dependency cost.
--
--     import Ipe.Locale as Locale
--
--     case Locale.fromTag "tr" of
--         Just tr -> String.toUpperIn tr "istanbul"
--         Nothing -> String.toUpper "istanbul"
--
{-| `toUpperIn locale s` — locale-sensitive upper-case conversion.

```ipe
import Ipe.Locale as Locale

Maybe.withDefault (toUpper "istanbul") (Maybe.map (\tr -> toUpperIn tr "istanbul") (Locale.fromTag "tr")) --> "İSTANBUL"
```
-}
toUpperIn : Locale -> String -> String
toUpperIn = Kernel.kernel "String_toUpperIn"


-- | `toLowerIn locale s` — locale-correct lower-case conversion.
--
-- The motivating difference is Turkish/Azerbaijani: `toLowerIn tr "I"` yields
-- `"ı"` (dotless i, U+0131), whereas `toLower "I"` yields `"i"`.
{-| `toLowerIn locale s` — locale-sensitive lower-case conversion.

```ipe
import Ipe.Locale as Locale

Maybe.withDefault (toLower "ISTANBUL") (Maybe.map (\tr -> toLowerIn tr "ISTANBUL") (Locale.fromTag "tr")) --> "istanbul"
```
-}
toLowerIn : Locale -> String -> String
toLowerIn = Kernel.kernel "String_toLowerIn"


{-| `trim s` — remove leading and trailing whitespace.

```ipe
trim "  hello  " --> "hello"
trim "\t hi \n" --> "hi"
trim "no space" --> "no space"
```
-}
trim : String -> String
trim = Kernel.kernel "String_trim"


{-| `trimStart s` — remove leading whitespace only.

```ipe
trimStart "  hello  " --> "hello  "
trimStart "  hi" --> "hi"
```
-}
trimStart : String -> String
trimStart = Kernel.kernel "String_trimStart"


{-| `trimEnd s` — remove trailing whitespace only.

```ipe
trimEnd "  hello  " --> "  hello"
trimEnd "hi  " --> "hi"
```
-}
trimEnd : String -> String
trimEnd = Kernel.kernel "String_trimEnd"


-- ─── Slicing + assembly ────────────────────────────────────────────


{-| `reverse s` — the string with its characters in reverse order.

```ipe
reverse "hello" --> "olleh"
reverse "" --> ""
reverse "abcde" --> "edcba"
```
-}
reverse : String -> String
reverse = Kernel.kernel "String_reverse"


{-| `append s1 s2` — concatenate two strings; `s1` followed by `s2`.

```ipe
append "hello" " world" --> "hello world"
append "" "abc" --> "abc"
append "foo" "" --> "foo"
```
-}
append : String -> String -> String
append = Kernel.kernel "String_append"


{-| `concat strings` — join a list of strings into one.

```ipe
concat [ "hello", " ", "world" ] --> "hello world"
concat [] --> ""
concat [ "a", "b", "c" ] --> "abc"
```
-}
concat : List String -> String
concat = Kernel.kernel "String_concat"


{-| `join sep strings` — join a list of strings with `sep` between each pair.

```ipe
join ", " [ "a", "b", "c" ] --> "a, b, c"
join "-" [ "year", "month", "day" ] --> "year-month-day"
join "" [ "hello", "world" ] --> "helloworld"
```
-}
join : String -> List String -> String
join = Kernel.kernel "String_join"


{-| `split sep s` — split `s` on every occurrence of `sep`.

```ipe
split "," "a,b,c" --> [ "a", "b", "c" ]
split "/" "/api/users" --> [ "", "api", "users" ]
split "x" "no match" --> [ "no match" ]
```
-}
split : String -> String -> List String
split = Kernel.kernel "String_split"


{-| `replace from to s` — replace every occurrence of `from` in `s` with `to`.

```ipe
replace "o" "0" "foo bar" --> "f00 bar"
replace "  " " " "too  many  spaces" --> "too many spaces"
replace "x" "y" "no match" --> "no match"
```
-}
replace : String -> String -> String -> String
replace = Kernel.kernel "String_replace"


{-| `slice start end s` — characters from index `start` to `end` (exclusive).
Negative indices count from the end.

```ipe
slice 0 5 "hello world" --> "hello"
slice 6 11 "hello world" --> "world"
slice (-5) (-1) "hello world" --> "worl"
```
-}
slice : Int -> Int -> String -> String
slice = Kernel.kernel "String_slice"


-- | Drop the first n characters (runes) from s.  Elm semantics:
-- negative n returns s unchanged; n >= length returns "".
{-| `dropLeft n s` — remove the first `n` characters; `""` when `n >= length`.

```ipe
dropLeft 2 "hello" --> "llo"
dropLeft 0 "hello" --> "hello"
dropLeft 9 "hi" --> ""
```
-}
dropLeft : Int -> String -> String
dropLeft = Kernel.kernel "String_dropLeft"


-- | Drop the last n characters (runes) from s.  Elm semantics:
-- negative n returns s unchanged; n >= length returns "".
{-| `dropRight n s` — remove the last `n` characters; `""` when `n >= length`.

```ipe
dropRight 2 "hello" --> "hel"
dropRight 0 "hello" --> "hello"
dropRight 9 "hi" --> ""
```
-}
dropRight : Int -> String -> String
dropRight = Kernel.kernel "String_dropRight"


{-| `repeat n s` — concatenate `s` with itself `n` times.

The result is bounded at a 64 MiB ceiling. When `n * length s` would exceed it,
the count is clamped to the whole copies that fit, so the output is always a
genuine prefix of the requested repetition — never silently collapsed to "".
A non-positive `n`, or an empty `s`, yields "".

```ipe
repeat 3 "ab" --> "ababab"
repeat 0 "abc" --> ""
repeat 1 "x" --> "x"
```
-}
repeat : Int -> String -> String
repeat = Kernel.kernel "String_repeat"


{-| `padLeft n c s` — left-pad `s` with character `c` to width `n`.

```ipe
padLeft 5 '0' "42" --> "00042"
padLeft 3 ' ' "hi" --> " hi"
padLeft 2 '-' "abc" --> "abc"
```
-}
padLeft : Int -> Char -> String -> String
padLeft = Kernel.kernel "String_padLeft"


{-| `padRight n c s` — right-pad `s` with character `c` to width `n`.

```ipe
padRight 5 '.' "hi" --> "hi..."
padRight 3 ' ' "abc" --> "abc"
```
-}
padRight : Int -> Char -> String -> String
padRight = Kernel.kernel "String_padRight"


-- ─── Word / line / character views ─────────────────────────────────


{-| `words s` — split `s` into words on whitespace boundaries.

```ipe
words "hello world" --> [ "hello", "world" ]
words "  foo  bar  " --> [ "foo", "bar" ]
words "" --> []
```
-}
words : String -> List String
words = Kernel.kernel "String_words"


{-| `lines s` — split `s` into lines on newline boundaries.

```ipe
lines "line1\nline2\nline3" --> [ "line1", "line2", "line3" ]
lines "only one" --> [ "only one" ]
lines "" --> [ "" ]
```
-}
lines : String -> List String
lines = Kernel.kernel "String_lines"


{-| `toList s` — convert `s` to a list of characters.

```ipe
toList "abc" --> [ 'a', 'b', 'c' ]
toList "" --> []
toList "hi" --> [ 'h', 'i' ]
```
-}
toList : String -> List Char
toList = Kernel.kernel "String_toList"


-- ─── Char-level navigation ─────────────────────────────────────────


-- | `left n s` — the first `n` characters (runes). `n <= 0` → "".
{-| `left n s` — the first `n` characters; `""` when `n <= 0`.

```ipe
left 3 "hello" --> "hel"
left 0 "hello" --> ""
left 9 "hi" --> "hi"
```
-}
left : Int -> String -> String
left = Kernel.kernel "String_left"


-- | `right n s` — the last `n` characters (runes). `n <= 0` → "".
{-| `right n s` — the last `n` characters; `""` when `n <= 0`.

```ipe
right 3 "hello" --> "llo"
right 0 "hello" --> ""
right 9 "hi" --> "hi"
```
-}
right : Int -> String -> String
right = Kernel.kernel "String_right"


-- | `cons c s` — prepend a character.
{-| `cons c s` — prepend character `c` to string `s`.

```ipe
cons 'h' "ello" --> "hello"
cons 'x' "" --> "x"
```
-}
cons : Char -> String -> String
cons = Kernel.kernel "String_cons"


-- | `uncons s` — split off the first character; `Nothing` on "".
{-| `uncons s` — split off the first character and the rest; `Nothing` on `""`.

```ipe
uncons "hello" --> Just ( 'h', "ello" )
uncons "" --> Nothing
uncons "x" --> Just ( 'x', "" )
```
-}
uncons : String -> Maybe ( Char, String )
uncons = Kernel.kernel "String_uncons"


-- | `pad n ch s` — centre-pad `s` to width `n` with `ch`.
{-| `pad n ch s` — centre-pad `s` to width `n` with character `ch`.

```ipe
pad 7 '.' "hello" --> ".hello."
pad 3 ' ' "hello" --> "hello"
```
-}
pad : Int -> Char -> String -> String
pad = Kernel.kernel "String_pad"


-- | `indexes sub s` — every rune start index of `sub` within `s`.
{-| `indexes sub s` — list of start indices where `sub` appears in `s`.

```ipe
indexes "l" "hello" --> [ 2, 3 ]
indexes "x" "hello" --> []
indexes "o" "foo boo" --> [ 2, 6 ]
```
-}
indexes : String -> String -> List Int
indexes = Kernel.kernel "String_indexes"


-- ─── Char-fold family ──────────────────────────────────────────────


-- | `map fn s` — transform each character.
{-| `map fn s` — transform each character of `s` with `fn`.

```ipe
map (\c -> if c == 'a' then 'x' else c) "banana" --> "bxnxnx"
map (\c -> if c == 'e' then 'a' else c) "hello" --> "hallo"
```
-}
map : (Char -> Char) -> String -> String
map = Kernel.kernel "String_map"


-- | `filter pred s` — keep only characters satisfying `pred`.
{-| `filter pred s` — keep only characters satisfying `pred`.

```ipe
filter (\c -> c /= ' ') "hello world" --> "helloworld"
filter Char.isAlpha "a1b2c3" --> "abc"
```
-}
filter : (Char -> Bool) -> String -> String
filter = Kernel.kernel "String_filter"


-- | `foldl fn acc s` — fold left over the characters.
{-| `foldl fn acc s` — reduce `s` character-by-character from the left.

```ipe
foldl (\c acc -> acc + 1) 0 "hello" --> 5
foldl (\c acc -> String.cons c acc) "" "abc" --> "cba"
```
-}
foldl : (Char -> b -> b) -> b -> String -> b
foldl = Kernel.kernel "String_foldl"


-- | `foldr fn acc s` — fold right over the characters.
{-| `foldr fn acc s` — reduce `s` character-by-character from the right.

```ipe
foldr (\c acc -> String.cons c acc) "" "abc" --> "abc"
foldr (\c acc -> acc + 1) 0 "hello" --> 5
```
-}
foldr : (Char -> b -> b) -> b -> String -> b
foldr = Kernel.kernel "String_foldr"


-- | `any pred s` — `True` if any character satisfies `pred`.
{-| `any pred s` — `True` if `pred` holds for at least one character.

```ipe
any Char.isDigit "abc3" --> True
any Char.isDigit "abc" --> False
any (\_ -> True) "" --> False
```
-}
any : (Char -> Bool) -> String -> Bool
any = Kernel.kernel "String_any"


-- | `all pred s` — `True` if every character satisfies `pred`.
{-| `all pred s` — `True` if `pred` holds for every character.

```ipe
all Char.isAlpha "hello" --> True
all Char.isAlpha "hello1" --> False
all (\_ -> True) "" --> True
```
-}
all : (Char -> Bool) -> String -> Bool
all = Kernel.kernel "String_all"
