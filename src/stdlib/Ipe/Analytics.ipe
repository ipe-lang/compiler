-- | Ipe.Analytics — typed, consent-gated product analytics.
--
-- This module provides a structured surface for emitting analytics events with
-- three security properties enforced by the type system:
--
--   1. Consent is fail-closed. `track` and `trackEvent` DROP the event and
--      return `Task.succeed ()` when consent is `Pending` or `Denied`. There
--      is no branch where an event is emitted without proof of `Granted`
--      consent — the safe outcome is the only reachable one.
--
--   2. PII is a distinct type, never a bare `String`. `Pii` wraps an opaque
--      `Secret`; the `Secret` field's runtime `IpeStringify` and `Debug` impls
--      always return the fixed redacted placeholder regardless of the wrapped
--      value — string interpolation and `Debug.log` are both
--      fail-closed by construction. The only JSON serialization path for a
--      `PPii` prop value produces `"[redacted]"` unconditionally.
--
--   3. Money is lossless. A `PMoney` prop value encodes as a JSON object
--      `{"amount":"<decimal-string>","currency":"<code>"}` — no floating-point
--      truncation.
--
-- Event union / codec:
--
-- Events are encoded via `Ipe.Codec.taggedUnion` — a single source of truth
-- for both encode and decode directions. The caller defines their event ADT
-- and supplies a `Codec Event` built with `Codec.taggedUnion`; `trackEvent`
-- routes that codec through the active sink.
--
-- Pluggable sinks:
--
-- Two concrete sinks ship: `Stderr` (development) and `Jsonl Path` (append a
-- JSONL line to a file). The custom-sink seam (a caller-supplied emit
-- function) is deferred: it requires function-in-union-ctor support (IPE-L0107
-- residual); see the tracking issue. Each sink receives the fully serialised
-- JSON line; PII is already redacted before the line reaches the sink.
--
-- Session and identity:
--
-- `Config` carries the session's consent state and optional identity. Build a
-- `Config` with `defaultConfig`, set consent with `setConsent`, record
-- identity with `identify`. All functions take a `Config` explicitly — there
-- is no mutable global; the caller threads the config value through their
-- program.
--
-- Store-backed persistence:
--
-- `eventsStore` is the typed `Ipe.Db.Store` for `AnalyticsEvent` rows. Every
-- row carries a redacted `props_json` (PII serialised as `"[redacted]"` before
-- the string reaches the database — the store never sees plaintext). Persisting
-- an event is CONSENT-GATED: `persist` drops silently on `Pending` / `Denied`.
-- `erase` deletes all rows for a user (right-to-erasure; consent-state
-- independent — deletion is the safe outcome regardless of current state).
--
-- Aggregate queries (`totals`, `uniqueUsers`, `eventCounts`, `recent`) run
-- read-only paths over the same injection-safe `Store.all` / `Store.findWhere`
-- surface. Each row decodes through `analyticsEventCodec` (typed decode,
-- fail-closed on a missing or malformed column).
--
-- Minimal store usage:
--
--     import Ipe.Analytics as Analytics exposing (Config, ConsentState(..))
--     import Ipe.Db.Store as Store
--     import Ipe.Path as Path
--
--     cfg : Config
--     cfg =
--         Analytics.defaultConfig (Analytics.Jsonl (Path.fromString "/var/log/events.jsonl"))
--             |> Analytics.setConsent Granted
--             |> Analytics.identify "user-42" Analytics.noTraits
--
--     main : Task Error ()
--     main =
--         case Analytics.eventsStore of
--             Err e ->
--                 Task.fail e
--
--             Ok store ->
--                 Store.create db store
--                     |> Task.andThen (\_ ->
--                         Analytics.persist db store cfg "button_click"
--                             (Analytics.props [ ( "label", Analytics.PText "Sign up" ) ])
--                     )
module Ipe.Analytics exposing
    ( -- Types
      Config
    , ConsentState(..)
    , Sink(..)
    , PropValue(..)
    , Props
    , Pii
    , AnalyticsEvent
      -- Pii constructors (no reveal — redact is the only serialisation path)
    , pii
    , redactedText
      -- Props
    , noProps
    , props
    , prop
      -- Traits alias
    , noTraits
      -- Config builders
    , defaultConfig
    , setConsent
    , identify
    , consentState
      -- Event emission
    , track
    , trackEvent
      -- Store-backed persistence
    , eventsStore
    , persist
    , persistEvent
    , erase
      -- Aggregate queries
    , totals
    , uniqueUsers
    , eventCounts
    , recent
      -- Low-level serialisation (exposed for testing; not a Pii leak — Pii
      -- is already redacted before this returns)
    , encodePropValue
    )


import Ipe.Codec as Codec exposing (Codec(..), Shape(..), ColType(..))
import Ipe.Json.Encode as Encode
import Ipe.Json.Decode as Decode
import Ipe.Db as Db
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Io as Io
import Ipe.File as File
import Ipe.Task as Task
import Ipe.Path as Path exposing (Path)
import Ipe.Money as Money exposing (Money(..))
import Ipe.Decimal as Dec
import Ipe.Secret as Secret
import Ipe.String as String
import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.Maybe as Maybe exposing (Maybe(..))
import Ipe.Result as Result exposing (Result(..))
import Ipe.Error as Error exposing (Error)


-- ─── Pii ──────────────────────────────────────────────────────────────────────
--
-- An opaque wrapper around a PII-bearing string. `Pii` wraps an `Ipe.Secret`
-- so every stringification path — string interpolation,
-- `Debug.log`, and the JSON encode path — is closed by construction. The
-- `Secret` field's runtime `IpeStringify` and `Debug` impls always return the
-- fixed placeholder `"<redacted>"`, never the wrapped value. `pii` is the
-- single seal (constructs a `Secret` under the cover); there is no reveal.


-- | An opaque PII-tagged string. Cannot be serialised directly — the sink
-- layer always emits `"[redacted]"` in place of the raw plaintext.
type Pii
    = Pii Secret


-- | Wrap a plaintext string as a `Pii` value. The wrapped string is sealed
-- inside the opaque constructor; no API on this module reveals it back.
pii : String -> Pii
pii s =
    Pii (Secret.fromString s)


-- | The only text this module emits for a `Pii` value: the literal string
-- `"[redacted]"`. Calling this does NOT reveal the plaintext — the result is
-- the redacted sentinel, not the wrapped string.
redactedText : Pii -> String
redactedText _ =
    "[redacted]"


-- ─── ConsentState ─────────────────────────────────────────────────────────────


-- | The three possible consent states. `track` / `trackEvent` are
-- fail-closed: any state other than `Granted` drops the event silently.
type ConsentState
    = Granted
    | Denied
    | Pending


-- ─── Sink ─────────────────────────────────────────────────────────────────────


-- | Where serialised event lines go.
--
-- `Stderr` — emit to stderr, one JSON line per event; useful for local
-- development without any persistent store.
--
-- `Jsonl Path` — append one JSON line per event to the file at `path`,
-- creating it if absent. All bytes are flushed before the Task resolves.
--
-- A custom-sink variant (caller-supplied emit function) is deferred; it
-- requires function-in-union-ctor support (IPE-L0107 residual).
type Sink
    = Stderr
    | Jsonl Path


-- ─── PropValue ────────────────────────────────────────────────────────────────


-- | A typed analytics property value. Every branch serialises safely:
--
--   * `PText`  — a plain string (non-PII).
--   * `PInt`   — an integer.
--   * `PFloat` — a floating-point number.
--   * `PBool`  — a boolean.
--   * `PMoney` — encodes as `{"amount":"<decimal>","currency":"<code>"}`;
--                lossless across all ISO-4217 currencies.
--   * `PPii`   — always serialises as `"[redacted]"`; the plaintext is sealed.
type PropValue
    = PText String
    | PInt Int
    | PFloat Float
    | PBool Bool
    | PMoney Money
    | PPii Pii


-- ─── Props ────────────────────────────────────────────────────────────────────


-- | A bag of named property values for an event or identity.
type alias Props =
    Dict String PropValue


-- | An empty `Props`.
noProps : Props
noProps =
    Dict.empty


-- | Build a `Props` from a list of `(name, value)` pairs.
props : List ( String, PropValue ) -> Props
props pairs =
    List.foldl insertProp Dict.empty pairs


insertProp : ( String, PropValue ) -> Props -> Props
insertProp pair acc =
    case pair of
        ( k, v ) ->
            Dict.insert k v acc


-- | Insert one property into an existing `Props`.
prop : String -> PropValue -> Props -> Props
prop k v existing =
    Dict.insert k v existing


-- | Synonym for `noProps` used in the identity position.
noTraits : Props
noTraits =
    noProps


-- ─── Config ───────────────────────────────────────────────────────────────────


-- | Session configuration: which sink to use, the current consent state, and
-- an optional identity (`userId` + trait `Props`).
--
-- Build with `defaultConfig`, then thread through `setConsent` / `identify`.
type alias Config =
    { sink : Sink
    , consent : ConsentState
    , userId : Maybe String
    , traits : Props
    }


-- | A `Config` starting in the `Pending` state (fail-closed default) with no
-- identity. Call `setConsent Granted` before any `track*` calls, or those
-- calls will drop silently.
defaultConfig : Sink -> Config
defaultConfig sink =
    { sink = sink
    , consent = Pending
    , userId = Nothing
    , traits = noTraits
    }


-- | Replace the consent state in a `Config`.
setConsent : ConsentState -> Config -> Config
setConsent state cfg =
    { cfg | consent = state }


-- | Record the user's identity and optional trait properties.
identify : String -> Props -> Config -> Config
identify userId traits cfg =
    { cfg | userId = Just userId, traits = traits }


-- | Read the current consent state from a `Config`.
consentState : Config -> ConsentState
consentState cfg =
    cfg.consent


-- ─── Serialisation ────────────────────────────────────────────────────────────
--
-- `encodePropValue` converts a `PropValue` to a JSON `Value`. The critical
-- invariant: `PPii` always encodes as the literal string `"[redacted]"`,
-- never as its wrapped plaintext. `PMoney` encodes losslessly as a
-- two-field object (decimal string + currency code).


-- | Encode one `PropValue` to a JSON `Value`. `PPii` → `"[redacted]"`,
-- `PMoney` → `{"amount":"…","currency":"…"}`, all others as expected.
encodePropValue : PropValue -> Value
encodePropValue v =
    case v of
        PText s ->
            Encode.string s

        PInt n ->
            Encode.int n

        PFloat x ->
            Encode.float x

        PBool b ->
            Encode.bool b

        PMoney m ->
            Encode.object
                [ ( "amount", Encode.string (Dec.toString (Money.amount m)) )
                , ( "currency", Encode.string (Money.currencyCode (Money.currency m)) )
                ]

        PPii _ ->
            Encode.string "[redacted]"


encodeProps : Props -> Value
encodeProps p =
    Encode.object (List.map encodePropPair (Dict.toList p))


encodePropPair : ( String, PropValue ) -> ( String, Value )
encodePropPair pair =
    case pair of
        ( k, v ) ->
            ( k, encodePropValue v )


-- | Build the JSON line for a named event: a JSON object with `event`, `userId`
-- (when present), and `props` fields.
encodeEvent : Config -> String -> Props -> String
encodeEvent cfg eventName eventProps =
    let
        base =
            [ ( "event", Encode.string eventName )
            , ( "props", encodeProps eventProps )
            ]

        withUser =
            case cfg.userId of
                Just uid ->
                    ( "userId", Encode.string uid ) :: base

                Nothing ->
                    base
    in
    Encode.encode 0 (Encode.object withUser)


-- | Build the JSON line for a codec-encoded event. The codec encodes the event
-- value to a JSON `Value`; this function wraps it with the session envelope
-- (`userId`, `props`).
encodeEventValue : Config -> Value -> Props -> String
encodeEventValue cfg eventValue eventProps =
    let
        base =
            [ ( "event", eventValue )
            , ( "props", encodeProps eventProps )
            ]

        withUser =
            case cfg.userId of
                Just uid ->
                    ( "userId", Encode.string uid ) :: base

                Nothing ->
                    base
    in
    Encode.encode 0 (Encode.object withUser)


-- ─── Sink dispatch ────────────────────────────────────────────────────────────


-- | Write one serialised JSON line to the configured sink.
emitLine : Config -> String -> Task Error ()
emitLine cfg line =
    case cfg.sink of
        Stderr ->
            Io.eprintln line

        Jsonl path ->
            File.append path (line ++ "\n")


-- ─── Event emission (fail-closed) ─────────────────────────────────────────────


-- | `track cfg eventName eventProps` — emit a named event with a property bag.
--
-- Fail-closed: when consent is `Pending` or `Denied` the event is dropped and
-- `Task.succeed ()` is returned. The event only reaches the sink when consent
-- is `Granted`.
track : Config -> String -> Props -> Task Error ()
track cfg eventName eventProps =
    case cfg.consent of
        Granted ->
            emitLine cfg (encodeEvent cfg eventName eventProps)

        Denied ->
            Task.succeed ()

        Pending ->
            Task.succeed ()


-- | `trackEvent cfg codec event eventProps` — emit an event encoded by the
-- caller's `Codec`, plus a supplementary `Props` bag.
--
-- The caller constructs their event ADT and supplies a `Codec Event` built
-- with `Codec.taggedUnion` (or any other `Codec`). The codec encodes the
-- event value to a JSON `Value`; this function wraps it in the session
-- envelope and dispatches to the sink.
--
-- Fail-closed: when consent is `Pending` or `Denied` the event is dropped and
-- `Task.succeed ()` is returned. No codec encoding and no sink write happen.
trackEvent : Config -> Codec a -> a -> Props -> Task Error ()
trackEvent cfg codec event eventProps =
    case cfg.consent of
        Granted ->
            let
                eventValue =
                    Codec.toValue codec event
            in
            emitLine cfg (encodeEventValue cfg eventValue eventProps)

        Denied ->
            Task.succeed ()

        Pending ->
            Task.succeed ()


-- ─── Store-backed persistence ──────────────────────────────────────────────────
--
-- `AnalyticsEvent` is the concrete row type stored in the `ipe_analytics_events`
-- table. The `propsJson` column holds the already-redacted JSON string produced
-- by `encodeProps` — PII is serialised as `"[redacted]"` BEFORE this string
-- reaches the database. The store never sees plaintext PII.
--
-- The schema derives from `analyticsEventCodec` (one source of truth for the
-- columns, the writes, and the reads); the column names are the record's field
-- names snake_cased, matching how `Codec.auto` derives them:
--   id           INTEGER  PRIMARY KEY, db-assigned serial (omitted from writes)
--   event_name   TEXT     the event name
--   user_id      TEXT     the userId from Config, or "" when absent
--   props_json   TEXT     JSON object of prop values, PII already redacted
--   recorded_at  TEXT     ISO-8601 timestamp, db-stamped DEFAULT (omitted from writes)
--
-- Security argument:
--   * PII-safe: `propsJson` is built by `encodeProps`, which routes every
--     `PPii` branch through `encodePropValue`, which returns `"[redacted]"`.
--     No path from `pii s` back to `s` exists on this module's surface.
--   * Consent-gated: `persist` and `persistEvent` pattern-match on
--     `cfg.consent` and return `Task.succeed ()` on `Pending` / `Denied`.
--   * Injection-safe: all writes route through `Store.insert` (typed
--     `SqlValue` params, no interpolation); all reads through `Store.all` /
--     `Store.findWhere` over `SqlFragment`s built from `Sql.column` +
--     `Sql.param`.


-- | A persisted analytics event row.
--
-- `recordedAt` is a DB-stamped ISO-8601 timestamp string (SQLite
-- `CURRENT_TIMESTAMP`). The column is read back as text; ordering in `recent`
-- uses lexicographic order, which matches temporal order for ISO-8601 strings.
type alias AnalyticsEvent =
    { id : Int
    , eventName : String
    , userId : String
    , propsJson : String
    , recordedAt : String
    }


-- | A zero-valued `AnalyticsEvent` witness. `Codec.auto` reads a record's field
-- names and types from a top-level annotated value; an inline record literal at
-- the `Codec.auto` call site is rejected (IPE-N0041), so the witness is named.
blankAnalyticsEvent : AnalyticsEvent
blankAnalyticsEvent =
    { id = 0
    , eventName = ""
    , userId = ""
    , propsJson = ""
    , recordedAt = ""
    }


-- | The `Codec AnalyticsEvent` — the single source of truth for the store's
-- columns, its row writes, and its row reads. Its `Shape` is an `SRecord` whose
-- columns are the record's field names snake_cased (`eventName` → `event_name`),
-- so the store's schema, the insert binds, and the row decode all derive from
-- this one value. A field renamed or retyped changes exactly one place.
analyticsEventCodec : Codec AnalyticsEvent
analyticsEventCodec =
    Codec.auto blankAnalyticsEvent


-- | The typed `Store AnalyticsEvent`. Built from `analyticsEventCodec`, so its
-- columns, writes, and reads are one derivation from that codec. `id` is a
-- DB-assigned serial primary key and `recordedAt` is DB-stamped on insert — both
-- are OMITTED from every client write, so a client value can never overwrite a
-- generated column. Returns `Err` only if an identifier is rejected by
-- `Store.validSqlIdent` — which cannot happen for the codec-derived names here.
-- Call `Store.create conn eventsStore` once at startup to ensure the table exists.
eventsStore : Result Error (Store AnalyticsEvent)
eventsStore =
    case Store.fromCodec "ipe_analytics_events" analyticsEventCodec of
        Err e ->
            Err e

        Ok s ->
            Ok (Store.public (Store.serial .id (Store.primaryKey .id (Store.defaultNow .recordedAt s))))


-- | `persist db store cfg eventName eventProps` — persist a named event with a
-- property bag.
--
-- Consent-gated: returns `Task.succeed ()` without any DB write when consent
-- is `Pending` or `Denied`.
--
-- PII-safe: `eventProps` is serialised by `encodeProps`, which routes every
-- `PPii` branch to `"[redacted]"`. The stored `props_json` string never
-- contains plaintext PII.
persist : Db -> Store AnalyticsEvent -> Config -> String -> Props -> Task Error ()
persist db store cfg eventName eventProps =
    case cfg.consent of
        Granted ->
            let
                uid =
                    case cfg.userId of
                        Just u ->
                            u

                        Nothing ->
                            ""

                pj =
                    Encode.encode 0 (encodeProps eventProps)

                ev =
                    { id = 0
                    , eventName = eventName
                    , userId = uid
                    , propsJson = pj
                    , recordedAt = ""
                    }
            in
            Task.map (\_ -> ()) (Store.insert db store ev)

        Denied ->
            Task.succeed ()

        Pending ->
            Task.succeed ()


-- | `persistEvent db store cfg codec event eventProps` — persist an event
-- encoded by the caller's `Codec`, plus a supplementary `Props` bag.
--
-- Consent-gated and PII-safe: same guarantees as `persist`.
persistEvent : Db -> Store AnalyticsEvent -> Config -> Codec a -> a -> Props -> Task Error ()
persistEvent db store cfg codec event eventProps =
    case cfg.consent of
        Granted ->
            let
                uid =
                    case cfg.userId of
                        Just u ->
                            u

                        Nothing ->
                            ""

                eventName =
                    Encode.encode 0 (Codec.toValue codec event)

                pj =
                    Encode.encode 0 (encodeProps eventProps)

                ev =
                    { id = 0
                    , eventName = eventName
                    , userId = uid
                    , propsJson = pj
                    , recordedAt = ""
                    }
            in
            Task.map (\_ -> ()) (Store.insert db store ev)

        Denied ->
            Task.succeed ()

        Pending ->
            Task.succeed ()


-- | `erase db store cfg` — delete all persisted rows for the `Config`'s
-- `userId`. Consent-state independent: GDPR right-to-erasure must succeed
-- regardless of whether consent is currently `Granted`. Returns `Task.fail`
-- when `cfg.userId` is `Nothing` (no identity to erase).
erase : Db -> Store AnalyticsEvent -> Config -> Task Error Int
erase db store cfg =
    case cfg.userId of
        Nothing ->
            Task.fail noUserIdError

        Just uid ->
            Store.deleteWhere db store (Store.eq .userId uid)


-- ─── Aggregate queries ─────────────────────────────────────────────────────────
--
-- All read paths route through `Store.all`, which uses the audited
-- `Db.findWhere` kernel — every identifier through `Sql.column` (validated),
-- every value through `Sql.param` (bound). No raw SQL is built. `Store.all`
-- decodes each row through `analyticsEventCodec`, so a row missing or mistyping
-- a column is a typed `Task.fail`, never a wrong value.


-- | Read and decode every stored `AnalyticsEvent`. Decoding is the codec's, so
-- a row missing or mistyping a column is a typed `Task.fail`, never a wrong value.
readAllEvents : Db -> Store AnalyticsEvent -> Task Error (List AnalyticsEvent)
readAllEvents db store =
    Store.all db store


-- | `totals db store` — the total count of persisted events.
totals : Db -> Store AnalyticsEvent -> Task Error Int
totals db store =
    Task.map List.length (readAllEvents db store)


-- | `uniqueUsers db store` — the count of distinct `userId` values in the
-- store (excludes the empty-string sentinel used for anonymous events).
uniqueUsers : Db -> Store AnalyticsEvent -> Task Error Int
uniqueUsers db store =
    Task.map countDistinctUsers (readAllEvents db store)


countDistinctUsers : List AnalyticsEvent -> Int
countDistinctUsers events =
    let
        ids =
            List.filterMap nonEmpty (List.map (\ev -> ev.userId) events)
    in
    List.length (List.foldl addUnique [] ids)


nonEmpty : String -> Maybe String
nonEmpty s =
    if String.isEmpty s then
        Nothing

    else
        Just s


addUnique : String -> List String -> List String
addUnique s acc =
    if List.member s acc then
        acc

    else
        s :: acc


-- | `eventCounts db store` — a dictionary mapping each event name to the
-- number of times it appears in the store.
eventCounts : Db -> Store AnalyticsEvent -> Task Error (Dict String Int)
eventCounts db store =
    Task.map tallyNames (readAllEvents db store)


tallyNames : List AnalyticsEvent -> Dict String Int
tallyNames events =
    List.foldl countName Dict.empty events


countName : AnalyticsEvent -> Dict String Int -> Dict String Int
countName ev acc =
    case Dict.get ev.eventName acc of
        Just n ->
            Dict.insert ev.eventName (n + 1) acc

        Nothing ->
            Dict.insert ev.eventName 1 acc


-- | `recent db store limit` — the `limit` most-recently recorded events,
-- ordered newest-first by `recordedAt`. All columns read and decoded; PII was
-- already redacted at persist time, so the returned `propsJson` field holds
-- only redacted values.
recent : Db -> Store AnalyticsEvent -> Int -> Task Error (List AnalyticsEvent)
recent db store limit =
    Task.map (\evs -> List.take limit (sortByRecent evs)) (readAllEvents db store)


sortByRecent : List AnalyticsEvent -> List AnalyticsEvent
sortByRecent events =
    List.sortWith compareByTs events


compareByTs : AnalyticsEvent -> AnalyticsEvent -> Order
compareByTs a b =
    if b.recordedAt > a.recordedAt then
        LT

    else if b.recordedAt < a.recordedAt then
        GT

    else
        EQ


-- ─── Errors ────────────────────────────────────────────────────────────────────


noUserIdError : Error
noUserIdError =
    Error.invalidInput
        "Ipe.Analytics.erase: Config has no userId — call Analytics.identify first"
