-- | Ipe.WebSocket — outbound WebSocket client.
--
-- Opens a long-lived bidirectional connection to a peer.  Incoming
-- frames surface as `Sub` events on a Ipe.Web update loop (mirror
-- of `Ipe.Http.Stream.chunks`); outbound `send` queues a text
-- or binary frame for the socket's writer.
--
-- Driving use cases: bidirectional LLM chat, collab editor ops,
-- multiplayer game state, financial feeds.  When you need request
-- /response with no incremental body Http.get is the right tool;
-- this is for the long-lived bidirectional case.
--
-- URLs must be `ws://` or `wss://` (prefer `wss://` for encrypted
-- connections).  Build a `WsUrl` via `WebSocket.url` — a plain
-- `String` or an `http://` URL is a type error.
--
-- Dial rule: a URL with `\` anywhere, or `@` in its path or fragment, is
-- refused (its credentials could run into the host) — write `@` as `%40`.
-- An `@` in the query is allowed, but an error for that URL then withholds
-- the host.
--
-- Lifecycle:
--
--  1. `Cmd.perform (WebSocket.connect wsUrl) Connected` — kick
--     off the handshake.  The runtime returns a `WebSocket` once the
--     handshake completes (no message wait).
--
--  2. `subscriptions model = WebSocket.onMessage sock GotFrame` —
--     subscribe to incoming frames.  Each `Text String` or
--     `Binary String` Msg flows through `update`.
--
--  3. `WebSocket.send sock "hello"` — queue a text frame.  Never
--     blocks: a full outbound queue fails the task at once.
--
--  4. `WebSocket.close sock` — release the connection.  Idempotent.
--
-- Ownership: a socket belongs to no Ipe.Web session.  It stays open
-- until `close`, a close from the peer, or a failed read or write
-- ends it; evicting a session does not close it, so close a socket
-- in `update` once the program no longer needs it.
--
-- Heartbeat: `connect` sends no pings.  `connectWith` pings every
-- `pingInterval` milliseconds unless it is zero; a span below zero or
-- past 10 minutes refuses the connect with an `InvalidInput` error.
-- `defaultCfg` sets 30 s.  Pings from the peer are answered
-- automatically.  In the browser both spans are judged the same way
-- but not applied: the browser owns the ping/pong exchange.
-- Pongs are not tracked: a peer that stops answering pings is not
-- detected by the heartbeat.
--
-- Backpressure: `send` never blocks.  Each socket queues at most
-- 1024 outbound frames; past that `send` fails at once, and a
-- message past `IPE_WS_MAX_MESSAGE_BYTES` fails with
-- `LimitExceeded`.  A peer that stops reading cannot stall the
-- program: a close it never answers ends the socket within 5 s,
-- the reply to a close it sends is given at most 5 s to go out,
-- and a write that fails tears the socket down through `onError`.
-- Incoming frames never wait for the program: each subscription
-- buffers up to 64 of them, a subscription that falls further
-- behind skips the frames it missed, and a frame that arrives while
-- no subscription is listening is dropped.  Skipped and dropped
-- frames are not counted.
--
-- See `examples/33-websocket-echo` for the canonical pattern.
module Ipe.WebSocket exposing
    ( WebSocket(..)
    , WebSocketMessage(..)
    , CloseCode(..)
    , WsUrl
    , url
    , toUrl
    , WebSocketCfg
    , defaultCfg
    , withHeaders
    , withTimeout
    , withPingInterval
    , connect
    , connectWith
    , send
    , sendBinary
    , close
    , closeWithCode
    , onOpen
    , onMessage
    , onClose
    , onError
    )

import Ipe.Ffi.Kernel as Kernel
import Ipe.Bytes exposing (Bytes)
import Ipe.Error exposing (Error)
import Ipe.Task as Task
import Ipe.Duration as Duration exposing (Duration)
import Ipe.Url as Url exposing (Url)
import Ipe.Result exposing (Result(..))


-- | Opaque handle to an open WebSocket.  The wrapped `Int` is the
-- runtime's per-socket id; user code treats it as opaque.
type WebSocket
    = WebSocket Int


-- | One incoming frame from the peer.
--
--   * `Text String` — UTF-8 text frame.
--   * `Binary Bytes` — raw byte frame (`Vec<u8>` on Rust).
type WebSocketMessage
    = Text String
    | Binary Bytes


-- | A WebSocket close code.  Either one of the standard symbolic
-- codes OR a `Custom Int` for application-defined codes (1000-4999).
type CloseCode
    = Normal
    | GoingAway
    | UnsupportedData
    | InternalError
    | Custom Int


-- | An opaque WebSocket URL.  The ONLY way to build one is `WebSocket.url`,
-- which accepts a `Ipe.Url.Url` and rejects any scheme other than `ws` or
-- `wss`.  A non-WebSocket URL is a construction-time `Err`, never a value
-- that reaches a live socket.  Prefer `wss://` for encrypted connections.
type WsUrl
    = WsUrl Url


-- | `url u` — the parse-don't-validate seal for WebSocket URLs.  Returns `Ok`
-- when `u`'s scheme is `"ws"` or `"wss"`, otherwise `Err`.
url : Url -> Result Error WsUrl
url u =
    let
        s = Url.scheme u
    in
    if s == "ws" || s == "wss" then
        Ok (WsUrl u)

    else
        Err (Error.invalidInput "Ipe.WebSocket.url: scheme must be ws or wss")


-- | `toUrl wsUrl` — recover the underlying `Url` (e.g. to read the host).
toUrl : WsUrl -> Url
toUrl w =
    case w of
        WsUrl u ->
            u


-- | Connect configuration record for `connectWith`.
--
-- Every typed record ships with a `default` constructor + `with*`
-- builder helpers so adding new fields in future releases doesn't
-- break downstream record literals.
type alias WebSocketCfg =
    { url : String
    , headers : List ( String, String )
    , timeout : Int
    , pingInterval : Int
    }


-- | The default handshake timeout and ping cadence applied by `defaultCfg`: 30
-- seconds each, spelled as a typed `Ipe.Duration` rather than a bare
-- millisecond literal so the unit is explicit and a negative floor is
-- unrepresentable.  The raw milliseconds are recovered once, here, for the
-- transport DTO the runtime `WsClientCfg` fold consumes.
defaultTimeout : Duration
defaultTimeout =
    Duration.seconds 30


-- | Default WebSocketCfg.  All-defaults values.  Override fields
-- with the `with*` builder helpers.  The time-span defaults come from the typed
-- `defaultTimeout`, unwrapped to milliseconds only here at the DTO boundary, so
-- no bare `30000` literal survives in the surface.
defaultCfg : WsUrl -> WebSocketCfg
defaultCfg w =
    { url = Url.toString (toUrl w)
    , headers = []
    , timeout = Duration.toMillis defaultTimeout
    , pingInterval = Duration.toMillis defaultTimeout
    }


-- | Override the HTTP headers (e.g. Authorization) sent on the
-- upgrade handshake.
withHeaders : List ( String, String ) -> WebSocketCfg -> WebSocketCfg
withHeaders headers cfg =
    { cfg | headers = headers }


-- | Override the handshake timeout (default 30 s).  Takes a typed
-- `Ipe.Duration` (e.g. `Duration.seconds 30`); the raw milliseconds are
-- unwrapped into the transport DTO for the runtime.
--
-- The runtime admits a deadline from 1 millisecond to 10 minutes and refuses
-- the connect with an `InvalidInput` error otherwise: `Duration.zero` is
-- refused (it never means "no deadline" or "the default"), and a span past
-- 10 minutes is refused rather than cut down.  In the browser the span is
-- judged the same way but not applied: the browser owns the handshake
-- deadline.
withTimeout : Duration -> WebSocketCfg -> WebSocketCfg
withTimeout timeout cfg =
    { cfg | timeout = Duration.toMillis timeout }


-- | Override the ping interval (default 30 s).  Takes a typed `Ipe.Duration`;
-- `Duration.zero` disables application-level pings entirely.  The raw
-- milliseconds are unwrapped into the transport DTO for the runtime, which
-- admits `Duration.zero` or a span from 1 millisecond to 10 minutes and
-- refuses the connect with an `InvalidInput` error otherwise.
withPingInterval : Duration -> WebSocketCfg -> WebSocketCfg
withPingInterval interval cfg =
    { cfg | pingInterval = Duration.toMillis interval }


-- | Internal — direct kernel alias.  Returns a bare `Task Error Int`;
-- the public `connect` wraps it in `WebSocket`.
connectRaw : String -> Task Error Int
connectRaw =
    Kernel.kernel "WebSocket_connect"


-- | `connect wsUrl` — open a new WebSocket to `wsUrl` (`ws://` or `wss://`).
-- The `WsUrl` constructor rejects any other scheme at construction time, so
-- a non-WebSocket address is a type error, never a runtime surprise.  The
-- Task resolves once the handshake completes; frames flow via `onMessage`
-- after that.  A handshake past the size limit fails the Task with a
-- `LimitExceeded` error.
connect : WsUrl -> Task Error WebSocket
connect w =
    Task.map WebSocket (connectRaw (Url.toString (toUrl w)))


-- | Internal — direct kernel alias for the typed-record cfg form.
connectWithRaw : WebSocketCfg -> Task Error Int
connectWithRaw =
    Kernel.kernel "WebSocket_connectWith"


-- | `connectWith cfg` — connect with custom headers / timeout /
-- ping cadence.  Build the cfg via `defaultCfg url |> withHeaders
-- [...]` etc. so future field additions don't break call sites.
connectWith : WebSocketCfg -> Task Error WebSocket
connectWith cfg =
    Task.map WebSocket (connectWithRaw cfg)


-- | Internal — direct kernel alias.
sendRaw : Int -> String -> Task Error ()
sendRaw =
    Kernel.kernel "WebSocket_send"


-- | `send sock text` — queue a text frame.  Never blocks: a full
-- outbound queue fails the task at once.
send : WebSocket -> String -> Task Error ()
send sock msg =
    case sock of

        WebSocket raw ->
            sendRaw raw msg


sendBinaryRaw : Int -> Bytes -> Task Error ()
sendBinaryRaw =
    Kernel.kernel "WebSocket_sendBinary"


-- | `sendBinary sock bytes` — write a binary frame.  Takes `Bytes`
-- (a distinct primitive in this backend, unlike the reference's
-- String alias — sanctioned divergence §B18).
sendBinary : WebSocket -> Bytes -> Task Error ()
sendBinary sock msg =
    case sock of

        WebSocket raw ->
            sendBinaryRaw raw msg


closeRaw : Int -> Task Error ()
closeRaw =
    Kernel.kernel "WebSocket_close"


-- | `close sock` — release the connection (sends a Normal close
-- frame).  Idempotent.
close : WebSocket -> Task Error ()
close sock =
    case sock of

        WebSocket raw ->
            closeRaw raw


closeWithCodeRaw : Int -> String -> Int -> Task Error ()
closeWithCodeRaw =
    Kernel.kernel "WebSocket_closeWithCode"


-- | `closeWithCode code reason sock` — release the connection with
-- a custom close code + reason.  The reason is cut to its first
-- 123 bytes (at a character boundary), the most a close frame
-- carries.
closeWithCode : CloseCode -> String -> WebSocket -> Task Error ()
closeWithCode code reason sock =
    case sock of

        WebSocket raw ->
            closeWithCodeRaw (closeCodeToInt code) reason raw


-- | Map a CloseCode ADT to the WebSocket integer code.
closeCodeToInt : CloseCode -> Int
closeCodeToInt code =
    case code of

        Normal ->
            1000

        GoingAway ->
            1001

        UnsupportedData ->
            1003

        InternalError ->
            1011

        Custom n ->
            n


-- | Internal — direct kernel alias.  `kind` selects which event
-- class this Sub receives: "open" | "message" | "close" | "error".
subscribeWebSocketRaw : Int -> String -> any -> Sub msg
subscribeWebSocketRaw =
    Kernel.kernel "Sub_subscribeWebSocket"


-- | `onOpen sock msg` — dispatch `msg` once the socket is connected.
-- The Sub is one-shot semantically (the connection opens at most
-- once over its lifetime); subsequent re-subscriptions are no-ops.
onOpen : WebSocket -> msg -> Sub msg
onOpen sock msg =
    case sock of

        WebSocket raw ->
            subscribeWebSocketRaw raw "open" msg


-- | `onMessage sock toMsg` — dispatch `toMsg event` for every
-- incoming frame.
onMessage : WebSocket -> (WebSocketMessage -> msg) -> Sub msg
onMessage sock toMsg =
    case sock of

        WebSocket raw ->
            subscribeWebSocketRaw raw "message" toMsg


-- | `onClose sock toMsg` — dispatch `toMsg closeCode` when the
-- peer (or this side) closes the connection.
onClose : WebSocket -> (CloseCode -> msg) -> Sub msg
onClose sock toMsg =
    case sock of

        WebSocket raw ->
            subscribeWebSocketRaw raw "close" toMsg


-- | `onError sock toMsg` — dispatch `toMsg err` on a network /
-- protocol error.  A message or frame past `IPE_WS_MAX_MESSAGE_BYTES`
-- dispatches a `LimitExceeded` error.  The socket is closed automatically
-- after the error is dispatched.
onError : WebSocket -> (Error -> msg) -> Sub msg
onError sock toMsg =
    case sock of

        WebSocket raw ->
            subscribeWebSocketRaw raw "error" toMsg
