-- ── Retained native primitives ───────────────────────────────────────────────
-- The irreducible `Element` constructors. Every layout builder below is pure
-- Ipê over `node` / `taggedNode`.
-- | `node desc attrs children` — a container `Element` carrying a role
-- `Description`, attributes, and children verbatim.
node : Description -> List (Attribute msg) -> List (Element msg) -> Element msg
node =
    Kernel.kernel "Ui_node"


-- | `taggedNode tag desc attrs children` — a tag-fixed `Element`.
taggedNode : String -> Description -> List (Attribute msg) -> List (Element msg) -> Element msg
taggedNode =
    Kernel.kernel "Ui_taggedNode"


-- Module-local `Description` producers backing the sugar below (NOT exposed).
descNone : Description
descNone =
    Kernel.kernel "Ui_descNone"


descParagraph : Description
descParagraph =
    Kernel.kernel "Ui_descParagraph"


-- ── Retained native surface ──────────────────────────────────────────────────
-- These stay native and are re-exposed here through the alias mechanism so
-- `Ui.layout` / `Ui.spacing` / `Ui.button` / … keep resolving from user code.
-- | `layout attrs element` — render a root `Element` to `Html`.
layout : List (Attribute msg) -> Element msg -> Html msg
layout =
    Kernel.kernel "Ui_layout"


-- | `layoutWith { wrapperAttrs, rootAttrs } element` — `layout` with explicit
-- wrapper + root attribute sets.
layoutWith : { wrapperAttrs : List (Attribute msg), rootAttrs : List (Attribute msg) } -> Element msg -> Html msg
layoutWith =
    Kernel.kernel "Ui_layoutWith"


-- | `none` — the empty `Element`.
none : Element msg
none =
    Kernel.kernel "Ui_none"


-- | `text s` — a text `Element`.
text : String -> Element msg
text =
    Kernel.kernel "Ui_text"


-- | `html h` — embed raw `Html` inside a `Ui` view.
html : Html msg -> Element msg
html =
    Kernel.kernel "Ui_html"


-- | `cells grid` — a raw terminal cell grid (one inner list per row).
cells : List (List Char) -> Element msg
cells =
    Kernel.kernel "Ui_cells"


-- | `button attrs { onPress, label }` — a `<button>` with an optional press msg.
button : List (Attribute msg) -> { onPress : Maybe msg, label : Element msg } -> Element msg
button =
    Kernel.kernel "Ui_button"


-- | The schemes a hyperlink may target: `http`/`https` for web, plus `mailto`
-- and `tel` for the two safe non-web anchor schemes. A `javascript:` / `data:`
-- / `file:` target is rejected at `linkTarget`, so it has no representation at
-- the `<a href>` sink.
linkSchemes : List String
linkSchemes =
    [ "http", "https", "mailto", "tel" ]


-- | An opaque, safe hyperlink target — EITHER a scheme-narrowed absolute `Url`
-- (`http`/`https`/`mailto`/`tel`) OR a validated same-origin relative reference
-- (`/page`). The ONE constructor `linkTarget` fails closed, so a value of this
-- type is always safe as an `href` — the proof `Ui.link` consumes TOTALLY. A
-- raw `String` cannot reach `link` directly.
type LinkTarget
    = LinkAbsolute Url
    | LinkRelative Relative


-- | `linkTarget raw` — the ONE parse-don't-validate seal for a hyperlink target,
-- dispatched exactly as a browser reads an `href`: an absolute URL if `raw`
-- parses as one (then scheme-narrowed to `http`/`https`/`mailto`/`tel`),
-- otherwise a validated same-origin relative reference. Fail-closed: a
-- `javascript:` / `data:` / `file:` scheme, a protocol-relative (`//host`), or a
-- cross-origin string is a typed `Err`, never rendered into an `href`.
linkTarget : String -> Result Error LinkTarget
linkTarget raw =
    case Url.fromString raw of
        Ok u ->
            Result.map LinkAbsolute (Url.checkScheme linkSchemes u)

        Err _ ->
            Result.map LinkRelative (Url.relative raw)


-- | The schemes a media `src` (an `<img src>` fetch sink) may target:
-- `http`/`https` ONLY. A `src` is a resource the browser FETCHES, a distinct
-- role from a navigation `href` — so it does NOT admit the anchor schemes
-- `mailto`/`tel` that `linkSchemes` allows.
mediaSchemes : List String
mediaSchemes =
    [ "http", "https" ]


-- | An opaque, safe media target for the `<img src>` sink — EITHER a
-- scheme-narrowed absolute `Url` (`http`/`https` only) OR a validated
-- same-origin relative reference (`/logo.png`). The ONE constructor `imageSrc`
-- fails closed. Distinct from `LinkTarget`: a `mailto:` / `tel:` string parses
-- to a `LinkTarget` but has NO `MediaTarget` representation, so it cannot reach
-- the `<img src>` sink.
type MediaTarget
    = MediaAbsolute Url
    | MediaRelative Relative


-- | `imageSrc raw` — the ONE parse-don't-validate seal for a media `src` target:
-- an absolute URL if `raw` parses as one (then scheme-narrowed to `http`/`https`
-- via `mediaSchemes`), otherwise a validated same-origin relative reference.
-- Fail-closed: a `mailto:` / `tel:` / `javascript:` / `data:` / `file:` scheme,
-- a protocol-relative (`//host`), or a cross-origin string is a typed `Err`.
imageSrc : String -> Result Error MediaTarget
imageSrc raw =
    case Url.fromString raw of
        Ok u ->
            Result.map MediaAbsolute (Url.checkScheme mediaSchemes u)

        Err _ ->
            Result.map MediaRelative (Url.relative raw)


-- | Private kernel: takes a raw `String` href for the `<a href=…>` attribute.
linkKernel : List (Attribute msg) -> { url : String, label : Element msg } -> Element msg
linkKernel =
    Kernel.kernel "Ui_link"


-- | `link attrs { url, label }` — an `<a href=…>` link.  `url` is a typed, safe
-- `LinkTarget` (build one with `Ui.linkTarget`); a bare `String` or an
-- unvetted-scheme URL is a type error, so a `javascript:` href cannot be
-- smuggled through. The `case` is exhaustive over both arms — no wildcard.
link : List (Attribute msg) -> { url : LinkTarget, label : Element msg } -> Element msg
link attrs rec =
    case rec.url of
        LinkAbsolute u ->
            linkKernel attrs { url = Url.toString u, label = rec.label }

        LinkRelative ref ->
            linkKernel attrs { url = Url.relativeToString ref, label = rec.label }


-- | Private kernel: takes a raw `String` src for the `<img src=…>` attribute.
imageKernel : List (Attribute msg) -> { src : String, description : String } -> Element msg
imageKernel =
    Kernel.kernel "Ui_image"


-- | An opaque image source: EITHER a safe `MediaTarget` (a scheme-narrowed URL
-- restricted to `http`/`https`, or a same-origin path, built with `imageSrc`)
-- via `imageUrl`, OR an inline `data:` image via `imageData`. The constructors
-- fail closed, so a raw `String`, a `mailto:`/`tel:`, or a non-network scheme
-- cannot reach the `<img src>` sink.
type ImageValue
    = ImageFromTarget MediaTarget
    | ImageFromData { mime : String, base64 : String }


-- | `imageUrl target` — a remote or same-origin image from a safe `MediaTarget`
-- (build one with `imageSrc`).
imageUrl : MediaTarget -> ImageValue
imageUrl target =
    ImageFromTarget target


-- | `imageData { mime, base64 }` — an inline image from base64-encoded bytes.
-- `mime` is the MIME type (e.g. `"image/png"`); `base64` is the payload without
-- the `data:` prefix. The ONE thing that is not a URL.
imageData : { mime : String, base64 : String } -> ImageValue
imageData rec =
    ImageFromData rec


-- | `imageValueToString value` — the string an HTML `src` attribute accepts:
-- the target's rendered form, or `data:<mime>;base64,<base64>` for inline data.
imageValueToString : ImageValue -> String
imageValueToString value =
    case value of
        ImageFromTarget target ->
            case target of
                MediaAbsolute u ->
                    Url.toString u

                MediaRelative ref ->
                    Url.relativeToString ref

        ImageFromData rec ->
            "data:" ++ rec.mime ++ ";base64," ++ rec.base64


-- | `image attrs { src, description }` — an `<img src=… alt=…>`.  `src` is a
-- typed `ImageValue` — either a validated `MediaTarget` (`imageUrl`, narrowed to
-- `http`/`https` or a same-origin path) or an inline data image
-- (`imageData { mime, base64 }`).  A bare `String` is a type error.
image : List (Attribute msg) -> { src : ImageValue, description : String } -> Element msg
image attrs rec =
    imageKernel attrs { src = imageValueToString rec.src, description = rec.description }


