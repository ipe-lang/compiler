    Kernel.kernel "Ui_descLabel"


-- ── Accessible-by-default controls + typed ARIA vocabulary. ──
--
-- `Ipe.Ui` is Ipê's default UI library, so it must be accessible BY
-- CONSTRUCTION — an app built from `Ui` alone should be accessible with no extra
-- effort. Two pieces deliver that here:
--
--  1. The accessible-name FLOOR. `Ui.button`'s `label` is an `Element` that may
--     be an icon with no text, so an icon-only button can ship with no name for
--     assistive tech. `iconButton` closes that hole: its `label : String` is
--     REQUIRED and becomes the `aria-label`, so a nameless icon control has no
--     representation on the `Ui` path. (`Ui.image` already requires a
--     `description`, and `Ui.input` pairs with a `descLabel`, so those floors
--     already hold.)
--  2. The typed ARIA vocabulary, in `Ui` terms — the same closed `Role` and
--     `aria-*` sets `Ipe.Html.Attributes` exposes, rendered here over
--     `htmlAttribute` so a `Ui` author never drops to raw strings. Landmark
--     roles are usually better set through `describe` (`descNavigation` &c.,
--     which the runtime turns into `role=` automatically); `role` is the escape
--     for the roles the `Description` layer does not cover.
-- | `iconButton attrs { icon, label, onPress }` — a `<button>` whose visible
-- content is an icon `Element` and whose accessible name is the REQUIRED
-- `label : String` (rendered as `aria-label`). Use this instead of `button`
-- whenever the visible content is not itself readable text, so the control is
-- never nameless to a screen reader.
iconButton : List (Attribute msg) -> { icon : Element msg, label : String, onPress : Maybe msg } -> Element msg
iconButton attrs rec =
    button (ariaLabel rec.label :: attrs) { onPress = rec.onPress, label = rec.icon }


-- | `id s` — the `id` attribute, the anchor an `ariaLabelledby` / `ariaDescribedby`
-- points at.
id : String -> Attribute msg
id =
    htmlAttribute "id"


-- The typed ARIA / role vocabulary, mirrored from `Ipe.Html.Attributes` so a
-- `Ui` author reaches it in `Ui` terms. The wire strings are identical; only
-- the carrier (`Ui.Attribute` over `htmlAttribute`) differs.
-- | The WAI-ARIA role vocabulary (see `Ipe.Html.Attributes.Role`). Prefer a
-- landmark `describe` (`descNavigation` &c.) where one exists; reach for `role`
-- for the roles it does not cover.
type Role
    = Alert
    | AlertDialog
    | Application
    | Article
    | Banner
    | Button
    | Cell
    | Checkbox
    | Columnheader
    | Combobox
    | Complementary
    | ContentInfo
    | Definition
    | Dialog
    | Directory
    | Document
    | Feed
    | Figure
    | Form
    | Grid
    | Gridcell
    | Group
    | Heading
    | Img
    | Link
    | List
    | Listbox
    | Listitem
    | Log
    | Main
    | Marquee
    | Math
    | Menu
    | Menubar
    | Menuitem
    | MenuitemCheckbox
    | MenuitemRadio
    | Navigation
    | None
    | Note
    | Option
    | Presentation
    | Progressbar
    | Radio
    | Radiogroup
    | Region
    | Row
    | Rowgroup
    | Rowheader
    | Scrollbar
    | Search
    | Searchbox
    | Separator
    | Slider
    | Spinbutton
    | Status
    | Switch
    | Tab
    | Table
    | Tablist
    | Tabpanel
    | Term
    | Textbox
    | Timer
    | Toolbar
    | Tooltip
    | Tree
    | Treegrid
    | Treeitem


roleName : Role -> String
roleName r =
    case r of
        Alert ->
            "alert"

        AlertDialog ->
            "alertdialog"

        Application ->
            "application"

        Article ->
            "article"

        Banner ->
            "banner"

        Button ->
            "button"

        Cell ->
            "cell"

        Checkbox ->
            "checkbox"

        Columnheader ->
            "columnheader"

        Combobox ->
            "combobox"

        Complementary ->
            "complementary"

        ContentInfo ->
            "contentinfo"

        Definition ->
            "definition"

        Dialog ->
            "dialog"

        Directory ->
            "directory"

        Document ->
            "document"

        Feed ->
            "feed"

        Figure ->
            "figure"

        Form ->
            "form"

        Grid ->
            "grid"

        Gridcell ->
            "gridcell"

        Group ->
            "group"

        Heading ->
            "heading"

        Img ->
            "img"

        Link ->
            "link"

        List ->
            "list"

        Listbox ->
            "listbox"

        Listitem ->
            "listitem"

        Log ->
            "log"

        Main ->
            "main"

        Marquee ->
            "marquee"

        Math ->
            "math"

        Menu ->
            "menu"

        Menubar ->
            "menubar"

        Menuitem ->
            "menuitem"

        MenuitemCheckbox ->
            "menuitemcheckbox"

        MenuitemRadio ->
            "menuitemradio"

        Navigation ->
            "navigation"

        None ->
            "none"

        Note ->
            "note"

        Option ->
            "option"

        Presentation ->
            "presentation"

        Progressbar ->
            "progressbar"

        Radio ->
            "radio"

        Radiogroup ->
            "radiogroup"

        Region ->
            "region"

        Row ->
            "row"

        Rowgroup ->
            "rowgroup"

        Rowheader ->
            "rowheader"

        Scrollbar ->
            "scrollbar"

        Search ->
            "search"

        Searchbox ->
            "searchbox"

        Separator ->
            "separator"

        Slider ->
            "slider"

        Spinbutton ->
            "spinbutton"

        Status ->
            "status"

        Switch ->
            "switch"

        Tab ->
            "tab"

        Table ->
            "table"

        Tablist ->
            "tablist"

        Tabpanel ->
            "tabpanel"

        Term ->
            "term"

        Textbox ->
            "textbox"

        Timer ->
            "timer"

        Toolbar ->
            "toolbar"

        Tooltip ->
            "tooltip"

        Tree ->
            "tree"

        Treegrid ->
            "treegrid"

        Treeitem ->
            "treeitem"


-- | `role r` — the `role` attribute over the closed `Role` vocabulary.
role : Role -> Attribute msg
role r =
    htmlAttribute "role" (roleName r)


-- | The closed value set for `aria-live` (off/polite/assertive).
type AriaLive
    = LiveOff
    | LivePolite
    | LiveAssertive


ariaLiveName : AriaLive -> String
ariaLiveName v =
    case v of
        LiveOff ->
            "off"

        LivePolite ->
            "polite"

        LiveAssertive ->
            "assertive"


-- | The closed value set for `aria-current`.
type AriaCurrent
    = CurrentFalse
    | CurrentTrue
    | CurrentPage
    | CurrentStep
    | CurrentLocation
    | CurrentDate
    | CurrentTime


ariaCurrentName : AriaCurrent -> String
ariaCurrentName v =
    case v of
        CurrentFalse ->
            "false"

        CurrentTrue ->
            "true"

        CurrentPage ->
            "page"

        CurrentStep ->
            "step"

        CurrentLocation ->
            "location"

        CurrentDate ->
            "date"

        CurrentTime ->
            "time"


-- | The closed tri-state for `aria-checked` / `aria-pressed` (on/off/mixed).
type AriaTristate
    = TriTrue
    | TriFalse
    | TriMixed


ariaTristateName : AriaTristate -> String
ariaTristateName v =
    case v of
        TriTrue ->
            "true"

        TriFalse ->
            "false"

        TriMixed ->
            "mixed"


-- | The closed value set for `aria-haspopup`.
type AriaHaspopup
    = HaspopupFalse
    | HaspopupTrue
    | HaspopupMenu
    | HaspopupListbox
    | HaspopupTree
    | HaspopupGrid
    | HaspopupDialog


ariaHaspopupName : AriaHaspopup -> String
ariaHaspopupName v =
    case v of
        HaspopupFalse ->
            "false"

        HaspopupTrue ->
            "true"

        HaspopupMenu ->
            "menu"

        HaspopupListbox ->
            "listbox"

        HaspopupTree ->
            "tree"

        HaspopupGrid ->
            "grid"

        HaspopupDialog ->
            "dialog"


-- | The closed value set for `aria-invalid`.
type AriaInvalid
    = InvalidFalse
    | InvalidTrue
    | InvalidGrammar
    | InvalidSpelling


ariaInvalidName : AriaInvalid -> String
ariaInvalidName v =
    case v of
        InvalidFalse ->
            "false"

        InvalidTrue ->
            "true"

        InvalidGrammar ->
            "grammar"

        InvalidSpelling ->
            "spelling"


-- | The explicit `"true"`/`"false"` an aria STATE boolean renders to — the
-- `False` case is written out (not omitted), because an absent aria state and an
-- explicit `"false"` mean different things to assistive tech.
ariaBool : Bool -> String
ariaBool on =
    if on then
        "true"

    else
        "false"


ariaLabel : String -> Attribute msg
ariaLabel =
    htmlAttribute "aria-label"


ariaLabelledby : String -> Attribute msg
ariaLabelledby =
    htmlAttribute "aria-labelledby"


ariaDescribedby : String -> Attribute msg
ariaDescribedby =
    htmlAttribute "aria-describedby"


ariaControls : String -> Attribute msg
ariaControls =
    htmlAttribute "aria-controls"


ariaValuetext : String -> Attribute msg
ariaValuetext =
    htmlAttribute "aria-valuetext"


ariaHidden : Bool -> Attribute msg
ariaHidden on =
    htmlAttribute "aria-hidden" (ariaBool on)


ariaExpanded : Bool -> Attribute msg
ariaExpanded on =
    htmlAttribute "aria-expanded" (ariaBool on)


ariaDisabled : Bool -> Attribute msg
ariaDisabled on =
    htmlAttribute "aria-disabled" (ariaBool on)


ariaSelected : Bool -> Attribute msg
ariaSelected on =
    htmlAttribute "aria-selected" (ariaBool on)


ariaRequired : Bool -> Attribute msg
ariaRequired on =
    htmlAttribute "aria-required" (ariaBool on)


ariaModal : Bool -> Attribute msg
ariaModal on =
    htmlAttribute "aria-modal" (ariaBool on)


ariaBusy : Bool -> Attribute msg
ariaBusy on =
    htmlAttribute "aria-busy" (ariaBool on)


ariaPressed : AriaTristate -> Attribute msg
ariaPressed state =
    htmlAttribute "aria-pressed" (ariaTristateName state)


ariaChecked : AriaTristate -> Attribute msg
ariaChecked state =
    htmlAttribute "aria-checked" (ariaTristateName state)


ariaLive : AriaLive -> Attribute msg
ariaLive urgency =
    htmlAttribute "aria-live" (ariaLiveName urgency)


ariaCurrent : AriaCurrent -> Attribute msg
ariaCurrent which =
    htmlAttribute "aria-current" (ariaCurrentName which)


ariaHaspopup : AriaHaspopup -> Attribute msg
ariaHaspopup kind =
    htmlAttribute "aria-haspopup" (ariaHaspopupName kind)


ariaInvalid : AriaInvalid -> Attribute msg
ariaInvalid state =
    htmlAttribute "aria-invalid" (ariaInvalidName state)


ariaValuemin : Int -> Attribute msg
ariaValuemin n =
    htmlAttribute "aria-valuemin" (String.fromInt n)


ariaValuemax : Int -> Attribute msg
ariaValuemax n =
    htmlAttribute "aria-valuemax" (String.fromInt n)


ariaValuenow : Int -> Attribute msg
ariaValuenow n =
    htmlAttribute "aria-valuenow" (String.fromInt n)


-- ── Layout builders (pure Ipê sugar over `node` / `taggedNode`). ──
-- | `el attrs child` — a single-child container.
el : List (Attribute msg) -> Element msg -> Element msg
el attrs child =
    node descNone attrs [ child ]


-- | `row attrs children` — a horizontal container (`__row` marker).
row : List (Attribute msg) -> List (Element msg) -> Element msg
row attrs children =
    node descNone (style "__row" "true" :: attrs) children


-- | `column attrs children` — a vertical container (`__col` marker).
column : List (Attribute msg) -> List (Element msg) -> Element msg
column attrs children =
    node descNone (style "__col" "true" :: attrs) children


-- | `wrappedRow attrs children` — a wrapping horizontal container.
wrappedRow : List (Attribute msg) -> List (Element msg) -> Element msg
wrappedRow attrs children =
    node descNone (style "__wrappedrow" "true" :: attrs) children


-- | `grid attrs children` — a CSS-grid container.
grid : List (Attribute msg) -> List (Element msg) -> Element msg
grid attrs children =
    node descNone (style "__grid" "true" :: attrs) children


-- | `paragraph attrs children` — a `<p>` with inline-flow children.
paragraph : List (Attribute msg) -> List (Element msg) -> Element msg
paragraph attrs children =
    taggedNode "p" descParagraph (style "__paragraph" "true" :: attrs) children


-- | `textColumn attrs children` — a `<section>` block of paragraphs.
textColumn : List (Attribute msg) -> List (Element msg) -> Element msg
textColumn attrs children =
    taggedNode "section" descNone (style "__textcolumn" "true" :: attrs) children


-- | `form attrs children` — a `<form>` container.
form : List (Attribute msg) -> List (Element msg) -> Element msg
form attrs children =
    taggedNode "form" descNone attrs children


-- | `input attrs` — an `<input>` void element.
input : List (Attribute msg) -> Element msg
input attrs =
    taggedNode "input" descNone attrs []
