-- | Ipe.Crypto — cryptographic primitives.
--
-- All functions are aliased to runtime kernels via `Kernel.kernel`.
-- Security notes:
--   * `constantTimeEqual` stays constant-time (backed by `subtle`).
--   * AEAD functions (`aesGcmEncrypt`, `chacha20Encrypt`) use a fresh
--     random nonce on every call; the nonce is prepended to the
--     ciphertext so `decrypt` can recover it.
--   * Key/secret material is never logged.
--   * `sha1` and `md5` are cryptographically BROKEN (practical collisions):
--     use them only for legacy interop or non-security checksums, never for
--     passwords, signatures, or MACs.  Prefer `sha256`/`sha512`.
--   * `Key` and `Mac` enforce role at compile time.  Every key-consuming
--     function — `hmacSha256`, `hmacSha512`, `aesGcmEncrypt`/`Decrypt`,
--     `chacha20Encrypt`/`Decrypt` — requires a `Key`; passing a bare `String`
--     (e.g. a plaintext message or a password) where a key is expected is a
--     compile error, so key/message role confusion is unrepresentable.
--     `aesKeyFromPassword`/`chachaKeyFromPassword` return a `Key`, never a raw
--     `String`.  Construct a `Key` via `keyFromString`, `keyFromBytes`, or a
--     password-derivation function; there is no way to encrypt or derive with a
--     bare `String` key.
module Ipe.Crypto exposing
    ( sha256, sha512, sha1, md5
    , rsaSha256Sign, rsaSha256Verify
    , constantTimeEqual
    , aesGcmEncrypt, aesGcmDecrypt
    , chacha20Encrypt, chacha20Decrypt
    , aesKeyFromPassword, chachaKeyFromPassword
    , randomBytes, randomToken
    , Key
    , Mac
    , keyFromString
    , keyFromBytes
    , macToHex
    , macFromHex
    , hmacSha256
    , hmacSha512
    , verifyHmacSha256
    )


import Ipe.Ffi.Kernel as Kernel


-- ── Hashes ───────────────────────────────────────────────────────────────────

sha256 : String -> String
sha256 = Kernel.kernel "Crypto_sha256"

sha512 : String -> String
sha512 = Kernel.kernel "Crypto_sha512"

{-| SHA-1 hash, hex-encoded.

Cryptographically BROKEN (practical collisions exist). Use only for legacy
interop or non-security checksums — never for passwords, signatures, or MACs.
Prefer `sha256`/`sha512`.
-}
sha1 : String -> String
sha1 = Kernel.kernel "Crypto_sha1"

{-| MD5 hash, hex-encoded.

Cryptographically BROKEN (practical collisions exist). Use only for legacy
interop or non-security checksums — never for passwords, signatures, or MACs.
Prefer `sha256`/`sha512`.
-}
md5 : String -> String
md5 = Kernel.kernel "Crypto_md5"


-- ── HMAC ─────────────────────────────────────────────────────────────────────
--
-- Both functions require a `Key`.  Construct one via `keyFromString` or
-- `keyFromBytes` at your parse boundary.  Passing a bare `String` where a
-- `Key` is expected is a compile error, making message-as-key impossible.

-- | `hmacSha256 key message` — HMAC-SHA-256.  Returns a typed `Mac`.
hmacSha256 : Key -> String -> Mac
hmacSha256 = Kernel.kernel "Crypto_hmacSha256WithKey"

-- | `hmacSha512 key message` — HMAC-SHA-512.  Returns a typed `Mac`.
hmacSha512 : Key -> String -> Mac
hmacSha512 = Kernel.kernel "Crypto_hmacSha512WithKey"

-- | `verifyHmacSha256 key message mac` — `True` exactly when `mac` is the
-- HMAC-SHA-256 tag of `message` under `key`.  The tag is recomputed and
-- compared in constant time on the raw bytes, so a stored tag (parsed with
-- `macFromHex`) is never trusted on its own.  An HMAC-SHA-512 `Mac` is
-- always `False`.
verifyHmacSha256 : Key -> String -> Mac -> Bool
verifyHmacSha256 = Kernel.kernel "Crypto_verifyHmacSha256"


-- ── RSA / asymmetric ─────────────────────────────────────────────────────────

rsaSha256Sign : String -> String -> Result Error String
rsaSha256Sign = Kernel.kernel "Crypto_rsaSha256Sign"

rsaSha256Verify : String -> String -> String -> Bool
rsaSha256Verify = Kernel.kernel "Crypto_rsaSha256Verify"


-- ── Constant-time comparison ──────────────────────────────────────────────────

constantTimeEqual : String -> String -> Bool
constantTimeEqual = Kernel.kernel "Crypto_constantTimeEqual"


-- ── AEAD symmetric encryption ─────────────────────────────────────────────────
--
-- Every AEAD entry point requires a typed `Key` in the key role.  A bare
-- `String` (a message, a password, a plaintext) is a compile error where a
-- `Key` is expected, so key/message role confusion is unrepresentable.  A fresh
-- random nonce is generated per call and prepended to the ciphertext.

-- | `aesGcmEncrypt key plaintext` — AES-256-GCM encrypt with a typed `Key`.
aesGcmEncrypt : Key -> String -> Result Error String
aesGcmEncrypt = Kernel.kernel "Crypto_aesGcmEncrypt"

-- | `aesGcmDecrypt key ciphertext` — AES-256-GCM decrypt with a typed `Key`.
aesGcmDecrypt : Key -> String -> Result Error String
aesGcmDecrypt = Kernel.kernel "Crypto_aesGcmDecrypt"

-- | `chacha20Encrypt key plaintext` — ChaCha20-Poly1305 encrypt with a typed `Key`.
chacha20Encrypt : Key -> String -> Result Error String
chacha20Encrypt = Kernel.kernel "Crypto_chacha20Encrypt"

-- | `chacha20Decrypt key ciphertext` — ChaCha20-Poly1305 decrypt with a typed `Key`.
chacha20Decrypt : Key -> String -> Result Error String
chacha20Decrypt = Kernel.kernel "Crypto_chacha20Decrypt"


-- ── Key derivation ────────────────────────────────────────────────────────────
--
-- Password-based derivation returns a typed `Key`, never a raw `String`, so a
-- derived key can only flow into a `Key`-typed sink (AEAD/HMAC), never be
-- mistaken for arbitrary text.

-- | Derive an AES-256 `Key` from a password + salt string.
aesKeyFromPassword : String -> String -> Key
aesKeyFromPassword = Kernel.kernel "Crypto_aesKeyFromPassword"

-- | Derive a ChaCha20 `Key` from a password + salt string.
chachaKeyFromPassword : String -> String -> Key
chachaKeyFromPassword = Kernel.kernel "Crypto_chachaKeyFromPassword"


-- ── Random ───────────────────────────────────────────────────────────────────

randomBytes : Int -> Task Error String
randomBytes = Kernel.kernel "Crypto_randomBytes"

randomToken : Int -> Task Error String
randomToken = Kernel.kernel "Crypto_randomToken"


-- ── Typed newtypes ────────────────────────────────────────────────────────────
--
-- `Key` and `Mac` are opaque types backed by runtime newtypes.
-- They enforce role at the type level: passing a `Mac` where a `Key`
-- is expected is a compile error.  Key material never appears in logs.

-- | An opaque cryptographic key.  Construct only via `keyFromString`
-- or `keyFromBytes`; never forge from a plain string.
type Key = Key

-- | An opaque message authentication code (HMAC output).  Inspect via
-- `macToHex`; check a tag against a message with `verifyHmacSha256`, which
-- recomputes it and compares in constant time.
type Mac = Mac

-- | Wrap a string as a `Key`: the string's bytes are the key material as
-- given, with no hex or other decoding.  Returns `Nothing` for an empty
-- key; a wrong-length key for a given algorithm fails closed at that
-- algorithm's boundary (e.g. AEAD requires a 32-byte key).
keyFromString : String -> Maybe Key
keyFromString = Kernel.kernel "Key_fromString"

-- | Parse raw bytes (as Ipe `String`/`Bytes`) into a `Key`.
keyFromBytes : String -> Maybe Key
keyFromBytes = Kernel.kernel "Key_fromBytes"

-- | Render a `Mac` as a lowercase hex string for storage or display.
macToHex : Mac -> String
macToHex = Kernel.kernel "Mac_toHex"

-- | Parse a stored hex tag back into a `Mac`: exactly 64 hex digits (an
-- HMAC-SHA-256 tag) or 128 (HMAC-SHA-512), in upper or lower case.
-- Returns `Nothing` for anything else — empty, odd length, another length,
-- a non-hex digit, whitespace, or a `0x` prefix.  `macToHex` renders the
-- result in lowercase.
macFromHex : String -> Maybe Mac
macFromHex = Kernel.kernel "Mac_fromHex"
