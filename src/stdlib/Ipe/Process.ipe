-- | Ipe.Process — run child processes with NO shell.
--
-- `Process.run cmd argv` executes `cmd` with `argv` as a direct argument
-- vector — the arguments are NEVER passed through `sh -c`, so a
-- caller-controlled string can never be reinterpreted as shell syntax
-- (no command injection). Success yields the child's stdout; a non-zero
-- exit or a spawn failure is a typed `Error` carrying the exit code and the
-- child's stderr.
--
-- `Process.runWith` is the richer variant: it captures exit code, stdout, and
-- stderr independently, supports a per-child working directory and environment
-- overrides, and treats a non-zero exit as a NORMAL result (carried in
-- `exitCode`) rather than a Task failure. Only a spawn failure fails the Task.
--
-- `Process.runInPty` runs the child under a real pseudo-terminal instead of
-- piped stdio, so a TUI/interactive child sees `isatty == true`, sizes to the
-- given `cols`×`rows`, and emits terminal control sequences. It captures the
-- combined pty stream and the exit code. Unix-only (a non-unix target fails the
-- Task with an unsupported error); same `subprocess` capability as `run`.
--
-- This is a server-only capability (`subprocess`): it is DEFAULT-DENIED under
-- `--target wasm` (a browser bundle has no process surface), and a program
-- that runs a child process is tagged with the `subprocess` capability so a
-- sandbox can isolate it.
module Ipe.Process exposing
    ( run
    , runWith
    , runInPty
    )


import Ipe.Ffi.Kernel as Kernel
import Ipe.Error exposing (Error)


-- | `run cmd argv` — run `cmd` with the argument vector `argv`, no shell.
-- Succeeds with the child's captured stdout (bounded to guard memory);
-- fails with a typed `Error` on a non-zero exit or a spawn failure, and with a
-- `LimitExceeded` error when the output passes `IPE_PROCESS_OUTPUT_MAX`.
run : String -> List String -> Task Error String
run =
    Kernel.kernel "Process_run"


-- | `runWith cfg` — run a child process with per-child options.
--
-- The `cfg` record controls every axis of the spawn:
--
--   - `command` — the executable path or name (resolved via `PATH`);
--     never passed through a shell.
--   - `args` — the argument vector; each element is passed literally
--     as a separate `argv` entry (no word-splitting, no glob expansion).
--   - `cwd` — optional working directory for the child; `Nothing` inherits
--     the parent's current directory.
--   - `env` — per-child environment overrides applied on top of the parent
--     environment; pairs are `(key, value)`.
--
-- A non-zero exit is a NORMAL result carried in `exitCode`; only a spawn
-- failure (e.g. the executable does not exist) fails the Task.
-- `stdout` and `stderr` are each captured independently (no pipe-deadlock
-- risk) and bounded by `IPE_PROCESS_OUTPUT_MAX` (default 16 MiB per stream);
-- a stream past it fails the Task with a `LimitExceeded` error.
runWith :
    { command : String
    , args : List String
    , cwd : Maybe Path
    , env : List ( String, String )
    }
    -> Task Error { exitCode : Int, stdout : String, stderr : String }
runWith =
    Kernel.kernel "Process_runWith"


-- | `runInPty cfg` — run a child under a real pseudo-terminal.
--
-- Unlike `run`/`runWith` (which give the child piped stdio), `runInPty`
-- connects the child's stdin/stdout/stderr to a pseudo-terminal, so a TUI
-- child sees `isatty(stdout) == true`, sizes itself to `cols`×`rows`, and
-- emits cursor/color control sequences. `output` is the combined stream read
-- from the pty master until the child exits.
--
-- The `cfg` record:
--
--   - `command` / `args` / `cwd` / `env` — as in `runWith` (no shell; each
--     `args` element is a literal `argv` entry).
--   - `cols` / `rows` — the pty window size in columns and rows.
--
-- Captured `output` is bounded (`IPE_PROCESS_OUTPUT_MAX`, default 16 MiB); a
-- child that floods the pty past the ceiling fails the Task with a
-- `LimitExceeded` error rather than allocating without bound. This is the same `subprocess` capability as `run`
-- (the pty is an implementation detail of running a child, not a new reach).
--
-- Unix-only: on a non-unix target the Task fails with an `unsupported` error.
runInPty :
    { command : String
    , args : List String
    , cwd : Maybe Path
    , env : List ( String, String )
    , cols : Int
    , rows : Int
    }
    -> Task Error { exitCode : Int, output : String }
runInPty =
    Kernel.kernel "Process_runInPty"
