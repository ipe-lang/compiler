-- | Ipe.Url — typed, validated URLs.
--
-- Two opaque homes, each with a single fail-closed constructor: an absolute
-- `Url` (`fromString` parses it, then `checkScheme` narrows the scheme against a
-- per-surface allowlist before a sink) and a same-origin `Relative` reference
-- (`relative`). `buildQuery` is the injection-safe query-string builder — every
-- key and value percent-encoded, so a metacharacter cannot split off a new
-- parameter.
--
-- The mental model, a worked example, and the rationale live in the URLs guide
-- (`ipe doc guide:url`); this module doc is the reference intro its per-symbol
-- comments back.
module Ipe.Url exposing
    ( Url
    , fromString, toString
    , scheme, host, port, path, query, fragment
    , buildQuery
    , checkScheme
    , Relative, relative
    , relativePath, relativeQuery, relativeFragment, relativeToString
    )


import Ipe.Ffi.Kernel as Kernel
import Ipe.Error as Error exposing (Error)
import Ipe.List as List
import Ipe.Maybe exposing (Maybe)
import Ipe.Result exposing (Result(..))


-- | `fromString raw` — the parse-don't-validate seal: the only `Url`
-- constructor. Returns `Err` when `raw` is not a syntactically valid ABSOLUTE
-- URL (a relative reference, a scheme-less host, or otherwise unparseable);
-- otherwise `Ok` the parsed `Url`.
fromString : String -> Result Error Url
fromString = Kernel.kernel "Url_fromString"


-- | `toString url` — recover the serialized URL string.
toString : Url -> String
toString = Kernel.kernel "Url_toString"


-- | `scheme url` — the URL's scheme (`"https"`, `"http"`, …), always present.
scheme : Url -> String
scheme = Kernel.kernel "Url_scheme"


-- | `host url` — the host component, or `Nothing` for a hostless scheme
-- (e.g. `mailto:`).
host : Url -> Maybe String
host = Kernel.kernel "Url_host"


-- | `port url` — the port with the scheme's known default applied
-- (`https://x` → `443`), or `Nothing`.
port : Url -> Maybe Int
port = Kernel.kernel "Url_port"


-- | `path url` — the path component.
path : Url -> String
path = Kernel.kernel "Url_path"


-- | `query url` — the raw query string (without the leading `?`), or `Nothing`.
query : Url -> Maybe String
query = Kernel.kernel "Url_query"


-- | `fragment url` — the fragment (without the leading `#`), or `Nothing`.
fragment : Url -> Maybe String
fragment = Kernel.kernel "Url_fragment"


-- | `buildQuery pairs` — the injection-safe query-string builder. Every key and
-- value is percent-encoded, so a metacharacter in a value cannot split off a
-- new parameter. Returns the encoded string without a leading `?`.
buildQuery : List ( String, String ) -> String
buildQuery = Kernel.kernel "Url_buildQuery"


-- | `checkScheme allowed url` — the fail-closed scheme allowlist boundary, one
-- SSOT mechanism each surface calls with its own policy. `Url` is only the
-- SYNTACTIC parse seal: it legally carries ANY absolute scheme (`javascript:`,
-- `data:`, `file:` are valid `Url` values), so an href/link/share sink that
-- accepts arbitrary schemes is an injection surface. This narrows the already
-- parsed scheme against `allowed`: an `Ok url` only when `Url.scheme url` is in
-- the list, otherwise a typed `Err` naming the blocked scheme when it is a
-- well-known one (a user name can parse as the scheme, so any other is
-- withheld). The scheme read is the runtime-normalised (lowercased) value, so a
-- `JavaScript:` cannot evade a lowercase allowlist. Absent proof the scheme is
-- one a caller vetted, the URL is rejected — never silently dropped, never
-- passed through.
checkScheme : List String -> Url -> Result Error Url
checkScheme allowed url =
    if List.member (scheme url) allowed then
        Ok url

    else
        Err
            (Error.invalidInput
                ("Ipe.Url: blocked scheme "
                    ++ schemeShown url
                    ++ " (not in the allowed set for this surface)"
                )
            )


-- `schemeShown url` — the scheme as an error message may show it: a
-- well-known scheme quoted, any other withheld. Shares the runtime's list of
-- nameable schemes, so `checkScheme` and the outbound refusals agree.
schemeShown : Url -> String
schemeShown = Kernel.kernel "Url_schemeShown"


-- | `relative raw` — THE seal for a same-origin relative reference.
--
-- `Relative` is a safe same-origin RELATIVE reference (`/static/x.js`,
-- `./style.css`, `?q=1`, `#top`) — the `path`[`?query`][`#fragment`] projection
-- (RFC 3986 §4.2). It is an opaque compiler builtin (like `Url` itself): a `Url`
-- is always ABSOLUTE, so a relative reference is NOT a `Url` — it carries neither
-- scheme nor authority, exactly the parts dropped for a same-origin navigation.
-- This is the ONE typed home for a validated relative reference; the ONLY
-- constructor is `relative`. Validated by
-- the SAME `url` crate the absolute `Url` path uses (`Url_relative` resolves
-- `raw` against a fixed same-origin base and REJECTS any scheme or authority),
-- so the relative-href boundary and the absolute/SSRF boundary cannot diverge on
-- what parses. Fail-closed: a protocol-relative (`//host`), scheme-bearing,
-- backslash, control-char, or cross-origin string is a typed `Err`, never
-- rendered into an `href` / `src`.
relative : String -> Result Error Relative
relative = Kernel.kernel "Url_relative"


-- | `relativePath ref` — the path projection, always present (`/`, `/a/b`,
-- `./x`).
relativePath : Relative -> String
relativePath = Kernel.kernel "Url_relativePath"


-- | `relativeQuery ref` — the query string (without the leading `?`), or
-- `Nothing`.
relativeQuery : Relative -> Maybe String
relativeQuery = Kernel.kernel "Url_relativeQuery"


-- | `relativeFragment ref` — the fragment (without the leading `#`), or
-- `Nothing`.
relativeFragment : Relative -> Maybe String
relativeFragment = Kernel.kernel "Url_relativeFragment"


-- | `relativeToString ref` — recover the validated reference string
-- (path + optional query + optional fragment).
relativeToString : Relative -> String
relativeToString = Kernel.kernel "Url_relativeToString"
