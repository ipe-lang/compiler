-- | Ipe.Log — structured observability kernels.
--
-- Four severity levels — `debug` / `info` / `warn` / `error` — write a
-- single-line message to the structured log.  The `*With` variants attach
-- an ordered list of context values alongside the message.  Each value must
-- be a `String`, `Int`, `Float`, `Bool` or `Char` (all of one type per list);
-- anything else is refused at type-check (IPE-T0014) — convert it first
-- (`String.fromInt`, `Error.toString`, `Secret.redacted`, a record's fields).
--
-- `Log.level` is the runtime-config front door for the minimum log
-- severity.  It takes a `LogLevel` constructor from `Ipe.Level`
-- (`Level.debug` / `Level.info` / `Level.warn` / `Level.error`) and
-- produces a cross-shape `Setting a` value for inclusion in an app's
-- settings list.
--
-- Line printing to stdout / stderr lives in `Ipe.Io` (`Io.println` /
-- `Io.eprintln`), not here.
module Ipe.Log exposing
    ( info, debug, warn, error
    , infoWith, debugWith, warnWith, errorWith
    , level
    )


import Ipe.Ffi.Kernel as Kernel


-- | Emit an info-severity log line.
info : String -> Task Error ()
info = Kernel.kernel "Log_info"


-- | Emit a debug-severity log line.
debug : String -> Task Error ()
debug = Kernel.kernel "Log_debug"


-- | Emit a warn-severity log line.
warn : String -> Task Error ()
warn = Kernel.kernel "Log_warn"


-- | Emit an error-severity log line.
error : String -> Task Error ()
error = Kernel.kernel "Log_error"


-- | Emit an info-severity log line with a list of scalar context values
-- (`String` / `Int` / `Float` / `Bool` / `Char`).
infoWith : String -> List a -> Task Error ()
infoWith = Kernel.kernel "Log_infoWith"


-- | Emit a debug-severity log line with a list of scalar context values
-- (`String` / `Int` / `Float` / `Bool` / `Char`).
debugWith : String -> List a -> Task Error ()
debugWith = Kernel.kernel "Log_debugWith"


-- | Emit a warn-severity log line with a list of scalar context values
-- (`String` / `Int` / `Float` / `Bool` / `Char`).
warnWith : String -> List a -> Task Error ()
warnWith = Kernel.kernel "Log_warnWith"


-- | Emit an error-severity log line with a list of scalar context values
-- (`String` / `Int` / `Float` / `Bool` / `Char`).
errorWith : String -> List a -> Task Error ()
errorWith = Kernel.kernel "Log_errorWith"


-- | Set the minimum log severity for the application.  Takes a `LogLevel`
-- constructor from `Ipe.Level` and returns a cross-shape `Setting a` for
-- use in an app's settings list.
--
--     import Ipe.Level as Level
--
--     Web.appWith [ Log.level Level.warn ] { ... }
level : LogLevel -> Setting a
level = Kernel.kernel "Log_level"
