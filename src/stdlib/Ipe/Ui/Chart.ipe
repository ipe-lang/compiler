-- | Ipe.Ui.Chart — typed chart primitives for `Ipe.Ui`.
--
-- `line / area / bar / sparkline / heatmap` accept typed `Series`
-- records (`{ label, color, points : List Point }`) and render to
-- inline-styled SVG.  Pair with `Ui.layoutWith` to embed in
-- dashboards.  XSS-hardened: all axis ticks + tooltip labels
-- HTML-escape through the same renderer as text content; no
-- innerHTML, no `data-ipe-eval`.  Used by the bundled Ipe Console
-- + `examples/26-ui-showcase`.


module Ipe.Ui.Chart exposing
    ( Cfg
    , defaultCfg
    , withWidth
    , withHeight
    , withColor
    , withTitle
    , withYRange
    , withGridLines
    , Series
    , series
    , withSeriesColor
    , withSeriesLabel
    , Point
    , line
    , area
    , bar
    , sparkline
    , heatmap
    )

import Ipe.Html as Html exposing (Html)
import Ipe.Html.Attributes as Attr
import Ipe.List as List
import Ipe.Math as Math
import Ipe.String as String
import Ipe.Ui as Ui exposing (Element, Color)


-- A data sample. Named fields prevent silent axis transposition.
type alias Point =
    { x : Float, y : Float }


-- An axis interval [lo, hi]. Distinct from Point so a range cannot
-- be passed where a sample is expected, or vice versa.
type alias Range =
    { lo : Float, hi : Float }


-- A projected device coordinate in the SVG viewport.
type alias Pixel =
    { px : Float, py : Float }


type alias Cfg =
    { width : Int
    , height : Int
    , color : Color
    , title : Maybe String
    , yRange : Maybe Range
    , gridLines : Bool
    }


type alias Series =
    { points : List Point
    , label : Maybe String
    , color : Maybe Color
    }


defaultCfg : Cfg
defaultCfg =
    { width = 480
    , height = 200
    , color = Ui.rgb 64 128 224
    , title = Nothing
    , yRange = Nothing
    , gridLines = True
    }


withWidth : Int -> Cfg -> Cfg
withWidth w cfg =
    { cfg | width = w }


withHeight : Int -> Cfg -> Cfg
withHeight h cfg =
    { cfg | height = h }


withColor : Color -> Cfg -> Cfg
withColor c cfg =
    { cfg | color = c }


withTitle : String -> Cfg -> Cfg
withTitle t cfg =
    { cfg | title = Just t }


withYRange : Float -> Float -> Cfg -> Cfg
withYRange lo hi cfg =
    { cfg | yRange = Just { lo = lo, hi = hi } }


withGridLines : Bool -> Cfg -> Cfg
withGridLines b cfg =
    { cfg | gridLines = b }


series : List Point -> Series
series pts =
    { points = pts
    , label = Nothing
    , color = Nothing
    }


withSeriesColor : Color -> Series -> Series
withSeriesColor c s =
    { s | color = Just c }


withSeriesLabel : String -> Series -> Series
withSeriesLabel l s =
    { s | label = Just l }


-- Standard plot-area inset.
plotInset : { left : Int, right : Int, top : Int, bottom : Int }
plotInset =
    { left = 32, right = 8, top = 24, bottom = 24 }


xRange : List Point -> Range
xRange pts =
    case pts of
        [] ->
            { lo = 0.0, hi = 1.0 }

        pt :: rest ->
            xRangeHelp pt.x pt.x rest


xRangeHelp : Float -> Float -> List Point -> Range
xRangeHelp lo hi pts =
    case pts of
        [] ->
            { lo = lo, hi = hi }

        pt :: rest ->
            xRangeHelp (Math.min lo pt.x) (Math.max hi pt.x) rest


yRange : List Point -> Range
yRange pts =
    case pts of
        [] ->
            { lo = 0.0, hi = 1.0 }

        pt :: rest ->
            yRangeHelp pt.y pt.y rest


yRangeHelp : Float -> Float -> List Point -> Range
yRangeHelp lo hi pts =
    case pts of
        [] ->
            { lo = lo, hi = hi }

        pt :: rest ->
            yRangeHelp (Math.min lo pt.y) (Math.max hi pt.y) rest


xRangeAll : List Series -> Range
xRangeAll seriesList =
    case seriesList of
        [] ->
            { lo = 0.0, hi = 1.0 }

        s :: rest ->
            xRangeAllHelp (xRange s.points) rest


xRangeAllHelp : Range -> List Series -> Range
xRangeAllHelp acc seriesList =
    case seriesList of
        [] ->
            acc

        s :: rest ->
            let
                b =
                    xRange s.points
            in
            xRangeAllHelp { lo = Math.min acc.lo b.lo, hi = Math.max acc.hi b.hi } rest


yRangeAll : List Series -> Range
yRangeAll seriesList =
    case seriesList of
        [] ->
            { lo = 0.0, hi = 1.0 }

        s :: rest ->
            yRangeAllHelp (yRange s.points) rest


yRangeAllHelp : Range -> List Series -> Range
yRangeAllHelp acc seriesList =
    case seriesList of
        [] ->
            acc

        s :: rest ->
            let
                b =
                    yRange s.points
            in
            yRangeAllHelp { lo = Math.min acc.lo b.lo, hi = Math.max acc.hi b.hi } rest


seriesColor : Cfg -> Series -> Color
seriesColor cfg s =
    case s.color of
        Just c ->
            c

        Nothing ->
            cfg.color


effectiveYRange : Cfg -> List Series -> Range
effectiveYRange cfg seriesList =
    case cfg.yRange of
        Just r ->
            r

        Nothing ->
            let
                r =
                    yRangeAll seriesList

                lo2 =
                    Math.min r.lo 0.0

                pad =
                    (r.hi - lo2) * 0.05

                hi2 =
                    r.hi + pad
            in
            if hi2 <= lo2 then
                { lo = lo2, hi = lo2 + 1.0 }

            else
                { lo = lo2, hi = hi2 }


projectPoint : Int -> Int -> Range -> Range -> Point -> Pixel
projectPoint w h xR yR pt =
    let
        xSpan =
            xR.hi - xR.lo

        ySpan =
            yR.hi - yR.lo

        plotW =
            w - plotInset.left - plotInset.right

        plotH =
            h - plotInset.top - plotInset.bottom

        plotWf =
            toFloat plotW

        plotHf =
            toFloat plotH

        leftF =
            toFloat plotInset.left

        topF =
            toFloat plotInset.top

        nx =
            if xSpan == 0.0 then
                0.5

            else
                (pt.x - xR.lo) / xSpan

        ny =
            if ySpan == 0.0 then
                0.5

            else
                (pt.y - yR.lo) / ySpan
    in
    { px = leftF + nx * plotWf
    , py = topF + (1.0 - ny) * plotHf
    }


svgRootAttrs : Cfg -> List (Attr.Attribute msg)
svgRootAttrs cfg =
    [ Attr.attribute
        "viewBox"
        ("0 0 " ++ String.fromInt cfg.width ++ " " ++ String.fromInt cfg.height)
    , Attr.attribute "xmlns" "http://www.w3.org/2000/svg"
    , Attr.role Attr.Img
    , Attr.attribute "preserveAspectRatio" "xMidYMid meet"
    , Attr.style "max-width: 100%; height: auto; display: block; font-family: system-ui, -apple-system, Segoe UI, sans-serif;"
    ]


titleNode : Cfg -> Maybe (Html msg)
titleNode cfg =
    case cfg.title of
        Nothing ->
            Nothing

        Just t ->
            Just
                (Html.node "text"
                    [ Attr.attribute "x" (String.fromInt (cfg.width // 2))
                    , Attr.attribute "y" "14"
                    , Attr.attribute "text-anchor" "middle"
                    , Attr.attribute "fill" "#1a1a2e"
                    , Attr.attribute "font-size" "12"
                    , Attr.attribute "font-weight" "600"
                    ]
                    [ Html.text t ]
                )


gridLines : Cfg -> List (Html msg)
gridLines cfg =
    if cfg.gridLines then
        let
            plotH =
                cfg.height - plotInset.top - plotInset.bottom

            plotW =
                cfg.width - plotInset.left - plotInset.right

            x1 =
                String.fromInt plotInset.left

            x2 =
                String.fromInt (plotInset.left + plotW)

            ys =
                [ 0, 1, 2, 3, 4 ]
        in
        List.map (\i -> gridLine x1 x2 cfg.height plotH i) ys

    else
        []


gridLine : String -> String -> Int -> Int -> Int -> Html msg
gridLine x1 x2 _ plotH idx =
    let
        plotHf =
            toFloat plotH

        idxf =
            toFloat idx

        yPx =
            toFloat plotInset.top + (idxf / 4.0) * plotHf

        yStr =
            String.fromFloat yPx
    in
    Html.node "line"
        [ Attr.attribute "x1" x1
        , Attr.attribute "y1" yStr
        , Attr.attribute "x2" x2
        , Attr.attribute "y2" yStr
        , Attr.attribute "stroke" "#e6e8ec"
        , Attr.attribute "stroke-width" "1"
        ]
        []


buildPathD : List Pixel -> String
buildPathD coords =
    case coords of
        [] ->
            ""

        p0 :: rest ->
            "M "
                ++ String.fromFloat p0.px
                ++ ","
                ++ String.fromFloat p0.py
                ++ List.foldl appendLineSeg "" rest


appendLineSeg : Pixel -> String -> String
appendLineSeg p acc =
    acc ++ " L " ++ String.fromFloat p.px ++ "," ++ String.fromFloat p.py


labelTitle : Maybe String -> List (Html msg)
labelTitle lbl =
    case lbl of
        Nothing ->
            []

        Just s ->
            [ Html.node "title" [] [ Html.text s ] ]


maybeCons : Maybe (Html msg) -> List (Html msg) -> List (Html msg)
maybeCons m rest =
    case m of
        Nothing ->
            rest

        Just h ->
            h :: rest


line : Cfg -> List Series -> Element msg
line cfg seriesList =
    let
        xR =
            xRangeAll seriesList

        yR =
            effectiveYRange cfg seriesList

        seriesPaths =
            List.concatMap (lineOne cfg xR yR) seriesList

        baseChildren =
            gridLines cfg ++ axesNodes cfg ++ seriesPaths

        children =
            maybeCons (titleNode cfg) baseChildren
    in
    Ui.html (Html.node "svg" (svgRootAttrs cfg) children)


lineOne : Cfg -> Range -> Range -> Series -> List (Html msg)
lineOne cfg xR yR s =
    let
        col =
            Ui.colorCss (seriesColor cfg s)

        projected =
            List.map (projectPoint cfg.width cfg.height xR yR) s.points

        pathD =
            buildPathD projected

        pathNode =
            Html.node "path"
                [ Attr.attribute "d" pathD
                , Attr.attribute "fill" "none"
                , Attr.attribute "stroke" col
                , Attr.attribute "stroke-width" "2"
                , Attr.attribute "stroke-linejoin" "round"
                , Attr.attribute "stroke-linecap" "round"
                ]
                (labelTitle s.label)
    in
    case projected of
        [] ->
            []

        [ single ] ->
            [ singlePointCircle col single (labelTitle s.label) ]

        _ ->
            [ pathNode ]


singlePointCircle : String -> Pixel -> List (Html msg) -> Html msg
singlePointCircle col p extras =
    Html.node "circle"
        [ Attr.attribute "cx" (String.fromFloat p.px)
        , Attr.attribute "cy" (String.fromFloat p.py)
        , Attr.attribute "r" "3"
        , Attr.attribute "fill" col
        ]
        extras


axesNodes : Cfg -> List (Html msg)
axesNodes cfg =
    let
        plotW =
            cfg.width - plotInset.left - plotInset.right

        plotH =
            cfg.height - plotInset.top - plotInset.bottom

        leftStr =
            String.fromInt plotInset.left

        rightStr =
            String.fromInt (plotInset.left + plotW)

        topStr =
            String.fromInt plotInset.top

        bottomStr =
            String.fromInt (plotInset.top + plotH)
    in
    [ Html.node "line"
        [ Attr.attribute "x1" leftStr
        , Attr.attribute "y1" bottomStr
        , Attr.attribute "x2" rightStr
        , Attr.attribute "y2" bottomStr
        , Attr.attribute "stroke" "#9ca3af"
        , Attr.attribute "stroke-width" "1"
        ]
        []
    , Html.node "line"
        [ Attr.attribute "x1" leftStr
        , Attr.attribute "y1" topStr
        , Attr.attribute "x2" leftStr
        , Attr.attribute "y2" bottomStr
        , Attr.attribute "stroke" "#9ca3af"
        , Attr.attribute "stroke-width" "1"
        ]
        []
    ]


area : Cfg -> List Series -> Element msg
area cfg seriesList =
    let
        xR =
            xRangeAll seriesList

        yR =
            effectiveYRange cfg seriesList

        seriesPaths =
            List.concatMap (areaOne cfg xR yR) seriesList

        baseChildren =
            gridLines cfg ++ axesNodes cfg ++ seriesPaths

        children =
            maybeCons (titleNode cfg) baseChildren
    in
    Ui.html (Html.node "svg" (svgRootAttrs cfg) children)


areaOne : Cfg -> Range -> Range -> Series -> List (Html msg)
areaOne cfg xR yR s =
    let
        col =
            Ui.colorCss (seriesColor cfg s)

        projected =
            List.map (projectPoint cfg.width cfg.height xR yR) s.points

        plotH =
            cfg.height - plotInset.top - plotInset.bottom

        baselineY =
            toFloat (plotInset.top + plotH)

        pathD =
            buildAreaD baselineY projected

        areaNode =
            Html.node "path"
                [ Attr.attribute "d" pathD
                , Attr.attribute "fill" col
                , Attr.attribute "fill-opacity" "0.35"
                , Attr.attribute "stroke" col
                , Attr.attribute "stroke-width" "2"
                , Attr.attribute "stroke-linejoin" "round"
                ]
                (labelTitle s.label)
    in
    case projected of
        [] ->
            []

        _ ->
            [ areaNode ]


buildAreaD : Float -> List Pixel -> String
buildAreaD baselineY coords =
    case coords of
        [] ->
            ""

        p0 :: _ ->
            let
                start =
                    "M "
                        ++ String.fromFloat p0.px
                        ++ ","
                        ++ String.fromFloat baselineY
                        ++ " L "
                        ++ String.fromFloat p0.px
                        ++ ","
                        ++ String.fromFloat p0.py

                middle =
                    List.foldl appendLineSeg "" coords

                lastX =
                    lastXCoord coords p0.px

                close =
                    " L "
                        ++ String.fromFloat lastX
                        ++ ","
                        ++ String.fromFloat baselineY
                        ++ " Z"
            in
            start ++ middle ++ close


lastXCoord : List Pixel -> Float -> Float
lastXCoord coords fallback =
    case coords of
        [] ->
            fallback

        [ p ] ->
            p.px

        _ :: rest ->
            lastXCoord rest fallback


bar : Cfg -> List Series -> Element msg
bar cfg seriesList =
    let
        yR =
            effectiveYRange cfg seriesList

        seriesBars =
            List.indexedMap (\i s -> barOne cfg seriesList yR i s) seriesList

        flatBars =
            List.concat seriesBars

        baseChildren =
            gridLines cfg ++ axesNodes cfg ++ flatBars

        children =
            maybeCons (titleNode cfg) baseChildren
    in
    Ui.html (Html.node "svg" (svgRootAttrs cfg) children)


barOne : Cfg -> List Series -> Range -> Int -> Series -> List (Html msg)
barOne cfg allSeries yR seriesIdx s =
    let
        col =
            Ui.colorCss (seriesColor cfg s)

        nSeries =
            List.length allSeries

        groupCount =
            List.length s.points

        plotW =
            cfg.width - plotInset.left - plotInset.right

        plotH =
            cfg.height - plotInset.top - plotInset.bottom

        plotWf =
            toFloat plotW

        plotHf =
            toFloat plotH

        groupCountF =
            toFloat (Math.max 1 groupCount)

        nSeriesF =
            toFloat (Math.max 1 nSeries)

        groupWidth =
            plotWf / groupCountF

        barsWidth =
            groupWidth * 0.8

        groupGap =
            groupWidth * 0.2

        barWidth =
            barsWidth / nSeriesF

        ySpan =
            yR.hi - yR.lo

        baselineY =
            toFloat (plotInset.top + plotH)

        leftF =
            toFloat plotInset.left

        topF =
            toFloat plotInset.top

        seriesIdxF =
            toFloat seriesIdx
    in
    List.indexedMap
        (\gi pt ->
            let
                giF =
                    toFloat gi

                groupX =
                    leftF + groupGap * 0.5 + giF * groupWidth

                barX =
                    groupX + seriesIdxF * barWidth

                barY =
                    if ySpan == 0.0 then
                        baselineY

                    else
                        topF + (1.0 - (pt.y - yR.lo) / ySpan) * plotHf

                barH =
                    if ySpan == 0.0 then
                        0.0

                    else
                        ((pt.y - Math.max yR.lo 0.0) / ySpan) * plotHf

                finalH =
                    Math.max 0.0 barH
            in
            Html.node "rect"
                [ Attr.attribute "x" (String.fromFloat barX)
                , Attr.attribute "y" (String.fromFloat barY)
                , Attr.attribute "width" (String.fromFloat barWidth)
                , Attr.attribute "height" (String.fromFloat finalH)
                , Attr.attribute "fill" col
                , Attr.attribute "rx" "2"
                ]
                (labelTitle s.label)
        )
        s.points


sparkline : Cfg -> List Float -> Element msg
sparkline cfg values =
    let
        n =
            List.length values

        col =
            Ui.colorCss cfg.color

        wf =
            toFloat cfg.width

        hf =
            toFloat cfg.height

        ys =
            case cfg.yRange of
                Just r ->
                    r

                Nothing ->
                    let
                        r =
                            yRangeOfFloats values

                        pad =
                            (r.hi - r.lo) * 0.1
                    in
                    if r.hi <= r.lo then
                        { lo = r.lo - 0.5, hi = r.lo + 0.5 }

                    else
                        { lo = r.lo - pad, hi = r.hi + pad }

        ySpan =
            ys.hi - ys.lo

        nF =
            toFloat (Math.max 1 (n - 1))

        projected =
            List.indexedMap
                (\i v ->
                    let
                        iF =
                            toFloat i

                        x =
                            (iF / nF) * wf

                        ny =
                            if ySpan == 0.0 then
                                0.5

                            else
                                (v - ys.lo) / ySpan

                        y =
                            (1.0 - ny) * hf
                    in
                    { px = x, py = y }
                )
                values

        pathD =
            buildPathD projected
    in
    Ui.html
        (Html.node "svg"
            [ Attr.attribute
                "viewBox"
                ("0 0 " ++ String.fromInt cfg.width ++ " " ++ String.fromInt cfg.height)
            , Attr.attribute "xmlns" "http://www.w3.org/2000/svg"
            , Attr.role Attr.Img
            , Attr.attribute "preserveAspectRatio" "none"
            , Attr.style "display: block; width: 100%; height: 100%;"
            ]
            [ Html.node "path"
                [ Attr.attribute "d" pathD
                , Attr.attribute "fill" "none"
                , Attr.attribute "stroke" col
                , Attr.attribute "stroke-width" "1.5"
                , Attr.attribute "stroke-linejoin" "round"
                , Attr.attribute "stroke-linecap" "round"
                ]
                []
            ]
        )


yRangeOfFloats : List Float -> Range
yRangeOfFloats vals =
    case vals of
        [] ->
            { lo = 0.0, hi = 1.0 }

        v :: rest ->
            yRangeOfFloatsHelp v v rest


yRangeOfFloatsHelp : Float -> Float -> List Float -> Range
yRangeOfFloatsHelp lo hi vals =
    case vals of
        [] ->
            { lo = lo, hi = hi }

        v :: rest ->
            yRangeOfFloatsHelp (Math.min lo v) (Math.max hi v) rest


heatmap : Cfg -> List (List Float) -> Element msg
heatmap cfg grid =
    let
        nRows =
            List.length grid

        nCols =
            heatmapMaxCols grid

        wf =
            toFloat cfg.width

        hf =
            toFloat cfg.height

        rowsF =
            toFloat (Math.max 1 nRows)

        colsF =
            toFloat (Math.max 1 nCols)

        cellW =
            wf / colsF

        cellH =
            hf / rowsF

        r =
            heatmapRange grid

        cells =
            List.concat
                (List.indexedMap (\ri row -> heatmapRow cfg cellW cellH r.lo r.hi ri row) grid)
    in
    Ui.html
        (Html.node "svg"
            [ Attr.attribute
                "viewBox"
                ("0 0 " ++ String.fromInt cfg.width ++ " " ++ String.fromInt cfg.height)
            , Attr.attribute "xmlns" "http://www.w3.org/2000/svg"
            , Attr.role Attr.Img
            , Attr.attribute "preserveAspectRatio" "none"
            , Attr.style "display: block; max-width: 100%; height: auto;"
            ]
            (maybeCons (titleNode cfg) cells)
        )


heatmapRow : Cfg -> Float -> Float -> Float -> Float -> Int -> List Float -> List (Html msg)
heatmapRow cfg cellW cellH gMin gMax rowIdx row =
    let
        rowIdxF =
            toFloat rowIdx

        gSpan =
            gMax - gMin

        baseCss =
            Ui.colorCss cfg.color
    in
    List.indexedMap
        (\colIdx v ->
            let
                colIdxF =
                    toFloat colIdx

                x =
                    colIdxF * cellW

                y =
                    rowIdxF * cellH

                intensity =
                    if gSpan == 0.0 then
                        1.0

                    else
                        Math.max 0.0 (Math.min 1.0 ((v - gMin) / gSpan))
            in
            Html.node "rect"
                [ Attr.attribute "x" (String.fromFloat x)
                , Attr.attribute "y" (String.fromFloat y)
                , Attr.attribute "width" (String.fromFloat cellW)
                , Attr.attribute "height" (String.fromFloat cellH)
                , Attr.attribute "fill" baseCss
                , Attr.attribute "fill-opacity" (String.fromFloat intensity)
                , Attr.attribute "stroke" "#ffffff"
                , Attr.attribute "stroke-width" "0.5"
                ]
                []
        )
        row


heatmapMaxCols : List (List Float) -> Int
heatmapMaxCols grid =
    case grid of
        [] ->
            0

        row :: rest ->
            heatmapMaxColsHelp (List.length row) rest


heatmapMaxColsHelp : Int -> List (List Float) -> Int
heatmapMaxColsHelp acc grid =
    case grid of
        [] ->
            acc

        row :: rest ->
            heatmapMaxColsHelp (Math.max acc (List.length row)) rest


heatmapRange : List (List Float) -> Range
heatmapRange grid =
    case grid of
        [] ->
            { lo = 0.0, hi = 1.0 }

        row :: _ ->
            case row of
                [] ->
                    { lo = 0.0, hi = 1.0 }

                v :: _ ->
                    heatmapRangeHelp v v grid


heatmapRangeHelp : Float -> Float -> List (List Float) -> Range
heatmapRangeHelp lo hi grid =
    case grid of
        [] ->
            { lo = lo, hi = hi }

        row :: rest ->
            let
                r =
                    yRangeOfFloats row

                newLo =
                    if List.isEmpty row then
                        lo

                    else
                        Math.min lo r.lo

                newHi =
                    if List.isEmpty row then
                        hi

                    else
                        Math.max hi r.hi
            in
            heatmapRangeHelp newLo newHi rest
