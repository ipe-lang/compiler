-- | Ipe.Db.Codec — the seam that turns one `Ipe.Codec.Codec a` into a database
-- row and back, so a single codec is the source of truth for the wire form, the
-- column shape, AND the stored row.
--
-- `Ipe.Codec` itself knows nothing about SQL — it holds a JSON encoder, a JSON
-- decoder factory, and a dialect-neutral `Shape`. This module is the only place
-- the codec meets `SqlValue`: it imports both `Ipe.Codec` (for the encoder,
-- decoder, and `Shape`) and the reserved `SqlValue` sum type, and bridges them
-- WITHOUT re-encoding, without a string round-trip, and without a second
-- decoder. Both directions reuse the codec's own JSON seam:
--
--   * `codecToBinds` runs the codec's encoder to ONE in-memory `Value`, walks
--     the codec's `Shape`, and reads each declared column out of that `Value`
--     with the JSON decoder that matches the column's `ColType`, coercing it to
--     a BOUND `SqlValue`. Every value produced is a parameter binding, never SQL
--     text — the bridge constructs no query string, so it adds no injection
--     surface over `Ipe.Db.Sql`'s already-parameterised binds.
--
--   * `codecFromRow` builds an in-memory `Value` object from the row's cells,
--     one field per declared column parsed into the JSON scalar the decoder
--     expects, then runs the codec's OWN `Decoder` on that `Value` via
--     `Json.Decode.decodeValue`. A row cell is `Maybe String`: `Nothing` is SQL
--     `NULL`, kept apart from the empty string, so a nullable column reads back
--     `Nothing` only for `NULL` and `Just ""` only for an empty value. Schema
--     drift (a missing column, a `NULL` in a non-nullable column, a cell that is
--     not the declared shape) surfaces as a typed `Err`, never a wrong value.
--
-- Fail-closed throughout. A codec whose `Shape` is not an `SRecord` cannot name
-- columns, so both directions reject it with a typed `Error` rather than guess.
-- A scalar that does not match its `ColType` is a typed `Err`, never a silently
-- mis-typed bind. An exact-decimal or money field (whose codec encodes to a JSON
-- string) round-trips as TEXT — it is never coerced through a lossy `Float`.
--
--     import Ipe.Db.Codec as DbCodec
--     import Ipe.Codec as Codec exposing (Codec)
--
--     -- Given `userCodec : Codec User` (an `SRecord` codec):
--     --   DbCodec.codecToBinds userCodec user
--     --       == Ok [ ( "id", SqlString "…" ), ( "age", SqlInt 30 ), … ]
--     --   DbCodec.codecFromRow userCodec row == Ok user   (row from those binds)
module Ipe.Db.Codec exposing
    ( codecToBinds
    , codecFromRow
    , toSqlValue
    )


import Ipe.Codec as Codec exposing (Codec(..), ColType(..), Shape(..))
import Ipe.Json.Encode as Encode
import Ipe.Json.Decode as Decode
import Ipe.Config as Config
import Ipe.Decimal as Decimal exposing (Decimal)
import Ipe.Dict as Dict
import Ipe.List as List
import Ipe.Maybe as Maybe exposing (Maybe(..))
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Error as Error exposing (Error)


-- ─── Encode direction: codec + value → bound binds ─────────────────


-- | Project a value through its codec to the `(column, SqlValue)` binds a row
-- INSERT/UPDATE takes. The codec's encoder runs to ONE in-memory `Value`; each
-- column declared by the codec's `Shape` is read back out of that `Value` and
-- coerced to a BOUND `SqlValue` matching its `ColType`. Every element is a
-- parameter binding — no SQL text is built here.
--
-- Fail-closed: a codec whose shape is not an `SRecord` (a bare scalar, a blob,
-- a container) has no column list, so it is a typed `Err`. A field whose encoded
-- JSON does not match its declared `ColType` is likewise a typed `Err`, never a
-- wrong bind.
codecToBinds : Codec a -> a -> Result Error (List ( String, SqlValue ))
codecToBinds codec x =
    case Codec.shape codec of
        SRecord columns ->
            bindsFromValue (Codec.toValue codec x) columns

        SScalar _ ->
            Err notARecordError

        SBlob ->
            Err notARecordError


bindsFromValue : Value -> List ( String, ColType ) -> Result Error (List ( String, SqlValue ))
bindsFromValue value columns =
    List.foldr (\col acc -> consBind value col acc) (Ok []) columns


consBind :
    Value
    -> ( String, ColType )
    -> Result Error (List ( String, SqlValue ))
    -> Result Error (List ( String, SqlValue ))
consBind value col acc =
    case acc of
        Err e ->
            Err e

        Ok rest ->
            case col of
                ( name, colType ) ->
                    case bindColumn value name colType of
                        Ok sqlValue ->
                            Ok (( name, sqlValue ) :: rest)

                        Err e ->
                            Err e


-- | Read ONE column out of the encoded `Value` and coerce it to a bound
-- `SqlValue`, running the JSON decoder that matches the column's `ColType`
-- against the field. A decode failure (the field is absent or not the declared
-- shape) is a typed `Err`.
bindColumn : Value -> String -> ColType -> Result Error SqlValue
bindColumn value name colType =
    Decode.decodeValue (Decode.field name (sqlValueDecoder colType)) value


-- | The `Decoder SqlValue` for one column type. Each arm reads the field as the
-- JSON scalar its `ColType` implies and wraps it in the matching bound
-- constructor:
--
--   * `CText`    → JSON string  → `SqlString`
--   * `CInt`     → JSON integer → `SqlInt`
--   * `CReal`    → JSON number  → `SqlFloat`
--   * `CBool`    → JSON boolean → `SqlInt` 0/1 (bound as an integer flag)
--   * `CTime`    → JSON integer → `SqlTime` (Unix millis, bound as the time role)
--   * `CDecimal` → JSON string  → `SqlDecimal` (lossless exact decimal; the
--                  string is parsed to `Decimal` by the runtime bind, so a
--                  quantity is never coerced through a lossy `Float`)
--   * `CMoney`   → JSON string  → `SqlMoney` ("AMOUNT ISO_CODE" verbatim; the
--                  runtime bind holds the full string, never a bare `SqlString`)
--   * `CBlob`    → any JSON node → its compact serialisation as `SqlString` TEXT
--   * `CNull inner` → JSON null → `SqlNull <inner witness>`; any other value is
--     coerced as `inner`, so a nullable column binds a real NULL or the inner
--     scalar, never a wrong type.
--
-- A `CTime` column's millis bind as `SqlTime`, never `SqlInt`; a `CDecimal`
-- column binds as `SqlDecimal`, never `SqlString`; a `CMoney` column binds as
-- `SqlMoney`, never `SqlString` — the role lives in the variant tag so each
-- kind is structurally distinct at the bind site.
sqlValueDecoder : ColType -> Decoder SqlValue
sqlValueDecoder colType =
    case colType of
        CText ->
            Decode.map (\s -> SqlString s) Decode.string

        CInt ->
            Decode.map (\n -> SqlInt n) Decode.int

        CReal ->
            Decode.map (\f -> SqlFloat f) Decode.float

        CBool ->
            Decode.map (\b -> SqlInt (boolToInt b)) Decode.bool

        CTime ->
            Decode.map (\ms -> SqlTime ms) Decode.int

        CDecimal ->
            Decode.andThen decimalSqlDecoder Decode.string

        CMoney ->
            Decode.map (\s -> SqlMoney s) Decode.string

        CBlob ->
            Decode.map (\node -> SqlString (Encode.encode 0 node)) Decode.value

        CNull inner ->
            Config.nullable (sqlValueDecoder inner)
                |> Decode.map (nullableToSqlValue inner)


boolToInt : Bool -> Int
boolToInt b =
    if b then
        1

    else
        0


-- | Parse a JSON string to a `SqlDecimal` bind. The `Decimal` runtime parses
-- the lossless string; a malformed value is a typed decode failure.
decimalSqlDecoder : String -> Decoder SqlValue
decimalSqlDecoder s =
    case Decimal.fromString s of
        Ok d ->
            Decode.succeed (SqlDecimal d)

        Err _ ->
            Decode.fail (badDecimalBindMessage s)


-- | Fold a decoded nullable column to a `SqlValue`: `Nothing` (a JSON null) is a
-- real SQL NULL that carries the inner column's type witness so the bind site
-- can pick a correctly-typed `NULL`; `Just` is the already-coerced inner value.
nullableToSqlValue : ColType -> Maybe SqlValue -> SqlValue
nullableToSqlValue inner decoded =
    case decoded of
        Nothing ->
            SqlNull (nullWitness inner)

        Just sqlValue ->
            sqlValue


-- | A typed-NULL witness for a column type — a zero/empty value of the inner
-- constructor, discarded by the bind site (a NULL carries no data) but pinning
-- the variant TAG so a nullable column binds `NULL` at the right type. A nested
-- `CNull` collapses to its innermost witness (a doubly-nullable column is one
-- NULL).
nullWitness : ColType -> SqlValue
nullWitness colType =
    case colType of
        CText ->
            SqlString ""

        CInt ->
            SqlInt 0

        CReal ->
            SqlFloat 0.0

        CBool ->
            SqlInt 0

        CTime ->
            SqlTime 0

        CDecimal ->
            SqlDecimal (Decimal.fromInt 0)

        CMoney ->
            SqlMoney ""

        CBlob ->
            SqlString ""

        CNull inner ->
            nullWitness inner


-- | Project a SCALAR-shaped value through its codec to one bound `SqlValue`.
-- Where `codecToBinds` handles an `SRecord` codec (a whole row), this handles a
-- codec whose `Shape` is a single `SScalar` column — an enum or newtype whose
-- wire form is one JSON scalar. The codec's encoder runs to one in-memory
-- `Value`, then the decoder for the column's `ColType` coerces it to the matching
-- bound constructor (`SqlString` / `SqlInt` / …). The result is a parameter
-- binding — no SQL text is built.
--
-- Fail-closed: a codec whose shape is not `SScalar` (a record or a blob has no
-- single column type) is a typed `Err`; so is an encoded value that does not
-- match its declared `ColType`. Used by `Ipe.Db.Store.eqBy` to bind an enum or
-- newtype column's query value.
toSqlValue : Codec a -> a -> Result Error SqlValue
toSqlValue codec x =
    case Codec.shape codec of
        SScalar colType ->
            bindScalar (Codec.toValue codec x) colType

        SRecord _ ->
            Err notARecordError

        SBlob ->
            Err notARecordError


-- | Coerce a single encoded `Value` to a bound `SqlValue` for a scalar column
-- type, running the same `ColType`-directed decoder the row binds use. A decode
-- failure (the value is not the declared scalar shape) is a typed `Err`.
bindScalar : Value -> ColType -> Result Error SqlValue
bindScalar value colType =
    Decode.decodeValue (sqlValueDecoder colType) value


-- ─── Decode direction: codec + row → value ─────────────────────────


-- | Rebuild a value from a database row through its codec. The row maps each
-- column name to its cell, `Nothing` for SQL `NULL`. Each column declared by the
-- codec's `Shape` is parsed from its row cell into the JSON scalar the decoder
-- expects, assembled into ONE in-memory `Value` object, and the codec's OWN
-- `Decoder` is run on that `Value`. No second decoder is written — the same
-- decoder that reads the wire form reads the row.
--
-- Fail-closed: a codec whose shape is not an `SRecord`, a declared column
-- missing from the row, a `NULL` cell in a non-nullable column, or a cell that
-- does not parse to its declared shape is a typed `Err`. Schema drift surfaces
-- as an error, never a wrong value.
codecFromRow : Codec a -> Dict String (Maybe String) -> Result Error a
codecFromRow codec row =
    case codec of
        Codec r ->
            case r.shp of
                SRecord columns ->
                    case valueFromRow row columns of
                        Ok value ->
                            Decode.decodeValue (r.mkDec {}) value

                        Err e ->
                            Err e

                SScalar _ ->
                    Err notARecordError

                SBlob ->
                    Err notARecordError


-- | Assemble the row's cells into a JSON `Value` object, one field per declared
-- column parsed into the JSON node its `ColType` implies.
valueFromRow : Dict String (Maybe String) -> List ( String, ColType ) -> Result Error Value
valueFromRow row columns =
    case fieldsFromRow row columns of
        Ok fields ->
            Ok (Encode.object fields)

        Err e ->
            Err e


fieldsFromRow : Dict String (Maybe String) -> List ( String, ColType ) -> Result Error (List ( String, Value ))
fieldsFromRow row columns =
    List.foldr (\col acc -> consField row col acc) (Ok []) columns


consField :
    Dict String (Maybe String)
    -> ( String, ColType )
    -> Result Error (List ( String, Value ))
    -> Result Error (List ( String, Value ))
consField row col acc =
    case acc of
        Err e ->
            Err e

        Ok rest ->
            case col of
                ( name, colType ) ->
                    case cellToValue name colType (lookupCell name row) of
                        Ok node ->
                            Ok (( name, node ) :: rest)

                        Err e ->
                            Err e


-- One column's cell as the row holds it: the column is absent from the row, its
-- cell is SQL `NULL`, or its cell holds text (possibly empty). The three cases
-- are distinct, so `NULL` and the empty string can never be confused.
type Cell
    = CellAbsent
    | CellNull
    | CellText String


lookupCell : String -> Dict String (Maybe String) -> Cell
lookupCell name row =
    case Dict.get name row of
        Nothing ->
            CellAbsent

        Just maybeText ->
            case maybeText of
                Nothing ->
                    CellNull

                Just text ->
                    CellText text


-- | Parse one row cell into the JSON node its `ColType` implies:
--
--   * `CText`    → the cell verbatim as a JSON string
--   * `CInt`     → the cell parsed as an integer JSON number (non-integral → Err)
--   * `CReal`    → the cell parsed as a JSON number
--   * `CBool`    → `"0"`/`"1"` (or `"true"`/`"false"`) as a JSON boolean
--   * `CTime`    → the cell parsed as an integer JSON number of Unix millis
--   * `CDecimal` → the cell validated as an exact decimal, kept as a JSON string
--   * `CMoney`   → the cell kept verbatim as a JSON string ("AMOUNT ISO_CODE")
--   * `CBlob`    → the cell parsed as JSON TEXT back into its node
--   * `CNull inner` → JSON null when the cell is SQL `NULL`, else parse as
--     `inner` (an empty or `"NULL"` text cell is text, never `NULL`)
--
-- An absent column, a `NULL` cell in a non-nullable column, or a cell that does
-- not parse to its declared shape is a typed `Err`.
cellToValue : String -> ColType -> Cell -> Result Error Value
cellToValue name colType cell =
    case colType of
        CNull inner ->
            case cell of
                CellNull ->
                    Ok Encode.null

                CellAbsent ->
                    Err (missingColumnError name)

                CellText _ ->
                    cellToValue name inner cell

        CText ->
            requireText name cell (scalarCellToValue name colType)

        CInt ->
            requireText name cell (scalarCellToValue name colType)

        CReal ->
            requireText name cell (scalarCellToValue name colType)

        CBool ->
            requireText name cell (scalarCellToValue name colType)

        CTime ->
            requireText name cell (scalarCellToValue name colType)

        CDecimal ->
            requireText name cell (scalarCellToValue name colType)

        CMoney ->
            requireText name cell (scalarCellToValue name colType)

        CBlob ->
            requireText name cell (scalarCellToValue name colType)


-- | A non-nullable column MUST hold a text cell: an absent column is a typed
-- missing-column `Err`, and a `NULL` cell a typed null-in-required-column `Err`.
-- Threads the text into the parser.
requireText : String -> Cell -> (String -> Result Error Value) -> Result Error Value
requireText name cell parse =
    case cell of
        CellText text ->
            parse text

        CellNull ->
            Err (nullCellError name)

        CellAbsent ->
            Err (missingColumnError name)


scalarCellToValue : String -> ColType -> String -> Result Error Value
scalarCellToValue name colType cell =
    case colType of
        CText ->
            Ok (Encode.string cell)

        CInt ->
            case String.toInt cell of
                Just n ->
                    Ok (Encode.int n)

                Nothing ->
                    Err (badCellError name colType cell)

        CReal ->
            case String.toFloat cell of
                Just f ->
                    Ok (Encode.float f)

                Nothing ->
                    Err (badCellError name colType cell)

        CBool ->
            case boolFromCell cell of
                Just b ->
                    Ok (Encode.bool b)

                Nothing ->
                    Err (badCellError name colType cell)

        CTime ->
            case String.toInt cell of
                Just ms ->
                    Ok (Encode.int ms)

                Nothing ->
                    Err (badCellError name colType cell)

        CDecimal ->
            case Decimal.fromString cell of
                Ok _ ->
                    Ok (Encode.string cell)

                Err _ ->
                    Err (badCellError name colType cell)

        CMoney ->
            Ok (Encode.string cell)

        CBlob ->
            Decode.decodeString Decode.value cell

        CNull inner ->
            scalarCellToValue name inner cell


boolFromCell : String -> Maybe Bool
boolFromCell cell =
    case cell of
        "1" ->
            Just True

        "0" ->
            Just False

        "true" ->
            Just True

        "false" ->
            Just False

        _ ->
            Nothing


-- ─── Errors ────────────────────────────────────────────────────────


-- | The codec's shape is not an `SRecord`, so it declares no columns to bind or
-- read — a typed invalid-input error, never a guess.
notARecordError : Error
notARecordError =
    Error.invalidInput
        "Ipe.Db.Codec: the codec's shape is not a record, so it has no columns to bind or read"


missingColumnError : String -> Error
missingColumnError name =
    Error.invalidInput
        (String.concat [ "Ipe.Db.Codec: row is missing the required column \"", name, "\"" ])


nullCellError : String -> Error
nullCellError name =
    Error.invalidInput
        (String.concat [ "Ipe.Db.Codec: column \"", name, "\" is NULL but its field is not a Maybe" ])


badCellError : String -> ColType -> String -> Error
badCellError name colType cell =
    Error.invalidInput
        (String.concat
            [ "Ipe.Db.Codec: column \""
            , name
            , "\" cell \""
            , cell
            , "\" is not a "
            , colTypeName colType
            ]
        )


colTypeName : ColType -> String
colTypeName colType =
    case colType of
        CText ->
            "text value"

        CInt ->
            "integer"

        CReal ->
            "real number"

        CBool ->
            "boolean"

        CTime ->
            "integer timestamp"

        CDecimal ->
            "exact decimal string"

        CMoney ->
            "money string (AMOUNT ISO_CODE)"

        CBlob ->
            "JSON value"

        CNull inner ->
            colTypeName inner


badDecimalBindMessage : String -> String
badDecimalBindMessage s =
    String.concat [ "Ipe.Db.Codec: not an exact decimal \"", s, "\"" ]
