-- | Ipe.Db.Store — typed, injection-safe persistence over the audited `Ipe.Db`.
--
-- A `Store a` is one classified, queryable table whose row type is `a`,
-- described once by a `Codec a`: the codec is the single source of truth for the
-- columns, the writes, and the reads. The safe surface cannot express SQL
-- injection — every identifier reaches SQL only after `validSqlIdent` accepts it,
-- and every value binds as a parameter, never interpolated.
--
-- Access is deny-by-default: `fromCodec` yields a `Draft a` with no read or write
-- operation, and only an explicit classification promotes it to something
-- queryable — `public` (world-open `Store a`) or `secured` (a policy-guarded
-- `Secured a`, read and written only through the authenticated `…As` operations,
-- each taking a `Principal`). A table nobody classified is unqueryable by
-- construction. A caller who wants raw SQL, or a non-codec dynamic table, reaches
-- for the capability-gated `Ipe.Db.Store.Unsafe`.
--
-- The mental model, the secured row-security grammar, and a runnable end-to-end
-- example live in the Store guide; the composable owner/tenant/RBAC/sharing
-- policy algebra lives in its sibling composition guide. This doc-comment is the
-- per-symbol reference — see the guides for the narrative and the worked example.
module Ipe.Db.Store exposing
    ( Draft(..)
    , Store(..)
    , Column(..)
    , ColType(..)
    , ColumnSpec(..)
    , PrimaryKeyDecl(..)
    , IndexSpec(..)
    , Row
    , validSqlIdent, validSqlIdentPlain
    , column, textColumn, intColumn, floatColumn, boolColumn
    , fromCodec, fromColumns, rowCodec
    , public
    , primaryKey, serial, unique, defaultNow
    , defaultText, defaultInt, touchOnUpdate
    , compositePrimaryKey2, compositePrimaryKey3
    , primaryKeyNamed, compositePrimaryKeyNamed
    , serialNamed, uniqueNamed, defaultNowNamed
    , defaultTextNamed, defaultIntNamed, touchOnUpdateNamed
    , index, indexNamed
    , tableName, columnNames, createSql
    , readText, readInt, readBool, readFloat
    , insert, insertReturning, upsert, insertIfAbsent, all, get, delete, findWhere, create
    , allOn, getOn, findWhereOn
    , update, updateWhere, deleteWhere, findBy
    , renameColumn, renameTable, migrations
    , noopRenameError
    , Cond(..), CompareOp(..), Query
    , query, where
    , eq, eqBy
    , neq, neqBy
    , gt, gtBy
    , gte, gteBy
    , lt, ltBy
    , lte, lteBy
    , like
    , isNull, notNull
    , inList, inListBy
    , and, or, not
    , orderAsc, orderDesc, limit, offset
    , toList, toMaybe, count
    , Order(..)
    , Joined
    , join, joinNamed
    , joinFilterLeft, joinFilterRight
    , orderByLeft, orderByRight
    , orderByLeftNamed, orderByRightNamed
    , joinToList, joinToMaybe, joinCount
    , Select
    , select, selectNamed, literal, upper, lower, coalesce, add, sub, mul
    , selectToList, selectToMaybe
    , Policy, Secured, Pred
    , always, never, allOf, anyOf, notPred, matchWhere
    , role, memberOf, claimEquals
    , correlate, existsIn, existsInNamed
    , readOnly, alsoInsert, alsoUpdate, alsoDelete
    , unrestricted, publicRead, ownerColumn, immutable, mask, andPolicy, secured
    , ownerColumnNamed, immutableNamed, maskNamed
    , explain
    , allAs, getAs, insertAs, updateAs, deleteAs
    )


import Ipe.Auth as Auth
import Ipe.Basics as Basics
import Ipe.Codec as Codec exposing (Codec(..), ColType(..), Shape(..))
import Ipe.Db as Db
import Ipe.Db.Codec as DbCodec
import Ipe.Db.Dsn as Dsn exposing (Connection)
import Ipe.Db.Sql as Sql
import Ipe.Ffi.Kernel as Kernel
import Ipe.Json.Encode as Encode
import Ipe.Json.Decode as Decode
import Ipe.Config as Config
import Ipe.Char as Char
import Ipe.String as String
import Ipe.List as List
