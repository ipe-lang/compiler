-- | Ipe.Db.Dsn — a typed, opaque database connection descriptor
-- (parse-don't-validate,).
--
-- `Dsn` is opaque and reserved: the ONLY ways to obtain one are `parse` (from a
-- full DSN URL string) and `build` (from typed parts). Both enforce the same
-- fail-closed invariants in the runtime kernel (`parse` on URL text, `build` on
-- literal parts), so a `Dsn` value is a proof that the descriptor passed every
-- check — an invalid DSN is a typed `Err`, never a silently-accepted,
-- re-injectable value.
--
-- The descriptor's password is a `Secret`: it is never rendered, logged, or
-- returned as a plain `String`. There is no password accessor; the only display
-- path is `redacted`, which substitutes a placeholder.
--
-- This module owns the parse SURFACE only. Connecting a `Dsn` to a live database
-- is a separate, separately-reviewed capability (it discloses `network`); a
-- `Dsn` on its own performs no I/O and discloses no capability.
module Ipe.Db.Dsn exposing
    ( Dsn
    , Driver(..)
    , TlsMode(..)
    , Connection
    , ReadOnly
    , ReadWrite
    , parse
    , build
    , driver
    , host
    , port
    , database
    , user
    , tls
    , redacted
    , open
    , close
    )


import Ipe.Ffi.Kernel as Kernel
import Ipe.Error exposing (Error)
import Ipe.Result as Result
import Ipe.Task exposing (Task)
import Ipe.Net as Net exposing (Port)
import Ipe.Maybe exposing (Maybe(..))


-- ── Types ─────────────────────────────────────────────────────────────────────


-- | The closed set of drivers the runtime can describe — exactly the two the
-- runtime links. A driver the runtime cannot dial is unrepresentable here, not a
-- free string.
type Driver
    = Postgres
    | Sqlite


-- | The transport-security posture: TLS with the server certificate verified.
-- `VerifyFull` (`sslmode=verify-full`) checks that the certificate chains to a
-- trusted root and names the dialled host; it is the default when a DSN names
-- no `sslmode`. `VerifyCa` (`sslmode=verify-ca`) checks the chain but not the
-- host name, so it is weaker: any certificate from a trusted root is accepted
-- for any host. Every mode that accepts an unverified server or a cleartext
-- transport (`sslmode=require`, `prefer`, `allow`, `disable`) is rejected by
-- every constructor, so a `Dsn` is a proof that its connection authenticates
-- the server.
--
-- The server certificate must chain to a root in the Mozilla root set the
-- runtime is built with; the operating system's certificate store is not
-- consulted, and a certificate issued by a private certificate authority is
-- refused. Where the runtime cannot route a connection through its pinned
-- relay (on platforms other than Unix), a `VerifyFull` connection to a named
-- host is refused; name the server by its IP address or use `VerifyCa`.
type TlsMode
    = VerifyFull
    | VerifyCa


-- ── Construction ──────────────────────────────────────────────────────────────


-- | `parse raw` — THE seal from a full DSN URL string. Returns `Err` on any
-- invalid shape: an unparseable string, an unknown driver, a missing host for a
-- network driver, an out-of-range port, an `sslmode` that does not verify the
-- server (`require`, `prefer`, `allow`, `disable`), an unknown `sslmode`, a smuggled/duplicated credential parameter, a control-character
-- component, or a PostgreSQL user name or password that may run past the URL's
-- authority. An `@` anywhere after the host (in the path or a query value) is
-- refused the same way; write it as `%40`. The user name, password, and database
-- are percent-decoded, so `user` and `database` return the decoded text. The
-- password is captured as a `Secret`; a password with no user name, and a DSN
-- longer than 4096 bytes, are rejected. A sqlite DSN names its file by everything
-- after `sqlite:`, `sqlite://`, or `file:`, percent-decoded; credentials, any
-- query but `mode=rwc`, and a file name starting `file:` are rejected.
parse : String -> Result Error Dsn
parse =
    Kernel.kernel "Db.Dsn_parse"


-- | `build parts` — THE seal from typed parts, enforcing the invariants `parse`
-- does on literal parts. Preferred over `parse` when the parts are already
-- structured (there is no string to mis-escape). The `password` is a `Secret` on
-- the way in; an out-of-range port is rejected. The `database`, `user`, and
-- `password` are taken literally and percent-encoded into the connection URL, so a
-- `?`, `&`, `#`, `@`, `/`, or `%` in them cannot add a parameter such as `sslmode`.
-- Each is capped at 512 bytes, and a `password` needs a `user`.
-- A sqlite `database` is a literal file name, opened create-if-missing, and no
-- character in it can change how the file is opened; `:memory:` is the
-- in-memory database, and a name starting `file:` is rejected.
-- The `host` must be a host name or IP literal (IPv6 in brackets); one holding a
-- URL delimiter is rejected.
build :
    { driver : Driver
    , host : String
    , port : Port
    , database : String
    , user : String
    , password : Secret
    , tls : TlsMode
    }
    -> Result Error Dsn
build parts =
    buildKernel
        (driverTag parts.driver)
        parts.host
        (Net.toInt parts.port)
        parts.database
        parts.user
        parts.password
        (tlsTag parts.tls)


-- The 7-arg runtime constructor over primitive tags. The `Driver` / `TlsMode`
-- ADTs are marshalled to their small-integer discriminants by `driverTag` /
-- `tlsTag` before the call, so no ADT crosses the kernel boundary.
buildKernel : Int -> String -> Int -> String -> String -> Secret -> Int -> Result Error Dsn
buildKernel =
    Kernel.kernel "Db.Dsn_build"


-- ── Accessors ─────────────────────────────────────────────────────────────────


-- | `driver dsn` — the descriptor's driver.
driver : Dsn -> Driver
driver dsn =
    driverFromTag (driverTagKernel dsn)


-- | `host dsn` — the host component (`""` for a file-backed sqlite descriptor).
host : Dsn -> String
host =
    Kernel.kernel "Db.Dsn_host"


-- | `port dsn` — the network port as a validated `Ipe.Net.Port`, or `Nothing`
-- for a file-backed sqlite descriptor (which has no port; the kernel returns the
-- `0` sentinel, which `Net.fromInt` rejects, yielding `Nothing`).  A network
-- descriptor always carries a `1..65535` port, so `Net.fromInt` re-proves the
-- range the kernel already enforced at construction.
port : Dsn -> Maybe Port
port dsn =
    Result.toMaybe (Net.fromInt (portRaw dsn))


-- Internal — the raw kernel port (`0` for sqlite).  Never exported; the only
-- public reader is `port`, which wraps it into a validated `Maybe Port`.
portRaw : Dsn -> Int
portRaw =
    Kernel.kernel "Db.Dsn_port"


-- | `database dsn` — the database name (or file path, for sqlite).
database : Dsn -> String
database =
    Kernel.kernel "Db.Dsn_database"


-- | `user dsn` — the connection user (`""` when none).
user : Dsn -> String
user =
    Kernel.kernel "Db.Dsn_user"


-- | `tls dsn` — the descriptor's transport posture.
tls : Dsn -> TlsMode
tls dsn =
    tlsFromTag (tlsTagKernel dsn)


-- | `redacted dsn` — a credential-free, human-readable rendering. The password is
-- NEVER included; this is the ONLY display path a `Dsn` has.
redacted : Dsn -> String
redacted =
    Kernel.kernel "Db.Dsn_redacted"


-- ── Connecting a Dsn — read-only by type ───────────────────────────────────────
--
-- `Connection mode` is a live connection to a database the application was NOT
-- built against. Its phantom `mode` (`ReadOnly` / `ReadWrite`) is the access
-- posture as a TYPE, not a runtime flag: a mutating kernel requires `Connection
-- ReadWrite`, so a `Connection ReadOnly` from `open` CANNOT type-check into a
-- write. The read-only guarantee is a compile error, never a caught runtime `Err`.
-- The mode is erased at runtime — both are the one concrete connection handle.


-- | `open dsn` — connect a parsed `Dsn` to a live, read-only external database.
-- The `Dsn` arrived through a validating parse, so no unchecked string reaches the
-- connector. Discloses `network` (it reaches an arbitrary host of the program's
-- choosing). Fails closed: an unreachable host, a refused connection, or a bad
-- credential is a typed `Err` that leaks no credential. Writing to the returned
-- `Connection ReadOnly` is a COMPILE error — request a raw write only through the
-- explicitly-disclosed `Ipe.Db.Unsafe.unsafeExecRawOn`.
open : Dsn -> Task Error (Connection ReadOnly)
open =
    Kernel.kernel "Db.Dsn_open"


-- | `close conn` — return the connection's pool. Total and idempotent over either
-- access mode; a `Connection` dropped without `close` still releases its pool.
close : Connection mode -> Task Error ()
close =
    Kernel.kernel "Db.Dsn_close"


-- ── Tag marshalling (ADT ↔ runtime discriminant) ──────────────────────────────


driverTagKernel : Dsn -> Int
driverTagKernel =
    Kernel.kernel "Db.Dsn_driverTag"


tlsTagKernel : Dsn -> Int
tlsTagKernel =
    Kernel.kernel "Db.Dsn_tlsTag"


driverTag : Driver -> Int
driverTag d =
    case d of
        Postgres ->
            0

        Sqlite ->
            1


tlsTag : TlsMode -> Int
tlsTag t =
    case t of
        VerifyFull ->
            0

        VerifyCa ->
            1


-- The runtime only ever hands back a valid driver discriminant (0 or 1); the
-- `_` arm keeps the case total and defaults, conservatively, to the network
-- driver rather than fabricating an impossible value.
driverFromTag : Int -> Driver
driverFromTag tag =
    case tag of
        1 ->
            Sqlite

        _ ->
            Postgres


-- The runtime only ever hands back a TLS discriminant `tlsTag` produces (0 or
-- 1); the `_` arm keeps the case total and defaults to the strongest posture.
tlsFromTag : Int -> TlsMode
tlsFromTag tag =
    case tag of
        1 ->
            VerifyCa

        _ ->
            VerifyFull
