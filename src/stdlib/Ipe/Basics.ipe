-- | Ipe.Basics — the implicit prelude (Tier-A auto-import, compiled source).
--
-- Each binding routes to its runtime kernel via `Kernel.kernel`. Polymorphic
-- members with ordering or numeric obligations (`clamp`, `min`, `max`,
-- `negate`, `abs`, `compare`) carry the bound implicitly — the type-checker's
-- `Comparable`/`Number` obligation rejects a function, record, list, or tuple
-- argument before it monomorphises. `sqrt` is monomorphically `Float -> Float`.
module Ipe.Basics exposing
    ( identity
    , always
    , not
    , fst
    , snd
    , clamp
    , modBy
    , negate
    , abs
    , sqrt
    , min
    , max
    , compare
    )


import Ipe.Ffi.Kernel as Kernel


{-| `identity x` — return `x` unchanged.

The canonical no-op transformation. Useful as a placeholder when a
higher-order function requires a function argument but you want the
value to pass through untouched.

```ipe
identity 42 --> 42
identity "hello" --> "hello"
```
-}
identity : a -> a
identity = Kernel.kernel "Basics_identity"


{-| `always x y` — return `x`, ignoring `y`.

Produces a function that always returns the same value regardless of
its argument. Handy for filling in callbacks you want to suppress.

```ipe
always 5 "anything" --> 5
List.map (always 0) [ 1, 2, 3 ] --> [ 0, 0, 0 ]
```
-}
always : a -> b -> a
always = Kernel.kernel "Basics_always"


{-| `not b` — boolean negation.

```ipe
not True --> False
not False --> True
```
-}
not : Bool -> Bool
not = Kernel.kernel "Basics_not"


{-| `fst pair` — the first component of a 2-tuple.

```ipe
fst ( 1, 2 ) --> 1
fst ( "hello", True ) --> "hello"
```
-}
fst : ( a, b ) -> a
fst = Kernel.kernel "Basics_fst"


{-| `snd pair` — the second component of a 2-tuple.

```ipe
snd ( 1, 2 ) --> 2
snd ( "hello", True ) --> True
```
-}
snd : ( a, b ) -> b
snd = Kernel.kernel "Basics_snd"


{-| `clamp lo hi x` — constrain `x` to the range `[lo, hi]`.

Returns `lo` when `x < lo`, `hi` when `x > hi`, and `x` otherwise.
Works on any comparable scalar: `Int`, `Float`, `String`, `Char`, or `Bool`.

```ipe
clamp 0 100 42 --> 42
clamp 0 100 (-5) --> 0
clamp 0 100 200 --> 100
clamp "a" "z" "m" --> "m"
```
-}
clamp : a -> a -> a -> a
clamp = Kernel.kernel "Basics_clamp"


{-| `modBy divisor dividend` — the modulo remainder, with the sign of the
divisor.

This follows the mathematical modulo convention (not C-style remainder):
the result is always in the range `[0, abs divisor)` when `divisor > 0`.

```ipe
modBy 3 10 --> 1
modBy 3 (-1) --> 2
modBy 5 0 --> 0
```
-}
modBy : Int -> Int -> Int
modBy = Kernel.kernel "Basics_modBy"


{-| `negate x` — arithmetic negation.

Works on any `Number` type (`Int` or `Float`).

```ipe
negate 5 --> -5
negate (-3) --> 3
negate 0 --> 0
negate 2.5 --> -2.5
```
-}
negate : a -> a
negate = Kernel.kernel "Basics_negate"


{-| `abs x` — absolute value.

Works on any `Number` type. Returns the magnitude of `x` without its sign.

```ipe
abs (-7) --> 7
abs 7 --> 7
abs 0 --> 0
abs (-3.14) --> 3.14
```
-}
abs : a -> a
abs = Kernel.kernel "Basics_abs"


{-| `sqrt x` — the non-negative square root of `x`.

Returns `NaN` for negative inputs (follows IEEE 754). For integer square
roots, convert with `round`, `floor`, or `ceil`.

```ipe
sqrt 9.0 --> 3.0
sqrt 2.0 --> 1.4142135623730951
sqrt 0.0 --> 0.0
```
-}
sqrt : Float -> Float
sqrt = Kernel.kernel "Basics_sqrt"


{-| `min a b` — the smaller of two comparable values.

Works on any `Comparable` scalar: `Int`, `Float`, `String`, `Char`, or
`Bool`. A list, tuple, or record is not comparable. Returns `a` when
`a == b`.

```ipe
min 3 5 --> 3
min 5 3 --> 3
min "apple" "banana" --> "apple"
```
-}
min : a -> a -> a
min = Kernel.kernel "Basics_min"


{-| `max a b` — the larger of two comparable values.

Works on any `Comparable` scalar: `Int`, `Float`, `String`, `Char`, or
`Bool`. A list, tuple, or record is not comparable. Returns `a` when
`a == b`.

```ipe
max 3 5 --> 5
max 5 3 --> 5
max "apple" "banana" --> "banana"
```
-}
max : a -> a -> a
max = Kernel.kernel "Basics_max"


{-| `compare a b` — the `Order` relation between two comparable values.

Works on any comparable scalar: `Int`, `Float`, `String`, `Char`, or `Bool`.
A list, tuple, or record is not comparable.

Returns `LT` when `a < b`, `EQ` when `a == b`, and `GT` when `a > b`.
`Order` is a built-in type with three constructors: `LT`, `EQ`, `GT`.
Use it with `List.sortWith` to build custom orderings.

```ipe
compare 1 2 --> LT
compare 2 2 --> EQ
compare 3 2 --> GT
compare "abc" "abd" --> LT
```
-}
compare : a -> a -> Order
compare = Kernel.kernel "Basics_compare"
