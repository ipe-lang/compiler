-- | Ipe.Test — lightweight in-process test framework.
--
-- Build a `Test` with `test name thunk`, group tests with `suite`, and
-- decide each one with an assertion (`equal`, `ok`, `expectErr`, `isTrue`, …)
-- that yields a `TestResult`. `run` evaluates a list of tests into
-- `( name, result )` pairs; `summarise` prints the report and yields whether
-- every test passed; `runMain` does both and exits non-zero on a failure, so
-- it can be a test program's `main`.


module Ipe.Test exposing
    ( Test, TestResult(..)
    , test, suite
    , pass, fail
    , equal, notEqual
    , ok, err, expectErr
    , isTrue, isFalse
    , kindName
    , run, runWithPrefix, summarise, runMain
    )


import Ipe.Error as Error exposing (Error, ErrorKind)
import Ipe.Ffi.Kernel as Kernel
import Ipe.List as List
import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task


-- ─── Types ───────────────────────────────────────────────────────────────────
type Test
    = Leaf String (() -> TestResult)
    | Suite String (List Test)


type TestResult
    = Passed
    | Failed String


-- ─── Builders ────────────────────────────────────────────────────────────────
test : String -> (() -> TestResult) -> Test
test name thunk =
    Leaf name thunk


suite : String -> List Test -> Test
suite name items =
    Suite name items


-- ─── Assertions ──────────────────────────────────────────────────────────────
pass : TestResult
pass =
    Passed


fail : String -> TestResult
fail msg =
    Failed msg


equal : a -> a -> TestResult
equal expected actual =
    if expected == actual then
        Passed

    else
        Failed
            ("expected "
                ++ errorToString expected
                ++ " but got "
                ++ errorToString actual
            )


notEqual : a -> a -> TestResult
notEqual expected actual =
    if expected /= actual then
        Passed

    else
        Failed ("expected inequality but both were " ++ errorToString actual)


ok : Result e a -> TestResult
ok result =
    case result of
        Ok _ ->
            Passed

        Err e ->
            Failed ("expected Ok but got Err " ++ errorToString e)


err : Result e a -> TestResult
err result =
    case result of
        Err _ ->
            Passed

        Ok v ->
            Failed ("expected Err but got Ok " ++ errorToString v)


-- | Render an `ErrorKind` as its stable variant name (`"Io"`, `"Network"`, …).
kindName : ErrorKind -> String
kindName =
    Error.kindName


-- | Pass when `result` is an `Err` classified as `expected`. Reports the actual
-- kind (or the unexpected `Ok`) on failure.
expectErr : ErrorKind -> Result Error a -> TestResult
expectErr expected result =
    case result of
        Err e ->
            let
                actual =
                    Error.kind e
            in
            if actual == expected then
                Passed

            else
                Failed
                    ("expected Err "
                        ++ kindName expected
                        ++ " but got Err "
                        ++ kindName actual
                    )

        Ok v ->
            Failed
                ("expected Err "
                    ++ kindName expected
                    ++ " but got Ok "
                    ++ errorToString v
                )


isTrue : Bool -> TestResult
isTrue b =
    case b of
        True ->
            Passed

        False ->
            Failed "expected True but got False"


isFalse : Bool -> TestResult
isFalse b =
    case b of
        False ->
            Passed

        True ->
            Failed "expected False but got True"


-- ─── Runner ──────────────────────────────────────────────────────────────────
run : List Test -> List ( String, TestResult )
run tests =
    runWithPrefix "" tests


runWithPrefix : String -> List Test -> List ( String, TestResult )
runWithPrefix prefix tests =
    List.concat
        (List.map
            (\t ->
                case t of
                    Leaf name thunk ->
                        [ ( prefix ++ name, thunk () ) ]

                    Suite name inner ->
                        let
                            nextPrefix =
                                if prefix == "" then
                                    name ++ " > "

                                else
                                    prefix ++ name ++ " > "
                        in
                        runWithPrefix nextPrefix inner
            )
            tests
        )


println : String -> Task Error ()
println =
    Kernel.kernel "Io_println"


summarise : List ( String, TestResult ) -> Task Error Bool
summarise results =
    do
        total = List.length results
        failures =
            List.concatMap
                (\pair ->
                    case pair of
                        ( _, Passed ) ->
                            []

                        ( name, Failed reason ) ->
                            [ ( name, reason ) ]
                )
                results
        failCount = List.length failures
        passCount = total - failCount
        failureReport =
            String.join ""
                (List.map
                    (\( name, reason ) ->
                        "  FAIL  " ++ name ++ "\n          " ++ reason ++ "\n"
                    )
                    failures
                )
        summaryLine =
            String.fromInt passCount
                ++ " passed, "
                ++ String.fromInt failCount
                ++ " failed ("
                ++ String.fromInt total
                ++ " total)"
        println (failureReport ++ summaryLine)
        Task.succeed (failCount == 0)


runMain : List Test -> Task Error ()
runMain tests =
    Task.andThen
        (\allPassed ->
            if allPassed then
                System.exit 0

            else
                System.exit 1
        )
        (summarise (run tests))
