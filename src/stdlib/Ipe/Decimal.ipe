-- | Ipe.Decimal — arbitrary-precision decimal arithmetic.
--
-- `Decimal` is an opaque arbitrary-precision decimal value backed by
-- `ipe_runtime::decimal::Decimal` (wrapping `rust_decimal::Decimal`).
-- Every member is aliased to its runtime kernel via the `Kernel.kernel` mechanism.
module Ipe.Decimal exposing
    ( Decimal
    , zero, one, oneHundred
    , fromString, fromInt, fromFloat, fromMinor
    , toString, toStringFixed, toFloat, toInt, toMinor
    , add, sub, mul, div, mod
    , neg, abs, floor, ceil
    , round, roundHalfUp, truncate
    , compare, eq, neq, lt, lte, gt, gte
    , min, max
    , isZero, isPositive, isNegative
    , percentOf, addPercent, subPercent
    , formatWith
    )


import Ipe.Ffi.Kernel as Kernel


-- | The additive identity.
zero : Decimal
zero = Kernel.kernel "Decimal_zero"


-- | The multiplicative identity.
one : Decimal
one = Kernel.kernel "Decimal_one"


-- | The value 100.
oneHundred : Decimal
oneHundred = Kernel.kernel "Decimal_oneHundred"


-- | Parse a decimal from its string representation.
--
--     Decimal.fromString "3.14" |> Result.map Decimal.toString --> Ok "3.14"
--     Decimal.fromString "nope" |> Result.map Decimal.toString |> Result.withDefault "parse error" --> "parse error"
fromString : String -> Result Error Decimal
fromString = Kernel.kernel "Decimal_fromString"


{-| Convert an `Int` to a `Decimal` exactly, with no precision loss — unlike
the prelude's `toFloat`, which rounds past `2^53`.

```ipe
Decimal.toString (Decimal.fromInt 7) --> "7"
```
-}
fromInt : Int -> Decimal
fromInt = Kernel.kernel "Decimal_fromInt"


-- | Convert a `Float` to a `Decimal`.  Subject to the same precision limits as
-- IEEE 754 double; prefer `fromString` when exactness matters.
fromFloat : Float -> Decimal
fromFloat = Kernel.kernel "Decimal_fromFloat"


-- | Construct a `Decimal` from a minor-unit integer and a scale.
--
--     Decimal.toString (Decimal.fromMinor 2 314) --> "3.14"
fromMinor : Int -> Int -> Decimal
fromMinor = Kernel.kernel "Decimal_fromMinor"


-- | Render the decimal as a plain decimal string (no thousands separators).
toString : Decimal -> String
toString = Kernel.kernel "Decimal_toString"


-- | Render with a fixed number of decimal places.
--
--     Decimal.toStringFixed 2 (Decimal.fromString "3.1" |> Result.withDefault Decimal.zero) --> "3.10"
toStringFixed : Int -> Decimal -> String
toStringFixed = Kernel.kernel "Decimal_toStringFixed"


{-| Convert to the nearest `Float`. May lose precision past `2^53`, the same
boundary as the prelude's `toFloat : Int -> Float`. Going from an `Int`
straight to a `Float` needs only that `toFloat`; reach for `Decimal` first
when the arithmetic in between must stay exact.

```ipe
Decimal.toFloat (Decimal.fromInt 7) --> 7.0
```
-}
toFloat : Decimal -> Float
toFloat = Kernel.kernel "Decimal_toFloat"


-- | Truncate to an `Int` (towards zero).
toInt : Decimal -> Int
toInt = Kernel.kernel "Decimal_toInt"


-- | Return the minor-unit integer at the given scale.
--
--     Decimal.toMinor 2 (Decimal.fromString "3.14" |> Result.withDefault Decimal.zero) --> 314
toMinor : Int -> Decimal -> Int
toMinor = Kernel.kernel "Decimal_toMinor"


-- | Add two decimals.
add : Decimal -> Decimal -> Decimal
add = Kernel.kernel "Decimal_add"


-- | Subtract the second decimal from the first.
sub : Decimal -> Decimal -> Decimal
sub = Kernel.kernel "Decimal_sub"


-- | Multiply two decimals.
mul : Decimal -> Decimal -> Decimal
mul = Kernel.kernel "Decimal_mul"


-- | Divide the first decimal by the second.  Returns `Err` on division by zero.
div : Decimal -> Decimal -> Result Error Decimal
div = Kernel.kernel "Decimal_div"


-- | Remainder of dividing the first decimal by the second.  Returns `Err` on
-- division by zero.
mod : Decimal -> Decimal -> Result Error Decimal
mod = Kernel.kernel "Decimal_mod"


-- | Negate a decimal.
neg : Decimal -> Decimal
neg = Kernel.kernel "Decimal_neg"


-- | Absolute value.
abs : Decimal -> Decimal
abs = Kernel.kernel "Decimal_abs"


-- | Round down to the nearest integer-valued decimal (towards negative infinity).
floor : Decimal -> Decimal
floor = Kernel.kernel "Decimal_floor"


-- | Round up to the nearest integer-valued decimal (towards positive infinity).
ceil : Decimal -> Decimal
ceil = Kernel.kernel "Decimal_ceil"


-- | Round to `n` decimal places using banker's rounding (round-half-to-even).
round : Int -> Decimal -> Decimal
round = Kernel.kernel "Decimal_round"


-- | Round to `n` decimal places always rounding 0.5 away from zero.
roundHalfUp : Int -> Decimal -> Decimal
roundHalfUp = Kernel.kernel "Decimal_roundHalfUp"


-- | Truncate to `n` decimal places (towards zero, no rounding).
truncate : Int -> Decimal -> Decimal
truncate = Kernel.kernel "Decimal_truncate"


-- | Total ordering: `compare a b` returns a negative `Int` if `a < b`, zero if
-- `a == b`, or a positive `Int` if `a > b`.
compare : Decimal -> Decimal -> Int
compare = Kernel.kernel "Decimal_compare"


-- | Decimal equality.
eq : Decimal -> Decimal -> Bool
eq = Kernel.kernel "Decimal_eq"


-- | Decimal inequality.
neq : Decimal -> Decimal -> Bool
neq = Kernel.kernel "Decimal_neq"


-- | Strict less-than.
lt : Decimal -> Decimal -> Bool
lt = Kernel.kernel "Decimal_lt"


-- | Less-than-or-equal.
lte : Decimal -> Decimal -> Bool
lte = Kernel.kernel "Decimal_lte"


-- | Strict greater-than.
gt : Decimal -> Decimal -> Bool
gt = Kernel.kernel "Decimal_gt"


-- | Greater-than-or-equal.
gte : Decimal -> Decimal -> Bool
gte = Kernel.kernel "Decimal_gte"


-- | The smaller of two decimals.
min : Decimal -> Decimal -> Decimal
min = Kernel.kernel "Decimal_min"


-- | The larger of two decimals.
max : Decimal -> Decimal -> Decimal
max = Kernel.kernel "Decimal_max"


-- | True when the decimal equals zero.
isZero : Decimal -> Bool
isZero = Kernel.kernel "Decimal_isZero"


-- | True when the decimal is strictly greater than zero.
isPositive : Decimal -> Bool
isPositive = Kernel.kernel "Decimal_isPositive"


-- | True when the decimal is strictly less than zero.
isNegative : Decimal -> Bool
isNegative = Kernel.kernel "Decimal_isNegative"


-- | `percentOf pct base` — the value of `pct`% of `base`.
--
--     Decimal.toString (Decimal.percentOf (Decimal.fromInt 10) (Decimal.fromInt 200)) --> "20"
percentOf : Decimal -> Decimal -> Decimal
percentOf = Kernel.kernel "Decimal_percentOf"


-- | `addPercent pct base` — `base` increased by `pct`%.
addPercent : Decimal -> Decimal -> Decimal
addPercent = Kernel.kernel "Decimal_addPercent"


-- | `subPercent pct base` — `base` decreased by `pct`%.
subPercent : Decimal -> Decimal -> Decimal
subPercent = Kernel.kernel "Decimal_subPercent"


-- | `formatWith thousandsSep decimalSep places value` — locale-style formatting.
--
--     Decimal.formatWith "," "." 2 (Decimal.fromInt 1234567) --> "1,234,567.00"
formatWith : String -> String -> Int -> Decimal -> String
formatWith = Kernel.kernel "Decimal_formatWith"
