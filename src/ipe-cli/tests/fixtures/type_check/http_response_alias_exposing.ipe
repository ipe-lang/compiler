module Main exposing (main)

import Ipe.Dict as Dict
import Ipe.Http exposing (HttpResponse)
import Ipe.Io as Io
import Ipe.String


status : HttpResponse -> Int
status response =
    response.status


main : Task ()
main =
    Io.println
        (String.fromInt
            (status
                { status = 200
                , body = "ok"
                , headers = Dict.fromList [ ( "X-Test", "1" ) ]
                }
            )
        )
