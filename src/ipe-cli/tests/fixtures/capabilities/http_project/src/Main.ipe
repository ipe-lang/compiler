module Main exposing (main)

import Ipe.Http as Http
import Ipe.Io as Io
import Ipe.Task as Task
import Ipe.Url as Url


main : Task ()
main =
    case Url.fromString "http://example.com" of
        Ok url ->
            Http.get url
                |> Task.andThen (\_ -> Io.println "done")

        Err e ->
            Task.fail e
