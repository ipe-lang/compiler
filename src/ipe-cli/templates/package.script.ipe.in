module Package exposing (package)

import Ipe.Package exposing (..)


package : Package
package =
    { name = "{name}"
    , version = "0.1.0"
    , delivery =
        { desktop = { title = "{name}", width = 1024, height = 768 }
        , mobile = { bundleId = "{bundle_id}", orientation = Any }
        , browser = { basePath = "/" }
        }
    }
