module Main exposing (main)

import Ipe.String as String
import Ipe.System as System
import Ipe.Tea.Tui exposing (tea)
import Ipe.Tea.Tui.Cmd as Cmd
import Ipe.Tea.Tui.Sub as Sub
import Ipe.Ui.Tui as Ui
import Ipe.Ui.Tui exposing (Screen)


type Msg
    = Increment
    | Decrement
    | Quit
    | NoOp


type alias Model =
    { count : Int
    }


init : () -> ( Model, Cmd Msg )
init _unit =
    ( { count = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )

        Decrement ->
            ( { model | count = model.count - 1 }, Cmd.none )

        Quit ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        NoOp ->
            ( model, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.onKey onKey


view : Model -> Screen Msg
view model =
    Ui.column
        [ Ui.spacing 1, Ui.padding 2 ]
        [ Ui.el [ Ui.bold ] (Ui.text "Ipê counter")
        , Ui.el [ Ui.reverse ] (Ui.text ("count = " ++ String.fromInt model.count))
        , Ui.el [ Ui.dim ] (Ui.text "(Up +, Down -, q quit)")
        ]


type alias KeyEvent =
    { kind : String
    , value : String
    }


onKey : KeyEvent -> Msg
onKey key =
    if key.kind == "up" then
        Increment

    else if key.kind == "down" then
        Decrement

    else if key.kind == "char" && key.value == "q" then
        Quit

    else
        NoOp


main =
    tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
