module Main exposing (main)

-- SEAL smoke for `Store.upper` and `Store.lower` in a typed projection body.
-- Two `Codec.auto`-derived stores join on `books.author_id = authors.id`; one
-- `select` projects `Store.upper author.name` and one projects a tuple of
-- `Store.lower book.title` with `author.name`.
--
-- Both lowers must produce SQL like:
--   SELECT UPPER(a1.name) AS p0 FROM …
--   SELECT LOWER(a0.title) AS p0, a1.name AS p1 FROM …
--
-- The column identifiers are validated at compile time and re-checked by the
-- runtime. No live database is needed: `Task.onError` catches any connection
-- failure and the program exits cleanly. The SEAL proof is a `cargo build` of
-- the emitted project under `IPE_E2E=1`.
--
-- Expected output:
--   projection-upper-lower-seal:ok


import Ipe.Codec as Codec exposing (Codec)
import Ipe.Db as Db exposing (Db)
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error exposing (Error)
import Ipe.Io as Io
import Ipe.List as List
import Ipe.Result as Result exposing (Result(..))
import Ipe.Task as Task exposing (Task)


type alias Book =
    { id : String
    , title : String
    , authorId : String
    }


type alias Author =
    { id : String
    , name : String
    , active : Bool
    }


blankBook : Book
blankBook =
    { id = "", title = "", authorId = "" }


blankAuthor : Author
blankAuthor =
    { id = "", name = "", active = False }


bookCodec : Codec Book
bookCodec =
    Codec.auto blankBook


authorCodec : Codec Author
authorCodec =
    Codec.auto blankAuthor


booksStore : Result Error (Store Book)
booksStore =
    Store.fromCodec "books" bookCodec
        |> Result.map (\s -> Store.primaryKey .id s)
        |> Result.map Store.public


authorsStore : Result Error (Store Author)
authorsStore =
    Store.fromCodec "authors" authorCodec
        |> Result.map (\s -> Store.primaryKey .id s)
        |> Result.map Store.public


-- Projects UPPER(a1.name) — one column, upper-cased.
upperNames : Db -> Store Book -> Store Author -> Task Error (List String)
upperNames db books authors =
    Store.selectToList db
        (Store.select
            (\( _, author ) -> Store.upper author.name)
            (Store.join books .authorId authors .id)
        )


-- Projects ( LOWER(a0.title), a1.name ) — two columns, first lower-cased.
lowerTitlesWithNames : Db -> Store Book -> Store Author -> Task Error (List ( String, String ))
lowerTitlesWithNames db books authors =
    Store.selectToList db
        (Store.select
            (\( book, author ) -> ( Store.lower book.title, author.name ))
            (Store.join books .authorId authors .id)
        )


run : Db -> Task Error ()
run db =
    case booksStore of
        Ok books ->
            case authorsStore of
                Ok authors ->
                    Task.andThen
                        (\_ -> Task.map (\_ -> ()) (lowerTitlesWithNames db books authors))
                        (Task.map (\_ -> ()) (upperNames db books authors))

                Err e ->
                    Task.fail e

        Err e ->
            Task.fail e


main : Task Error ()
main =
    Task.andThen
        (\_ -> Io.println "projection-upper-lower-seal:ok")
        (Task.onError
            (\_ -> Task.succeed ())
            (Task.andThen
                (\db -> run db)
                (Db.connect ())
            )
        )
