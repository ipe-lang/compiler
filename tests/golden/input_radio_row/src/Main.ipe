module Main exposing (main)

import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Ui.Input as Input
import Ipe.Io as Io


-- i155 regression: Input.radio, Input.radioRow, and Input.option must
-- type-check and lower without IPE-N0005.

type Msg
    = ColorSelected String


options : List (Input.RadioOption Msg)
options =
    [ Input.option "red" (Ui.text "Red")
    , Input.option "green" (Ui.text "Green")
    , Input.option "blue" (Ui.text "Blue")
    ]


viewRadio : String -> String
viewRadio selected =
    Html.htmlRender
        (Ui.layout []
            (Input.radio []
                { onChange = ColorSelected
                , options = options
                , selected = selected
                , label = Input.labelAbove [] (Ui.text "Pick a color")
                }))


viewRadioRow : String -> String
viewRadioRow selected =
    Html.htmlRender
        (Ui.layout []
            (Input.radioRow []
                { onChange = ColorSelected
                , options = options
                , selected = selected
                , label = Input.labelAbove [] (Ui.text "Pick a color (row)")
                }))


main =
    Io.println (viewRadio "red" ++ viewRadioRow "blue")
