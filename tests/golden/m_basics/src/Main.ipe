module Main exposing (main)

import Ipe.Io as Io
import Ipe.String


main =
    let
        a =
            not False

        b =
            identity 7

        c =
            always 3 "ignored"

        d =
            fst ( 10, 20 )

        e =
            snd ( 10, 20 )

        f =
            modBy 3 10
    in
    Io.println
        ((if a then "T" else "F")
            ++ " "
            ++ String.fromInt (b + c + d + e + f)
        )
