module Main exposing (main)

-- Cross-shape Cmd/Sub gate (IPE-N0035): this is a Terminal app (its `main` calls
-- `Cli.tea`), but it imports the Web shape's `Cmd`. `Cmd` is
-- shape-specific and reached through the app's own shape, so the wrong-shape
-- import fails closed here, before any Rust is generated.

import Ipe.Tea.Cli as Cli
import Ipe.Ui.Cli as Ui
import Ipe.Ui.Cli exposing (Lines)
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Cli.Sub as Sub

type Msg
    = GotLine String

type alias Model =
    { n : Int }

init : () -> ( Model, Cmd Msg )
init _unit =
    ( { n = 0 }, Cmd.none )

update : Msg -> Model -> ( Model, Cmd Msg )
update _msg model =
    ( model, Cmd.none )

view : Model -> Lines Msg
view _model =
    Ui.text ("ok")

subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.onLine onLine

onLine : String -> Msg
onLine line =
    GotLine line

main =
    Cli.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
