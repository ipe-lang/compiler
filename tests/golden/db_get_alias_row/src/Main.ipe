module Main exposing (main)

import Ipe.Task as Task
import Ipe.Dict as Dict
import Ipe.Db as Db
import Ipe.Db.Unsafe
import Ipe.Io as Io


-- BACKLOG #177 FIX-UP 2 regression — INDIRECTED row arg (single-hop alias).
--
-- The structural `body_calls_db_get_on_param` walk originally matched only a
-- DIRECT `Var`/`CloneVar` of the wildcard param in row-argument position. So a
-- decoder that let-binds a pure alias of the payload and reads fields off THAT
-- alias dropped the `+ IpeRow` bound: `ipec build` exit 0, then `cargo build`
-- E0277 (`T1: IpeRow is not satisfied`). The base commit's old TEXT scan
-- happened to bound it (the alias still renders as `db_get_string(_, &r)`), so
-- the structural rewrite REGRESSED this case.
--
-- The fix makes the walk alias-transparent: `let r = payload` tracks `r` as an
-- additional alias of the wildcard row for the rest of the `let` body, so a
-- `Unsafe.unsafeGetString _ r` obliges the bound exactly as `Unsafe.unsafeGetString _ payload`
-- would.


type alias Row =
    { author : String
    , text : String
    }


-- Row arg is `r`, a value-preserving `let` alias of the wildcard `payload`.
decodeRow : any -> Row
decodeRow payload =
    let
        r =
            payload
    in
    { author = Unsafe.unsafeGetString "author" r
    , text = Unsafe.unsafeGetString "text" r
    }


main : Task Error ()
main =
    let
        payload =
            Dict.fromList
                [ ( "author", "ada" )
                , ( "text", "hello" )
                ]

        row =
            decodeRow payload
    in
    Io.println (row.author ++ "," ++ row.text)
