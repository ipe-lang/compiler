module Main exposing (main)

import Ipe.Io as Io
import Ipe.List
import Ipe.String

-- #158 Class-4 item C, Repro 1: a `Just`-wrapped list, discriminated by an
-- inner `case` over the list payload. The outer `case` handles each `Maybe`
-- constructor explicitly (no closed-union catch-all), and the inner `case xs`
-- over `List` splits `h :: t` from `[]`.
f : Maybe (List Int) -> Int
f m =
    case m of
        Just xs ->
            case xs of
                h :: t ->
                    h

                [] ->
                    0

        Nothing ->
            0


main =
    Io.println (String.fromInt (f (Just [ 1, 2, 3 ])))
