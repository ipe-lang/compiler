module Main exposing (main)

import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Ui.Lazy as Lazy
import Ipe.Io as Io


-- i146 regression: LazyLazy..LazyLazy5 emit arms.
-- Lazy.lazy and Lazy.lazy2 must lower to ipe_runtime::ui::lazy helpers
-- without IPE-I0001 "no emit arm".
-- oracle_divergence = true: Go oracle does not expose Html.htmlRender.


type Msg
    = NoOp


viewItem : String -> Ui.Element Msg
viewItem label =
    Ui.text label


viewPair : String -> String -> Ui.Element Msg
viewPair a b =
    Ui.column [] [ Ui.text a, Ui.text b ]


staticHtml : String
staticHtml =
    Html.htmlRender
        (Ui.layout []
            (Ui.column []
                [ Lazy.lazy viewItem "hello"
                , Lazy.lazy2 viewPair "first" "second"
                ]))


main =
    Io.println staticHtml
