module Main exposing (main)

import Ipe.Error as Error
import Ipe.Io as Io
import Ipe.Task

-- #86: the `Error` module qualifier. `Error.unexpected` builds a message-
-- carrying Error (String-backed in this minimal slice); `Task.fail` raises it on
-- the Task error channel; `Task.onError` recovers with a handler whose parameter
-- `e : Error`; `Error.toString e` renders the error back to its message.
--
-- With `IpeError = String` the message round-trips verbatim (`boom`). Upstream's
-- kind-prefixed rendering (`Unexpected: boom`) awaits the rich `ErrorKind` ADT
-- (#85) — hence this golden is marked `oracle_divergence`.
main =
    Task.onError (\e -> Io.println (Error.toString e)) (Task.fail (Error.unexpected "boom"))
