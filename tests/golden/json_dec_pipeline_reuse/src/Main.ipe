module Main exposing (main)
import Ipe.Io as Io
import Ipe.Json.Decode
import Ipe.Json.Decode.Pipeline
import Ipe.String

-- A let-bound `|>` pipeline decoder used twice (Decoder reuse → thunk): each
-- `decodeString` call gets a fresh Decoder value rather than moving out of the
-- binding.
-- Expected:
--   Alice|30
--   Bob|25

main =
    let
        d =
            JsonDec.succeed (\name age -> name ++ "|" ++ String.fromInt age)
                |> JsonDecP.required "name" JsonDec.string
                |> JsonDecP.required "age" JsonDec.int

        r1 =
            JsonDec.decodeString d "{\"name\":\"Alice\",\"age\":30}"

        r2 =
            JsonDec.decodeString d "{\"name\":\"Bob\",\"age\":25}"
    in
    case r1 of
        Ok label1 ->
            case r2 of
                Ok label2 -> Io.println (label1 ++ "\n" ++ label2)
                Err _ -> Io.println "err2"
        Err _ -> Io.println "err1"
