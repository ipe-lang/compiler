module Main exposing (main)

import Ipe.Http as Http
import Ipe.Io as Io
import Ipe.String
import Ipe.Url as Url


-- `Http.withRedirects` with both `NoRedirects` and `FollowRedirects Int`,
-- plus a `withUrl` retarget. The chain overrides defaultRequest values:
--   url "http://example.com" -> "http://example.org"
--   redirects (FollowRedirects 10) -> NoRedirects   (first line block)
--   redirects (FollowRedirects 10) -> FollowRedirects 3 (second line block)
--
-- Expected output:
--   http://example.org
--   noredirect
--   http://example.org
--   follow 3


printReq : { body : String, headers : List ( String, String ), method : Http.HttpMethod, redirects : Http.RedirectPolicy, timeout : Int, url : String } -> String
printReq req =
    String.join "\n"
        [ req.url
        , case req.redirects of
            NoRedirects ->
                "noredirect"

            FollowRedirects n ->
                "follow " ++ String.fromInt n
        ]


main =
    case Http.defaultRequestFromString "http://example.com" of
        Ok req0 ->
            case Url.fromString "http://example.org" of
                Ok target ->
                    case Http.withUrl target req0 of
                        Ok retargeted ->
                            Io.println
                                (String.join "\n"
                                    [ printReq
                                        (Http.withRedirects NoRedirects retargeted)
                                    , printReq
                                        (Http.withRedirects
                                            (FollowRedirects 3)
                                            retargeted)
                                    ]
                                )

                        Err _ ->
                            Io.println "blocked"

                Err _ ->
                    Io.println "unparseable"

        Err _ ->
            Io.println "blocked"
