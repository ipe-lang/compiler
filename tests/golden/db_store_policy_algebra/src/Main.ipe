module Main exposing (main)

-- SEAL smoke for the row-security `Pred` / `Policy` algebra + `secured`
-- constructor + simplifier + `explain`. Every line is a pure check (no DB), so
-- the emitted project builds and runs deterministically under `IPE_E2E=1`.
--
-- Happy path + fail-closed re-validation + the algebra's documented identities:
--
--   * `goodStore` is a `Codec.auto`-derived store over `Doc`, so its columns are
--     `author` / `created_at` / `body`. The re-expressed conjoined policy
--     `ownerColumn .author |> andPolicy (immutable .createdAt)` names only real
--     columns, so `secured` returns `Ok` → `good:ok`.
--   * `thinStore` is built from a hand-assembled codec whose shape names only
--     `body`, so `author` is NOT one of its columns. `secured (ownerColumn
--     .author)` re-validates the policy column and returns a typed `Err` →
--     `thin:err` (deny-by-default: a policy over a non-existent column is never a
--     silent no-op).
--   * `secured` re-validates a column named DEEP in the algebra, not only at the
--     top level: an `anyOf [ matchWhere (eq .author …), matchWhere (eq .body …) ]`
--     over `thinStore` (which lacks `author`) still fails closed → `deep:err`.
--   * Simplifier identities, observed through `explain`:
--       `anyOf []` ⇒ `never`             → `emptyany:no row (denied)`
--       `allOf []` ⇒ `always`            → `emptyall:every row`
--       `anyOf [ p, always ]` ⇒ `always` → `anyalways:every row`
--       `allOf [ p, never ]` ⇒ `never`   → `allnever:no row (denied)`
--   * `readOnly always` leaves every write `never` (fail-closed): its update
--     predicate explains as `no row (denied)` → `readonly:no row (denied)`.
--   * The principal-side leaves `role` / `memberOf` / `claimEquals` gate on the
--     caller (not on a row column), so they `explain` as caller-claim text
--     (`role:…` / `memberof:…` / `claimeq:…`) and `notPred` over one negates it
--     (`notrole:…`). Naming no row column, one classifies `Ok` even over the thin
--     store that lacks `author` → `principalleaf:ok` (they smuggle no phantom
--     column into `secured`'s column-validation surface).
--
-- Expected output:
--   good:ok
--   thin:err
--   deep:err
--   emptyany:no row (denied)
--   emptyall:every row
--   anyalways:every row
--   allnever:no row (denied)
--   readonly:no row (denied)
--   existsinok:ok
--   existsinexplain:exists in shares where shares.doc_ref = author and its read policy: (member = caller subject)
--   existsinouter:err
--   existsinshare:err
--   maskok:ok
--   maskexplain:ssn when (a column condition)
--   masknonnull:err
--   maskmissing:err
--   role:caller holds role admin
--   memberof:caller is member of group platform
--   claimeq:caller claim tenant = acme
--   notrole:not (caller holds role admin)
--   principalleaf:ok
--
-- Column-masking (`mask` / `secured` CNull SEAL), all pure `secured`-outcome +
-- `explain` checks:
--
--   * `maskCodec`'s shape names `owner` (`CText`) and `ssn` (`CNull CText`).
--     Masking the nullable `ssn` on a store that has it → `Ok` → `maskok:ok`.
--   * `explain` renders the mask rule as transparent text →
--     `maskexplain:ssn when (a column condition)`.
--   * Masking the NON-nullable `owner` column fails closed at `secured` (a masked
--     column must be nullable to carry NULL for an unauthorized row) →
--     `masknonnull:err` (the soundness SEAL).
--   * Masking `ssn` on a thin store whose shape lacks it → `maskmissing:err`
--     (a masked column absent from the store is re-validated and refused).


import Ipe.Codec as Codec exposing (Codec(..), Shape(..), ColType(..))
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error as Error exposing (Error)
import Ipe.Io as Io
import Ipe.Json.Decode as Decode
import Ipe.Json.Encode as Encode
import Ipe.List as List
import Ipe.String as String
import Ipe.Result as Result exposing (Result(..))
import Ipe.Task as Task


type alias Doc =
    { author : String
    , createdAt : String
    , body : String
    }


blankDoc : Doc
blankDoc =
    { author = "", createdAt = "", body = "" }


-- A `Codec.auto`-derived codec: its columns are `author` / `created_at` / `body`.
docCodec : Codec Doc
docCodec =
    Codec.auto blankDoc


-- A hand-assembled codec whose shape names ONLY `body`, so a store built from it
-- has no `author` column even though the record type has an `author` field.
thinCodec : Codec Doc
thinCodec =
    Codec
        { enc = \d -> Encode.object [ ( "body", Encode.string d.body ) ]
        , mkDec =
            \_ ->
                Decode.map (\b -> { author = "", createdAt = "", body = b })
                    (Decode.field "body" Decode.string)
        , shp = SRecord [ ( "body", CText ) ]
        }


-- The re-expressed conjoined policy: owner-scoped on `.author`, `.createdAt`
-- immutable.
docPolicy : Store.Policy Doc
docPolicy =
    Store.ownerColumn .author
        |> Store.andPolicy (Store.immutable .createdAt)


-- A predicate naming `author` buried inside a disjunction, to prove `secured`
-- re-validates columns across the whole algebra rather than only at the top.
deepPolicy : Store.Policy Doc
deepPolicy =
    Store.readOnly
        (Store.anyOf
            [ Store.matchWhere (Store.eq .author "a")
            , Store.matchWhere (Store.eq .body "b")
            ]
        )


-- ── `existsIn` correlated-subquery fixtures ────────────────────────────────
--
-- A `Share` row records which member may see which document. Its `Codec.auto`
-- columns are `doc_ref` / `member`. The secured share store is owner-scoped on
-- `.member` (its OWN read policy), which composes into every `existsIn` subquery.
type alias Share =
    { docRef : String
    , member : String
    }


blankShare : Share
blankShare =
    { docRef = "", member = "" }


shareCodec : Codec Share
shareCodec =
    Codec.auto blankShare


-- A share codec whose shape names ONLY `member`, so a share store built from it
-- has no `doc_ref` column — used to prove the SHARE side of a correlation is
-- re-validated against the SHARE store, not the outer store.
thinShareCodec : Codec Share
thinShareCodec =
    Codec
        { enc = \s -> Encode.object [ ( "member", Encode.string s.member ) ]
        , mkDec =
            \_ ->
                Decode.map (\m -> { docRef = "", member = m })
                    (Decode.field "member" Decode.string)
        , shp = SRecord [ ( "member", CText ) ]
        }


-- ── Column-masking fixtures ────────────────────────────────────────────────
--
-- A `MaskDoc` records an owner and an optional-in-the-DB `ssn`. Its codec shape
-- names `owner` (non-nullable `CText`) and `ssn` (nullable `CNull CText`) — the
-- SSN column is masked, so it MUST be nullable (an unauthorized row projects
-- NULL). A hand-assembled codec pins the shape so the SEAL's nullability check is
-- exercised precisely.
type alias MaskDoc =
    { owner : String
    , ssn : String
    }


maskCodec : Codec MaskDoc
maskCodec =
    Codec
        { enc =
            \d ->
                Encode.object
                    [ ( "owner", Encode.string d.owner )
                    , ( "ssn", Encode.string d.ssn )
                    ]
        , mkDec =
            \_ ->
                Decode.map2 (\o s -> { owner = o, ssn = s })
                    (Decode.field "owner" Decode.string)
                    (Decode.field "ssn" Decode.string)
        , shp = SRecord [ ( "owner", CText ), ( "ssn", CNull CText ) ]
        }


-- A mask policy: owner-scoped on `.owner`, masking the nullable `.ssn` column so
-- it is visible only when the caller's `role` is admin (the predicate names a
-- real column of the store).
maskPolicy : Store.Policy MaskDoc
maskPolicy =
    Store.ownerColumn .owner
        |> Store.andPolicy
            (Store.readOnly Store.always
                |> Store.mask .ssn (Store.matchWhere (Store.eq .owner "admin"))
            )


-- Build the secured share store from `codec`, or `Nothing` on any build/classify
-- failure (the caller lines turn that into a fail marker).
securedShareFrom : Codec Share -> Maybe (Store.Secured Share)
securedShareFrom codec =
    case Store.fromCodec "shares" codec of
        Err _ ->
            Nothing

        Ok store ->
            case Store.secured (Store.ownerColumn .member) store of
                Ok secured ->
                    Just secured

                Err _ ->
                    Nothing


main : Task Error ()
main =
    Io.println
        (String.join "\n"
            [ goodLine
            , thinLine
            , deepLine
            , identityLine "emptyany" (Store.anyOf [])
            , identityLine "emptyall" (Store.allOf [])
            , identityLine "anyalways" (Store.anyOf [ Store.matchWhere (Store.eq .body "b"), Store.always ])
            , identityLine "allnever" (Store.allOf [ Store.matchWhere (Store.eq .body "b"), Store.never ])
            , readOnlyLine
            , existsInOkLine
            , existsInExplainLine
            , existsInOuterErrLine
            , existsInShareErrLine
            , maskOkLine
            , maskExplainLine
            , maskNonNullLine
            , maskMissingLine
            , identityLine "role" (Store.role "admin")
            , identityLine "memberof" (Store.memberOf "platform")
            , identityLine "claimeq" (Store.claimEquals "tenant" "acme")
            , identityLine "notrole" (Store.notPred (Store.role "admin"))
            , principalLeafSecuredLine
            ]
        )


-- `secured` over a store whose columns include every policy column → `Ok`.
goodLine : String
goodLine =
    case Store.fromCodec "docs" docCodec of
        Err _ ->
            "good:build-err"

        Ok store ->
            case Store.secured docPolicy store of
                Ok _ ->
                    "good:ok"

                Err _ ->
                    "good:err"


-- `secured (ownerColumn .author)` over a store whose columns lack `author` →
-- fail-closed typed `Err`.
thinLine : String
thinLine =
    case Store.fromCodec "docs2" thinCodec of
        Err _ ->
            "thin:build-err"

        Ok store ->
            case Store.secured (Store.ownerColumn .author) store of
                Ok _ ->
                    "thin:ok"

                Err _ ->
                    "thin:err"


-- `secured` must reject a column named deep in the algebra, not only top-level.
deepLine : String
deepLine =
    case Store.fromCodec "docs3" thinCodec of
        Err _ ->
            "deep:build-err"

        Ok store ->
            case Store.secured deepPolicy store of
                Ok _ ->
                    "deep:ok"

                Err _ ->
                    "deep:err"


-- Render a bare read predicate through `explain`, extracting the read line so a
-- simplifier identity is observable as text.
identityLine : String -> Store.Pred Doc -> String
identityLine label pred =
    String.concat [ label, ":", readExplanation (Store.readOnly pred) ]


-- `readOnly always` leaves the update path at its fail-closed `never` default.
readOnlyLine : String
readOnlyLine =
    String.concat [ "readonly:", updateExplanation (Store.readOnly Store.always) ]


-- A read-only `existsIn` policy over the good `docs` store: a doc is readable
-- when a share row exists whose `docRef` equals the doc's `author`. Both
-- correlation columns exist on their own side, and the good share store's owner
-- read policy composes in, so `secured` returns `Ok`.
existsInPolicy : Store.Secured Share -> Store.Policy Doc
existsInPolicy securedShare =
    Store.readOnly
        (Store.existsIn securedShare
            (\share doc -> Store.correlate share.docRef doc.author)
        )


-- `secured` over the good `docs` store with an `existsIn` policy whose
-- correlation columns exist on BOTH sides → `Ok`.
existsInOkLine : String
existsInOkLine =
    case ( Store.fromCodec "docs" docCodec, securedShareFrom shareCodec ) of
        ( Ok store, Just securedShare ) ->
            case Store.secured (existsInPolicy securedShare) store of
                Ok _ ->
                    "existsinok:ok"

                Err _ ->
                    "existsinok:err"

        _ ->
            "existsinok:build-err"


-- The `read:` clause of the `existsIn` policy, proving `explain` renders the
-- correlation AND the composed share read policy as transparent text.
existsInExplainLine : String
existsInExplainLine =
    case securedShareFrom shareCodec of
        Just securedShare ->
            String.concat [ "existsinexplain:", readExplanation (existsInPolicy securedShare) ]

        Nothing ->
            "existsinexplain:build-err"


-- `secured` over the THIN `docs` store (only `body`): the correlation names
-- `doc.author` on the OUTER side, absent from the thin store → fail-closed
-- `Err` (the outer-side column is re-validated against the outer store).
existsInOuterErrLine : String
existsInOuterErrLine =
    case ( Store.fromCodec "docs2" thinCodec, securedShareFrom shareCodec ) of
        ( Ok store, Just securedShare ) ->
            case Store.secured (existsInPolicy securedShare) store of
                Ok _ ->
                    "existsinouter:ok"

                Err _ ->
                    "existsinouter:err"

        _ ->
            "existsinouter:build-err"


-- `secured` over the good `docs` store but a THIN share store (only `member`):
-- the correlation names `share.docRef` on the SHARE side, absent from the thin
-- share store → fail-closed `Err` (the share-side column is re-validated against
-- the SHARE store, not the outer store).
existsInShareErrLine : String
existsInShareErrLine =
    case ( Store.fromCodec "docs" docCodec, securedShareFrom thinShareCodec ) of
        ( Ok store, Just securedShare ) ->
            case Store.secured (existsInPolicy securedShare) store of
                Ok _ ->
                    "existsinshare:ok"

                Err _ ->
                    "existsinshare:err"

        _ ->
            "existsinshare:build-err"


-- `secured` over a `MaskDoc` store: the masked `ssn` column is nullable
-- (`CNull CText`) and every policy column exists → `Ok`.
maskOkLine : String
maskOkLine =
    case Store.fromCodec "mdocs" maskCodec of
        Err _ ->
            "maskok:build-err"

        Ok store ->
            case Store.secured maskPolicy store of
                Ok _ ->
                    "maskok:ok"

                Err _ ->
                    "maskok:err"


-- The `masked columns:` clause of the mask policy's `explain`, proving the mask
-- rule renders as transparent text.
maskExplainLine : String
maskExplainLine =
    String.concat [ "maskexplain:", maskedExplanation maskPolicy ]


-- Masking a NON-nullable column fails closed at `secured`: `.owner` is `CText`
-- (not `CNull`), so masking it would NULL a value the decoder cannot represent →
-- typed `Err` (the soundness SEAL).
maskNonNullLine : String
maskNonNullLine =
    case Store.fromCodec "mdocs2" maskCodec of
        Err _ ->
            "masknonnull:build-err"

        Ok store ->
            case
                Store.secured
                    (Store.readOnly Store.always
                        |> Store.mask .owner Store.always
                    )
                    store
            of
                Ok _ ->
                    "masknonnull:ok"

                Err _ ->
                    "masknonnull:err"


-- Masking a column ABSENT from the store's derived columns fails closed at
-- `secured`: the thin `MaskDoc` store's shape names only `owner`, so masking
-- `.ssn` (not a column) is a typed `Err`.
maskMissingLine : String
maskMissingLine =
    case Store.fromCodec "mdocs3" thinMaskCodec of
        Err _ ->
            "maskmissing:build-err"

        Ok store ->
            case
                Store.secured
                    (Store.readOnly Store.always
                        |> Store.mask .ssn Store.always
                    )
                    store
            of
                Ok _ ->
                    "maskmissing:ok"

                Err _ ->
                    "maskmissing:err"


-- A `MaskDoc` codec whose shape names ONLY `owner`, so a store built from it has
-- no `ssn` column — used to prove a masked column absent from the store is
-- re-validated and refused.
thinMaskCodec : Codec MaskDoc
thinMaskCodec =
    Codec
        { enc = \d -> Encode.object [ ( "owner", Encode.string d.owner ) ]
        , mkDec =
            \_ ->
                Decode.map (\o -> { owner = o, ssn = "" })
                    (Decode.field "owner" Decode.string)
        , shp = SRecord [ ( "owner", CText ) ]
        }


-- The `masked columns:` clause of a mask policy's `explain`, reduced to its value.
maskedExplanation : Store.Policy MaskDoc -> String
maskedExplanation policy =
    case List.head (List.filter (String.startsWith "masked columns:") (String.lines (Store.explain policy))) of
        Just line ->
            String.trim (afterColon line)

        Nothing ->
            ""


-- A principal-side leaf (`role` / `memberOf` / `claimEquals`) names NO row
-- column — it gates on WHO is asking, not on the row's contents. So a read
-- policy built from one carries no column for `secured` to re-validate, and it
-- classifies `Ok` even over the THIN store (which lacks `author` / `created_at`).
-- This pins that the caller-claim leaves smuggle no phantom column into the
-- column-validation surface.
principalLeafSecuredLine : String
principalLeafSecuredLine =
    case Store.fromCodec "docs4" thinCodec of
        Err _ ->
            "principalleaf:build-err"

        Ok store ->
            case Store.secured (Store.readOnly (Store.role "admin")) store of
                Ok _ ->
                    "principalleaf:ok"

                Err _ ->
                    "principalleaf:err"


-- The `read:` clause of a policy's `explain`, reduced to its value.
readExplanation : Store.Policy Doc -> String
readExplanation policy =
    clauseValue "read" policy


-- The `update:` clause of a policy's `explain`, reduced to its value.
updateExplanation : Store.Policy Doc -> String
updateExplanation policy =
    clauseValue "update" policy


-- The value of the `explain` clause labelled `<label>` — the text after the
-- label's colon, trimmed — or `""` when the clause is absent.
clauseValue : String -> Store.Policy Doc -> String
clauseValue label policy =
    case List.head (List.filter (String.startsWith (String.append label ":")) (String.lines (Store.explain policy))) of
        Just line ->
            String.trim (afterColon line)

        Nothing ->
            ""


-- Everything after the first `:` in `s`, or `s` unchanged when it has none.
afterColon : String -> String
afterColon s =
    case String.split ":" s of
        _ :: rest ->
            String.join ":" rest

        [] ->
            s
