module Main exposing (main)

-- SEAL fix 2026-07-11: `ErrorInfo` is a NOMINAL opaque type backed by the
-- runtime's `IpeErrorInfo`. Constructing `Error` from a bare record literal
-- must be REJECTED at `ipec` time (IPE-T0001) — the sanctioned construction
-- path is the `Error.io`/`Error.unexpected`/… smart constructors (plus
-- `Error.withMessage` / `Error.withDetails` modifiers).
-- See tests/golden/error_record_literal_panicinfo/.

import Ipe.Io as Io
import Ipe.Error


main =
    let
        err =
            Error Io { message = "disk full", details = Nothing }
    in
    Io.println (Error.toString err)
