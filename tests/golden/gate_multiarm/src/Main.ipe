module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- Matching a tuple with MORE THAN ONE arm needs product/literal-pattern
-- exhaustiveness — the tuple-pattern gap (IPE-L0115).
classify : (Int, Int) -> Int
classify pair =
    case pair of
        (a, b) -> a + b
        (c, d) -> c

main =
    Io.println (String.fromInt (classify (1, 2)))
