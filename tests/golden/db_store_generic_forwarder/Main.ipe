module Main exposing (main)

import Ipe.Io as Io
import Ipe.Db as Db
import Ipe.Db.Location as Location
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Db.Store.Unsafe as StoreU
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.List as List
import Ipe.Task as Task
import Ipe.Result as Result exposing (Result(..))
import Ipe.Maybe as Maybe exposing (Maybe(..))
import Ipe.Error as Error exposing (Error)


-- Ipe.Db.Store generic-forwarder golden: the regression anchor for cross-call
-- auto-trait-bound propagation THROUGH A NON-BARE ARGUMENT.
--
-- `fetchAll` is generic over the row type `a` and runs a query it BUILDS inline:
-- `s : Store a` flows into `Store.query s` — a computed `Call`, not a bare
-- reference — which fills `Store.toList`'s bounded `Query a` slot. The forwarded
-- tvar `a` must inherit `toList<T1: Send + Sync + Clone>`'s obligations, so the
-- emitted `main_fetch_all<T1: 'static + Send + Sync + Clone>` stays GENERIC and
-- cargo-builds. A bare-argument-only propagation dropped the bound the moment
-- the tvar rode inside `Store.query s`, emitting `<T1: Send + Clone>` (no `Sync`)
-- which cargo-failed E0277 (`T1 cannot be shared between threads`) though `ipe`
-- reported exit 0 — an exit-0-then-cargo-fail SEAL break.
--
-- `fetchLimited` carries the tvar two `Call`s deep (`Store.query s |> limit 1`),
-- proving the leaf-walk descends nested computed arguments, not just the top one.
--
-- Two output lines assert the forwarders run end-to-end (not merely build):
--   all:2
--   limited:1


-- The tvar rides inside a computed `Store.query s`, NOT a bare `s`.
fetchAll : Db -> Store a -> Task Error (List a)
fetchAll conn s =
    Store.toList conn (Store.query s)


-- The tvar rides two Calls deep: `limit 1 (query s)`.
fetchLimited : Db -> Store a -> Task Error (List a)
fetchLimited conn s =
    Store.query s
        |> Store.limit 1
        |> Store.toList conn


type alias Product =
    { id : String
    , name : String
    , qty : Int
    }


productColumns : List Store.Column
productColumns =
    [ Store.textColumn "id"
    , Store.textColumn "name"
    , Store.intColumn "qty"
    ]


productStore : Result Error (Store Store.Row)
productStore =
    case Store.fromColumns "products" productColumns of
        Ok s ->
            Ok (Store.public (StoreU.primaryKey "id" s))

        Err e ->
            Err e


writeProduct : Product -> Store.Row
writeProduct p =
    Dict.fromList
        [ ( "id", p.id )
        , ( "name", p.name )
        , ( "qty", String.fromInt p.qty )
        ]


seed : List Product
seed =
    [ { id = "p1", name = "widget", qty = 30 }
    , { id = "p2", name = "gizmo", qty = 9 }
    ]


main : Task Error ()
main =
    case productStore of
        Err e ->
            Io.println (Error.toString e)

        Ok store ->
            Task.andThen
                (\conn ->
                    Db.withTransaction conn
                        (\txconn -> runChecks txconn store)
                )
                (Db.open Location.memory)


runChecks : Db -> Store Store.Row -> Task Error ()
runChecks conn store =
    Task.andThen
        (\_ -> Task.andThen (\_ -> report conn store) (insertSeed conn store))
        (Store.create conn store)


insertSeed : Db -> Store Store.Row -> Task Error ()
insertSeed conn store =
    List.foldl
        (\p acc -> Task.andThen (\_ -> insertOne conn store p) acc)
        (Task.succeed ())
        seed


insertOne : Db -> Store Store.Row -> Product -> Task Error ()
insertOne conn store p =
    Task.map (\_ -> ()) (Store.insert conn store (writeProduct p))


report : Db -> Store Store.Row -> Task Error ()
report conn store =
    Task.andThen
        (\all ->
            Task.andThen
                (\limited ->
                    Io.println
                        (String.join "\n"
                            [ String.concat [ "all:", String.fromInt (List.length all) ]
                            , String.concat [ "limited:", String.fromInt (List.length limited) ]
                            ]
                        )
                )
                (fetchLimited conn store)
        )
        (fetchAll conn store)
