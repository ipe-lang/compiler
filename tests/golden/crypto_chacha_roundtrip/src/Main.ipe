module Main exposing (main)
import Ipe.Io as Io
import Ipe.Crypto

-- ChaCha20-Poly1305 round-trip: encrypt then decrypt returns original plaintext.
-- Keys are derived inline (PBKDF2 is deterministic, same inputs → same key).
-- Nonce is random; only "ok" is tested.
main =
    let
        result =
            case Crypto.chacha20Encrypt (Crypto.chachaKeyFromPassword "password" "salt") "hello" of
                Ok ciphertext ->
                    case Crypto.chacha20Decrypt (Crypto.chachaKeyFromPassword "password" "salt") ciphertext of
                        Ok plaintext ->
                            if plaintext == "hello" then
                                "ok"

                            else
                                "wrong"

                        Err _ ->
                            "decrypt-failed"

                Err _ ->
                    "encrypt-failed"
    in
    Io.println result
