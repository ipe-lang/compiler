module Main exposing (main)

import Ipe.Html as Html
import Ipe.Html.Events as Event
import Ipe.Io as Io


-- #107 NEGATIVE sentinel (issue #45): `Ipe.Html.Events.onInput` expects
-- `(String -> msg) -> Attribute msg`. Passing a `Bool -> msg` closure is a type
-- mismatch that ipec MUST reject with IPE-T0001 — never exit 0 and defer the
-- error to cargo.
--
-- Hosted on a Ipe.Html element (`Html.input`): post-#107 `Ipe.Html.Events`
-- produces `Ipe.Html.Attribute`, which composes with Ipe.Html elements (pre-#107
-- this used `Ui.el`, relying on the removed Event→Ui conflation). The rejection
-- is on the handler payload (`Bool` vs `String`), independent of the host.


type Msg
    = SetChecked Bool


-- Bool handler on a String event — ill-typed, must be rejected.
staticHtml : String
staticHtml =
    Html.htmlRender
        (Html.input [ Event.onInput (\b -> SetChecked b) ])


main =
    Io.println staticHtml
