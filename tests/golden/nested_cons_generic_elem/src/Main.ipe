module Main exposing (main)

import Ipe.Io as Io
import Ipe.List
import Ipe.String

-- #158: a `Just`-wrapped list whose element type flows through a GENERIC
-- function parameter (`firstOr : b -> Maybe (List b) -> b`). The backend emits
-- the enclosing function with a `T: Clone` bound, so the head-element clone is
-- sound — this shape is ACCEPTED and runs. The inner `case` over the list
-- payload keeps the outer `Maybe` match free of a closed-union catch-all.
firstOr : b -> Maybe (List b) -> b
firstOr dflt m =
    case m of
        Just xs ->
            case xs of
                h :: t ->
                    h

                [] ->
                    dflt

        Nothing ->
            dflt


main =
    Io.println (String.fromInt (firstOr 0 (Just [ 1, 2 ])))
