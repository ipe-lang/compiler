module Main exposing (main)

import Ipe.Task as Task
import Ipe.Io as Io
import Ipe.String


-- #193 regression: asymmetric-arm clone-hoist, CloneOk binding (String).
--
-- `label` (non-Copy String) is used:
--   - Once in arm A (the `True` branch)
--   - Twice in arm B (the `False` branch)
--   - Once more in a post-match tail expression (T >= 1, required by v3 C4)
--
-- Pre-fix: SUM arm counts → `remaining` seeded at sum(1,2)+1 = 4; the shared
-- counter threads arms sequentially → arm A's single use is spuriously cloned
-- (remaining 4→3, clone) and arm B's first use bare-moves (remaining 3→2 →
-- 1→0) leading to a double-move E0382 in arm B.
--
-- Post-fix (MAX + per-arm snapshot): seed = max(1,2)+1 = 3; arm A gets own
-- remaining=1+1=2 (phantom +1 because tail exists) → first use clones; arm B
-- gets own remaining=2+1=3 → two clones + one bare; tail remaining=3-2=1 →
-- bare move. No E0382.
--
-- Also exercises twice-A/once-B ordering (second case expression) so both
-- orderings are pinned.
formatTag : Bool -> String -> String
formatTag isShort label =
    let
        result =
            case isShort of
                True ->
                    -- arm A: one use
                    String.toUpper label

                False ->
                    -- arm B: two uses
                    label ++ " (" ++ String.toUpper label ++ ")"
    in
    -- tail T=1: one post-match use of `label`
    result ++ " [" ++ label ++ "]"


-- Mirror with arms reversed (twice-A / once-B ordering).
formatTag2 : Bool -> String -> String
formatTag2 isLong label =
    let
        result =
            case isLong of
                True ->
                    -- arm A: two uses
                    label ++ " (" ++ String.toUpper label ++ ")"

                False ->
                    -- arm B: one use
                    String.toUpper label
    in
    result ++ " [" ++ label ++ "]"


main : Task Error ()
main =
    do
        r1 = formatTag True "ipe"
        r2 = formatTag False "ipe"
        r3 = formatTag2 True "ipe"
        r4 = formatTag2 False "ipe"
        Io.println r1
        Io.println r2
        Io.println r3
        Io.println r4
