module Main exposing (main)
import Ipe.Io as Io
import Ipe.Maybe
import Ipe.String

-- #90 Stage 1: `Just f` holding a function used to trip IPE-L0114
-- unconditionally, making `Maybe.andMap` unusable.
main =
    Io.println (String.fromInt (Maybe.withDefault 0 (Just (\x -> x * 2) |> Maybe.andMap (Just 21))))
