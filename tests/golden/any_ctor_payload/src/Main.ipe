module Main exposing (main)

-- IPE-L0102 regression: `any` as a union-constructor payload field.
--
-- Pre-fix: `lower_enum` Gate 1 collected the `any` Ty::Var, found it absent
-- from `union.vars`, and raised Feature::Polymorphism (IPE-L0102).
--
-- Post-fix: `any` is the pub/sub wire-carrier pin (Dict String String).
-- The solver substitutes it in the CtorScheme; the lowerer skips it in Gate 1
-- and emits IrType::Dict(Str, Str) in ir_type_from_canon.
--
-- Seal: ipec exit 0 AND cargo build green.

import Ipe.Io as Io

type Msg
    = BroadcastMsg any
    | Ignored

handleMsg : Msg -> String
handleMsg msg =
    case msg of
        BroadcastMsg _ -> "received"
        Ignored        -> "ignored"

main =
    Io.println (handleMsg Ignored)
