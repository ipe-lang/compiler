module Main exposing (main)
import Ipe.Io as Io
import Ipe.Db
import Ipe.Db.Location as Location
import Ipe.Db.Unsafe
import Ipe.Dict
import Ipe.List
import Ipe.Maybe
import Ipe.Db.Sql
import Ipe.String
import Ipe.Task

-- M5b-db golden: Db.findWhere with a typed SqlFragment predicate (backlog #61).
-- Replaces the removed Db.unsafeFindWhere raw-string golden: the WHERE clause
-- is built from Sql.column / Sql.int / Sql.gt combinators, never a hand-built
-- string, so the parameterised channel is structural rather than a caller
-- convention.
--
-- Inserts two rows then queries WHERE qty > 9 so only the high-qty row
-- matches. Uses sqlite::memory: inside withTransaction so all ops share one
-- connection.

main =
    Task.andThen
        (\conn ->
            Db.withTransaction conn
                (\txconn ->
                    do
                        Unsafe.unsafeExecRaw txconn
                            "CREATE TABLE products (name TEXT NOT NULL, qty INTEGER NOT NULL)"
                        Db.exec txconn
                            "INSERT INTO products (name, qty) VALUES (?, ?)"
                            [ SqlString "widget", SqlInt 10 ]
                        Db.exec txconn
                            "INSERT INTO products (name, qty) VALUES (?, ?)"
                            [ SqlString "gadget", SqlInt 7 ]
                        Task.andThen
                            (\rows ->
                                let
                                    row =
                                        Maybe.withDefault Dict.empty (List.head rows)

                                    name =
                                        Unsafe.unsafeGetString "name" row

                                    qty =
                                        Unsafe.unsafeGetInt "qty" row
                                in
                                Io.println (name ++ ":" ++ String.fromInt qty)
                            )
                            -- Typed WHERE clause: SQL injection via a naive
                            -- string-concatenated WHERE is a compile-time type
                            -- error at this call site (String vs SqlFragment) —
                            -- see the db_gate_findwhere_string negative golden.
                            (Db.findWhere txconn "products" (Sql.gt (Sql.column "qty") (Sql.int 9)))
                )
        )
        (Db.open Location.memory)
