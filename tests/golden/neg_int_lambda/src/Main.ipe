module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- A bare integer-literal lambda param `\1 ->` is refutable. It is caught even
-- EARLIER than the IPE-T0015 gate: the parser's param grammar does not admit a
-- bare literal in binding position, so it fails closed as IPE-P0001. Either way,
-- a refutable literal param never reaches codegen.
f : Int -> Int
f = \1 -> 0

main =
    Io.println (String.fromInt (f 1))
