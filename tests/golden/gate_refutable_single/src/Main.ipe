module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- A SINGLE-arm tuple `case` whose first element is a constructor sub-pattern
-- (`Wrap x`). The carrier type has exactly one constructor, so the arm is
-- type-level EXHAUSTIVE (the usefulness checker is satisfied — `Wrap` is the
-- whole signature, nothing is missing). The lowerer, however, does not model
-- constructor destructuring inside a tuple binder yet, so this refutable element
-- must fail closed as IPE-L0115 — never a mis-lowered (refutable) Rust binding.
--
-- This is the companion to `gate_refutable` (two arms): there the gap is
-- reached after a multi-arm tuple `case`; here it is the single irrefutable-slot
-- path, so the gate is proven on both branches of `lower_case`. A two-constructor
-- carrier (`Som | Non`) would instead be caught earlier as IPE-T0010 (the value
-- `(Non, _)` escapes the single arm) — see `gate_nonexhaustive_nested`.
type Wrapper = Wrap Int

f : (Wrapper, Int) -> Int
f pair =
    case pair of
        (Wrap x, b) -> x + b

main =
    Io.println (String.fromInt (f (Wrap 1, 2)))
