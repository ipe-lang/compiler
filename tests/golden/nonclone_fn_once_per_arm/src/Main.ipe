module Main exposing (main)

import Ipe.Task as Task
import Ipe.Io as Io
import Ipe.String


-- #193 D3 seal: a fn-value passed as argument (consuming position) in each of
-- two case arms — one use per arm, two arms total.
--
-- `count_fn_value_uses` must keep SUM (not MAX) so that sum(1,1)=2 triggers
-- the #221 Arc-carrier promotion of `f` (this compiles and runs). If the
-- counter were accidentally MAXed, max(1,1)=1 would skip the promotion and
-- leave an unsound per-arm double-move of a bare Box<dyn Fn> (cargo E0382).
--
-- The function `wrap` takes an `Int -> Int` argument (consuming position).
-- `applyEither` passes `f` to `wrap` once per arm — each arm has 1 consuming
-- use; two arms sum to 2 → Arc promotion.
wrap : (Int -> Int) -> Int
wrap f =
    f 42


applyEither : Bool -> (Int -> Int) -> Int
applyEither flag f =
    case flag of

        True ->
            -- arm A: `f` passed as argument to `wrap` (consuming position)
            wrap f

        False ->
            -- arm B: `f` passed as argument to `wrap` (consuming position)
            wrap f


main : Task Error ()
main =
    Io.println (String.fromInt (applyEither True (\n -> n + 1)))
