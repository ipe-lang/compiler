module Main exposing (main)

import Ipe.Io as Io
import Ipe.String

-- #158 Class-4 item C: a `Just`-wrapped list matched by a CLOSED list literal
-- (`[a, b]`) in an inner `case` over the payload — an exact-length match plus
-- indexed head bindings. A `Just [1]` (wrong length) falls through to the inner
-- `_` list arm, so this exercises both the exact-match and the fall-through
-- path, while the outer `Maybe` match names each constructor explicitly.
f : Maybe (List Int) -> Int
f m =
    case m of
        Just xs ->
            case xs of
                [ a, b ] ->
                    a + b

                _ ->
                    0

        Nothing ->
            0


main =
    Io.println (String.fromInt (f (Just [ 10, 20 ])))
