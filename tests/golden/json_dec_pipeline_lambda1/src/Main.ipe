module Main exposing (main)
import Ipe.Io as Io
import Ipe.Json.Decode
import Ipe.Json.Decode.Pipeline

-- 1-arg lambda `JsonDec.succeed (\name -> name ++ "!")` threaded with `|>`
-- through a single `required` step (arity-1 curry path).
-- Expected: Alice!

main =
    let
        r1 =
            JsonDec.decodeString
                (JsonDec.succeed (\name -> name ++ "!")
                    |> JsonDecP.required "name" JsonDec.string
                )
                "{\"name\":\"Alice\"}"
    in
    case r1 of
        Ok label1 -> Io.println label1
        Err _ -> Io.println "err1"
