module Main exposing (main)

import Ipe.Task as Task
import Ipe.Dict as Dict
import Ipe.Db as Db
import Ipe.Db.Unsafe
import Ipe.Io as Io


-- BACKLOG #177 FIX-UP 2 regression — MULTI-HOP alias chain in row position.
--
-- `let r = payload; let r2 = r in Unsafe.unsafeGetString _ r2`: the row arg `r2` is a
-- pure alias of `r`, itself a pure alias of the wildcard `payload`. The
-- alias-transparent walk resolves the chain by induction — the `r`-tracked
-- walk sees `let r2 = r` as an alias of `r` and recurses again — so the
-- `+ IpeRow` bound still lands. ipec-0 -> cargo-0.


type alias Row =
    { author : String
    , text : String
    }


decodeRow : any -> Row
decodeRow payload =
    let
        r =
            payload

        r2 =
            r
    in
    { author = Unsafe.unsafeGetString "author" r2
    , text = Unsafe.unsafeGetString "text" r2
    }


main : Task Error ()
main =
    let
        payload =
            Dict.fromList
                [ ( "author", "ada" )
                , ( "text", "hello" )
                ]

        row =
            decodeRow payload
    in
    Io.println (row.author ++ "," ++ row.text)
