module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- Value-param double-use (#49): the jump's new `a` is `a + b` and its new `b` is
-- the OLD `a` — both jump args read the current `a`. The temporaries-first
-- emission reads each arg against the current params before any write, so the
-- double read is correct. `Int` is `Copy` so it compiles trivially.
--
-- Trace of `go 5 1 0` (n, a, b):
--   (5,1,0) → (4,1,1) → (3,2,1) → (2,3,2) → (1,5,3) → (0,8,5) ⇒ a+b = 13.

go : Int -> Int -> Int -> Int
go n a b =
    if n == 0 then
        a + b

    else
        go (n - 1) (a + b) a


main =
    Io.println (String.fromInt (go 5 1 0))
