module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- A NESTED non-exhaustive `case`: the `Som` arm only matches when its inner
-- value is itself `Som`, so `Som Non` is uncovered. With the same-top-ctor
-- restriction lifted, exhaustiveness over the nested shape is still the
-- usefulness checker's call — it reports IPE-T0010 (naming the missing
-- `Som Non`) BEFORE emit, so rustc never sees a non-exhaustive `match`.
type Opt a = Som a | Non

f : Opt (Opt Int) -> Int
f oo =
    case oo of
        Som (Som x) -> x
        Non -> 0

main =
    Io.println (String.fromInt (f Non))
