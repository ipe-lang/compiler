module Main exposing (main)

import Ipe.Io as Io
import Ipe.Result
import Ipe.String

-- #90 T3 (5th attempt): annotated generic forwarder around `Result.map`,
-- instantiated at a curried callback — the deferred SchemeApp path
-- (IPE-T0014, friendly message), mirroring the andMap forwarder fixture.
mmap : (a -> b) -> Result e a -> Result e b
mmap f x =
    Result.map f x

add : Int -> Int -> Int
add a b =
    a + b

main =
    case mmap add (Ok 1) of
        Ok g -> Io.println (String.fromInt (g 2))
        Err _ -> Io.println "err"
