module Main exposing (main)

import Ipe.Io as Io
import Ipe.String as String


-- `pairWith : a -> b -> (a, b)` has def-arity 1; inside the def body
-- `\y -> (x, y)` the binder `x : a` is a bare `Generic` captured into the
-- returned closure. A bare `Generic` capture clones under the emitted
-- `a : Clone` bound, so this is soundly admitted (the capture-clone gate yields)
-- and the crate builds and runs.
pairWith : a -> b -> ( a, b )
pairWith x =
    \y -> ( x, y )


useFirst : (String -> Int -> ( String, Int )) -> ( String, Int )
useFirst f =
    f "hello" 42


main =
    case useFirst pairWith of
        ( s, n ) ->
            Io.println (s ++ "," ++ String.fromInt n)
