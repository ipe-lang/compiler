module Main exposing (main)

import Ipe.Task as Task
import Ipe.Email as Email
import Ipe.Bytes as Bytes
import Ipe.Io as Io
import Ipe.Secret
import Ipe.System as System


-- SEAL fixture: a typed `EmailMessage` built via `defaultMessage` + `with*`
-- builders is fed directly to `Email.send`, and the `EmailProvider` ADT is
-- constructed via its `Resend` ctor.  `ipe_lower` folds the message /
-- attachment / provider record + ADT shapes to the nominal runtime types the
-- `email_send` kernel takes.  This exercises the fold (message + attachment)
-- AND the `EmailProvider` ctor routing.
--
-- Address fields require `EmailAddress` values obtained via `parseAddress`.
-- The constants below are always valid; the `Nothing` arm is unreachable.
--
-- `IPE_EMAIL_DRY_RUN=1` short-circuits the provider and returns a synthetic
-- id so the run needs no network; the printed line is `sent` on success.


main =
    case ( Email.parseAddress "noreply@example.com"
         , Email.parseAddress "alice@example.com"
         ) of
        ( Just from, Just to ) ->
            let
                provider =
                    Email.Resend (Secret.fromString (System.getenvOr "RESEND_API_KEY" "test-key"))

                message =
                    Email.defaultMessage { from = from, to = [ to ], subject = "Hi" }
                        |> Email.withTextBody "Hello, world!"
                        |> Email.withAttachment
                            (Email.defaultAttachment "note.txt"
                                |> Email.withMimeType "text/plain"
                                |> Email.withContent (Bytes.fromString "body bytes")
                            )
            in
            Email.send provider message
                |> Task.andThen (\_ -> Task.succeed (Io.println "sent"))
                |> Task.onError (\_ -> Task.succeed (Io.println "failed"))

        _ ->
            Task.succeed (Io.println "unreachable")
