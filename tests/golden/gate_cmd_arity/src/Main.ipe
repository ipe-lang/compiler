module Main exposing (main)

import Ipe.Tea.Cli as Cli
import Ipe.Ui.Cli as Ui
import Ipe.Ui.Cli exposing (Lines)
import Ipe.Tea.Terminal.Cmd as Cmd
import Ipe.Tea.Cli.Sub as Sub

-- A mis-arity `Cmd` ANNOTATION (`Cmd` takes exactly one message type) used to
-- ICE (IPE-I0001) via ir_type_from_canon's catch-all. It now fails closed with
-- the clean IPE-T0016, symmetric with the Task gate.
f : Cmd Int Bool -> Int
f _ =
    0

type Msg
    = GotLine String

type alias Model =
    { n : Int }

init : () -> ( Model, Cmd Msg )
init _unit =
    ( { n = f Cmd.none }, Cmd.none )

update : Msg -> Model -> ( Model, Cmd Msg )
update _msg model =
    ( model, Cmd.none )

view : Model -> Lines Msg
view _model =
    Ui.text ("ok")

subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.onLine onLine

onLine : String -> Msg
onLine line =
    GotLine line

main =
    Cli.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
