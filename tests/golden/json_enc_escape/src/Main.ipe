module Main exposing (main)
import Ipe.Io as Io
import Ipe.Json.Encode

-- Strings must be HTML-escaped exactly as Go's json.Marshal does by default:
--   "  -> \"      (also serde)
--   <  -> \u003c
--   >  -> \u003e
--   &  -> \u0026
--   U+2028 (line sep)      -> \u2028
--   U+2029 (paragraph sep) -> \u2029
-- The value below carries all six. serde does NOT escape < > & U+2028 U+2029 by
-- default, so this pins the GoFormatter HTML-escape pass.
main =
    Io.println (JsonEnc.encode 0 (JsonEnc.string "say \"hi\" a<b>c&d e f"))
