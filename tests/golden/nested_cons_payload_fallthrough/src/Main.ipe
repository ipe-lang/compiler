module Main exposing (main)

import Ipe.Io as Io
import Ipe.String

-- #158 Class-4 item C, THE decisive soundness test: `Just []` is a valid value
-- of `Maybe (List Int)`. The inner `case` over the list payload routes `[]` to
-- its own arm — printing `0`, never panicking — while `h :: t` binds the head.
f : Maybe (List Int) -> Int
f m =
    case m of
        Just xs ->
            case xs of
                h :: t ->
                    h

                [] ->
                    0

        Nothing ->
            0


main =
    Io.println (String.fromInt (f (Just [])))
