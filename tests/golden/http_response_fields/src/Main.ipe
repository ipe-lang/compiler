module Main exposing (main)

-- Exercises the real Http.* kernel surface:
-- * Http.defaultRequestFromString is the MARKED parse-at-the-boundary helper:
--   it parses the raw string into a typed Url and narrows the scheme to
--   http/https, returning a Result. The HttpRequest fieldset synthesises and
--   the url field is readable off the Ok branch.
-- * A local HttpResponse record literal (same {body, headers, status} shape
--   the task_map targets) proves field access compiles for the response side.
import Ipe.Http as Http
import Ipe.Dict as Dict
import Ipe.Io as Io
import Ipe.Maybe
import Ipe.String


main =
    let
        reqUrl =
            case Http.defaultRequestFromString "http://example.com" of
                Ok req ->
                    req.url

                Err _ ->
                    "blocked"

        resp =
            { status = 200
            , body = "ok"
            , headers = Dict.fromList [ ( "X-Test", "1" ) ]
            }

        headerVal = Maybe.withDefault "missing" (Dict.get "X-Test" resp.headers)
    in
    Io.println
        (String.join "\n"
            [ reqUrl
            , String.fromInt resp.status
            , resp.body
            , headerVal
            ]
        )
