-- Regression: errorToString must be polymorphic `Stringify a => a -> String`,
-- not monomorphic `Error -> String`. Before the fix, calling errorToString
-- on an annotation var `a` (rigid) produced IPE-T0001. After the fix the
-- solver accumulates Stringify as a trait bound on `a`, and eqShow
-- (which also needs Eq via `==`) exercises the Eq+Stringify union.
module Main exposing (main, showAny, eqOrShow)

import Ipe.Io as Io

showAny : a -> String
showAny x =
    errorToString x

eqOrShow : a -> a -> String
eqOrShow x y =
    if x == y then
        "equal"
    else
        errorToString x ++ " /= " ++ errorToString y

main =
    Io.println (showAny 42 ++ " " ++ eqOrShow "hi" "hi" ++ " " ++ eqOrShow 1 2)
