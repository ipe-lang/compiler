module Main exposing (main)

-- #111 reconciler fixture: Cli.tea is FULLY WIRED.
-- Expected: ipec-0 AND cargo-0 on the emitted project.

import Ipe.Tea.Cli as Cli
import Ipe.Ui.Cli as Ui
import Ipe.Ui.Cli exposing (Lines)
import Ipe.Tea.Terminal.Cmd
import Ipe.String
import Ipe.Tea.Cli.Sub

type Msg = GotLine String

type alias Model = { lines : Int }

init : () -> ( Model, Cmd Msg )
init _unit =
    ( { lines = 0 }, Cmd.none )

update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        GotLine _line ->
            ( { model | lines = model.lines + 1 }, Cmd.none )

view : Model -> Lines Msg
view model =
    Ui.text ("lines: " ++ String.fromInt model.lines)

subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.onLine onLine

onLine : String -> Msg
onLine line =
    GotLine line

main =
    Cli.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
