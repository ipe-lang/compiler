module Main exposing (main)
import Ipe.Task as Task
import Ipe.Io as Io

-- #149 seal. A function-typed let-binding `go` forwarded as a HOF
-- callback to `Task.andThen` via the |> operator:
--
--   Task.succeed "hello" |> Task.andThen go
--
-- The partial application `Task.andThen go` puts `go` in a `Fun`-typed
-- (NonClone) slot.  Before #149 this emitted IPE-L0126 because
-- eta_expand_partial treated any Var in a NonClone slot as an error.
-- After the fix, NonClone Vars are bare-moved into the eta-lambda
-- (valid because task_and_then takes FnOnce — a single ownership
-- transfer suffices).
--
-- Expected output: "hello!"

step : String -> Task Error String
step s =
    Task.succeed (s ++ "!")

main =
    let go = step in
    Task.succeed "hello" |> Task.andThen go |> Task.andThen Io.println
