module Main exposing (main)
import Ipe.Io as Io
import Ipe.Task

-- Task String Int must be REJECTED: the error channel must always be `Error`.
-- `normalize_annotation_ty` validates this and emits IPE-T0001
-- "expected Error, found String".
doThing : String -> Task String Int
doThing s =
    Task.succeed 42

main =
    Io.println "test"
