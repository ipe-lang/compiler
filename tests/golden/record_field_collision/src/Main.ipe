module Main exposing (main)

import Ipe.String as String
import Ipe.Log as Log
import Ipe.Io as Io
import Ipe.Task as Task


type alias RecCount =
    { count : Int }


fieldOf : RecCount -> Int
fieldOf r =
    r.count


-- AUD-04 witness 2 (record-field-name corruption — the "seal breach" case).
--
-- `count` is captured free in `rest` (`Io.println (String.fromInt count)`) and
-- the auto-forced `effect` constructs a record LITERAL whose field is named
-- `count` too — same identifier text, unrelated binding.
--
-- The pre-fix textual pass rendered `effect_s` to Rust first
-- (`RecCount_R { count: 99 }`), then scanned it for the bare word "count"
-- and unconditionally appended `.clone()` — including onto the STRUCT
-- FIELD NAME (`count:` -> `count.clone():`), which is not valid Rust syntax
-- in field-key position. That was a genuine seal breach: a well-typed Ipe
-- program that failed `cargo build`.
--
-- Expected output: "99" then "3" (both the record's field read and the
-- captured `count` binding survive unmolested).
main =
    do
        count = 3
        Log.info (String.fromInt (fieldOf { count = 99 }))
        Io.println (String.fromInt count)
