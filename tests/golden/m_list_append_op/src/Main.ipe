module Main exposing (main)

import Ipe.Io as Io
import Ipe.List
import Ipe.String


-- (a) `++` on List Int
ints : List Int
ints =
    [ 1, 2 ] ++ [ 3, 4 ]


-- (b) `++` on List (Int, Bool) — the example-38 shape
pairs : List (Int, Bool)
pairs =
    [ ( 1, True ), ( 2, False ) ] ++ [ ( 3, True ) ]


-- (c) `++` on String — regression guard
greeting : String
greeting =
    "hi, " ++ "world"


main =
    Io.println
        (String.fromInt (List.length ints)
            ++ " "
            ++ String.fromInt (List.length pairs)
            ++ " "
            ++ greeting
        )
