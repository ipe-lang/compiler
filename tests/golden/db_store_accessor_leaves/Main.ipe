module Main exposing (main)

-- SEAL smoke for the new accessor-typed query leaves:
--   neq, gt, gte, lt, lte, like, isNull, notNull, inList, inListBy
--
-- The row type is `Item = { name : String, qty : Int, note : Maybe String }`.
-- A `Codec Item` is assembled directly (using the exposed `Codec(..)` and
-- `Shape(..)` constructors) so its `Shape` is `SRecord`, which `Store.fromCodec`
-- requires. `name`/`qty` are scalar (covered by the plain leaves); `note` is a
-- NULLABLE column (`CNull CText`) so `isNull` / `notNull` are exercised against
-- real SQL NULLs. `inListBy` is exercised with `Codec.string` (a scalar codec)
-- over `.name`.
--
-- The program connects to in-memory SQLite, creates + seeds the table, then
-- counts rows for each leaf.
--
-- Seed data:
--   { name = "widget",   qty = 30, note = Just "keep"  }
--   { name = "gizmo",    qty = 9,  note = Just "watch" }
--   { name = "sprocket", qty = 5,  note = Nothing       }  -- a real SQL NULL
--
-- Expected output:
--   gt-qty:1
--   lt-qty:2
--   gte-qty:2
--   lte-qty:2
--   neq-name:2
--   like-name:1
--   inlist-qty:2
--   inlistby-name:1
--   isnull-note:1
--   notnull-note:2


import Ipe.Codec as Codec exposing (Codec(..), Shape(..), ColType(..))
import Ipe.Db as Db
import Ipe.Db.Location as Location
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error as Error exposing (Error)
import Ipe.Io as Io
import Ipe.Json.Decode as Decode
import Ipe.Json.Encode as Encode
import Ipe.List as List
import Ipe.Maybe as Maybe exposing (Maybe(..))
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task


type alias Item =
    { name : String
    , qty : Int
    , note : Maybe String
    }


-- A `Codec Item` with `SRecord [("name", CText), ("qty", CInt), ("note",
-- CNull CText)]` shape, built directly so `Store.fromCodec` derives the three
-- columns. `note` is nullable: a `Nothing` encodes to JSON null (bound as a
-- real SQL NULL on insert), so `isNull` / `notNull` have live NULLs to match.
itemCodec : Codec Item
itemCodec =
    Codec
        { enc =
            \item ->
                Encode.object
                    [ ( "name", Encode.string item.name )
                    , ( "qty", Encode.int item.qty )
                    , ( "note", encodeNote item.note )
                    ]
        , mkDec =
            \_ ->
                Decode.map3 (\n q nt -> { name = n, qty = q, note = nt })
                    (Decode.field "name" Decode.string)
                    (Decode.field "qty" Decode.int)
                    (Decode.oneOf
                        [ Decode.map Just (Decode.field "note" Decode.string)
                        , Decode.succeed Nothing
                        ]
                    )
        , shp = SRecord [ ( "name", CText ), ( "qty", CInt ), ( "note", CNull CText ) ]
        }


encodeNote : Maybe String -> Encode.Value
encodeNote note =
    case note of
        Just s ->
            Encode.string s

        Nothing ->
            Encode.null


seed : List Item
seed =
    [ { name = "widget", qty = 30, note = Just "keep" }
    , { name = "gizmo", qty = 9, note = Just "watch" }
    , { name = "sprocket", qty = 5, note = Nothing }
    ]


countWhere : Db -> Store Item -> Store.Cond Item -> Task Error Int
countWhere conn store cond =
    Store.query store
        |> Store.where cond
        |> Store.count conn


main : Task Error ()
main =
    case Store.fromCodec "items" itemCodec of
        Err e ->
            Io.println (Error.toString e)

        Ok draft ->
            Task.andThen
                (\conn ->
                    Db.withTransaction conn
                        (\txconn -> run txconn (Store.public draft))
                )
                (Db.open Location.memory)


run : Db -> Store Item -> Task Error ()
run conn store =
    Task.andThen
        (\_ ->
            Task.andThen
                (\_ -> checks conn store)
                (seedAll conn store)
        )
        (Store.create conn store)


seedAll : Db -> Store Item -> Task Error ()
seedAll conn store =
    List.foldl
        (\item acc ->
            Task.andThen
                (\_ -> Task.map (\_ -> ()) (Store.insert conn store item))
                acc
        )
        (Task.succeed ())
        seed


checks : Db -> Store Item -> Task Error ()
checks conn store =
    Task.andThen
        (\gtN ->
            Task.andThen
                (\ltN ->
                    Task.andThen
                        (\gteN ->
                            Task.andThen
                                (\lteN ->
                                    Task.andThen
                                        (\neqN ->
                                            Task.andThen
                                                (\likeN ->
                                                    Task.andThen
                                                        (\inListN ->
                                                            Task.andThen
                                                                (\inListByN ->
                                                                    Task.andThen
                                                                        (\isNullN ->
                                                                            Task.andThen
                                                                                (\notNullN ->
                                                                                    printAll gtN ltN gteN lteN neqN likeN inListN inListByN isNullN notNullN
                                                                                )
                                                                                (countWhere conn store (Store.notNull .note))
                                                                        )
                                                                        (countWhere conn store (Store.isNull .note))
                                                                )
                                                                (countWhere conn store (Store.inListBy Codec.string .name [ "widget" ]))
                                                        )
                                                        (countWhere conn store (Store.inList .qty [ 30, 9 ]))
                                                )
                                                (countWhere conn store (Store.like .name "w%"))
                                        )
                                        (countWhere conn store (Store.neq .name "widget"))
                                )
                                (countWhere conn store (Store.lte .qty 9))
                        )
                        (countWhere conn store (Store.gte .qty 9))
                )
                (countWhere conn store (Store.lt .qty 10))
        )
        (countWhere conn store (Store.gt .qty 9))


printAll : Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Task Error ()
printAll gtN ltN gteN lteN neqN likeN inListN inListByN isNullN notNullN =
    Io.println
        (String.join "\n"
            [ String.concat [ "gt-qty:", String.fromInt gtN ]
            , String.concat [ "lt-qty:", String.fromInt ltN ]
            , String.concat [ "gte-qty:", String.fromInt gteN ]
            , String.concat [ "lte-qty:", String.fromInt lteN ]
            , String.concat [ "neq-name:", String.fromInt neqN ]
            , String.concat [ "like-name:", String.fromInt likeN ]
            , String.concat [ "inlist-qty:", String.fromInt inListN ]
            , String.concat [ "inlistby-name:", String.fromInt inListByN ]
            , String.concat [ "isnull-note:", String.fromInt isNullN ]
            , String.concat [ "notnull-note:", String.fromInt notNullN ]
            ]
        )
