module Main exposing (main)

import Ipe.Html as Html
import Ipe.Html.Events as Event
import Ipe.Io as Io


-- #107 POSITIVE sentinel: `Ipe.Html.Events.onInput` produces a
-- `Ipe.Html.Attribute msg` that composes with a Ipe.Html element's attribute
-- list. `onInput` receives a `String -> msg` closure — well-typed.
--
-- Pre-#107 this fixture rendered via `Ui.el`, relying on the (incorrect)
-- Event→Ui conflation that made `Ipe.Html.Events.*` produce a `Ipe.Ui`
-- attribute. #107 makes `Ipe.Html.Events` produce `Ipe.Html.Attribute`, so the
-- correct host is a Ipe.Html element. Ipe.Ui events stay covered by
-- `stdui_onclick` (which uses `Ui.onClick`).
--
-- oracle_divergence = true: Go oracle does not expose Html.htmlRender.


type Msg
    = SetText String


staticHtml : String
staticHtml =
    Html.htmlRender
        (Html.input [ Event.onInput (\s -> SetText s) ])


main =
    Io.println staticHtml
