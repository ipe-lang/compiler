module Main exposing (main)

import Ipe.Io as Io
import Ipe.Db


dbGetLabel : String -> String
dbGetLabel s =
    "label:" ++ s


-- #177 false-positive probe D: wildcard-`any` param, calls a USER fn whose
-- emitted symbol is `main_db_get_label` (contains db_get_) but is NOT a
-- Db.get* kernel. No Ipe.Db import.
render : any -> String
render x =
    let
        _unused =
            x
    in
    dbGetLabel "payload"


main : Task Error ()
main =
    Io.println (render 99)
