module Main exposing (main)
import Ipe.Io as Io
import Ipe.Json.Decode as JsonDec

-- A decoder applied to a value of the wrong type must return `Err`.
-- `JsonDec.int` on the string `"not an int"` must fail.
main =
    case JsonDec.decodeString JsonDec.int "\"not an int\"" of
        Ok _ ->
            Io.println "ok"

        Err _ ->
            Io.println "got error"
