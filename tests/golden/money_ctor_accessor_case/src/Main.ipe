module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- Positive regression: single-constructor union with case-expression accessors.
-- `unwrap` must compile clean (irrefutable case, not refutable param).
-- Guards the seal: ipec exit-0 → emitted Rust must cargo build.

type Wrap = Wrap Int

unwrap : Wrap -> Int
unwrap w =
    case w of
        Wrap n ->
            n

main =
    Io.println (String.fromInt (unwrap (Wrap 42)))
