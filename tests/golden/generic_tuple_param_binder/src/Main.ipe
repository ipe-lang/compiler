module Main exposing (main)

import Ipe.Io as Io
import Ipe.String

-- Tuple-pattern parameters under generics. `fst` and `pick` declare
-- polymorphic signatures, so each tuple component's type is one of the
-- definition's own type variables, and each is instantiated at two different
-- types below. (An unannotated top-level binding stays monomorphic inside its
-- own module, so the signatures are what make these generic.)
fst : ( a, b ) -> a
fst (a, b) = a

pick : ( a, a ) -> Bool -> a
pick (a, b) flag =
    if flag then
        a
    else
        b

main =
    Io.println
        (String.fromInt (fst (40, "x"))
            ++ " "
            ++ fst ("ok", 2)
            ++ " "
            ++ pick ("l", "r") False
            ++ " "
            ++ String.fromInt (pick (1, 2) True)
        )
