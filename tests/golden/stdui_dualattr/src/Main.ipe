module Main exposing (main)

import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Ui.Background as Background
import Ipe.Ui.Font as Font
import Ipe.Io as Io


-- Phase-0 reduced dual-attribute bridge test: mixes Ipe.Ui.Attribute values
-- (Font.bold, Background.color) with a Ipe.Html node (Html.div / Html.text)
-- embedded via Ui.html.  Exercises the UiCtor::UiAttribute + UiCtor::Html
-- collision-adjacent path that is buildable in Phase 0 (no event kernels).
-- oracle_divergence = true: Rust backend emits compact inline CSS.


main =
    Io.println
        (Html.htmlRender
            (Ui.layout []
                (Ui.column [ Ui.spacing 8 ]
                    [ Ui.el [ Font.bold, Background.color (Ui.rgb 0 128 0) ] (Ui.text "ui-attr")
                    , Ui.html (Html.div [] [ Html.text "html-node" ])
                    ])))
