module Main exposing (main)
import Ipe.Io as Io
import Ipe.String


-- c14 (#130 seal) — RE-CLASSIFIED to ACCEPT by the #221 fn-value Arc-carrier
-- promotion. The fn-typed param `f` is called in direct callee position
-- INSIDE a nested lambda at depth ≥ 2:
--
-- `composed f = \p -> (\x -> f x) p`
--
-- Under the bare `Box<dyn Fn>` carrier the inner `move` closure consumed `f`
-- from the outer env per call (E0525), so the depth-0-only callee exemption
-- fail-closed this with IPE-L0126. The promotion shadow-rebinds `f` to the
-- `Clone` `Arc<dyn Fn>` carrier and relays a clone across each closure
-- boundary, so the shape compiles and runs.
composed : (Int -> Int) -> Int -> Int
composed f =
    \p -> (\x -> f x) p


main =
    Io.println (String.fromInt (composed (\n -> n * 2) 3))
