module Main exposing (main)
import Ipe.Io as Io
import Ipe.Crypto
import Ipe.String

-- constantTimeEqual : constant-time byte comparison.
-- "abc" == "abc" → True ; "abc" == "abd" → False
-- Output: "true false"
main =
    let
        a =
            if Crypto.constantTimeEqual "abc" "abc" then
                "true"

            else
                "false"

        b =
            if Crypto.constantTimeEqual "abc" "abd" then
                "true"

            else
                "false"
    in
    Io.println (String.join " " [ a, b ])
