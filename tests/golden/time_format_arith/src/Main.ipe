module Main exposing (main)

import Ipe.Io as Io
import Ipe.String
import Ipe.Task as Task
import Ipe.Time as Time
import Ipe.Time.Timestamp as Timestamp


-- Fixed epoch-ms (2023-11-14 22:13:20 UTC) exercises every registered
-- kernel without reading the system clock.
epochMs : Int
epochMs =
    1700000000000


ts : Timestamp.Timestamp
ts =
    Timestamp.fromUnixMillis epochMs


main : Task Error ()
main =
    Io.println (Time.format "2006-01-02" ts)
        |> Task.andThen (\_ -> Io.println (Time.formatHTTP ts))
        |> Task.andThen (\_ -> Io.println (Time.formatISO8601 ts))
        |> Task.andThen (\_ -> Io.println (Time.formatRFC3339 ts))
        |> Task.andThen (\_ -> Io.println (String.fromInt (Timestamp.toUnixMillis (Time.addMillis 5000 ts))))
        |> Task.andThen (\_ -> Io.println (String.fromInt (Time.diffMillis (Timestamp.fromUnixMillis (epochMs + 5000)) ts)))
