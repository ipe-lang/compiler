module Main exposing (main)
import Ipe.Io as Io
import Ipe.Db
import Ipe.Db.Location as Location
import Ipe.Db.Unsafe
import Ipe.Db.Decode
import Ipe.String
import Ipe.Task

-- M5b-db golden: Db.queryDecode with Db.Decode.string — typed row decoder path.
-- Exercises IrType::Decoder(String) introduced in constrain.rs for the M5b-db fix.
-- Uses withTransaction to pin all ops to one in-memory connection.

main =
    Task.andThen
        (\conn ->
            Db.withTransaction conn
                (\txconn ->
                    do
                        Unsafe.unsafeExecRaw txconn
                            "CREATE TABLE names (n TEXT)"
                        Db.exec txconn
                            "INSERT INTO names VALUES (?)"
                            [ SqlString "alice" ]
                        Db.exec txconn
                            "INSERT INTO names VALUES (?)"
                            [ SqlString "bob" ]
                        Task.andThen
                            (\names -> Io.println (String.join "," names))
                            (Db.queryDecode txconn
                                "SELECT n FROM names ORDER BY n"
                                []
                                (Db.Decode.string "n")
                            )
                )
        )
        (Db.open Location.memory)
