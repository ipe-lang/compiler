module Main exposing (main)

import Ipe.Io as Io
import Ipe.Task as Task


-- A row-polymorphic function that sequences two reads of its row field as
-- effects. The first effect captures `rec`, so the emit-time capture-clone must
-- produce a bare `Var` receiver (routing through the borrowing witness getter),
-- never a whole-row clone. `report` is sequenced at two DIFFERENT shapes so the
-- row stays generic.
report : { r | name : String } -> Task Error ()
report rec =
    do
        Io.println rec.name
        Io.println rec.name


ada : { name : String, age : Int }
ada =
    { name = "Ada", age = 36 }


bo : { name : String, id : Int }
bo =
    { name = "Bo", id = 7 }


main =
    Task.andThen (\_ -> report bo) (report ada)
