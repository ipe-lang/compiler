module Main exposing (main)

import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Ui.Font as Font
import Ipe.Io as Io


-- Phase-0 Ipe.Ui regression: `Ui.layout` turbofish must use the enclosing
-- function's return type `Html Msg` rather than the hardcoded `()`.
-- Verifies that `main_static_view` emits `ui_layout::<MainMsg>(...)`,
-- not `ui_layout::<()>(...)`, and that the HTML renders correctly.
-- oracle_divergence = true: Rust backend emits compact inline CSS.


type Msg
    = Tick


staticView : Msg -> Html Msg
staticView msg =
    Ui.layout [] (Ui.el [ Font.bold ] (Ui.text "typed"))


main =
    Io.println (Html.htmlRender (staticView Tick))
