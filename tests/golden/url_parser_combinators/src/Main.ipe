module Main exposing (main)

-- Url.Parser routing SEAL fixture.
--
-- Exercises the pattern surface — `s`, `int`, `string`, `slash`, `top`,
-- `withQuery`, `query`, `parse`, `firstInt`/`firstString`/`firstQuery` —
-- matching a typed `Url` into a typed `AppRoute`, then rendering it. Proves the
-- pure-data patterns lower over the shipped `Ipe.Url` accessors, the emitted
-- crate builds, and the program runs: `Cli.tea` renders once at stdin
-- EOF and exits 0.

import Ipe.Maybe as Maybe
import Ipe.String
import Ipe.Tea.Cli as Cli
import Ipe.Tea.Cli.Sub
import Ipe.Tea.Terminal.Cmd
import Ipe.Ui.Cli as Ui
import Ipe.Ui.Cli exposing (Lines)
import Ipe.Url as Url
import Ipe.Url.Parser as Parser


type Msg
    = GotLine String


type AppRoute
    = Home
    | BlogPost Int
    | UserProfile String
    | Search (Maybe String)


type alias Model =
    { rendered : String
    , plusRoutes : String
    }


-- Try each route pattern in order; the first total match wins. Each alternative
-- applies its route constructor in ordinary code (the constructor is CALLED,
-- never stored), so nothing carries a function value.
router : Url.Url -> Maybe AppRoute
router url =
    case Parser.parse Parser.top url of
        Just _caps ->
            Just Home

        Nothing ->
            case Parser.parse (Parser.slash (Parser.s "blog") Parser.int) url of
                Just caps ->
                    Maybe.map BlogPost (Parser.firstInt caps)

                Nothing ->
                    case Parser.parse (Parser.slash (Parser.s "user") Parser.string) url of
                        Just caps ->
                            Maybe.map UserProfile (Parser.firstString caps)

                        Nothing ->
                            case Parser.parse (Parser.withQuery (Parser.s "search") (Parser.query "q")) url of
                                Just caps ->
                                    Just (Search (Parser.firstQuery caps))

                                Nothing ->
                                    Nothing


-- Match a raw URL string through the seal, then run the router over the typed
-- `Url`. A parse failure or an unmatched route both render a stable sentinel.
routeOf : String -> String
routeOf raw =
    case Url.fromString raw of
        Ok url ->
            case router url of
                Just Home ->
                    "home"

                Just (BlogPost n) ->
                    "blog:" ++ String.fromInt n

                Just (UserProfile name) ->
                    "user:" ++ name

                Just (Search (Just q)) ->
                    "search:" ++ q

                Just (Search Nothing) ->
                    "search:none"

                Nothing ->
                    "nomatch"

        Err _ ->
            "badurl"


render : Model
render =
    { rendered = routeOf "https://example.com/blog/42"
        ++ " "
        ++ routeOf "https://example.com/user/alice"
        ++ " "
        ++ routeOf "https://example.com/"
        ++ " "
        ++ routeOf "https://example.com/search?q=rust"
        ++ " "
        ++ routeOf "https://example.com/nowhere"
        ++ " "
        ++ routeOf "https://example.com/user/john%20doe"
        ++ " "
        ++ routeOf "https://example.com/search?q=hello%20world"
        ++ " "
        ++ routeOf "https://example.com/user/bad%C0"
    , plusRoutes =
        -- A path segment decodes under the path grammar: `+` stays a literal `+`.
        routeOf "https://example.com/user/a+b"
        -- An escape that is not two hex digits fails closed, like invalid UTF-8.
        ++ " "
        ++ routeOf "https://example.com/user/%zz"
        -- A query value decodes under the form grammar: `+` is a space.
        ++ " "
        ++ routeOf "https://example.com/search?q=a+b"
    }


-- A `%XX` escape in a captured path segment decodes at the parse
-- boundary: `john%20doe` matches the decoded literal `john doe`.
-- A `%XX` escape in a query value decodes: `hello%20world` -> `hello world`.
-- A malformed percent-escape fails closed: the segment cannot decode, so
-- `parse` yields `Nothing` and the router reports no match (never the raw
-- encoded form).
-- A path is percent-encoded, not form-encoded: `+` in a segment stays a
-- literal `+`, while `+` in the (form-encoded) query is a space. Rendered
-- on its own line so the terminal width never clips it.
init : () -> ( Model, Cmd Msg )
init _unit =
    ( render, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update _msg model =
    ( model, Cmd.none )


view : Model -> Lines Msg
view model =
    Ui.lines
        [ Ui.text ("routes: " ++ model.rendered)
        , Ui.text ("plus: " ++ model.plusRoutes)
        ]


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.onLine onLine


onLine : String -> Msg
onLine line =
    GotLine line


main =
    Cli.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
