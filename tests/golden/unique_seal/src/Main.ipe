module Main exposing (main)

-- seal — List.unique : List a -> List a
-- Removes duplicates, keeping the FIRST occurrence of each element and
-- preserving that first-seen order. Equality-only (uses ==), so it works for
-- any equatable element type.

import Ipe.Io as Io
import Ipe.List
import Ipe.String


main =
    let
        nums =
            List.unique [ 3, 1, 3, 2, 1, 3, 2 ]

        words =
            List.unique [ "a", "b", "a", "c", "b" ]
    in
    Io.println (String.join "," (List.map String.fromInt nums) ++ " " ++ String.join "," words)
