module Main exposing (main)

import Ipe.Io as Io

-- #158 C2 string-literal payload matching: a `Just`-wrapped string, matched by
-- the literal `"live"` in an inner `case` over the payload (String is an open
-- type, so its `_` fallback is not a closed-union catch-all). The outer `Maybe`
-- match names each constructor explicitly. Positive control for the depth-2
-- fail-closed gate in `nested_strlit_two_levels_gated` (adjacent test).
f : Maybe String -> String
f m =
    case m of
        Just s ->
            case s of
                "live" ->
                    "live"

                _ ->
                    "other"

        Nothing ->
            "other"


main =
    Io.println (f (Just "live"))
