module Main exposing (main)
import Ipe.Io as Io
import Ipe.Json.Decode
import Ipe.Json.Decode.Pipeline
import Ipe.String

-- Pipeline-style record decoding: `JsonDec.succeed` lifts the 3-arg `makeLabel`
-- into a decoder factory, then `JsonDecP.required` / `JsonDecP.optional` thread
-- one field each with `|>` so the written order matches the binding order.
--
-- j1 has no "nickname" field: optional supplies the default "unknown".
-- j2 has "nickname" "Bobby".
--
-- Expected:
--   Alice|30|unknown
--   Bob|25|Bobby
makeLabel : String -> Int -> String -> String
makeLabel name age nick =
    name ++ "|" ++ String.fromInt age ++ "|" ++ nick


main =
    let
        j1 = "{\"name\":\"Alice\",\"age\":30}"

        j2 = "{\"name\":\"Bob\",\"age\":25,\"nickname\":\"Bobby\"}"

        r1 =
            JsonDec.decodeString
                (JsonDec.succeed makeLabel
                    |> JsonDecP.required "name" JsonDec.string
                    |> JsonDecP.required "age" JsonDec.int
                    |> JsonDecP.optional "nickname" JsonDec.string "unknown"
                )
                j1

        r2 =
            JsonDec.decodeString
                (JsonDec.succeed makeLabel
                    |> JsonDecP.required "name" JsonDec.string
                    |> JsonDecP.required "age" JsonDec.int
                    |> JsonDecP.optional "nickname" JsonDec.string "unknown"
                )
                j2
    in
    case r1 of
        Ok label1 ->
            case r2 of
                Ok label2 ->
                    Io.println (label1 ++ "\n" ++ label2)

                Err _ ->
                    Io.println "err2"

        Err _ ->
            Io.println "err1"
