module Main exposing (main)

-- Task.attempt SEAL fixture.
--
-- `Task.attempt : (Result Error a -> msg) -> Task Error a -> Cmd msg` bridges a
-- Task into a Cmd from `init`, mapping the settled Result to a Msg. Proves the
-- combinator lowers to the runtime `cmd_perform`, the emitted crate builds, and
-- the program runs: `Cli.tea` renders the initial view once at stdin EOF and
-- exits 0.

import Ipe.Tea.Cli as Cli
import Ipe.Ui.Cli as Ui
import Ipe.Ui.Cli exposing (Lines)
import Ipe.Task as Task
import Ipe.Tea.Terminal.Cmd
import Ipe.String
import Ipe.Tea.Cli.Sub

type Msg
    = Loaded (Result Error Int)
    | GotLine String

type alias Model =
    { value : Int }

-- A task whose settled Result is delivered as `Loaded` via `Task.attempt`.
loadValue : Task Error Int
loadValue =
    Task.succeed 7

init : () -> ( Model, Cmd Msg )
init _unit =
    ( { value = 0 }, Task.attempt Loaded loadValue )

update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Loaded result ->
            case result of
                Ok n ->
                    ( { model | value = n }, Cmd.none )

                Err _ ->
                    ( model, Cmd.none )

        GotLine _line ->
            ( model, Cmd.none )

view : Model -> Lines Msg
view model =
    Ui.text ("value: " ++ String.fromInt model.value)

subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.onLine onLine

onLine : String -> Msg
onLine line =
    GotLine line

main =
    Cli.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
