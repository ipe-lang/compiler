module Main exposing (main)

-- F11 (#164 follow-up gap). `mkPair : String -> (Int -> String)` used with
-- `JsonDecP.custom` (not `required`) as the pipeline's second step. The
-- reviewer's minimal repro for the #164 gap: `JsonDecPCustom` was missing
-- from `is_pipeline_next_decoder_kernel`'s gate list
-- (crates/ipe_lower/src/lower.rs), so the `next_decoder` slot lowered to an
-- ordinary flattened `Fn` bound instead of `IrType::FnOnceChain`, producing
-- E0308 ("expected trait 'Fn', found trait 'FnOnce'") at the
-- `decode_pipeline_custom` call site in the emitted Rust.
--
-- `custom` runs its decoder over the WHOLE json value (not a single field) —
-- here `JsonDec.field "v" JsonDec.int` reads field "v" from the top-level
-- object, exercising `custom` as distinct from `required`.

import Ipe.Json.Decode as JsonDec
import Ipe.Json.Decode.Pipeline as Pipe
import Ipe.Io as Io
import Ipe.String


mkPair : String -> (Int -> String)
mkPair prefix =
    \n -> prefix ++ ":" ++ String.fromInt n


decoder : JsonDec.Decoder String
decoder =
    JsonDec.succeed mkPair
        |> Pipe.required "k" JsonDec.string
        |> Pipe.custom (JsonDec.field "v" JsonDec.int)


main =
    case JsonDec.decodeString decoder "{\"k\":\"val\",\"v\":99}" of
        Ok s ->
            Io.println s

        Err _ ->
            Io.println "decode-error"
