module Main exposing (main)
import Ipe.Io as Io
import Ipe.Result
import Ipe.String

-- #90 T3 aliasing-shape audit: RECORD-FIELD extraction of a bare
-- `Result.andMap` reference. This shape is closed, but NOT by the T3
-- mechanism itself — `{ combiner = Result.andMap }` trips the PRE-EXISTING,
-- more general `reject_function_valued_field` gate (IPE-L0107: "a function
-- value stored in a plain record field is not supported yet") unconditionally
-- for ANY bare function value in a record-literal field, independent of
-- whether the function happens to be `andMap` or perfectly harmless
-- (`{ f = String.length }` trips the identical gate). So this aliasing vector
-- was already closed before #90 ever touched `andMap` — recorded here so the
-- T3 fixture matrix has an explicit, verified answer for this row rather than
-- a silent skip.
add3 : Int -> Int -> Int -> Int
add3 a b c =
    a + b + c

main =
    let wrapper = { combiner = Result.andMap } in
    case wrapper.combiner (Ok 1) (Ok add3) of
        Ok _ -> Io.println "ok"
        Err _ -> Io.println "err"
