module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- `double` needs Number (its body adds `a` to itself). Instantiating it at Bool
-- asks for `Bool + Bool`, which has no meaning, so the use is rejected here
-- (IPE-T0014) rather than emitting Rust that cargo cannot build.
double : a -> a
double x = x + x

doubleBool : Bool -> Bool
doubleBool x = double x

main =
    Io.println (String.fromInt 0)
