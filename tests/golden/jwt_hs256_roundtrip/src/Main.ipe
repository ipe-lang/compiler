module Main exposing (main)
import Ipe.Io as Io
import Ipe.Jwt

-- JWT HS256: encode with a fixed 32-byte key and claims, then decode.
-- Two separate bindings for the secret avoid double-move of the String.
-- Secret is exactly 32 bytes, clearing the RFC 7518 §3.2 floor.
main =
    let
        encSecret = "test-secret-key-0123456789abcdef"

        decSecret = "test-secret-key-0123456789abcdef"

        claims = "{\"sub\":\"alice\",\"exp\":9999999999}"

        result =
            case Jwt.encodeHs256 encSecret claims of
                Err _ ->
                    "encode-error"

                Ok token ->
                    case Jwt.decodeHs256 decSecret token of
                        Err _ ->
                            "decode-error"

                        Ok _ ->
                            "ok"
    in
    Io.println result
