module Main exposing (main)

import Ipe.Task as Task
import Ipe.Html as Html
import Ipe.Ui as Ui exposing (Element)
import Ipe.Io as Io


-- BACKLOG #172 regression, shape (1): a promoted Arc-root handler and a SIBLING
-- INLINE lambda unified at ONE Rust type slot inside an `if` (the base case).
--
-- `handler` is a function-typed `let` binding flowing DIRECTLY into the
-- `Ui.onSubmit` kernel, so it is promoted to `Expr::SharedLambda` (its reads
-- render `Arc<dyn Fn + Send + Sync>`). The SIBLING `else` branch is an INLINE
-- `\form -> Noop` lambda, never promoted → default `Box<dyn Fn + Send + Sync>`.
-- `Arc` vs `Box` are distinct Rust types → cargo `E0308` AFTER `ipec` exit 0.
-- Fix: the inline lambda leaf is coerced DIRECTLY to `SharedLambda` (`Arc`).


type alias SignInForm =
    { email : String
    , password : String
    }


type Msg
    = DoSignIn SignInForm
    | Noop


loginForm : Bool -> Element Msg
loginForm flag =
    let
        handler =
            \form -> DoSignIn form
    in
    Ui.form
        [ Ui.onSubmit (if flag then handler else \form -> Noop) ]
        [ Ui.text "sign in" ]


main : Task Error ()
main =
    Io.println (Html.render (Ui.layout [] (loginForm True)))
