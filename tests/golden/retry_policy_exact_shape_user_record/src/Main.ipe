module Main exposing (main)

import Ipe.Io as Io
import Ipe.String


-- A USER record that shares three of the four RetryPolicy field names
-- (`baseMs`, `maxAttempts`, `shouldRetry`) but uses a plain `Int` for the
-- fourth field (`mode`) instead of `BackoffStrategy`.
--
-- This is the boundary the RetryPolicy exemption guards: the exact closed
-- shape with a function-typed `shouldRetry` and the exact field set is the
-- kernel `RetryPolicy`. A record with even ONE different field name (here
-- `mode` instead of `strategy`) is a plain user record — it uses the
-- fn-value-reuse carrier for `shouldRetry`, never the kernel-struct path.
-- L0107 protects the generic DERIVE path; this record never touches that
-- path.  The test documents the intended boundary by exercising it: ipe
-- must accept, emit, and run the program.


type alias Policy =
    { baseMs : Int
    , maxAttempts : Int
    , mode : Int
    , shouldRetry : Int -> Bool
    }


makePolicy : Int -> Int -> Policy
makePolicy attempts m =
    { baseMs = 100
    , maxAttempts = attempts
    , mode = m
    , shouldRetry = \n -> n < attempts
    }


applyPolicy : Policy -> Int -> String
applyPolicy p attempt =
    if (p.shouldRetry) attempt then
        "retry"

    else
        "done"


main =
    let
        p = makePolicy 3 1
    in
    Io.println
        (applyPolicy p 1
            ++ ","
            ++ applyPolicy p 5
            ++ ","
            ++ String.fromInt p.maxAttempts
        )
