module Main exposing (main)

import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Io as Io
import Ipe.String


-- Descending Order comparator for List.sortWith.
descending : Int -> Int -> Order
descending a b =
    compare b a


main =
    let
        xs =
            [ 3, 1, 4, 1, 5, 9, 2, 6 ]

        total =
            List.sum xs

        prod =
            List.product [ 1, 2, 3, 4 ]

        hi =
            Maybe.withDefault 0 (List.maximum xs)

        lo =
            Maybe.withDefault 0 (List.minimum xs)

        one =
            List.sum (List.singleton 7)

        rep =
            List.sum (List.repeat 4 2)

        gaps =
            List.length (List.intersperse 0 [ 1, 2, 3 ])

        parts =
            List.partition (\n -> n > 3) xs

        big =
            List.length (fst parts)

        pairs =
            List.unzip [ ( 1, 10 ), ( 2, 20 ), ( 3, 30 ) ]

        keys =
            List.sum (fst pairs)

        vals =
            List.sum (snd pairs)

        sortedHead =
            Maybe.withDefault 0 (List.head (List.sort xs))

        descHead =
            Maybe.withDefault 0 (List.head (List.sortWith descending xs))

        -- map2 (+) truncates to the shorter list.
        map2Sum =
            List.sum (List.map2 (\a b -> a + b) [ 1, 2, 3 ] [ 10, 20 ])

        -- map3 sums three lists element-wise.
        map3Sum =
            List.sum (List.map3 (\a b c -> a + b + c) [ 1, 2 ] [ 10, 20 ] [ 100, 200 ])

        -- sortBy on the negated value orders descending; head is the largest (9).
        sortByHead =
            Maybe.withDefault 0 (List.head (List.sortBy (\n -> 0 - n) xs))

        -- filterMap keeps evens and halves them: [4,2,6] → sum 6.
        halvedEvens =
            List.sum (List.filterMap (\n -> if modBy 2 n == 0 then Just (n // 2) else Nothing) xs)

        -- unique drops duplicates, keeping first-seen order: [1,2,3] → sum 6.
        distinct =
            List.sum (List.unique [ 1, 1, 2, 3, 2, 1 ])

        nums =
            [ total, prod, hi, lo, one, rep, gaps, big, keys, vals, sortedHead, descHead, map2Sum, map3Sum, sortByHead, halvedEvens, distinct ]
    in
    Io.println (String.join " " (List.map String.fromInt nums))
