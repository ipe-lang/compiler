module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- Partial ctor application: `Node Leaf 1` supplies 2 of 3 args to a ctor
-- of arity 3, leaving one `Tree` arg still needed.  Since #147 this is
-- SUPPORTED — the lowerer eta-expands into a closure.

type Tree = Leaf | Node Tree Int Tree

-- half : Tree -> (Tree -> Tree) — partially applies the first two args
half : Tree -> (Tree -> Tree)
half x = Node x 1

main =
    let t = half Leaf Leaf in
    case t of
        Leaf -> Io.println "leaf"
        Node _ n _ -> Io.println (String.fromInt n)
