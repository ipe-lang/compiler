module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- Same top-level constructor across several arms, discriminated by a NESTED
-- constructor sub-pattern. `Som (Som x)` and `Som Non` both head-match `Som`
-- and differ only in the inner `Opt`; `Non` covers the rest. Each Ipe arm
-- lowers to its OWN Rust `match` arm, in source order, so Rust's match resolves
-- the overlap and ordering natively — no one-arm-per-constructor grouping.
type Opt a = Som a | Non

f : Opt (Opt Int) -> Int
f oo =
    case oo of
        Som (Som x) -> x
        Som Non -> 7
        Non -> 3

-- 42 + 7 + 3 = 52, the same value the Go reference compiler prints.
main =
    Io.println (String.fromInt (f (Som (Som 42)) + f (Som Non) + f Non))
