module Main exposing (main)

-- Named `config` binding: the app's cross-cutting wiring lives in one top-level
-- `config : List (Setting Web)` binding, and a plain `Web.tea { … }` entry with
-- no inline settings picks it up automatically (canon threads it into
-- `Web.appWith config { … }`). ipe MUST exit 0 AND the emitted project MUST
-- cargo-build (THE SEAL for item 1's recognition site).

import Ipe.Tea.Web as Web
import Ipe.Ui as Ui
import Ipe.Tea.Web.Cmd
import Ipe.String
import Ipe.Tea.Web.Sub
import Ipe.App as App
import Ipe.Host as Host
import Ipe.Db as Db
import Ipe.Log as Log
import Ipe.Level as Level


type Page
    = CounterPage


type Msg
    = Increment


type alias Model =
    { page : Page
    , count : Int
    }


config =
    [ Host.bind Host.loopback
    , Log.level Level.warn
    , Db.url (App.fromEnv "DATABASE_URL")
    , Web.csrf Web.strict
    , Web.sessionTtl 3600
    ]


init : WebReq -> ( Model, Cmd Msg )
init _req =
    ( { page = CounterPage, count = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )


view : Model -> Element Msg
view model =
    Ui.text (String.fromInt model.count)


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.none


main =
    Web.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = [ Web.route "/" CounterPage ]
        , notFound = CounterPage
        }
