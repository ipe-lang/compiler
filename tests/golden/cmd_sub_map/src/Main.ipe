module Main exposing (main)

-- Cmd.map / Sub.map SEAL + composition fixture.
--
-- A child sub-component speaks its own `ChildMsg`; the parent folds it in with
-- `Cmd.map` (its init command) and `Sub.map` (its subscriptions), retagging the
-- child's effects into the parent's `Msg`. Proves the full pipeline compiles,
-- the emitted crate builds, and the program runs: `Cli.tea` renders the
-- initial view once at stdin EOF and exits 0.

import Ipe.Tea.Cli as Cli
import Ipe.Ui.Cli as Ui
import Ipe.Ui.Cli exposing (Lines)
import Ipe.Tea.Terminal.Cmd
import Ipe.String
import Ipe.Tea.Cli.Sub

type ChildMsg
    = ChildTick

type Msg
    = FromChild ChildMsg
    | GotLine String

type alias Model =
    { lines : Int }

-- The child's own effects, in `ChildMsg`.
childCmd : Cmd ChildMsg
childCmd =
    Cmd.none

childSub : Sub ChildMsg
childSub =
    Sub.none

init : () -> ( Model, Cmd Msg )
init _unit =
    ( { lines = 0 }, Cmd.map FromChild childCmd )

update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        FromChild _child ->
            ( model, Cmd.none )

        GotLine _line ->
            ( { model | lines = model.lines + 1 }, Cmd.none )

view : Model -> Lines Msg
view model =
    Ui.text ("mapped lines: " ++ String.fromInt model.lines)

subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.batch [ Sub.map FromChild childSub, Sub.onLine onLine ]

onLine : String -> Msg
onLine line =
    GotLine line

main =
    Cli.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
