module Main exposing (main)

import Ipe.Io as Io
import Ipe.List as List
import Ipe.String
import Ipe.Task as Task


pick : (Int -> Int) -> Int -> Int -> Int
pick g =
    \a b -> g a + b


-- Refused (IPE-L0126): the over-application `pick (\y -> h y) 1` is rebuilt as
-- a closure whose inlined argument moves the destructure-bound `h`, and
-- `List.map` may call that closure more than once.
run : ( Int -> Int, Int ) -> List Int -> List Int
run ( h, _ ) xs =
    List.map (pick (\y -> h y) 1) xs


main : Task Error ()
main =
    Io.println (String.join "," (List.map String.fromInt (run ( \n -> n + 1, 0 ) [ 1, 2 ])))
