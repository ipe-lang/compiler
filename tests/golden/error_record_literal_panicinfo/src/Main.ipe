module Main exposing (main)

-- SEAL fix 2026-07-11 (docs/architecture/
-- error-record-literal-seal-fix-2026-07-11.md): `PanicInfo` is a NOMINAL
-- opaque type backed by the runtime's `IpePanicInfo`. A bare record literal
-- must be REJECTED at `ipec` time (IPE-T0001) — before this fix it was
-- accepted (exit 0) and the emitted project failed `cargo build` with
-- E0308 `expected IpePanicInfo, found RecMessageStack`.

import Ipe.Io as Io
import Ipe.String


describe : ErrorDetails -> String
describe details =
    case details of
        FfiPanic p ->
            "FfiPanic " ++ p.message

        TypeMismatch t ->
            "TypeMismatch " ++ t.expected

        HttpStatus code ->
            "HttpStatus " ++ String.fromInt code

        JsonDecode msg ->
            "JsonDecode " ++ msg

        Custom msg ->
            "Custom " ++ msg


main =
    Io.println (describe (FfiPanic { message = "boom", stack = [] }))
