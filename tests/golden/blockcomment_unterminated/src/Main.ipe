module Main exposing (main)
import Ipe.Io as Io

-- basics negative gate: a block comment that opens with `{-` and is never closed.
-- The lexer must report IPE-P0017 (unterminated block comment) rather than
-- silently swallow the rest of the file or loop.

{- this comment starts but never ends

main =
    Io.println "unreachable"
