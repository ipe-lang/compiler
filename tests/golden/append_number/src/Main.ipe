module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- NEGATIVE (AUD-12): x has both Append and Number obligations.
-- Before the fix, ipec defaulted x to Int and accepted silently;
-- the emitted `x ++ x` then failed cargo because i64 has no ++ impl.
-- After the fix, ipec rejects here with IPE-T0014.
f x = (x ++ x) + 1

main =
    Io.println (String.fromInt 0)
