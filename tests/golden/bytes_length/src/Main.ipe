module Main exposing (main)

import Ipe.Bytes as Bytes
import Ipe.Io as Io
import Ipe.String

main =
    let
        e = Bytes.length Bytes.empty

        s = Bytes.length (Bytes.fromString "Hello")

        isEmpty0 = if Bytes.isEmpty Bytes.empty then 1 else 0

        isEmpty1 = if Bytes.isEmpty (Bytes.fromString "x") then 1 else 0
    in
    Io.println (String.join " " [ String.fromInt e, String.fromInt s, String.fromInt isEmpty0, String.fromInt isEmpty1 ])
