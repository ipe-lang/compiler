module Main exposing (main)

import Ipe.Csv as Csv
import Ipe.Io as Io
import Ipe.List
import Ipe.String

-- Regression fixture for the BACKLOG row "Ipe.Csv record literal vs nominal
-- CsvDoc mismatch at the kernel boundary": a record literal of the canonical
-- `Csv` shape `{ header : List String, rows : List (List String) }` is fed
-- DIRECTLY to `Csv.encode`, and a `Csv.parse` result is field-accessed via
-- `.header` / `.rows`.
--
-- Pre-fix, `ipe_lower` synthesised a per-project `RecHeaderRows` struct for
-- the literal while the `csv_encode` kernel takes `ipe_runtime::csv::CsvDoc`:
-- `ipec` exited 0, but the emitted `cargo build` failed with E0308
-- (`expected CsvDoc, found RecHeaderRows`). The fold to the nominal
-- `IrType::CsvDoc` (mirroring the `HttpRequest` / `CacheCfg` folds) makes the
-- literal construct the runtime struct the kernel expects.
encoded : String
encoded =
    Csv.encode
        { header = [ "id", "name" ]
        , rows = [ [ "1", "a" ], [ "2", "b" ] ]
        }


-- Round-trip: parse the encoded document back and read a nominal field. On
-- `Err` the `.header` list is empty, so the reported count is 0.
headerCount : Int
headerCount =
    case Csv.parse encoded of
        Ok doc ->
            List.length doc.header

        Err _ ->
            0


main =
    Io.println (String.fromInt headerCount)
