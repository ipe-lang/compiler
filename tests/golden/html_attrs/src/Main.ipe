module Main exposing (main)

import Ipe.Error exposing (Error)
import Ipe.Html exposing (..)
import Ipe.Html.Attributes exposing (..)
import Ipe.Io as Io
import Ipe.Result exposing (Result(..))
import Ipe.Task as Task exposing (Task)


-- #76: Ipe.Html.Attributes family end-to-end golden. Exercises fixed-key
-- string attrs (class/id/href/value/type_/placeholder), fixed-key bool attrs
-- (checked/disabled), the generic `attribute`/`boolAttribute` builders, and
-- the render-sink SECURITY gate (a hostile `attribute "onclick" ...` and an
-- unsafe value must be neutralised, never reflected verbatim). The `href`
-- target is sealed ONCE at the boundary; an `Err` fails loud via `Task.fail`.
-- oracle_divergence = true: pure Rust-backend HTML; asserted by substring.
main : Task Error ()
main =
    case linkTarget "/x?q='z" of
        Ok go ->
            Io.println
                (render
                    (div
                        [ class "app", id "main" ]
                        [ input
                            [ value "a<b\"c"
                            , type_ "text"
                            , placeholder "name"
                            , checked True
                            , disabled False
                            , attribute "data-ok" "safe"
                            , attribute "onclick" "alert(1)"
                            , boolAttribute "hidden" True
                            , role Searchbox
                            , ariaLabel "search"
                            , ariaExpanded False
                            , ariaHidden True
                            , ariaLive LivePolite
                            , ariaCurrent CurrentPage
                            , ariaChecked TriMixed
                            , ariaValuenow 3
                            ]
                        , a [ href go ] [ text "go" ]
                        ]
                    )
                )

        Err e ->
            Task.fail e
