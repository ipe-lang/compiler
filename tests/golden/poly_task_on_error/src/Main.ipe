module Main exposing (main)

import Ipe.Task as Task
import Ipe.Crypto as Crypto
import Ipe.Io as Io
import Ipe.Error

-- Minimal reproduction of the 18-job-queue withErrorReporting pattern:
-- a polymorphic helper `wrap : String -> Task Error a -> Task Error a`
-- that defines a let-fn `report` and forwards it to `Task.onError`.
--
-- Pre-fix: `eta_expand_partial` classified `Var(report)` in the partial
-- application `Task.onError report` as slot-class `None` (because
-- `ir_type_from_ty` failed on `Error -> Task Error a` when `a` is still
-- a free `Ty::Var`), triggering IPE-L0126.
--
-- Post-fix: a `Ty::Fun` slot that fails only due to a nested type variable
-- maps to `Some(NonClone)` — forwarding the Var is a plain ownership
-- transfer into `impl FnOnce`, which is correct.

wrap : String -> Task Error a -> Task Error a
wrap label task =
    let
        report e =
            Task.fail (Error.unexpected (label ++ " failed: " ++ Error.toString e))
    in
        task |> Task.onError report


main =
    wrap "test" (Task.succeed "hello")
        |> Task.andThen (\_ -> Io.println "ok")
