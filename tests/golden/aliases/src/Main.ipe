module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- A non-parametric type alias for a domain quantity.
type alias Count = Int

-- Annotated with the alias; must compile exactly as if annotated with `Int`
-- directly (the alias is expanded at canonicalisation).
increment : Count -> Count
increment n =
    n + 1

main =
    Io.println (String.fromInt (increment 41))
