module Main exposing (main)

import Ipe.Io as Io
import Ipe.Crypto as Crypto

-- Type-error fixture: `chacha20Decrypt` requires a `Key` in the key position.
-- Passing a bare `String` where the key belongs must be a compile error.

main =
    case Crypto.chacha20Decrypt "not-a-key" "ciphertext" of
        Ok plaintext ->
            Io.println plaintext

        Err _ ->
            Io.println "decrypt-failed"
