module Main exposing (main)

-- A non-Copy (CloneOk) binding used BOTH as a closure-capture into a NESTED
-- `move` closure (a `Task.andThen` continuation nested inside the pipeline
-- eta-lambda) AND as an outer by-value argument in the SAME enclosing
-- expression — the todo-cli `addTodo`/`markDone`/`listTodos` shape.
--
-- The clone hoist must descend into the outer capturing lambda's body: without
-- that, the inner nested closure moves the shadowed clone out of the outer
-- `Box<dyn Fn>` closure → E0507 ("cannot move out of a captured variable in an
-- `Fn` closure"). This fixture pins ipe-0 ⇒ cargo-0 ⇒ correct run for every
-- sub-shape.

import Ipe.List as List
import Ipe.Task as Task
import Ipe.Io as Io
import Ipe.String


-- Shape A — param captured into a Task.andThen nested closure AND consumed by
-- the outer by-value argument (`fakeExec label` moves `label`, the closure
-- clones it). The effect continuation returns a Task, so the print is
-- sequenced lawfully rather than run through a discard.
recordAction : String -> Task Error ()
recordAction label =
    fakeExec label
        |> Task.andThen
               (\_ ->
                   Io.println ("Added: " ++ label)
                       |> Task.andThen (\_ -> Io.println ("Confirmed: " ++ label)))


-- Shape B — param captured into a Task.andThen nested closure AND consumed
-- again as an outer by-value argument.
runPipeline : String -> Task Error ()
runPipeline conn =
    fakeConnect conn
        |> Task.andThen
               (\_ ->
                   Io.println ("using " ++ conn)
                       |> Task.andThen (\_ -> recordAction conn))


-- Shape C — a LAMBDA PARAM (`rows`) used by value more than once across
-- mutually-exclusive branches (`\rows -> if isEmpty rows … else … rows`).
listItems : Task Error ()
listItems =
    fakeQuery "select"
        |> Task.andThen
               (\rows ->
                   if List.isEmpty rows then
                       Io.println "empty"

                   else
                       Io.println (String.join "," rows))


-- Effect stubs (Task Error _) so no external DB/FFI is needed.
fakeExec : String -> Task Error Int
fakeExec label =
    Task.succeed (String.length label)


fakeConnect : String -> Task Error ()
fakeConnect conn =
    Task.succeed ()


fakeQuery : String -> Task Error (List String)
fakeQuery q =
    Task.succeed [ "a", "b" ]


main : Task Error ()
main =
    runPipeline "db://localhost"
        |> Task.andThen (\_ -> listItems)
