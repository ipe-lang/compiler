module Main exposing (main)

import Ipe.Io as Io
import Ipe.String as String


-- Generic {q:a}, generic {q:(a,a)}, concrete {q:Int} and concrete
-- {q:(Int,Int)} all unify with {q:a}, so every one of them is an instance of
-- the single struct RecQ<T1>.
wrapOne : a -> a
wrapOne value =
    let
        r =
            { q = value }
    in
    r.q


firstOfPair : a -> a
firstOfPair value =
    let
        r =
            { q = ( value, value ) }
    in
    case r.q of
        ( x, _ ) ->
            x


concreteScalar : Int
concreteScalar =
    let
        r =
            { q = 100 }
    in
    r.q


concretePair : Int
concretePair =
    let
        r =
            { q = ( 40, 2 ) }
    in
    case r.q of
        ( x, y ) ->
            x + y


main : Task Error ()
main =
    Io.println
        (String.fromInt
            (wrapOne 1 + firstOfPair 2 + concreteScalar + concretePair)
        )
