module Main exposing (main)
import Ipe.Io as Io
import Ipe.Result
import Ipe.String

-- #90 Stage 1 residual seal hole (found by the 5th-attempt adversarial review,
-- bisected to cd9bb1c): a LET-BOUND constructor-wrapped closure later passed to
-- a `Box<dyn Fn>`-expecting position.
--
-- The inline pipe form (`Ok (\x -> x + 1) |> Result.andMap (Ok 2)`) works
-- because the kernel call site supplies the `Box<dyn Fn>` coercion target. A
-- bare `let f = Ok (\x -> x + 1)` has NO such target at the box site: `Ok`
-- routes to the runtime `IpeResult` enum whose generic argument is inferred
-- from the constructor arg, so `Box::new(closure)` used to pin the CONCRETE
-- closure type `IpeResult<_, Box<{closure@…}>>` — which never unsize-coerces
-- to `IpeResult<E, Box<dyn Fn(..)->.. + Send>>` across the `let` boundary and
-- reached `cargo build` as E0308 (ipec-accept / cargo-reject seal hole).
--
-- `applyIt`'s param is annotated `Result Error (Int -> Int)` so the fn-carrier
-- crosses a FUNCTION boundary — Rust's whole-function inference cannot patch
-- the closure type from the far side. The fix pins the trait-object type at the
-- lambda's own emission site, so `f : IpeResult<_, Box<dyn Fn>>` regardless of
-- where it flows. Must build+run and print 42.
applyIt : Result Error (Int -> Int) -> Int
applyIt rfn =
    Result.withDefault 0 (Result.andMap (Ok 41) rfn)

main =
    let
        f = Ok (\x -> x + 1)
    in
    Io.println (String.fromInt (applyIt f))
