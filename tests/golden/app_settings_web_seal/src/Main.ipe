module Main exposing (main)

-- Runtime-config front door: `Web.appWith` carries a shape-checked
-- `List (Setting Web)` alongside the same cfg record as `Web.tea`. The
-- settings mix cross-cutting `Host.bind` / `Log.level` / `Db.url` (a `Setting a`)
-- with the web-pinned `Web.csrf` / `Web.sessionTtl` (a `Setting Web`). Each
-- setting is resolved into its runtime subsystem at startup. The database URL
-- can only come from `App.fromEnv` (a `Secret`), never a hard-coded string.
--
-- ipe MUST exit 0 AND the emitted project MUST cargo-build (THE SEAL).

import Ipe.Tea.Web as Web
import Ipe.Ui as Ui
import Ipe.Tea.Web.Cmd
import Ipe.String
import Ipe.Tea.Web.Sub
import Ipe.App as App
import Ipe.Host as Host
import Ipe.Db as Db
import Ipe.Log as Log
import Ipe.Level as Level


type Page
    = CounterPage


type Msg
    = Increment


type alias Model =
    { page : Page
    , count : Int
    }


init : WebReq -> ( Model, Cmd Msg )
init _req =
    ( { page = CounterPage, count = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )


view : Model -> Element Msg
view model =
    Ui.text (String.fromInt model.count)


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.none


main =
    Web.appWith
        [ Host.bind Host.loopback
        , Log.level Level.warn
        , Db.url (App.fromEnv "DATABASE_URL")
        , Web.csrf Web.strict
        , Web.sessionTtl 3600
        ]
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = [ Web.route "/" CounterPage ]
        , notFound = CounterPage
        }
