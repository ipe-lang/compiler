module Main exposing (main)

import Ipe.Io as Io
import Ipe.Result
import Ipe.String

-- #90 T3 green twin of map_annotated_forwarder_curried_is_t0014:
-- the SAME annotated map forwarder at an arity-1 callback must stay
-- accepted — the obligation lifts onto `mmap`'s own `b` skolem and is
-- re-verified (concretely, at Int) at this external call site.
mmap : (a -> b) -> Result e a -> Result e b
mmap f x =
    Result.map f x

inc : Int -> Int
inc n =
    n + 1

main =
    case mmap inc (Ok 41) of
        Ok n -> Io.println (String.fromInt n)
        Err _ -> Io.println "err"
