module Main exposing (main)

import Ipe.Io as Io
import Ipe.Db


-- #177 false-positive probe C: wildcard-`any` param, body has the STRING
-- LITERAL "db_get_string ..." but NO Db.get* kernel call and no Ipe.Db import.
labelFor : any -> String
labelFor x =
    let
        _unused =
            x
    in
    "db_get_string called on the payload"


main : Task Error ()
main =
    Io.println (labelFor 7)
