module Main exposing (main)

-- NEGATIVE golden: a `Store.select` projection that is NOT a column reference (or
-- a flat tuple of column references) is a fail-closed build error (IPE-L0149).
-- The stores and join are well-formed; only the projection body is at fault, so
-- the build must be rejected with IPE-L0149 — never accepted, never a partial
-- statement or a `SELECT *`.


import Ipe.Codec as Codec exposing (Codec)
import Ipe.Db as Db exposing (Db)
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error exposing (Error)
import Ipe.Io as Io
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task exposing (Task)


type alias Book =
    { id : String
    , title : String
    , authorId : String
    }


type alias Author =
    { id : String
    , name : String
    , active : Bool
    }


blankBook : Book
blankBook =
    { id = "", title = "", authorId = "" }


blankAuthor : Author
blankAuthor =
    { id = "", name = "", active = False }


bookCodec : Codec Book
bookCodec =
    Codec.auto blankBook


authorCodec : Codec Author
authorCodec =
    Codec.auto blankAuthor


booksStore : Result Error (Store Book)
booksStore =
    Store.fromCodec "books" bookCodec
        |> Result.map (\s -> Store.primaryKey .id s)
        |> Result.map Store.public


authorsStore : Result Error (Store Author)
authorsStore =
    Store.fromCodec "authors" authorCodec
        |> Result.map (\s -> Store.primaryKey .id s)
        |> Result.map Store.public


-- A SINGLE-column projection body that computes a value (`String.toUpper
-- author.name`) instead of naming a bare column — rejected (IPE-L0149). Back-fills
-- the single-reference rejection alongside the tuple ones.
badProjection : Db -> Store Book -> Store Author -> Task Error (List String)
badProjection db books authors =
    Store.selectToList db
        (Store.select (\( book, _ ) -> String.append book.title book.id)
            (Store.join books .authorId authors .id)
        )


run : Db -> Task Error (List String)
run db =
    case booksStore of
        Ok books ->
            case authorsStore of
                Ok authors ->
                    badProjection db books authors

                Err e ->
                    Task.fail e

        Err e ->
            Task.fail e


main : Task Error ()
main =
    Task.andThen
        (\_ -> Io.println "unreachable")
        (Task.onError
            (\_ -> Task.succeed ())
            (Task.andThen
                (\db -> Task.map (\_ -> ()) (run db))
                (Db.connect ())
            )
        )
