module Main exposing (main)

-- SEAL smoke for `Store.coalesce` in a typed projection body.
-- Two `Codec.auto`-derived stores join on `books.author_id = authors.id`.
-- Two `select` calls exercise the two supported operand shapes:
--
--   1. column + literal: `coalesce author.name (literal "unknown")`
--      emits: SELECT COALESCE(a1.name, ?) AS p0 FROM …
--
--   2. column + column: `coalesce book.title author.name`
--      emits: SELECT COALESCE(a0.title, a1.name) AS p0 FROM …
--
-- Column identifiers are validated at compile time and re-checked by the
-- runtime. No live database is needed: `Task.onError` catches any connection
-- failure and the program exits cleanly. The SEAL proof is a `cargo build` of
-- the emitted project under `IPE_E2E=1`.
--
-- Expected output:
--   projection-coalesce-seal:ok


import Ipe.Codec as Codec exposing (Codec)
import Ipe.Db as Db exposing (Db)
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error exposing (Error)
import Ipe.Io as Io
import Ipe.List as List
import Ipe.Result as Result exposing (Result(..))
import Ipe.Task as Task exposing (Task)


type alias Book =
    { id : String
    , title : String
    , authorId : String
    }


type alias Author =
    { id : String
    , name : String
    , active : Bool
    }


blankBook : Book
blankBook =
    { id = "", title = "", authorId = "" }


blankAuthor : Author
blankAuthor =
    { id = "", name = "", active = False }


bookCodec : Codec Book
bookCodec =
    Codec.auto blankBook


authorCodec : Codec Author
authorCodec =
    Codec.auto blankAuthor


booksStore : Result Error (Store Book)
booksStore =
    Store.fromCodec "books" bookCodec
        |> Result.map (\s -> Store.primaryKey .id s)
        |> Result.map Store.public


authorsStore : Result Error (Store Author)
authorsStore =
    Store.fromCodec "authors" authorCodec
        |> Result.map (\s -> Store.primaryKey .id s)
        |> Result.map Store.public


-- Projects COALESCE(a1.name, ?) — column + literal fallback.
coalesceWithLiteral : Db -> Store Book -> Store Author -> Task Error (List String)
coalesceWithLiteral db books authors =
    Store.selectToList db
        (Store.select
            (\( _, author ) -> Store.coalesce author.name (Store.literal "unknown"))
            (Store.join books .authorId authors .id)
        )


-- Projects COALESCE(a0.title, a1.name) — column + column.
coalesceTwoColumns : Db -> Store Book -> Store Author -> Task Error (List String)
coalesceTwoColumns db books authors =
    Store.selectToList db
        (Store.select
            (\( book, author ) -> Store.coalesce book.title author.name)
            (Store.join books .authorId authors .id)
        )


run : Db -> Task Error ()
run db =
    case booksStore of
        Ok books ->
            case authorsStore of
                Ok authors ->
                    Task.andThen
                        (\_ -> Task.map (\_ -> ()) (coalesceTwoColumns db books authors))
                        (Task.map (\_ -> ()) (coalesceWithLiteral db books authors))

                Err e ->
                    Task.fail e

        Err e ->
            Task.fail e


main : Task Error ()
main =
    Task.andThen
        (\_ -> Io.println "projection-coalesce-seal:ok")
        (Task.onError
            (\_ -> Task.succeed ())
            (Task.andThen
                (\db -> run db)
                (Db.connect ())
            )
        )
