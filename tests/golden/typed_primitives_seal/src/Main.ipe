module Main exposing (main)

import Ipe.Io as Io
import Ipe.String as String
import Ipe.Net as Net
import Ipe.Duration as Duration
import Ipe.ByteSize as ByteSize
import Ipe.Cache as Cache
import Ipe.Result as Result exposing (Result(..))


-- SEAL positive: each typed-primitive newtype is constructed through its parse
-- boundary and read back through its `toX` accessor. `Net.fromInt` also proves
-- the runtime refusals: an out-of-range port and the `0` sentinel are `Err`.
--   #1422 (masked-numeric: Port / Duration / ByteSize)


portLine : String
portLine =
    case Net.fromInt 8080 of
        Ok p ->
            "port " ++ String.fromInt (Net.toInt p)

        Err _ ->
            "port ERR"


portRejectHigh : String
portRejectHigh =
    case Net.fromInt 70000 of
        Ok _ ->
            "high UNEXPECTED-OK"

        Err _ ->
            "high rejected"


portRejectZero : String
portRejectZero =
    case Net.fromInt 0 of
        Ok _ ->
            "zero UNEXPECTED-OK"

        Err _ ->
            "zero rejected"


durLine : String
durLine =
    "dur "
        ++ String.fromInt (Duration.toMillis (Duration.seconds 30))
        ++ " "
        ++ String.fromInt (Duration.toMillis (Duration.minutes 2))


-- Non-negativity: a negative input to any constructor clamps to the zero span,
-- so a "minus-five-seconds timeout" is not a representable `Duration` — it
-- reads back as `0`, never a negative millisecond count that could disable a
-- floor.
negLine : String
negLine =
    "neg "
        ++ String.fromInt (Duration.toMillis (Duration.millis (0 - 5)))
        ++ " "
        ++ String.fromInt (Duration.toMillis (Duration.seconds (0 - 100)))


byteLine : String
byteLine =
    "bytes "
        ++ String.fromInt (ByteSize.toBytes (ByteSize.mib 10))
        ++ " "
        ++ String.fromInt (ByteSize.toBytes (ByteSize.kib 4))


-- Overflow-safety: an `n` that would overflow `Int` (i64) when scaled by the
-- unit multiplier saturates to the largest representable value rather than
-- wrapping (no negative, no panic).
satLine : String
satLine =
    "sat "
        ++ String.fromInt (Duration.toMillis (Duration.minutes 99999999999999999))
        ++ " "
        ++ String.fromInt (ByteSize.toBytes (ByteSize.mib 99999999999999))


-- Config-field boundary: the only surface that fills a timeout/ttl/interval
-- config field takes a `Duration`, so a negative span cannot reach the field —
-- it is clamped to the zero span at construction. Routing `Duration.millis (0 -
-- 5)` through `Cache.withTTL` (the ttl config-field setter) and reading the
-- field back proves the floor cannot be disabled by a negative millisecond
-- count entering through a builder. `withTTL Duration.zero` reads back `0` too;
-- the clamp makes the negative case indistinguishable from the honest zero.
ttlFieldLine : String
ttlFieldLine =
    let
        cfg =
            Cache.defaultCfg
                |> Cache.withTTL (Duration.millis (0 - 5))
    in
    "ttlField " ++ String.fromInt cfg.ttlMs


main =
    Io.println
        (String.join "\n"
            [ portLine
            , portRejectHigh
            , portRejectZero
            , durLine
            , negLine
            , byteLine
            , satLine
            , ttlFieldLine
            ]
        )
