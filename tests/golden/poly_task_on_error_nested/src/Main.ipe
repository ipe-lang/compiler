module Main exposing (main)

import Ipe.Task as Task
import Ipe.Crypto as Crypto
import Ipe.Error as Error exposing (Error)
import Ipe.Io as Io

-- #164 seal — E0308 pair. `withErrorReporting` mirrors
-- `examples/18-job-queue`'s helper of the same name: a polymorphic function
-- `String -> Task Error a -> Task Error a` whose internal error-handling
-- lambda body is a MULTI-STEP pipeline (`Crypto.randomToken 4 |> Task.andThen
-- (\errId -> logAndFail e errId)`), not a bare partial application forward
-- (that shape is covered separately by poly_task_on_error, which goes
-- through `eta_expand_partial`'s slot-class path).  This shape instead goes
-- through `lower_lambda`'s return-type inference (line ~5537 of lower.rs),
-- which used `ir_type_from_ty_json` unconditionally — mapping the lambda's
-- free return-type var straight to `IrType::Json` regardless of whether that
-- var is ALSO the enclosing `withErrorReporting`'s own quantified `a`.
--
-- Pre-fix: ipec emits closures typed `Fn(..) -> IpeTask<JsonVal>` at a call
-- site expecting `IpeTask<T1>` — a clean exit-0-then-cargo-fail (2x E0308).
--
-- Post-fix: `ir_type_from_ty_json` checks `current_poly_tvars` first (same
-- gate `ir_type_from_ty` / `ir_type_from_ty_ui_msg` already apply), routing
-- the enclosing-generic case to `IrType::Generic(sym)` instead of Json.
withErrorReporting : String -> Task Error a -> Task Error a
withErrorReporting opName task =
    let
        logAndFail e errId =
            Task.fail
                (Error.unexpected (opName ++ " failed (ref " ++ errId ++ ")"))

        report e =
            Crypto.randomToken 4
                |> Task.andThen (\errId -> logAndFail e errId)
    in
        task |> Task.onError report


failingTask : Task Error String
failingTask =
    Task.fail (Error.unexpected "boom")


main =
    withErrorReporting "op.ok" (Task.succeed "hello")
        |> Task.andThen
            (\v ->
                withErrorReporting "op.fail" failingTask
                    |> Task.andThen (\_ -> Io.println "unexpected")
                    |> Task.onError (\e -> Io.println (v ++ " | " ++ Error.toString e))
            )
