module Main exposing (main)
import Ipe.Io as Io
import Ipe.Json.Decode
import Ipe.List
import Ipe.String

-- Decode a JSON array of integers; print the length of the resulting list.
-- Exercises `JsonDec.list` (which wraps an element decoder in a factory so
-- it can be reused per element) and `JsonDec.int`.
main =
    case JsonDec.decodeString (JsonDec.list JsonDec.int) "[1,2,3]" of
        Ok ns ->
            Io.println (String.fromInt (List.length ns))

        Err _ ->
            Io.println "got error"
