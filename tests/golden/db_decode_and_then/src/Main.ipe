module Main exposing (main)
import Ipe.Io as Io
import Ipe.Db
import Ipe.Db.Location as Location
import Ipe.Db.Unsafe
import Ipe.Db.Decode
import Ipe.List
import Ipe.String
import Ipe.Task

-- `Db.Decode.andThen f decoder` — the function comes first at the surface, but
-- the runtime `decode_and_then(decoder, f)` takes the decoder first. The emitter
-- must reorder the two arguments; a chained decoder that reads a `TEXT` column
-- and rewraps it exercises that path, and only compiles when the reorder holds.
--
-- Decoder: read `n` as a String, then `andThen` into a decoder that succeeds
-- with its upper-cased form. Two rows ("alice", "bob") decode to "ALICE" and
-- "BOB", joined with ",". Output: "ALICE,BOB".

nameDecoder =
    Db.Decode.andThen
        (\n -> Db.Decode.succeed (String.toUpper n))
        (Db.Decode.string "n")

main =
    Task.andThen
        (\conn ->
            Db.withTransaction conn
                (\txconn ->
                    do
                        Unsafe.unsafeExecRaw txconn
                            "CREATE TABLE names (n TEXT)"
                        Db.exec txconn
                            "INSERT INTO names VALUES (?)"
                            [ SqlString "alice" ]
                        Db.exec txconn
                            "INSERT INTO names VALUES (?)"
                            [ SqlString "bob" ]
                        Task.andThen
                            (\names -> Io.println (String.join "," names))
                            (Db.queryDecode txconn
                                "SELECT n FROM names ORDER BY n"
                                []
                                nameDecoder
                            )
                )
        )
        (Db.open Location.memory)
