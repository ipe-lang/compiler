module Main exposing (main)

import Ipe.Io as Io
import Ipe.String

-- Regression fixture for the "Name-only HttpRequest-shape false-positive fold":
-- a record literal that shares the canonical `HttpRequest` fieldset
-- {body, headers, method, redirects, timeout, url} in NAME ONLY -- every
-- field here is `Int`, nothing HTTP-related.
--
-- The lowerer must NOT fold this to `IrType::HttpRequest` because the field
-- TYPES differ (all `Int`, not String/RedirectPolicy/etc).
sumFields : { body : Int, headers : Int, method : Int, redirects : Int, timeout : Int, url : Int } -> Int
sumFields c =
    c.body + c.headers + c.method + c.redirects + c.timeout + c.url


main =
    Io.println
        (String.fromInt
            (sumFields
                { body = 1
                , headers = 2
                , method = 3
                , redirects = 4
                , timeout = 5
                , url = 6
                }
            )
        )
