module Main exposing (main)

import Ipe.Http as Http
import Ipe.Http.Stream as HttpStream exposing (StreamId)
import Ipe.Task as Task
import Ipe.Error as Error exposing (Error)
import Ipe.Io as Io


-- i148 regression: HttpStream.open must return Task Error StreamId
-- (not Task Error Int — the pre-fix incorrect scheme).
-- The type annotation on handleOpen constrains the success type to StreamId,
-- proving the scheme is correct without a mid-flow force.

handleOpen : Result Error StreamId -> String
handleOpen res =
    case res of
        Ok _ ->
            "opened"

        Err _ ->
            "failed"


main =
    case Http.defaultRequestFromString "http://localhost:1" of
        Ok req ->
            HttpStream.open req
                |> Task.andThen (\_ -> Io.println "opened")
                |> Task.onError (\_ -> Io.println "failed")

        Err _ ->
            Io.println "failed"
