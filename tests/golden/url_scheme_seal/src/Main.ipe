module Main exposing (main)

-- SEAL + REFUSAL MATRIX: the typed URL boundary for the href / link / image /
-- share sinks. Every unsafe target must fail closed at its typed constructor,
-- and every safe one must pass. This program drives the whole matrix and prints
-- one `OK` / `ERR` verdict per case; the pinned expected output is the proof the
-- refusals hold (a regression that opened one flips a row and fails the golden).

import Ipe.Browser.Share as Share
import Ipe.Char as Char
import Ipe.Html.Attributes as Attr
import Ipe.Io as Io
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Ui as Ui
import Ipe.Url as Url
import Ipe.Web.Head as Head


-- | Collapse any `Result` to a two-state tag so the matrix output is scheme-
-- and type-agnostic: `OK` for `Ok`, `ERR` for the fail-closed `Err`.
verdict : Result e a -> String
verdict r =
    case r of
        Ok _ ->
            "OK"

        Err _ ->
            "ERR"


-- | Drive each surface's ONE dispatching seal on a raw string. `Attr.linkTarget`
-- (href) and `Ui.linkTarget` narrow through the anchor allowlist
-- (http/https/mailto/tel); `Attr.imageSrc` (the media `src` fetch sink) narrows
-- through its own tighter allowlist (http/https only). Each reads the raw string
-- absolute-then-scheme-narrowed, else same-origin relative. The `verdict` fold
-- only reads the `Ok`/`Err` tag.
hrefOf raw =
    Attr.linkTarget raw


linkOf raw =
    Ui.linkTarget raw


imageOf raw =
    Attr.imageSrc raw


shareOf raw =
    Result.andThen Share.shareUrl (Url.fromString raw)


-- | The `<head>` `href` sinks (`Head.canonical` / `Head.rss`) narrow the parsed
-- absolute `Url` through the head allowlist (http/https ONLY), so a non-web
-- scheme never reaches an emitted canonical / feed `href`.
canonicalOf raw =
    Result.andThen Head.canonical (Url.fromString raw)


rssOf raw =
    Result.andThen (\u -> Head.rss u "Feed") (Url.fromString raw)


line : String -> String -> String
line name v =
    name ++ "=" ++ v


main =
    Io.println
        (String.join "\n"
            -- href allowlist: http/https/mailto/tel accept; script/data/file reject.
            [ line "href_https" (verdict (hrefOf "https://example.com/a"))
            , line "href_http" (verdict (hrefOf "http://example.com/a"))
            , line "href_mailto" (verdict (hrefOf "mailto:a@b.com"))
            , line "href_tel" (verdict (hrefOf "tel:+15551234"))
            , line "href_javascript" (verdict (hrefOf "javascript:alert(1)"))
            , line "href_data" (verdict (hrefOf "data:text/html,<x>"))
            , line "href_file" (verdict (hrefOf "file:///etc/passwd"))
            , line "href_vbscript" (verdict (hrefOf "vbscript:msgbox"))
            , line "href_blob" (verdict (hrefOf "blob:https://x/y"))

            -- link mirrors href (mailto/tel allowed).
            , line "link_https" (verdict (linkOf "https://example.com"))
            , line "link_mailto" (verdict (linkOf "mailto:a@b.com"))
            , line "link_javascript" (verdict (linkOf "javascript:alert(1)"))

            -- image `src` is a FETCH sink with its OWN narrower allowlist
            -- (http/https ONLY): a same-origin path accepts, but the mailto/tel
            -- anchor schemes an `href` allows REJECT here, as does a script
            -- scheme. `share` is absolute-only (no relative).
            , line "img_https" (verdict (imageOf "https://example.com/i.png"))
            , line "img_relative" (verdict (imageOf "/static/logo.png"))
            , line "img_mailto" (verdict (imageOf "mailto:a@b.com"))
            , line "img_tel" (verdict (imageOf "tel:+15551234"))
            , line "img_javascript" (verdict (imageOf "javascript:alert(1)"))
            , line "share_https" (verdict (shareOf "https://example.com"))
            , line "share_mailto" (verdict (shareOf "mailto:a@b.com"))

            -- `<head>` href sinks: http/https accept; a non-web scheme rejects
            -- so it never reaches an emitted canonical / RSS-feed `href`.
            , line "canonical_https" (verdict (canonicalOf "https://example.com/"))
            , line "canonical_javascript" (verdict (canonicalOf "javascript:alert(1)"))
            , line "canonical_file" (verdict (canonicalOf "file:///etc/passwd"))
            , line "rss_https" (verdict (rssOf "https://example.com/feed.xml"))
            , line "rss_javascript" (verdict (rssOf "javascript:alert(1)"))

            -- relative reference seal: same-origin paths accept; the
            -- cross-origin / scheme / backslash / control / empty coercions reject.
            , line "rel_path" (verdict (Url.relative "/static/x.js"))
            , line "rel_dot" (verdict (Url.relative "./page"))
            , line "rel_fragment" (verdict (Url.relative "#top"))
            , line "rel_query" (verdict (Url.relative "?q=1"))
            , line "rel_protocol_rel" (verdict (Url.relative "//evil.com/x"))
            , line "rel_backslash" (verdict (Url.relative "/\\evil.com"))
            , line "rel_scheme" (verdict (Url.relative "javascript:alert(1)"))
            , line "rel_empty" (verdict (Url.relative ""))
            , line "rel_control" (verdict (Url.relative ("/a" ++ tab ++ "b")))
            ]
        )


-- | A literal horizontal-tab, to prove a control byte in an otherwise
-- path-shaped relative ref is rejected on presence.
tab : String
tab =
    String.fromChar (Char.fromCode 9)
