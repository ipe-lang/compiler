module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- An unrecognised escape resolves to backslash + char, two scalar values, which
-- violates the single-character invariant the char backend relies on. In
-- pattern position `'\q'` must be rejected at lex time as IPE-P0015 — never
-- silently lowered to a two-character literal.
grade : Char -> Int
grade c =
    case c of
        '\q' -> 1
        _ -> 0

main =
    Io.println (String.fromInt (grade 'a'))
