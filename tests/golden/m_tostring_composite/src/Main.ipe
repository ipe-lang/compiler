module Main exposing (main)

-- Refusal golden: `{{expr}}` interpolates exactly `String` / `Int` / `Float` /
-- `Bool` / `Char`. Interpolating a record or a custom type is refused at
-- type-check (IPE-T0014) — render the fields explicitly instead (see
-- `golden_stringify.rs`).

import Ipe.Io as Io


type Shape
    = Circle Int
    | Empty


type alias Point =
    { x : Int, y : Int }


point : Point
point =
    { x = 1, y = 2 }


main =
    let
        scalar =
            """{{42}}"""

        record =
            """{{point}}"""

        adtPayload =
            """{{Circle 5}}"""

        adtNullary =
            """{{Empty}}"""
    in
    Io.println (scalar ++ " | " ++ record ++ " | " ++ adtPayload ++ " | " ++ adtNullary)
