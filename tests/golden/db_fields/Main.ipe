module Main exposing (main)
import Ipe.Io as Io
import Ipe.Db
import Ipe.Db.Location as Location
import Ipe.Db.Unsafe
import Ipe.Dict
import Ipe.List
import Ipe.String
import Ipe.Task

-- M5b-db golden: Db.insertFields with SetField/OmitField + Db.updateFields.
-- OmitField columns are excluded from generated SQL; the DB applies DEFAULT.
-- Verifies: initial insert omits "notes" → gets DEFAULT 'none'; updateFields
-- omits "notes" again → notes stays 'none' while name changes to 'gadget'.

main =
    Task.andThen
        (\conn ->
            Db.withTransaction conn
                (\txconn ->
                    do
                        Unsafe.unsafeExecRaw txconn
                            "CREATE TABLE items (id TEXT PRIMARY KEY, name TEXT, notes TEXT DEFAULT 'none')"
                        Db.insertFields txconn
                            "items"
                            [ ( "id", SetField (SqlString "1") )
                            , ( "name", SetField (SqlString "widget") )
                            , ( "notes", OmitField )
                            ]
                        Task.andThen
                            (\before ->
                                do
                                    Db.updateFields txconn
                                        "items"
                                        [ ( "id", SqlString "1" ) ]
                                        [ ( "name", SetField (SqlString "gadget") )
                                        , ( "notes", OmitField )
                                        ]
                                    Task.andThen
                                        (\after ->
                                            Io.println
                                                (String.join
                                                    ","
                                                    (List.map
                                                        (\r -> cellText "name" r ++ "/" ++ cellText "notes" r)
                                                        before
                                                    )
                                                    ++ "\n"
                                                    ++ String.join
                                                        ","
                                                        (List.map
                                                            (\r -> cellText "name" r ++ "/" ++ cellText "notes" r)
                                                            after
                                                        )
                                                )
                                        )
                                        (Unsafe.unsafeQuery txconn
                                            "SELECT name, notes FROM items ORDER BY id"
                                            []
                                        )
                            )
                            (Unsafe.unsafeQuery txconn
                                "SELECT name, notes FROM items ORDER BY id"
                                []
                            )
                )
        )
        (Db.open Location.memory)


-- The text of column `key` in a raw Db row: a SQL `NULL` cell reads as `NULL`,
-- a missing column as the empty string.
cellText : String -> Dict String (Maybe String) -> String
cellText key row =
    case Dict.get key row of
        Just (Just s) ->
            s

        Just Nothing ->
            "NULL"

        Nothing ->
            ""
