module Main exposing (main)

-- `Store.upsert` against a live `sqlite::memory:` database. The conflict target
-- is the store's declared key, never an argument: every refusal is Store's own
-- typed `Err`, raised before any SQL, and every accepted upsert is one atomic
-- `INSERT … ON CONFLICT (…) DO UPDATE`. Tables a fixture needs that `createSql`
-- does not render (a composite key, a second `UNIQUE`, a renamed column) are
-- created by raw DDL. Checks, one line each:
--
--   * refusals, each clearing every earlier guard: no key and no `unique`
--     column; several `unique` columns; an illegal key declaration; an unknown
--     target column; a target column, declared or renamed, that is not a valid
--     identifier (its text never echoed); a DB-filled (`serial`) key; a `NULL`
--     key;
--   * the row counts of every refused table, read before and after the
--     refusals, are equal: no refused upsert reached the database;
--   * a raw-column row with no key cell binds the empty string (the `rowCodec`
--     encoding of an absent cell) and is upserted under that key;
--   * a single key: insert, then update in place; a `defaultNow` column keeps
--     its stored value across the update;
--   * a composite key: a repeated pair updates, a new pair inserts;
--   * a `unique` column as the target of a store with no primary key;
--   * a row that conflicts on a `UNIQUE` column other than the target is the
--     database's typed `Err` carrying `Database UniqueViolation`, and writes
--     nothing;
--   * a renamed key column is targeted under its current name.
--
-- Output: see expected.txt.

import Ipe.Codec as Codec exposing (Codec(..), ColType(..), Shape(..))
import Ipe.Db as Db exposing (Db, DbFailure(..))
import Ipe.Db.Store as Store exposing (Draft, Store)
import Ipe.Db.Store.Unsafe as StoreU
import Ipe.Db.Unsafe as Unsafe
import Ipe.Dict as Dict
import Ipe.Error as Error exposing (Error)
import Ipe.Io as Io
import Ipe.Json.Decode as Decode
import Ipe.Json.Encode as Encode
import Ipe.List as List
import Ipe.Maybe as Maybe exposing (Maybe(..))
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task exposing (Task)


-- ── Typed stores ─────────────────────────────────────────────────────

type alias Code =
    { code : String
    , label : String
    , createdAt : String
    }


blankCode : Code
blankCode =
    { code = "", label = "", createdAt = "" }


codesStore : Result Error (Store Code)
codesStore =
    Store.fromCodec "codes" (Codec.auto blankCode)
        |> Result.map (\d -> Store.public (Store.defaultNow .createdAt (Store.primaryKey .code d)))


type alias Ticket =
    { id : Int
    , title : String
    }


blankTicket : Ticket
blankTicket =
    { id = 0, title = "" }


ticketsStore : Result Error (Store Ticket)
ticketsStore =
    Store.fromCodec "tickets" (Codec.auto blankTicket)
        |> Result.map (\d -> Store.public (Store.primaryKey .id (Store.serial .id d)))


type alias Badge =
    { code : Maybe String
    , label : String
    }


-- A hand-assembled codec pinning `code` to a nullable column, so a row can carry
-- a `NULL` key.
badgeCodec : Codec Badge
badgeCodec =
    Codec
        { enc =
            \b ->
                Encode.object
                    [ ( "code", encodeMaybeString b.code )
                    , ( "label", Encode.string b.label )
                    ]
        , mkDec =
            \_ ->
                Decode.map2 (\c l -> { code = c, label = l })
                    (Decode.field "code" (Decode.nullable Decode.string))
                    (Decode.field "label" Decode.string)
        , shp = SRecord [ ( "code", CNull CText ), ( "label", CText ) ]
        }


encodeMaybeString : Maybe String -> Encode.Value
encodeMaybeString m =
    case m of
        Just s ->
            Encode.string s

        Nothing ->
            Encode.null


badgesStore : Result Error (Store Badge)
badgesStore =
    Store.fromCodec "badges" badgeCodec
        |> Result.map (\d -> Store.public (Store.primaryKey .code d))


-- ── Raw-column drafts ────────────────────────────────────────────────

contactsDraft : Result Error (Draft Store.Row)
contactsDraft =
    Store.fromColumns "contacts"
        [ Store.textColumn "email"
        , Store.textColumn "name"
        , Store.textColumn "phone"
        ]


membershipsDraft : Result Error (Draft Store.Row)
membershipsDraft =
    Store.fromColumns "memberships"
        [ Store.textColumn "user_id"
        , Store.textColumn "group_id"
        , Store.textColumn "role"
        ]


slugsDraft : Result Error (Draft Store.Row)
slugsDraft =
    Store.fromColumns "slugs"
        [ Store.textColumn "slug"
        , Store.textColumn "title"
        ]


pairsDraft : Result Error (Draft Store.Row)
pairsDraft =
    Store.fromColumns "pairs"
        [ Store.textColumn "k"
        , Store.textColumn "v"
        ]


type alias Fixtures =
    { contacts : Draft Store.Row
    , memberships : Draft Store.Row
    , slugs : Draft Store.Row
    , pairs : Draft Store.Row
    , codes : Store Code
    , tickets : Store Ticket
    , badges : Store Badge
    }


fixtures : Result Error Fixtures
fixtures =
    Result.andThen
        (\contacts ->
            Result.andThen
                (\memberships ->
                    Result.andThen
                        (\slugs ->
                            Result.andThen
                                (\pairs ->
                                    Result.andThen
                                        (\codes ->
                                            Result.andThen
                                                (\tickets ->
                                                    Result.map
                                                        (\badges ->
                                                            { contacts = contacts
                                                            , memberships = memberships
                                                            , slugs = slugs
                                                            , pairs = pairs
                                                            , codes = codes
                                                            , tickets = tickets
                                                            , badges = badges
                                                            }
                                                        )
                                                        badgesStore
                                                )
                                                ticketsStore
                                        )
                                        codesStore
                                )
                                pairsDraft
                        )
                        slugsDraft
                )
                membershipsDraft
        )
        contactsDraft


-- ── Driver ───────────────────────────────────────────────────────────

main : Task Error ()
main =
    case fixtures of
        Ok fx ->
            do
                conn <- Db.open "sqlite" "sqlite::memory:"
                Db.withTransaction conn
                    (\tx ->
                        do
                            setup tx fx
                            refusalChecks tx fx
                            acceptChecks tx fx
                    )

        Err e ->
            Io.println (String.concat [ "fixtures:FAIL ", Error.toString e ])


setup : Db -> Fixtures -> Task Error ()
setup conn fx =
    do
        _ <- Store.create conn fx.codes
        _ <- Store.create conn fx.tickets
        _ <- Store.insert conn fx.tickets { id = 0, title = "seed" }
        List.foldl
            (\stmt acc -> Task.andThen (\_ -> Task.map (\_ -> ()) (Unsafe.unsafeExecRaw conn stmt)) acc)
            (Task.succeed ())
            [ "CREATE TABLE contacts (email TEXT NOT NULL UNIQUE, name TEXT NOT NULL, phone TEXT NOT NULL UNIQUE)"
            , "INSERT INTO contacts (email, name, phone) VALUES ('seed@x', 'Seed', 'p0')"
            , "CREATE TABLE badges (code TEXT PRIMARY KEY, label TEXT NOT NULL)"
            , "INSERT INTO badges (code, label) VALUES ('b1', 'Seed')"
            , "CREATE TABLE memberships (user_id TEXT NOT NULL, group_id TEXT NOT NULL, role TEXT NOT NULL, PRIMARY KEY (user_id, group_id))"
            , "CREATE TABLE pairs (k TEXT PRIMARY KEY, v TEXT NOT NULL)"
            , "CREATE TABLE slugs (handle TEXT PRIMARY KEY, title TEXT NOT NULL)"
            ]


-- ── Refusals: Store's own `Err`, no SQL sent ─────────────────────────

contact : String -> String -> String -> Store.Row
contact email name phone =
    Dict.fromList [ ( "email", email ), ( "name", name ), ( "phone", phone ) ]


refusalChecks : Db -> Fixtures -> Task Error ()
refusalChecks conn fx =
    let
        view =
            Store.public fx.contacts

        row =
            contact "new@x" "New" "p9"
    in
    do
        say (countLine "contacts-before" conn view)
        say (countLine "tickets-before" conn fx.tickets)
        say (countLine "badges-before" conn fx.badges)
        say
            (refused "no-key"
                "upsert requires a declared primary key or unique column"
                (Store.upsert conn view row)
            )
        say
            (refused "several-unique"
                "upsert found several unique columns"
                (Store.upsert conn (Store.public (StoreU.unique "phone" (StoreU.unique "email" fx.contacts))) row)
            )
        say
            (refused "illegal-key"
                "a second one was declared after primary key (email)"
                (Store.upsert conn (Store.public (StoreU.primaryKey "name" (StoreU.primaryKey "email" fx.contacts))) row)
            )
        say
            (refused "unknown-target"
                "\"nope\" is not a column of this store"
                (Store.upsert conn (Store.public (StoreU.unique "nope" fx.contacts)) row)
            )
        say
            (refusedWithout "invalid-target"
                "upsert refused a conflict-target column whose name is not a valid SQL identifier"
                "bad name"
                (Store.upsert conn (Store.public (StoreU.unique "bad name" fx.contacts)) row)
            )
        say
            (refusedWithout "invalid-renamed-target"
                "upsert refused a conflict-target column whose name is not a valid SQL identifier"
                "bad name"
                (Store.upsert conn (Store.renameColumn "email" "bad name" (Store.public (StoreU.unique "email" fx.contacts))) row)
            )
        say
            (refused "serial-key"
                "the database fills that column"
                (Store.upsert conn fx.tickets { id = 1, title = "hijack" })
            )
        say
            (refused "null-key"
                "NULL key in conflict-target column \"code\""
                (Store.upsert conn fx.badges { code = Nothing, label = "dup" })
            )
        say (countLine "contacts-after" conn view)
        say (countLine "tickets-after" conn fx.tickets)
        say (countLine "badges-after" conn fx.badges)


-- ── Accepted upserts ─────────────────────────────────────────────────

acceptChecks : Db -> Fixtures -> Task Error ()
acceptChecks conn fx =
    let
        pairs =
            Store.public (StoreU.primaryKey "k" fx.pairs)

        members =
            Store.public (StoreU.compositePrimaryKey [ "user_id", "group_id" ] fx.memberships)

        byEmail =
            Store.public (StoreU.unique "email" fx.contacts)

        slugs =
            Store.renameColumn "slug" "handle" (Store.public (StoreU.primaryKey "slug" fx.slugs))
    in
    do
        say (counted "absent-key" (Store.upsert conn pairs (Dict.fromList [ ( "v", "v1" ) ])))
        say (snapshot "pairs" conn pairs [ "k", "v" ])
        say (counted "single-insert" (Store.upsert conn fx.codes { code = "a", label = "one", createdAt = "CLIENT" }))
        say (counted "stamp-sentinel" (Unsafe.unsafeExecRaw conn "UPDATE codes SET created_at = 'sentinel'"))
        say (counted "single-update" (Store.upsert conn fx.codes { code = "a", label = "two", createdAt = "CLIENT2" }))
        say (codesLine conn fx.codes)
        say (counted "composite-insert" (Store.upsert conn members (member "u1" "g1" "member")))
        say (counted "composite-update" (Store.upsert conn members (member "u1" "g1" "admin")))
        say (counted "composite-new-pair" (Store.upsert conn members (member "u1" "g2" "member")))
        say (snapshot "memberships" conn members [ "user_id", "group_id", "role" ])
        say (counted "unique-insert" (Store.upsert conn byEmail (contact "a@x" "Ann" "p1")))
        say (counted "unique-update" (Store.upsert conn byEmail (contact "a@x" "Ann2" "p1")))
        say (snapshot "contacts" conn byEmail [ "email", "name", "phone" ])
        say
            (refusedBy "other-unique-conflict"
                UniqueViolation
                (Store.upsert conn byEmail (contact "b@x" "Bob" "p1"))
            )
        say (snapshot "contacts-after-conflict" conn byEmail [ "email", "name", "phone" ])
        say (counted "renamed-insert" (Store.upsert conn slugs (Dict.fromList [ ( "slug", "s1" ), ( "title", "A" ) ])))
        say (counted "renamed-update" (Store.upsert conn slugs (Dict.fromList [ ( "slug", "s1" ), ( "title", "B" ) ])))
        say (snapshot "slugs" conn slugs [ "slug", "title" ])


member : String -> String -> String -> Store.Row
member user group role =
    Dict.fromList [ ( "user_id", user ), ( "group_id", group ), ( "role", role ) ]


codesLine : Db -> Store Code -> Task Error String
codesLine conn store =
    Task.map
        (\rows ->
            String.concat
                [ "codes:"
                , String.join "," (List.map (\c -> String.join "/" [ c.code, c.label, c.createdAt ]) rows)
                ]
        )
        (Store.toList conn (Store.query store))


-- ── Line helpers ─────────────────────────────────────────────────────

say : Task Error String -> Task Error ()
say task =
    Task.andThen Io.println task


-- `label:rejected` when `task` fails with an error whose message contains
-- `needle`; any success or any other error is a FAIL line.
refused : String -> String -> Task Error a -> Task Error String
refused label needle task =
    Task.onError
        (\e ->
            if String.contains needle (Error.message e) then
                Task.succeed (String.concat [ label, ":rejected" ])

            else
                Task.succeed (String.concat [ label, ":FAIL-wrong-error:", Error.message e ])
        )
        (Task.map (\_ -> String.concat [ label, ":FAIL-accepted" ]) task)


-- `label:rejected` when `task` fails with the database failure `expected` in
-- its details; any success, other failure, or non-database error is a FAIL line.
refusedBy : String -> DbFailure -> Task Error a -> Task Error String
refusedBy label expected task =
    Task.onError
        (\e ->
            case e of
                Error _ info ->
                    case info.details of
                        Just (Database failure) ->
                            if failure == expected then
                                Task.succeed (String.concat [ label, ":rejected" ])

                            else
                                Task.succeed (String.concat [ label, ":FAIL-wrong-failure:", Error.message e ])

                        _ ->
                            Task.succeed (String.concat [ label, ":FAIL-not-database:", Error.message e ])
        )
        (Task.map (\_ -> String.concat [ label, ":FAIL-accepted" ]) task)


-- `refused`, also requiring that the message does not echo `forbidden`.
refusedWithout : String -> String -> String -> Task Error a -> Task Error String
refusedWithout label needle forbidden task =
    Task.onError
        (\e ->
            if String.contains forbidden (Error.message e) then
                Task.succeed (String.concat [ label, ":FAIL-echoed-rejected-text" ])

            else if String.contains needle (Error.message e) then
                Task.succeed (String.concat [ label, ":rejected" ])

            else
                Task.succeed (String.concat [ label, ":FAIL-wrong-error:", Error.message e ])
        )
        (Task.map (\_ -> String.concat [ label, ":FAIL-accepted" ]) task)


-- `label:<count>` for a task's result, or a FAIL line carrying its error.
counted : String -> Task Error Int -> Task Error String
counted label task =
    Task.onError
        (\e -> Task.succeed (String.concat [ label, ":FAIL-error:", Error.message e ]))
        (Task.map (\n -> String.concat [ label, ":", String.fromInt n ]) task)


countLine : String -> Db -> Store a -> Task Error String
countLine label conn store =
    Task.map
        (\rows -> String.concat [ label, ":", String.fromInt (List.length rows) ])
        (Store.toList conn (Store.query store))


-- Every row as its `cols` joined by `/`, ordered by every column in turn, so
-- the line is deterministic.
snapshot : String -> Db -> Store Store.Row -> List String -> Task Error String
snapshot label conn store cols =
    Task.map
        (\rows ->
            String.concat
                [ label
                , ":"
                , String.join "," (List.map (\row -> String.join "/" (List.map (\c -> cell c row) cols)) rows)
                ]
        )
        (Store.toList conn (List.foldl (\c q -> Store.orderAsc c q) (Store.query store) cols))


cell : String -> Store.Row -> String
cell name row =
    case Dict.get name row of
        Just s ->
            s

        Nothing ->
            "?"
