module Main exposing (main)
import Ipe.Io as Io
import Ipe.Task as Task
import Ipe.Secret
import Ipe.System as System

-- golden: `Secret.fromString` is the seal; `Secret.use` is the scoped consume
-- (apply a function to the plaintext, return its result); `Secret.redacted` is
-- the explicit "<redacted>" accessor. Plaintext-grep-guard (see
-- `golden_secret.rs`): the marker "sk_live_zx9K3_MARKER" appears in THIS SOURCE
-- exactly once (sealed right here) and the compiled binary's stdout is asserted
-- to contain it exactly once too (from the deliberate `Secret.use` scoped
-- println below) — proving `Secret.redacted` never echoes it. The blunt raw
-- un-parse now lives in `Ipe.Secret.Unsafe.unsafeReveal` (discloses `unsafe`);
-- the scoped `Secret.use` covers this common case off the `unsafe` axis.

secretVal =
    Secret.fromString (System.getenvOr "TEST_SECRET" "sk_live_zx9K3_MARKER")

main =
    do
        Io.println (Secret.redacted secretVal)
        Secret.use secretVal Io.println
