module Main exposing (main)

import Ipe.Io as Io
import Ipe.Task as Task
import Lib1
import Lib2
import Ipe.Db
import Ipe.Db.Unsafe
import Ipe.Dict
import Ipe.List
import Ipe.String


-- Regression: a wrapper around `Db.exec` / `Unsafe.unsafeQuery` forwards its
-- polymorphic `args : List a` parameter into the kernel — exercised
-- cross-module at both empty `[]` (the regression trigger) and non-empty
-- `List SqlValue` (the typed mixed-param path).
--
-- Expected output: "gadget,widget" (two rows, ordered by name).
main =
    Lib1.withConn
        (\conn ->
            -- (a) empty params — the regression trigger.
            Lib1.exec conn "CREATE TABLE IF NOT EXISTS items (id TEXT, name TEXT)" []
                |> Task.andThen (\_ -> Lib1.exec conn "DELETE FROM items" [])
                -- List SqlValue via Lib2 (cross-module).
                |> Task.andThen (\_ -> Lib2.insertWidget conn)
                -- List SqlValue directly from Main.
                |> Task.andThen
                    (\_ ->
                        Lib1.exec conn
                            "INSERT INTO items (id, name) VALUES (?, ?)"
                            [ SqlString "2", SqlString "gadget" ]
                    )
                -- (a) again — empty-params SELECT reading back.
                |> Task.andThen
                    (\_ -> Lib1.query conn "SELECT name FROM items ORDER BY name" [])
                |> Task.andThen
                    (\rows ->
                        Io.println
                            (String.join ","
                                (List.map (\row -> cellText "name" row) rows)
                            )
                    )
        )


-- The text of column `key` in a raw Db row: a SQL `NULL` cell reads as `NULL`,
-- a missing column as the empty string.
cellText : String -> Dict String (Maybe String) -> String
cellText key row =
    case Dict.get key row of
        Just (Just s) ->
            s

        Just Nothing ->
            "NULL"

        Nothing ->
            ""
