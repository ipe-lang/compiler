module Lib1 exposing (withConn, query, exec)

import Ipe.Db
import Ipe.Db.Location as Location exposing (Mode(..))
import Ipe.Db.Unsafe
import Ipe.Path as Path
import Ipe.Result as Result
import Ipe.Task as Task


-- Regression: a wrapper function around `Db.exec` / `Unsafe.unsafeQuery` forwards its
-- own polymorphic `args : List a` parameter straight into the kernel's params
-- position — exactly the `examples/17-ipemon` `Lib.Database` shape.
--
-- Called cross-module (from `Lib2` AND `Main`, both with a `List SqlValue`
-- `args` AND with the empty list `[]`), so `args`'s type variable is
-- exercised across module boundaries exactly like the production bug.
--
-- The fix ensured the wrapper's emitted Rust generic carries the required
-- `Into<ipe_runtime::db::SqlParam>` bound and the empty-list call site is
-- not left ambiguous (E0277 / E0283 were the pre-fix cargo failures).
query conn queryStr args =
    Unsafe.unsafeQuery conn queryStr args


exec conn queryStr args =
    Db.exec conn queryStr args
        |> Task.andThen (\_ -> Task.succeed ())


-- Open a connection, run `f conn`, then close it.
withConn f =
    Path.fromString "/tmp/ipe_db_wrapper_empty_params_165_golden.db"
        |> Result.andThen (Location.file CreateIfMissing)
        |> Task.fromResult
        |> Task.andThen (\loc -> Db.open loc)
        |> Task.andThen f
