module Main exposing (main)

-- `List.sortBy` orders by its key with Rust `PartialOrd`. A record key has no
-- ordering, so the key variable cannot pin to `{ name : String }` and the call
-- is rejected at type-check (IPE-T0001) instead of emitting a `list_sort_by`
-- call `cargo` cannot build.

import Ipe.Io as Io
import Ipe.List
import Ipe.String


type alias Doc =
    { title : String, owner : { name : String } }


docs : List Doc
docs =
    [ { title = "b", owner = { name = "y" } }, { title = "a", owner = { name = "x" } } ]


main =
    let
        _unused =
            List.sortBy (\d -> d.owner) docs
    in
    Io.println (String.fromInt 0)
