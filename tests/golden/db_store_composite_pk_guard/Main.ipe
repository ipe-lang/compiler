module Main exposing (main)

-- Composite primary keys in the `Draft` model: the declared column list is
-- parsed once into a typed key, and every illegal declaration is refused with a
-- typed `Err` that `createSql` returns — no DDL is built from it.
--
-- Pure checks (no DB connection), one line each:
--   * the refusals: an empty list, a one-column list, an invalid identifier, an
--     unknown column, a repeated column, every second-key conflict (single then
--     composite, composite then single, single then single), a one-column key
--     naming no store column, and a composite key beside a `serial` column;
--   * the raw form and the accessor forms `compositePrimaryKey2` /
--     `compositePrimaryKey3` render the exact table-level
--     `PRIMARY KEY (…)` constraint, columns in declared order, and the
--     `migrations` create entry carries the same DDL;
--   * a `unique` key column keeps its inline `UNIQUE`;
--   * a rename of a key column leaves the frozen create DDL unchanged;
--   * a single-column key stays inline.

import Ipe.Codec as Codec exposing (Codec)
import Ipe.Db.Store as Store exposing (Draft, Store)
import Ipe.Db.Store.Unsafe as StoreU
import Ipe.Error as Error exposing (Error)
import Ipe.Io as Io
import Ipe.List as List
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task exposing (Task)


type alias Membership =
    { userId : String
    , groupId : String
    , role : String
    }


blankMembership : Membership
blankMembership =
    { userId = "", groupId = "", role = "" }


membershipCodec : Codec Membership
membershipCodec =
    Codec.auto blankMembership


-- The DDL of a raw-column `memberships` draft shaped by `shape`.
rawDdl : (Draft Store.Row -> Draft Store.Row) -> Result Error String
rawDdl shape =
    case
        Store.fromColumns "memberships"
            [ Store.textColumn "user_id"
            , Store.textColumn "group_id"
            , Store.textColumn "role"
            ]
    of
        Err e ->
            Err e

        Ok draft ->
            Store.createSql (Store.public (shape draft))


-- The DDL of the typed `memberships` draft shaped by `shape`.
typedDdl : (Draft Membership -> Draft Membership) -> Result Error String
typedDdl shape =
    case Store.fromCodec "memberships" membershipCodec of
        Err e ->
            Err e

        Ok draft ->
            Store.createSql (Store.public (shape draft))


-- `label:rejected` when the DDL is an `Err` whose message contains `needle`.
refusedLine : String -> String -> Result Error String -> String
refusedLine label needle ddl =
    case ddl of
        Err e ->
            if String.contains needle (Error.message e) then
                String.concat [ label, ":rejected" ]

            else
                String.concat [ label, ":FAIL-wrong-error:", Error.message e ]

        Ok sql ->
            String.concat [ label, ":FAIL-accepted:", sql ]


-- `label:ok` when the DDL is exactly `expected`.
ddlLine : String -> String -> Result Error String -> String
ddlLine label expected ddl =
    case ddl of
        Ok sql ->
            if sql == expected then
                String.concat [ label, ":ok" ]

            else
                String.concat [ label, ":FAIL-bad-ddl:", sql ]

        Err e ->
            String.concat [ label, ":FAIL-rejected:", Error.message e ]


membershipsDdl : String
membershipsDdl =
    "CREATE TABLE IF NOT EXISTS memberships (user_id TEXT, group_id TEXT, role TEXT, PRIMARY KEY (user_id, group_id))"


-- The typed `memberships` store keyed on (user_id, group_id).
membershipStore : Result Error (Store Membership)
membershipStore =
    Result.map (\d -> Store.public (Store.compositePrimaryKey2 .userId .groupId d))
        (Store.fromCodec "memberships" membershipCodec)


-- The SQL of the `migrations` create entry (the first ledger entry).
createEntryOf : Result Error (Store a) -> Result Error String
createEntryOf built =
    case Result.andThen Store.migrations built of
        Err e ->
            Err e

        Ok entries ->
            case List.head entries of
                Just first ->
                    Ok first.sql

                Nothing ->
                    Err (Error.invalidInput "migrations produced no create entry")


-- The DDL of a raw-column `shifts` draft (with an INTEGER `slot`) shaped by `shape`.
shiftDdl : (Draft Store.Row -> Draft Store.Row) -> Result Error String
shiftDdl shape =
    case
        Store.fromColumns "shifts"
            [ Store.textColumn "site_id"
            , Store.intColumn "slot"
            , Store.textColumn "badge"
            ]
    of
        Err e ->
            Err e

        Ok draft ->
            Store.createSql (Store.public (shape draft))


main : Task Error ()
main =
    Io.println
        (String.join "\n"
            [ refusedLine "empty" "was given no columns" (rawDdl (StoreU.compositePrimaryKey []))
            , refusedLine "one-column"
                "was given the single column \"user_id\""
                (rawDdl (StoreU.compositePrimaryKey [ "user_id" ]))
            , refusedLine "invalid-identifier"
                "rejected primary-key column identifier"
                (rawDdl (StoreU.compositePrimaryKey [ "user_id", "group_id; DROP TABLE x" ]))
            , refusedLine "unknown-column"
                "\"tenant_id\" is not a column"
                (rawDdl (StoreU.compositePrimaryKey [ "user_id", "tenant_id" ]))
            , refusedLine "duplicate-column"
                "column \"user_id\" is listed twice"
                (rawDdl (StoreU.compositePrimaryKey [ "user_id", "group_id", "user_id" ]))
            , refusedLine "single-then-composite"
                "second one was declared after primary key (user_id)"
                (rawDdl (\d -> StoreU.compositePrimaryKey [ "user_id", "group_id" ] (StoreU.primaryKey "user_id" d)))
            , refusedLine "composite-then-single"
                "second one was declared after composite primary key (user_id, group_id)"
                (rawDdl (\d -> StoreU.primaryKey "role" (StoreU.compositePrimaryKey [ "user_id", "group_id" ] d)))
            , refusedLine "single-then-single"
                "second one was declared after primary key (user_id)"
                (rawDdl (\d -> StoreU.primaryKey "role" (StoreU.primaryKey "user_id" d)))
            , refusedLine "typed-single-then-composite"
                "second one was declared after primary key (user_id)"
                (typedDdl (\d -> Store.compositePrimaryKey2 .userId .groupId (Store.primaryKey .userId d)))
            , refusedLine "single-unknown-column"
                "\"tenant_id\" is not a column"
                (rawDdl (StoreU.primaryKey "tenant_id"))
            , refusedLine "composite-serial"
                "is marked serial, but the store's primary key is the composite key (site_id, slot)"
                (shiftDdl (\d -> StoreU.compositePrimaryKey [ "site_id", "slot" ] (StoreU.serial "slot" d)))
            , ddlLine "raw-composite-ddl" membershipsDdl (rawDdl (StoreU.compositePrimaryKey [ "user_id", "group_id" ]))
            , ddlLine "typed-composite2-ddl" membershipsDdl (typedDdl (\d -> Store.compositePrimaryKey2 .userId .groupId d))
            , ddlLine "typed-composite3-ddl"
                "CREATE TABLE IF NOT EXISTS memberships (user_id TEXT, group_id TEXT, role TEXT, PRIMARY KEY (user_id, group_id, role))"
                (typedDdl (\d -> Store.compositePrimaryKey3 .userId .groupId .role d))
            , ddlLine "key-order-kept"
                "CREATE TABLE IF NOT EXISTS memberships (user_id TEXT, group_id TEXT, role TEXT, PRIMARY KEY (group_id, user_id))"
                (rawDdl (StoreU.compositePrimaryKey [ "group_id", "user_id" ]))
            , ddlLine "composite-unique"
                "CREATE TABLE IF NOT EXISTS memberships (user_id TEXT UNIQUE, group_id TEXT, role TEXT, PRIMARY KEY (user_id, group_id))"
                (rawDdl (\d -> StoreU.compositePrimaryKey [ "user_id", "group_id" ] (StoreU.unique "user_id" d)))
            , ddlLine "composite-migrations" membershipsDdl (createEntryOf membershipStore)
            , ddlLine "composite-rename-key" membershipsDdl (Result.andThen Store.createSql (Result.map (Store.renameColumn "group_id" "team_id") membershipStore))
            , ddlLine "single-pk"
                "CREATE TABLE IF NOT EXISTS memberships (user_id TEXT PRIMARY KEY, group_id TEXT, role TEXT)"
                (typedDdl (\d -> Store.primaryKey .userId d))
            ]
        )
