module Main exposing (main)

import Ipe.Duration as Duration
import Ipe.Http as Http exposing (HttpMethod(..))
import Ipe.Io as Io
import Ipe.List
import Ipe.String


-- Http builder chain test: verifies that Http.defaultRequestFromString (the
-- marked parse-at-the-boundary helper) plus Http.withTimeout / Http.withHeader /
-- Http.withBody all resolve through the kernel dispatch path and produce a
-- correctly-shaped HttpRequest record. The typed target is parsed exactly once;
-- the record-update builders chain on the Ok branch.
-- withHeader PREPENDS (latest-added first) — B:2 appears before A:1.


headerStr : ( String, String ) -> String
headerStr pair =
    case pair of
        ( k, v ) -> k ++ ":" ++ v


printReq : { body : String, headers : List ( String, String ), method : Http.HttpMethod, redirects : Http.RedirectPolicy, timeout : Int, url : String } -> String
printReq req =
    String.join "\n" [ req.url, String.fromInt req.timeout, req.body, String.join "," (List.map headerStr req.headers) ]


main =
    case Http.defaultRequestFromString "http://example.com" of
        Ok req0 ->
            Io.println
                (printReq
                    (Http.withBody "hello"
                        (Http.withHeader "B" "2"
                            (Http.withHeader "A" "1"
                                (Http.withTimeout (Duration.millis 5000) req0)))))

        Err _ ->
            Io.println "blocked"
