module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- m2lex negative gate: integer division by zero through `//`. The divisor flows
-- in as a function parameter so it is opaque at the division site (a literal
-- `10 // 0` would be rejected at *compile* time by the backend's
-- unconditional-panic check; this exercises the *runtime* path instead). The
-- runtime must abort with a DivisionByZero panic (exit 101) rather than emit a
-- wrong answer.

divBy : Int -> Int
divBy d =
    10 // d

main =
    Io.println (String.fromInt (divBy 0))
