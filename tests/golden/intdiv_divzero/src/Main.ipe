module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- Integer division by zero through `//` at runtime. The divisor flows in as a
-- function parameter so it is opaque at the division site, exercising the
-- runtime operator rather than a constant fold. `x // 0` is `0`, as in Elm: the
-- program prints `0` and exits 0, never aborting.

divBy : Int -> Int
divBy d =
    10 // d

main =
    Io.println (String.fromInt (divBy 0))
