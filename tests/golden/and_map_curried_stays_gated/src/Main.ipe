module Main exposing (main)
import Ipe.Io as Io
import Ipe.Maybe
import Ipe.String

-- #90 T3 residual gate: a CURRIED (arity >= 2) payload function through
-- `andMap` stays rejected — the IR flattens curried arrows, so the first
-- `andMap` here produces `Maybe (Int -> Int)` (not a fully-applied value),
-- and a second `andMap` to finish it needs nested-closure lowering
-- (Stage 2, not implemented). Must stay a clean IPE-L0114, never a silent
-- accept that later cargo-fails.
main =
    Io.println (String.fromInt (Maybe.withDefault 0
        (Just (\a b -> a + b)
            |> Maybe.andMap (Just 1)
            |> Maybe.andMap (Just 2))))
