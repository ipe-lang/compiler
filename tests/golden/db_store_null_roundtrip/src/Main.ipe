module Main exposing (main)

-- Ipe.Db.Store NULL round-trip golden: a codec store whose record holds a
-- `Maybe String`, a `Maybe Int`, a `Maybe Float`, and a `Maybe Bool` reads SQL
-- `NULL` back as `Nothing` and a present value back as `Just`, through every
-- codec-decoded read terminal (`get`, `all`, `findBy`, `findWhere`, and the
-- query builder's `toList`).
--
-- The output lines assert, in order:
--   * a row written with every field `Nothing` reads back `Nothing` for each —
--     never `Just ""` for the text column, never a decode error for the others;
--   * a row written with `Just ""`, `Just 0`, `Just 3.0`, `Just False` reads
--     each back unchanged — the empty string and zero are values, not `NULL`
--     (an integral `REAL` and an `INTEGER` boolean cell decode to their fields);
--   * a row written with `Just "NULL"` reads back `Just "NULL"` — the text
--     `"NULL"` is a value, not an in-band `NULL` marker; its `REAL` cell outside
--     the positional range decodes exactly;
--   * `all` decodes every row with the same distinction;
--   * `findBy` and `findWhere` on the `NULL` row read `Nothing`;
--   * an ascending query on the nullable int orders the `NULL` row first, a
--     descending one last;
--   * the same table read through a codec whose `reason` is a plain `String`
--     refuses the `NULL` row with a typed `Err`, never an invented `""`.
--
-- Output:
--   get-null:n1 reason=Nothing score=Nothing ratio=Nothing flag=Nothing
--   get-empty:n2 reason=Just "" score=Just 0 ratio=Just 3 flag=Just false
--   get-null-text:n3 reason=Just "NULL" score=Just 7 ratio=Just 1.2345675e+06 flag=Just true
--   all:n1 reason=Nothing score=Nothing ratio=Nothing flag=Nothing|n2 reason=Just "" score=Just 0 ratio=Just 3 flag=Just false|n3 reason=Just "NULL" score=Just 7 ratio=Just 1.2345675e+06 flag=Just true
--   find-by:n1 reason=Nothing score=Nothing ratio=Nothing flag=Nothing
--   find-where:n1 reason=Nothing score=Nothing ratio=Nothing flag=Nothing
--   query-order:n1,n2,n3
--   query-desc:n3,n2,n1
--   strict-null:Err InvalidInput: Ipe.Db.Codec: column "reason" is NULL but its field is not a Maybe

import Ipe.Codec as Codec exposing (Codec(..), Shape(..), ColType(..))
import Ipe.Config as Config
import Ipe.Db as Db exposing (Db)
import Ipe.Db.Location as Location
import Ipe.Db.Sql as Sql
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error as Error exposing (Error)
import Ipe.Io as Io
import Ipe.Json.Encode as Encode
import Ipe.List as List
import Ipe.Maybe as Maybe exposing (Maybe(..))
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task exposing (Task)


type alias Note =
    { id : String
    , reason : Maybe String
    , score : Maybe Int
    , ratio : Maybe Float
    , flag : Maybe Bool
    }


makeNote : String -> Maybe String -> Maybe Int -> Maybe Float -> Maybe Bool -> Note
makeNote id reason score ratio flag =
    { id = id, reason = reason, score = score, ratio = ratio, flag = flag }


-- The same `notes` table read through a codec whose `reason` field is a plain
-- `String`: a `NULL` reason has no value to decode into, so the read is a typed
-- `Err` rather than an invented `""`.
type alias StrictNote =
    { id : String
    , reason : String
    }


makeStrictNote : String -> String -> StrictNote
makeStrictNote id reason =
    { id = id, reason = reason }


strictCodec : Codec StrictNote
strictCodec =
    Codec
        { enc =
            \n ->
                Encode.object
                    [ ( "id", Encode.string n.id )
                    , ( "reason", Encode.string n.reason )
                    ]
        , mkDec =
            \_ ->
                Config.map2 makeStrictNote
                    (Config.field "id" Config.string)
                    (Config.field "reason" Config.string)
        , shp =
            SRecord
                [ ( "id", CText )
                , ( "reason", CText )
                ]
        }


strictStore : Result Error (Store StrictNote)
strictStore =
    Store.fromCodec "notes" strictCodec
        |> Result.map (\draft -> Store.public (Store.primaryKey .id draft))


encodeMaybe : (a -> Value) -> Maybe a -> Value
encodeMaybe enc m =
    case m of
        Just x ->
            enc x

        Nothing ->
            Encode.null


noteCodec : Codec Note
noteCodec =
    Codec
        { enc =
            \n ->
                Encode.object
                    [ ( "id", Encode.string n.id )
                    , ( "reason", encodeMaybe Encode.string n.reason )
                    , ( "score", encodeMaybe Encode.int n.score )
                    , ( "ratio", encodeMaybe Encode.float n.ratio )
                    , ( "flag", encodeMaybe Encode.bool n.flag )
                    ]
        , mkDec =
            \_ ->
                Config.map5 makeNote
                    (Config.field "id" Config.string)
                    (Config.field "reason" (Config.nullable Config.string))
                    (Config.field "score" (Config.nullable Config.int))
                    (Config.field "ratio" (Config.nullable Config.float))
                    (Config.field "flag" (Config.nullable Config.bool))
        , shp =
            SRecord
                [ ( "id", CText )
                , ( "reason", CNull CText )
                , ( "score", CNull CInt )
                , ( "ratio", CNull CReal )
                , ( "flag", CNull CBool )
                ]
        }


noteStore : Result Error (Store Note)
noteStore =
    Store.fromCodec "notes" noteCodec
        |> Result.map (\draft -> Store.public (Store.primaryKey .id draft))


seed : List Note
seed =
    [ makeNote "n1" Nothing Nothing Nothing Nothing
    , makeNote "n2" (Just "") (Just 0) (Just 3.0) (Just False)
    , makeNote "n3" (Just "NULL") (Just 7) (Just 1234567.5) (Just True)
    ]


showReason : Maybe String -> String
showReason m =
    case m of
        Just s ->
            String.concat [ "Just \"", s, "\"" ]

        Nothing ->
            "Nothing"


showScore : Maybe Int -> String
showScore m =
    case m of
        Just n ->
            String.concat [ "Just ", String.fromInt n ]

        Nothing ->
            "Nothing"


showRatio : Maybe Float -> String
showRatio m =
    case m of
        Just f ->
            String.concat [ "Just ", String.fromFloat f ]

        Nothing ->
            "Nothing"


showFlag : Maybe Bool -> String
showFlag m =
    case m of
        Just b ->
            String.concat [ "Just ", String.fromBool b ]

        Nothing ->
            "Nothing"


showNote : Note -> String
showNote n =
    String.concat
        [ n.id
        , " reason="
        , showReason n.reason
        , " score="
        , showScore n.score
        , " ratio="
        , showRatio n.ratio
        , " flag="
        , showFlag n.flag
        ]


showMaybeNote : Maybe Note -> String
showMaybeNote m =
    case m of
        Just n ->
            showNote n

        Nothing ->
            "missing"


getLine : Db -> Store Note -> String -> String -> Task Error String
getLine conn store label id =
    Task.map
        (\m -> String.concat [ label, ":", showMaybeNote m ])
        (Store.get conn store (SqlString id))


allLine : Db -> Store Note -> Task Error String
allLine conn store =
    Task.map
        (\notes -> String.concat [ "all:", String.join "|" (List.map showNote (List.sortBy .id notes)) ])
        (Store.all conn store)


findByLine : Db -> Store Note -> Task Error String
findByLine conn store =
    Task.map
        (\notes -> String.concat [ "find-by:", String.join "|" (List.map showNote notes) ])
        (Store.findBy conn store "id" (SqlString "n1"))


findWhereLine : Db -> Store Note -> Task Error String
findWhereLine conn store =
    Task.map
        (\notes -> String.concat [ "find-where:", String.join "|" (List.map showNote notes) ])
        (Store.findWhere conn store (Sql.eq (Sql.column "id") (Sql.param (SqlString "n1"))))


queryOrderLine : Db -> Store Note -> Task Error String
queryOrderLine conn store =
    Task.map
        (\notes -> String.concat [ "query-order:", String.join "," (List.map .id notes) ])
        (Store.query store
            |> Store.orderAsc "score"
            |> Store.toList conn
        )


queryDescLine : Db -> Store Note -> Task Error String
queryDescLine conn store =
    Task.map
        (\notes -> String.concat [ "query-desc:", String.join "," (List.map .id notes) ])
        (Store.query store
            |> Store.orderDesc "score"
            |> Store.toList conn
        )


strictNullLine : Db -> Store StrictNote -> Task Error String
strictNullLine conn store =
    Task.onError
        (\e -> Task.succeed (String.concat [ "strict-null:Err ", Error.toString e ]))
        (Task.map
            (\m ->
                case m of
                    Just n ->
                        String.concat [ "strict-null:Ok reason=\"", n.reason, "\"" ]

                    Nothing ->
                        "strict-null:Ok missing"
            )
            (Store.get conn store (SqlString "n1"))
        )


insertSeed : Db -> Store Note -> Task Error ()
insertSeed conn store =
    List.foldl
        (\n acc -> Task.andThen (\_ -> Task.map (\_ -> ()) (Store.insert conn store n)) acc)
        (Task.succeed ())
        seed


report : Db -> Store Note -> Store StrictNote -> Task Error ()
report conn store strict =
    Task.andThen
        (\lines -> Io.println (String.join "\n" lines))
        (Task.sequence
            [ getLine conn store "get-null" "n1"
            , getLine conn store "get-empty" "n2"
            , getLine conn store "get-null-text" "n3"
            , allLine conn store
            , findByLine conn store
            , findWhereLine conn store
            , queryOrderLine conn store
            , queryDescLine conn store
            , strictNullLine conn strict
            ]
        )


runChecks : Db -> Store Note -> Store StrictNote -> Task Error ()
runChecks conn store strict =
    Task.andThen
        (\_ -> Task.andThen (\_ -> report conn store strict) (insertSeed conn store))
        (Store.create conn store)


main : Task Error ()
main =
    case Result.map2 (\a b -> ( a, b )) noteStore strictStore of
        Err e ->
            Io.println (Error.toString e)

        Ok ( store, strict ) ->
            Task.andThen
                (\conn -> Db.withTransaction conn (\txconn -> runChecks txconn store strict))
                (Db.open Location.memory)
