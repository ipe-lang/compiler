module Main exposing (main)

import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Io as Io


-- Phase-1a regression lock (#4): closure-shaped onInput handler.
-- The emitter must Arc-wrap the lambda so the resulting Attribute<Msg>
-- carries Arc<dyn Fn(String) -> Msg + Send + Sync + 'static>.
-- oracle_divergence = true: Go oracle does not expose Html.htmlRender.


type Msg
    = SetText String


staticHtml : String
staticHtml =
    Html.htmlRender
        (Ui.layout []
            (Ui.el
                [ Ui.onInput (\s -> SetText s) ]
                (Ui.text "input here")))


main =
    Io.println staticHtml
