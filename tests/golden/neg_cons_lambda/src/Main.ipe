module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- A cons param `\(x :: xs) ->`: `x :: xs` fails to match `[]`, so it is refutable
-- and rejected as IPE-T0015. It PARSES (as a parenthesised cons pattern), so the
-- type-phase gate — not the parser — is what closes it.
f : List Int -> Int
f = \(x :: xs) -> x

main =
    Io.println (String.fromInt (f [ 1 ]))
