module Main exposing (main)

import Ipe.Io as Io
import Ipe.String as String


-- Two non-alpha-equivalent generic record shapes that share the field-name set
-- `{q}`. `wrapOne` surfaces `{ q : a }` from its body; `firstOfPair` surfaces
-- `{ q : ( a, a ) }`. The two unify, so the backend synthesises ONE struct whose
-- template is their least general generalization (`RecQ<T1>` with `q: T1`).
wrapOne : a -> a
wrapOne value =
    let
        r =
            { q = value }
    in
    r.q


firstOfPair : a -> a
firstOfPair value =
    let
        r =
            { q = ( value, value ) }
    in
    case r.q of
        ( x, _ ) ->
            x


main : Task Error ()
main =
    Io.println (String.fromInt (wrapOne 7 + firstOfPair 3))
