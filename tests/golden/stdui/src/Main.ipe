module Main exposing (main)

import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Ui.Background as Background
import Ipe.Ui.Font as Font
import Ipe.Io as Io


-- Phase-0 Ipe.Ui smoke test: layout / column / el / text + a Background and Font
-- attribute, rendered through Ipe.Html.htmlRender.
-- oracle_divergence = true: the Rust backend emits compact inline CSS (no <style>
-- reset tag, no trailing spaces), whereas the Go backend emits a different HTML
-- skeleton with a separate <style> reset block. Both are semantically correct.


main =
    Io.println
        (Html.htmlRender
            (Ui.layout []
                (Ui.column [ Ui.spacing 8 ]
                    [ Ui.el [ Font.bold ] (Ui.text "hello")
                    , Ui.el [ Background.color (Ui.rgb 255 0 0) ] (Ui.text "world")
                    ])))
