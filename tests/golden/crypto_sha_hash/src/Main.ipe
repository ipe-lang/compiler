module Main exposing (main)
import Ipe.Io as Io
import Ipe.Crypto
import Ipe.String

-- sha256 / sha512 / sha1 / md5 of "abc" — standard known test vectors.
main =
    let
        h256 = Crypto.sha256 "abc"

        h512 = Crypto.sha512 "abc"

        h1 = Crypto.sha1 "abc"

        m = Crypto.md5 "abc"
    in
    Io.println (String.join " " [ h256, h512, h1, m ])
