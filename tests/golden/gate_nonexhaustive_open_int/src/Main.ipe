module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- Int is an OPEN type: literal arms without a wildcard / variable catch-all do
-- NOT cover every value, so this `case` is non-exhaustive (IPE-T0010).
f : Int -> Int
f n =
    case n of
        0 -> 0
        1 -> 1

main =
    Io.println (String.fromInt (f 7))
