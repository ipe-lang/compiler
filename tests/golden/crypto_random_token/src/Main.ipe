module Main exposing (main)
import Ipe.Io as Io
import Ipe.Task as Task
import Ipe.Crypto

-- Crypto.randomToken: verify the call compiles and the program exits cleanly.
-- The result is discarded; the effect runs and sequences into the final print.
main =
    Crypto.randomToken 8 |> Task.andThen (\_ -> Io.println "ok")
