module Main exposing (main)

import Ipe.Io as Io

type Wrap
    = Wrap (Maybe Int)

-- #99 RED-side control: an alias over a dispatch-NEEDING inner (`Just x`
-- needs its own discriminant check) in a by-value arm is IPE-L0128 — the
-- clone-rebuild repair is only sound for dispatch-free inners, and the
-- fail-closed gate must fire rather than let the backend double-move.
describe : Wrap -> String
describe w =
    case w of
        Wrap ((Just x) as inner) ->
            "got"

        Wrap Nothing ->
            "none"

main =
    Io.println (describe (Wrap (Just 1)))
