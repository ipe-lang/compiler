module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- A RECORD sub-pattern nested inside a constructor payload (`Box { x }`).
-- Once the IPE-L0112 nested-record-carrier gap; #158 (Class 4 item C) closed it
-- by threading the payload field's record type to the lowerer, so this now
-- ACCEPTS and prints 5.
type Box = Box { x : Int }

f : Box -> Int
f b =
    case b of
        Box { x } -> x

main =
    Io.println (String.fromInt (f (Box { x = 5 })))
