module Main exposing (main)
import Ipe.Io as Io
import Ipe.Db
import Ipe.Db.Location as Location
import Ipe.Db.Unsafe
import Ipe.Db.Decode
import Ipe.Decimal
import Ipe.List
import Ipe.String
import Ipe.Task

-- #34 golden: `Db.Decode.money` kernel wiring end-to-end.
--
-- Before this fix, `db_decode_money` (runtime/src/ipe_runtime/db.rs) was fully
-- implemented and unit-tested (`test_db_decode_money_roundtrip`), but had NO
-- `StdlibKernel` variant, NO constrain scheme, and NO lower/emit arm -- so
-- `Db.Decode.money` was rejected at canonicalisation as an unknown qualified
-- name, and the runtime function was dead code from the compiler's
-- perspective (backlog #34, spec `class7-sql-db-fix-spec-2026-07-09.md` S6).
--
-- This golden proves the full kernel-registration recipe closed the gap:
-- canon `Db.Decode` allowlist, `StdlibKernel::DbDecMoney` decl, constrain.rs
-- scheme (`String -> Decoder (Decimal, String)`), ipe_lower arity-1 dispatch,
-- ipe_backend_rust standard-path emit, ipe_ir pretty-print.
--
-- `Db.Decode.money` deliberately returns `Decoder (Decimal, String)`, not
-- `Decoder Money` -- `Money`/`Currency` are project-generated Rust types
-- unnameable from the shared runtime crate.
--
-- Row "widget": amount column = "USD 12.34" (the lossless "CODE AMOUNT" TEXT
-- `SqlMoney` writes on INSERT) -> decodes to (Decimal "12.34", "USD").
-- Row "broken": amount column = "BADFORMAT" (no space separator) -> decode
-- is a total `Err`, never a panic -- caught via `Task.onError`.
--
-- Output: "USD 12.34\nmalformed:caught"

main =
    Task.andThen
        (\conn ->
            Db.withTransaction conn
                (\txconn ->
                    do
                        Unsafe.unsafeExecRaw txconn
                            "CREATE TABLE prices (label TEXT, amount TEXT)"
                        Db.exec txconn
                            "INSERT INTO prices (label, amount) VALUES (?, ?)"
                            [ SqlString "widget", SqlMoney "USD 12.34" ]
                        Db.exec txconn
                            "INSERT INTO prices (label, amount) VALUES (?, ?)"
                            [ SqlString "broken", SqlString "BADFORMAT" ]
                        Task.andThen
                            (\okLine ->
                                Task.andThen
                                    (\badLine ->
                                        Io.println (okLine ++ "\n" ++ badLine)
                                    )
                                    (Task.onError
                                        (\_ -> Task.succeed "malformed:caught")
                                        (Task.andThen
                                            (\rows ->
                                                Task.succeed
                                                    (String.join ","
                                                        (List.map
                                                            (\( amount, code ) ->
                                                                code ++ " " ++ Decimal.toString amount
                                                            )
                                                            rows
                                                        )
                                                    )
                                            )
                                            (Db.queryDecode txconn
                                                "SELECT amount FROM prices WHERE label = ?"
                                                [ SqlString "broken" ]
                                                (Db.Decode.money "amount")
                                            )
                                        )
                                    )
                            )
                            (Task.andThen
                                (\rows ->
                                    Task.succeed
                                        (String.join ","
                                            (List.map
                                                (\( amount, code ) ->
                                                    code ++ " " ++ Decimal.toString amount
                                                )
                                                rows
                                            )
                                        )
                                )
                                (Db.queryDecode txconn
                                    "SELECT amount FROM prices WHERE label = ?"
                                    [ SqlString "widget" ]
                                    (Db.Decode.money "amount")
                                )
                            )
                )
        )
        (Db.open Location.memory)
