module Main exposing (main)

import Ipe.Io as Io
import Ipe.Db as Db
import Ipe.Db.Location as Location
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Db.Store.Unsafe as StoreU
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.Task as Task
import Ipe.Result as Result exposing (Result(..))
import Ipe.Maybe as Maybe exposing (Maybe(..))
import Ipe.Error as Error exposing (Error)


-- Ipe.Db.Store golden: derive a Store from a record's typed columns, then
-- round-trip a row (insert -> query -> decode == original) through the audited
-- Db/Sql surface. Also proves the two injection defences structurally:
--
--   1. A value containing `'; DROP TABLE` binds as a PARAMETER and is stored +
--      retrieved LITERALLY (parameterisation, not escaping).
--   2. A column identifier with a quote/semicolon/space makes `fromColumns`
--      return `Err` at build time — the injection never reaches SQL.
--
-- Output (one line per check):
--   roundtrip:ok
--   injection-value:'; DROP TABLE users; --
--   reject-bad-ident:ok


type alias User =
    { id : String
    , name : String
    , age : Int
    }


userColumns : List Store.Column
userColumns =
    [ Store.textColumn "id"
    , Store.textColumn "name"
    , Store.intColumn "age"
    ]


writeUser : User -> Store.Row
writeUser u =
    Dict.fromList
        [ ( "id", u.id )
        , ( "name", u.name )
        , ( "age", String.fromInt u.age )
        ]


readUser : Store.Row -> Result Error User
readUser row =
    Result.map3 (\i n a -> { id = i, name = n, age = a })
        (Store.readText "id" row)
        (Store.readText "name" row)
        (Store.readInt "age" row)


userStore : Result Error (Store Store.Row)
userStore =
    case Store.fromColumns "users" userColumns of
        Ok s ->
            Ok (Store.public (StoreU.primaryKey "id" s))

        Err e ->
            Err e


-- A store declared with a malformed column identifier must FAIL to build: the
-- injection attempt is rejected by `validSqlIdent` before any SQL is issued.
badStore : Result Error (Store Store.Row)
badStore =
    Store.fromColumns "users"
        [ Store.textColumn "id"
        , Store.textColumn "name\"; DROP TABLE users; --"
        , Store.intColumn "age"
        ]
        |> Result.map Store.public


rejectBadIdentLine : String
rejectBadIdentLine =
    case badStore of
        Ok _ ->
            "reject-bad-ident:FAIL-accepted"

        Err _ ->
            "reject-bad-ident:ok"


-- The adversarial payload: a value that would be SQL injection if interpolated.
-- Bound as a parameter, it is stored + read back verbatim.
attacker : User
attacker =
    { id = "u2", name = "'; DROP TABLE users; --", age = 30 }


sampleUser : User
sampleUser =
    { id = "u1", name = "alice", age = 42 }


main : Task Error ()
main =
    case userStore of
        Err e ->
            Io.println (Error.toString e)

        Ok store ->
            Task.andThen
                (\conn ->
                    Db.withTransaction conn
                        (\txconn -> runChecks txconn store)
                )
                (Db.open Location.memory)


runChecks : Db -> Store Store.Row -> Task Error ()
runChecks conn store =
    Task.andThen
        (\_ -> Task.andThen (\_ -> readBack conn store) (Store.insert conn store (writeUser attacker)))
        (Task.andThen (\_ -> Store.insert conn store (writeUser sampleUser)) (Store.create conn store))


readBack : Db -> Store Store.Row -> Task Error ()
readBack conn store =
    Task.andThen
        (\maybeRow -> report (decodeRow maybeRow))
        (Store.get conn store (SqlString "u1"))


-- Decode the fetched row through `readUser`, folding a decode failure to
-- `Nothing` so the round-trip check reports a clean miss rather than crashing.
decodeRow : Maybe Store.Row -> Maybe User
decodeRow maybeRow =
    case maybeRow of
        Just row ->
            case readUser row of
                Ok u ->
                    Just u

                Err _ ->
                    Nothing

        Nothing ->
            Nothing


report : Maybe User -> Task Error ()
report maybeUser =
    let
        roundtripLine =
            case maybeUser of
                Just u ->
                    if u.id == sampleUser.id && u.name == sampleUser.name && u.age == sampleUser.age then
                        "roundtrip:ok"

                    else
                        "roundtrip:FAIL-mismatch"

                Nothing ->
                    "roundtrip:FAIL-missing"
    in
    Io.println
        (String.join "\n"
            [ roundtripLine
            , String.concat [ "injection-value:", attacker.name ]
            , rejectBadIdentLine
            ]
        )
