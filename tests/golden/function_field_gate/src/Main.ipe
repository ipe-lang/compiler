module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- A function value reaching a record field THROUGH a type variable:
-- `wrap`'s field `value : a` instantiates to `Int -> Int` at this call,
-- so the synthesised struct would carry a `Box<dyn Fn>` field that cannot
-- derive Clone/Debug/PartialEq. The compiler must reject this (IPE-L0107),
-- never emit Rust that does not build.
wrap : a -> { value : a }
wrap x = { value = x }

unwrap : { value : a } -> a
unwrap r = r.value

main =
    let f = unwrap (wrap (\n -> n + 1)) in
    Io.println (String.fromInt (f 41))
