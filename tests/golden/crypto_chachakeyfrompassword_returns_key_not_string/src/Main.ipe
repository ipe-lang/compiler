module Main exposing (main)

import Ipe.Io as Io
import Ipe.Crypto as Crypto

-- Type-error fixture: `chachaKeyFromPassword` returns an opaque `Key`, never a
-- raw `String`.  Treating the derived key as a `String` (here printing it) must
-- be a compile error, so a derived key can only flow into a `Key`-typed sink.

main =
    Io.println (Crypto.chachaKeyFromPassword "password" "salt")
