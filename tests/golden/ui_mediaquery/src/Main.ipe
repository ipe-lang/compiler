module Main exposing (main)

import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Ui.Background as Background
import Ipe.Io as Io
import Ipe.Task as Task


-- E2E smoke test for `Ui.mediaQuery` (the 1-of-20 kernel deferred from the
-- 2026-07-10 Ipe.Ui/Html wiring batch, wired 2026-07-11 — see
-- docs/architecture/ui-mediaquery-design-2026-07-11.md). Also exercises
-- `Ui.breakpoint`, which now delegates to the same marker-emitting
-- mechanism instead of the Phase-0 passthrough stub.
-- oracle_divergence = true: ipec's own correct output, not a Go oracle diff.
-- (Plain Html.render leaves the data-ipe-mq-* markers visible; the Live /
-- Webview pipelines expand them into the ipe-id-scoped <style> block via
-- apply_style_injections — pinned by the runtime unit tests.)


mqPage : String
mqPage =
    Html.render
        (Ui.layout []
            (Ui.column []
                [ Ui.mediaQuery "(min-width: 768px)"
                    [ Background.color (Ui.rgb 18 18 24) ]
                    (Ui.text "responsive")
                , Ui.breakpoint Ui.mobile
                    [ Background.color (Ui.rgb 1 2 3) ]
                    (Ui.text "mobile-only")
                ]
            )
        )


evilPage : String
evilPage =
    Html.render
        (Ui.layout []
            (Ui.mediaQuery "(min-width: 1px) </style><script>alert(1)</script>"
                [ Background.color (Ui.rgb 4 5 6) ]
                (Ui.text "gated")
            )
        )


main =
    do
        Io.println mqPage
        Io.println evilPage
