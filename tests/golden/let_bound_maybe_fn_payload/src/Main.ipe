module Main exposing (main)
import Ipe.Io as Io
import Ipe.Maybe
import Ipe.String

-- #90 Stage 1 residual seal hole — Maybe variant of the let-bound
-- constructor-wrapped closure (see let_bound_fn_payload for the full
-- root-cause note). Exercises the SAME lambda trait-object-pin fix through the
-- runtime `IpeMaybe` enum rather than `IpeResult`. Must build+run and print 42.
applyIt : Maybe (Int -> Int) -> Int
applyIt mfn =
    Maybe.withDefault 0 (Maybe.andMap (Just 21) mfn)

main =
    let
        f = Just (\x -> x * 2)
    in
    Io.println (String.fromInt (applyIt f))
