module Main exposing (main)

import Ipe.Io as Io
import Ipe.Db as Db
import Ipe.Db.Location as Location
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Db.Store.Unsafe as StoreU
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.List as List
import Ipe.Task as Task
import Ipe.Result as Result exposing (Result(..))
import Ipe.Maybe as Maybe exposing (Maybe(..))
import Ipe.Error as Error exposing (Error)


-- Ipe.Db.Store generic-forwarder golden: cross-call auto-trait-bound propagation
-- THROUGH A LOCALLY-BOUND VALUE (a `case`-bound / `let`-bound query), not a
-- forwarded parameter.
--
-- `runFirst` is generic over the row type `a`. Its query reaches the bounded
-- `Store.toList` slot only through `q`, a value bound by the `Just q` arm of a
-- `case` over `List.head qs` — NOT a caller parameter. A propagation that keyed
-- only on parameter membership never attributed the tvar `a` to `q`, so the
-- emitted `main_run_first<T1>` dropped the `Sync` bound `Store.toList` obliges:
-- the crate then cargo-failed `E0277` (`T1 cannot be shared between threads`)
-- though `ipe` reported exit 0 — an exit-0-then-cargo-fail SEAL break, the
-- sibling of the parameter-forwarding class.
--
-- `runLet` binds the query with a `let` instead, proving the local-derived trace
-- covers both binding forms. Both forwarders must stay GENERIC
-- (`<T1: 'static + Send + Sync + Clone>`, never monomorphized) AND the emitted
-- crate must cargo-build and run.
--
-- Two output lines assert the forwarders run end-to-end (not merely build):
--   first:2
--   let:2


-- The tvar reaches `Store.toList` only through `q`, a `case`-bound value.
runFirst : Db -> List (Store.Query a) -> Task Error (List a)
runFirst conn qs =
    case List.head qs of
        Just q ->
            Store.toList conn q

        Nothing ->
            Task.succeed []


-- The same shape with a `let`-bound query rather than a `case` arm binder.
runLet : Db -> List (Store.Query a) -> Task Error (List a)
runLet conn qs =
    case List.head qs of
        Just first ->
            let
                q =
                    first
            in
            Store.toList conn q

        Nothing ->
            Task.succeed []


type alias Product =
    { id : String
    , name : String
    , qty : Int
    }


productColumns : List Store.Column
productColumns =
    [ Store.textColumn "id"
    , Store.textColumn "name"
    , Store.intColumn "qty"
    ]


productStore : Result Error (Store Store.Row)
productStore =
    case Store.fromColumns "products" productColumns of
        Ok s ->
            Ok (Store.public (StoreU.primaryKey "id" s))

        Err e ->
            Err e


writeProduct : Product -> Store.Row
writeProduct p =
    Dict.fromList
        [ ( "id", p.id )
        , ( "name", p.name )
        , ( "qty", String.fromInt p.qty )
        ]


seed : List Product
seed =
    [ { id = "p1", name = "widget", qty = 30 }
    , { id = "p2", name = "gizmo", qty = 9 }
    ]


main : Task Error ()
main =
    case productStore of
        Err e ->
            Io.println (Error.toString e)

        Ok store ->
            Task.andThen
                (\conn ->
                    Db.withTransaction conn
                        (\txconn -> runChecks txconn store)
                )
                (Db.open Location.memory)


runChecks : Db -> Store Store.Row -> Task Error ()
runChecks conn store =
    Task.andThen
        (\_ -> Task.andThen (\_ -> report conn store) (insertSeed conn store))
        (Store.create conn store)


insertSeed : Db -> Store Store.Row -> Task Error ()
insertSeed conn store =
    List.foldl
        (\p acc -> Task.andThen (\_ -> insertOne conn store p) acc)
        (Task.succeed ())
        seed


insertOne : Db -> Store Store.Row -> Product -> Task Error ()
insertOne conn store p =
    Task.map (\_ -> ()) (Store.insert conn store (writeProduct p))


report : Db -> Store Store.Row -> Task Error ()
report conn store =
    Task.andThen
        (\first ->
            Task.andThen
                (\lets ->
                    Io.println
                        (String.join "\n"
                            [ String.concat [ "first:", String.fromInt (List.length first) ]
                            , String.concat [ "let:", String.fromInt (List.length lets) ]
                            ]
                        )
                )
                (runLet conn [ Store.query store ])
        )
        (runFirst conn [ Store.query store ])
