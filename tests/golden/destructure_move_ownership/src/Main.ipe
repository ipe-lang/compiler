module Main exposing (main)

import Ipe.Io as Io
import Ipe.String


-- #224 SEAL breach: a `let (a, b) = pair` destructure binder used to emit a
-- bare `Destructure` with NO move-ownership discipline on its bound component
-- symbols. `a` is a CloneOk `String` read TWICE by value in the body, so the
-- first read must `.clone()` — otherwise the emitted
-- `string_append(a, string_append(a, b))` moves `a` twice → cargo E0382
-- (use of moved value) after ipec exit 0. Destructure was the ONE binder kind
-- the per-binder-kind clone machinery never covered; routing it through the
-- shared `apply_move_ownership` entry point closes the class.
combine : ( String, String ) -> String
combine pair =
    let
        ( a, b ) =
            pair
    in
    String.append a (String.append a b)


main : Task Error ()
main =
    Io.println (combine ( "x", "y" ))
