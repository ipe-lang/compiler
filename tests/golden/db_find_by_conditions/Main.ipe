module Main exposing (main)
import Ipe.Io as Io
import Ipe.Db
import Ipe.Db.Location as Location
import Ipe.Db.Unsafe
import Ipe.Dict
import Ipe.List
import Ipe.Maybe
import Ipe.String
import Ipe.Task

-- M5b-db golden: Db.findByConditions with a Dict String String conditions map.
-- Inserts two rows then queries with {"name": "apple"} — only the apple row
-- should be returned.  Proves Dict String String (not List (String, SqlValue))
-- is the correct arg type and that the DbFindByConditions emit arm works.
--
-- Uses sqlite::memory: inside withTransaction so all ops share one connection.

main =
    Task.andThen
        (\conn ->
            Db.withTransaction conn
                (\txconn ->
                    do
                        Unsafe.unsafeExecRaw txconn
                            "CREATE TABLE items (name TEXT NOT NULL, score INTEGER NOT NULL)"
                        Db.exec txconn
                            "INSERT INTO items (name, score) VALUES (?, ?)"
                            [ SqlString "apple", SqlInt 5 ]
                        Db.exec txconn
                            "INSERT INTO items (name, score) VALUES (?, ?)"
                            [ SqlString "banana", SqlInt 3 ]
                        Task.andThen
                            (\rows ->
                                let
                                    row =
                                        Maybe.withDefault Dict.empty (List.head rows)

                                    name =
                                        Unsafe.unsafeGetString "name" row

                                    score =
                                        Unsafe.unsafeGetInt "score" row
                                in
                                Io.println (name ++ ":" ++ String.fromInt score)
                            )
                            (Db.findByConditions txconn "items" (Dict.fromList [ ( "name", "apple" ) ]))
                )
        )
        (Db.open Location.memory)
