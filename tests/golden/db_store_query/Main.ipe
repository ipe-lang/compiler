module Main exposing (main)

import Ipe.Io as Io
import Ipe.Db as Db
import Ipe.Db.Location as Location
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Db.Store.Unsafe as StoreU
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.List as List
import Ipe.Task as Task
import Ipe.Result as Result exposing (Result(..))
import Ipe.Maybe as Maybe exposing (Maybe(..))
import Ipe.Error as Error exposing (Error)


-- Ipe.Db.Store query-builder golden: build a raw-column store, then exercise
-- the typed query builder (`where` / `orderDesc` / `limit` lowering a `Cond` to
-- an audited `SqlFragment`), `findBy`, `update`, and `count`, plus the two
-- fail-closed defences:
--
--   * an ORDER BY on the `qty` INTEGER column sorts NUMERICALLY (30 before 9),
--     not lexicographically ("9" before "30") — the store's column type drives
--     the compare;
--   * a query referencing a column the store does not derive is a typed `Err`
--     with NO SQL issued (parse-don't-validate against the store's own columns);
--   * a value containing `'; DROP TABLE` binds as a parameter through the query
--     builder, stored + retrieved LITERALLY.
--
-- Output (one line per check):
--   order-limit:widget:30,gizmo:9
--   find-by:sprocket:5
--   update:gizmo:99
--   count-gt:2
--   reject-bad-column:ok
--   injection-value:'; DROP TABLE products; --


type alias Product =
    { id : String
    , name : String
    , qty : Int
    }


productColumns : List Store.Column
productColumns =
    [ Store.textColumn "id"
    , Store.textColumn "name"
    , Store.intColumn "qty"
    ]


writeProduct : Product -> Store.Row
writeProduct p =
    Dict.fromList
        [ ( "id", p.id )
        , ( "name", p.name )
        , ( "qty", String.fromInt p.qty )
        ]


rowLabel : Store.Row -> String
rowLabel row =
    String.concat
        [ cell "name" row, ":", cell "qty" row ]


cell : String -> Store.Row -> String
cell name row =
    case Dict.get name row of
        Just s ->
            s

        Nothing ->
            "?"


productStore : Result Error (Store Store.Row)
productStore =
    case Store.fromColumns "products" productColumns of
        Ok s ->
            Ok (Store.public (StoreU.primaryKey "id" s))

        Err e ->
            Err e


seed : List Product
seed =
    [ { id = "p1", name = "widget", qty = 30 }
    , { id = "p2", name = "gizmo", qty = 9 }
    , { id = "p3", name = "sprocket", qty = 5 }
    , { id = "p4", name = "'; DROP TABLE products; --", qty = 1 }
    ]


main : Task Error ()
main =
    case productStore of
        Err e ->
            Io.println (Error.toString e)

        Ok store ->
            Task.andThen
                (\conn ->
                    Db.withTransaction conn
                        (\txconn -> runChecks txconn store)
                )
                (Db.open Location.memory)


runChecks : Db -> Store Store.Row -> Task Error ()
runChecks conn store =
    Task.andThen
        (\_ -> Task.andThen (\_ -> report conn store) (insertSeed conn store))
        (Store.create conn store)


insertSeed : Db -> Store Store.Row -> Task Error ()
insertSeed conn store =
    List.foldl
        (\p acc -> Task.andThen (\_ -> insertOne conn store p) acc)
        (Task.succeed ())
        seed


insertOne : Db -> Store Store.Row -> Product -> Task Error ()
insertOne conn store p =
    Task.map (\_ -> ()) (Store.insert conn store (writeProduct p))


-- The query under test: qty > 4, ordered by qty descending, top two rows. The
-- numeric ordering is the load-bearing check — "widget" (30) must precede
-- "gizmo" (9), which a lexicographic string sort would reverse.
orderLimitQuery : Db -> Store Store.Row -> Task Error String
orderLimitQuery conn store =
    Task.map
        (\rows -> String.join "," (List.map rowLabel rows))
        (Store.query store
            |> Store.where (StoreU.gt "qty" (SqlInt 4))
            |> Store.orderDesc "qty"
            |> Store.limit 2
            |> Store.toList conn
        )


findByCheck : Db -> Store Store.Row -> Task Error String
findByCheck conn store =
    Task.map
        (\rows -> String.join "," (List.map rowLabel rows))
        (Store.findBy conn store "name" (SqlString "sprocket"))


-- Update the "gizmo" row's qty to 99 through `update` (whole-record, by pk),
-- then read it back by primary key to prove the write landed.
updateCheck : Db -> Store Store.Row -> Task Error String
updateCheck conn store =
    Task.andThen
        (\_ -> Task.map renderMaybeRow (Store.get conn store (SqlString "p2")))
        (Store.update conn store (writeProduct { id = "p2", name = "gizmo", qty = 99 }))


renderMaybeRow : Maybe Store.Row -> String
renderMaybeRow maybeRow =
    case maybeRow of
        Just row ->
            rowLabel row

        Nothing ->
            "missing"


countCheck : Db -> Store Store.Row -> Task Error Int
countCheck conn store =
    Store.query store
        |> Store.where (StoreU.gt "qty" (SqlInt 8))
        |> Store.count conn


-- A query naming a column the store does not derive must be a total `Err`,
-- issuing NO SQL. `Task.onError` turns that fail-closed error into the "ok" line.
rejectBadColumn : Db -> Store Store.Row -> Task Error String
rejectBadColumn conn store =
    Task.onError
        (\_ -> Task.succeed "reject-bad-column:ok")
        (Task.map
            (\_ -> "reject-bad-column:FAIL-accepted")
            (Store.query store
                |> Store.where (StoreU.eq "no_such_column" (SqlInt 1))
                |> Store.toList conn
            )
        )


report : Db -> Store Store.Row -> Task Error ()
report conn store =
    Task.andThen
        (\orderLimit ->
            Task.andThen
                (\findBy ->
                    Task.andThen
                        (\updated ->
                            Task.andThen
                                (\n ->
                                    Task.andThen
                                        (\rejected -> printLines orderLimit findBy updated n rejected)
                                        (rejectBadColumn conn store)
                                )
                                (countCheck conn store)
                        )
                        (updateCheck conn store)
                )
                (findByCheck conn store)
        )
        (orderLimitQuery conn store)


printLines : String -> String -> String -> Int -> String -> Task Error ()
printLines orderLimit findBy updated n rejected =
    Io.println
        (String.join "\n"
            [ String.concat [ "order-limit:", orderLimit ]
            , String.concat [ "find-by:", findBy ]
            , String.concat [ "update:", updated ]
            , String.concat [ "count-gt:", String.fromInt n ]
            , rejected
            , String.concat [ "injection-value:", productName4 ]
            ]
        )


productName4 : String
productName4 =
    "'; DROP TABLE products; --"
