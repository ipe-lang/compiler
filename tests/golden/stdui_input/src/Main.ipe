module Main exposing (main)

import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Io as Io


-- stdui_input seal — Ui.input + Ui.describe + desc* constructors.
-- Asserts: ipec-0 ∧ cargo-0.


view : String
view =
    Html.htmlRender
        (Ui.layout []
            (Ui.column []
                [ -- Ui.input creates a real <input> void element.
                  Ui.input [ Ui.htmlAttribute "type" "text", Ui.htmlAttribute "placeholder" "Search…" ]
                , -- Ui.describe + nullary desc* constructors.
                  Ui.el [ Ui.describe (Ui.descMain) ] (Ui.text "main content")
                , Ui.el [ Ui.describe (Ui.descNavigation) ] (Ui.text "nav")
                , Ui.el [ Ui.describe (Ui.descContentInfo) ] (Ui.text "footer")
                , Ui.el [ Ui.describe (Ui.descComplementary) ] (Ui.text "aside")
                , Ui.el [ Ui.describe (Ui.descLivePolite) ] (Ui.text "status")
                , Ui.el [ Ui.describe (Ui.descLiveAssertive) ] (Ui.text "alert")
                , -- Ui.descHeading / Ui.descLabel — arity-1 constructors.
                  Ui.el [ Ui.describe (Ui.descHeading 1) ] (Ui.text "h1")
                , Ui.el [ Ui.describe (Ui.descLabel "search-field") ] (Ui.text "label")
                ]))


main =
    Io.println view
