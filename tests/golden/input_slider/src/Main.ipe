module Main exposing (main)

import Ipe.Html as Html
import Ipe.Ui as Ui
import Ipe.Ui.Input as Input
import Ipe.Io as Io
import Ipe.String


-- i148 regression: Input.slider must type-check and lower without IPE-N0005.
-- The cfg record carries onChange/value/min/max/step/label.

type Msg
    = VolumeChanged String


view : Int -> String
view vol =
    Html.htmlRender
        (Ui.layout []
            (Input.slider []
                { onChange = VolumeChanged
                , value = String.fromInt vol
                , min = "0"
                , max = "100"
                , step = "1"
                , label = Input.labelHidden "Volume"
                }))


main =
    Io.println (view 42)
