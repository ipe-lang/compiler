module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- Correct, bounded, NON-tail recursion ~1000 deep: the pending `n +` after the
-- recursive call keeps it out of tail position, so the tail-call rewrite leaves
-- it as genuine stack recursion. It runs well under the depth budget and returns
-- the right value byte-identically — the recursion guard is invisible to working
-- programs and never false-trips on legitimate deep recursion.
sumTo : Int -> Int
sumTo n =
    if n == 0 then
        0
    else
        n + sumTo (n - 1)

main =
    Io.println (String.fromInt (sumTo 1000))
