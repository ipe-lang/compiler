module Main exposing (main)

import Ipe.Task as Task
import Ipe.Log as Log
import Ipe.Secret
import Ipe.System as System

-- Logging a `Secret`: `Log.infoWith`'s attributes are interpolable scalars
-- only, so a bare `Secret` is refused at type-check (IPE-T0014) and the only
-- way to mention one in a log line is its explicit `Secret.redacted` render.
-- Plaintext-grep-guard: the marker "sk_live_LOGGED_SECRET_MARKER" must NEVER
-- appear in this program's stdout (see `golden_secret.rs`).

main : Task Error ()
main =
    Log.infoWith "boot"
        [ Secret.redacted (Secret.fromString (System.getenvOr "LOG_SECRET" "sk_live_LOGGED_SECRET_MARKER")) ]
