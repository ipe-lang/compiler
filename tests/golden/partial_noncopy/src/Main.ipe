module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- F3 (#121 seal). `mk s` is a PARTIAL APPLICATION of a non-`Copy` var.
-- `s : String` is CloneOk.  T4 rewrites the supplied `Var(s)` in the
-- eta-lambda's captured arg list to `CloneVar(s)` so the closure is `Fn`
-- (re-callable), not `FnOnce` (moves `s` on first call → E0525).
--
-- The partial `f` is called TWICE (`r1`, `r2`) to verify the lambda is
-- genuinely re-callable after the fix.


mk : String -> String -> String
mk a b =
    String.append a b


main =
    let s = String.append "he" "llo" in
    let f = mk s in
    let r1 = f "!" in
    let r2 = f "?" in
    Io.println (r1 ++ " " ++ r2)
