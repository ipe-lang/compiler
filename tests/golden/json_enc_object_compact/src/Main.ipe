module Main exposing (main)
import Ipe.Io as Io
import Ipe.Json.Encode

-- Nested object: { name, age, tags:[...] } encoded at indent=0 (compact).
-- Keys are emitted in the list order given to `object`: name, age, tags.
main =
    let
        v =
            JsonEnc.object
                [ ( "name", JsonEnc.string "Alice" )
                , ( "age", JsonEnc.int 30 )
                , ( "tags", JsonEnc.list JsonEnc.string [ "go", "rust" ] )
                ]
    in
    Io.println (JsonEnc.encode 0 v)
