module Main exposing (main)

-- End-to-end proof of the framework-injected row-security path: an authenticated
-- HTTP route mints a `Principal` (the sole minter is the fail-closed auth
-- middleware), and the handler reads a secured store as that caller through
-- `Store.allAs`. The policy's owner filter compiles to a BOUND-PARAM `WHERE`
-- (`Sql.column` for the validated column, `Sql.param` for the subject) — never
-- string interpolation — so the database never returns an out-of-policy row.
--
-- No live database or network is needed: `Task.onError` catches the connection
-- failure and the route builder is only assembled, never served. The SEAL proof
-- is that the emitted crate `cargo build`s under `IPE_E2E=1` — `ipe` accepting
-- this program (exit 0) must imply a buildable emitted crate.

import Ipe.Auth as Auth
import Ipe.Codec as Codec exposing (Codec(..), Shape(..), ColType(..))
import Ipe.Db as Db exposing (Db)
import Ipe.Db.Store as Store exposing (Store, Secured)
import Ipe.Error exposing (Error)
import Ipe.Json.Decode as Decode
import Ipe.Json.Encode as Encode
import Ipe.Maybe as Maybe exposing (Maybe(..))
import Ipe.Http.Server as Server
import Ipe.Http.Server exposing (Request, Response)
import Ipe.Io as Io
import Ipe.List as List
import Ipe.Secret as Secret
import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task exposing (Task)


type alias Doc =
    { author : String
    , body : String
    }


blankDoc : Doc
blankDoc =
    { author = "", body = "" }


-- A `Codec.auto`-derived codec: its columns are `author` / `body`, so the
-- `ownerColumn .author` policy names a real column.
docCodec : Codec Doc
docCodec =
    Codec.auto blankDoc


-- The row-security policy: each row is owned by its `.author`, which the framework
-- binds to the authenticated subject.
docPolicy : Store.Policy Doc
docPolicy =
    Store.ownerColumn .author


-- Build the secured store once, failing closed if the policy names a column the
-- store does not have.
securedDocs : Result Error (Secured Doc)
securedDocs =
    case Store.fromCodec "docs" docCodec of
        Err e ->
            Err e

        Ok store ->
            Store.secured docPolicy store


-- A `Share` row: which member may see which document. `Codec.auto` columns are
-- `doc_ref` / `member`.
type alias Share =
    { docRef : String
    , member : String
    }


blankShare : Share
blankShare =
    { docRef = "", member = "" }


shareCodec : Codec Share
shareCodec =
    Codec.auto blankShare


-- The share store's OWN policy: a member sees only their own share rows. This
-- composes into every `existsIn` subquery over the share store (defence in
-- depth), so a doc is admitted only when the caller has a share row FOR it.
sharePolicy : Store.Policy Share
sharePolicy =
    Store.ownerColumn .member


securedShares : Result Error (Secured Share)
securedShares =
    case Store.fromCodec "shares" shareCodec of
        Err e ->
            Err e

        Ok store ->
            Store.secured sharePolicy store


-- The correlated-subquery policy over `docs`: a doc is readable when a share row
-- exists whose `docRef` equals the doc's `author` (the correlation) AND which the
-- share store's own policy admits for the caller. Lowers to
-- `EXISTS (SELECT 1 FROM shares WHERE shares.doc_ref = docs.author AND …)`.
sharedDocsPolicy : Secured Share -> Store.Policy Doc
sharedDocsPolicy securedShare =
    Store.readOnly
        (Store.existsIn securedShare
            (\share doc -> Store.correlate share.docRef doc.author)
        )


securedSharedDocs : Result Error (Secured Doc)
securedSharedDocs =
    case ( Store.fromCodec "docs" docCodec, securedShares ) of
        ( Ok store, Ok securedShare ) ->
            Store.secured (sharedDocsPolicy securedShare) store

        ( Err e, _ ) ->
            Err e

        ( _, Err e ) ->
            Err e


-- The authed handler for the correlated-subquery read: `allAs` over the secured
-- store whose read policy is `existsIn securedShares …`. Emits the `EXISTS`
-- subquery WHERE; the SEAL is that this `cargo build`s under `IPE_E2E=1`.
handleSharedDocs : Request -> Auth.Principal -> Task Error Response
handleSharedDocs req principal =
    Task.onError
        (\_ -> Task.succeed (Server.text "none"))
        (Task.andThen
            (\db ->
                case securedSharedDocs of
                    Err _ ->
                        Task.succeed (Server.text "policy-error")

                    Ok secured ->
                        Task.andThen
                            (\docs ->
                                Task.succeed
                                    (Server.text (String.join "\n" (List.map .body docs)))
                            )
                            (Store.allAs principal db secured)
            )
            (Db.connect ())
        )


-- The authed handler. The middleware has already verified the token and minted
-- `principal`; `allAs` reads only the rows the policy admits for that caller.
handleMyDocs : Request -> Auth.Principal -> Task Error Response
handleMyDocs req principal =
    Task.onError
        (\_ -> Task.succeed (Server.text "none"))
        (Task.andThen
            (\db ->
                case securedDocs of
                    Err _ ->
                        Task.succeed (Server.text "policy-error")

                    Ok secured ->
                        Task.andThen
                            (\docs ->
                                Task.succeed
                                    (Server.text
                                        (String.join
                                            "\n"
                                            (List.map .body docs)
                                        )
                                    )
                            )
                            (Store.allAs principal db secured)
            )
            (Db.connect ())
        )


-- ── Column-masking read path ───────────────────────────────────────────────
--
-- A `MaskDoc` has an `owner` and a DB-optional `ssn` (a `Maybe String`, decoded
-- through a nullable column so a masked-out cell reads back as `Nothing`). The
-- policy is owner-scoped AND masks the nullable `ssn` so it is projected only for
-- an authorized row: `allAs` routes through `Db.findWhereMasked`, emitting an
-- explicit `SELECT owner, CASE WHEN (…) THEN ssn ELSE NULL END AS ssn` and
-- decoding each row (NULL-preserving) through the store's codec. The SEAL is that
-- this `cargo build`s under `IPE_E2E=1`.
type alias MaskDoc =
    { owner : String
    , ssn : Maybe String
    }


-- A hand-assembled codec pinning `ssn` to a nullable (`CNull CText`) column, so
-- the mask on `.ssn` passes `secured`'s nullability SEAL and an unauthorized row
-- decodes `ssn` to `Nothing`.
maskCodec : Codec MaskDoc
maskCodec =
    Codec
        { enc =
            \d ->
                Encode.object
                    [ ( "owner", Encode.string d.owner )
                    , ( "ssn", encodeMaybeString d.ssn )
                    ]
        , mkDec =
            \_ ->
                Decode.map2 (\o s -> { owner = o, ssn = s })
                    (Decode.field "owner" Decode.string)
                    (Decode.field "ssn" (Decode.nullable Decode.string))
        , shp = SRecord [ ( "owner", CText ), ( "ssn", CNull CText ) ]
        }


encodeMaybeString : Maybe String -> Encode.Value
encodeMaybeString m =
    case m of
        Just s ->
            Encode.string s

        Nothing ->
            Encode.null


-- Owner-scoped, with `ssn` masked to admins: an owner reads their rows, but the
-- `ssn` value is projected only when the caller's `owner` is `"admin"` — every
-- other row yields `Nothing` for `ssn`.
maskPolicy : Store.Policy MaskDoc
maskPolicy =
    Store.ownerColumn .owner
        |> Store.andPolicy
            (Store.readOnly Store.always
                |> Store.mask .ssn (Store.matchWhere (Store.eq .owner "admin"))
            )


securedMaskDocs : Result Error (Secured MaskDoc)
securedMaskDocs =
    case Store.fromCodec "mask_docs" maskCodec of
        Err e ->
            Err e

        Ok store ->
            Store.secured maskPolicy store


-- The authed handler for the masked read: `allAs` over the masked secured store.
-- Emits the `db_find_where_masked` projected read; the SEAL is that this
-- `cargo build`s under `IPE_E2E=1`.
handleMaskDocs : Request -> Auth.Principal -> Task Error Response
handleMaskDocs req principal =
    Task.onError
        (\_ -> Task.succeed (Server.text "none"))
        (Task.andThen
            (\db ->
                case securedMaskDocs of
                    Err _ ->
                        Task.succeed (Server.text "policy-error")

                    Ok secured ->
                        Task.andThen
                            (\docs ->
                                Task.succeed
                                    (Server.text
                                        (String.join "\n" (List.map (\d -> Maybe.withDefault "•" d.ssn) docs))
                                    )
                            )
                            (Store.allAs principal db secured)
            )
            (Db.connect ())
        )


authCfg : Server.AuthConfig
authCfg =
    Server.authConfig
        (Secret.fromString (System.getenvOr "SIGNING_KEY" "this-is-a-32-byte-or-longer-secret-key-value"))
        Server.bearerToken


main : Task Error ()
main =
    Task.onError
        (\_ -> Io.println "authed-store-query-seal")
        (Task.andThen
            (\_ -> Io.println "authed-store-query-seal")
            (Server.listen
                8000
                [ Server.getAuthed "/my/docs" authCfg handleMyDocs
                , Server.getAuthed "/shared/docs" authCfg handleSharedDocs
                , Server.getAuthed "/mask/docs" authCfg handleMaskDocs
                ]
            )
        )
