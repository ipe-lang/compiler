module Main exposing (main)

-- Closed-ADT refusal: `Log.level` takes the closed `LogLevel` type, not a bare
-- `Int`. `Log.level 5` does NOT type-check (IPE-T0001, expected `LogLevel`). The
-- only `LogLevel` values are the constructors `Level.debug` / `Level.info` /
-- `Level.warn` / `Level.error` (a separate qualifier from the `Log.*` logging
-- kernels).

import Ipe.Tea.Web as Web
import Ipe.Ui as Ui
import Ipe.Tea.Web.Cmd
import Ipe.String
import Ipe.Tea.Web.Sub
import Ipe.Log as Log


type Page
    = CounterPage


type Msg
    = Increment


type alias Model =
    { page : Page
    , count : Int
    }


init : WebReq -> ( Model, Cmd Msg )
init _req =
    ( { page = CounterPage, count = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )


view : Model -> Element Msg
view model =
    Ui.text (String.fromInt model.count)


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.none


main =
    Web.appWith
        [ Log.level 5 ]
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = [ Web.route "/" CounterPage ]
        , notFound = CounterPage
        }
