module Main exposing (main)

import Ipe.Task as Task
import Ipe.Html as Html
import Ipe.Ui as Ui exposing (Element)
import Ipe.Io as Io


-- BACKLOG #172 regression, shape (3): a promoted Arc-root handler and a SIBLING
-- read of a SEPARATE `let`-bound lambda (`Expr::Var` of a box-typed binding)
-- unified at ONE Rust type slot inside an `if`.
--
-- `handler` flows DIRECTLY into `Ui.onSubmit` → promoted to `SharedLambda`
-- (`Arc`). `alt` is a SECOND `let`-bound lambda that does NOT flow into a
-- sync-capture kernel, so it stays a plain `Box<dyn Fn + Send + Sync>` local.
-- The `else` branch reads `alt` — a bare `Expr::Var` at the group's type slot.
-- `Arc` (then) vs `Box` (else) → cargo `E0308` AFTER `ipec` exit 0. Fix: the
-- `Var(alt)` leaf is eta-expanded to `SharedLambda` (`Arc::new(move |x| (alt
-- .clone())(x))`), unifying with the promoted branch.


type alias SignInForm =
    { email : String
    , password : String
    }


type Msg
    = DoSignIn SignInForm
    | Noop


loginForm : Bool -> Element Msg
loginForm flag =
    let
        handler =
            \form -> DoSignIn form

        alt =
            \form -> Noop
    in
    Ui.form
        [ Ui.onSubmit (if flag then handler else alt) ]
        [ Ui.text "sign in" ]


main : Task Error ()
main =
    Io.println (Html.render (Ui.layout [] (loginForm True)))
