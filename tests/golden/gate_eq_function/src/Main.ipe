module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- `eq2` constrains `a` to Equatable (its body compares with `==`). A function is
-- the one shape `==` cannot handle — Rust derives `PartialEq` for primitives,
-- tuples, records, and enums, but never for a function. Instantiating `eq2` at a
-- function type is rejected here (IPE-T0014) rather than emitting Rust that
-- cargo cannot build.
eq2 : a -> a -> Bool
eq2 p q = p == q

apply : (Int -> Int) -> Int -> Int
apply f x = f x

main =
    let bad = eq2 apply apply
        n = if bad then 1 else 0
    in
    Io.println (String.fromInt n)
