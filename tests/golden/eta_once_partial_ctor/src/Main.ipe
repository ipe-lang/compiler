module Main exposing (main)

import Ipe.Io as Io
import Ipe.List as List
import Ipe.String
import Ipe.Task as Task


type Step
    = Step (Task Error Int -> Task Error Int) Int


-- Refused (IPE-L0126): the partial constructor `Step (Task.andThen (\x -> h x))`
-- is rebuilt as a closure whose field moves the destructure-bound `h`, and
-- `List.map` may call that closure more than once.
run : ( Int -> Task Error Int, Int ) -> List Int -> List Step
run ( h, _ ) ns =
    List.map (Step (Task.andThen (\x -> h x))) ns


inc : Int -> Task Error Int
inc n =
    Task.succeed (n + 1)


main : Task Error ()
main =
    Io.println (String.fromInt (List.length (run ( inc, 0 ) [ 1, 2 ])))
