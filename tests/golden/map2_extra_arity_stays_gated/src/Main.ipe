module Main exposing (main)

import Ipe.Io as Io
import Ipe.Maybe
import Ipe.String

-- #90 T3 (5th attempt): `Maybe.map2` with an arity-3 callback — the
-- runtime kernel applies exactly TWO arguments; the residual arrow on the
-- final result var is the same flattening hazard. (An exact-arity-2
-- callback stays accepted — see the green twin.)
add3 : Int -> Int -> Int -> Int
add3 a b c =
    a + b + c

main =
    case Maybe.map2 add3 (Just 1) (Just 2) of
        Just g -> Io.println (String.fromInt (g 3))
        Nothing -> Io.println "none"
