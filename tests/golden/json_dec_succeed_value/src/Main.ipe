module Main exposing (main)
import Ipe.Io as Io
import Ipe.Json.Decode
import Ipe.String

-- R3: plain value `JsonDec.succeed 42`.
-- Exercises Fix A case 3 (factory-wrap for plain value).
-- Expected: 42

main =
    let
        r1 =
            JsonDec.decodeString
                (JsonDec.succeed 42)
                "{}"
    in
    case r1 of
        Ok n -> Io.println (String.fromInt n)
        Err _ -> Io.println "err1"
