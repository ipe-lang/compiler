module Main exposing (main)

import Ipe.Io as Io
import Ipe.String


-- NEGATIVE: `++` on Int should fail with IPE-T0014 (Appendable obligation
-- unsatisfied) — Int is neither String nor List _. This must be rejected at
-- ipec type-check, never reaching the backend.
v : Int
v =
    1 ++ 2


main =
    Io.println (String.fromInt v)
