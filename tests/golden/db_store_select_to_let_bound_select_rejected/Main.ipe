module Main exposing (main)

-- NEGATIVE golden: a `Select` bound to a name and piped into
-- `Store.selectToList`, and a `Select` taken as a parameter. The pipe
-- collapses to the direct call, whose `Select` argument is a name, not a
-- `Store.select` expression: its projected column types are hidden, so no
-- per-row decode can be emitted. Both are rejected with IPE-L0149
-- (`SelectArgNotProjection`).


import Ipe.Codec as Codec exposing (Codec)
import Ipe.Db as Db exposing (Db)
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error exposing (Error)
import Ipe.Io as Io
import Ipe.List as List
import Ipe.Maybe exposing (Maybe(..))
import Ipe.Result as Result exposing (Result(..))
import Ipe.Task as Task exposing (Task)


type alias Book =
    { id : String
    , title : String
    , authorId : String
    }


type alias Author =
    { id : String
    , name : String
    }


blankBook : Book
blankBook =
    { id = "", title = "", authorId = "" }


blankAuthor : Author
blankAuthor =
    { id = "", name = "" }


bookCodec : Codec Book
bookCodec =
    Codec.auto blankBook


authorCodec : Codec Author
authorCodec =
    Codec.auto blankAuthor


booksStore : Result Error (Store Book)
booksStore =
    Store.fromCodec "books" bookCodec
        |> Result.map (\s -> Store.public (Store.primaryKey .id s))


authorsStore : Result Error (Store Author)
authorsStore =
    Store.fromCodec "authors" authorCodec
        |> Result.map (\s -> Store.public (Store.primaryKey .id s))


badRead : Db -> Store Book -> Store Author -> Task Error (List String)
badRead db books authors =
    let
        names =
            Store.select (\( _, author ) -> author.name)
                (Store.join books .authorId authors .id)
    in
    names |> Store.selectToList db


readSelect : Db -> Store.Select String -> Task Error (List String)
readSelect db sel =
    Store.selectToList db sel


run : Db -> Task Error ()
run db =
    case booksStore of
        Ok books ->
            case authorsStore of
                Ok authors ->
                    Task.map (\_ -> ()) (badRead db books authors)

                Err e ->
                    Task.fail e

        Err e ->
            Task.fail e


main : Task Error ()
main =
    Task.andThen
        (\_ -> Io.println "unreachable")
        (Task.onError
            (\_ -> Task.succeed ())
            (Task.andThen run (Db.connect ()))
        )
