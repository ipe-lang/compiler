module Main exposing (main)

import Ipe.Io as Io
import Ipe.Result
import Ipe.String

-- #90 T3 (5th attempt): the hazard reaches the ERROR channel too —
-- `Result.mapError`'s callback result `f` must not be an arrow.
mk : Int -> Int -> Int
mk a b =
    a + b

main =
    case Result.mapError mk (Err 1) of
        Ok _ -> Io.println "ok"
        Err g -> Io.println (String.fromInt (g 2))
