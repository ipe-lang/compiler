module Main exposing (main)

-- Closed-ADT refusal (security): `Web.csrf` takes the closed `CsrfMode` type,
-- not a bare `Int`. `Web.csrf 99` does NOT type-check (IPE-T0001, expected
-- `CsrfMode`). `CsrfMode` has only `Web.strict` and an inherit default — no
-- disabling variant — so a setting cannot express turning CSRF off, and an
-- out-of-range tag is a compile-time type error.

import Ipe.Tea.Web as Web
import Ipe.Ui as Ui
import Ipe.Tea.Web.Cmd
import Ipe.String
import Ipe.Tea.Web.Sub


type Page
    = CounterPage


type Msg
    = Increment


type alias Model =
    { page : Page
    , count : Int
    }


init : WebReq -> ( Model, Cmd Msg )
init _req =
    ( { page = CounterPage, count = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )


view : Model -> Element Msg
view model =
    Ui.text (String.fromInt model.count)


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.none


main =
    Web.appWith
        [ Web.csrf 99 ]
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = [ Web.route "/" CounterPage ]
        , notFound = CounterPage
        }
