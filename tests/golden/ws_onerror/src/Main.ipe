module Main exposing (main)

-- Regression fixture for the WS `onError` Box-into-Arc E0308 SEAL hole.
-- `Ws.withOnError`'s callback is `WebSocketServer -> Error -> Task Error ()`,
-- i.e. IR `Fun([WebSocketServer, Error], Task Unit)`. Its runtime setter
-- `ws_server_with_on_error` takes `Arc<dyn Fn(WsHandle, E) -> …>`, so the
-- callback MUST box with `Arc::new`. Before the fix `wants_arc_ctor` /
-- `render_type` only matched `[WebSocketServer, Str]` (onMessage), so onError
-- fell to the generic `Box<dyn Fn>` arm and ipec-0 then cargo-failed E0308.

import Ipe.Task as Task
import Ipe.Error exposing (Error)
import Ipe.Http.Server as Server
import Ipe.Http.Server exposing (Request, Response)
import Ipe.Http.Server.WebSocket as Ws

handleWs : Request -> Task Error Response
handleWs req =
    Ws.upgrade req (Ws.defaultCfg |> Ws.withOnError onError)

onError : Ws.WebSocketServer -> Error -> Task Error ()
onError _ _ =
    Task.succeed ()

main =
    Server.listen 8033 [ Server.get "/ws" handleWs ]
