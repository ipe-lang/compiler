module Main exposing (main)

import Ipe.Io as Io
import Ipe.Db.Dsn as Dsn exposing (Dsn, Driver(..), TlsMode(..))
import Ipe.Net as Net
import Ipe.Result as Result exposing (Result(..))
import Ipe.Secret
import Ipe.String as String
import Ipe.System as System


-- Ipe.Db.Dsn parse-don't-validate golden (pure — no connect, no I/O beyond
-- stdout). Proves the parse SURFACE end-to-end in an emitted crate:
--
--   1. A valid Postgres DSN carrying a password parses; its Driver, host, and
--      REDACTED render are printed. The password sentinel NEVER appears in the
--      output (Secret non-leak).
--   2. `sslmode=disable` is a HARD typed Err (fail-closed TLS).
--   3. An omitted sslmode defaults to Require (secure default).
--   4. `Dsn.build` from typed parts runs the same validators.


driverName : Driver -> String
driverName d =
    case d of
        Postgres ->
            "postgres"

        Sqlite ->
            "sqlite"


tlsName : TlsMode -> String
tlsName t =
    case t of
        Require ->
            "require"

        Prefer ->
            "prefer"

        Disable ->
            "disable"


-- Describe a parsed Dsn on one line: driver, host, tls, and the redacted render.
describe : Dsn -> String
describe dsn =
    String.join " "
        [ driverName (Dsn.driver dsn)
        , Dsn.host dsn
        , tlsName (Dsn.tls dsn)
        , Dsn.redacted dsn
        ]


-- A valid Postgres DSN whose password is a distinctive sentinel.
parseValid : String
parseValid =
    case Dsn.parse "postgres://reader:hunter2SENTINEL@db.example.com:5432/appdb" of
        Ok dsn ->
            "valid: " ++ describe dsn

        Err _ ->
            "valid: UNEXPECTED-ERR"


-- `sslmode=disable` must be rejected (a Dsn is never a cleartext proof).
parseDisable : String
parseDisable =
    case Dsn.parse "postgres://h:5432/d?sslmode=disable" of
        Ok _ ->
            "disable: UNEXPECTED-OK"

        Err _ ->
            "disable: rejected"


-- Omitted sslmode defaults to Require.
parseDefault : String
parseDefault =
    case Dsn.parse "postgres://u@h:5432/d" of
        Ok dsn ->
            "default-tls: " ++ tlsName (Dsn.tls dsn)

        Err _ ->
            "default-tls: UNEXPECTED-ERR"


-- `build` from typed parts, running the same validators.
buildTyped : String
buildTyped =
    case
        Dsn.build
            { driver = Postgres
            , host = "warehouse.internal"
            , port = Net.fromInt 5432 |> Result.withDefault Net.min
            , database = "metrics"
            , user = "etl"
            , password = Secret.fromString (System.getenvOr "DB_PASSWORD" "hunter2SENTINEL")
            , tls = Require
            }
    of
        Ok dsn ->
            "build: " ++ driverName (Dsn.driver dsn) ++ " " ++ Dsn.database dsn

        Err _ ->
            "build: UNEXPECTED-ERR"


main =
    Io.println
        (String.join "\n"
            [ parseValid
            , parseDisable
            , parseDefault
            , buildTyped
            ]
        )
