module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- #90 T4 residual gate: a fn-carrying, non-Clone `let`-binding used in TWO
-- consuming (argument) positions has no sound rewrite (`Box<dyn Fn>` is not
-- `Clone`) — must stay a clean IPE-L0127, never a silent accept that later
-- cargo-fails with E0382 (use of moved value).
consume : Maybe (Int -> Int) -> Int
consume mf =
    case mf of
        Just f -> f 1
        Nothing -> 0

main =
    let mf = Just (\x -> x + 1) in
    Io.println (String.fromInt (consume mf + consume mf))
