module Main exposing (main)
import Ipe.Io as Io
import Ipe.Json.Decode as JsonDec
import Ipe.Json.Decode.Pipeline as JsonDecP
import Ipe.String

-- `JsonDec.succeed (\name age -> …)` — a multi-arg lambda threaded through a
-- `|>` pipeline of `required` steps (lambda-as-decoder-factory).
-- Expected: Alice|30

main =
    let
        r1 =
            JsonDec.decodeString
                (JsonDec.succeed (\name age -> name ++ "|" ++ String.fromInt age)
                    |> JsonDecP.required "name" JsonDec.string
                    |> JsonDecP.required "age" JsonDec.int
                )
                "{\"name\":\"Alice\",\"age\":30}"
    in
    case r1 of
        Ok label1 -> Io.println label1
        Err _ -> Io.println "err1"
