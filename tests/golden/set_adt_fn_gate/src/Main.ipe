module Main exposing (main)

-- Companion to `set_rec_fn_gate` for a USER ADT value.
-- `singletonSet` is a generic `a -> Set a` forwarder built on `Set.fromList`.
-- A user ADT (`Color`) is not a comparable type, so instantiating the forwarder
-- at `Color` is rejected at type-check (IPE-T0014) rather than emitting an
-- unbounded `singleton_set::<T>` that `cargo` cannot build.

import Ipe.Set as Set
import Ipe.Io as Io
import Ipe.String


type Color
    = Red
    | Green


singletonSet : a -> Set a
singletonSet x =
    Set.fromList [ x ]


main =
    let
        _unused =
            singletonSet Red
    in
    Io.println (String.fromInt 0)
