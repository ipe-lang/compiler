module Main exposing (main)
import Ipe.Io as Io

-- greet is a signed top-level effectful helper; its annotation uses the
-- canonical two-arg `Task Error ()` form (previously rejected as IPE-T0001
-- before the `normalize_annotation_ty` fix: "expected Task Error (), found
-- Task ()").  The fix reduces Task Error a → Task a in the solver so the
-- kernel-built unary Task type unifies with the annotation.
greet : String -> Task Error ()
greet name =
    Io.println ("Hello, " ++ name ++ "!")

main =
    greet "World"
