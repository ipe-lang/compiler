module Main exposing (main)
import Ipe.Io as Io
import Ipe.Db
import Ipe.Db.Location as Location
import Ipe.Db.Unsafe
import Ipe.Dict
import Ipe.Decimal
import Ipe.List
import Ipe.String
import Ipe.Task

-- SqlDecimal + SqlMoney params in Db.exec + Unsafe.unsafeQuery.
-- Proves both ctors are reachable end-to-end: canon name table,
-- constrain.rs type schemes, lower.rs emit path, and project.rs
-- into_sql_param dispatch. SqlDecimal carries a native Decimal, bound as a
-- lossless TEXT param via decimal_to_string; SqlMoney carries an
-- "ISO_CODE AMOUNT" string.

main =
    Task.andThen
        (\conn ->
            Db.withTransaction conn
                (\txconn ->
                    do
                        Unsafe.unsafeExecRaw txconn
                            "CREATE TABLE prices (label TEXT, amount TEXT, money TEXT)"
                        Db.exec txconn
                            "INSERT INTO prices (label, amount, money) VALUES (?, ?, ?)"
                            [ SqlString "pi", SqlDecimal (Decimal.fromMinor 5 314159), SqlMoney "USD 9.99" ]
                        Task.andThen
                            (\rows ->
                                Io.println
                                    (String.join "\n"
                                        (List.map
                                            (\row ->
                                                cellText "label" row
                                                    ++ ":"
                                                    ++ cellText "amount" row
                                                    ++ ":"
                                                    ++ cellText "money" row
                                            )
                                            rows
                                        )
                                    )
                            )
                            (Unsafe.unsafeQuery txconn
                                "SELECT label, amount, money FROM prices"
                                []
                            )
                )
        )
        (Db.open Location.memory)


-- The text of column `key` in a raw Db row: a SQL `NULL` cell reads as `NULL`,
-- a missing column as the empty string.
cellText : String -> Dict String (Maybe String) -> String
cellText key row =
    case Dict.get key row of
        Just (Just s) ->
            s

        Just Nothing ->
            "NULL"

        Nothing ->
            ""
