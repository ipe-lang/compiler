module Main exposing (main)

-- End-to-end proof of the codec↔SQL row bridge (`Ipe.Db.Codec`): for a record
-- codec exercising every `ColType` (text, int, real, bool, a lossless decimal
-- stored as TEXT, a nullable int, and a JSON-in-TEXT blob list), running
-- `codecToBinds` then rebuilding a `Row` from those binds then `codecFromRow`
-- returns the original value. The bridge builds bound `SqlValue` params only —
-- it constructs no SQL text.
--
-- The fixture also asserts the fail-closed paths: a non-record (scalar) codec
-- has no columns to bind, and a row missing a required column decodes to a typed
-- `Err`. It prints one `db-codec-bridge-ok` line iff every check holds.

import Ipe.Io as Io
import Ipe.Codec as Codec exposing (Codec(..), Shape(..), ColType(..))
import Ipe.Db.Codec as DbCodec
import Ipe.Json.Encode as Encode
import Ipe.Json.Decode as Decode
import Ipe.Json.Decode.Pipeline as Pipeline
import Ipe.Decimal as Dec exposing (Decimal)
import Ipe.Money as Money exposing (Money)
import Ipe.Dict as Dict
import Ipe.List as List
import Ipe.String as String
import Ipe.Time.Timestamp as Timestamp exposing (Timestamp)
import Ipe.Maybe exposing (Maybe(..))
import Ipe.Result exposing (Result(..))


type alias User =
    { id : String
    , age : Int
    , score : Float
    , active : Bool
    , balance : Decimal
    , nickname : Maybe Int
    , tags : List String
    }


makeUser : String -> Int -> Float -> Bool -> Decimal -> Maybe Int -> List String -> User
makeUser id age score active balance nickname tags =
    { id = id
    , age = age
    , score = score
    , active = active
    , balance = balance
    , nickname = nickname
    , tags = tags
    }


-- A record codec written in the direct form, one field per `ColType`:
--   id       CText
--   age      CInt
--   score    CReal
--   active   CBool
--   balance  CText   (Decimal — lossless string, never a Float column)
--   nickname CNull CInt
--   tags     CBlob   (List — one JSON-in-TEXT column)
userCodec : Codec User
userCodec =
    Codec
        { enc =
            \u ->
                Encode.object
                    [ ( "id", Encode.string u.id )
                    , ( "age", Encode.int u.age )
                    , ( "score", Encode.float u.score )
                    , ( "active", Encode.bool u.active )
                    , ( "balance", Encode.string (Dec.toString u.balance) )
                    , ( "nickname", encMaybeInt u.nickname )
                    , ( "tags", Encode.list Encode.string u.tags )
                    ]
        , mkDec = \_ -> userDecoder
        , shp =
            SRecord
                [ ( "id", CText )
                , ( "age", CInt )
                , ( "score", CReal )
                , ( "active", CBool )
                , ( "balance", CText )
                , ( "nickname", CNull CInt )
                , ( "tags", CBlob )
                ]
        }


encMaybeInt : Maybe Int -> Value
encMaybeInt m =
    case m of
        Just n ->
            Encode.int n

        Nothing ->
            Encode.null


userDecoder : Decoder User
userDecoder =
    Decode.succeed makeUser
        |> Pipeline.required "id" Decode.string
        |> Pipeline.required "age" Decode.int
        |> Pipeline.required "score" Decode.float
        |> Pipeline.required "active" Decode.bool
        |> Pipeline.required "balance" decimalDecoder
        |> Pipeline.required "nickname" (Decode.oneOf [ Decode.map Just Decode.int, Decode.succeed Nothing ])
        |> Pipeline.required "tags" (Decode.list Decode.string)


decimalDecoder : Decoder Decimal
decimalDecoder =
    Decode.andThen decimalFromString Decode.string


decimalFromString : String -> Decoder Decimal
decimalFromString s =
    case Dec.fromString s of
        Ok d ->
            Decode.succeed d

        Err _ ->
            Decode.fail "bad decimal"


moneyFromWire : String -> Decoder Money
moneyFromWire s =
    case String.words s of
        [ amountStr, codeStr ] ->
            case Money.parseCurrency codeStr of
                Just cur ->
                    case Money.fromString cur amountStr of
                        Ok m ->
                            Decode.succeed m

                        Err _ ->
                            Decode.fail "bad money amount"

                Nothing ->
                    Decode.fail "bad money currency"

        _ ->
            Decode.fail "bad money wire"


-- Mirror the store's cell representation: build a row (`Dict String (Maybe
-- String)`, `Nothing` for SQL `NULL`) from the bound binds the way
-- `Ipe.Db.Store` reads a row back.
sqlToCell : SqlValue -> Maybe String
sqlToCell v =
    case v of
        SqlString s ->
            Just s

        SqlInt n ->
            Just (String.fromInt n)

        SqlFloat f ->
            Just (String.fromFloat f)

        SqlNull _ ->
            Nothing

        SqlBool b ->
            if b then
                Just "1"

            else
                Just "0"

        SqlBytes _ ->
            Just ""

        SqlTime t ->
            Just (String.fromInt t)

        SqlDecimal d ->
            Just (Dec.toString d)

        SqlMoney s ->
            Just s


rowFromBinds : List ( String, SqlValue ) -> Dict String (Maybe String)
rowFromBinds binds =
    Dict.fromList (List.map (\pair -> case pair of ( k, v ) -> ( k, sqlToCell v )) binds)


userEq : User -> User -> Bool
userEq a b =
    a.id
        == b.id
        && a.age
        == b.age
        && a.score
        == b.score
        && a.active
        == b.active
        && Dec.toString a.balance
        == Dec.toString b.balance
        && nickEq a.nickname b.nickname
        && List.length a.tags
        == List.length b.tags


nickEq : Maybe Int -> Maybe Int -> Bool
nickEq a b =
    case a of
        Just x ->
            case b of
                Just y ->
                    x == y

                Nothing ->
                    False

        Nothing ->
            case b of
                Just _ ->
                    False

                Nothing ->
                    True


-- codecToBinds -> Row -> codecFromRow -> equals original.
bridgeRoundTrips : User -> Bool
bridgeRoundTrips u =
    case DbCodec.codecToBinds userCodec u of
        Ok binds ->
            case DbCodec.codecFromRow userCodec (rowFromBinds binds) of
                Ok back ->
                    userEq u back

                Err _ ->
                    False

        Err _ ->
            False


sample1 : User
sample1 =
    { id = "u-1"
    , age = 30
    , score = 4.5
    , active = True
    , balance = Dec.fromInt 1099
    , nickname = Just 7
    , tags = [ "a", "b", "c" ]
    }


sample2 : User
sample2 =
    { id = "u-2"
    , age = 0
    , score = 0.0
    , active = False
    , balance = Dec.fromInt 250
    , nickname = Nothing
    , tags = []
    }


-- Fail-closed: a bare-scalar codec (SScalar) has no columns to bind.
scalarRejected : Bool
scalarRejected =
    case DbCodec.codecToBinds Codec.string "lonely" of
        Ok _ ->
            False

        Err _ ->
            True


-- Fail-closed: a row missing a required column decodes to a typed Err.
missingColumnRejected : Bool
missingColumnRejected =
    let
        partial =
            Dict.fromList [ ( "id", Just "u-9" ) ]
    in
    case DbCodec.codecFromRow userCodec partial of
        Ok _ ->
            False

        Err _ ->
            True


-- A one-field record codec whose only column is `CTime`, built from the
-- `Codec.timestamp` scalar so the field carries the time role end-to-end.
type alias Stamped =
    { at : Timestamp }


makeStamped : Timestamp -> Stamped
makeStamped at =
    { at = at }


stampedCodec : Codec Stamped
stampedCodec =
    Codec
        { enc =
            \s ->
                Encode.object
                    [ ( "at", Codec.toValue Codec.timestamp s.at ) ]
        , mkDec =
            \_ ->
                Decode.succeed makeStamped
                    |> Pipeline.required "at" (Decode.map Timestamp.fromUnixMillis Decode.int)
        , shp =
            SRecord
                [ ( "at", Codec.columnOf (Codec.shape Codec.timestamp) ) ]
        }


-- A `CTime` column binds as `SqlTime` (the time role), NEVER `SqlInt`, even
-- though the payload is the same millis integer. This is the whole point of the
-- variant: the role lives in the tag, so a moment cannot be swapped for a count.
timestampBindsAsSqlTime : Bool
timestampBindsAsSqlTime =
    case DbCodec.codecToBinds stampedCodec { at = Timestamp.fromUnixMillis 1700000000000 } of
        Ok binds ->
            case binds of
                [ ( key, bound ) ] ->
                    key == "at" && boundIsSqlTime bound

                _ ->
                    False

        Err _ ->
            False


-- The bound value is `SqlTime` (millis in the time role), NEVER `SqlInt`.
boundIsSqlTime : SqlValue -> Bool
boundIsSqlTime bound =
    case bound of
        SqlTime ms ->
            ms == 1700000000000

        SqlString _ ->
            False

        SqlInt _ ->
            False

        SqlFloat _ ->
            False

        SqlBool _ ->
            False

        SqlBytes _ ->
            False

        SqlDecimal _ ->
            False

        SqlMoney _ ->
            False

        SqlNull _ ->
            False


-- The bound `SqlTime` cell rebuilds the original `Timestamp` through the same
-- codec — a lossless row round-trip.
timestampRowRoundTrips : Bool
timestampRowRoundTrips =
    let
        original =
            { at = Timestamp.fromUnixMillis 1700000000000 }
    in
    case DbCodec.codecToBinds stampedCodec original of
        Ok binds ->
            case DbCodec.codecFromRow stampedCodec (rowFromBinds binds) of
                Ok back ->
                    Timestamp.toUnixMillis back.at == Timestamp.toUnixMillis original.at

                Err _ ->
                    False

        Err _ ->
            False


-- A one-field record codec whose only column is `CDecimal`, built from the
-- `Codec.decimal` scalar so the field carries the decimal role end-to-end.
type alias Priced =
    { amount : Decimal }


makePriced : Decimal -> Priced
makePriced amount =
    { amount = amount }


pricedCodec : Codec Priced
pricedCodec =
    Codec
        { enc =
            \p ->
                Encode.object
                    [ ( "amount", Codec.toValue Codec.decimal p.amount ) ]
        , mkDec =
            \_ ->
                Decode.succeed makePriced
                    |> Pipeline.required "amount" (Decode.andThen decimalFromString Decode.string)
        , shp =
            SRecord
                [ ( "amount", Codec.columnOf (Codec.shape Codec.decimal) ) ]
        }


-- A `CDecimal` column binds as `SqlDecimal`, NEVER `SqlString`, even though
-- the wire form is a JSON string. The role lives in the tag.
decimalBindsAsSqlDecimal : Bool
decimalBindsAsSqlDecimal =
    case DbCodec.codecToBinds pricedCodec { amount = Dec.fromInt 12345 } of
        Ok binds ->
            case binds of
                [ ( key, bound ) ] ->
                    key == "amount" && boundIsSqlDecimal bound

                _ ->
                    False

        Err _ ->
            False


-- The bound value is `SqlDecimal`, NEVER `SqlString` or any other variant.
boundIsSqlDecimal : SqlValue -> Bool
boundIsSqlDecimal bound =
    case bound of
        SqlDecimal _ ->
            True

        SqlString _ ->
            False

        SqlInt _ ->
            False

        SqlFloat _ ->
            False

        SqlBool _ ->
            False

        SqlBytes _ ->
            False

        SqlTime _ ->
            False

        SqlMoney _ ->
            False

        SqlNull _ ->
            False


-- The `SqlDecimal` cell rebuilds the original `Decimal` through the codec —
-- lossless round-trip.
decimalRowRoundTrips : Bool
decimalRowRoundTrips =
    let
        original =
            { amount = Dec.fromInt 99999 }
    in
    case DbCodec.codecToBinds pricedCodec original of
        Ok binds ->
            case DbCodec.codecFromRow pricedCodec (rowFromBinds binds) of
                Ok back ->
                    Dec.toString back.amount == Dec.toString original.amount

                Err _ ->
                    False

        Err _ ->
            False


-- A one-field record codec whose only column is `CMoney`, built from the
-- `Codec.money` scalar so the field carries the money role end-to-end.
type alias Valued =
    { price : Money }


makeValued : Money -> Valued
makeValued price =
    { price = price }


valuedCodec : Codec Valued
valuedCodec =
    Codec
        { enc =
            \v ->
                Encode.object
                    [ ( "price", Codec.toValue Codec.money v.price ) ]
        , mkDec =
            \_ ->
                Decode.succeed makeValued
                    |> Pipeline.required "price" (Decode.andThen moneyFromWire Decode.string)
        , shp =
            SRecord
                [ ( "price", Codec.columnOf (Codec.shape Codec.money) ) ]
        }


-- A `CMoney` column binds as `SqlMoney`, NEVER `SqlString`. The role lives in
-- the tag so a monetary value cannot be swapped for a bare text field.
moneyBindsAsSqlMoney : Bool
moneyBindsAsSqlMoney =
    case Money.parseCurrency "USD" of
        Just usd ->
            case Money.fromString usd "42.00" of
                Ok m ->
                    case DbCodec.codecToBinds valuedCodec { price = m } of
                        Ok binds ->
                            case binds of
                                [ ( key, bound ) ] ->
                                    key == "price" && boundIsSqlMoney bound

                                _ ->
                                    False

                        Err _ ->
                            False

                Err _ ->
                    False

        Nothing ->
            False


-- The bound value is `SqlMoney`, NEVER `SqlString` or any other variant.
boundIsSqlMoney : SqlValue -> Bool
boundIsSqlMoney bound =
    case bound of
        SqlMoney _ ->
            True

        SqlString _ ->
            False

        SqlInt _ ->
            False

        SqlFloat _ ->
            False

        SqlBool _ ->
            False

        SqlBytes _ ->
            False

        SqlTime _ ->
            False

        SqlDecimal _ ->
            False

        SqlNull _ ->
            False


-- The `SqlMoney` cell rebuilds the original `Money` through the codec —
-- lossless round-trip preserving both amount and currency.
moneyRowRoundTrips : Bool
moneyRowRoundTrips =
    case Money.parseCurrency "EUR" of
        Just eur ->
            case Money.fromString eur "199.99" of
                Ok m ->
                    let
                        original =
                            { price = m }
                    in
                    case DbCodec.codecToBinds valuedCodec original of
                        Ok binds ->
                            case DbCodec.codecFromRow valuedCodec (rowFromBinds binds) of
                                Ok back ->
                                    moneyEq back.price original.price

                                Err _ ->
                                    False

                        Err _ ->
                            False

                Err _ ->
                    False

        Nothing ->
            False


moneyEq : Money -> Money -> Bool
moneyEq a b =
    Money.currencyCode (Money.currency a)
        == Money.currencyCode (Money.currency b)
        && Dec.toString (Money.amount a)
        == Dec.toString (Money.amount b)


main =
    if
        bridgeRoundTrips sample1
            && bridgeRoundTrips sample2
            && scalarRejected
            && missingColumnRejected
            && timestampBindsAsSqlTime
            && timestampRowRoundTrips
            && decimalBindsAsSqlDecimal
            && decimalRowRoundTrips
            && moneyBindsAsSqlMoney
            && moneyRowRoundTrips
    then
        Io.println "db-codec-bridge-ok"

    else
        Io.println "db-codec-bridge-FAIL"
