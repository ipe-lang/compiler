module Main exposing (main)

-- SEAL fix 2026-07-11: `TypeInfo` is a NOMINAL opaque type backed by the
-- runtime's `IpeTypeInfo`. A bare record literal must be REJECTED at `ipec`
-- time (IPE-T0001). See tests/golden/error_record_literal_panicinfo/.

import Ipe.Io as Io


describe : ErrorDetails -> String
describe details =
    case details of
        TypeMismatch t ->
            "TypeMismatch " ++ t.expected ++ " vs " ++ t.actual

        FfiPanic _ | HttpStatus _ | JsonDecode _ | Custom _ | Database _ ->
            "other"


main =
    Io.println (describe (TypeMismatch { expected = "Int", actual = "String" }))
