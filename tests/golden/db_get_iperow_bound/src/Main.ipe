module Main exposing (main)

import Ipe.Task as Task
import Ipe.Dict as Dict
import Ipe.Db as Db
import Ipe.Db.Unsafe
import Ipe.Io as Io


-- BACKLOG #177 regression — `examples/27-multi-session-chat`'s cargo build.
--
-- Pre-fix: `ipec build` exits 0, but the emitted Rust fails `cargo build`
-- with E0277 (`the trait bound T1: IpeRow is not satisfied`) at every
-- `db_get_string(field, &payload)` call site inside a function whose only
-- generic is the wildcard `any` PARAM. The runtime's field accessors are
-- generic `db_get_*<R: IpeRow>(field, &row)`; the emitted enclosing function
-- carried an unbounded `<T1: Clone>` param, so its body's `db_get_string(_,
-- &payload)` could not prove `payload: IpeRow`.
--
-- The trigger idiom (mirrors example 27's `decodeChatMessage`): a decoder
-- typed `any -> Record` that reads named fields out of its payload via
-- `Unsafe.unsafeGetString` (a Dict-shaped accessor). The `any` param lowers to a
-- wildcard generic; the fix appends `+ IpeRow` to exactly that generic (and
-- ONLY when the body actually calls a `db_get_*`), leaving the record STRUCT
-- itself unbounded so it stays reusable in non-row contexts.


type alias Row =
    { author : String
    , text : String
    }


-- The payload is typed `any` (the pub/sub / broadcast convention). We carry
-- it as a `Dict String String` so `Unsafe.unsafeGetString` reads fields straight back.
decodeRow : any -> Row
decodeRow payload =
    { author = Unsafe.unsafeGetString "author" payload
    , text = Unsafe.unsafeGetString "text" payload
    }


main : Task Error ()
main =
    let
        payload =
            Dict.fromList
                [ ( "author", "ada" )
                , ( "text", "hello" )
                ]

        row =
            decodeRow payload
    in
    Io.println (row.author ++ "," ++ row.text)
