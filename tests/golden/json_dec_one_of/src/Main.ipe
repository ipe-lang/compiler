module Main exposing (main)
import Ipe.Io as Io
import Ipe.Json.Decode
import Ipe.String

-- `JsonDec.oneOf` tries decoders in order; the first success wins.
-- The decoder is inlined at each `decodeString` call so Rust's ownership
-- and Ipe's type-inference for top-level decoder bindings are not involved.
--
-- Decode `42`      → int branch: map (\n -> String.fromInt n) int → "42".
-- Decode `"hello"` → int branch fails, string branch succeeds → "hello".
-- Expected: "42 hello"
main =
    let
        r1 =
            JsonDec.decodeString
                (JsonDec.oneOf [ JsonDec.map (\n -> String.fromInt n) JsonDec.int, JsonDec.string ])
                "42"

        r2 =
            JsonDec.decodeString
                (JsonDec.oneOf [ JsonDec.map (\n -> String.fromInt n) JsonDec.int, JsonDec.string ])
                "\"hello\""
    in
    case r1 of
        Ok s1 ->
            case r2 of
                Ok s2 ->
                    Io.println (s1 ++ " " ++ s2)

                Err _ ->
                    Io.println "err2"

        Err _ ->
            Io.println "err1"
