module Main exposing (main)

-- A stored `List (Int -> Int)` is `Clone` (storable, mappable, foldable), but a
-- function value is not comparable: `Arc<dyn Fn>` is neither `PartialEq` nor
-- `Ord`. `List.member` needs `==` on the element, so applying it to a
-- function-carrying list must fail closed at `ipe` time — the element's
-- equality obligation refuses it at type-check (IPE-T0001), ahead of the
-- element-capability gate (IPE-L0134) — never emit Rust `cargo` rejects.

import Ipe.Io as Io
import Ipe.List
import Ipe.String


steps : List (Int -> Int)
steps =
    [ \n -> n + 1, \n -> n * 2 ]


main =
    let
        _unused =
            List.member (\n -> n + 1) steps
    in
    Io.println (String.fromInt 0)
