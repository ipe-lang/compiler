module Main exposing (main)
import Ipe.Io as Io
import Ipe.Secret
import Ipe.System as System

-- golden: a record containing a `Secret` field stays fully derivable
-- (`Clone` / `Debug` / `PartialEq`) — `Secret` is merely non-serde, not
-- non-derivable, so the WHOLE record keeps its derives. Exercises record `==`
-- (recurses into `Secret`'s own constant-time equality) AND the record-update
-- syntax `{ r | f = v }` (requires `Clone` on the base record, hence on every
-- field including `apiKey : Secret`).
--
-- The key is sealed from a runtime `String` (`System.getenvOr` with a
-- test-default fallback), never a committed literal (IPE-L0150).

type alias Config =
    { apiKey : Secret, label : String }

cfg1 : Config
cfg1 =
    { apiKey = Secret.fromString (System.getenvOr "API_KEY" "k1"), label = "prod" }

cfg2 : Config
cfg2 =
    { apiKey = Secret.fromString (System.getenvOr "API_KEY" "k1"), label = "prod" }

cfg3 : Config
cfg3 =
    { cfg1 | label = "staging" }

boolStr : Bool -> String
boolStr flag =
    if flag then
        "T"
    else
        "F"

main =
    Io.println (boolStr (cfg1 == cfg2) ++ boolStr (cfg1 == cfg3) ++ cfg3.label)
