module Main exposing (main)

-- BACKLOG #195 regression — a Json.Decode pipeline whose accumulator value is
-- itself a function (`Decoder (a -> b)` curry chain) exercises the OWNED /
-- linear decoder-payload path.
--
-- Pre-fix: `ipec build` exits 0, but the emitted Rust fails `cargo build`. The
-- backend's `IrType::Fun` renderer stamped `Box<dyn Fn(..) -> R + Send + Sync>`
-- on the decoder payload, but the runtime represents a `Decoder (a -> b)`
-- payload as a Send-ONLY curry chain `Box<dyn FnOnce(a) -> b + Send>` (what
-- `curryN` builds and `decode_succeed`'s `A` is inferred to). Two mismatches
-- fire: the wrong trait (`Fn` vs `FnOnce`) AND an over-constrained `+ Sync`
-- (a `FnOnce` curry chain is Send but not Sync) → ipec-0-then-cargo-fail
-- (E0308/E0277).
--
-- Fix (`emit_types.rs`): a function-typed `Decoder` payload renders as the
-- `FnOnceChain` shape the runtime uses (`Box<dyn FnOnce(..) -> _ + Send>`,
-- Send-only, never `+ Sync`) — a decoder payload is owned/linear and never
-- flows into an `Arc<dyn Fn + Send + Sync>` callback slot.
import Ipe.Json.Decode as JsonDec exposing (Decoder)
import Ipe.Json.Decode.Pipeline as Pipeline
import Ipe.Result as Result
import Ipe.String as String
import Ipe.Io as Io


type alias Transaction =
    { id : Int
    , account : String
    , amount : String
    }


-- (1) An ANNOTATED PARTIAL decoder value — the pipeline accumulator after one
-- `required` step. Its payload is a curry chain `String -> Int -> Transaction`,
-- i.e. `Decoder (String -> String -> Transaction)` desugared. This is the exact
-- #195 trigger: the annotation forces the backend to render the function-typed
-- payload, which pre-fix mismatched the runtime's `Box<dyn FnOnce + Send>`.
partialTxnDecoder : Decoder (String -> String -> Transaction)
partialTxnDecoder =
    JsonDec.succeed
        (\rowId account amount ->
            { id = rowId, account = account, amount = amount })
        |> Pipeline.required "id" JsonDec.int


-- (2) Finish the pipeline off the partial accumulator: `Decoder Transaction`.
txnDecoder : Decoder Transaction
txnDecoder =
    partialTxnDecoder
        |> Pipeline.required "account" JsonDec.string
        |> Pipeline.required "amount" JsonDec.string


-- (3) map2 over two fields decoded from the SAME object.
labelDecoder : Decoder String
labelDecoder =
    JsonDec.map2
        (\acc amt -> acc ++ ":" ++ amt)
        (JsonDec.field "account" JsonDec.string)
        (JsonDec.field "amount" JsonDec.string)


-- (4) andThen chain: the callback returns a `succeed`/`fail` decoder.
bucketDecoder : Decoder Int
bucketDecoder =
    JsonDec.field "count" JsonDec.int
        |> JsonDec.andThen
            (\n ->
                if n < 0 then
                    JsonDec.fail "count must be non-negative"

                else
                    JsonDec.succeed n
            )


main =
    let
        j = "{\"id\":1,\"account\":\"acme\",\"amount\":\"12.00\",\"count\":3}"
        tx = JsonDec.decodeString txnDecoder j
        lbl = JsonDec.decodeString labelDecoder j
        cnt = JsonDec.decodeString bucketDecoder j
    in
    case tx of
        Ok t ->
            Io.println
                (t.account
                    ++ " "
                    ++ Result.withDefault "?" lbl
                    ++ " "
                    ++ String.fromInt (Result.withDefault 0 cnt)
                )

        Err _ ->
            Io.println "err"
