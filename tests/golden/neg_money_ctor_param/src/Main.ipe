module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- Negative regression: `amount (Money d _) = d` is a refutable param on a
-- single-constructor union — must still be rejected as IPE-T0015.
-- Proves the fix to Std/Money.ipe did not relax the irrefutability rule.

type Money = Money Int String

amount : Money -> Int
amount (Money d _) = d

main =
    Io.println (String.fromInt (amount (Money 42 "USD")))
