module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- ONE generic enum instantiated at two distinct element types in one module:
-- `Opt Int` (via `Som 41`) and `Opt Bool` (via `Som (1 == 1)`). The backend
-- emits a single `MainOpt<T1>` that Rust monomorphises per use site.
type Opt a = Som a | Non

orElse : Opt Int -> Int -> Int
orElse o d =
    case o of
        Som x -> x
        Non -> d

pick : Opt Bool -> Bool
pick o =
    case o of
        Som b -> b
        Non -> 0 == 1

main =
    let n = orElse (Som 41) 0 in
    let flag = pick (Som (1 == 1)) in
    Io.println (String.fromInt (if flag then n + 1 else n))
