module Main exposing (main)

-- #108 Part B regression fixture — R2.
--
-- The app is ROUTED (Model has a `page : Page` field) but `routes = []`
-- (empty list) and `notFound = Increment` — a constructor from the WRONG ADT
-- (`Msg`, not `Page`).
--
-- Expected: ipec rejects with IPE-T0001 (type mismatch: Msg vs Page).
-- Before Part B: the empty-routes hole let var(2) unify with Msg (the type of
-- `Increment`), so ipec exited 0, then cargo emitted E0631 / E0308.

import Ipe.Tea.Web as Web
import Ipe.Ui as Ui
import Ipe.Tea.Web.Cmd
import Ipe.String
import Ipe.Tea.Web.Sub

type Page
    = CounterPage
    | AboutPage

type Msg
    = Increment

type alias Model =
    { page : Page
    , count : Int
    }

init _req =
    ( { page = CounterPage, count = 0 }, Cmd.none )

update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )

view model =
    Ui.text (String.fromInt model.count)

subscriptions _model =
    Sub.none

main =
    Web.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = []
        , notFound = Increment
        }
