module Main exposing (main)

import Ipe.Task as Task
import Ipe.Error as Error exposing (Error)
import Ipe.Io as Io


-- A step that always fails: no `Step` value is ever built, so the loop's result
-- type is never fixed by a use. The step lambda's return type keeps a free
-- parameter, which has no concrete Rust type.
main =
    Task.loop 3 0 (\_ -> Task.fail (Error.conflict "x"))
        |> Task.map (\_ -> ())
        |> Task.onError (\err -> Io.println (Error.toString err))
