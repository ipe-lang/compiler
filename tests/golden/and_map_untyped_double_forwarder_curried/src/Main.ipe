module Main exposing (main)

import Ipe.Io as Io
import Ipe.Result

-- #90 T3: UNANNOTATED same-module double forwarder — `am2` shares one
-- monomorphic variable set with its call site (CLocal semantics), so the
-- obligation check sees the fully CONCRETE curried type and rejects with
-- the precise found-type, proving no precision is lost where the solver
-- can see concreteness (the green twin fixture stays accepted).
am1 : Result e a -> Result e (a -> b) -> Result e b
am1 x f =
    Result.andMap x f

am2 x f =
    am1 x f

add3 : Int -> Int -> Int -> Int
add3 a b c =
    a + b + c

main =
    case am2 (Ok 1) (Ok add3) of
        Ok _ -> Io.println "ok"
        Err _ -> Io.println "err"
