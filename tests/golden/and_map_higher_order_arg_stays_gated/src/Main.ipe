module Main exposing (main)
import Ipe.Io as Io
import Ipe.Result

-- #90 T3 residual gate, HIGHER-ORDER-ARGUMENT aliasing shape: `Result.andMap`
-- passed bare as an ARGUMENT expression to another function, which applies it
-- to a curried (arity >= 2) payload. `Result.andMap`'s literal occurrence here
-- is one of `applyAM`'s CALL ARGUMENTS (lowered via the ordinary
-- `args.iter().map(lower_expr)` argument path, not a callee position at all),
-- yet the obligation still fires: `constrain_var_kernel` ties the payload-
-- result bound to the SAME union-find variable regardless of what larger
-- expression contains the `VarKernel` occurrence (Tier 2, by construction),
-- and the Tier-1 backstop lives inside `lower_callee`, the single funnel every
-- reference to `Result.andMap` resolves through regardless of argument vs.
-- callee position. Must stay rejected, never silently accepted.
type alias AndMapFn = Result Error Int -> Result Error (Int -> Int -> Int -> Int) -> Result Error (Int -> Int -> Int)

applyAM : AndMapFn -> Result Error Int -> Result Error (Int -> Int -> Int -> Int) -> Result Error (Int -> Int -> Int)
applyAM f x y =
    f x y

add3 : Int -> Int -> Int -> Int
add3 a b c =
    a + b + c

main =
    case applyAM Result.andMap (Ok 1) (Ok add3) of
        Ok _ -> Io.println "ok"
        Err _ -> Io.println "err"
