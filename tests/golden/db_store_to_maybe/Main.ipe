module Main exposing (main)

import Ipe.Io as Io
import Ipe.Db as Db
import Ipe.Db.Location as Location
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Db.Store.Unsafe as StoreU
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.List as List
import Ipe.Task as Task
import Ipe.Result as Result exposing (Result(..))
import Ipe.Maybe as Maybe exposing (Maybe(..))
import Ipe.Error as Error exposing (Error)


-- Ipe.Db.Store `toMaybe` golden: the fetch-one query terminal. `toMaybe` runs a
-- query and decodes the FIRST ordered row through the store's codec, or
-- `Nothing`. It is defined as `Task.map List.head (toList conn q)` — it forwards
-- its generic row type to `toList`, capturing it in no closure of its OWN body.
-- The emitted `to_list<T1: Send + Sync + Clone>` requires `Sync`; a caller that
-- only forwards `T1` used to emit `to_maybe<T1: Send + Clone>` (no `Sync`),
-- which cargo-failed E0277 (`T1 cannot be shared between threads`) even though
-- `ipe` reported exit 0 — an exit-0-then-cargo-fail SEAL break. Cross-call bound
-- propagation now copies `toList`'s `Sync` obligation onto the forwarded tvar,
-- so `to_maybe<T1: Send + Sync + Clone>` builds. This golden is that class's
-- regression anchor.
--
-- The four output lines assert, in order:
--   * a `where (eq "id" "p1")` query returns the matching row (hit);
--   * ordering picks the FIRST ordered row (highest qty) among many matches;
--   * a query matching no row returns `Nothing` (miss);
--   * a value containing `'; DROP TABLE` binds as a parameter, retrieved
--     LITERALLY (parameterisation, not escaping).
--
-- Output:
--   by-id:widget:30
--   first-ordered:widget:30
--   miss:nothing
--   injection:'; DROP TABLE products; --


type alias Product =
    { id : String
    , name : String
    , qty : Int
    }


productColumns : List Store.Column
productColumns =
    [ Store.textColumn "id"
    , Store.textColumn "name"
    , Store.intColumn "qty"
    ]


productStore : Result Error (Store Store.Row)
productStore =
    case Store.fromColumns "products" productColumns of
        Ok s ->
            Ok (Store.public (StoreU.primaryKey "id" s))

        Err e ->
            Err e


writeProduct : Product -> Store.Row
writeProduct p =
    Dict.fromList
        [ ( "id", Just p.id )
        , ( "name", Just p.name )
        , ( "qty", Just (String.fromInt p.qty) )
        ]


cell : String -> Store.Row -> String
cell name row =
    case Dict.get name row of
        Just (Just s) ->
            s

        Just Nothing ->
            "NULL"

        Nothing ->
            "?"


rowLabel : Store.Row -> String
rowLabel row =
    String.concat [ cell "name" row, ":", cell "qty" row ]


seed : List Product
seed =
    [ { id = "p1", name = "widget", qty = 30 }
    , { id = "p2", name = "gizmo", qty = 9 }
    , { id = "p3", name = "'; DROP TABLE products; --", qty = 1 }
    ]


main : Task Error ()
main =
    case productStore of
        Err e ->
            Io.println (Error.toString e)

        Ok store ->
            Task.andThen
                (\conn ->
                    Db.withTransaction conn
                        (\txconn -> runChecks txconn store)
                )
                (Db.open Location.memory)


runChecks : Db -> Store Store.Row -> Task Error ()
runChecks conn store =
    Task.andThen
        (\_ -> Task.andThen (\_ -> report conn store) (insertSeed conn store))
        (Store.create conn store)


insertSeed : Db -> Store Store.Row -> Task Error ()
insertSeed conn store =
    List.foldl
        (\p acc -> Task.andThen (\_ -> insertOne conn store p) acc)
        (Task.succeed ())
        seed


insertOne : Db -> Store Store.Row -> Product -> Task Error ()
insertOne conn store p =
    Task.map (\_ -> ()) (Store.insert conn store (writeProduct p))


-- Fetch-one by primary key equality through the query builder + `toMaybe`.
byIdCheck : Db -> Store Store.Row -> Task Error String
byIdCheck conn store =
    Task.map
        (\m -> String.concat [ "by-id:", renderMaybeRow m ])
        (Store.query store
            |> Store.where (StoreU.eq "id" (SqlString "p1"))
            |> Store.toMaybe conn
        )


-- Among many matches, `toMaybe` reads the FIRST ordered row: qty descending
-- picks widget (30) over gizmo (9).
firstOrderedCheck : Db -> Store Store.Row -> Task Error String
firstOrderedCheck conn store =
    Task.map
        (\m -> String.concat [ "first-ordered:", renderMaybeRow m ])
        (Store.query store
            |> Store.where (StoreU.gt "qty" (SqlInt 4))
            |> Store.orderDesc "qty"
            |> Store.toMaybe conn
        )


-- No row matches, so `toMaybe` returns `Nothing`.
missCheck : Db -> Store Store.Row -> Task Error String
missCheck conn store =
    Task.map
        (\m -> String.concat [ "miss:", renderMaybeRow m ])
        (Store.query store
            |> Store.where (StoreU.eq "id" (SqlString "absent"))
            |> Store.toMaybe conn
        )


renderMaybeRow : Maybe Store.Row -> String
renderMaybeRow m =
    case m of
        Just row ->
            rowLabel row

        Nothing ->
            "nothing"


report : Db -> Store Store.Row -> Task Error ()
report conn store =
    Task.andThen
        (\byId ->
            Task.andThen
                (\firstOrdered ->
                    Task.andThen
                        (\miss -> printLines byId firstOrdered miss)
                        (missCheck conn store)
                )
                (firstOrderedCheck conn store)
        )
        (byIdCheck conn store)


printLines : String -> String -> String -> Task Error ()
printLines byId firstOrdered miss =
    Io.println
        (String.join "\n"
            [ byId
            , firstOrdered
            , miss
            , String.concat [ "injection:", productName3 ]
            ]
        )


productName3 : String
productName3 =
    "'; DROP TABLE products; --"
