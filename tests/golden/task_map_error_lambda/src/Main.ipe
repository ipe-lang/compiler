module Main exposing (main)

import Ipe.Error as Error
import Ipe.Io as Io
import Ipe.Task

-- Task.onError with a lambda: `e` must be inferred as `Error` (not a free
-- variable) so the handler compiles without IPE-L0102 ("polymorphic
-- parameter").  Fixed by pinning the handler-parameter type to the concrete
-- `Error` type in the kernel_ty dispatch for onError/mapError.  `Task.fail`
-- is likewise pinned to `Error -> Task Error a`, hence `Error.unexpected`
-- below rather than a bare string literal.
main =
    Task.onError
        (\e -> Io.println "recovered")
        (Task.fail (Error.unexpected "an error"))
