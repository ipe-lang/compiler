module Main exposing (main)
import Ipe.Io as Io
import Ipe.Char
import Ipe.Crypto as Crypto
import Ipe.String

-- HMAC-SHA256 / HMAC-SHA512 — RFC 4231 test case 1.
-- key = 0x0b repeated 20 times (byte value 11 = vertical tab)
-- msg = "Hi There"
main =
    let
        rawKey = String.repeat 20 (String.fromChar (Char.fromCode 11))
    in
    case Crypto.keyFromBytes rawKey of
        Nothing ->
            Io.println "error: key construction failed"

        Just key ->
            let
                h256 = Crypto.hmacSha256 key "Hi There"

                h512 = Crypto.hmacSha512 key "Hi There"
            in
            Io.println (String.join " " [ Crypto.macToHex h256, Crypto.macToHex h512 ])
