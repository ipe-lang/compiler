module Main exposing (main)
import Ipe.Io as Io
import Ipe.Task as Task
import Ipe.Crypto

-- Crypto.randomBytes: verify the call compiles and the program exits cleanly.
-- The result is discarded; the effect runs and sequences into the final print.
main =
    Crypto.randomBytes 16 |> Task.andThen (\_ -> Io.println "ok")
