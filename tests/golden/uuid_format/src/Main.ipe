module Main exposing (main)
import Ipe.Io as Io
import Ipe.String
import Ipe.Task
import Ipe.Uuid

-- Uuid.v4 / Uuid.v7 are `() -> Task Error String` (entropy is an EFFECT,
-- task #54): each call re-evaluates and draws fresh entropy, so they are
-- sequenced with Task.andThen. Each generated id is used exactly once (the
-- current Rust lowering moves a String into a kernel call, so a single binding
-- can't feed two by-value kernels). Checks, one fresh id each:
--   * v4 length is 36; v4 version nibble at index 14 is '4';
--   * a fresh v4 round-trips through the PURE Uuid.parse;
--   * v7 length is 36; v7 version nibble at index 14 is '7'.
main =
    Task.andThen
        (\lenId4 ->
            Task.andThen
                (\verId4 ->
                    Task.andThen
                        (\parseId4 ->
                            Task.andThen
                                (\lenId7 ->
                                    Task.andThen
                                        (\verId7 ->
                                            let
                                                lenOk4 = String.length lenId4 == 36

                                                versionOk4 = String.slice 14 15 verId4 == "4"

                                                parseOk =
                                                    case Uuid.parse parseId4 of
                                                        Just _ ->
                                                            True

                                                        Nothing ->
                                                            False

                                                lenOk7 = String.length lenId7 == 36

                                                versionOk7 = String.slice 14 15 verId7 == "7"
                                            in
                                            Io.println
                                                (if lenOk4 && versionOk4 && parseOk && lenOk7 && versionOk7 then
                                                    "ok"

                                                 else
                                                    "fail"))
                                        (Uuid.v7 ()))
                                (Uuid.v7 ()))
                        (Uuid.v4 ()))
                (Uuid.v4 ()))
        (Uuid.v4 ())
