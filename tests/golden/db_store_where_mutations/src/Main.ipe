module Main exposing (main)

import Ipe.Io as Io
import Ipe.Db as Db
import Ipe.Db.Location as Location
import Ipe.Db.Unsafe as Unsafe
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Db.Store.Unsafe as StoreU
import Ipe.Dict as Dict
import Ipe.String as String
import Ipe.List as List
import Ipe.Task as Task
import Ipe.Result as Result exposing (Result(..))
import Ipe.Maybe as Maybe exposing (Maybe(..))
import Ipe.Error as Error exposing (Error)


-- Ipe.Db.Store WHERE-based mutation + default-spec golden. A raw-column store
-- with three DEFAULT specs (`defaultText`, `defaultInt`, `touchOnUpdate`) is
-- created on `sqlite::memory:`, seeded, then mutated through the typed
-- `updateWhere` / `deleteWhere` surface. Checks, one line each:
--
--   * the DDL defaults land: a row inserted WITHOUT `status` / `retries` /
--     `updated_at` (a partial INSERT that omits them) gets the declared defaults
--     (`active` / `0`) and a non-empty `updated_at` stamp — proving the
--     `defaultText` / `defaultInt` / `touchOnUpdate` DDL is emitted and applied.
--   * `updateWhere (gte "balance" 100)` rewrites the two matching rows from a
--     template (owner + balance) and leaves the below-threshold row untouched —
--     the updated-row count is 2, and the primary key is NOT rewritten (each row
--     keeps its own id).
--   * the template `owner` is an injection payload, bound (never spliced): the
--     table survives and stores the value verbatim.
--   * a `deleteWhere (Store.and [])` — a condition constraining NO column, which
--     lowers to the always-true `(1 = 1)` fragment — is refused with NO SQL
--     issued (fail-closed): an unconstrained bulk mutation would delete every
--     row, so it must never reach the database. The later `remaining` line (both
--     rows still present) confirms the delete never ran.
--   * `deleteWhere (lt "balance" 100)` removes exactly the one low row.
--   * a `deleteWhere` naming a column the store does not derive is a typed `Err`
--     with NO SQL issued (fail-closed).
--
-- Output:
--   defaults:active:0:stamped
--   update-where:2
--   after-update:acct-1=hijacked';DROP,acct-2=hijacked';DROP,acct-3=carol
--   reject-unscoped:ok
--   delete-where:1
--   remaining:acct-1,acct-2
--   reject-bad-column:ok


accountColumns : List Store.Column
accountColumns =
    [ Store.textColumn "id"
    , Store.textColumn "owner"
    , Store.intColumn "balance"
    , Store.textColumn "status"
    , Store.intColumn "retries"
    , Store.textColumn "updated_at"
    ]


accountStore : Result Error (Store Store.Row)
accountStore =
    case Store.fromColumns "accounts" accountColumns of
        Ok s ->
            Ok
                (s
                    |> StoreU.primaryKey "id"
                    |> StoreU.defaultText "status" "active"
                    |> StoreU.defaultInt "retries" 0
                    |> StoreU.touchOnUpdate "updated_at"
                    |> Store.public
                )

        Err e ->
            Err e


-- The injection payload used as the SET `owner` value in `updateWhere`; if it
-- were spliced instead of bound it would drop the table.
injectionOwner : String
injectionOwner =
    "hijacked';DROP TABLE accounts;--"


-- A full-record template for `updateWhere`: it sets `owner` and `balance` on
-- every matching row (the primary key is dropped by `updateWhere`, and the
-- DB-filled columns are omitted). `balance` stays at 200 so both rewritten rows
-- remain above the later delete threshold.
updateTemplate : Store.Row
updateTemplate =
    Dict.fromList
        [ ( "id", Just "" )
        , ( "owner", Just injectionOwner )
        , ( "balance", Just "200" )
        ]


cell : String -> Store.Row -> String
cell name row =
    case Dict.get name row of
        Just (Just s) ->
            s

        Just Nothing ->
            "NULL"

        Nothing ->
            "?"


main : Task Error ()
main =
    case accountStore of
        Err e ->
            Io.println (Error.toString e)

        Ok store ->
            Task.andThen
                (\conn ->
                    Db.withTransaction conn
                        (\txconn -> runChecks txconn store)
                )
                (Db.open Location.memory)


runChecks : Db -> Store Store.Row -> Task Error ()
runChecks conn store =
    Task.andThen
        (\_ -> Task.andThen (\_ -> report conn store) (seedRows conn))
        (Store.create conn store)


-- Seed rows through a PARTIAL raw INSERT that names only id/owner/balance, so
-- the DB fills `status` / `retries` / `updated_at` from the DDL defaults — the
-- behavioural proof that `defaultText` / `defaultInt` / `touchOnUpdate` landed.
seedRows : Db -> Task Error ()
seedRows conn =
    List.foldl
        (\stmt acc -> Task.andThen (\_ -> Task.map (\_ -> ()) (Unsafe.unsafeExecRaw conn stmt)) acc)
        (Task.succeed ())
        [ "INSERT INTO accounts (id, owner, balance) VALUES ('acct-1', 'alice', 150)"
        , "INSERT INTO accounts (id, owner, balance) VALUES ('acct-2', 'bob', 100)"
        , "INSERT INTO accounts (id, owner, balance) VALUES ('acct-3', 'carol', 40)"
        ]


-- Read acct-3 back and render its DB-filled columns, proving the DDL defaults
-- landed and `touchOnUpdate` stamped a non-empty value.
defaultsCheck : Db -> Store Store.Row -> Task Error String
defaultsCheck conn store =
    Task.map renderDefaults (Store.get conn store (SqlString "acct-3"))


renderDefaults : Maybe Store.Row -> String
renderDefaults maybeRow =
    case maybeRow of
        Just row ->
            String.concat
                [ "defaults:"
                , cell "status" row
                , ":"
                , cell "retries" row
                , ":"
                , stampLabel (cell "updated_at" row)
                ]

        Nothing ->
            "defaults:missing"


stampLabel : String -> String
stampLabel value =
    if String.isEmpty value then
        "unstamped"

    else
        "stamped"


-- Rewrite `owner` + `balance` on every row with balance >= 100 (acct-1 and
-- acct-2); acct-3 (balance 40) is untouched. Returns the updated-row count.
updateWhereCheck : Db -> Store Store.Row -> Task Error Int
updateWhereCheck conn store =
    Store.updateWhere conn
        store
        (StoreU.gte "balance" (SqlInt 100))
        updateTemplate


-- Render every row's `id=owner` after the update, ordered by id. Truncates the
-- injection payload to its stable prefix so the line is deterministic.
afterUpdate : Db -> Store Store.Row -> Task Error String
afterUpdate conn store =
    Task.map
        (\rows -> String.join "," (List.map ownerPair rows))
        (Store.query store
            |> Store.orderAsc "id"
            |> Store.toList conn
        )


ownerPair : Store.Row -> String
ownerPair row =
    String.concat [ cell "id" row, "=", String.left 14 (cell "owner" row) ]


-- Delete every row below the 100 threshold (exactly acct-3). Returns the count.
deleteWhereCheck : Db -> Store Store.Row -> Task Error Int
deleteWhereCheck conn store =
    Store.deleteWhere conn store (StoreU.lt "balance" (SqlInt 100))


remainingCheck : Db -> Store Store.Row -> Task Error String
remainingCheck conn store =
    Task.map
        (\rows -> String.join "," (List.map (\row -> cell "id" row) rows))
        (Store.query store
            |> Store.orderAsc "id"
            |> Store.toList conn
        )


-- A `deleteWhere` naming a column the store does not derive must be a total
-- `Err`, issuing NO SQL. `Task.onError` turns that fail-closed error into "ok".
rejectBadColumn : Db -> Store Store.Row -> Task Error String
rejectBadColumn conn store =
    Task.onError
        (\_ -> Task.succeed "reject-bad-column:ok")
        (Task.map
            (\_ -> "reject-bad-column:FAIL-accepted")
            (Store.deleteWhere conn store (StoreU.eq "no_such_column" (SqlInt 1)))
        )


-- A `deleteWhere` whose condition constrains NO column (`Store.and []` lowers to
-- the always-true `(1 = 1)` fragment) must fail closed, issuing NO SQL — an
-- unconstrained bulk mutation would delete every row (data loss). The table is
-- still intact after this check (the delete never ran), which the later
-- `remaining` line confirms.
rejectUnscoped : Db -> Store Store.Row -> Task Error String
rejectUnscoped conn store =
    Task.onError
        (\_ -> Task.succeed "reject-unscoped:ok")
        (Task.map
            (\_ -> "reject-unscoped:FAIL-mass-deleted")
            (Store.deleteWhere conn store (Store.and []))
        )


report : Db -> Store Store.Row -> Task Error ()
report conn store =
    Task.andThen
        (\defaults ->
            Task.andThen
                (\updated ->
                    Task.andThen
                        (\afterUpd ->
                            Task.andThen
                                (\unscoped ->
                                    Task.andThen
                                        (\deleted ->
                                            Task.andThen
                                                (\remaining ->
                                                    Task.andThen
                                                        (\rejected ->
                                                            printLines defaults updated afterUpd unscoped deleted remaining rejected
                                                        )
                                                        (rejectBadColumn conn store)
                                                )
                                                (remainingCheck conn store)
                                        )
                                        (deleteWhereCheck conn store)
                                )
                                (rejectUnscoped conn store)
                        )
                        (afterUpdate conn store)
                )
                (updateWhereCheck conn store)
        )
        (defaultsCheck conn store)


printLines : String -> Int -> String -> String -> Int -> String -> String -> Task Error ()
printLines defaults updated afterUpd unscoped deleted remaining rejected =
    Io.println
        (String.join "\n"
            [ defaults
            , String.concat [ "update-where:", String.fromInt updated ]
            , String.concat [ "after-update:", afterUpd ]
            , unscoped
            , String.concat [ "delete-where:", String.fromInt deleted ]
            , String.concat [ "remaining:", remaining ]
            , rejected
            ]
        )
