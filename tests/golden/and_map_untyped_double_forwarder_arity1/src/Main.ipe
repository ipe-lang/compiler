module Main exposing (main)

import Ipe.Io as Io
import Ipe.Result
import Ipe.String

-- #90 T3 green twin of and_map_untyped_double_forwarder_curried:
-- same UNANNOTATED same-module double-forwarder shape, arity-1 payload —
-- must stay ACCEPTED and compute 42 (CLocal keeps everything concrete, so
-- the fail-closed Var arm never fires here).
am1 : Result e a -> Result e (a -> b) -> Result e b
am1 x f =
    Result.andMap x f

am2 x f =
    am1 x f

inc : Int -> Int
inc n =
    n + 1

main =
    case am2 (Ok 41) (Ok inc) of
        Ok n -> Io.println (String.fromInt n)
        Err _ -> Io.println "err"
