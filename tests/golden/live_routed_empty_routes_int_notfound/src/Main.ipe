module Main exposing (main)

-- #108 Part B regression fixture — R1.
--
-- The app is ROUTED (Model has a `page : Page` field) but `routes = []`
-- (empty list, so no route constructor witnesses `var(2)`) and `notFound = 5`
-- (Int, which is NOT the Page type).
--
-- Expected: ipec rejects with IPE-T0001 (type mismatch: Int vs Page).
-- Before Part B: ipec exited 0 (the empty-routes hole let var(2) = Int slip
-- through), then cargo rejected the emitted `set_page` closure with E0308.

import Ipe.Tea.Web as Web
import Ipe.Ui as Ui
import Ipe.Tea.Web.Cmd
import Ipe.String
import Ipe.Tea.Web.Sub

type Page
    = CounterPage
    | AboutPage

type Msg
    = Increment

type alias Model =
    { page : Page
    , count : Int
    }

init _req =
    ( { page = CounterPage, count = 0 }, Cmd.none )

update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )

view model =
    Ui.text (String.fromInt model.count)

subscriptions _model =
    Sub.none

main =
    Web.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = []
        , notFound = 5
        }
