module Main exposing (main)

-- #181 regression: polymorphic kernels whose free result type parameter the HM
-- solver leaves GENUINELY UNCONSTRAINED (a discarded / empty / phantom position)
-- must emit a default turbofish so the Rust builds (no E0282/E0283) — the SEAL
-- (ipec-0 ⟹ cargo-0). Each line below is such an ambiguous shape; the printed
-- output proves the runtime behaviour is still correct, not just that it builds.

import Ipe.List as List
import Ipe.Dict as Dict
import Ipe.Set as Set
import Ipe.Task as Task
import Ipe.String as String
import Ipe.Error as Error
import Ipe.Decimal as Dec
import Ipe.Io as Io
import Ipe.Result


-- `List.head []` — element type free; result discarded to a Bool.
headEmpty : Bool
headEmpty =
    case List.head [] of
        Nothing ->
            True

        Just _ ->
            False


-- `List.tail []` — element type free (Maybe (List elem)).
tailEmpty : Bool
tailEmpty =
    case List.tail [] of
        Nothing ->
            True

        Just _ ->
            False


-- `List.isEmpty []` — element free, comes only from the empty-list argument.
isEmptyEmpty : Bool
isEmptyEmpty =
    List.isEmpty []


-- `List.length []` — likewise argument-driven.
lengthEmpty : Int
lengthEmpty =
    List.length []


-- `Dict.keys Dict.empty` — key AND value free.
dictKeysEmpty : Int
dictKeysEmpty =
    List.length (Dict.keys Dict.empty)


-- `Set.toList Set.empty` — element free.
setEmptyCount : Int
setEmptyCount =
    List.length (Set.toList Set.empty)


-- `Result.mapError` on a discarded `Err` — the `Ok` type is free.
mapErrorDiscard : Bool
mapErrorDiscard =
    let
        wrapped =
            Result.mapError (\_ -> Error.unexpected "wrapped") (Err (Error.unexpected "inner"))
    in
    case wrapped of
        Err _ ->
            True

        Ok _ ->
            False


-- `Decimal.fromString "abc"` — error channel free, discarded.
decJunkIsErr : Bool
decJunkIsErr =
    case Dec.fromString "abc" of
        Err _ ->
            True

        Ok _ ->
            False


main =
    let
        pureFlags =
            [ headEmpty
            , tailEmpty
            , isEmptyEmpty
            , mapErrorDiscard
            , decJunkIsErr
            ]

        allTrue =
            List.all (\b -> b) pureFlags

        verdict =
            if allTrue then
                "ok"

            else
                "FAIL"

        counts =
            String.fromInt lengthEmpty
                ++ "," ++ String.fromInt dictKeysEmpty
                ++ "," ++ String.fromInt setEmptyCount
    in
    -- `Task.fail` whose phantom success is discarded; err branch proves Err.
    Task.fail (Error.unexpected "boom")
        |> Task.andThen (\_ -> Io.println "FAIL taskFail")
        |> Task.onError (\_ -> Io.println (verdict ++ " " ++ counts))
