module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- Integer division at the i64::MIN // -1 corner: the quotient wraps to
-- i64::MIN instead of trapping. minInt is built by wrapping subtraction,
-- (-9223372036854775807) - 1, so the program also pins that path.

minInt : Int
minInt =
    (-9223372036854775807) - 1

main =
    Io.println (String.fromInt (minInt // (-1)))
