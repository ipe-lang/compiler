module Main exposing (main)
import Ipe.Io as Io
import Ipe.String
import Ipe.Task as Task

-- Integer division at the minInt // -1 corner: the quotient 2^63 is outside
-- the 64-bit Int range, so the program ends in a typed IntOverflow error
-- (exit 1, nothing printed) instead of a wrapped value or a panic. minInt is
-- built by subtraction, (-9223372036854775807) - 1, which stays in range.
-- The division runs inside a task step, where a runtime trip becomes the
-- program's typed error.

minInt : Int
minInt =
    (-9223372036854775807) - 1

main =
    Task.succeed ()
        |> Task.andThen (\_ -> Io.println (String.fromInt (minInt // (-1))))
