module Main exposing (main)
import Ipe.Io as Io
import Ipe.String


-- F6 (#121 seal) — RE-CLASSIFIED to ACCEPT by the #221 fn-value Arc-carrier
-- promotion. A lambda FORWARDS (not calls) the fn-typed param `f` in a
-- non-callee position: the param is shadow-rebound to the `Clone`
-- `Arc<dyn Fn>` carrier at function entry and the read re-dispatched through
-- a fresh `Box` closure, so the shape compiles and runs (it was IPE-L0125/6
-- fail-closed while the only carrier was a non-`Clone` `Box<dyn Fn>`).
applyTwice : (Int -> Int) -> Int -> Int
applyTwice g x =
    g (g x)
-- `f` is captured from outside and forwarded to `applyTwice` — non-callee.


compose : (Int -> Int) -> Int -> Int
compose f =
    \x -> applyTwice f x


main =
    Io.println (String.fromInt (compose (\n -> n + 1) 3))
