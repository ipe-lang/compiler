module Main exposing (main)

import Ipe.Task as Task
import Ipe.Dict as Dict
import Ipe.Db as Db
import Ipe.Db.Unsafe
import Ipe.Io as Io


-- FALSE-POSITIVE guard: a wildcard `any` param used ONLY as a Db row (which
-- correctly gains the `IpeRow` bound) must NOT ALSO gain a spurious
-- `IpeStringify` bound just because a SIBLING concrete `String` param is
-- interpolated in the same body. The stringify obligation is decided per-param
-- by the exact `{{…}}` argument position; a `String`-typed sibling never
-- routes `IpeStringify` onto the wildcard `row` generic. The row generic's real
-- obligation is `IpeRow` alone — a gratuitous stringify bound would be a bound
-- the param does not need and does not reflect its use.
grab : any -> String -> String
grab row prefix =
    """{{prefix}}""" ++ ":" ++ Unsafe.unsafeGetString "k" row


main : Task Error ()
main =
    let
        payload =
            Dict.fromList [ ( "k", "v" ) ]
    in
    Io.println (grab payload "p")
