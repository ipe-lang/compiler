module Main exposing (main)
import Ipe.Io as Io
import Ipe.Task

-- `Task Error Int Bool` (3 type arguments) is ill-formed: `Task` takes exactly
-- an error channel and a success type. Before #32 this ICE'd with a generic
-- `CompilerBug` ("please report"); now `normalize_annotation_ty` fails closed
-- with a clean IPE-T0016 diagnostic naming the found argument count.
doThing : String -> Task Error Int Bool
doThing s =
    Task.succeed 42

main =
    Io.println "test"
