module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- Boolean literal patterns: a `True` + `False` pair is a closed, exhaustive
-- cover of `Bool` (no wildcard required).
toInt : Bool -> Int
toInt b =
    case b of
        True -> 1
        False -> 0

main =
    Io.println (String.fromInt (toInt (0 == 0)))
