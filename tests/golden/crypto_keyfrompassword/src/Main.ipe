module Main exposing (main)
import Ipe.Io as Io
import Ipe.Crypto

-- aesKeyFromPassword is deterministic: same password+salt → same key.
-- Derive the key twice independently; encrypt with key1, decrypt with key2.
-- If derivation is deterministic, decrypt succeeds and returns the plaintext.
main =
    let
        key1 = Crypto.aesKeyFromPassword "mypassword" "mysalt"

        key2 = Crypto.aesKeyFromPassword "mypassword" "mysalt"

        result =
            case Crypto.aesGcmEncrypt key1 "secret" of
                Ok ciphertext ->
                    case Crypto.aesGcmDecrypt key2 ciphertext of
                        Ok plaintext ->
                            if plaintext == "secret" then
                                "ok"

                            else
                                "wrong"

                        Err _ ->
                            "decrypt-failed"

                Err _ ->
                    "encrypt-failed"
    in
    Io.println result
