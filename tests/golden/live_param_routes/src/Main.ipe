module Main exposing (main)

-- #108 round 4 (hole 3) regression — `:param` routes with a payload
-- constructor page builder, the CANONICAL corpus shape
-- (AGENTS.md: `route "/apps/:slug" AppDetailPage`).
--
-- The pre-round-4 `Web.route : String -> page -> WebRoute page` scheme
-- shared ONE type variable between the builder argument and the page, so
-- `Web.route "/u/:id" UserPage` (builder : String -> Page) forced
-- `Page ≟ String -> Page` → a false IPE-T0001 on every param-route app, and
-- the emit tier's `route_param_get` conversion path was dead code.
--
-- Post-fix (per-route witness): nullary routes AND param routes type-check
-- into one routes list, ipec exits 0, the emitted project cargo-builds, and
-- a GET on `/u/:id` delivers the captured param to the page constructor.

import Ipe.Tea.Web as Web
import Ipe.Ui as Ui
import Ipe.Tea.Web.Cmd
import Ipe.String
import Ipe.Tea.Web.Sub

type Page
    = CounterPage
    | UserPage String
    | ItemPage Int
    | FlagPage Bool
    | ScorePage Float

type Msg
    = Increment

type alias Model =
    { page : Page
    , count : Int
    }

init : WebReq -> ( Model, Cmd Msg )
init _req =
    ( { page = CounterPage, count = 0 }, Cmd.none )

update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )

view : Model -> Element Msg
view model =
    case model.page of
        UserPage id ->
            Ui.text ("user:" ++ id)

        CounterPage ->
            Ui.text (String.fromInt model.count)

        ItemPage n ->
            Ui.text ("item:" ++ String.fromInt n)

        FlagPage _ ->
            Ui.text "flag"

        ScorePage _ ->
            Ui.text "score"

subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.none

main =
    Web.tea
        { init = init, update = update, view = view, subscriptions = subscriptions
        , routes =
            [ Web.route "/" CounterPage
            , Web.route "/u/:id" UserPage
            , Web.route "/i/:n" ItemPage
            , Web.route "/f/:b" FlagPage
            , Web.route "/s/:x" ScorePage
            ]
        , notFound = CounterPage
        }
