module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- `Node` declares three fields; this pattern binds only two — IPE-T0013.
type Tree = Leaf | Node Tree Int Tree

f : Tree -> Int
f t =
    case t of
        Leaf -> 0
        Node l r -> 1

main =
    Io.println (String.fromInt (f Leaf))
