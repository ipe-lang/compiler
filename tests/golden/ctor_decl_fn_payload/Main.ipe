module Main exposing (main)
import Ipe.Io as Io

-- #90 Stage 1: a DECLARED function-typed constructor payload used to trip
-- IPE-L0114 at the union declaration (`lower_enum`'s decl-site gate). #87's
-- derive-demotion fixpoint already keeps the emitted enum sound (no derive,
-- `<function>` IpeStringify placeholder), so the declaration site needs no gate.
type Retryish e = RetryAlways | RetryWhen (e -> Bool)

shouldRetry : Retryish Int -> Int -> Bool
shouldRetry r e =
    case r of
        RetryAlways -> True
        RetryWhen f -> f e

main =
    Io.println (if shouldRetry (RetryWhen (\n -> n > 5)) 10 then "retry" else "stop")
