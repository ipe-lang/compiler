module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- REFUTABLE lambda param `\(Just x) ->`: `Just x` fails to match `Nothing`, so a
-- parameter (a binding position) can never be a constructor pattern. Rejected up
-- front as IPE-T0015 — never a runtime match failure.
f : Maybe Int -> Int
f = \(Just x) -> x

main =
    Io.println (String.fromInt (f (Just 1)))
