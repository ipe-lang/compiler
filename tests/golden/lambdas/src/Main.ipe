module Main exposing (main)
import Ipe.Io as Io
import Ipe.String

-- A lambda bound to a name, then applied: `inc 41` is 42.
-- A lambda capturing an outer local: `(\x -> x + n) 5` with n = 10 is 15.
-- A multi-parameter lambda: `add 2 3` is 5.
main =
    let inc = \x -> x + 1 in
    let n = 10 in
    let add = \a b -> a + b in
    let r = inc 41 + (\x -> x + n) 5 + add 2 3 in
    Io.println (String.fromInt r)
