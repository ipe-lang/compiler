module Main exposing (main)

import Ipe.Task as Task
import Ipe.Db as Db
import Ipe.Io as Io
import Ipe.List
import Ipe.String


-- #217 contract-drift regression: `Ipe.Db.Migration` is a record alias
-- `{ name : String, sql : String }` (reference `Std/Db.ipe:237`) and
-- `Db.migrate : Db -> List Migration -> Task Error (List String)`
-- (reference `:300`) — NOT `List (String, String)`. Ported verbatim from
-- the reference migration idiom: record literals in a `List Migration`,
-- plus the `defaultMigration` builder.
--
-- The `defaultMigration "…"` entry exercises the pure record builder;
-- `CREATE TABLE IF NOT EXISTS` keeps repeated runs idempotent. The pipeline
-- recovers any Task error to a fixed marker so the SEAL check (cargo-0 ⇒
-- exit-0) is independent of ambient `ipe.db` state — the point of this test
-- is that the three contract surfaces TYPE-CHECK and EMIT correctly, not the
-- migration engine's runtime behaviour (covered by the m5b_db goldens).
migrations : List Db.Migration
migrations =
    [ { name = "0001_users"
      , sql = "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, email TEXT)"
      }
    , Db.defaultMigration "0002_noop"
    ]


runMigrations : Task Error (List String)
runMigrations =
    Task.andThen (\db -> Db.migrate db migrations) (Db.connect ())


main =
    Task.andThen
        (\names -> Io.println ("applied:" ++ String.fromInt (List.length names)))
        (Task.onError (\_ -> Task.succeed []) runMigrations)
