module Main exposing (main)
import Ipe.Io as Io
import Ipe.Json.Decode
import Ipe.String

-- JsonDec.int decodes an integer or yields a typed rejection — it never
-- silently truncates a non-integral number (parse, don't validate).
--   "3.0" -> Ok 3        (integral float still decodes)
--   "3.5" -> Err _       (non-integral is rejected, shown here as "reject")
--   "1e2" -> Ok 100      (exponent literal, integral magnitude)
-- JsonDec.string rides along to keep the primitive-decoder coverage.
intOrReject : String -> String
intOrReject json =
    case JsonDec.decodeString JsonDec.int json of
        Ok n ->
            String.fromInt n

        Err _ ->
            "reject"


stringOrQ : String -> String
stringOrQ json =
    case JsonDec.decodeString JsonDec.string json of
        Ok s ->
            s

        Err _ ->
            "?"


main =
    Io.println
        (String.join " "
            [ intOrReject "3.0"
            , intOrReject "3.5"
            , intOrReject "1e2"
            , stringOrQ "\"hello\""
            ]
        )
