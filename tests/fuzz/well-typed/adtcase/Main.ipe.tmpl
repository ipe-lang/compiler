-- fuzz-slot n1 : Int 0 99
-- fuzz-slot n2 : Int 0 99
-- fuzz-slot n3 : Int 0 99
module Main exposing (main)

import Ipe.Io as Io
import Ipe.String as String


type Color
    = Red
    | Green
    | Blue


colorValue : Color -> Int
colorValue c =
    case c of
        Red -> @n1@
        Green -> @n2@
        Blue -> @n3@


main =
    Io.println (String.fromInt (colorValue Red + colorValue Green + colorValue Blue))
