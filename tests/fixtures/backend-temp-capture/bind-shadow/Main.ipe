module Main exposing (main)

import Ipe.Io as Io
import Ipe.String as String

-- A user parameter spelled like the backend's tuple-binding temporary. The
-- aliased tuple `let` mints `__ipe_bind_0`; the parameter must keep its own
-- value, so the program prints `100`.


pick : Int -> Int
pick __ipe_bind_0 =
    let
        ( x as p, c ) =
            ( 5, 3 )
    in
    __ipe_bind_0 + p + c - x - c


main =
    Io.println (String.fromInt (pick 100))
