module Main exposing (main)

-- `Ipe.Env.public` — build-time-embedded public config, exercised end-to-end
-- in a real browser: `API_BASE_URL` is allowlisted in this project's
-- `ipe.toml` `[wasm] publicEnv` and embedded at `cargo build` time via
-- `option_env!`; `IPE_AUTH_TOKEN_SECRET` is named directly here (NOT
-- allowlisted — `ipe.toml` would refuse it at parse time if it were) to
-- prove the kernel returns `Nothing` for any key outside the allowlist,
-- never a live read of the raw process/host environment.

import Ipe.Env as Env
import Ipe.Maybe as Maybe
import Ipe.Tea.Web exposing (tea)
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import Ipe.Ui as Ui


type Page
    = ConfigPage


type Msg
    = NoOp


type alias Model =
    { apiBaseUrl : String
    , secretProbe : String
    }


init : WebReq -> ( Model, Cmd Msg )
init _req =
    ( { apiBaseUrl = Maybe.withDefault "(none)" (Env.public "API_BASE_URL")
      , secretProbe = Maybe.withDefault "(none)" (Env.public "IPE_AUTH_TOKEN_SECRET")
      }
    , Cmd.none
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update _msg model =
    ( model, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.none


view : Model -> Element Msg
view model =
    Ui.column
        [ Ui.spacing 14, Ui.padding 32 ]
        [ Ui.el [ Ui.htmlAttribute "id" "public-env-heading" ] (Ui.text "Ipe.Env.public build-time config")
        , Ui.row
            [ Ui.spacing 12 ]
            [ Ui.el [] (Ui.text "API_BASE_URL:")
            , Ui.el [ Ui.htmlAttribute "id" "api-base-url" ] (Ui.text model.apiBaseUrl)
            ]
        , Ui.row
            [ Ui.spacing 12 ]
            [ Ui.el [] (Ui.text "IPE_AUTH_TOKEN_SECRET (must read as none):")
            , Ui.el [ Ui.htmlAttribute "id" "secret-probe" ] (Ui.text model.secretProbe)
            ]
        ]


main =
    tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = []
        , notFound = ConfigPage
        }
