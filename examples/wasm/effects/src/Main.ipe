module Main exposing (main)

-- M4 Cmd/Sub browser-effects bridge, exercised end-to-end in a real browser:
--   * Sub.every          -> gloo-timers interval  (ticks counter)
--   * Log.info            -> console.info          (via Cmd.perform)
--   * Random.int           -> crypto.getRandomValues (via Cmd.perform)
--   * PubSub.publish / Sub.subscribeTopic -> the in-tab pub/sub broker
--   * Http.get              -> fetch                (a typed absolute Url; CORS)
--
-- The WebSocket client has its own example (`examples/wasm/websocket`).

import Ipe.Http as Http
import Ipe.Log as Log
import Ipe.PubSub as PubSub
import Ipe.Random as Random
import Ipe.String as String
import Ipe.Task as Task
import Ipe.Tea.Web exposing (tea)
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import Ipe.Ui as Ui
import Ipe.Ui.Background as Background
import Ipe.Ui.Border as Border
import Ipe.Ui.Font as Font
import Ipe.Url as Url


type Page
    = EffectsPage


-- The shared topic handle. Its `String` payload type is what `publish` and
-- `Sub.subscribeTopic` on the same value must agree on.
pingTopic : PubSub.Topic String
pingTopic =
    PubSub.topic "wasm-effects-ping"


type Msg
    = Tick
    | LogClicked
    | LogDone (Result Error ())
    | RollDice
    | GotDice (Result Error Int)
    | PingClicked
    | GotPingCount (Result Error Int)
    | GotPing String
    | FetchClicked
    | GotFetch (Result Error String)


type alias Model =
    { ticks : Int
    , dice : Int
    , lastLog : String
    , pings : Int
    , lastPing : String
    , fetchStatus : String
    }


init : WebReq -> ( Model, Cmd Msg )
init _req =
    ( { ticks = 0
      , dice = 0
      , lastLog = "(not logged yet)"
      , pings = 0
      , lastPing = "(none)"
      , fetchStatus = "(not fetched yet)"
      }
    , Cmd.none
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Tick ->
            ( { model | ticks = model.ticks + 1 }, Cmd.none )

        LogClicked ->
            ( model
            , Cmd.perform (Log.info ("wasm-effects tick " ++ String.fromInt model.ticks)) LogDone
            )

        LogDone result ->
            case result of
                Ok _ ->
                    ( { model | lastLog = "logged (see devtools console)" }, Cmd.none )

                Err e ->
                    ( { model | lastLog = "log failed: " ++ errorToString e }, Cmd.none )

        RollDice ->
            ( model, Cmd.perform (Random.int 1 6) GotDice )

        GotDice result ->
            case result of
                Ok n ->
                    ( { model | dice = n }, Cmd.none )

                Err _ ->
                    ( model, Cmd.none )

        PingClicked ->
            ( model
            , Cmd.perform (PubSub.publish pingTopic "hello-from-ping") GotPingCount
            )

        GotPingCount result ->
            case result of
                Ok n ->
                    ( { model | lastPing = "published to " ++ String.fromInt n ++ " subscriber(s)" }, Cmd.none )

                Err e ->
                    ( { model | lastPing = "publish failed: " ++ errorToString e }, Cmd.none )

        GotPing payload ->
            ( { model | pings = model.pings + 1, lastPing = "received: " ++ payload }, Cmd.none )

        FetchClicked ->
            case Url.fromString "https://example.com/" of
                Ok url ->
                    ( { model | fetchStatus = "fetching..." }
                    , Cmd.perform (Task.map summarizeResponse (Http.get url)) GotFetch
                    )

                Err e ->
                    ( { model | fetchStatus = "bad URL: " ++ errorToString e }, Cmd.none )

        GotFetch result ->
            case result of
                Ok summary ->
                    ( { model | fetchStatus = summary }, Cmd.none )

                Err e ->
                    ( { model | fetchStatus = "fetch failed: " ++ errorToString e }, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.batch
        [ Sub.every 1000 Tick
        , Sub.subscribeTopic pingTopic GotPing
        ]


summarizeResponse resp =
    "status=" ++ String.fromInt resp.status ++ " bytes=" ++ String.fromInt (String.length resp.body)


labelled : String -> Ui.Element Msg -> Ui.Element Msg
labelled label content =
    Ui.row [ Ui.spacing 12 ] [ Ui.el [ Font.bold ] (Ui.text label), content ]


actionButton : Msg -> String -> Ui.Element Msg
actionButton msg label =
    Ui.button
        [ Ui.padding 8, Background.color (Ui.rgb 37 99 235), Font.color (Ui.rgb 255 255 255), Border.rounded 6 ]
        { onPress = Just msg, label = Ui.text label }


view : Model -> Element Msg
view model =
    Ui.column
        [ Ui.spacing 14, Ui.padding 32 ]
        [ Ui.el [ Font.size 20, Font.bold ] (Ui.text "M4 Cmd/Sub browser-effects bridge")
        , labelled "ticks (Sub.every):" (Ui.el [] (Ui.text (String.fromInt model.ticks)))
        , Ui.row
            [ Ui.spacing 12 ]
            [ actionButton LogClicked "Log.info"
            , Ui.el [] (Ui.text model.lastLog)
            ]
        , Ui.row
            [ Ui.spacing 12 ]
            [ actionButton RollDice "Random.int 1 6"
            , Ui.el [] (Ui.text ("dice: " ++ String.fromInt model.dice))
            ]
        , Ui.row
            [ Ui.spacing 12 ]
            [ actionButton PingClicked "PubSub.publish"
            , Ui.el [] (Ui.text ("pings received: " ++ String.fromInt model.pings ++ " / " ++ model.lastPing))
            ]
        , Ui.row
            [ Ui.spacing 12 ]
            [ actionButton FetchClicked "Http.get"
            , Ui.el [] (Ui.text model.fetchStatus)
            ]
        ]


main =
    tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = []
        , notFound = EffectsPage
        }
