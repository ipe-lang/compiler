module Main exposing (main)

-- M7 Hydration example: SSR paint + WASM client takeover.
--
-- The server renders the initial HTML with an embedded island blob
-- (a `<script type="application/ipe-model+json">` tag) containing the
-- serialised `HydrationState`. On boot the WASM `hydrate(json)` export
-- parses that blob, converts it to `Model` via `fromHydrationState`, and
-- adopts the server-rendered DOM without re-rendering.
--
-- Gate properties demonstrated:
--   * `HydrationState` carries only client-safe data types (Int, String).
--   * `fromHydrationState` converts the hydration record to the app Model.
--   * The first client diff is empty — SSR and client view are deterministic.
--   * A tampered / missing island falls back to clean init (count = 0).
--
-- KNOWN GAP (issue #224): the emitted `hydrate()` glue references a
-- `MainHydrationState` type the record-alias emitter does not produce, so this
-- example does not yet `cargo build` for wasm. It is excluded from the examples
-- sweep until that codegen defect is fixed; the source below is already on the
-- current Web shape. Its `htmlView : Model -> Html Msg` authors the DOM directly
-- with `Ipe.Html`, reached through the `Ui.html` node inside the single
-- `Element` view that `Web.tea` takes.

import Ipe.Html as Html
import Ipe.Html.Attributes as Attr
import Ipe.Html.Events exposing (onClick)
import Ipe.String as String
import Ipe.Tea.Web exposing (tea)
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import Ipe.Ui as Ui
import Ipe.Ui exposing (Element)


-- The island type: only serialisable fields.
-- A `Secret` or `Db` field here is a compile error (M7 field-type gate).
type alias HydrationState =
    { count : Int
    }


type Msg
    = Increment
    | Decrement
    | Reset


type alias Model =
    { count : Int
    }


-- Converts the hydrated island state to the live Model.
fromHydrationState : HydrationState -> Model
fromHydrationState hs =
    { count = hs.count }


init : WebReq -> ( Model, Cmd Msg )
init _req =
    ( { count = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )

        Decrement ->
            ( { model | count = model.count - 1 }, Cmd.none )

        Reset ->
            ( { model | count = 0 }, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.none


htmlView : Model -> Html Msg
htmlView model =
    Html.div []
        [ Html.h1 [] [ Html.text "Ipê Hydration Counter" ]
        , Html.p
            [ Attr.attribute "data-testid" "count" ]
            [ Html.text (String.fromInt model.count) ]
        , Html.button
            [ Attr.attribute "data-testid" "increment"
            , onClick Increment
            ]
            [ Html.text "+" ]
        , Html.button
            [ Attr.attribute "data-testid" "decrement"
            , onClick Decrement
            ]
            [ Html.text "−" ]
        , Html.button
            [ Attr.attribute "data-testid" "reset"
            , onClick Reset
            ]
            [ Html.text "Reset" ]
        ]


view : Model -> Element Msg
view model =
    Ui.html (htmlView model)


main =
    tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = []
        , notFound = {}
        }
