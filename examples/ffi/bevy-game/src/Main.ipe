module Main exposing (main)

-- A headless bevy_ecs "world tick" driven entirely from Ipê, over the REAL
-- crates.io `bevy_ecs` crate, auto-FFI-bound shim-free. Bevy's `World` is the
-- ECS core. Here we create one and thread it LINEARLY through a sequence of
-- real ECS maintenance operations — the work a schedule does between frames:
-- flush command queues, clear trackers, clear entities — then read the world's
-- final change tick (the ECS clock) and entity count as observable state.
--
-- Every `World.*` / `Tick.*` call is a generated binding — no hand-written Rust.
--
-- The world is threaded, never duplicated: each maintenance step consumes the
-- world and returns it (`World -> Result Error World`), so the value is used
-- exactly once per step. An opaque foreign handle for a non-`Clone` Rust type
-- (bevy's `World` is `!Clone`) cannot be duplicated, so a linear thread is the
-- only shape the shim-free FFI can compile.

import Ipe.Error as Error exposing (Error)
import Ipe.Io as Io
import Ipe.Result as Result
import Ipe.String as String
import Ipe.Task as Task
import Rust.Bevy_ecs as Ecs


-- One maintenance step: run `op` on the world, log `label`, hand the world on.
step : String -> (Ecs.WorldWorld -> Result Error Ecs.WorldWorld) -> Ecs.WorldWorld -> Task Error Ecs.WorldWorld
step label op world =
    op world
        |> Task.fromResult
        |> Task.andThen
            (\next ->
                Io.println ("[world] " ++ label)
                    |> Task.map (\_ -> next)
            )


play : Task Error Int
play =
    Ecs.new_from_worldWorld ()
        |> Task.fromResult
        |> Task.andThen
            (\world ->
                Io.println "bevy_ecs World created."
                    |> Task.map (\_ -> world)
            )
        |> Task.andThen (step "flush command queue" Ecs.flush_from_worldWorld)
        |> Task.andThen (step "clear change trackers" Ecs.clear_trackers_from_worldWorld)
        |> Task.andThen (step "clear all entities" Ecs.clear_entities_from_worldWorld)
        |> Task.andThen (step "flush command queue" Ecs.flush_from_worldWorld)
        -- Two reads, threaded: a by-borrow `&self` reader returns
        -- `(value, world)`, so the world flows on to the next read without a
        -- clone or the IPE-L0130 gate. `entity_count` reads, hands the world
        -- back; `change_tick` reads the same threaded world; we combine both.
        |> Task.andThen (\w -> Ecs.entity_count_from_worldWorld w |> Task.fromResult)
        |> Task.andThen
            (\( count, world ) ->
                Ecs.change_tick_from_worldWorld world
                    |> Result.map (\( _, _ ) -> count)
                    |> Task.fromResult
            )


main : Task Error ()
main =
    play
        |> Task.andThen
            (\count ->
                Io.println
                    ("headless bevy_ecs world tick finished; final entity count = "
                        ++ String.fromInt count
                    )
            )
        |> Task.onError (\err -> Io.println ("bevy_ecs error: " ++ Error.toString err))
