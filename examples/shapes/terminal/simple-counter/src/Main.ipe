module Main exposing (main)

{-|
A line-oriented TEA counter using `Cli.tea`.

Line input is a subscription: `subscriptions` returns `Sub.onLine onLine`,
and `onLine : String -> Msg` maps each stdin line to a `Msg` — the same
`init / update / view / subscriptions` shape as every other TEA app.

Type:
    +     increment
    -     decrement
    r     reset to zero
    q     quit (or Ctrl-D)
-}

import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task
import Ipe.Tea.Cli as Cli
import Ipe.Tea.Cli.Cmd as Cmd
import Ipe.Tea.Cli.Sub as Sub
import Ipe.Ui.Cli as Ui
import Ipe.Ui.Cli exposing (Lines)


type Msg
    = Increment
    | Decrement
    | Reset
    | Quit
    | NoOp


type alias Model =
    { count : Int }


init : () -> ( Model, Cmd Msg )
init _ =
    ( { count = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )

        Decrement ->
            ( { model | count = model.count - 1 }, Cmd.none )

        Reset ->
            ( { count = 0 }, Cmd.none )

        Quit ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        NoOp ->
            ( model, Cmd.none )


view : Model -> Lines Msg
view model =
    Ui.text ("count=" ++ String.fromInt model.count ++ "  (+, -, r, q) > ")


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.onLine onLine


onLine : String -> Msg
onLine line =
    case String.trim line of
        "+" ->
            Increment

        "-" ->
            Decrement

        "r" ->
            Reset

        "q" ->
            Quit

        _ ->
            NoOp


main =
    Cli.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
