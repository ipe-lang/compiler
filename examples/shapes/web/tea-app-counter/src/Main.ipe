module Main exposing (main)

-- | tea-app-counter — the `Web.tea` entry over the closed Web renderer.
--
-- Proves the toolbox-model view-ful path end-to-end: the `view` field is
-- `Model -> Element Msg`, the DOM view carrier, so every existing `Ipe.Ui`
-- combinator populates it with no parallel surface. The cfg is the Web app
-- surface (`init` / `update` / `view` / `subscriptions` plus the routing
-- fields), and the app produces a `Program Web Msg`.
--
-- Co-located, no capabilities, no JS ports: a pure counter over the closed Web
-- renderer.

import Ipe.String as String
import Ipe.Tea.Web as Web
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import Ipe.Ui as Ui


type alias Model =
    { count : Int }


type Msg
    = Increment
    | Decrement
    | NoOp


init : WebReq -> ( Model, Cmd.Cmd Msg )
init _req =
    ( { count = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd.Cmd Msg )
update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )

        Decrement ->
            ( { model | count = model.count - 1 }, Cmd.none )

        NoOp ->
            ( model, Cmd.none )


subscriptions : Model -> Sub.Sub Msg
subscriptions _model =
    Sub.none


view : Model -> Element Msg
view model =
    Ui.column []
        [ Ui.button [] { onPress = Just Increment, label = Ui.text "+" }
        , Ui.text (String.fromInt model.count)
        , Ui.button [] { onPress = Just Decrement, label = Ui.text "-" }
        ]


main =
    Web.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = []
        , notFound = NoOp
        }
