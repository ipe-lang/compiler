module Package exposing (package)

import Ipe.Package exposing (..)


package : Package
package =
    { name = "wasm-client-clipboard"
    , version = "0.1.0"
    , wasm = On { mode = Render }
    , capabilities =
        { declares = []
        -- `Ipe.Browser.Clipboard` discloses its own port axis and the `:raw`
        -- floor it reaches through `Js.send`/`Js.subscribe`.
        , accepts = [ JsPort Clipboard, JsPort Raw ]
        }
    }
