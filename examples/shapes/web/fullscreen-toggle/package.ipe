module Package exposing (package)

import Ipe.Package exposing (..)


package : Package
package =
    { name = "fullscreen-toggle"
    , version = "0.1.0"
    , capabilities =
        { declares = []
        -- The `Ipe.Browser.Fullscreen` import discloses `js-port:fullscreen`;
        -- the `:raw` floor is also disclosed. Both must be accepted here or the
        -- build fails closed (IPE-S0002).
        , accepts = [ JsPort Fullscreen, JsPort Raw ]
        }
    }
