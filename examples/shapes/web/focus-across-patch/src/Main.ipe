module Main exposing (main)

-- | focus-across-patch — a patch never moves keyboard focus.
--
-- The root column takes focus when the page loads and handles every key, so a
-- key works wherever focus sits below it. `add` appends a row and `drop`
-- removes itself, each changing the panel's children (the client swaps the
-- panel); `Escape` toggles the row from the keyboard. The note field sits
-- ahead of the row so its position survives either change. `swap` replaces
-- itself with another focusable control at the same position, which is not the
-- node that held focus. `press` replaces its keyed item with one whose key
-- spells the button's own identity, one level up. The form holds a control
-- named after each DOM member the client reads on a node that may be a form,
-- which shadows that member on the form, and a field to type in. The form
-- gains a row on `Escape`, so the client swaps a form's children; `fdrop`
-- removes itself from it, so focus falls back to the form. `fgrow` (inside the
-- form) and `nfocus` (after it) each add a row beside the form, so the client
-- swaps the form's parent with focus inside or after the form. `escname` is a
-- field whose `name` holds a backslash and a newline; `Escape` puts a row ahead
-- of it, so the swap finds it again by name. `m` puts a row beside the
-- focusable MathML element `mfocus`.
-- Clicking `xdeep` replaces its keyed chain with one whose keys absorb the
-- next id segment, so a node at the same depth carries the same id under a
-- different chain. `tbutton` (a `button` named `x`) is replaced by an element
-- whose tag is `button:x`, which carries the same id under another tag.
-- `F2` toggles a panel whose `autofocus` field `ask` appears in answer to the
-- key press. `F3` arms a timer whose tick adds the `autofocus` field `subask`,
-- a render no event of the tab caused. A query holding `noauto` leaves the
-- root without `autofocus`, so focus stays on the body at load; one holding
-- `tick` arms the timer from the start. Picking a file in `pick` adds the
-- `autofocus` field `fileask` once the file is read. `q` toggles `autofocus`
-- on the element `flag` already on screen. `z` adds a second row to the table
-- body `tb`.
-- `F4` arms a timer whose tick replaces `fchild` inside the focusable column
-- `fhost`; once that tick has landed, `fhost`'s `onFocus` adds the `autofocus`
-- field `focusask`, so focus the runtime puts back on `fhost` raises it. `F5`
-- arms a timer whose tick puts a row ahead of `hovertarget`, moving it to
-- where `hoverbelow` was; once that tick has landed, a pointer crossing into
-- `hovertarget` adds the `autofocus` field `hoverask`.
-- A query holding `frame` makes the first tick add two frames of the fixture's
-- own root, which carries `autofocus`: `frame`, built with `Html.iframe`, and
-- `rawframe`, inside `Ipe.Html.Unsafe.unsafeRaw` markup.
-- The focusable column `keephost` holds three controls, each made unfocusable
-- by an attribute written in place on it: `F7` drops `untab`'s `tabindex`,
-- clicking `disableself` disables it and clicking `hideself` gives it
-- `hidden`. `F6` drops `untab`'s `tabindex` and adds a row after it in the
-- same render, so the client swaps `keephost`'s children instead.
--
-- Co-located, no JS ports; `rawframe` is why the package accepts `Unsafe`.

import Ipe.Html as Html
import Ipe.Html.Attributes as Attr
import Ipe.Html.Unsafe as Unsafe
import Ipe.String as String
import Ipe.Tea.Web as Web
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import Ipe.Ui as Ui
import Ipe.Ui.Input as Input
import Ipe.Ui.Keyed as Keyed


type alias Model =
    { keys : String
    , row : Bool
    , drop : Bool
    , note : String
    , swapped : Bool
    , pressed : Bool
    , deep : Bool
    , tagSwapped : Bool
    , hostRow : Bool
    , formDrop : Bool
    , mathRow : Bool
    , ask : Bool
    , answer : String
    , ticking : Bool
    , subAsk : Bool
    , loadAuto : Bool
    , picked : Bool
    , flag : Bool
    , tableRow : Bool
    , shifting : Bool
    , shifted : Bool
    , focusAsk : Bool
    , hovering : Bool
    , hoverShift : Bool
    , hoverAsk : Bool
    , framing : Bool
    , framed : Bool
    , untabbed : Bool
    , selfDisabled : Bool
    , selfHidden : Bool
    , keepRow : Bool
    }


type Msg
    = KeyDown String
    | AddRow
    | DropButton
    | Note String
    | Swap
    | Press
    | Deep
    | TagSwap
    | Grow
    | FormDrop
    | Answer String
    | Tick
    | Picked String
    | Focused
    | Hovered
    | DisableSelf
    | HideSelf
    | NoOp


init : WebReq -> ( Model, Cmd.Cmd Msg )
init req =
    ( { keys = "", row = False, drop = True, note = "", swapped = False, pressed = False, deep = False, tagSwapped = False, hostRow = False, formDrop = True, mathRow = False, ask = False, answer = "", ticking = String.contains "tick" req.query, subAsk = False, loadAuto = not (String.contains "noauto" req.query), picked = False, flag = False, tableRow = False, shifting = False, shifted = False, focusAsk = False, hovering = False, hoverShift = False, hoverAsk = False, framing = String.contains "frame" req.query, framed = False, untabbed = False, selfDisabled = False, selfHidden = False, keepRow = False }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd.Cmd Msg )
update msg model =
    case msg of
        KeyDown key ->
            if key == "Escape" then
                ( { model | keys = key, row = not model.row }, Cmd.none )

            else if key == "m" then
                ( { model | keys = key, mathRow = not model.mathRow }, Cmd.none )

            else if key == "F2" then
                ( { model | keys = key, ask = not model.ask }, Cmd.none )

            else if key == "F3" then
                ( { model | keys = key, ticking = True }, Cmd.none )

            else if key == "q" then
                ( { model | keys = key, flag = not model.flag }, Cmd.none )

            else if key == "z" then
                ( { model | keys = key, tableRow = not model.tableRow }, Cmd.none )

            else if key == "F4" then
                ( { model | keys = key, shifting = True }, Cmd.none )

            else if key == "F5" then
                ( { model | keys = key, hovering = True }, Cmd.none )

            else if key == "F6" then
                ( { model | keys = key, untabbed = True, keepRow = True }, Cmd.none )

            else if key == "F7" then
                ( { model | keys = key, untabbed = True }, Cmd.none )

            else
                ( { model | keys = key }, Cmd.none )

        AddRow ->
            ( { model | row = True }, Cmd.none )

        DropButton ->
            ( { model | drop = False }, Cmd.none )

        Note text ->
            ( { model | note = text }, Cmd.none )

        Swap ->
            ( { model | swapped = True }, Cmd.none )

        Press ->
            ( { model | pressed = True }, Cmd.none )

        Deep ->
            ( { model | deep = True }, Cmd.none )

        TagSwap ->
            ( { model | tagSwapped = True }, Cmd.none )

        Grow ->
            ( { model | hostRow = True }, Cmd.none )

        FormDrop ->
            ( { model | formDrop = False }, Cmd.none )

        Answer text ->
            ( { model | answer = text }, Cmd.none )

        Tick ->
            ( { model
                | ticking = False
                , subAsk = model.subAsk || model.ticking
                , shifting = False
                , shifted = model.shifted || model.shifting
                , hovering = False
                , hoverShift = model.hoverShift || model.hovering
                , framed = model.framed || (model.framing && model.ticking)
              }
            , Cmd.none
            )

        Picked _ ->
            ( { model | picked = True }, Cmd.none )

        Focused ->
            ( { model | focusAsk = model.focusAsk || model.shifted }, Cmd.none )

        Hovered ->
            ( { model | hoverAsk = model.hoverAsk || model.hoverShift }, Cmd.none )

        DisableSelf ->
            ( { model | selfDisabled = True }, Cmd.none )

        HideSelf ->
            ( { model | selfHidden = True }, Cmd.none )

        NoOp ->
            ( model, Cmd.none )


subscriptions : Model -> Sub.Sub Msg
subscriptions model =
    if model.ticking || model.shifting || model.hovering then
        Sub.every 100 Tick

    else
        Sub.none


panelRow : Model -> List (Ui.Element Msg)
panelRow model =
    if model.row then
        [ Ui.el [ Ui.id "row" ] (Ui.text "row") ]

    else
        []


panelDrop : Model -> List (Ui.Element Msg)
panelDrop model =
    if model.drop then
        [ Ui.button [ Ui.id "drop" ] { onPress = Just DropButton, label = Ui.text "drop" } ]

    else
        []


swapSlot : Model -> Ui.Element Msg
swapSlot model =
    if model.swapped then
        Ui.el [ Ui.id "swapped", Ui.htmlAttribute "tabindex" "0" ] (Ui.text "swapped")

    else
        Ui.button [ Ui.id "swap" ] { onPress = Just Swap, label = Ui.text "swap" }


-- The pressed item's key `k_0_button` makes its server identity the one the
-- `press` button held, `<column>_0_div:k_0_button`, one level higher.
keyedItems : Model -> List ( String, Ui.Element Msg )
keyedItems model =
    if model.pressed then
        [ ( "k_0_button", Ui.el [ Ui.id "kspoof", Ui.htmlAttribute "tabindex" "0" ] (Ui.text "spoof") )
        , ( "tail", Ui.el [ Ui.id "ktail" ] (Ui.text "tail") )
        ]

    else
        [ ( "k", Ui.el [ Ui.id "kitem" ] (Ui.button [ Ui.id "kbutton" ] { onPress = Just Press, label = Ui.text "press" }) ) ]


-- Before: item `a` > unkeyed column > `xdeep` keyed `b_0_div`. After: item
-- `a_0_div` > div keyed `b` > unkeyed `ydeep`. Both deepest nodes are divs
-- with id `<column>_0_div:a_0_div_0_div:b_0_div`; their parents' ids differ.
deepItems : Model -> List ( String, Ui.Element Msg )
deepItems model =
    if model.deep then
        [ ( "a_0_div"
          , Keyed.column
                []
                [ ( "b", Ui.el [] (Ui.el [ Ui.id "ydeep", Ui.htmlAttribute "tabindex" "0" ] (Ui.text "y")) ) ]
          )
        , ( "deeptail", Ui.el [ Ui.id "deeptail" ] (Ui.text "tail") )
        ]

    else
        [ ( "a"
          , Ui.el []
                (Keyed.column []
                    [ ( "b_0_div"
                      , Ui.el
                            [ Ui.id "xdeep", Ui.htmlAttribute "tabindex" "0", Ui.onClick Deep ]
                            (Ui.text "x")
                      )
                    ]
                )
          )
        ]


-- A `button` named `x` and a `button:x` element both get id `<column>_0_button:x`.
tagSlot : Model -> Ui.Element Msg
tagSlot model =
    if model.tagSwapped then
        Ui.html
            (Html.node
                "button:x"
                [ Attr.id "tspoof", Attr.attribute "tabindex" "0" ]
                [ Html.text "spoof" ]
            )

    else
        Ui.button
            [ Ui.id "tbutton", Ui.htmlAttribute "name" "x" ]
            { onPress = Just TagSwap, label = Ui.text "tag" }


formRow : Model -> List (Ui.Element Msg)
formRow model =
    if model.row then
        [ Ui.el [ Ui.id "formrow" ] (Ui.text "form row") ]

    else
        []


hostRow : Model -> List (Ui.Element Msg)
hostRow model =
    if model.hostRow then
        [ Ui.el [ Ui.id "hostrow" ] (Ui.text "host row") ]

    else
        []


formDrop : Model -> List (Ui.Element Msg)
formDrop model =
    if model.formDrop then
        [ Ui.button
            [ Ui.id "fdrop", Ui.htmlAttribute "type" "button" ]
            { onPress = Just FormDrop, label = Ui.text "form drop" }
        ]

    else
        []


-- A disabled button named `member`: the form's `member` property answers with it.
shadow : String -> Ui.Element Msg
shadow member =
    Ui.button
        [ Ui.htmlAttribute "name" member ]
        { onPress = Nothing, label = Ui.text member }


-- The form carries `data-drop` while its `fdrop` button stands and
-- `data-dropped` once it is gone, so the patch that removes the button both
-- removes and sets an attribute on the form.
dropMarks : Model -> List (Ui.Attribute Msg)
dropMarks model =
    if model.formDrop then
        [ Ui.htmlAttribute "data-drop" "kept" ]

    else
        [ Ui.htmlAttribute "data-dropped" "yes" ]


-- The form's first child holds the `appendChild` control, so the commit's
-- second append reads it; `firstChild` and `firstElementChild` sit one level
-- down, so a lookup through the form answers with a node that is not its
-- child.
shadowingForm : Model -> Ui.Element Msg
shadowingForm model =
    Ui.form
        ([ Ui.id "form"
         , Ui.htmlAttribute "tabindex" "0"
         ]
            ++ dropMarks model
        )
        ([ shadow "appendChild"
         , Ui.button
            [ Ui.id "rc", Ui.htmlAttribute "name" "removeChild" ]
            { onPress = Nothing, label = Ui.text "named control" }
         , Ui.button
            [ Ui.id "pe", Ui.htmlAttribute "name" "parentElement" ]
            { onPress = Nothing, label = Ui.text "named walk" }
         , Ui.el [] (shadow "firstChild")
         , Ui.el [] (shadow "firstElementChild")
         , shadow "querySelectorAll"
         , shadow "contains"
         , shadow "getAttribute"
         , shadow "tagName"
         , shadow "previousElementSibling"
         , shadow "nextElementSibling"
         , shadow "namespaceURI"
         , shadow "replaceChild"
         , shadow "focus"
         , shadow "setAttribute"
         , shadow "removeAttribute"
         , shadow "closest"
         , Ui.el [ Ui.id "formlabel" ] (Ui.text "form label")
         , Ui.el
            [ Ui.id "fgrow", Ui.htmlAttribute "tabindex" "0", Ui.onClick Grow ]
            (Ui.text "grow")
         ]
            ++ formDrop model
            ++ [ Ui.input
                    [ Ui.id "typed"
                    , Ui.htmlAttribute "name" "typed"
                    , Ui.htmlAttribute "aria-label" "Form field"
                    ]
               ]
            ++ formRow model
        )


escRow : Model -> List (Ui.Element Msg)
escRow model =
    if model.row then
        [ Ui.el [ Ui.id "escrow" ] (Ui.text "esc row") ]

    else
        []


mathRow : Model -> List (Ui.Element Msg)
mathRow model =
    if model.mathRow then
        [ Ui.el [ Ui.id "mathrow" ] (Ui.text "math row") ]

    else
        []


askField : String -> Model -> Ui.Element Msg
askField name model =
    Input.text
        [ Ui.id name, Ui.htmlAttribute "autofocus" "" ]
        { label = Input.labelHidden name
        , text = model.answer
        , onChange = Answer
        , placeholder = Nothing
        }


-- `name` while `shown`, else nothing.
askPanel : Bool -> String -> Model -> List (Ui.Element Msg)
askPanel shown name model =
    if shown then
        [ askField name model ]

    else
        []


-- While `on`, a mark and an `autofocus` with a non-empty value: the client
-- patches both onto the element already on screen.
flagAttrs : Bool -> List (Ui.Attribute Msg)
flagAttrs on =
    if on then
        [ Ui.htmlAttribute "data-on" "yes", Ui.htmlAttribute "autofocus" "autofocus" ]

    else
        []


-- The body's second row while `on`: the client swaps the body's children.
tableRows : Bool -> List (Html.Html Msg)
tableRows on =
    if on then
        [ Html.node "tr" [] [ Html.node "td" [ Attr.id "two" ] [ Html.text "two" ] ] ]

    else
        []


-- `fhost`'s child: a focusable `fchild`, or after the `F4` tick a row of
-- another tag in its place, so the tick's patch swaps `fhost`'s children and
-- focus on `fchild` falls back to `fhost`. A row of the same tag would be
-- patched in place, and focus would drop to the body with nothing to put back.
shiftSlot : Bool -> Ui.Element Msg
shiftSlot shifted =
    if shifted then
        Ui.html (Html.node "p" [ Attr.id "shiftrow" ] [ Html.text "shifted" ])

    else
        Ui.el [ Ui.id "fchild", Ui.htmlAttribute "tabindex" "0" ] (Ui.text "child")


-- A row ahead of `hovertarget` once the `F5` tick has landed, as tall as it.
hoverPad : Bool -> List (Ui.Element Msg)
hoverPad shifted =
    if shifted then
        [ Ui.el [ Ui.id "hoverpad" ] (Ui.text "pad") ]

    else
        []


-- Once `on`, a frame of the fixture's root built with `Html.iframe`, and one
-- inside raw markup.
frames : Bool -> List (Ui.Element Msg)
frames on =
    if on then
        [ Ui.html (Html.iframe [ Attr.id "frame", Attr.attribute "src" "/" ] [])
        , Ui.html (Html.div [ Attr.id "rawhost" ] [ Unsafe.unsafeRaw "<iframe id=\"rawframe\" src=\"/\"></iframe>" ])
        ]

    else
        []


-- `untab`'s `tabindex` until `F6` or `F7`.
untabAttrs : Bool -> List (Ui.Attribute Msg)
untabAttrs untabbed =
    if untabbed then
        []

    else
        [ Ui.htmlAttribute "tabindex" "0" ]


-- `hideself`'s `hidden` once it is clicked.
hiddenAttrs : Bool -> List (Ui.Attribute Msg)
hiddenAttrs hidden =
    if hidden then
        [ Ui.htmlAttribute "hidden" "" ]

    else
        []


-- What `disableself` sends while it is enabled.
disablePress : Bool -> Maybe Msg
disablePress disabled =
    if disabled then
        Nothing

    else
        Just DisableSelf


-- The row `F6` adds after `keephost`'s controls.
keepRow : Bool -> List (Ui.Element Msg)
keepRow on =
    if on then
        [ Ui.el [ Ui.id "keeprow" ] (Ui.text "keep row") ]

    else
        []


-- The focusable column whose controls each become unfocusable in place.
keepHost : Model -> Ui.Element Msg
keepHost model =
    Ui.column
        [ Ui.id "keephost", Ui.htmlAttribute "tabindex" "-1" ]
        ([ Ui.el (Ui.id "untab" :: untabAttrs model.untabbed) (Ui.text "untab")
         , Ui.button [ Ui.id "disableself" ] { onPress = disablePress model.selfDisabled, label = Ui.text "disable" }
         , Ui.el
            ([ Ui.id "hideself", Ui.htmlAttribute "tabindex" "0", Ui.onClick HideSelf ] ++ hiddenAttrs model.selfHidden)
            (Ui.text "hide")
         ]
            ++ keepRow model.keepRow
        )


-- The root's `autofocus` unless the page loaded with `noauto`.
rootAutofocus : Model -> List (Ui.Attribute Msg)
rootAutofocus model =
    if model.loadAuto then
        [ Ui.htmlAttribute "autofocus" "" ]

    else
        []


view : Model -> Ui.Element Msg
view model =
    Ui.column
        ([ Ui.id "root"
         , Ui.onKeyDown KeyDown
         , Ui.htmlAttribute "tabindex" "0"
         ]
            ++ rootAutofocus model
        )
        [ Ui.el [ Ui.id "keys" ] (Ui.text ("keys: " ++ model.keys))
        , Ui.column
            [ Ui.id "panel" ]
            ([ Ui.button [ Ui.id "add" ] { onPress = Just AddRow, label = Ui.text "add" }
             , Input.text
                [ Ui.id "note" ]
                { label = Input.labelHidden "Note"
                , text = model.note
                , onChange = Note
                , placeholder = Nothing
                }
             ]
                ++ panelRow model
                ++ panelDrop model
            )
        , Ui.column [ Ui.id "swapper" ] [ swapSlot model ]
        , Keyed.column [ Ui.id "keyed" ] (keyedItems model)
        , Keyed.column [ Ui.id "deep" ] (deepItems model)
        , Ui.column [ Ui.id "tagswap" ] [ tagSlot model ]
        , Ui.column
            [ Ui.id "formhost" ]
            ([ shadowingForm model
             , Ui.el
                [ Ui.id "nfocus", Ui.htmlAttribute "tabindex" "0", Ui.onClick Grow ]
                (Ui.text "after form")
             ]
                ++ hostRow model
            )
        , Ui.column
            [ Ui.id "eschost" ]
            (escRow model
                ++ [ Ui.input
                        [ Ui.id "escname"
                        , Ui.htmlAttribute "name" "a\\b\nc"
                        , Ui.htmlAttribute "aria-label" "Escaped name"
                        ]
                   ]
            )
        , Ui.column
            [ Ui.id "mathhost" ]
            (Ui.html
                (Html.node
                    "math"
                    [ Attr.id "mfocus", Attr.attribute "tabindex" "0" ]
                    [ Html.node "mi" [] [ Html.text "x" ] ]
                )
                :: mathRow model
            )
        , Ui.column [ Ui.id "askhost" ] (askPanel model.ask "ask" model)
        , Ui.column [ Ui.id "subaskhost" ] (askPanel model.subAsk "subask" model)
        , Ui.column
            [ Ui.id "pickhost" ]
            (Ui.input
                [ Ui.id "pick"
                , Ui.htmlAttribute "type" "file"
                , Ui.htmlAttribute "aria-label" "Pick"
                , Ui.onFile Picked
                ]
                :: askPanel model.picked "fileask" model
            )
        , Ui.el (Ui.id "flag" :: flagAttrs model.flag) (Ui.text "flag")
        , Ui.html
            (Html.node "table"
                [ Attr.id "table" ]
                [ Html.node "tbody"
                    [ Attr.id "tb" ]
                    (Html.node "tr" [] [ Html.node "td" [ Attr.id "one" ] [ Html.text "one" ] ]
                        :: tableRows model.tableRow
                    )
                ]
            )
        , Ui.column
            [ Ui.id "fhost", Ui.htmlAttribute "tabindex" "0", Ui.onFocus Focused ]
            [ shiftSlot model.shifted ]
        , Ui.column [ Ui.id "focusaskhost" ] (askPanel model.focusAsk "focusask" model)
        , Ui.column
            [ Ui.id "hoverhost" ]
            (hoverPad model.hoverShift
                ++ [ Ui.el [ Ui.id "hovertarget", Ui.onMouseOver Hovered ] (Ui.text "hover")
                   , Ui.el [ Ui.id "hoverbelow" ] (Ui.text "below")
                   ]
            )
        , Ui.column [ Ui.id "hoveraskhost" ] (askPanel model.hoverAsk "hoverask" model)
        , Ui.column [ Ui.id "framehost" ] (frames model.framed)
        , keepHost model
        ]


main =
    Web.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = []
        , notFound = NoOp
        }
