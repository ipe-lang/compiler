module Main exposing (main)

{-|
A full-screen TEA counter over the canonical `Tui.tea` surface.

The `view` returns `Screen msg` from `Ipe.Ui.Tui` — the terminal shape's
own view surface, with cell-native attributes.  Key input is a subscription:
`subscriptions` returns `Sub.onKey onKey`, and `onKey` maps each key event to a
`Msg`.

Keys:
    Up / k     increment
    Down / j   decrement
    r          reset to zero
    q          quit (Ctrl-C also quits)
-}

import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task
import Ipe.Tea.Tui as Tui
import Ipe.Tea.Tui.Cmd as Cmd
import Ipe.Tea.Tui.Sub as Sub
import Ipe.Ui.Tui as Ui
import Ipe.Ui.Tui exposing (Screen)


type Msg
    = Increment
    | Decrement
    | Reset
    | Quit
    | NoOp


type alias Model =
    { count : Int }


init : () -> ( Model, Cmd Msg )
init _unit =
    ( { count = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Increment ->
            ( { model | count = model.count + 1 }, Cmd.none )

        Decrement ->
            ( { model | count = model.count - 1 }, Cmd.none )

        Reset ->
            ( { count = 0 }, Cmd.none )

        Quit ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        NoOp ->
            ( model, Cmd.none )


view : Model -> Screen Msg
view model =
    Ui.column
        [ Ui.spacing 1, Ui.padding 2 ]
        [ Ui.el [ Ui.bold ] (Ui.text "Ipê tui counter")
        , Ui.el [ Ui.reverse ] (Ui.text ("count = " ++ String.fromInt model.count))
        , Ui.el [ Ui.dim ] (Ui.text "(Up/k +, Down/j -, r reset, q quit)")
        ]


subscriptions : Model -> Sub Msg
subscriptions _model =
    Sub.onKey onKey


type alias KeyEvent =
    { kind : String
    , value : String
    }


onKey : KeyEvent -> Msg
onKey key =
    if key.kind == "up" then
        Increment

    else if key.kind == "down" then
        Decrement

    else if key.kind == "char" && key.value == "k" then
        Increment

    else if key.kind == "char" && key.value == "j" then
        Decrement

    else if key.kind == "char" && key.value == "r" then
        Reset

    else if key.kind == "char" && key.value == "q" then
        Quit

    else
        NoOp


main =
    Tui.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
