module Main exposing (main)

-- Markdown semantic-parity snapshot generator.
--
-- `Ipe.Markdown` is the Markdown parse authority. This program embeds the
-- shared parity corpus and prints, for each document, its source and the
-- canonical S-expression form of `parseBlocks` (or of `parseSpans`, for the
-- inline corpus). The doc-side Rust port (`ipe_docs::markdown`) is asserted
-- equal to this output by a standing test, so `Ipe.Markdown` stays the single
-- source of truth for parse behaviour and any drift reddens CI. Its output is
-- written to the snapshot by `tools/scripts/regen-markdown-parity.sh`; never
-- hand-edited.

import Ipe.Io as Io
import Ipe.List as List
import Ipe.Markdown as Markdown exposing (Block(..), HeadingLevel(..), Span(..))
import Ipe.String as String
import Ipe.Task as Task


-- ─── Shared parity corpus (SSOT) ────────────────────────────────────────────
--
-- Each entry is (name, markdown source). Cover every block and span form plus
-- the fail-closed edge cases (unmatched markers, unsafe hrefs, nesting).


type alias Doc =
    { name : String, source : String }


corpus : List Doc
corpus =
    [ { name = "header-h1", source = "# Release notes" }
    , { name = "header-h6", source = "###### Deep" }
    , { name = "header-no-space", source = "#nospace" }
    , { name = "paragraph-fold"
      , source = String.join "\n" [ "alpha", "beta" ]
      }
    , { name = "paragraph-hard-break"
      , source = String.join "\n" [ "alpha  ", "beta" ]
      }
    , { name = "bullet-list"
      , source = String.join "\n" [ "- one", "- two" ]
      }
    , { name = "numbered-list"
      , source = String.join "\n" [ "1. one", "2. two" ]
      }
    , { name = "code-fence"
      , source = String.join "\n" [ "```ipe", "foo =", "    bar", "```" ]
      }
    , { name = "rule-dash", source = "---" }
    , { name = "rule-star", source = "***" }
    , { name = "table"
      , source = String.join "\n" [ "| A | B |", "|---|---|", "| 1 | 2 |" ]
      }
    , { name = "blockquote"
      , source = String.join "\n" [ "> quoted", "> lines" ]
      }
    , { name = "blockquote-nested"
      , source = String.join "\n" [ "> outer", "> > inner" ]
      }
    , { name = "inline-emphasis"
      , source = "a **bold** and *italic* and `code`"
      }
    , { name = "inline-link-safe", source = "see [docs](guide.html)" }
    , { name = "inline-link-unsafe", source = "[x](javascript:alert(1))" }
    , { name = "inline-link-vbscript", source = "[x](vbscript:msgbox(1))" }
    , { name = "inline-image", source = "![alt](img.png)" }
    , { name = "inline-unmatched", source = "a * b and [x](y and `z" }
    , { name = "inline-multibyte", source = "café ☕ **✓**" }
    , { name = "html-literal", source = "a <script>x</script> b" }
    , { name = "mixed-doc"
      , source =
            String.join "\n"
                [ "# Title"
                , ""
                , "Intro **para**."
                , ""
                , "- item [link](https://a.example)"
                , ""
                , "> note"
                , ""
                , "| H |"
                , "|---|"
                , "| v |"
                ]
      }
    , { name = "blank-run"
      , source = String.join "\n" [ "alpha", String.repeat 50 "\n", "beta" ]
      }
    , { name = "table-head-at-end", source = "| A | B |" }
    , { name = "table-head-no-separator"
      , source = String.join "\n" [ "| A | B |", "plain" ]
      }
    , { name = "paragraph-absorbs-table-row"
      , source = String.join "\n" [ "alpha", "| A | B |", "|---|---|" ]
      }
    , { name = "code-fence-unclosed"
      , source = String.join "\n" [ "```", "x =", "  y" ]
      }
    , { name = "adjacent-groups"
      , source =
            String.join "\n"
                [ "- a"
                , "1. b"
                , "> c"
                , "| D |"
                , "|---|"
                , "| e |"
                , "- f"
                ]
      }
    , { name = "paragraph-hard-break-mid", source = "a  \nb" }
    , { name = "quote-depth-31", source = String.repeat 31 "> " ++ "- item" }
    , { name = "quote-depth-32", source = String.repeat 32 "> " ++ "- item" }
    , { name = "quote-depth-33"
      , source =
            String.join "\n"
                [ String.repeat 33 "> " ++ "- item"
                , String.repeat 33 "> " ++ "# head"
                ]
      }
    , { name = "quote-markers-run", source = String.repeat 40 ">" ++ " deep" }
    ]


-- Each entry is (name, one line of inline markup) for `parseSpans`: the
-- link, emphasis and break forms plus their unmatched and nested edges.
spanCorpus : List Doc
spanCorpus =
    [ { name = "span-bracket-before-link", source = "[[a](b)" }
    , { name = "span-link-text-has-bracket", source = "[a [b](c)" }
    , { name = "span-link-no-paren", source = "[a]x(b)" }
    , { name = "span-image-bracket-link", source = "![[a](b)" }
    , { name = "span-link-no-close-paren", source = "[a](b" }
    , { name = "span-brackets-only", source = "[[[" }
    , { name = "span-link-no-url", source = "[a]" }
    , { name = "span-star", source = "*" }
    , { name = "span-double-star", source = "**" }
    , { name = "span-triple-star", source = "***" }
    , { name = "span-bold-unclosed", source = "**a" }
    , { name = "span-bold-star-run", source = "**a***b" }
    , { name = "span-italic", source = "*a*" }
    , { name = "span-code-unclosed", source = "`a" }
    , { name = "span-code", source = "`x`" }
    , { name = "span-trailing-spaces", source = "a  " }
    , { name = "span-bang-text", source = "!x" }
    , { name = "span-bang-bracket", source = "![" }
    , { name = "span-hard-break-mid", source = "a  \nb" }
    , { name = "span-newline", source = "a\nb" }
    , { name = "span-link-https", source = "[t](https://a.example)" }
    , { name = "span-image", source = "![i](img.png)" }
    , { name = "span-double-bang-link", source = "!![a](b)" }
    , { name = "span-mailto", source = "x [a](mailto:a@b.c) y" }
    , { name = "span-link-after-miss", source = "[a]x [b](c)" }
    ]


-- ─── Canonical serialization ────────────────────────────────────────────────
--
-- One block per line. A `blockquote` is written as `(blockquote` then its inner
-- blocks each indented two more spaces, closed by a `)` line at the quote's
-- indent — a shape the Rust port reproduces exactly.


quote : String -> String
quote s =
    "\""
        ++ (s
                |> String.replace "\\" "\\\\"
                |> String.replace "\"" "\\\""
                |> String.replace "\n" "\\n"
                |> String.replace "\t" "\\t"
           )
        ++ "\""


levelName : HeadingLevel -> String
levelName level =
    case level of
        H1 ->
            "H1"

        H2 ->
            "H2"

        H3 ->
            "H3"

        H4 ->
            "H4"

        H5 ->
            "H5"

        H6 ->
            "H6"


-- Serialize one block into indented S-expression lines (joined by "\n").
blockLines : String -> Block -> String
blockLines indent block =
    case block of
        HeaderBlock level text ->
            indent ++ "(header " ++ levelName level ++ " " ++ quote text ++ ")"

        ParaBlock text ->
            indent ++ "(para " ++ quote text ++ ")"

        CodeBlock body ->
            indent ++ "(code " ++ quote body ++ ")"

        BulletBlock items ->
            indent ++ "(bullet" ++ items_ items ++ ")"

        NumberedBlock items ->
            indent ++ "(numbered" ++ items_ items ++ ")"

        TableBlock header rows ->
            indent
                ++ "(table (hdr"
                ++ items_ header
                ++ ")"
                ++ String.concat (List.map (\r -> " (row" ++ items_ r ++ ")") rows)
                ++ ")"

        RuleBlock ->
            indent ++ "(rule)"

        BlockquoteBlock inner ->
            String.join "\n"
                (List.concat
                    [ [ indent ++ "(blockquote" ]
                    , List.map (blockLines (indent ++ "  ")) inner
                    , [ indent ++ ")" ]
                    ]
                )


items_ : List String -> String
items_ xs =
    String.concat (List.map (\x -> " " ++ quote x) xs)


-- Serialize one span as one S-expression line.
spanLine : Span -> String
spanLine span =
    case span of
        PlainSpan text ->
            "(plain " ++ quote text ++ ")"

        BoldSpan text ->
            "(bold " ++ quote text ++ ")"

        ItalicSpan text ->
            "(italic " ++ quote text ++ ")"

        CodeSpan text ->
            "(code " ++ quote text ++ ")"

        LinkSpan text url ->
            "(link " ++ quote text ++ " " ++ quote url ++ ")"

        ImageSpan alt url ->
            "(image " ++ quote alt ++ " " ++ quote url ++ ")"

        HardBreakSpan ->
            "(hardbreak)"


serializeDoc : Doc -> String
serializeDoc doc =
    let
        blocks =
            Markdown.parseBlocks doc.source

        body =
            String.join "\n" (List.map (blockLines "") blocks)
    in
    String.join "\n"
        [ "=== " ++ doc.name ++ " ==="
        , "--- source ---"
        , doc.source
        , "--- blocks ---"
        , body
        , "--- end ---"
        ]


serializeSpans : Doc -> String
serializeSpans doc =
    String.join "\n"
        [ "=== " ++ doc.name ++ " ==="
        , "--- source ---"
        , doc.source
        , "--- spans ---"
        , String.join "\n" (List.map spanLine (Markdown.parseSpans doc.source))
        , "--- end ---"
        ]


main =
    do
        List.map serializeDoc corpus ++ List.map serializeSpans spanCorpus |> List.map Io.println |> Task.sequence |> Task.map (always ())
