module Main exposing (main)

import Ipe.Io as Io
import Ipe.Ui.Grid as Grid exposing (Track)


-- `Ipe.Ui.Grid` describes CSS grid track lists as typed VALUES, then lowers them
-- to a CSS string. This example stays on that pure surface — building tracks and
-- rendering them — which is enough to show the ideas:
--   • A track is a typed value, not a string. `Grid.fr 1`, `Grid.px 200`,
--     `Grid.auto`, and the composites `Grid.minmax` / `Grid.repeat` build a
--     `Track`, so a malformed track (a stray unit, an unbalanced `minmax(`) is
--     unrepresentable.
--   • Composites nest by construction. `Grid.minmax (Grid.px 100) (Grid.fr 1)`
--     takes two `Track`s and yields a `Track`, so the CSS `minmax(100px, 1fr)`
--     is assembled from checked pieces, never string-concatenated by hand.
--   • `tracksToCss` lowers a whole list to the space-joined CSS string a
--     `grid-template-columns` value expects.

-- A responsive column list: a fixed sidebar, a flexible main column with a
-- minimum, and a repeated set of equal cards.
columns : List Track
columns =
    [ Grid.px 200
    , Grid.minmax (Grid.px 100) (Grid.fr 1)
    , Grid.repeat 3 (Grid.fr 1)
    ]


main =
    do
        Io.println "grid-template-columns:"
        Io.println ("  " ++ Grid.tracksToCss columns)
        Io.println ("single track (auto): " ++ Grid.trackToCss Grid.auto)
