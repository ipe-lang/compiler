module Main exposing (main)

import Ipe.Html as Html exposing (Html)
import Ipe.Io as Io
import Ipe.Web.Head.Unsafe as HeadU


-- `Ipe.Web.Head.Unsafe` is the one home for the `<head>` member that emits a raw
-- JSON-LD `<script type="application/ld+json">` block. A `<script>` body is a
-- scripting context, not an HTML text context, so the renderer emits it VERBATIM
-- — no HTML escaping runs. Two ideas:
--   • The `unsafe` prefix names the risk: the caller owns the invariant that the
--     body is trusted and cannot contain a `</script>` breakout. Importing the
--     module discloses the `unsafe` capability program-wide.
--   • Build the JSON from typed data you control, never from request input, so
--     the string is structurally trusted before it reaches the verbatim sink.

-- Structured data for a product page. In a real app this would come from a typed
-- JSON encoder over your own record types; here it is a trusted constant.
productJsonLd : String
productJsonLd =
    "{\"@context\":\"https://schema.org\",\"@type\":\"Product\",\"name\":\"Widget\",\"sku\":\"W-1\"}"


head : Html msg
head =
    HeadU.unsafeJsonLd productJsonLd


main =
    do
        Io.println "Rendered JSON-LD (script body emitted verbatim, not escaped):"
        Io.println (Html.render head)
