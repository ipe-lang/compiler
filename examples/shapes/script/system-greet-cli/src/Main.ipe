module Main exposing (main)

import Ipe.Io as Io
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task


-- A tiny CLI that reads its inputs from the two process-global sources and writes
-- to the two output streams. It shows the shapes that split `Ipe.System` and
-- `Ipe.Io` apart:
--   • Reads that touch mutable process state are effects — `System.args` returns a
--     `Task Error (List String)`, sequenced with `do`.
--   • `System.getenvOr key default` is the ONE sync read: because the default
--     resolves the missing case, it can't fail, so it returns a bare `String`.
--   • `Io.println` goes to stdout (the program's result); `Io.eprintln` goes to
--     stderr (diagnostics), so a caller can pipe one without the other.
--
-- `System.args ()` yields the USER arguments (the program name is already
-- dropped); the whole-argv `System.getArg n` is the escape hatch when index 0
-- (the executable path) is genuinely wanted.

-- The first user argument is the name to greet, or "world" when none was passed.
-- `List.head` returns `Maybe String` — absence is a value, not an index panic.
firstName : List String -> String
firstName argv =
    List.head argv
        |> Maybe.withDefault "world"


-- `getenvOr` is the sync read: the default resolves the missing case, so the
-- result is a bare `String` needing no `<-`.
greeting : String
greeting =
    System.getenvOr "GREETING" "Hello"


main =
    do
        argv <- System.args ()
        Io.eprintln ("user args: " ++ String.fromInt (List.length argv))
        Io.println (greeting ++ ", " ++ firstName argv ++ "!")
