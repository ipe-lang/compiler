module Main exposing (main)

import Ipe.Io as Io


-- Turning a value into text is always explicit in Ipê. Two ideas:
--   • A standalone conversion names its type: `String.fromInt`,
--     `String.fromFloat`, `String.fromBool` — each total, no `Maybe`, no
--     `Result` to unwrap.
--   • Inside a `"""..."""` triple-quoted string, `{{expr}}` interpolation
--     renders each chunk the same way, and reads closer to the output than a
--     `++`/`String.concat` chain of the same pieces.

-- A one-line summary row, each field interpolated straight into the string.
row : String -> Int -> Float -> Bool -> String
row label count ratio enabled =
    """{{label}}: count={{count}} ratio={{ratio}} enabled={{enabled}}"""


main =
    do
        Io.println (row "alpha" 3 0.75 True)
        Io.println (row "beta" 128 1.5 False)
