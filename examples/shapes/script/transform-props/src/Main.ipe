module Main exposing (main)

import Ipe.Io as Io
import Ipe.Ui.Transform as Transform exposing (Prop)


-- `Ipe.Ui.Transform` describes a CSS transform as a list of typed VALUES, then
-- lowers them to a CSS string. This example stays on that pure surface. Two
-- ideas:
--   • Each part is a typed builder with the right argument type: `translateX`
--     and `translateY` take an `Int` of pixels, `scale` and `rotate` take a
--     `Float`. You cannot pass an angle where a pixel count belongs, or forget a
--     unit — the unit is supplied by the builder.
--   • `propsToCss` joins a whole list into a single CSS `transform` declaration,
--     in the order given. Composition is a list, so the order is explicit and the
--     pieces cannot run together malformed.

-- A card lift: nudge up, shrink slightly, and tilt.
lift : List Prop
lift =
    [ Transform.translateY (-4)
    , Transform.scale 0.98
    , Transform.rotate 2.0
    ]


main =
    do
        Io.println "The transform declaration (propsToCss emits the property name and value):"
        Io.println ("  " ++ Transform.propsToCss lift)
