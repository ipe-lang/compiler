module Main exposing (main)

-- | android-push-shell — a wasm client that reads this device's push
-- subscription, so its Android shell links the Firebase push service.

import Ipe.Browser.Push as Push
import Ipe.Error as Error exposing (Error)
import Ipe.Task as Task
import Ipe.Tea.Web as Web
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import Ipe.Ui as Ui


type alias Model =
    { status : String
    }


type Msg
    = Check
    | GotCurrent (Result Error (Maybe Push.Subscription))


init : WebReq -> ( Model, Cmd.Cmd Msg )
init _req =
    ( { status = "" }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd.Cmd Msg )
update msg model =
    case msg of
        Check ->
            ( model, Task.attempt GotCurrent Push.current )

        GotCurrent result ->
            case result of
                Ok (Just _) ->
                    ( { model | status = "subscribed" }, Cmd.none )

                Ok Nothing ->
                    ( { model | status = "not subscribed" }, Cmd.none )

                Err error ->
                    ( { model | status = "error: " ++ Error.toString error }, Cmd.none )


subscriptions : Model -> Sub.Sub Msg
subscriptions _model =
    Sub.none


view : Model -> Element Msg
view model =
    Ui.column []
        [ Ui.button [] { onPress = Just Check, label = Ui.text "Check push" }
        , Ui.text ("push: " ++ model.status)
        ]


main =
    Web.tea
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = []
        , notFound = Check
        }
