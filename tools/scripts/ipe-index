#!/usr/bin/env bash
# ipe-index — thin wrapper execing the Rust binary (tools/ipe-index).
#
# Indexes this repo into one sqlite DB (path-prefixed by repo tag):
#   * ipe:  this repo   — Rust compiler (crates/), runtime (runtime/),
#                          tooling (tools/), stdlib/examples (*.ipe)
# Languages: Rust, TypeScript/JS (tree-sitter) + Ipê + Bash.
#
# Commands (run `ipe-index` with no args for the full list):
#   index               rebuild the index (the review queue is reconciled, never reset)
#   update              incremental: re-extract the files whose content stamp changed
#   locate <name>       every def site of a symbol (file:line:col)
#   roles | pipeline | wakeup | deps <m> | rdeps <m> | covers <m>
#
# DB defaults to .ipe-index/index.db (gitignored). Agents: prefer this over rg
# for "where is X defined / who imports Y / which examples exercise a module".
#
# The build output is always out-of-tree (SSOT for the binary's location — this
# is the only place that decides it). Resolution order:
#   1. $CARGO_TARGET_DIR, when set (e.g. a per-worktree warm target dir).
#   2. /mnt/ipe-scratch/warm-targets/ipe-index, one shared default so every
#      worktree reuses a single prebuilt binary instead of each rebuilding.
#   3. ${XDG_CACHE_HOME:-$HOME/.cache}/ipe-index/target, when /mnt/ipe-scratch
#      isn't mounted.
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

if [ -n "${CARGO_TARGET_DIR:-}" ]; then
    TARGET_DIR="$CARGO_TARGET_DIR"
elif [ -d /mnt/ipe-scratch ]; then
    TARGET_DIR="/mnt/ipe-scratch/warm-targets/ipe-index"
else
    TARGET_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ipe-index/target"
fi

# Cargo owns freshness: a no-op when the binary is current, a rebuild when any
# source, manifest or lockfile input changed. Testing only for an existing
# binary would run a stale one after every edit to the tool.
CARGO_TARGET_DIR="$TARGET_DIR" cargo build --release --locked --quiet \
    --manifest-path "$REPO/tools/ipe-index/Cargo.toml" >&2
exec "$TARGET_DIR/release/ipe-index" "$@"
