import TestSupport exposing (accepted, labelOf, quotedLabelOf, labelText, decidedRefusalNow, checkReporting, cleanupIndex, codeText, execIndex, freshScratch, loadHistoryPageNow, loadPageNow, loadUnitNow, migratedReviewAt, removeFileIfAny, renderedForeign, seedIndex, uid, writeFileText, appendSigned, rawRow, countingVerifier, testKeyHex)


-- Every check here renders the real `View.view` to HTML, the exact string the
-- browser receives, and asserts on that string. A refusal the view enforces
-- (a withheld source gives no decision buttons; hostile text is escaped; a
-- reason past the bound is never printed; a non-http link is never an `href`)
-- is therefore pinned at the sink, not at a helper the view might stop calling.
-- Each refusal sits beside a positive control that renders the permitted form
-- through the same path, so a needle that no longer matches the markup turns a
-- check red instead of letting its negative half pass vacuously.
--
-- The tests render under `Ui.layout []`, the root the app serves.
page : Model -> String
page model =
    Html.render (Ui.layout [] (View.view model))


has : String -> String -> Bool
has needle haystack =
    String.contains needle haystack


-- A button's label as the markup spells it: the text directly between tags.
button : String -> String -> Bool
button label html =
    has (">" ++ label ++ "<") html


-- ── fixtures ────────────────────────────────────────────────────────────
-- A model on the queue page, nothing loaded.
baseModel : Model
baseModel =
    initialModel


queued : Index.UnitView -> Queue.QueuedUnit
queued loaded =
    { unit = loaded.unit, change = New, changed = Nothing, standing = Queue.Undecided }


queuePage : List Queue.QueuedUnit -> Int -> Queue.Progress -> Queue.QueuePage
queuePage units total progress =
    { units = units
    , total = total
    , unbound = 0
    , dbName = SafeText.literal "index.db"
    , dbBytes = 2048
    , next = Nothing
    , progress = progress
    , log = ShownProven
    , refusals = []
    , refusalsOpen = 0
    , refusalsUnbound = 0
    }


-- The queue page with one selected unit card showing `loaded`.
cardModel : Index.UnitView -> Model
cardModel loaded =
    { baseModel
        | queueState = Loaded (queuePage [ queued loaded ] 1 { reviewed = 0, total = 1 })
        , selectedView = ViewShown loaded
    }


-- The queue page whose one selected card carries a previous review of the
-- unit, as a unit decided on an older hash resurfaces.
changedModel : Index.UnitView -> LibDb.VerifiedRow -> Model
changedModel loaded old =
    { baseModel
        | queueState = Loaded (queuePage [ { unit = loaded.unit, change = Modified { old = LibDb.verifiedHash old }, changed = Just old, standing = Queue.Undecided } ] 1 { reviewed = 0, total = 1 })
        , selectedView = ViewShown loaded
    }


-- The queue card with its refusal panel open.
refusingModel : Index.UnitView -> Model
refusingModel loaded =
    let
        card =
            cardModel loaded
    in
    { card | refusingUid = Just loaded.unit.uid }


-- The unit page of `loaded`'s own address, with its read settled.
unitPageModel : Index.UnitView -> Model
unitPageModel loaded =
    { baseModel | page = UnitPage (Uid.toString loaded.unit.uid), selectedView = ViewShown loaded }


-- A unit page at `address`, whatever it names.
addressModel : String -> Model
addressModel address =
    { baseModel | page = UnitPage address }


historyModel : List Queue.HistoryRow -> Model
historyModel rows =
    { baseModel
        | page = HistoryPage
        , history = HistoryLoaded { rows = rows, at = HistoryStart, next = Nothing, log = ShownProven }
    }


historyRowOf : LibDb.VerifiedRow -> Queue.HistoryRow
historyRowOf row =
    { entry = Verified row, label = Queue.Unnamed }


-- The queue card of `loaded` on a server whose review log reads `log`.
cardModelUnder : LogShown -> Index.UnitView -> Model
cardModelUnder log loaded =
    let
        shown =
            queuePage [ queued loaded ] 1 { reviewed = 0, total = 1 }
    in
    { baseModel
        | queueState = Loaded { shown | log = log }
        , selectedView = ViewShown loaded
    }


-- The History page of one entry that does not count, for `why`, on a log
-- that reads `log`.
unverifiedHistory : LogShown -> Unverified -> Model
unverifiedHistory log why =
    { baseModel
        | page = HistoryPage
        , history = HistoryLoaded { rows = [ { entry = Unverified { uid = Just (uid "u-a"), bodyHash = "h", reviewedAt = Timestamp.fromUnixMillis 0, why = why }, label = Queue.Unnamed } ], at = HistoryStart, next = Nothing, log = log }
    }


-- Text that is hostile in HTML (a tag) and in display (a bidi override).
hostileText : String
hostileText =
    "<script>alert(1)</script>" ++ codeText 8238


-- `hostileText` as it must reach the browser: the tag escaped by the HTML
-- sink and the override spelled out by the display scrub, inside the marked
-- element only a tool-written escape draws in.
hostileEscaped : String
hostileEscaped =
    "&lt;script&gt;alert(1)&lt;/script&gt;" ++ escapeMarkup (renderedForeign (codeText 8238))


-- A tool-written escape as the markup spells it.
escapeMarkup : String -> String
escapeMarkup spelled =
    "<span data-review-escape=\"true\" style=\"" ++ View.escapeCss ++ "\">" ++ spelled ++ "</span>"


-- The opening of an untrusted-text element: it draws in byte order.
byteOrderOpen : String
byteOrderOpen =
    "<span style=\"" ++ View.displayOrderCss ++ "\">"


-- True when `html` draws `hostileText`, right after `prefix`, at the start of
-- an element that draws in byte order.
hostileInByteOrder : String -> String -> Bool
hostileInByteOrder prefix html =
    has (byteOrderOpen ++ prefix ++ hostileEscaped) html


-- True when `html` carries `hostileText` escaped and neither raw form.
escapesHostile : String -> Bool
escapesHostile html =
    has hostileEscaped html
        && not (has "<script>" html)
        && not (has (codeText 8238) html)


-- The text of the one source line the fixture unit shows that is neither a
-- keyword nor punctuation, so a shown source is recognisable in the markup.
sourceMarker : String
sourceMarker =
    "everything"


requireUnit : Maybe Index.UnitView -> Task.Task Error Index.UnitView
requireUnit found =
    case found of
        Just loaded ->
            Task.succeed loaded

        Nothing ->
            Task.fail (Error.conflict "a fixture unit is missing from the seeded index")


isShown : Index.UnitView -> Bool
isShown loaded =
    case loaded.view of
        Shown _ ->
            True

        Stale _ ->
            False

        Unreadable _ ->
            False

        TooLarge _ ->
            False


-- The two fixture units loaded from a seeded index of their own, handed to
-- `body`; both must be shown, or the checks that follow would test nothing.
withSeededIndex : String -> (Index.UnitView -> Index.UnitView -> Task.Task Error (List ( String, Bool ))) -> Task.Task Error (List ( String, Bool ))
withSeededIndex name body =
    do
        at <- freshScratch name
        seedIndex at.indexDb at.repo
        a <- loadUnitNow (uid "u-a") |> Task.andThen requireUnit
        b <- loadUnitNow (uid "u-b") |> Task.andThen requireUnit
        results <- body a b
        cleanupIndex at.indexDb at.repo
        Task.succeed ([ ( "the fixture units load as verified sources", isShown a && isShown b ) ] ++ results)


-- ── decision buttons exist only for a verified source ───────────
type alias Withheld =
    { view : SourceView
    , reason : String
    }


-- The fragment of text that says why a stale source is withheld. The match is
-- exhaustive, so a new `StaleReason` does not compile until it is pinned here.
staleCase : StaleReason -> Withheld
staleCase reason =
    case reason of
        Drifted ->
            { view = Stale reason, reason = "Source changed since it was indexed" }

        RangeOutOfFile { lineCount } ->
            { view = Stale reason, reason = "The file now has " ++ String.fromInt lineCount ++ " lines" }

        UnverifiableHash ->
            { view = Stale reason, reason = "predates source attestation" }


-- The fragment of text that says which ceiling an oversize source passed,
-- each one step past its ceiling. The match is exhaustive, so a new
-- `Oversize` does not compile until it is pinned here.
oversizeCase : Oversize -> Withheld
oversizeCase over =
    case over of
        SpanLines { lines } ->
            { view = TooLarge over, reason = "spans " ++ String.fromInt lines ++ " lines, past the " ++ String.fromInt Index.viewLineCeiling ++ "-line review ceiling" }

        ViewBytes _ ->
            { view = TooLarge over, reason = "past the " ++ String.fromInt (ByteSize.toBytes Index.viewByteCeiling // 1024) ++ " KiB review ceiling" }

        ChildSpans { atLeast } ->
            { view = TooLarge over, reason = "holds at least " ++ String.fromInt atLeast ++ " other units, past the " ++ String.fromInt Index.childSpanCeiling ++ "-unit review ceiling" }


-- Every way a source is withheld.
withheldCases : List Withheld
withheldCases =
    [ staleCase Drifted
    , staleCase (RangeOutOfFile { lineCount = 2 })
    , staleCase UnverifiableHash
    , { view = Unreadable (NoFile (quotedLabelOf "ipe:gone.rs")), reason = "Source unreadable: " }
    , { view = Unreadable (CannotRead (quotedLabelOf "ipe:dir.rs")), reason = "Source unreadable: " }
    , { view = Unreadable (PathRefused (UnknownTag (quotedLabelOf "other:a.rs"))), reason = "Source unreadable: " }
    , { view = Unreadable (PathPastWindow (quotedLabelOf (String.repeat (Label.windowChars + 1) "a"))), reason = "Source unreadable: " }
    , { view = Unreadable (PathHoldsNul (quotedLabelOf "ipe:src/Ma")), reason = "Source unreadable: " }
    , { view = Unreadable (PathNotText (quotedLabelOf "69")), reason = "Source unreadable: " }
    , oversizeCase (SpanLines { lines = Index.viewLineCeiling + 1 })
    , oversizeCase (ViewBytes { size = ByteSize.bytes (ByteSize.toBytes Index.viewByteCeiling + 1) })
    , oversizeCase (ChildSpans { atLeast = Index.childSpanCeiling + 1 })
    ]


-- The constructor a withheld view is named by: the reason's own constructor
-- for a stale, an unreadable or an oversize view; `Shown` withholds
-- nothing.
withheldName : SourceView -> Maybe String
withheldName view =
    case view of
        Shown _ ->
            Nothing

        Stale Drifted ->
            Just "Drifted"

        Stale (RangeOutOfFile _) ->
            Just "RangeOutOfFile"

        Stale UnverifiableHash ->
            Just "UnverifiableHash"

        Unreadable (PathRefused _) ->
            Just "PathRefused"

        Unreadable (PathPastWindow _) ->
            Just "PathPastWindow"

        Unreadable (PathHoldsNul _) ->
            Just "PathHoldsNul"

        Unreadable (PathNotText _) ->
            Just "PathNotText"

        Unreadable (NoFile _) ->
            Just "NoFile"

        Unreadable (CannotRead _) ->
            Just "CannotRead"

        TooLarge (SpanLines _) ->
            Just "SpanLines"

        TooLarge (ViewBytes _) ->
            Just "ViewBytes"

        TooLarge (ChildSpans _) ->
            Just "ChildSpans"


-- The constructors `type <name>` declares in `source`, read off its `=` and
-- `|` lines up to the first blank line.
constructorsOf : String -> String -> List String
constructorsOf name source =
    let
        constructorName line =
            let
                trimmed =
                    String.trim line
            in
            if String.startsWith "= " trimmed || String.startsWith "| " trimmed then
                List.head (String.words (String.dropLeft 2 trimmed))

            else
                Nothing
    in
    case String.split ("\ntype " ++ name ++ "\n") source of
        [ _, rest ] ->
            String.split "\n\n" rest
                |> List.head
                |> Maybe.withDefault ""
                |> String.lines
                |> List.filterMap constructorName

        _ ->
            []


-- Every withheld constructor `Lib.Index` declares has a case in
-- `withheldCases`, so it is rendered by the withheld checks: each
-- `SourceView` but `Shown`, with `Stale`, `Unreadable` and `TooLarge` read
-- as their reasons' constructors. Read from the declarations themselves, so a new
-- variant is red here until it is rendered, not only until it compiles.
everyWithheldConstructorRendered : Task.Task Error Bool
everyWithheldConstructorRendered =
    do
        cwd <- System.cwd ()
        path <- Task.fromResult (Path.fromString (cwd ++ "/src/Lib/Index.ipe"))
        source <- File.readFileLimit path (ByteSize.kib 256)
        let
            views =
                constructorsOf "SourceView" source

            declared =
                views
                    |> List.filter (\c -> c /= "Shown")
                    |> List.concatMap
                        (\c ->
                            if c == "Stale" then
                                constructorsOf "StaleReason" source

                            else if c == "TooLarge" then
                                constructorsOf "Oversize" source

                            else if c == "Unreadable" then
                                constructorsOf "ReadFailure" source

                            else
                                [ c ]
                        )
        in
        Task.succeed
            (List.member "Shown" views
                && List.member "Stale" views
                && List.member "TooLarge" views
                && List.sort declared == List.sort (List.filterMap (\entry -> withheldName entry.view) withheldCases)
            )


noDecisionButtons : String -> Bool
noDecisionButtons html =
    not (button "Approve" html) && not (button "Refuse" html) && not (button "Confirm" html)


-- A withheld source, on the queue card and on the unit page, names its reason,
-- offers no decision button and prints none of the source.
withheldRefuses : Index.UnitView -> Withheld -> Bool
withheldRefuses loaded entry =
    let
        withheld =
            { loaded | view = entry.view }

        onCard =
            page (cardModel withheld)

        onPage =
            page (unitPageModel withheld)
    in
    has entry.reason onCard
        && noDecisionButtons onCard
        && not (has sourceMarker onCard)
        && has entry.reason onPage
        && not (has sourceMarker onPage)


-- A withheld card whose refusal panel is open still offers no decision.
withheldRefusePanelRefuses : Index.UnitView -> Withheld -> Bool
withheldRefusePanelRefuses loaded entry =
    let
        withheld =
            { loaded | view = entry.view }

        html =
            page (refusingModel withheld)
    in
    has entry.reason html && noDecisionButtons html


-- ── queue states and counts ─────────────────────────────────────
-- The queue page in each state that shows no card, with the text that state
-- shows: loading, failed, an empty queue, and a page with no open unit while
-- the queue holds some.
type alias StateCase =
    { text : String
    , model : Model
    }


stateCases : List StateCase
stateCases =
    [ { text = "Loading queue…", model = { baseModel | queueState = Loading } }
    , { text = "Queue failed to load: ", model = { baseModel | queueState = Failed LoadFailed } }
    , { text = "No units queued.", model = { baseModel | queueState = Loaded (queuePage [] 0 { reviewed = 0, total = 0 }) } }
    , { text = "No units to review on this page.", model = { baseModel | queueState = Loaded (queuePage [] 3 { reviewed = 0, total = 3 }) } }
    ]


stateNeedles : List String
stateNeedles =
    List.map (\c -> c.text) stateCases


-- True when the page for the case carries its own text and none of the
-- other states' texts.
showsOnly : StateCase -> Bool
showsOnly entry =
    let
        html =
            page entry.model
    in
    has entry.text html && List.all (\other -> other == entry.text || not (has other html)) stateNeedles


progressLine : Queue.Progress -> String
progressLine progress =
    String.fromInt progress.reviewed ++ " of " ++ String.fromInt progress.total ++ " reviewed (" ++ Format.percent progress.reviewed progress.total ++ ")"


showingLine : Queue.QueuePage -> String
showingLine loadedPage =
    "showing " ++ String.fromInt (List.length loadedPage.units) ++ " of " ++ String.fromInt loadedPage.total


-- The progress line and the "showing k of N" header follow the model's own
-- counts: two models with different counts render different lines, and each
-- line is the one its model's counts spell.
countsFollowModel : Index.UnitView -> Index.UnitView -> Bool
countsFollowModel a b =
    let
        first =
            queuePage [ queued a, queued b ] 9 { reviewed = 3, total = 7 }

        second =
            queuePage [ queued a ] 4 { reviewed = 5, total = 5 }

        firstHtml =
            page { baseModel | queueState = Loaded first, selectedView = ViewShown a }

        secondHtml =
            page { baseModel | queueState = Loaded second, selectedView = ViewShown a }
    in
    has (progressLine first.progress) firstHtml
        && has (showingLine first) firstHtml
        && has (progressLine second.progress) secondHtml
        && has (showingLine second) secondHtml
        && not (has (progressLine second.progress) firstHtml)
        && not (has (showingLine second) firstHtml)
        && not (has (progressLine first.progress) secondHtml)
        && not (has (showingLine first) secondHtml)


-- ── error text ──────────────────────────────────────────────────────
-- A refused draft shows its case's fixed text in the open refusal panel,
-- beside the Confirm button, and no other case's text. Red if a case renders
-- another's text or the panel loses its control.
refuseErrorFixedText : Index.UnitView -> Bool
refuseErrorFixedText loaded =
    let
        opened =
            refusingModel loaded

        cases =
            [ DraftRefused ReasonBlank
            , DraftRefused (ReasonOverlong { chars = LibDb.reasonMaxChars + 1, limit = LibDb.reasonMaxChars })
            , DraftWhileSaving
            ]

        rendered failure =
            page { opened | refuseError = Just failure }

        showsItsOwn failure =
            let
                html =
                    rendered failure
            in
            has (Html.escapeHtml (Failure.refuseFailureText failure)) html
                && button "Confirm" html
                && List.all (\other -> other == failure || not (has (Html.escapeHtml (Failure.refuseFailureText other)) html)) cases
    in
    List.all showsItsOwn cases
        && not (has (Html.escapeHtml (Failure.refuseFailureText (DraftRefused ReasonBlank))) (page opened))


-- A failed decision save shows its case's fixed text in the queue banner,
-- and nothing when no save failed. Red if a case renders another's text or
-- the banner shows without a failure.
decisionErrorFixedText : Index.UnitView -> Bool
decisionErrorFixedText loaded =
    let
        card =
            cardModel loaded
    in
    List.all
        (\failure -> has (Html.escapeHtml ("Decision save failed: " ++ Failure.saveFailureText failure)) (page { card | decision = DecisionNotSaved failure Queue.firstTicket }))
        [ SaveOffQueue
        , SaveReadOnly
        , SaveContended
        , SavePastLimit
        , SaveFailed
        , SaveRefused SourceGone
        , SaveRefused SourceChanged
        , SaveRefused SourcePastCeiling
        , SaveRefused NamePastCeiling
        , SaveRefused NameUnreadable
        , SaveRefused NotQueued
        , SaveRefused SourceNotShown
        , SaveRefused LogBroken
        , SaveRefused LogKeyMismatch
        , SaveRefused FileGone
        , SaveRefused FileChanged
        , SaveRefused FileNotAcknowledgeable
        , SaveRefused FileNotReprobed
        , SaveRefused FileReadsAsText
        , SaveRefused FileNotQueued
        ]
        && not (has "Decision save failed: " (page card))


-- ── the address the page reports ────────────────────────────────────
-- The path an address reports is an attribute value, escaped at the sink; the
-- three pages report their fixed paths.
pathAttributeEscaped : Index.UnitView -> Bool
pathAttributeEscaped loaded =
    let
        hostileAddress =
            "\"><script>alert(1)</script>"

        hostile =
            page (addressModel hostileAddress)

        plain =
            page (addressModel "abc")
    in
    has "data-ipe-path=\"/unit/&#34;&gt;&lt;script&gt;alert(1)&lt;/script&gt;\"" hostile
        && not (has "<script>" hostile)
        && not (has hostileAddress hostile)
        && has "data-ipe-path=\"/unit/abc\"" plain
        && has "data-ipe-path=\"/\"" (page baseModel)
        && has "data-ipe-path=\"/history\"" (page (historyModel []))


-- ── links ──────────────────────────────────────────────────────────
withLinks : List Link -> Index.UnitView -> Index.UnitView
withLinks links loaded =
    { loaded | links = { links = links, hidden = NoneHidden } }


-- A link whose target is not an http(s) or mailto/tel URL or a same-origin
-- path renders as its plain label with no `href` anywhere in the page.
unsafeLinkHasNoHref : Index.UnitView -> String -> Bool
unsafeLinkHasNoHref loaded url =
    let
        linked =
            withLinks [ Lib.Links.external url ] loaded

        onPage =
            page (unitPageModel linked)

        onCard =
            page (cardModel linked)
    in
    has url onPage
        && has url onCard
        && not (has "href=" onPage)
        && not (has "href=" onCard)


unsafeTargets : List String
unsafeTargets =
    [ "javascript:alert(1)"
    , "data:text/html,x"
    , "file:///etc/passwd"
    , "//evil.example/x"
    ]


-- The same link path renders an https target as an `href`.
safeLinkHasHref : Index.UnitView -> Bool
safeLinkHasHref loaded =
    let
        linked =
            withLinks [ Lib.Links.external "https://example.com/x" ] loaded
    in
    has "href=\"https://example.com/x\"" (page (unitPageModel linked))
        && has "href=\"https://example.com/x\"" (page (cardModel linked))


-- A URL of exactly the href ceiling is linked whole; one byte over is shown
-- cut with its marker and never linked, so no href is ever a cut label.
hrefCeilingIsExact : Index.UnitView -> Bool
hrefCeilingIsExact loaded =
    let
        urlOf n =
            "https://example.com/" ++ String.repeat (n - 20) "a"

        atCap =
            urlOf Lib.Links.hrefByteCeiling

        overCap =
            urlOf (Lib.Links.hrefByteCeiling + 1)

        shown url =
            page (unitPageModel (withLinks [ Lib.Links.external url ] loaded))
    in
    has ("href=\"" ++ atCap ++ "\"") (shown atCap)
        && not (has "data-review-cut" (shown atCap))
        && not (has "href=" (shown overCap))
        && has "data-review-cut" (shown overCap)
        && String.startsWith "f:" (Lib.Links.linkKey (Lib.Links.external overCap))
        && String.startsWith "e:" (Lib.Links.linkKey (Lib.Links.external atCap))


-- A URL well under the href ceiling whose label is cut by its escape runs
-- (one past `Label.runCeiling`) is shown cut and never linked, keyed as an
-- untargeted URL: the href rule is "shown whole", not only "few bytes".
escapeCutUrlIsUnlinked : Index.UnitView -> Bool
escapeCutUrlIsUnlinked loaded =
    let
        rlo =
            codeText 8238

        url =
            "https://example.com/" ++ String.concat (List.map (\c -> c ++ rlo) [ "a", "b", "c", "d" ])

        link =
            Lib.Links.external url

        shown =
            page (unitPageModel (withLinks [ link ] loaded))
    in
    Label.textBytes url < Lib.Links.hrefByteCeiling
        && has "data-review-cut" shown
        && not (has "href=" shown)
        && String.startsWith "f:" (Lib.Links.linkKey link)


-- A unit holding the most links, each named by a hostile qualified name of a
-- full read window, draws at most `Index.linkElements` for each link past the
-- first (the first also opens the links row, page chrome), every name cut with
-- its marker, and holds no more link bytes than the links' share of the queue
-- label ceiling.
maxLinksFitBudget : Index.UnitView -> List ( String, Bool )
maxLinksFitBudget loaded =
    let
        links =
            List.map
                (\n -> Lib.Links.internal (labelOf (hostileColumn ++ String.fromInt n)) (Uid.toString (uid ("u-link-" ++ String.fromInt n))))
                (List.range 1 Lib.Links.linkCeiling)

        drawnOn view linkSet =
            elementsOf (page (view (withLinks linkSet loaded)))

        delta view =
            drawnOn view links - drawnOn view (List.take 1 links)

        cuts view =
            List.length (String.split "data-review-cut" (page (view (withLinks links loaded))))
                - List.length (String.split "data-review-cut" (page (view (withLinks [] loaded))))

        linkBytes =
            List.sum (List.map (\l -> Label.byteCount (Lib.Links.label l)) links)
    in
    [ ( "a card of the most hostile links draws no more than linkElements per link and draws every link cut"
      , delta cardModel <= (Lib.Links.linkCeiling - 1) * Index.linkElements && cuts cardModel >= Lib.Links.linkCeiling
      )
    , ( "a unit page of the most hostile links draws no more than linkElements per link and draws every link cut"
      , delta unitPageModel <= (Lib.Links.linkCeiling - 1) * Index.linkElements && cuts unitPageModel >= Lib.Links.linkCeiling
      )
    , ( "the most hostile links hold no more bytes than their share of the queue label ceiling"
      , linkBytes > 0 && linkBytes <= Lib.Links.linkCeiling * Lib.Links.linkByteCeiling
      )
    ]


-- ── checks on the seeded fixture units ──────────────────────────────────
seededChecks : Index.UnitView -> Index.UnitView -> List ( String, Bool )
seededChecks a b =
    let
        shownCard =
            page (cardModel a)

        shownPage =
            page (unitPageModel a)

        unit =
            a.unit

        hostileName =
            { a | unit = { unit | qualified = labelOf hostileText } }

        hostilePath =
            { a | unit = { unit | path = labelOf hostileText } }

        opened =
            page (refusingModel a)

        hostileHistory =
            historyModel [ { entry = Unverified { uid = Just a.unit.uid, bodyHash = "h", reviewedAt = Timestamp.fromUnixMillis 0, why = Legacy }, label = Queue.FileLabelled (labelOf hostileText) Queue.Indexed } ]

        readOnlyCard =
            page (cardModelUnder ShownUnkeyed a)

        brokenCard =
            page (cardModelUnder (ShownBroken (BreaksAt 2)) a)

        banner =
            "The review log&#39;s chain breaks at entry 2"

        pastHeadCard =
            page (cardModelUnder (ShownBroken (PastHead 2)) a)

        keyMismatchCard =
            page (cardModelUnder ShownKeyMismatch a)

        beforeFirstCard =
            page (cardModelUnder (ShownBroken (BeforeFirst 1)) a)

        twin =
            { unit | uid = uid "u-twin", path = labelOf "ipe:src/twin.rs" }

        twinCard =
            page { baseModel | queueState = Loaded (queuePage [ queued a, { unit = twin, change = New, changed = Nothing, standing = Queue.Undecided } ] 2 { reviewed = 0, total = 2 }), selectedView = ViewShown a }

        placeOf path =
            path ++ ":" ++ String.fromInt unit.lineStart

        historyPage =
            page (unverifiedHistory ShownProven Legacy)

        documented title html =
            has ("<title>" ++ title ++ " · Code review</title>") html
                && has "lang=\"en\"" html
                && List.length (String.split "<h1" html) == 2

        standingPage bodyHash standing =
            page { baseModel | page = UnitPage (Uid.toString a.unit.uid), selectedView = ViewShown a, standing = Queue.StandingShown a.unit.uid bodyHash standing }

        currentHash =
            Index.storedHash a.unit.attested

        approvedPage =
            standingPage currentHash (Queue.Decided StoredApproved)

        tamperedPage =
            standingPage currentHash (Queue.NotCounted Tampered)

        undecidedPage =
            standingPage currentHash Queue.Undecided

        olderBodyPage =
            standingPage (currentHash ++ "-older") (Queue.Decided StoredApproved)

        tamperedCard =
            page { baseModel | queueState = Loaded (queuePage [ { unit = a.unit, change = Unrecorded, changed = Nothing, standing = Queue.NotCounted Tampered } ] 1 { reviewed = 0, total = 1 }), selectedView = ViewShown a }

        noControl html =
            not (button "Approve" html) && not (button "Refuse" html) && not (has "a approve" html)

        everyPage =
            [ shownCard, shownPage, opened, page hostileHistory, readOnlyCard, brokenCard, pastHeadCard, keyMismatchCard, beforeFirstCard, page (unverifiedHistory (ShownBroken (BreaksAt 2)) ChainBroken) ]
    in
    [ ( "a verified source shows Approve, Refuse and its source text", button "Approve" shownCard && button "Refuse" shownCard && has sourceMarker shownCard )
    , ( "a withheld source shows its reason, no decision button and no source text, for every stale reason and an unreadable file", List.all (withheldRefuses a) withheldCases )
    , ( "a withheld source offers no decision with the refusal panel open", List.all (withheldRefusePanelRefuses a) withheldCases )
    , ( "the unit page shows a verified source and never a decision button", has sourceMarker shownPage && noDecisionButtons shownPage )
    , ( "an open refusal panel shows Confirm and Cancel in place of Approve and Refuse", button "Confirm" opened && button "Cancel" opened && not (button "Approve" opened) && not (button "Refuse" opened) )
    , ( "the escaped needle differs from the raw hostile text, and a benign render holds no script tag, no href and shows the unit name", hostileEscaped /= hostileText && renderedForeign (codeText 8238) /= codeText 8238 && not (has "<script" shownCard) && not (has "href=" shownCard) && has "Lib.answer" shownCard )
    , ( "a hostile unit name is escaped on the queue page and the unit page", escapesHostile (page (cardModel hostileName)) && escapesHostile (page (unitPageModel hostileName)) )
    , ( "a hostile unit path is escaped on the queue page and the unit page", escapesHostile (page (cardModel hostilePath)) && escapesHostile (page (unitPageModel hostilePath)) )
    , ( "a hostile history name is escaped", escapesHostile (page hostileHistory) )
    , ( "a hostile unit name, unit path and history name each draw in byte order", hostileInByteOrder "" (page (cardModel hostileName)) && hostileInByteOrder "" (page (unitPageModel hostileName)) && hostileInByteOrder "" (page (cardModel hostilePath)) && hostileInByteOrder "" (page hostileHistory) )
    , ( "untrusted text draws in byte order, and text with no hazard draws no escape marker", has "unicode-bidi:bidi-override" View.displayOrderCss && has "direction:ltr" View.displayOrderCss && has "background-color:" View.escapeCss && has "border:" View.escapeCss && not (has "data-review-escape" shownCard) && has (byteOrderOpen ++ "Lib.answer") shownCard )
    , ( "two units sharing a kind and name each show their place, a unit alone shows its kind and no place"
      , has (placeOf "ipe:src/twin.rs") twinCard
            && has (placeOf (labelText unit.path)) twinCard
            && has (labelText unit.kind) shownCard
            && not (has (placeOf (labelText unit.path)) shownCard)
      )
    , ( "every page has a title naming it, a language and one h1, and each unit card or history entry opens an h2"
      , documented "Queue" shownCard
            && documented "Queue" (page baseModel)
            && documented "History" historyPage
            && documented "Unit" shownPage
            && documented "Unit" (page (addressModel "not a uid"))
            && has "<h2" shownCard
            && has "<h2" shownPage
            && has "<h2" historyPage
            && not (has "<title></title>" shownCard)
            && not (has "<h2" (page baseModel))
      )
    , ( "the unit page of a decided unit names its decision, a reopened unit says why its row is not counted, and an undecided one says it is not reviewed"
      , has "Approved" approvedPage
            && not (has "Not reviewed" approvedPage)
            && has "signature does not verify" tamperedPage
            && not (has "Approved" tamperedPage)
            && has "Not reviewed" undecidedPage
            && not (has "Approved" undecidedPage)
            && noDecisionButtons approvedPage
      )
    , ( "a standing read for another body of the unit shows no decision, only that the read is running"
      , not (has "Approved" olderBodyPage)
            && has "Reading review status" olderBodyPage
            && has "Reading review status" shownPage
      )
    , ( "a queued unit whose row for the current body does not verify says so on its card and in the rail, never as an unreviewed unit"
      , List.length (String.split "signature does not verify" tamperedCard) == 3
            && not (has "Not reviewed" tamperedCard)
            && has "Not reviewed" shownCard
      )
    , ( "each queue state renders its own text and no other state's", List.all showsOnly stateCases )
    , ( "a queue with open units renders none of the state texts and its header", showsNoStateText (page (cardModel a)) && has (showingLine (queuePage [ queued a ] 1 { reviewed = 0, total = 1 })) shownCard )
    , ( "the progress line and the showing header follow the model's counts", countsFollowModel a b )
    , ( "a refused draft shows its case's fixed text in the open refusal panel", refuseErrorFixedText a )
    , ( "a failed decision save shows its case's fixed text in the queue banner", decisionErrorFixedText a )
    , ( "the reported address is escaped as an attribute value", pathAttributeEscaped a )
    , ( "an unsafe link target renders as plain text with no href", List.all (unsafeLinkHasNoHref a) unsafeTargets )
    , ( "an https link target renders as an href", safeLinkHasHref a )
    , ( "a URL at the href ceiling is linked whole and one byte over is shown cut and never linked", hrefCeilingIsExact a )
    , ( "a URL under the href ceiling whose label its escape runs cut is shown cut and never linked", escapeCutUrlIsUnlinked a )
    , ( "a read-only server shows no decision control and says why, beside a signing server that shows them", not (button "Approve" readOnlyCard) && not (button "Refuse" readOnlyCard) && has "Read-only: IPE_REVIEW_MAC_KEY is not set, so no decision is recorded." readOnlyCard && button "Approve" shownCard && not (has "Read-only:" shownCard) )
    , ( "a broken chain shows its banner, naming the entry, on the queue and the History, and an intact one shows none", has banner brokenCard && has banner (page (unverifiedHistory (ShownBroken (BreaksAt 2)) ChainBroken)) && not (has "chain breaks" shownCard) && not (has "chain breaks" (page hostileHistory)) )
    , ( "a log with entries past its head and a log signed by another key each show their own banner"
      , has "The review log holds 2 entries past its head: a decision was added outside this tool." pastHeadCard
            && not (has "chain breaks" pastHeadCard)
            && has "The review log was signed by a different IPE_REVIEW_MAC_KEY: no decision in it counts." keyMismatchCard
            && not (has "chain breaks" keyMismatchCard)
            && has "The review log holds 1 entry before its first: a decision was added outside this tool." beforeFirstCard
            && not (has "past its head" beforeFirstCard)
      )
    , ( "a log not proven under the server's key shows no decision control or shortcut and says why, beside a proven one that shows them"
      , List.all noControl [ brokenCard, pastHeadCard, beforeFirstCard, keyMismatchCard ]
            && has "The review log is not intact, so no decision is recorded until it is restored." brokenCard
            && has "The review log is not intact, so no decision is recorded until it is restored." pastHeadCard
            && has "The review log is not intact, so no decision is recorded until it is restored." beforeFirstCard
            && has "The review log was signed by a different IPE_REVIEW_MAC_KEY, so no decision is recorded." keyMismatchCard
            && not (has "Read-only:" brokenCard)
            && not (has "Read-only:" keyMismatchCard)
            && button "Approve" shownCard
            && has "a approve" shownCard
      )
    , ( "each reason an entry does not count shows its own text", List.all (\( why, text ) -> has text (page (unverifiedHistory ShownProven why))) unverifiedTexts )
    , ( "the review key never appears on any page", List.all (\html -> not (has testKeyHex html) && not (has (String.toUpper testKeyHex) html)) everyPage )
    ]


unverifiedTexts : List ( Unverified, String )
unverifiedTexts =
    [ ( Tampered, "Not counted: this row&#39;s signature does not verify" )
    , ( Legacy, "Not counted: recorded before rows were signed" )
    , ( NoKey, "Not counted: no key to verify it (read-only)" )
    , ( ChainBroken, "Not counted: the log&#39;s chain breaks before this row" )
    ]


showsNoStateText : String -> Bool
showsNoStateText html =
    List.all (\needle -> not (has needle html)) stateNeedles


-- ── a hostile source token ──────────────────────────────────────────────
-- True when `html` draws the hostile comment inside a code block, every
-- code block opens in byte order (`displayOrderCss` on the block itself),
-- and no element inside a block sets its own `unicode-bidi`, so none resets
-- the block's override.
hostileSourceInByteOrder : String -> Bool
hostileSourceInByteOrder html =
    let
        blocks =
            codeBlocks html
    in
    not (List.isEmpty blocks)
        && List.any (has ("// " ++ hostileEscaped)) blocks
        && List.all (\block -> String.startsWith ("style=\"" ++ View.codeCss ++ "\">") block && List.length (String.split "unicode-bidi" block) == 2) blocks
        && has View.displayOrderCss View.codeCss


-- Each `code` element of `html`, from its attributes to its close.
codeBlocks : String -> List String
codeBlocks html =
    List.filterMap (\piece -> List.head (String.split "</code>" piece)) (List.drop 1 (String.split "<code " html))


-- The nesting depth, the root counted, of the deepest element inside a
-- `code` block of `html`, or 0 when it has none. Every `<` of the markup
-- opens or closes a tag, since the sink escapes it in text and attributes;
-- a tag ending in `/>` is void and opens no level.
deepestDrawnDepth : String -> Int
deepestDrawnDepth html =
    (List.foldl drawnDepthStep { depth = 0, code = Nothing, deepest = 0 } (List.drop 1 (String.split "<" html))).deepest


drawnDepthStep : String -> { depth : Int, code : Maybe Int, deepest : Int } -> { depth : Int, code : Maybe Int, deepest : Int }
drawnDepthStep piece state =
    if String.startsWith "/" piece then
        let
            depth =
                state.depth - 1
        in
        case state.code of
            Just codeDepth ->
                if depth < codeDepth then
                    { state | depth = depth, code = Nothing }

                else
                    { state | depth = depth }

            Nothing ->
                { state | depth = depth }

    else if String.startsWith "!" piece then
        state

    else
        let
            depth =
                state.depth + 1

            void =
                String.endsWith "/" (Maybe.withDefault piece (List.head (String.split ">" piece)))

            code =
                case state.code of
                    Just codeDepth ->
                        Just codeDepth

                    Nothing ->
                        if String.startsWith "code " piece || String.startsWith "code>" piece then
                            Just depth

                        else
                            Nothing

            deepest =
                case code of
                    Just _ ->
                        max state.deepest depth

                    Nothing ->
                        state.deepest

            open =
                if void then
                    state.depth

                else
                    depth
        in
        { depth = open, code = code, deepest = deepest }


-- A page draws its source within the depth the runtime's cost per element
-- holds at: an element's id spells each of its ancestors, so a layout that
-- wraps the source deeper costs every drawn element more than the element
-- ceiling is sized by. The page must draw an escape inside a coloured run,
-- the deepest drawn element, so the depth is measured, not assumed. Red if
-- a wrapper moves the source past `Index.drawnDepthCeiling`.
drawnDepthWithinBound : String -> Bool
drawnDepthWithinBound html =
    let
        deepest =
            deepestDrawnDepth html
    in
    List.any (has "data-review-escape") (codeBlocks html)
        && 0 < deepest
        && deepest <= Index.drawnDepthCeiling


-- The fixture unit's four lines with a comment holding `hostileText`, then the
-- six ASCII characters of an escape spelling and the real U+200B it names.
hostileView : String
hostileView =
    "pub fn answer() -> i32 {\n    // " ++ hostileText ++ asciiSpelling ++ codeText 8203 ++ "\n    42\n}"


asciiSpelling : String
asciiSpelling =
    " \\u{200b}x"


-- The fixture library with lines 3..6 replaced by `hostileView`, and the
-- unit's stored attestation re-pointed at them, so the source is shown
-- (it re-hashes) while its text is hostile.
hostileSourceChecks : Task.Task Error (List ( String, Bool ))
hostileSourceChecks =
    do
        at <- freshScratch "ipe-view-render-hostile-source"
        seedIndex at.indexDb at.repo
        writeFileText (at.repo ++ "/src/Lib.rs") ("// fixture library\n\n" ++ hostileView ++ "\n")
        execIndex at.indexDb "UPDATE units SET body_hash = ? WHERE uid = ?" [ SqlString (Index.attest hostileView), Uid.toSql (uid "u-a") ]
        loaded <- loadUnitNow (uid "u-a") |> Task.andThen requireUnit
        cleanupIndex at.indexDb at.repo
        Task.succeed
            [ ( "the hostile fixture source is verified and shown", isShown loaded )
            , ( "a hostile source token is escaped on the queue page", escapesHostile (page (cardModel loaded)) )
            , ( "a hostile source token is escaped on the unit page", escapesHostile (page (unitPageModel loaded)) )
            , ( "a hostile source token draws in its code block's byte order, which no element inside resets", hostileSourceInByteOrder (page (cardModel loaded)) && hostileSourceInByteOrder (page (unitPageModel loaded)) )
            , ( "source text spelling an escape draws as plain text, the real character it names as a marked escape", has (hostileEscaped ++ asciiSpelling ++ escapeMarkup "\\u{200b}") (page (cardModel loaded)) && not (has (codeText 8203) (page (cardModel loaded))) )
            , ( "a hostile source still offers its decision buttons", button "Approve" (page (cardModel loaded)) && button "Refuse" (page (cardModel loaded)) )
            , ( "the unit page and the queue card draw their source within the drawn depth ceiling", drawnDepthWithinBound (page (unitPageModel loaded)) && drawnDepthWithinBound (page (cardModel loaded)) )
            ]


-- The fixture unit's four lines, each of 1100 escapes after an `a`: past
-- the element ceiling drawn plain, so the view is shown spelled out.
spelledView : String
spelledView =
    String.join "\n" (List.repeat 4 (String.repeat 1100 ("a" ++ codeText 8238)))


-- A unit too escape-dense to draw with marked escapes is shown spelled out:
-- on the unit page and the queue card it carries the spelled-out note, its
-- escapes spelled and none raw, its decision buttons, within the element
-- and drawn depth ceilings. Red if the spelled drawing is withheld, unnoted,
-- or draws past a ceiling.
spelledSourceChecks : Task.Task Error (List ( String, Bool ))
spelledSourceChecks =
    do
        at <- freshScratch "ipe-view-render-spelled-source"
        seedIndex at.indexDb at.repo
        writeFileText (at.repo ++ "/src/Lib.rs") ("// fixture library\n\n" ++ spelledView ++ "\n")
        execIndex at.indexDb "UPDATE units SET body_hash = ? WHERE uid = ?" [ SqlString (Index.attest spelledView), Uid.toSql (uid "u-a") ]
        loaded <- loadUnitNow (uid "u-a") |> Task.andThen requireUnit
        cleanupIndex at.indexDb at.repo
        let
            pages =
                [ page (unitPageModel loaded), page (cardModel loaded) ]

            depth html =
                0 < deepestDrawnDepth html && deepestDrawnDepth html <= Index.drawnDepthCeiling
        in
        Task.succeed
            [ ( "an escape-dense source is verified and shown", isShown loaded )
            , ( "an escape-dense source is shown spelled out, its escapes spelled and none raw", List.all (\html -> has "Shown spelled out:" html && has "\\u{202e}" html && not (has (codeText 8238) html)) pages )
            , ( "a spelled-out source still offers its decision buttons", List.all (\html -> button "Approve" html && button "Refuse" html) pages )
            , ( "a spelled-out source page draws within the element ceilings", List.all (\html -> elementsOf html <= Index.viewNodeCeiling + Index.queueElementCeiling) pages )
            , ( "a spelled-out source draws within the drawn depth ceiling", List.all depth pages )
            ]


-- ── stored decisions ────────────────────────────────────────────
-- A reason one character past the bound, signed into the review log as an
-- older file may hold it.
overlongReason : String
overlongReason =
    String.repeat (LibDb.reasonMaxChars + 1) "Q"


insertReviewWith : Db -> String -> String -> String -> Maybe String -> Task.Task Error ()
insertReviewWith db unitLabel hash decision reason =
    appendSigned db (rawRow unitLabel hash decision reason)
        |> Task.map (\_ -> ())


requireRow : Maybe ReviewEntry -> Task.Task Error LibDb.VerifiedRow
requireRow found =
    case found of
        Just (Verified row) ->
            Task.succeed row

        Just (Unverified _) ->
            Task.fail (Error.conflict "a fixture review row does not verify")

        Nothing ->
            Task.fail (Error.conflict "a fixture review row is missing")


storedChecks : Task.Task Error (List ( String, Bool ))
storedChecks =
    do
        at <- freshScratch "ipe-view-render-stored"
        seedIndex at.indexDb at.repo
        loaded <- loadUnitNow (uid "u-a") |> Task.andThen requireUnit
        db <- migratedReviewAt at.reviewDb
        insertReviewWith db "u-a" "h-long" "refuse" (Just overlongReason)
        insertReviewWith db "u-b" "h-ok" "refuse" (Just "needs a test")
        insertReviewWith db "u-c" "h-yes" "approve" Nothing
        verify <- countingVerifier db
        long <- LibDb.findDecision verify db (uid "u-a") "h-long" |> Task.andThen requireRow
        ok <- LibDb.findDecision verify db (uid "u-b") "h-ok" |> Task.andThen requireRow
        yes <- LibDb.findDecision verify db (uid "u-c") "h-yes" |> Task.andThen requireRow
        cleanupIndex at.indexDb at.repo
        removeFileIfAny at.reviewDb
        removeFileIfAny (at.reviewDb ++ "-wal")
        removeFileIfAny (at.reviewDb ++ "-shm")
        Task.succeed (storedPure loaded long ok yes)


-- The checks over rows read back from a review table.
storedPure : Index.UnitView -> LibDb.VerifiedRow -> LibDb.VerifiedRow -> LibDb.VerifiedRow -> List ( String, Bool )
storedPure loaded long ok yes =
    let
        lengthNote =
            "reason not shown: " ++ String.fromInt (String.length overlongReason) ++ " characters"

        hiddenInHistory =
            page (historyModel [ historyRowOf long ])

        hiddenOnCard =
            page (changedModel loaded long)

        okInHistory =
            page (historyModel [ historyRowOf ok ])

        okOnCard =
            page (changedModel loaded ok)

        approvedInHistory =
            page (historyModel [ historyRowOf yes ])

        refusedInHistory =
            page (historyModel [ historyRowOf ok ])

        goneLabel =
            { kind = labelOf "const", name = labelOf "crate::FILE", place = Queue.At (labelOf "ipe:src/b.rs") 9 }

        goneHistory =
            page (historyModel [ { entry = Verified yes, label = Queue.Labelled goneLabel Queue.NoLongerIndexed } ])

        indexedHistory =
            page (historyModel [ { entry = Verified yes, label = Queue.Labelled goneLabel Queue.Indexed } ])

        goneFileHistory =
            page (historyModel [ { entry = Verified yes, label = Queue.FileLabelled (labelOf "ipe:src/blob.bin") Queue.NoLongerIndexed } ])

        unnamedHistory =
            page (historyModel [ { entry = Verified yes, label = Queue.Unnamed } ])
    in
    [ ( "an over-long stored reason shows its length and none of its text, in the History and on a changed card", has lengthNote hiddenInHistory && has lengthNote hiddenOnCard && not (has (String.repeat 20 "Q") hiddenInHistory) && not (has (String.repeat 20 "Q") hiddenOnCard) )
    , ( "a valid stored reason is shown in the History and on a changed card", has "needs a test" okInHistory && has "needs a test" okOnCard && not (has "reason not shown" okInHistory) )
    , ( "a stored approval shows its badge and no refusal", has "✓ Approved" approvedInHistory && not (has "✗ Refused" approvedInHistory) )
    , ( "a stored refusal shows its badge and no approval", has "✗ Refused" refusedInHistory && not (has "✓ Approved" refusedInHistory) )
    , ( "a changed card names a previous approval", has "Previously Approved" (page (changedModel loaded yes)) )
    , ( "a changed card names a previous refusal with its reason", has "Previously Refused (needs a test)" okOnCard )
    , ( "a History entry of a unit gone from the index shows its kind, name and place, says it is no longer indexed, and holds no run of 64 hex characters, beside one still indexed"
      , has "const" goneHistory
            && has "crate::FILE" goneHistory
            && has "ipe:src/b.rs" goneHistory
            && has ":9" goneHistory
            && has "no longer indexed" goneHistory
            && longestHexRun goneHistory < 64
            && has "crate::FILE" indexedHistory
            && not (has "no longer indexed" indexedHistory)
            && longestHexRun (Uid.toString (LibDb.verifiedUid yes)) >= 64
      )
    , ( "a History entry of a file gone from the index shows its path and says it is no longer indexed, with no uid"
      , has "ipe:src/blob.bin" goneFileHistory
            && has "no longer indexed" goneFileHistory
            && longestHexRun goneFileHistory < 64
      )
    , ( "an unnamed History entry shows its fixed text and its short body hash, and no uid"
      , has "unit no longer indexed (no verified record of its name)" unnamedHistory
            && has "h-yes" unnamedHistory
            && longestHexRun unnamedHistory < 64
            && not (has "no verified record of its name" goneHistory)
      )
    ]


-- The longest run of hex digits in `text`: a uid is 64 of them.
longestHexRun : String -> Int
longestHexRun text =
    String.foldl
        (\c run ->
            if String.contains (String.fromChar c) "0123456789abcdefABCDEF" then
                { current = run.current + 1, longest = max run.longest (run.current + 1) }

            else
                { current = 0, longest = run.longest }
        )
        { current = 0, longest = 0 }
        text
        |> .longest


-- ── harness ─────────────────────────────────────────────────────────────
-- A group whose fixtures fail to build reports one failed check by name, with
-- the error, instead of ending the run.
group : String -> Task.Task Error (List ( String, Bool )) -> Task.Task Error (List ( String, Bool ))
group name task =
    task
        |> Task.onError (\e -> checkReporting Io.println name (Task.fail e) |> Task.map (\failed -> [ failed ]))


-- The element that carries the shortcut handler's `tabindex` also carries
-- `autofocus`, and it is the page's only autofocused element, so keys work
-- from page load. Red if the root stops taking focus, or focus is claimed by
-- another element first.
shortcutRootAutofocused : Bool
shortcutRootAutofocused =
    let
        html =
            page baseModel
    in
    List.any (\tag -> has "tabindex=\"0\"" tag && has "autofocus" tag) (String.split "<" html)
        && List.length (String.split "autofocus" html) == 2


-- ── unreviewable files ──────────────────────────────────────────────────
--
-- An unreviewable file's stored path is index text: it reaches the queue
-- card and the History page escaped, and only an acknowledgeable file on a
-- server that can sign is offered a decision. The rows are read from a
-- seeded index, so the card renders what the decoder makes of them.
refusalChecks : Task.Task Error (List ( String, Bool ))
refusalChecks =
    do
        at <- freshScratch "ipe-view-render-refusals"
        seedIndex at.indexDb at.repo
        System.setenv "IPE_REVIEW_DB" at.reviewDb
        db <- migratedReviewAt at.reviewDb
        execIndex at.indexDb
            "INSERT INTO refusals (uid, path, lang, reason, size, digest) VALUES (?, ?, 'other', 'symlink-entry', NULL, ?)"
            [ Uid.toSql (uid "r-link"), SqlString ("ipe:src/" ++ hostileText), SqlString ("refusal-blake3:" ++ String.repeat 64 "a") ]
        execIndex at.indexDb
            "INSERT INTO refusals (uid, path, lang, reason, size, digest) VALUES (?, ?, 'other', 'replaced', NULL, NULL)"
            [ Uid.toSql (uid "r-gone"), SqlString "ipe:src/replaced.txt" ]
        loaded <- loadPageNow Index.Start
        decided <- case Maybe.andThen (\row -> row.digest) (List.find (\row -> row.uid == uid "r-link") loaded.refusals) of
                    Just digest ->
                        accepted "the acknowledgement of r-link" (decidedRefusalNow db "r-link" digest)
                            |> Task.map (\_ -> True)

                    Nothing ->
                        Task.succeed False
        history <- loadHistoryPageNow HistoryStart
        cleanupIndex at.indexDb at.repo
        removeFileIfAny at.reviewDb
        proven <- Task.succeed (page { baseModel | queueState = Loaded { loaded | log = ShownProven } })
        unkeyed <- Task.succeed (page { baseModel | queueState = Loaded { loaded | log = ShownUnkeyed } })
        historyHtml <- Task.succeed (page (historyModel history.rows))
        Task.succeed
            [ ( "an unreviewable file's hostile path is escaped on its queue card", escapesHostile proven && has "Unreviewable files" proven )
            , ( "only the acknowledgeable file is offered Acknowledge; the blocking one says to fix it", List.length (String.split ">Acknowledge<" proven) == 2 && has "Cannot be acknowledged: fix it in the tree." proven && has "Replaced while the index read it" proven )
            , ( "a server that cannot sign offers no acknowledgement", not (button "Acknowledge" unkeyed) && has "Cannot be acknowledged: fix it in the tree." unkeyed )
            , ( "an acknowledged file is named on the History page, its hostile path escaped", decided && escapesHostile historyHtml )
            ]


-- ── untrusted text reaches a page only through the one sink ─────────
-- The page states that show a load failure.
type FailureSlot
    = QueueSlot
    | HistorySlot
    | UnitSlot
    | SourceSlot


-- A load failure renders its case's fixed text inside a byte-order element,
-- with none of the error's bytes; a computed text with untrusted parts (an
-- unreadable file's stored path, the index file's name) keeps its escapes and
-- its byte order; the document title holds only this tool's words. Each
-- refusal renders beside the benign form through the same path.
untrustedSinkChecks : Index.UnitView -> List ( String, Bool )
untrustedSinkChecks loaded =
    let
        hostileFailure =
            Failure.loadFailureOf (Error.unexpected hostileText)

        terminalFailure =
            Failure.loadFailureOf (Error.unexpected (codeText 27 ++ "[2J" ++ codeText 8238))

        noErrorBytes html =
            not (has "<script" html)
                && not (has "&lt;script" html)
                && not (has "alert(1)" html)
                && not (has (codeText 8238) html)
                && not (has (codeText 27) html)
                && not (has "[2J" html)
                && not (has "data-review-escape" html)

        fixedInByteOrder prefix failure html =
            has (byteOrderOpen ++ Html.escapeHtml (prefix ++ Failure.loadFailureText failure)) html

        queueFailed failure =
            page { baseModel | queueState = Failed failure }

        historyFailed failure =
            page { baseModel | page = HistoryPage, history = HistoryFailed failure }

        unitFailed failure =
            page { baseModel | page = UnitPage (Uid.toString loaded.unit.uid), selectedView = ViewFailed loaded.unit.uid failure }

        card =
            cardModel loaded

        viewFailed failure =
            page { card | selectedView = ViewFailed loaded.unit.uid failure }

        render slot failure =
            case slot of
                QueueSlot ->
                    queueFailed failure

                HistorySlot ->
                    historyFailed failure

                UnitSlot ->
                    unitFailed failure

                SourceSlot ->
                    viewFailed failure

        prefixOf slot =
            case slot of
                QueueSlot ->
                    "Queue failed to load: "

                HistorySlot ->
                    "History load failed: "

                UnitSlot ->
                    "Unit load failed: "

                SourceSlot ->
                    "Source load failed: "

        everyCase =
            [ LoadContended, LoadPastLimit, LoadFailed ]

        slotRefuses slot =
            fixedInByteOrder (prefixOf slot) hostileFailure (render slot hostileFailure)
                && noErrorBytes (render slot hostileFailure)
                && fixedInByteOrder (prefixOf slot) terminalFailure (render slot terminalFailure)
                && noErrorBytes (render slot terminalFailure)
                && List.all (\failure -> fixedInByteOrder (prefixOf slot) failure (render slot failure)) everyCase

        unreadable stored =
            { loaded | view = Unreadable (NoFile (quotedLabelOf stored)) }

        unreadablePrefix =
            byteOrderOpen ++ Html.escapeHtml "Source unreadable: index path "

        hostileUnreadableCard =
            page (cardModel (unreadable hostileText))

        hostileUnreadablePage =
            page (unitPageModel (unreadable hostileText))

        benignUnreadableCard =
            page (cardModel (unreadable "ipe:gone.rs"))

        headerModel name =
            { baseModel | queueState = Loaded (queuePage [] 0 { reviewed = 0, total = 0 } |> \shown -> { shown | dbName = name }) }

        unit =
            loaded.unit

        hostileName =
            { loaded | unit = { unit | qualified = labelOf hostileText } }

        titleOf html =
            String.split "</title>" html |> List.head |> Maybe.withDefault html
    in
    [ ( "every load failure slot renders its case's fixed text in byte order and none of a hostile error's bytes", List.all slotRefuses [ QueueSlot, HistorySlot, UnitSlot, SourceSlot ] )
    , ( "a hostile error and a benign one fail the queue load with the same fixed text", queueFailed hostileFailure == queueFailed LoadFailed && hostileFailure == LoadFailed )
    , ( "an unreadable file's hostile stored path keeps its escapes and byte order on the queue card and the unit page"
      , has unreadablePrefix hostileUnreadableCard
            && escapesHostile hostileUnreadableCard
            && has unreadablePrefix hostileUnreadablePage
            && escapesHostile hostileUnreadablePage
            && has (unreadablePrefix ++ Html.escapeHtml "\"ipe:gone.rs\"") benignUnreadableCard
            && not (has "data-review-escape" benignUnreadableCard)
      )
    , ( "a hostile index file name keeps its escapes and byte order in the queue header"
      , hostileInByteOrder "" (page (headerModel (SafeText.renderForeign hostileText)))
            && has (byteOrderOpen ++ "index.db · ") (page (headerModel (SafeText.literal "index.db")))
      )
    , ( "a unit page's title names the page, never the unit, so a hostile unit name leaves no bytes in the title"
      , has "<title>Unit · Code review</title>" (page (unitPageModel hostileName))
            && not (has "script" (titleOf (page (unitPageModel hostileName))))
            && not (has (codeText 8238) (titleOf (page (unitPageModel hostileName))))
            && escapesHostile (page (unitPageModel hostileName))
            && has "<title>Queue · Code review</title>" (page (cardModel hostileName))
            && not (has "script" (titleOf (page (cardModel hostileName))))
      )
    ]


-- ── a full queue page of hostile labels ────────────────────────────────
-- A column of `Label.windowChars` characters that opens an escape run every
-- other character, so each label of it takes the most escape runs and a
-- marker.
hostileColumn : String
hostileColumn =
    String.left Label.windowChars (String.repeat Label.windowChars (codeText 8238 ++ "a" ++ codeText 0 ++ "\\"))


-- A queued unit whose every display column is `column`, so every unit of a
-- page of them shares a kind, a name and a place and is told apart by uid.
budgetUnit : Index.Unit -> String -> String -> Queue.QueuedUnit
budgetUnit unit column id =
    { unit =
        { unit
            | uid = uid id
            , kind = labelOf column
            , name = labelOf column
            , qualified = labelOf column
            , path = labelOf column
            , facing = labelOf column
            , purpose = Just (Label.fromText Label.purposeCap column)
        }
    , change = New
    , changed = Nothing
    , standing = Queue.Undecided
    }


budgetRefusal : String -> Index.RefusalRow
budgetRefusal id =
    { uid = uid id
    , path = labelOf hostileColumn
    , lang = labelOf "other"
    , reason = UnreadableEntry
    , size = Nothing
    , digest = Nothing
    }


-- The queue page holding `units` and `refusals`, nothing selected.
budgetModel : List Queue.QueuedUnit -> List Index.RefusalRow -> Model
budgetModel units refusals =
    let
        shown =
            queuePage units (List.length units) { reviewed = 0, total = List.length units }
    in
    { baseModel | queueState = Loaded { shown | refusals = refusals, refusalsOpen = List.length refusals } }


-- The elements a page's markup opens: every `<` that does not close one.
elementsOf : String -> Int
elementsOf html =
    List.length (String.split "<" html) - List.length (String.split "</" html)


unitLabelBytes : Queue.QueuedUnit -> Int
unitLabelBytes q =
    List.sum (List.map Label.byteCount [ q.unit.kind, q.unit.name, q.unit.qualified, q.unit.path, q.unit.facing ])
        + Maybe.withDefault 0 (Maybe.map Label.byteCount q.unit.purpose)


-- The place a unit's card names, as the markup spells it after its path.
uidPlace : String -> String
uidPlace id =
    " · " ++ Uid.toString (uid id) ++ "</span>"


queueBudgetChecks : Index.UnitView -> List ( String, Bool )
queueBudgetChecks loaded =
    let
        ids prefix =
            List.map (\n -> prefix ++ String.fromInt n) (List.range 1 (PageSize.toInt PageSize.queue))

        units =
            List.map (budgetUnit loaded.unit hostileColumn) (ids "u-budget-")

        refusals =
            List.map budgetRefusal (ids "r-budget-")

        full =
            page (budgetModel units refusals)

        labelBytes =
            List.sum (List.map unitLabelBytes units) + List.sum (List.map (\row -> Label.byteCount row.path) refusals)

        twinColumn tail =
            String.repeat Label.windowChars "n" ++ tail

        twins =
            [ budgetUnit loaded.unit (twinColumn "x") "u-twin-x", budgetUnit loaded.unit (twinColumn "y") "u-twin-y" ]

        twinPage =
            page (budgetModel twins [])

        unit =
            loaded.unit

        withPath path =
            page (cardModel { loaded | unit = { unit | path = labelOf path } })

        plainPath =
            "ipe:src/plain-path.rs"

        nulPath =
            String.repeat 100 (codeText 0)

        escapesIn html =
            List.length (String.split "data-review-escape" html)

        pathDraws =
            List.length (String.split plainPath (withPath plainPath)) - 1
    in
    [ ( "a full queue page of hostile labels draws no more elements than the queue element ceiling, and draws every unit cut with its marker"
      , elementsOf full <= Index.queueElementCeiling
            && List.all (\id -> has (uidPlace id) full) (ids "u-budget-")
            && has "data-review-cut" full
            && has "data-review-escape" full
      )
    , ( "a full queue page of hostile labels holds no more label bytes than the queue label ceiling"
      , labelBytes <= Index.queueLabelByteCeiling && labelBytes > 0
      )
    , ( "two units whose columns share their read window and byte length share a label and are told apart by uid"
      , Label.key (labelOf (twinColumn "x")) == Label.key (labelOf (twinColumn "y"))
            && has (uidPlace "u-twin-x") twinPage
            && has (uidPlace "u-twin-y") twinPage
      )
    , ( "a hundred adjacent NULs in a unit path draw one escape element wherever the path shows"
      , pathDraws >= 1 && escapesIn (withPath nulPath) - escapesIn (withPath plainPath) == pathDraws
      )
    ]


checks : Task.Task Error (List ( String, Bool ))
checks =
    Task.sequence
        [ group "view fixtures" (withSeededIndex "ipe-view-render-seeded" (\a b -> Task.succeed (seededChecks a b ++ untrustedSinkChecks a ++ queueBudgetChecks a ++ maxLinksFitBudget a)))
        , group "hostile source fixture" hostileSourceChecks
        , group "spelled source fixture" spelledSourceChecks
        , group "stored decision fixture" storedChecks
        , group "unreviewable file fixture" refusalChecks
        , Task.succeed [ ( "the shortcut root takes focus on page load", shortcutRootAutofocused ) ]
        , group "withheld constructors" (everyWithheldConstructorRendered |> Task.map (\ok -> [ ( "every withheld source constructor Lib.Index declares is rendered", ok ) ]))
        ]
        |> Task.map List.concat
