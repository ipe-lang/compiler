module FailureScanTests exposing (checks)

import Ipe.ByteSize as ByteSize
import Ipe.Char as Char
import Ipe.Error as Error
import Ipe.File as File
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Path as Path exposing (Path)
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task
import Ipe.Tuple as Tuple
import TestSupport exposing (check)


-- ── the source scan ─────────────────────────────────────────────────────
--
-- No error's text reaches a page: a page shows only the typed failure case
-- its callback decided. Three scans over `src` hold that by construction.
-- An error becomes text only at the admitted sites, each keyed by its file
-- and enclosing top-level name; no type reachable from the app's `Model` and
-- `Msg` names `Error`; the view does not import `Ipe.Error`.
-- Each scan reads tokens, maximal runs of `[A-Za-z0-9_.]`, never substrings,
-- so `refuseError` is not `Error`. Each returns its violations; none is a
-- pass.


-- The modules of `src`, each by its path relative to `src` with its text.
-- A file past `fileCeiling`, a module past `moduleByteCeiling`, or one that
-- cannot be read fails the read.
srcSources : Task.Task Error (List ( String, String ))
srcSources =
    do
        cwd <- System.cwd ()
        root <- Task.fromResult (Path.fromString (cwd ++ "/src"))
        files <- File.walk root
        bounded <- Task.fromResult (withinFileCeiling files)
        Task.sequence (List.map (readSource (Path.toString root ++ "/")) (List.filter (\path -> String.endsWith ".ipe" (Path.toString path)) bounded))


fileCeiling : Int
fileCeiling =
    64


moduleByteCeiling : ByteSize.ByteSize
moduleByteCeiling =
    ByteSize.kib 512


withinFileCeiling : List a -> Result Error (List a)
withinFileCeiling files =
    if List.length files > fileCeiling then
        Err (Error.limitExceeded ("src holds more than " ++ String.fromInt fileCeiling ++ " files"))

    else
        Ok files


readSource : String -> Path -> Task.Task Error ( String, String )
readSource prefix path =
    let
        file =
            Path.toString path
    in
    if String.startsWith prefix file then
        File.readFileLimit path moduleByteCeiling
            |> Task.map (\text -> ( String.dropLeft (String.length prefix) file, text ))

    else
        Task.fail (Error.unexpected (file ++ " is not under src"))


-- The tokens of `line`: maximal runs of ASCII letters, digits, `_` and `.`,
-- with each `=` and `|` a token of its own.
tokens : String -> List String
tokens line =
    line
        |> String.replace "=" " = "
        |> String.replace "|" " | "
        |> String.map
            (\c ->
                if tokenChar c then
                    c

                else
                    ' '
            )
        |> String.words


tokenChar : Char -> Bool
tokenChar c =
    (Char.isAlphaNum c && Char.toCode c < 128) || c == '_' || c == '.' || c == '=' || c == '|'


-- True when `text` begins with an ASCII character `test` accepts.
leadsWith : (Char -> Bool) -> String -> Bool
leadsWith test text =
    case String.uncons text of
        Just ( c, _ ) ->
            test c && Char.toCode c < 128

        Nothing ->
            False



-- ── conversion sites ────────────────────────────────────────────────────


-- The `Ipe.Error` calls that turn an error into text.
conversionFunctions : List String
conversionFunctions =
    [ "toString", "message", "kindName" ]


-- The fields of an error's record and of its details' records that hold
-- its text.
errorTextFields : List String
errorTextFields =
    [ "message", "stack", "expected", "actual" ]


-- The details constructors whose payload is text or a record of it.
textDetails : List String
textDetails =
    [ "Custom", "JsonDecode", "FfiPanic", "TypeMismatch" ]


-- The names a conversion call goes by in a module: each conversion under
-- `Error`, under `Ipe.Error`, and under every name the module imports
-- `Ipe.Error` as, and bare when an import of it exposes the call or
-- everything.
conversionNames : List Import -> List String
conversionNames imports =
    let
        errorImports =
            List.filter (\imp -> imp.moduleName == "Ipe.Error") imports

        qualifiers =
            List.unique ("Error" :: "Ipe.Error" :: List.map (\imp -> imp.qualifier) errorImports)

        bare =
            List.filter (\fn -> List.any (\imp -> List.member fn imp.exposed || List.member ".." imp.exposed) errorImports) conversionFunctions
    in
    "errorToString" :: bare ++ List.concatMap (\q -> List.map (\fn -> q ++ "." ++ fn) conversionFunctions) qualifiers


-- A token with its neighbours on the line, `""` past either end.
type alias SiteToken =
    { prev : String, token : String, next : String }


-- The tokens of `line` as the conversion scan reads them: `tokens`, with
-- each `,`, `{` and `}` a token of its own, so a record pattern shows.
siteTokens : String -> List SiteToken
siteTokens line =
    let
        words =
            line
                |> String.replace "," " , "
                |> String.replace "{" " { "
                |> String.replace "}" " } "
                |> String.map
                    (\c ->
                        if tokenChar c || c == ',' || c == '{' || c == '}' then
                            c

                        else
                            ' '
                    )
                |> String.words
    in
    List.map3 (\prev token next -> { prev = prev, token = token, next = next }) ("" :: words) words (List.drop 1 words ++ [ "" ])


-- An error becoming text at `at`: a conversion call, a read of an
-- error-text field (`info.message`, `.stack`), a record pattern binding one
-- (`{ message }`), or a text detail bound to a name (`Custom s`).
isConversion : List String -> SiteToken -> Bool
isConversion names at =
    List.member at.token names
        || List.any (\field -> String.endsWith ("." ++ field) at.token) errorTextFields
        || (List.member at.token errorTextFields && List.member at.prev [ "{", "," ] && List.member at.next [ ",", "}" ])
        || (List.any (\detail -> at.token == detail || String.endsWith ("." ++ detail) at.token) textDetails && at.next /= "_")


-- Every site an error becomes text: the startup refusals `Main` prints, the
-- root parse that names the failed path, and the server log.
admittedConversions : List String
admittedConversions =
    [ "Lib/RepoPath.ipe:parseRoot"
    , "Lib/ServerLog.ipe:logged"
    , "Main.ipe:requireReviewKey"
    , "Main.ipe:requireSettings"
    ]


type alias SiteScan =
    { name : String, sites : List String }


-- Each conversion token of `text`, keyed `rel:name` by the last column-0
-- lowercase line above it.
conversionSitesIn : String -> String -> List String
conversionSitesIn rel text =
    (indexModule ( rel, text )).sites


conversionSitesOf : String -> List Import -> List String -> List String
conversionSitesOf rel imports lines =
    let
        scanned =
            List.foldl (siteStep (conversionNames imports) rel) { name = "", sites = [] } lines
    in
    scanned.sites


siteStep : List String -> String -> String -> SiteScan -> SiteScan
siteStep names rel line scan =
    let
        name =
            if leadsWith Char.isLower line then
                Maybe.withDefault scan.name (List.head (tokens line))

            else
                scan.name

        found =
            List.filter (isConversion names) (siteTokens line)
    in
    { name = name, sites = List.map (\_ -> rel ++ ":" ++ name) found ++ scan.sites }


-- A conversion site `admitted` does not list, and an admitted site no
-- source holds.
conversionViolations : List String -> List ScanModule -> List String
conversionViolations admitted modules =
    let
        found =
            List.unique (List.concatMap (\scanned -> scanned.sites) modules)
    in
    List.map (\site -> "an error becomes text at " ++ site ++ ", which is not admitted") (List.filter (\site -> not (List.member site admitted)) found)
        ++ List.map (\site -> "the admitted site " ++ site ++ " holds no conversion") (List.filter (\site -> not (List.member site found)) admitted)



-- ── the types a page holds ──────────────────────────────────────────────


-- The stdlib types that hold no `Error` unless given one as a parameter,
-- which the token check sees.
leafTypes : List String
leafTypes =
    [ "Int", "Float", "Bool", "String", "Char", "Maybe", "List", "Result", "Dict", "Set", "Timestamp", "ByteSize" ]


reachCeiling : Int
reachCeiling =
    128


-- A type declaration's lines, from its column-0 header to the first blank
-- line: reading it, past it awaiting the next line, and closed, the flag
-- saying whether that line is indented, a declaration continued past a
-- blank line.
type BlockScan
    = Reading (List String)
    | Ended (List String)
    | Closed (List String) Bool


-- True when `lineTokens`, the tokens of a `type` line, open the declaration
-- of `name`.
declares : String -> List String -> Bool
declares name lineTokens =
    List.take 2 lineTokens == [ "type", name ] || List.take 3 lineTokens == [ "type", "alias", name ]


-- The code of `line`, its trailing comment dropped.
codeOf : String -> String
codeOf line =
    Maybe.withDefault "" (List.head (String.split "--" line))


-- A line opening with `type `, by its tokens, and the declaration read
-- from it.
type alias Decl =
    { tokens : List String, scan : BlockScan }


-- The declaration of `name`: the first `type` line declaring it, read on.
typeBlock : String -> List Decl -> Result String (List String)
typeBlock name decls =
    case List.find (\decl -> declares name decl.tokens) decls of
        Just decl ->
            case decl.scan of
                Reading block ->
                    Ok (List.reverse block)

                Ended block ->
                    Ok (List.reverse block)

                Closed block continued ->
                    if continued then
                        Err ("type " ++ name ++ " continues past a blank line")

                    else
                        Ok (List.reverse block)

        Nothing ->
            Err ("type " ++ name ++ " is not declared")


blockStep : String -> BlockScan -> BlockScan
blockStep line scan =
    case scan of
        Reading block ->
            if String.isEmpty (String.trim line) then
                Ended block

            else
                Reading (codeOf line :: block)

        Ended block ->
            if String.isEmpty (String.trim line) then
                Ended block

            else
                Closed block (leadsWith (\c -> c == ' ' || c == '\t') line)

        Closed block continued ->
            Closed block continued


-- The declarations of a module in one pass over its lines: each line moves
-- every open declaration on, a closed one is done, and a `type` line opens
-- one more. Declarations close in the order they open.
type alias DeclScan =
    { open : List Decl, done : List Decl }


declsOf : List String -> List Decl
declsOf lines =
    let
        scanned =
            List.foldl declStep { open = [], done = [] } lines
    in
    scanned.done ++ scanned.open


declStep : String -> DeclScan -> DeclScan
declStep line scan =
    let
        moved =
            List.map (\decl -> { decl | scan = blockStep line decl.scan }) scan.open

        closed =
            List.filter (\decl -> isClosed decl.scan) moved

        opened =
            if String.startsWith "type " line then
                [ { tokens = tokens line, scan = Reading [ codeOf line ] } ]

            else
                []
    in
    { open = List.filter (\decl -> not (isClosed decl.scan)) moved ++ opened, done = scan.done ++ closed }


isClosed : BlockScan -> Bool
isClosed scan =
    case scan of
        Closed _ _ ->
            True

        Reading _ ->
            False

        Ended _ ->
            False


type alias RefScan =
    { dropNext : Bool, refs : List String }


-- The uppercase tokens a declaration names, its header, each constructor
-- of a sum type, lowercase tokens and punctuation dropped.
typeRefs : List String -> List String
typeRefs block =
    let
        all =
            List.concatMap tokens block

        isAlias =
            List.take 2 all == [ "type", "alias" ]

        body =
            if isAlias then
                List.drop 3 all

            else
                List.drop 2 all

        scanned =
            List.foldl (refStep (not isAlias)) { dropNext = False, refs = [] } body
    in
    List.reverse scanned.refs


refStep : Bool -> String -> RefScan -> RefScan
refStep sumType token scan =
    if token == "=" || token == "|" then
        { scan | dropNext = sumType }

    else if scan.dropNext then
        { scan | dropNext = False }

    else if leadsWith Char.isUpper token then
        { scan | refs = token :: scan.refs }

    else
        scan


type alias Import =
    { moduleName : String, qualifier : String, exposed : List String }


importOf : String -> Maybe Import
importOf line =
    if String.startsWith "import " line then
        importFrom line

    else
        Nothing


importFrom : String -> Maybe Import
importFrom line =
    let
        words =
            String.words line

        pairs =
            List.map2 (\a b -> ( a, b )) words (List.drop 1 words)
    in
    Maybe.map
        (\moduleName ->
            { moduleName = moduleName
            , qualifier = Maybe.withDefault moduleName (Maybe.map (\( _, b ) -> b) (List.find (\( a, _ ) -> a == "as") pairs))
            , exposed = Maybe.withDefault [] (Maybe.map tokens (List.head (List.drop 1 (String.split "exposing" line))))
            }
        )
        (List.head (List.drop 1 words))


-- A module of `src` as the scans read it, split and lexed once: its text,
-- its imports, its conversion sites, whether a line imports `Ipe.Error`,
-- and its declarations. A scan reads the index, never the text; a changed
-- text is a new index.
type alias ScanModule =
    { rel : String, text : String, imports : List Import, sites : List String, importsError : Bool, decls : List Decl }


indexModule : ( String, String ) -> ScanModule
indexModule source =
    case source of
        ( rel, text ) ->
            let
                lines =
                    String.lines text

                imports =
                    List.filterMap importOf lines
            in
            { rel = rel
            , text = text
            , imports = imports
            , sites = conversionSitesOf rel imports lines
            , importsError = List.any (String.startsWith "import Ipe.Error") lines
            , decls = declsOf lines
            }


-- Where the type `token` names in module `rel` is declared: `Ok Nothing`
-- for a leaf, `Ok (Just ( file, name ))` for a declaration to walk, and
-- `Err` for a name that resolves to neither. `headers` are the tokens of
-- the module's `type` lines.
resolve : String -> List (List String) -> List Import -> String -> Result String (Maybe ( String, String ))
resolve rel headers imports token =
    let
        segments =
            List.reverse (String.split "." token)

        typeName =
            Maybe.withDefault token (List.head segments)

        qualifier =
            String.join "." (List.reverse (List.drop 1 segments))

        unresolved =
            Err (rel ++ ": " ++ token ++ " resolves to no declaration or leaf")
    in
    if String.isEmpty qualifier then
        if List.any (declares token) headers then
            Ok (Just ( rel, token ))

        else
            case List.find (\imp -> List.member token imp.exposed) imports of
                Just imp ->
                    fromModule imp.moduleName typeName unresolved

                Nothing ->
                    if List.member token leafTypes then
                        Ok Nothing

                    else
                        unresolved

    else
        case List.find (\imp -> imp.qualifier == qualifier) imports of
            Just imp ->
                fromModule imp.moduleName typeName unresolved

            Nothing ->
                unresolved


fromModule : String -> String -> Result String (Maybe ( String, String )) -> Result String (Maybe ( String, String ))
fromModule moduleName typeName unresolved =
    if String.startsWith "Lib." moduleName then
        Ok (Just ( String.replace "." "/" moduleName ++ ".ipe", typeName ))

    else if String.startsWith "Ipe." moduleName && List.member typeName leafTypes then
        Ok Nothing

    else
        unresolved


type alias Visit =
    { next : List ( String, String ), violations : List String }


-- The visits of the keys in `fresh` that name a declaration of `scanned`.
visitsIn : List ( String, String ) -> ScanModule -> List Visit
visitsIn fresh scanned =
    let
        rel =
            scanned.rel

        decls =
            scanned.decls

        headers =
            List.map (\decl -> decl.tokens) decls

        imports =
            scanned.imports

        names =
            List.filterMap
                (\key ->
                    case key of
                        ( file, name ) ->
                            if file == rel then
                                Just name

                            else
                                Nothing
                )
                fresh
    in
    List.map (visitBlock rel decls headers imports) names


visitBlock : String -> List Decl -> List (List String) -> List Import -> String -> Visit
visitBlock rel decls headers imports name =
    case typeBlock name decls of
        Ok block ->
            let
                refs =
                    typeRefs block

                resolved =
                    List.map (resolve rel headers imports) (List.filter (\token -> token /= "Error") refs)

                namesError =
                    if List.member "Error" refs then
                        [ rel ++ ": type " ++ name ++ " names Error" ]

                    else
                        []
            in
            { next = List.filterMap reached resolved, violations = namesError ++ List.filterMap unresolvedWhy resolved }

        Err why ->
            { next = [], violations = [ rel ++ ": " ++ why ] }


reached : Result String (Maybe ( String, String )) -> Maybe ( String, String )
reached resolved =
    case resolved of
        Ok found ->
            found

        Err _ ->
            Nothing


unresolvedWhy : Result String a -> Maybe String
unresolvedWhy resolved =
    case resolved of
        Ok _ ->
            Nothing

        Err why ->
            Just why


type alias Walk =
    { seen : List ( String, String ), frontier : List ( String, String ), violations : List String }


-- Every declaration reachable from the app's `Model` and `Msg`, one round
-- per distance from them, over each module indexed once. The walk stops at
-- its fixed point, an empty frontier, and after `reachCeiling + 1` rounds
-- at most; past `reachCeiling` declarations it stops and is a violation.
reachViolations : List ( String, String ) -> List String
reachViolations sources =
    reachViolationsOf (List.map indexModule sources)


reachViolationsOf : List ScanModule -> List String
reachViolationsOf modules =
    let
        start =
            { seen = [], frontier = [ ( "Lib/App.ipe", "Model" ), ( "Lib/App.ipe", "Msg" ) ], violations = [] }

        walked =
            walkFrom modules (reachCeiling + 1) start

        unfinished =
            if List.isEmpty walked.frontier then
                []

            else
                [ "the type walk did not finish" ]

        tooMany =
            if List.length walked.seen > reachCeiling then
                [ "more than " ++ String.fromInt reachCeiling ++ " types are reachable from the page" ]

            else
                []
    in
    walked.violations ++ unfinished ++ tooMany


-- `walk` after at most `rounds` more rounds, none past its fixed point.
walkFrom : List ScanModule -> Int -> Walk -> Walk
walkFrom modules rounds walk =
    if rounds <= 0 || List.isEmpty walk.frontier then
        walk

    else
        walkFrom modules (rounds - 1) (walkRound modules walk)


walkRound : List ScanModule -> Walk -> Walk
walkRound modules walk =
    if List.length walk.seen > reachCeiling then
        { walk | frontier = [] }

    else
        let
            fresh =
                List.filter (\key -> not (List.member key walk.seen)) (List.unique walk.frontier)

            rels =
                List.map (\scanned -> scanned.rel) modules

            strays =
                List.filter (\key -> not (List.member (Tuple.first key) rels)) fresh

            visits =
                List.concatMap (visitsIn fresh) modules
        in
        { seen = walk.seen ++ fresh
        , frontier = List.concatMap (\visit -> visit.next) visits
        , violations = walk.violations ++ List.concatMap (\visit -> visit.violations) visits ++ List.map (\key -> Tuple.first key ++ " is not a module of src") strays
        }


-- ── the view ────────────────────────────────────────────────────────────


viewImportViolations : List ScanModule -> List String
viewImportViolations modules =
    case List.find (\scanned -> scanned.rel == "Lib/View.ipe") modules of
        Just scanned ->
            if scanned.importsError then
                [ "Lib/View.ipe imports Ipe.Error" ]

            else
                []

        Nothing ->
            [ "Lib/View.ipe is not a module of src" ]


scanViolations : List ScanModule -> List String
scanViolations modules =
    conversionViolations admittedConversions modules ++ reachViolationsOf modules ++ viewImportViolations modules



-- ── the real tree ───────────────────────────────────────────────────────
--
-- The tree holds no violation, and each way around a scan is one: a new
-- conversion site, a site moved to another top-level name, an admitted
-- site removed from the list or from the source, the view importing
-- `Ipe.Error`, a conversion under an import alias or exposed bare, and an
-- error's text read from its record (`info.message`, `{ message }`) or its
-- details (`Custom s`). A token that only contains a conversion's name, and
-- a record field of that name that is not a pattern, are no site.
-- Red if a page can show an error's text, or a scan stops seeing a way
-- around it.
realTreeClean : Task.Task Error Bool
realTreeClean =
    srcSources |> Task.map (\sources -> List.isEmpty (scanViolations (List.map indexModule sources)))


scansRefuseEvasions : Task.Task Error Bool
scansRefuseEvasions =
    srcSources
        |> Task.map (List.map indexModule)
        |> Task.map
            (\sources ->
                caught (appendTo "Lib/Queue.ipe" "show e =\n    Error.toString e" sources)
                    && caught (appendTo "Main.ipe" "moved e =\n    Error.message e" sources)
                    && caught (appendTo "Lib/App.ipe" "named e =\n    Error.kindName e" sources)
                    && not (List.isEmpty (conversionViolations (List.filter (\site -> site /= "Lib/ServerLog.ipe:logged") admittedConversions) sources))
                    && not (List.isEmpty (conversionViolations admittedConversions (List.filter (\scanned -> scanned.rel /= "Lib/ServerLog.ipe") sources)))
                    && caught (prependTo "Lib/View.ipe" "import Ipe.Error as Error" sources)
                    && caught (prependTo "Lib/Queue.ipe" "import Ipe.Error as E" (appendTo "Lib/Queue.ipe" "shown e =\n    E.message e" sources))
                    && caught (prependTo "Lib/Queue.ipe" "import Ipe.Error exposing (toString)" (appendTo "Lib/Queue.ipe" "shown e =\n    toString e" sources))
                    && caught (appendTo "Lib/Queue.ipe" "shown e =\n    case e of\n        Error _ info ->\n            info.message" sources)
                    && caught (appendTo "Lib/Queue.ipe" "shown e =\n    case e of\n        Error _ { message } ->\n            message" sources)
                    && caught (appendTo "Lib/Queue.ipe" "shown d =\n    case d of\n        Custom text ->\n            text" sources)
                    && List.isEmpty (scanViolations (appendTo "Lib/Queue.ipe" "label =\n    errorToStringLabel refuseError.messages { messageCount = 1, message = \"x\" }\n\n\ntype alias Note =\n    { message : String }" sources))
            )


caught : List ScanModule -> Bool
caught sources =
    not (List.isEmpty (scanViolations sources))


-- `sources` with `extra` after the text of `rel`, that module indexed anew.
appendTo : String -> String -> List ScanModule -> List ScanModule
appendTo rel extra sources =
    List.map
        (\scanned ->
            if scanned.rel == rel then
                indexModule ( rel, scanned.text ++ "\n\n" ++ extra ++ "\n" )

            else
                scanned
        )
        sources


-- `sources` with `extra` before the text of `rel`, that module indexed anew.
prependTo : String -> String -> List ScanModule -> List ScanModule
prependTo rel extra sources =
    List.map
        (\scanned ->
            if scanned.rel == rel then
                indexModule ( rel, extra ++ "\n" ++ scanned.text )

            else
                scanned
        )
        sources



-- ── scanner self-tests ──────────────────────────────────────────────────


appOnly : String -> List ( String, String )
appOnly text =
    [ ( "Lib/App.ipe", text ) ]


reachFlags : List ( String, String ) -> Bool
reachFlags sources =
    not (List.isEmpty (reachViolations sources))


-- A state holding an error, a message carrying one, a type in another
-- module holding one, a name that resolves nowhere, a type in a module
-- `src` does not hold, a missing `Model`, a declaration continued past a
-- blank line, and a walk past its ceiling, by one declaration or more, are
-- each violations; a field named `refuseError` holding a typed case, and a
-- walk of exactly `reachCeiling` declarations, are not.
-- Red if the walk misses a path an error could reach a page by.
typeWalkRefuses : Bool
typeWalkRefuses =
    reachFlags (appOnly "type alias Model =\n    { queueState : QueueState }\n\n\ntype Msg\n    = Reload\n\n\ntype QueueState\n    = Loading\n    | Failed Error\n")
        && reachFlags (appOnly "type alias Model =\n    { n : Int }\n\n\ntype Msg\n    = QueueLoaded (Result Error QueuePage)\n\n\ntype alias QueuePage =\n    { n : Int }\n")
        && reachFlags
            [ ( "Lib/App.ipe", "import Lib.Failure as Failure exposing (LoadFailure)\n\n\ntype alias Model =\n    { load : Maybe LoadFailure, save : Maybe Failure.SaveFailure }\n\n\ntype Msg\n    = Reload\n" )
            , ( "Lib/Failure.ipe", "type LoadFailure\n    = LoadFailed\n\n\ntype SaveFailure\n    = SaveFailed Error\n" )
            ]
        && reachFlags (appOnly "type alias Model =\n    { x : Foo.Bar }\n\n\ntype Msg\n    = Reload\n")
        && reachFlags (appOnly "import Lib.Gone exposing (Gone)\n\n\ntype alias Model =\n    { gone : Gone }\n\n\ntype Msg\n    = Reload\n")
        && reachFlags (appOnly "type Msg\n    = Reload\n")
        && reachFlags (appOnly "type alias Model =\n    { n : Int }\n\n\ntype Msg\n    = Reload\n\n    | Failed Error\n")
        && reachFlags (appOnly (chainedModel (reachCeiling + 2)))
        && reachFlags (appOnly (chainedModel (reachCeiling - 2)))
        && List.isEmpty (reachViolations (appOnly (chainedModel (reachCeiling - 3))))
        && List.isEmpty (reachViolations (appOnly "type alias Model =\n    { refuseError : Maybe RefuseFailure }\n\n\ntype Msg\n    = Reload\n\n\ntype RefuseFailure\n    = DraftWhileSaving\n"))
        && List.isEmpty (reachViolations (appOnly (chainedModel 8)))


-- A `Model` and `Msg` reaching `depth + 1` more declarations, each naming
-- the next: `depth + 3` in all.
chainedModel : Int -> String
chainedModel depth =
    let
        link i =
            "type alias T" ++ String.fromInt i ++ " =\n    { next : T" ++ String.fromInt (i + 1) ++ " }\n"
    in
    String.join "\n\n"
        ([ "type alias Model =\n    { next : T1 }\n", "type Msg\n    = Reload\n" ]
            ++ List.map link (List.range 1 depth)
            ++ [ "type alias T" ++ String.fromInt (depth + 1) ++ " =\n    { n : Int }\n" ]
        )


-- The conversion scan keys a site by its enclosing name and admits only
-- the listed sites; a token that contains a conversion's name is no site,
-- and more files than the ceiling refuse the read. Red if the scan matches
-- substrings or a site's name.
conversionScanRefuses : Bool
conversionScanRefuses =
    conversionSitesIn "Lib/Queue.ipe" "show e =\n    Error.toString e\n\n\nlabel =\n    errorToStringLabel refuseError\n"
        == [ "Lib/Queue.ipe:show" ]
        && conversionViolations [ "Lib/Queue.ipe:show" ] [ indexModule ( "Lib/Queue.ipe", "show e =\n    Error.toString e\n" ) ]
        == []
        && List.length (conversionViolations [ "Lib/Queue.ipe:show" ] [ indexModule ( "Lib/Queue.ipe", "other e =\n    Error.toString e\n" ) ])
        == 2
        && Result.toMaybe (withinFileCeiling (List.repeat (fileCeiling + 1) ""))
        == Nothing
        && Result.toMaybe (withinFileCeiling (List.repeat fileCeiling ""))
        /= Nothing


checks : Task.Task Error (List ( String, Bool ))
checks =
    Task.sequence
        [ check "no page can show an error's text: the source scans find no violation" realTreeClean
        , check "each way around the source scans is a violation" scansRefuseEvasions
        , Task.succeed ( "the type walk refuses every path an error reaches a page by", typeWalkRefuses )
        , Task.succeed ( "the conversion scan admits only the listed sites, by token", conversionScanRefuses )
        ]
