module FailureScanTests exposing (checks)

import Ipe.ByteSize as ByteSize
import Ipe.Char as Char
import Ipe.Error as Error
import Ipe.File as File
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Path as Path exposing (Path)
import Ipe.Result as Result exposing (Result(..))
import Ipe.Set as Set
import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task
import Ipe.Tuple as Tuple
import Lib.Highlight as Highlight exposing (Token(..))
import TestSupport exposing (check)


-- ── the source scan ─────────────────────────────────────────────────────
--
-- No error's text reaches a page: a page shows only the typed failure case
-- its callback decided. Three scans over `src` hold that by construction.
-- An error becomes text only at the admitted sites, each keyed by its file
-- and enclosing top-level name; no type reachable from the app's `Model` and
-- `Msg` names `Error`; the view does not import `Ipe.Error`.
-- Each scan reads tokens, maximal runs of `[A-Za-z0-9_.]`, never substrings,
-- so `refuseError` is not `Error`. Each returns its violations; none is a
-- pass.

-- The modules of `src`, each by its path relative to `src` with its text.
-- A file past `fileCeiling`, a module past `moduleByteCeiling`, or one that
-- cannot be read fails the read.
srcSources : Task.Task Error (List ( String, String ))
srcSources =
    do
        cwd <- System.cwd ()
        root <- Task.fromResult (Path.fromString (cwd ++ "/src"))
        files <- File.walk root
        bounded <- Task.fromResult (withinFileCeiling files)
        Task.sequence (List.map (readSource (Path.toString root ++ "/")) (List.filter (\path -> String.endsWith ".ipe" (Path.toString path)) bounded))


fileCeiling : Int
fileCeiling =
    64


moduleByteCeiling : ByteSize.ByteSize
moduleByteCeiling =
    ByteSize.kib 512


withinFileCeiling : List a -> Result Error (List a)
withinFileCeiling files =
    if List.length files > fileCeiling then
        Err (Error.limitExceeded ("src holds more than " ++ String.fromInt fileCeiling ++ " files"))

    else
        Ok files


readSource : String -> Path -> Task.Task Error ( String, String )
readSource prefix path =
    let
        file =
            Path.toString path
    in
    if String.startsWith prefix file then
        File.readFileLimit path moduleByteCeiling
            |> Task.map (\text -> ( String.dropLeft (String.length prefix) file, text ))

    else
        Task.fail (Error.unexpected (file ++ " is not under src"))


-- The tokens of `line`: maximal runs of ASCII letters, digits, `_` and `.`,
-- with each `=` and `|` a token of its own.
tokens : String -> List String
tokens line =
    line
        |> String.replace "=" " = "
        |> String.replace "|" " | "
        |> String.map
            (\c ->
                if tokenChar c then
                    c

                else
                    ' '
            )
        |> String.words


tokenChar : Char -> Bool
tokenChar c =
    (Char.isAlphaNum c && Char.toCode c < 128) || c == '_' || c == '.' || c == '=' || c == '|'


-- True when `text` begins with an ASCII character `test` accepts.
leadsWith : (Char -> Bool) -> String -> Bool
leadsWith test text =
    case String.uncons text of
        Just ( c, _ ) ->
            test c && Char.toCode c < 128

        Nothing ->
            False


-- ── conversion sites ────────────────────────────────────────────────────

-- The `Ipe.Error` calls that turn an error into text.
conversionFunctions : List String
conversionFunctions =
    [ "toString", "message", "kindName" ]


-- The fields of an error's record and of its details' records that hold
-- its text.
errorTextFields : List String
errorTextFields =
    [ "message", "stack", "expected", "actual" ]


-- The details constructors whose payload is text or a record of it.
textDetails : List String
textDetails =
    [ "Custom", "JsonDecode", "FfiPanic", "TypeMismatch" ]


-- The names a conversion call goes by in a module: each conversion under
-- `Error`, under `Ipe.Error`, and under every name the module imports
-- `Ipe.Error` as, and bare when an import of it exposes the call or
-- everything.
conversionNames : List Import -> List String
conversionNames imports =
    let
        errorImports =
            List.filter (\imp -> imp.moduleName == "Ipe.Error") imports

        qualifiers =
            List.unique ("Error" :: "Ipe.Error" :: List.map (\imp -> imp.qualifier) errorImports)

        bare =
            List.filter (\fn -> List.any (\imp -> List.member fn imp.exposed || List.member ".." imp.exposed) errorImports) conversionFunctions
    in
    "errorToString" :: bare ++ List.concatMap (\q -> List.map (\fn -> q ++ "." ++ fn) conversionFunctions) qualifiers


-- A token with its neighbours on the line, `""` past either end.
type alias SiteToken =
    { prev : String, token : String, next : String }


-- The tokens of `line` as the conversion scan reads them: `tokens`, with
-- each `,`, `{` and `}` a token of its own, so a record pattern shows.
siteTokens : String -> List SiteToken
siteTokens line =
    let
        words =
            line
                |> String.replace "," " , "
                |> String.replace "{" " { "
                |> String.replace "}" " } "
                |> String.map
                    (\c ->
                        if tokenChar c || c == ',' || c == '{' || c == '}' then
                            c

                        else
                            ' '
                    )
                |> String.words
    in
    List.map3 (\prev token next -> { prev = prev, token = token, next = next }) ("" :: words) words (List.drop 1 words ++ [ "" ])


-- An error becoming text at `at`: a conversion call, a read of an
-- error-text field (`info.message`, `.stack`), a record pattern binding one
-- (`{ message }`), or a text detail bound to a name (`Custom s`).
isConversion : List String -> SiteToken -> Bool
isConversion names at =
    List.member at.token names
        || List.any (\field -> String.endsWith ("." ++ field) at.token) errorTextFields
        || (List.member at.token errorTextFields && List.member at.prev [ "{", "," ] && List.member at.next [ ",", "}" ])
        || (List.any (\detail -> at.token == detail || String.endsWith ("." ++ detail) at.token) textDetails && at.next /= "_")


-- Every site an error becomes text: the startup refusals `Main` prints, the
-- root refusal's problem that names the failure, and the server log.
admittedConversions : List String
admittedConversions =
    [ "Lib/RepoPath.ipe:failureProblem"
    , "Lib/ServerLog.ipe:logged"
    , "Main.ipe:printStartupFailure"
    ]


type alias SiteScan =
    { name : String, sites : List String }


-- Each conversion token of `text`, keyed `rel:name` by the last column-0
-- lowercase line above it.
conversionSitesIn : String -> String -> List String
conversionSitesIn rel text =
    (indexModule ( rel, text )).sites


conversionSitesOf : String -> List Import -> List String -> List String
conversionSitesOf rel imports lines =
    let
        scanned =
            List.foldl (siteStep (conversionNames imports) rel) { name = "", sites = [] } lines
    in
    scanned.sites


siteStep : List String -> String -> String -> SiteScan -> SiteScan
siteStep names rel line scan =
    let
        name =
            if leadsWith Char.isLower line then
                Maybe.withDefault scan.name (List.head (tokens line))

            else
                scan.name

        found =
            List.filter (isConversion names) (siteTokens line)
    in
    { name = name, sites = List.map (\_ -> rel ++ ":" ++ name) found ++ scan.sites }


-- A conversion site `admitted` does not list, and an admitted site no
-- source holds.
conversionViolations : List String -> List ScanModule -> List String
conversionViolations admitted modules =
    let
        found =
            List.unique (List.concatMap (\scanned -> scanned.sites) modules)
    in
    List.map (\site -> "an error becomes text at " ++ site ++ ", which is not admitted") (List.filter (\site -> not (List.member site admitted)) found)
        ++ List.map (\site -> "the admitted site " ++ site ++ " holds no conversion") (List.filter (\site -> not (List.member site found)) admitted)


-- ── the types a page holds ──────────────────────────────────────────────

-- The stdlib types that hold no `Error` unless given one as a parameter,
-- which the token check sees.
leafTypes : List String
leafTypes =
    [ "Int", "Float", "Bool", "String", "Char", "Maybe", "List", "Result", "Dict", "Set", "Timestamp", "ByteSize" ]


reachCeiling : Int
reachCeiling =
    128


-- A type declaration's lines, from its column-0 header to the first blank
-- line: reading it, past it awaiting the next line, and closed, the flag
-- saying whether that line is indented, a declaration continued past a
-- blank line.
type BlockScan
    = Reading (List String)
    | Ended (List String)
    | Closed (List String) Bool


-- True when `lineTokens`, the tokens of a `type` line, open the declaration
-- of `name`.
declares : String -> List String -> Bool
declares name lineTokens =
    List.take 2 lineTokens == [ "type", name ] || List.take 3 lineTokens == [ "type", "alias", name ]


-- The code of `line`, its trailing comment dropped.
codeOf : String -> String
codeOf line =
    Maybe.withDefault "" (List.head (String.split "--" line))


-- A line opening with `type `, by its tokens, and the declaration read
-- from it.
type alias Decl =
    { tokens : List String, scan : BlockScan }


-- The declaration of `name`: the first `type` line declaring it, read on.
typeBlock : String -> List Decl -> Result String (List String)
typeBlock name decls =
    case List.find (\decl -> declares name decl.tokens) decls of
        Just decl ->
            case decl.scan of
                Reading block ->
                    Ok (List.reverse block)

                Ended block ->
                    Ok (List.reverse block)

                Closed block continued ->
                    if continued then
                        Err ("type " ++ name ++ " continues past a blank line")

                    else
                        Ok (List.reverse block)

        Nothing ->
            Err ("type " ++ name ++ " is not declared")


blockStep : String -> BlockScan -> BlockScan
blockStep line scan =
    case scan of
        Reading block ->
            if String.isEmpty (String.trim line) then
                Ended block

            else
                Reading (codeOf line :: block)

        Ended block ->
            if String.isEmpty (String.trim line) then
                Ended block

            else
                Closed block (leadsWith (\c -> c == ' ' || c == '\t') line)

        Closed block continued ->
            Closed block continued


-- The declarations of a module in one pass over its lines: each line moves
-- every open declaration on, a closed one is done, and a `type` line opens
-- one more. Declarations close in the order they open.
type alias DeclScan =
    { open : List Decl, done : List Decl }


declsOf : List String -> List Decl
declsOf lines =
    let
        scanned =
            List.foldl declStep { open = [], done = [] } lines
    in
    scanned.done ++ scanned.open


declStep : String -> DeclScan -> DeclScan
declStep line scan =
    let
        moved =
            List.map (\decl -> { decl | scan = blockStep line decl.scan }) scan.open

        closed =
            List.filter (\decl -> isClosed decl.scan) moved

        opened =
            if String.startsWith "type " line then
                [ { tokens = tokens line, scan = Reading [ codeOf line ] } ]

            else
                []
    in
    { open = List.filter (\decl -> not (isClosed decl.scan)) moved ++ opened, done = scan.done ++ closed }


isClosed : BlockScan -> Bool
isClosed scan =
    case scan of
        Closed _ _ ->
            True

        Reading _ ->
            False

        Ended _ ->
            False


type alias RefScan =
    { dropNext : Bool, refs : List String }


-- The uppercase tokens a declaration names, its header, each constructor
-- of a sum type, lowercase tokens and punctuation dropped.
typeRefs : List String -> List String
typeRefs block =
    let
        all =
            List.concatMap tokens block

        isAlias =
            List.take 2 all == [ "type", "alias" ]

        body =
            if isAlias then
                List.drop 3 all

            else
                List.drop 2 all

        scanned =
            List.foldl (refStep (not isAlias)) { dropNext = False, refs = [] } body
    in
    List.reverse scanned.refs


refStep : Bool -> String -> RefScan -> RefScan
refStep sumType token scan =
    if token == "=" || token == "|" then
        { scan | dropNext = sumType }

    else if scan.dropNext then
        { scan | dropNext = False }

    else if leadsWith Char.isUpper token then
        { scan | refs = token :: scan.refs }

    else
        scan


type alias Import =
    { moduleName : String, qualifier : String, exposed : List String }


importOf : String -> Maybe Import
importOf line =
    if String.startsWith "import " line then
        importFrom line

    else
        Nothing


importFrom : String -> Maybe Import
importFrom line =
    let
        words =
            String.words line

        pairs =
            List.map2 (\a b -> ( a, b )) words (List.drop 1 words)
    in
    Maybe.map
        (\moduleName ->
            { moduleName = moduleName
            , qualifier = Maybe.withDefault moduleName (Maybe.map (\( _, b ) -> b) (List.find (\( a, _ ) -> a == "as") pairs))
            , exposed = Maybe.withDefault [] (Maybe.map tokens (List.head (List.drop 1 (String.split "exposing" line))))
            }
        )
        (List.head (List.drop 1 words))


-- A module of `src` as the scans read it, split and lexed once: its text,
-- its imports, its conversion sites, its uid-text sites, the `SqlValue`
-- patterns it holds, its reads that
-- carry no bound, whether a line imports `Ipe.Error`, and its
-- declarations. A scan reads the index, never the text; a changed text is
-- a new index, so a scan of a changed tree reads every other module's
-- index as it stands.
type alias ScanModule =
    { rel : String, text : String, imports : List Import, sites : List String, uidSites : List String, sqlPatterns : List String, reads : List ( String, Bool ), importsError : Bool, decls : List Decl }


indexModule : ( String, String ) -> ScanModule
indexModule source =
    case source of
        ( rel, text ) ->
            let
                lines =
                    String.lines text

                imports =
                    List.filterMap importOf lines
            in
            { rel = rel
            , text = text
            , imports = imports
            , sites = conversionSitesOf rel imports lines
            , uidSites = uidTextSitesOf rel imports lines
            , sqlPatterns = sqlPatternSitesOf rel lines
            , reads = unboundedReadsOf rel lines
            , importsError = List.any (String.startsWith "import Ipe.Error") lines
            , decls = declsOf lines
            }


-- Where the type `token` names in module `rel` is declared: `Ok Nothing`
-- for a leaf, `Ok (Just ( file, name ))` for a declaration to walk, and
-- `Err` for a name that resolves to neither. `headers` are the tokens of
-- the module's `type` lines.
resolve : String -> List (List String) -> List Import -> String -> Result String (Maybe ( String, String ))
resolve rel headers imports token =
    let
        segments =
            List.reverse (String.split "." token)

        typeName =
            Maybe.withDefault token (List.head segments)

        qualifier =
            String.join "." (List.reverse (List.drop 1 segments))

        unresolved =
            Err (rel ++ ": " ++ token ++ " resolves to no declaration or leaf")
    in
    if String.isEmpty qualifier then
        if List.any (declares token) headers then
            Ok (Just ( rel, token ))

        else
            case List.find (\imp -> List.member token imp.exposed) imports of
                Just imp ->
                    fromModule imp.moduleName typeName unresolved

                Nothing ->
                    if List.member token leafTypes then
                        Ok Nothing

                    else
                        unresolved

    else
        case List.find (\imp -> imp.qualifier == qualifier) imports of
            Just imp ->
                fromModule imp.moduleName typeName unresolved

            Nothing ->
                unresolved


fromModule : String -> String -> Result String (Maybe ( String, String )) -> Result String (Maybe ( String, String ))
fromModule moduleName typeName unresolved =
    if String.startsWith "Lib." moduleName then
        Ok (Just ( String.replace "." "/" moduleName ++ ".ipe", typeName ))

    else if String.startsWith "Ipe." moduleName && List.member typeName leafTypes then
        Ok Nothing

    else
        unresolved


type alias Visit =
    { next : List ( String, String ), violations : List String }


-- The visits of the keys in `fresh` that name a declaration of `scanned`.
visitsIn : List ( String, String ) -> ScanModule -> List Visit
visitsIn fresh scanned =
    let
        rel =
            scanned.rel

        decls =
            scanned.decls

        headers =
            List.map (\decl -> decl.tokens) decls

        imports =
            scanned.imports

        names =
            List.filterMap
                (\key ->
                    case key of
                        ( file, name ) ->
                            if file == rel then
                                Just name

                            else
                                Nothing
                )
                fresh
    in
    List.map (visitBlock rel decls headers imports) names


visitBlock : String -> List Decl -> List (List String) -> List Import -> String -> Visit
visitBlock rel decls headers imports name =
    case typeBlock name decls of
        Ok block ->
            let
                refs =
                    typeRefs block

                resolved =
                    List.map (resolve rel headers imports) (List.filter (\token -> token /= "Error") refs)

                namesError =
                    if List.member "Error" refs then
                        [ rel ++ ": type " ++ name ++ " names Error" ]

                    else
                        []
            in
            { next = List.filterMap reached resolved, violations = namesError ++ List.filterMap unresolvedWhy resolved }

        Err why ->
            { next = [], violations = [ rel ++ ": " ++ why ] }


reached : Result String (Maybe ( String, String )) -> Maybe ( String, String )
reached resolved =
    case resolved of
        Ok found ->
            found

        Err _ ->
            Nothing


unresolvedWhy : Result String a -> Maybe String
unresolvedWhy resolved =
    case resolved of
        Ok _ ->
            Nothing

        Err why ->
            Just why


type alias Walk =
    { seen : List ( String, String ), frontier : List ( String, String ), violations : List String }


-- Every declaration reachable from the app's `Model` and `Msg`, one round
-- per distance from them, over each module indexed once. The walk stops at
-- its fixed point, an empty frontier, and after `reachCeiling + 1` rounds
-- at most; past `reachCeiling` declarations it stops and is a violation.
reachViolations : List ( String, String ) -> List String
reachViolations sources =
    reachViolationsOf (List.map indexModule sources)


reachViolationsOf : List ScanModule -> List String
reachViolationsOf modules =
    let
        start =
            { seen = [], frontier = [ ( "Lib/Session.ipe", "Model" ), ( "Lib/Session.ipe", "Msg" ) ], violations = [] }

        walked =
            walkFrom modules (reachCeiling + 1) start

        unfinished =
            if List.isEmpty walked.frontier then
                []

            else
                [ "the type walk did not finish" ]

        tooMany =
            if List.length walked.seen > reachCeiling then
                [ "more than " ++ String.fromInt reachCeiling ++ " types are reachable from the page" ]

            else
                []
    in
    walked.violations ++ unfinished ++ tooMany


-- `walk` after at most `rounds` more rounds, none past its fixed point.
walkFrom : List ScanModule -> Int -> Walk -> Walk
walkFrom modules rounds walk =
    if rounds <= 0 || List.isEmpty walk.frontier then
        walk

    else
        walkFrom modules (rounds - 1) (walkRound modules walk)


walkRound : List ScanModule -> Walk -> Walk
walkRound modules walk =
    if List.length walk.seen > reachCeiling then
        { walk | frontier = [] }

    else
        let
            fresh =
                List.filter (\key -> not (List.member key walk.seen)) (List.unique walk.frontier)

            rels =
                List.map (\scanned -> scanned.rel) modules

            strays =
                List.filter (\key -> not (List.member (Tuple.first key) rels)) fresh

            visits =
                List.concatMap (visitsIn fresh) modules
        in
        { seen = walk.seen ++ fresh
        , frontier = List.concatMap (\visit -> visit.next) visits
        , violations = walk.violations ++ List.concatMap (\visit -> visit.violations) visits ++ List.map (\key -> Tuple.first key ++ " is not a module of src") strays
        }


-- ── the view ────────────────────────────────────────────────────────────


viewImportViolations : List ScanModule -> List String
viewImportViolations modules =
    case List.find (\scanned -> scanned.rel == "Lib/View.ipe") modules of
        Just scanned ->
            if scanned.importsError then
                [ "Lib/View.ipe imports Ipe.Error" ]

            else
                []

        Nothing ->
            [ "Lib/View.ipe is not a module of src" ]


scanViolations : List ScanModule -> List String
scanViolations modules =
    conversionViolations admittedConversions modules ++ reachViolationsOf modules ++ viewImportViolations modules


-- ── a uid as text ────────────────────────────────────────────────────────
--
-- A unit's uid never leaves its type as a plain `String`: `Lib/Uid.ipe`
-- exposes one exit per sink, each typed for that sink. Three of them
-- return a type the stdlib or the tool can read back as text, so three
-- scans hold the rest outside the type system. Each covers every module of
-- `src` but `Lib/Uid.ipe`, which defines the exits.
--
-- * No `SqlValue` is taken apart: no constructor of it appears in a
--   pattern, so a bind parameter cannot be read back as text.
-- * Each of `toSql`, `placeText` and `macFieldText` appears only at its
--   admitted sites, keyed by file and enclosing top-level name; `toString`
--   has none, a tripwire for an exit reintroduced.
-- * `Lib/Uid.ipe` exposes exactly the pinned exits, so a new one is a
--   violation until this file admits it.

-- The constructors of `SqlValue`.
sqlValueConstructors : List String
sqlValueConstructors =
    [ "SqlString", "SqlInt", "SqlFloat", "SqlBool", "SqlBytes", "SqlTime", "SqlDecimal", "SqlMoney", "SqlNull" ]


-- True when `token` names a `SqlValue` constructor, bare or under any
-- qualifier.
isSqlConstructor : String -> Bool
isSqlConstructor token =
    List.any (\ctor -> token == ctor || String.endsWith ("." ++ ctor) token) sqlValueConstructors


-- Each `SqlValue` constructor of a module in a pattern, keyed `rel:name`:
-- a constructor token with a `->` after it on its line, which holds for a
-- case arm (`SqlString s ->`), a nested one (`Just (SqlString s) ->`) and a
-- case on one line (`\v -> case v of SqlString s -> s`), while a
-- constructor applied after the last arrow builds a value. The line is read
-- through the tool's Ipê lexer, each line with the carry out of the one
-- before it, and only its code is searched: a string literal or a comment,
-- line or block, is a gap, so neither a `--` inside a literal pattern nor a
-- comment hides the arrow, and an arrow written in a literal is none.
sqlPatternSitesOf : String -> List String -> List String
sqlPatternSitesOf rel lines =
    (List.foldl (sqlPatternStep rel) { name = "", sites = [], carry = Highlight.lineStart } lines).sites


type alias PatternScan =
    { name : String, sites : List String, carry : Highlight.Carry }


-- The code of a lexed line: each string literal and comment a space.
lexedCode : List Highlight.Token -> String
lexedCode toks =
    String.concat (List.map codePiece toks)


codePiece : Highlight.Token -> String
codePiece tok =
    case tok of
        Keyword s ->
            s

        Ident s ->
            s

        Num s ->
            s

        Plain s ->
            s

        Str _ ->
            " "

        Comment _ ->
            " "


sqlPatternStep : String -> String -> PatternScan -> PatternScan
sqlPatternStep rel line scan =
    let
        name =
            if leadsWith Char.isLower line then
                Maybe.withDefault scan.name (List.head (tokens line))

            else
                scan.name

        lexed =
            Highlight.lexLine Highlight.Ipe scan.carry line

        segments =
            String.split "->" (lexedCode (Tuple.first lexed))

        beforeAnArrow =
            List.take (List.length segments - 1) segments

        found =
            List.filter isSqlConstructor (List.concatMap tokens beforeAnArrow)
    in
    { name = name, sites = List.map (\_ -> rel ++ ":" ++ name) found ++ scan.sites, carry = Tuple.second lexed }


-- Every `SqlValue` taken apart outside `Lib/Uid.ipe`; none is admitted.
sqlPatternViolations : List ScanModule -> List String
sqlPatternViolations modules =
    List.map (\site -> "a SqlValue is taken apart at " ++ site) (List.unique (List.concatMap (\scanned -> scanned.sqlPatterns) (List.filter (\scanned -> scanned.rel /= "Lib/Uid.ipe") modules)))


-- The exits of `Lib.Uid` whose result can be read back as text; its one
-- entrance from unchecked text, `storedMacField`, which frames a stored
-- row's own uid cell for the mac that verifies it and never a written
-- row's; and `toString`, which no site may name.
uidTextExits : List String
uidTextExits =
    [ "toSql", "placeText", "macFieldText", "storedMacField", "toString" ]


-- The names each text exit goes by in a module, paired with the exit:
-- under `Uid`, under `Lib.Uid`, under every name the module imports
-- `Lib.Uid` as, and bare when an import of it exposes the exit or
-- everything.
uidExitNames : List Import -> List ( String, String )
uidExitNames imports =
    let
        uidImports =
            List.filter (\imp -> imp.moduleName == "Lib.Uid") imports

        qualifiers =
            List.unique ("Uid" :: "Lib.Uid" :: List.map (\imp -> imp.qualifier) uidImports)

        bare exit =
            if List.any (\imp -> List.member exit imp.exposed || List.member ".." imp.exposed) uidImports then
                [ ( exit, exit ) ]

            else
                []
    in
    List.concatMap (\exit -> bare exit ++ List.map (\q -> ( q ++ "." ++ exit, exit )) qualifiers) uidTextExits


-- Every site a uid's text leaves through an exit, `rel:name exit`: each
-- SQL bind parameter, which feeds only a query's parameter list, the
-- disambiguator a page shows beside a unit's place, the uid field of a
-- row's mac input, and the one read whose stored uid cell enters it.
admittedUidExits : List String
admittedUidExits =
    [ "Lib/Db.ipe:appendDecision toSql"
    , "Lib/Db.ipe:findDecision toSql"
    , "Lib/Db.ipe:findLatestForUid toSql"
    , "Lib/Db.ipe:findLegacy toSql"
    , "Lib/Db.ipe:legacyParams toSql"
    , "Lib/Db.ipe:macInput macFieldText"
    , "Lib/Db.ipe:pairVerifies toSql"
    , "Lib/Db.ipe:rowSignedBy storedMacField"
    , "Lib/Index.ipe:candidateQuery toSql"
    , "Lib/Index.ipe:drainPair toSql"
    , "Lib/Index.ipe:edgeLinks toSql"
    , "Lib/Index.ipe:liveFiles toSql"
    , "Lib/Index.ipe:liveUnits toSql"
    , "Lib/Index.ipe:pendingPageQuery toSql"
    , "Lib/Index.ipe:reverifyRefusal toSql"
    , "Lib/Index.ipe:unitByUid toSql"
    , "Lib/View.ipe:placeEls placeText"
    ]


-- Each text-exit token of a module, keyed `rel:name exit` by the last
-- column-0 lowercase line above it.
uidTextSitesOf : String -> List Import -> List String -> List String
uidTextSitesOf rel imports lines =
    (List.foldl (uidTextStep (uidExitNames imports) rel) { name = "", sites = [] } lines).sites


uidTextStep : List ( String, String ) -> String -> String -> SiteScan -> SiteScan
uidTextStep names rel line scan =
    let
        name =
            if leadsWith Char.isLower line then
                Maybe.withDefault scan.name (List.head (tokens line))

            else
                scan.name

        found =
            List.filterMap (\token -> Maybe.map Tuple.second (List.find (\( spelled, _ ) -> spelled == token) names)) (tokens line)
    in
    { name = name, sites = List.map (\exit -> rel ++ ":" ++ name ++ " " ++ exit) found ++ scan.sites }


-- A text-exit site `admitted` does not list, and an admitted site no source
-- holds, over the modules of `src` but `Lib/Uid.ipe`.
uidTextViolations : List String -> List ScanModule -> List String
uidTextViolations admitted modules =
    let
        found =
            List.unique (List.concatMap (\scanned -> scanned.uidSites) (List.filter (\scanned -> scanned.rel /= "Lib/Uid.ipe") modules))
    in
    List.map (\site -> "a uid leaves its type at " ++ site ++ ", which is not admitted") (List.filter (\site -> not (List.member site admitted)) found)
        ++ List.map (\site -> "the admitted site " ++ site ++ " holds no such exit") (List.filter (\site -> not (List.member site found)) admitted)


-- What `Lib/Uid.ipe` exposes: the type, its role types, and one exit per
-- sink. `toString` is not among them.
pinnedUidExposing : List String
pinnedUidExposing =
    [ "MacField", "Uid", "UidKey", "decoder", "isLowerHex", "key", "keyOrder", "linkTarget", "macField", "macFieldText", "parse", "placeText", "storedMacField", "toSql", "uidLength" ]


-- The exposing list of `Lib/Uid.ipe` that differs from the pinned one, or
-- a tree without the module.
uidExposingViolations : List ScanModule -> List String
uidExposingViolations modules =
    case List.find (\scanned -> scanned.rel == "Lib/Uid.ipe") modules of
        Just scanned ->
            case List.find (String.startsWith "module ") (String.lines scanned.text) of
                Just header ->
                    if exposedBy header == pinnedUidExposing then
                        []

                    else
                        [ "Lib/Uid.ipe exposes " ++ String.join ", " (exposedBy header) ++ ", not the pinned exits" ]

                Nothing ->
                    [ "Lib/Uid.ipe declares no module" ]

        Nothing ->
            [ "Lib/Uid.ipe is not a module of src" ]


exposedBy : String -> List String
exposedBy header =
    Maybe.withDefault [] (Maybe.map tokens (List.head (List.drop 1 (String.split "exposing" header))))


-- Every uid violation of the tree: a `SqlValue` taken apart, a text exit
-- at a site not admitted or an admitted site without it, and an exposing
-- list off its pin.
uidViolations : List ScanModule -> List String
uidViolations modules =
    sqlPatternViolations modules ++ uidTextViolations admittedUidExits modules ++ uidExposingViolations modules


-- A `SqlValue` taken apart is a violation under every spelling: a case
-- arm on a bare constructor, under an import alias, fully qualified,
-- nested in another pattern, a whole case on one line, in another module.
-- A constructor that builds a value, a token that only contains the name,
-- and `Lib/Uid.ipe` itself are not. Red if a uid's bind parameter can be
-- read back as text without the scan seeing it.
uidLaunderingRefused : List ScanModule -> Bool
uidLaunderingRefused sources =
    List.isEmpty (sqlPatternViolations sources)
        && laundered (appendTo "Lib/Queue.ipe" "labelOf u =\n    case Uid.toSql u of\n        SqlString s ->\n            s" sources)
        && laundered (prependTo "Lib/Queue.ipe" "import Ipe.Db as D" (appendTo "Lib/Queue.ipe" "labelOf u =\n    case Uid.toSql u of\n        D.SqlString s ->\n            s" sources))
        && laundered (prependTo "Lib/Queue.ipe" "import Ipe.Db exposing (SqlValue(..))" (appendTo "Lib/Queue.ipe" "labelOf u =\n    case Uid.toSql u of\n        SqlString s ->\n            s" sources))
        && laundered (appendTo "Lib/Queue.ipe" "labelOf u =\n    case Uid.toSql u of\n        Ipe.Db.SqlNull _ ->\n            \"\"" sources)
        && laundered (appendTo "Lib/Queue.ipe" "labelOf u =\n    case Just (Uid.toSql u) of\n        Just (SqlString s) ->\n            s" sources)
        && laundered (appendTo "Lib/Queue.ipe" "labelOf =\n    \\v -> case v of SqlString s -> s" sources)
        && laundered (appendTo "Lib/View.ipe" "heading v =\n    case v of\n        SqlInt n ->\n            n" sources)
        && laundered (appendTo "Main.ipe" "shown v =\n    case v of\n        SqlString s ->\n            s" sources)
        && laundered (appendTo "Lib/Queue.ipe" "labelOf u =\n    case ( Uid.toSql u, \"--\" ) of\n        ( SqlString s, \"--\" ) ->\n            s\n\n        ( _, _ ) ->\n            \"\"" sources)
        && laundered (appendTo "Lib/Queue.ipe" "labelOf u =\n    case Uid.toSql u of\n        SqlString s {- -- -} ->\n            s" sources)
        && laundered (appendTo "Lib/Queue.ipe" "note =\n    \"\"\"\n    -- \"\"\"\n\n\nlabelOf u =\n    case Uid.toSql u of\n        SqlString s ->\n            s" sources)
        && List.isEmpty (sqlPatternViolations (appendTo "Lib/Queue.ipe" "note =\n    \"SqlString s -> s\"\n\n\nother =\n    {- case v of\n    SqlString s -> s -}\n    1" sources))
        && List.isEmpty (sqlPatternViolations (appendTo "Lib/Queue.ipe" "bind s =\n    SqlString s\n\n\nbound =\n    List.map (\\s -> SqlString s) [ \"a\" ]" sources))
        && List.isEmpty (sqlPatternViolations (appendTo "Lib/Queue.ipe" "labelOf v =\n    case v of\n        MySqlString s ->\n            s" sources))
        && List.isEmpty (sqlPatternViolations (appendTo "Lib/Uid.ipe" "shown v =\n    case v of\n        SqlString s ->\n            s" sources))


laundered : List ScanModule -> Bool
laundered sources =
    not (List.isEmpty (sqlPatternViolations sources))


-- Each text exit sits only at its admitted sites: a bind parameter built
-- in a heading, under `Lib.Uid`, under an import alias, exposed bare, in
-- `Main`; a shown disambiguator or a mac field read outside its one site;
-- an admitted site whose exit is gone or moved to another exit. A token
-- that only contains the name is no site, and `Lib/Uid.ipe` is not
-- scanned. Red if a uid's text can reach a sink the list does not name.
uidBindSitesAdmitted : List ScanModule -> Bool
uidBindSitesAdmitted sources =
    List.isEmpty (uidTextViolations admittedUidExits sources)
        && exitCaught (appendTo "Lib/View.ipe" "heading uid =\n    Uid.toSql uid" sources)
        && exitCaught (appendTo "Lib/Queue.ipe" "labelOf uid =\n    Lib.Uid.toSql uid" sources)
        && exitCaught (prependTo "Lib/Queue.ipe" "import Lib.Uid as U" (appendTo "Lib/Queue.ipe" "labelOf uid =\n    U.toSql uid" sources))
        && exitCaught (prependTo "Lib/Queue.ipe" "import Lib.Uid exposing (toSql)" (appendTo "Lib/Queue.ipe" "labelOf uid =\n    toSql uid" sources))
        && exitCaught (prependTo "Lib/Queue.ipe" "import Lib.Uid exposing (..)" (appendTo "Lib/Queue.ipe" "labelOf uid =\n    placeText uid" sources))
        && exitCaught (appendTo "Main.ipe" "shown uid =\n    Uid.toSql uid" sources)
        && exitCaught (appendTo "Lib/View.ipe" "heading uid =\n    Uid.placeText uid" sources)
        && exitCaught (appendTo "Lib/Db.ipe" "legacyKey uid =\n    Uid.macFieldText (Uid.macField uid)" sources)
        && exitCaught (editIn "Lib/Db.ipe" "Uid.macFieldText uid" "\"\"" sources)
        && exitCaught (appendTo "Lib/Db.ipe" "forgedField =\n    Uid.storedMacField \"not a uid\"" sources)
        && exitCaught (editIn "Lib/Db.ipe" "Uid.storedMacField (storedUidText uid)" "Uid.macField uid" sources)
        && exitCaught (editIn "Lib/View.ipe" "Uid.placeText uid" "SafeText.literal \"\"" sources)
        && exitCaught (List.filter (\scanned -> scanned.rel /= "Lib/Index.ipe") sources)
        && List.isEmpty (uidTextViolations admittedUidExits (appendTo "Lib/Queue.ipe" "labelOf uid =\n    myUid.toSqlLabel uid" sources))
        && List.isEmpty (uidTextViolations admittedUidExits (appendTo "Lib/Uid.ipe" "shown uid =\n    Uid.toSql uid" sources))


exitCaught : List ScanModule -> Bool
exitCaught sources =
    not (List.isEmpty (uidTextViolations admittedUidExits sources))


-- `toString` is no exit: under every spelling and in every module it is a
-- violation, and so is `Lib/Uid.ipe` exposing it, or any exit the pin
-- does not list, or dropping one. Red if a text exit returns unseen.
uidTextScanRefuses : List ScanModule -> Bool
uidTextScanRefuses sources =
    List.isEmpty (uidViolations sources)
        && uidCaught (appendTo "Lib/View.ipe" "heading uid =\n    Uid.toString uid" sources)
        && uidCaught (appendTo "Lib/Queue.ipe" "labelOf uid =\n    Lib.Uid.toString uid" sources)
        && uidCaught (prependTo "Lib/Queue.ipe" "import Lib.Uid as U" (appendTo "Lib/Queue.ipe" "labelOf uid =\n    U.toString uid" sources))
        && uidCaught (prependTo "Lib/Queue.ipe" "import Lib.Uid exposing (toString)" (appendTo "Lib/Queue.ipe" "labelOf uid =\n    toString uid" sources))
        && uidCaught (appendTo "Lib/UnitName.ipe" "shown name =\n    Uid.toString (uid name)" sources)
        && uidCaught (appendTo "Lib/Db.ipe" "legacyKey uid =\n    Uid.toString uid" sources)
        && uidCaught (editIn "Lib/Uid.ipe" "toSql, uidLength)" "toSql, toString, uidLength)" sources)
        && uidCaught (editIn "Lib/Uid.ipe" "toSql, uidLength)" "toSql, uidLength, uidText)" sources)
        && uidCaught (editIn "Lib/Uid.ipe" "placeText, " "" sources)
        && uidCaught (List.filter (\scanned -> scanned.rel /= "Lib/Uid.ipe") sources)


uidCaught : List ScanModule -> Bool
uidCaught sources =
    not (List.isEmpty (uidViolations sources))


-- ── reads carry their bound ─────────────────────────────────────────────
--
-- Every read under `src/Lib` is bounded by the code that issues it, never by
-- the size the schema or the database holds. A read is a `queryDecode` call
-- or a `Store` run that returns rows. Its seed is its own statement, the
-- read's line (or the head of the pipeline it ends) and the deeper lines
-- after it, and the bindings of the names that statement uses: the `let`
-- binding above it, or the scrutinee of the `case` arm binding them. A
-- `queryDecode` read is bounded when a `LIMIT` sits outside every
-- parenthesis of the SQL text written in its seed, or in a same-module
-- definition the seed names, up to `readReachDepth` deep. A `Store` run is
-- never bounded: `Store.limit` bounds no runner that takes no query, and
-- every run decodes its cells whole, past any per-cell window. A read not
-- bounded is one aggregate row by construction: it is admitted, keyed
-- `rel:name` with the count of such reads the definition issues, holds an
-- aggregate token in its seed and reaches no `GROUP`.

-- A top-level definition: its name, the first token of its column-0
-- lowercase lines, and the code of each of its lines.
type alias TopDef =
    { name : String, lines : List String }


-- The top-level definitions of `lines` in order. Consecutive column-0
-- lines of one name, a type annotation and its definition, are one
-- definition; every other line belongs to the definition above it. One
-- pass carries the definitions closed, the name of the open one, and its
-- lines so far, so each line is appended once.
topDefsOf : List String -> List TopDef
topDefsOf lines =
    case List.foldl topDefStep ( [], Nothing, [] ) lines of
        ( defs, current, currentLines ) ->
            closeTopDef defs current currentLines


topDefStep : String -> ( List TopDef, Maybe String, List String ) -> ( List TopDef, Maybe String, List String )
topDefStep line ( defs, current, currentLines ) =
    let
        code =
            codeOf line

        opened =
            if leadsWith Char.isLower line then
                List.head (tokens line)

            else
                Nothing
    in
    case opened of
        Just _ ->
            if opened == current then
                ( defs, current, currentLines ++ [ code ] )

            else
                ( closeTopDef defs current currentLines, opened, [ code ] )

        Nothing ->
            case current of
                Just _ ->
                    ( defs, current, currentLines ++ [ code ] )

                Nothing ->
                    ( defs, current, currentLines )


-- `defs` with the open definition, if any, closed after them.
closeTopDef : List TopDef -> Maybe String -> List String -> List TopDef
closeTopDef defs current currentLines =
    case current of
        Just name ->
            defs ++ [ { name = name, lines = currentLines } ]

        Nothing ->
            defs


defTokens : TopDef -> List String
defTokens def =
    List.concatMap tokens def.lines


-- A read's seed: the read calls on its line, its statement, and the lines
-- binding the names its statement uses.
type alias ReadSeed =
    { calls : List String, statement : List String, bindings : List String }


-- The seed of each read `def` issues, one per line holding a read call.
readSeedsOf : TopDef -> List ReadSeed
readSeedsOf def =
    List.concat
        (List.indexedMap
            (\at line ->
                case List.filter isReadCall (tokens line) of
                    [] ->
                        []

                    calls ->
                        [ readSeedAt def.lines at calls ]
            )
            def.lines
        )


readSeedAt : List String -> Int -> List String -> ReadSeed
readSeedAt lines at calls =
    let
        from =
            statementStart lines at

        statement =
            statementFrom lines from
    in
    { calls = calls
    , statement = statement
    , bindings = List.concatMap (bindingOf lines from) (List.unique (List.concatMap tokens statement))
    }


-- The line the statement holding line `at` opens on: that line, or for a
-- pipeline step, the nearest line above it indented less.
statementStart : List String -> Int -> Int
statementStart lines at =
    let
        line =
            Maybe.withDefault "" (List.head (List.drop at lines))
    in
    if String.startsWith "|>" (String.trim line) then
        List.foldl
            (\( index, above ) found ->
                if not (isBlank above) && indentOf above < indentOf line then
                    index

                else
                    found
            )
            at
            (List.indexedMap (\index above -> ( index, above )) (List.take at lines))

    else
        at


-- The statement opening at line `from`: that line and the deeper lines
-- after it, up to the first blank line or one indented no deeper.
statementFrom : List String -> Int -> List String
statementFrom lines from =
    case List.drop from lines of
        first :: rest ->
            first :: deeperRun (indentOf first) rest

        [] ->
            []


deeperRun : Int -> List String -> List String
deeperRun depth lines =
    List.reverse
        (Tuple.first
            (List.foldl
                (\line ( kept, open ) ->
                    if open && not (isBlank line) && indentOf line > depth then
                        ( line :: kept, True )

                    else
                        ( kept, False )
                )
                ( [], True )
                lines
            )
        )


-- The lines binding `name` above line `from`, the nearest binding first:
-- a `let` binding naming it, with its deeper lines, or the scrutinee line
-- of the `case` whose arm names it. A definition's own head, at column 0,
-- binds only parameters and is no binding.
bindingOf : List String -> Int -> String -> List String
bindingOf lines from name =
    let
        numbered =
            List.reverse (List.indexedMap (\index line -> ( index, line )) (List.take from lines))

        binds entry =
            indentOf (Tuple.second entry) > 0 && opensBinding (Tuple.second entry) && List.member name (tokens (Tuple.second entry))
    in
    if leadsWith Char.isLower name then
        case List.find binds numbered of
            Just ( index, line ) ->
                if String.endsWith "=" (String.trimEnd line) then
                    statementFrom lines index

                else
                    scrutineeOf numbered index (indentOf line)

            Nothing ->
                []

    else
        []


-- A line ending in `=` or `->`: a binding's or a `case` arm's head.
opensBinding : String -> Bool
opensBinding line =
    String.endsWith "=" (String.trimEnd line) || String.endsWith "->" (String.trimEnd line)


-- The nearest `case` line above line `index` indented less than `depth`,
-- from `numbered`, the lines above nearest first.
scrutineeOf : List ( Int, String ) -> Int -> Int -> List String
scrutineeOf numbered index depth =
    List.find (\entry -> Tuple.first entry < index && indentOf (Tuple.second entry) < depth && List.member "case" (tokens (Tuple.second entry))) numbered
        |> Maybe.map (\entry -> [ Tuple.second entry ])
        |> Maybe.withDefault []


indentOf : String -> Int
indentOf line =
    String.length line - String.length (String.trimStart line)


isBlank : String -> Bool
isBlank line =
    String.isEmpty (String.trim line)


-- A call that runs a read: `queryDecode` under any qualifier, and the
-- `Store` runs that return rows.
isReadCall : String -> Bool
isReadCall token =
    token == "queryDecode" || String.endsWith ".queryDecode" token || isStoreRun token


-- Each spelling of a `Store` run holds `Store.`, so a token without it is
-- no run and is not matched against each.
isStoreRun : String -> Bool
isStoreRun token =
    String.contains "Store." token && List.any (\run -> token == "Store." ++ run || String.endsWith (".Store." ++ run) token) storeRuns


-- Every `Ipe.Db.Store` function that runs a query and returns its rows.
storeRuns : List String
storeRuns =
    [ "all", "allAs", "allOn", "findBy", "findWhere", "findWhereOn", "get", "getAs", "getOn", "joinToList", "joinToMaybe", "selectToList", "selectToMaybe", "toList", "toMaybe" ]


-- The text of the string literals in `lines`, in order, escaped quotes and
-- backslashes dropped.
literalsOf : List String -> String
literalsOf lines =
    String.join "\n" lines
        |> String.replace "\\\\" ""
        |> String.replace "\\\"" ""
        |> String.split "\""
        |> List.indexedMap
            (\index piece ->
                if modBy 2 index == 1 then
                    piece

                else
                    ""
            )
        |> String.join " "


-- True when `sql` holds a `LIMIT` outside every parenthesis, so it bounds
-- the statement itself rather than a subquery.
limitAtTop : String -> Bool
limitAtTop sql =
    case String.split "LIMIT" sql of
        first :: rest ->
            Tuple.second (List.foldl (\piece ( depth, found ) -> ( depth + parenDepth piece, found || depth == 0 )) ( parenDepth first, False ) rest)

        [] ->
            False


parenDepth : String -> Int
parenDepth text =
    List.length (String.indexes "(" text) - List.length (String.indexes ")" text)


readReachDepth : Int
readReachDepth =
    3


-- A definition as a read's reach sees it: its name, whether its SQL text
-- holds a `LIMIT` outside every parenthesis, whether it names `GROUP`, and
-- the definitions of its module it names. Each is read from the
-- definition's lines once, however many reads reach it.
type alias Reach =
    { name : String, limited : Bool, grouped : Bool, names : Set String }


reachOf : Set String -> TopDef -> Reach
reachOf defNames def =
    let
        defToks =
            defTokens def
    in
    { name = def.name
    , limited = limitAtTop (literalsOf def.lines)
    , grouped = List.member "GROUP" defToks
    , names = Set.intersect (Set.fromList defToks) defNames
    }


-- The definitions in `reaches` that `frontier` names, followed `depth`
-- more steps through the definitions each names, none `seen` before.
-- `frontier` holds only definition names, none in `seen`.
reachedFrom : List Reach -> Int -> Set String -> Set String -> List Reach
reachedFrom reaches depth seen frontier =
    let
        named =
            List.filter (\reach -> Set.member reach.name frontier) reaches

        nextSeen =
            Set.union seen frontier

        next =
            Set.diff (List.foldl (\reach acc -> Set.union reach.names acc) Set.empty named) nextSeen
    in
    if depth <= 0 || List.isEmpty named then
        []

    else
        named ++ reachedFrom reaches (depth - 1) nextSeen next


-- A single-row aggregate read holds one of these in its seed.
aggregateTokens : List String
aggregateTokens =
    [ "COUNT", "count", "EXISTS", "MIN", "MAX", "pragma_page_count" ]


-- Each read of module `rel` that carries no bound: its key and whether it
-- is one aggregate row.
unboundedReadsOf : String -> List String -> List ( String, Bool )
unboundedReadsOf rel lines =
    let
        defs =
            topDefsOf lines

        defNames =
            Set.fromList (List.map (\def -> def.name) defs)

        reaches =
            List.map (reachOf defNames) defs
    in
    List.concatMap (judgedRead rel defNames reaches) (List.concatMap namedSeedsOf defs)


-- The seed of each read `def` issues, with the definition's name.
namedSeedsOf : TopDef -> List ( String, ReadSeed )
namedSeedsOf def =
    let
        name =
            def.name
    in
    List.map (\seed -> ( name, seed )) (readSeedsOf def)


-- The read of `seed`, in the definition `name` of module `rel`, when it
-- carries no bound.
judgedRead : String -> Set String -> List Reach -> ( String, ReadSeed ) -> List ( String, Bool )
judgedRead rel defNames reaches named =
    case named of
        ( name, seed ) ->
            let
                seedLines =
                    seed.statement ++ seed.bindings

                seedTokens =
                    List.concatMap tokens seedLines

                reached =
                    reachedFrom reaches readReachDepth (Set.singleton name) (Set.remove name (Set.intersect (Set.fromList seedTokens) defNames))

                bounded =
                    if List.any isStoreRun seed.calls then
                        False

                    else
                        limitAtTop (literalsOf seedLines) || List.any (\reach -> reach.limited) reached
            in
            if bounded then
                []

            else
                [ ( rel ++ ":" ++ name, List.any (\token -> List.member token seedTokens) aggregateTokens && not (List.member "GROUP" seedTokens || List.any (\reach -> reach.grouped) reached) ) ]


-- The reads admitted without a `LIMIT`, each a single aggregate row, by
-- `rel:name` and the count of them the definition issues.
admittedAggregates : List ( String, Int )
admittedAggregates =
    [ ( "Lib/Db.ipe:entriesBefore", 1 )
    , ( "Lib/Db.ipe:entriesPast", 1 )
    , ( "Lib/Db.ipe:firstRepeat", 1 )
    , ( "Lib/Db.ipe:requireNamedBeforeMigration", 2 )
    , ( "Lib/Db.ipe:requireNamedRows", 1 )
    , ( "Lib/Index.ipe:countAll", 1 )
    , ( "Lib/Index.ipe:countAllRefusals", 1 )
    , ( "Lib/Index.ipe:countOpenRefusals", 1 )
    , ( "Lib/Index.ipe:countPending", 1 )
    , ( "Lib/Index.ipe:countRefusals", 1 )
    , ( "Lib/Index.ipe:countUnbound", 1 )
    , ( "Lib/Index.ipe:countUnboundRefusals", 1 )
    , ( "Lib/Index.ipe:countUnits", 1 )
    , ( "Lib/Index.ipe:dbBytes", 1 )
    ]


-- A read under `Lib/` that reaches no bound and is not admitted, an
-- admitted read that is not one aggregate row, and an admitted definition
-- issuing another count of unbounded reads than listed.
readViolations : List ( String, Int ) -> List ScanModule -> List String
readViolations admitted modules =
    let
        found =
            List.concatMap (\scanned -> scanned.reads) (List.filter (\scanned -> String.startsWith "Lib/" scanned.rel) modules)

        admittedKeys =
            List.map Tuple.first admitted

        countOf key =
            List.length (List.filter (\read -> Tuple.first read == key) found)
    in
    List.map (\read -> "the read at " ++ Tuple.first read ++ " carries no LIMIT and is not admitted") (List.filter (\read -> not (List.member (Tuple.first read) admittedKeys)) found)
        ++ List.map (\read -> "the admitted read at " ++ Tuple.first read ++ " is not one aggregate row") (List.filter (\read -> not (Tuple.second read)) found)
        ++ List.map (\entry -> "the admitted definition " ++ Tuple.first entry ++ " issues another count of unbounded reads") (List.filter (\entry -> countOf (Tuple.first entry) /= Tuple.second entry) admitted)


-- The tree's reads are bounded, and each way around the scan is a
-- violation: a new read with no `LIMIT`, a second unbounded read in an
-- admitted definition, an admitted aggregate given a `GROUP BY` or turned
-- into a row read, a bounded read losing its `LIMIT`, any `Store` run, even
-- one piped through `Store.limit`, a `LIMIT` only inside a subquery, a
-- `LIMIT` on a line of the definition outside the read's statement, an
-- admitted entry no source holds. A `LIMIT` in a definition the read names
-- counts.
-- Red if a read can take its size from the database, or the scan stops
-- seeing one.
readsCarryLimit : List ScanModule -> Bool
readsCarryLimit sources =
    List.isEmpty (readViolations admittedAggregates sources)
        && readCaught (appendTo "Lib/Db.ipe" "leakedRead conn =\n    Db.queryDecode conn \"SELECT seq FROM review_log\" [] leakedDecoder" sources)
        && readCaught (appendTo "Lib/Db.ipe" "entriesBefore db =\n    Db.queryDecode db \"SELECT seq AS entries FROM review_log\" [] entriesDecoder" sources)
        && readCaught (replaceIn "Lib/Db.ipe" "count(*) AS entries FROM review_log WHERE seq < 1" "seq AS entries FROM review_log WHERE seq < 1" sources)
        && readCaught (replaceIn "Lib/Db.ipe" "count(*) AS entries FROM review_log WHERE seq > ?" "count(*) AS entries FROM review_log WHERE seq > ? GROUP BY uid" sources)
        && readCaught (replaceIn "Lib/Db.ipe" "review_log_head WHERE one = 1 LIMIT 2" "review_log_head WHERE one = 1" sources)
        && readCaught (replaceIn "Lib/Index.ipe" "reviewed_stamp WHERE one = 1 LIMIT 2" "reviewed_stamp WHERE one = 1" sources)
        && readCaught (replaceIn "Lib/Index.ipe" "(sql ++ \" LIMIT 2\")" "sql" sources)
        && readCaught (replaceIn "Lib/Db.ipe" "\" WHERE uid = ? AND body_hash = ? LIMIT 1\"" "\" WHERE uid = ? AND body_hash = ?\"" sources)
        && readCaught (appendTo "Lib/Db.ipe" "leakedRows db =\n    Store.all db reviews" sources)
        && readCaught (appendTo "Lib/Db.ipe" "leakedFind db =\n    Store.findBy db reviews \"uid\" (SqlString \"u\")" sources)
        && readCaught (appendTo "Lib/Db.ipe" "leakedRead conn =\n    Db.queryDecode conn \"SELECT seq FROM review_log WHERE seq IN (SELECT seq FROM review_log LIMIT 1)\" [] leakedDecoder" sources)
        && readCaught (appendTo "Lib/Db.ipe" "leakedRead conn =\n    do\n        rows <- Db.queryDecode conn \"SELECT seq FROM review_log\" [] leakedDecoder\n        Task.succeed (List.take 1 rows ++ [ \"LIMIT 1\" ])" sources)
        && not (List.isEmpty (readViolations (( "Lib/Db.ipe:gone", 1 ) :: admittedAggregates) sources))
        && List.isEmpty (readViolations admittedAggregates (appendTo "Lib/Db.ipe" "boundedRead conn =\n    Db.queryDecode conn boundedSql [] boundedDecoder\n\n\nboundedSql =\n    \"SELECT seq FROM review_log LIMIT 1\"" sources))
        && readCaught (appendTo "Lib/Db.ipe" "boundedRows db =\n    Store.all reviews\n        |> Store.limit 1\n        |> Store.toList db" sources)


readCaught : List ScanModule -> Bool
readCaught sources =
    not (List.isEmpty (readViolations admittedAggregates sources))


-- `sources` with every `from` in the text of `rel` replaced by `to`, that
-- module indexed anew.
replaceIn : String -> String -> String -> List ScanModule -> List ScanModule
replaceIn rel from to sources =
    List.map
        (\scanned ->
            if scanned.rel == rel then
                indexModule ( rel, String.replace from to scanned.text )

            else
                scanned
        )
        sources


-- ── the real tree ───────────────────────────────────────────────────────
--
-- The tree holds no violation, and each way around a scan is one: a new
-- conversion site, a site moved to another top-level name, an admitted
-- site removed from the list or from the source, the view importing
-- `Ipe.Error`, a conversion under an import alias or exposed bare, and an
-- error's text read from its record (`info.message`, `{ message }`) or its
-- details (`Custom s`). A token that only contains a conversion's name, and
-- a record field of that name that is not a pattern, are no site.
-- Red if a page can show an error's text, or a scan stops seeing a way
-- around it.
realTreeClean : List ScanModule -> Bool
realTreeClean sources =
    List.isEmpty (scanViolations sources)


scansRefuseEvasions : List ScanModule -> Bool
scansRefuseEvasions sources =
    caught (appendTo "Lib/Queue.ipe" "show e =\n    Error.toString e" sources)
        && caught (appendTo "Main.ipe" "moved e =\n    Error.message e" sources)
        && caught (appendTo "Lib/App.ipe" "named e =\n    Error.kindName e" sources)
        && not (List.isEmpty (conversionViolations (List.filter (\site -> site /= "Lib/ServerLog.ipe:logged") admittedConversions) sources))
        && not (List.isEmpty (conversionViolations admittedConversions (List.filter (\scanned -> scanned.rel /= "Lib/ServerLog.ipe") sources)))
        && caught (prependTo "Lib/View.ipe" "import Ipe.Error as Error" sources)
        && caught (prependTo "Lib/Queue.ipe" "import Ipe.Error as E" (appendTo "Lib/Queue.ipe" "shown e =\n    E.message e" sources))
        && caught (prependTo "Lib/Queue.ipe" "import Ipe.Error exposing (toString)" (appendTo "Lib/Queue.ipe" "shown e =\n    toString e" sources))
        && caught (appendTo "Lib/Queue.ipe" "shown e =\n    case e of\n        Error _ info ->\n            info.message" sources)
        && caught (appendTo "Lib/Queue.ipe" "shown e =\n    case e of\n        Error _ { message } ->\n            message" sources)
        && caught (appendTo "Lib/Queue.ipe" "shown d =\n    case d of\n        Custom text ->\n            text" sources)
        && List.isEmpty (scanViolations (appendTo "Lib/Queue.ipe" "label =\n    errorToStringLabel refuseError.messages { messageCount = 1, message = \"x\" }\n\n\ntype alias Note =\n    { message : String }" sources))


caught : List ScanModule -> Bool
caught sources =
    not (List.isEmpty (scanViolations sources))


-- `sources` with `extra` after the text of `rel`, that module indexed anew.
appendTo : String -> String -> List ScanModule -> List ScanModule
appendTo rel extra sources =
    List.map
        (\scanned ->
            if scanned.rel == rel then
                indexModule ( rel, scanned.text ++ "\n\n" ++ extra ++ "\n" )

            else
                scanned
        )
        sources


-- `sources` with `extra` before the text of `rel`, that module indexed anew.
prependTo : String -> String -> List ScanModule -> List ScanModule
prependTo rel extra sources =
    List.map
        (\scanned ->
            if scanned.rel == rel then
                indexModule ( rel, extra ++ "\n" ++ scanned.text )

            else
                scanned
        )
        sources


-- `sources` with each `old` in the text of `rel` replaced by `new`, that
-- module indexed anew.
editIn : String -> String -> String -> List ScanModule -> List ScanModule
editIn rel old new sources =
    List.map
        (\scanned ->
            if scanned.rel == rel then
                indexModule ( rel, String.replace old new scanned.text )

            else
                scanned
        )
        sources


-- ── scanner self-tests ──────────────────────────────────────────────────


sessionOnly : String -> List ( String, String )
sessionOnly text =
    [ ( "Lib/Session.ipe", text ) ]


reachFlags : List ( String, String ) -> Bool
reachFlags sources =
    not (List.isEmpty (reachViolations sources))


-- A state holding an error, a message carrying one, a type in another
-- module holding one, a name that resolves nowhere, a type in a module
-- `src` does not hold, a missing `Model`, a declaration continued past a
-- blank line, and a walk past its ceiling, by one declaration or more, are
-- each violations; a field named `refuseError` holding a typed case, and a
-- walk of exactly `reachCeiling` declarations, are not.
-- Red if the walk misses a path an error could reach a page by.
typeWalkRefuses : Bool
typeWalkRefuses =
    reachFlags (sessionOnly "type alias Model =\n    { queueState : QueueState }\n\n\ntype Msg\n    = Reload\n\n\ntype QueueState\n    = Loading\n    | Failed Error\n")
        && reachFlags (sessionOnly "type alias Model =\n    { n : Int }\n\n\ntype Msg\n    = QueueLoaded (Result Error QueuePage)\n\n\ntype alias QueuePage =\n    { n : Int }\n")
        && reachFlags
            [ ( "Lib/Session.ipe", "import Lib.Failure as Failure exposing (LoadFailure)\n\n\ntype alias Model =\n    { load : Maybe LoadFailure, save : Maybe Failure.SaveFailure }\n\n\ntype Msg\n    = Reload\n" )
            , ( "Lib/Failure.ipe", "type LoadFailure\n    = LoadFailed\n\n\ntype SaveFailure\n    = SaveFailed Error\n" )
            ]
        && reachFlags (sessionOnly "type alias Model =\n    { x : Foo.Bar }\n\n\ntype Msg\n    = Reload\n")
        && reachFlags (sessionOnly "import Lib.Gone exposing (Gone)\n\n\ntype alias Model =\n    { gone : Gone }\n\n\ntype Msg\n    = Reload\n")
        && reachFlags (sessionOnly "type Msg\n    = Reload\n")
        && reachFlags (sessionOnly "type alias Model =\n    { n : Int }\n\n\ntype Msg\n    = Reload\n\n    | Failed Error\n")
        && reachFlags (sessionOnly (chainedModel (reachCeiling + 2)))
        && reachFlags (sessionOnly (chainedModel (reachCeiling - 2)))
        && List.isEmpty (reachViolations (sessionOnly (chainedModel (reachCeiling - 3))))
        && List.isEmpty (reachViolations (sessionOnly "type alias Model =\n    { refuseError : Maybe RefuseFailure }\n\n\ntype Msg\n    = Reload\n\n\ntype RefuseFailure\n    = DraftWhileSaving\n"))
        && List.isEmpty (reachViolations (sessionOnly (chainedModel 8)))


-- A `Model` and `Msg` reaching `depth + 1` more declarations, each naming
-- the next: `depth + 3` in all.
chainedModel : Int -> String
chainedModel depth =
    let
        link i =
            "type alias T" ++ String.fromInt i ++ " =\n    { next : T" ++ String.fromInt (i + 1) ++ " }\n"
    in
    String.join "\n\n"
        ([ "type alias Model =\n    { next : T1 }\n", "type Msg\n    = Reload\n" ]
            ++ List.map link (List.range 1 depth)
            ++ [ "type alias T" ++ String.fromInt (depth + 1) ++ " =\n    { n : Int }\n" ]
        )


-- The conversion scan keys a site by its enclosing name and admits only
-- the listed sites; a token that contains a conversion's name is no site,
-- and more files than the ceiling refuse the read. Red if the scan matches
-- substrings or a site's name.
conversionScanRefuses : Bool
conversionScanRefuses =
    conversionSitesIn "Lib/Queue.ipe" "show e =\n    Error.toString e\n\n\nlabel =\n    errorToStringLabel refuseError\n" == [ "Lib/Queue.ipe:show" ]
        && conversionViolations [ "Lib/Queue.ipe:show" ] [ indexModule ( "Lib/Queue.ipe", "show e =\n    Error.toString e\n" ) ] == []
        && List.length (conversionViolations [ "Lib/Queue.ipe:show" ] [ indexModule ( "Lib/Queue.ipe", "other e =\n    Error.toString e\n" ) ]) == 2
        && Result.toMaybe (withinFileCeiling (List.repeat (fileCeiling + 1) "")) == Nothing
        && Result.toMaybe (withinFileCeiling (List.repeat fileCeiling "")) /= Nothing


-- `src` read and indexed once, for every check of the tree.
indexedTree : Task.Task Error (List ScanModule)
indexedTree =
    srcSources |> Task.map (List.map indexModule)


-- `scan` of the indexed tree, or the read's failure.
onTree : (List ScanModule -> Bool) -> Result Error (List ScanModule) -> Task.Task Error Bool
onTree scan tree =
    Task.fromResult (Result.map scan tree)


-- Each check of the tree reads the one index; a failed read fails each of
-- them.
checks : Task.Task Error (List ( String, Bool ))
checks =
    indexedTree
        |> Task.map Ok
        |> Task.onError (\e -> Task.succeed (Err e))
        |> Task.andThen
            (\tree ->
                Task.sequence
                    [ check "no page can show an error's text: the source scans find no violation" (onTree realTreeClean tree)
                    , check "each way around the source scans is a violation" (onTree scansRefuseEvasions tree)
                    , Task.succeed ( "the type walk refuses every path an error reaches a page by", typeWalkRefuses )
                    , Task.succeed ( "the conversion scan admits only the listed sites, by token", conversionScanRefuses )
                    , check "a uid leaves its type only through a pinned exit, and toString is none" (onTree uidTextScanRefuses tree)
                    , check "a SqlValue is never taken apart, so a uid's bind parameter is never text" (onTree uidLaunderingRefused tree)
                    , check "each text exit of a uid sits only at its admitted sites" (onTree uidBindSitesAdmitted tree)
                    , check "every read under src/Lib carries a LIMIT or is an admitted aggregate row" (onTree readsCarryLimit tree)
                    ]
            )
