import TestSupport exposing (tableExists, countReviewRows, expectErr, refuse, seedIndex, writeFileText, fixtureLibRs, fixtureMainIpe, viewA, viewB, viewTag, shownTextOf, unitViewTag, execIndex, execIndexUnchecked, Scratch, freshScratch, freshDir, check, onFreshReview, indexSchemaStatements, execIndexSchema, seedIndexDb, insertUnitRows, setIndexEnv, loadFirstPage, checkUnits, listSecond, isUnitA, isUnitB, cleanupIndex, removeFileIfAny, codeText, noHazard, rendered, renderedForeign, describeText, refusedFor, migratedReviewAt, tableNames, attestedFor, openReadOnlyAt, vectorsPath, ipeIndexTestFile, repoFile, probeMessage, probeNames, maybeContains, reviewHeadOf, uid, testMacKey, countingVerifier, RawRow, rawRow, appendSigned, appendSignedAs, tamperLog, headTextOf, logRowCount, testReviewKey)


removeReviewFiles : String -> Task.Task Error ()
removeReviewFiles dbPath =
    do
        removeFileIfAny dbPath
        removeFileIfAny (dbPath ++ "-wal")
        removeFileIfAny (dbPath ++ "-shm")


-- After `probe` the review database holds the legacy review table and its
-- head, the signed review log and its head, and the migrations table,
-- nothing else: no write-only table outlives its
-- last reader. A second `probe` on the same file is a no-op. Red while the
-- `drain_cursor` migration stands without the one dropping it.
drainCursorGoneAfterMigrate : Task.Task Error Bool
drainCursorGoneAfterMigrate =
    freshDir "ipe-review-table-set" |> Task.andThen drainCursorGoneAfterMigrateIn


drainCursorGoneAfterMigrateIn : String -> Task.Task Error Bool
drainCursorGoneAfterMigrateIn base =
    let
        dbPath =
            base ++ "/review.db"
    in
    do
        loc <- Settings.parseDbLocation "IPE_REVIEW_DB" dbPath
        LibDb.probe loc
        LibDb.probe loc
        db <- LibDb.openAt loc
        tables <- tableNames db
        removeReviewFiles dbPath
        Task.succeed (tables == [ "_ipe_migrations", "review", "review_head", "review_log", "review_log_head" ])


-- `LibDb.openAt` never migrates: on a review file that `probe` never ran on,
-- the next read is a typed error and no table is created. A review file
-- deleted under a running server is therefore never silently re-created
-- empty. Red while `openAt` migrates.
openDoesNotMigrate : Task.Task Error Bool
openDoesNotMigrate =
    freshDir "ipe-review-open-no-migrate" |> Task.andThen openDoesNotMigrateIn


openDoesNotMigrateIn : String -> Task.Task Error Bool
openDoesNotMigrateIn base =
    let
        dbPath =
            base ++ "/review.db"
    in
    do
        db <- Settings.parseReviewDb dbPath |> Task.andThen LibDb.openAt
        verify <- countingVerifier
        readFailed <- LibDb.findDecision verify db (uid "u-a") "h"
            |> Task.map (\_ -> False)
            |> Task.onError (\_ -> Task.succeed True)
        created <- tableExists db "review"
        removeReviewFiles dbPath
        Task.succeed (readFailed && not created)


-- A second decision on the same attested pair is `AlreadyDecided`: one
-- row, the first decision kept, and the log's head where the first decision
-- moved it. The first decision links the head from the one read before it
-- to the one read after it. Red if a duplicate inserts a second row,
-- replaces the first decision, is reported as `Inserted`, or moves the head.
-- The two decisions run one after the other, so this does not tell a
-- dedupe in the insert from a read before it.
duplicateDecisionAlreadyDecided : Task.Task Error Bool
duplicateDecisionAlreadyDecided =
    onFreshReview "ipe-review-duplicate"
        (\db ->
            do
                attested <- attestedFor "ipe-review-duplicate-index" (uid "u-a")
                key <- testMacKey
                verify <- countingVerifier
                genesis <- reviewHeadOf db
                first <- LibDb.insertDecision key db attested Approved
                afterFirst <- reviewHeadOf db
                changed <- refuse "changed"
                second <- LibDb.insertDecision key db attested changed
                afterSecond <- reviewHeadOf db
                n <- countReviewRows db (uid "u-a") (Index.attest viewA)
                found <- LibDb.findDecision verify db (uid "u-a") (Index.attest viewA)
                Task.succeed
                    (linksFrom genesis afterFirst first
                        && isAlreadyDecided second
                        && afterSecond
                        == afterFirst
                        && n
                        == 1
                        && isApproved found
                    )
        )


-- True when `written` is a new row that moved the copy's stamp from `prev`
-- to `next`.
linksFrom : String -> String -> Index.Written -> Bool
linksFrom prev next written =
    case written of
        Inserted link ->
            Index.stampText link.prev == prev && Index.stampText link.next == next && prev /= next

        AlreadyDecided ->
            False


isAlreadyDecided : Index.Written -> Bool
isAlreadyDecided written =
    case written of
        Inserted _ ->
            False

        AlreadyDecided ->
            True


-- The review log is append-only: deleting or updating a log row, deleting
-- the head, and changing the log's id are each refused by a trigger, and the
-- row and the head are left as they were. Re-inserting the first entry with
-- a replacing conflict clause (SQLite's REPLACE deletes the old row without
-- firing a delete trigger) or an upsert changes nothing: the first decision
-- stays. A refusal counts only as a trigger's `RAISE(ABORT)`, so a statement
-- that fails for another reason (a typo, a missing table) is red, and a
-- rewrite either runs or is refused by a trigger. Red with any of the five
-- log triggers dropped.
reviewLogAppendOnly : Db -> Task.Task Error Bool
reviewLogAppendOnly db =
    let
        refused sql =
            Db.exec db sql []
                |> Task.map (\_ -> False)
                |> Task.onError (\e -> Task.succeed (Error.message e == triggerAbortError))

        rewrite sql =
            Db.exec db sql [ Uid.toSql (uid "u-a"), SqlString (Index.attest viewA), SqlString "refuse", SqlString "rewritten", SqlInt 0, SqlString (String.repeat 64 "a") ]
                |> Task.map (\_ -> True)
                |> Task.onError (\e -> Task.succeed (Error.message e == triggerAbortError))

        columns =
            "review_log (seq, uid, body_hash, decision, reason, reviewed_at, prev, mac) VALUES (1, ?, ?, ?, ?, ?, 'genesis', ?)"
    in
    do
        attested <- attestedFor "ipe-review-append-only-index" (uid "u-a")
        key <- testMacKey
        verify <- countingVerifier
        LibDb.insertDecision key db attested Approved
        head <- headTextOf db
        refusals <- Task.sequence
            (List.map refused
                [ "DELETE FROM review_log"
                , "UPDATE review_log SET decision = 'refuse', reason = 'x'"
                , "UPDATE review_log SET body_hash = 'other'"
                , "DELETE FROM review_log_head"
                , "UPDATE review_log_head SET log_id = '00000000000000000000000000000000'"
                ]
            )
        rewrites <- Task.sequence
            (List.map rewrite
                [ "INSERT OR REPLACE INTO " ++ columns
                , "REPLACE INTO " ++ columns
                , "INSERT INTO " ++ columns ++ " ON CONFLICT (seq) DO UPDATE SET decision = excluded.decision, reason = excluded.reason, mac = excluded.mac"
                ]
            )
        n <- countReviewRows db (uid "u-a") (Index.attest viewA)
        kept <- LibDb.findDecision verify db (uid "u-a") (Index.attest viewA)
        headAfter <- headTextOf db
        Task.succeed
            (List.all (\ok -> ok) (refusals ++ rewrites)
                && n
                == 1
                && isApproved kept
                && headAfter
                == head
            )


-- The error a trigger's `RAISE(ABORT, ...)` surfaces as: SQLite's extended
-- code `SQLITE_CONSTRAINT_TRIGGER` (1811). The runtime keeps a database
-- error's code and never its driver text, so the trigger's own message is
-- not observable and the code is what tells its refusal from any other
-- failure.
triggerAbortError : String
triggerAbortError =
    "db: database error [1811]"


-- The head moves only from the head it was read as: a compare-and-set from a
-- head that is not current fails with a typed conflict, and the log row
-- written in the same transaction is rolled back with it, so a decision can
-- never be kept without its link and no orphan entry remains. Red if
-- `advanceHead` ignores a zero-row update.
concurrentHeadCasRefuses : Db -> Task.Task Error Bool
concurrentHeadCasRefuses db =
    do
        current <- LibDb.currentHead db
        before <- headTextOf db
        refusedAsConflict <- staleCasRefused db (Index.chainNext current (String.repeat 64 "b"))
        n <- logRowCount db
        headAfter <- headTextOf db
        Task.succeed (refusedAsConflict && n == 0 && headAfter == before)


-- One transaction that writes the log's first entry, then moves the head
-- from `stale`; True when it fails as a conflict.
staleCasRefused : Db -> Index.ChainHead -> Task.Task Error Bool
staleCasRefused db stale =
    Db.withTransaction db
        (\tx ->
            do
                Db.exec tx "INSERT INTO review_log (seq, uid, body_hash, decision, reason, reviewed_at, prev, mac) VALUES (1, ?, ?, 'approve', NULL, 0, 'genesis', ?)" [ Uid.toSql (uid "cas-uid"), SqlString "cas-hash", SqlString (String.repeat 64 "c") ]
                LibDb.advanceHead tx stale (Index.chainNext stale (String.repeat 64 "c"))
        )
        |> Task.map (\_ -> False)
        |> Task.onError (\e -> Task.succeed (Error.kind e == Error.kind (Error.conflict "")))


-- A review file whose log head is gone fails the startup probe, naming the
-- variable and the file. Red if the probe only migrates.
probeRefusesReviewWithoutHead : Task.Task Error Bool
probeRefusesReviewWithoutHead =
    freshDir "ipe-review-probe-no-head" |> Task.andThen probeRefusesReviewWithoutHeadIn


probeRefusesReviewWithoutHeadIn : String -> Task.Task Error Bool
probeRefusesReviewWithoutHeadIn base =
    let
        dbPath =
            base ++ "/review.db"
    in
    do
        db <- migratedReviewAt dbPath
        Db.exec db "DROP TABLE review_head" []
        loc <- Settings.parseDbLocation "IPE_REVIEW_DB" dbPath
        message <- probeMessage (LibDb.probe loc)
        removeReviewFiles dbPath
        Task.succeed (probeNames "IPE_REVIEW_DB" dbPath message)


-- A review file whose append-only guards are gone fails the startup probe,
-- naming the variable and the file: one trigger dropped, and the log renamed
-- away and recreated bare (its triggers follow the renamed table). An intact
-- file passes. The refusal says the log lost a guard and how to restore it,
-- never that the location must be writable. Red if the probe does not check
-- the guards on their table, or the guard refusal gets the open fix; the
-- review log losing `review_log_no_update` is refused the same way.
probeRefusesReviewWithoutGuards : Task.Task Error Bool
probeRefusesReviewWithoutGuards =
    freshDir "ipe-review-probe-no-guards" |> Task.andThen probeRefusesReviewWithoutGuardsIn


probeRefusesReviewWithoutGuardsIn : String -> Task.Task Error Bool
probeRefusesReviewWithoutGuardsIn base =
    let
        dropped =
            base ++ "/dropped.db"

        renamed =
            base ++ "/renamed.db"
    in
    do
        intact <- probeAfterEdits (base ++ "/intact.db") []
        droppedMessage <- probeAfterEdits dropped [ "DROP TRIGGER review_no_replace" ]
        droppedLogMessage <- probeAfterEdits (base ++ "/dropped-log.db") [ "DROP TRIGGER review_log_no_update" ]
        renamedMessage <- probeAfterEdits renamed [ "ALTER TABLE review RENAME TO review_old", "CREATE TABLE review (uid TEXT NOT NULL, body_hash TEXT NOT NULL, decision TEXT NOT NULL, reason TEXT, reviewed_at INTEGER NOT NULL, PRIMARY KEY (uid, body_hash))" ]
        Task.succeed
            (intact
                == Nothing
                && probeNames "IPE_REVIEW_DB" dropped droppedMessage
                && maybeContains "lost an append-only trigger" droppedLogMessage
                && probeNames "IPE_REVIEW_DB" renamed renamedMessage
                && maybeContains "lost an append-only trigger" droppedMessage
                && maybeContains "lost an append-only trigger" renamedMessage
                && not (maybeContains "writable" droppedMessage)
            )


-- The probe's refusal message on a migrated review file at `dbPath` after
-- `edits` ran on it; Nothing when the probe passes.
probeAfterEdits : String -> List String -> Task.Task Error (Maybe String)
probeAfterEdits dbPath edits =
    do
        db <- migratedReviewAt dbPath
        Task.sequence (List.map (\sql -> Db.exec db sql []) edits)
        loc <- Settings.parseDbLocation "IPE_REVIEW_DB" dbPath
        message <- probeMessage (LibDb.probe loc)
        removeReviewFiles dbPath
        Task.succeed message


-- Re-reviewing the same pair must succeed (any Err here fails
-- the check loudly) and must keep the first decision.
isApproved : Maybe ReviewEntry -> Bool
isApproved m =
    case m of
        Just (Verified row) ->
            LibDb.verifiedDecision row == StoredApproved

        Just (Unverified _) ->
            False

        Nothing ->
            False


shortHashShown : String -> String
shortHashShown stored =
    SafeText.toString (Index.shortHash stored)


reasonShown : LibDb.Reason -> String
reasonShown reason =
    SafeText.toString (LibDb.reasonText reason)


-- `parseReason` is the only way to a refusal: blank and over-long reasons
-- have no `Reason`, the bound itself is accepted, and a stored row whose
-- reason breaks the bound still decodes, its reason shown by length only.
reasonBounded : Db -> Task.Task Error Bool
reasonBounded db =
    let
        atBound =
            String.repeat LibDb.reasonMaxChars "x"

        rejected raw =
            case LibDb.parseReason raw of
                Ok _ ->
                    False

                Err e ->
                    Error.kind e == Error.kind (Error.invalidInput "")
    in
    do
        appendSigned db (rawRow "long-uid" "hL" "refuse" (Just (atBound ++ "x")))
        verify <- countingVerifier
        storedRefused <- LibDb.findDecision verify db (uid "long-uid") "hL" |> Task.map (storedReasonShown "reason not shown: 501 characters, over the 500-character limit")
        Task.succeed
            (rejected ""
                && rejected "   "
                && rejected (atBound ++ "x")
                && rejected (atBound ++ atBound)
                && (case LibDb.parseReason atBound of
                    Ok r ->
                        String.length (reasonShown r) == LibDb.reasonMaxChars

                    Err _ ->
                        False
                )
                && storedRefused
            )


checkPair : Maybe ReviewEntry -> Maybe ReviewEntry -> Bool
checkPair approved refused =
    isApproved approved && storedReasonShown "too big" refused


-- True when the row is a refusal whose reason shows exactly as `expected`.
storedReasonShown : String -> Maybe ReviewEntry -> Bool
storedReasonShown expected found =
    case found of
        Just (Verified row) ->
            case LibDb.verifiedDecision row of
                StoredApproved ->
                    False

                StoredRefused r ->
                    SafeText.toString (LibDb.storedReasonText r) == expected

        Just (Unverified _) ->
            False

        Nothing ->
            False


decisionRoundtrip : Task.Task Error Bool
decisionRoundtrip =
    onFreshReview "ipe-review-roundtrip"
        (\db ->
            do
                insertBoth "ipe-review-roundtrip-index" db
                verify <- countingVerifier
                Task.map2 checkPair
                    (LibDb.findDecision verify db (uid "u-a") (Index.attest viewA))
                    (LibDb.findDecision verify db (uid "u-b") (Index.attest viewB))
        )


-- ── stored rows ─────────────────────────────────────────────────────────
--
-- A signed refusal whose reason breaks the bound — signed before the bound
-- — still decodes through every read of the review log, and shows its length, never its text. Red if a stored reason
-- is parsed by `parseReason` at the decode point.
storedOverlongReasonDecodes : Db -> Task.Task Error Bool
storedOverlongReasonDecodes db =
    let
        expected =
            "reason not shown: 5000 characters, over the 500-character limit"
    in
    do
        appendSigned db (rawRow "huge-uid" "hH" "refuse" (Just (String.repeat 5000 "y")))
        verify <- countingVerifier
        byPair <- LibDb.findDecision verify db (uid "huge-uid") "hH"
        byUid <- LibDb.findLatestForUid verify db (uid "huge-uid")
        Task.succeed (storedReasonShown expected byPair && storedReasonShown expected (Maybe.map Verified byUid))


-- A signed reason the log's check accepts but that is blank to the tool
-- (SQLite's `trim` strips only spaces) decodes as blank, not as a `Reason`.
storedBlankReasonDecodes : Db -> Task.Task Error Bool
storedBlankReasonDecodes db =
    do
        appendSigned db (rawRow "blank-uid" "hB" "refuse" (Just "\n\t"))
        verify <- countingVerifier
        found <- LibDb.findDecision verify db (uid "blank-uid") "hB"
        Task.succeed (storedReasonShown "reason not shown: it is blank" found)


-- History pages walked two rows at a time from the start return every
-- review-log row and then every legacy row exactly once, each table in the
-- order one unpaged query gives — ties in `reviewed_at`, one uid at two
-- hashes, and the page where the log's rows end and the legacy rows begin
-- included. Red if a page skips or repeats a row at its edge, if the walk
-- never pages, or if it never reaches the legacy rows.
historyWalkMatchesOrder : Db -> Task.Task Error Bool
historyWalkMatchesOrder db =
    let
        seeded =
            [ ( "walk-b", "h1", 7 ), ( "walk-a", "h2", 7 ), ( "walk-a", "h1", 7 ), ( "walk-c", "h1", 3 ), ( "walk-c", "h2", 3 ), ( "walk-d", "h1", 9 ), ( "walk-e", "h1", 1 ) ]

        legacy =
            [ ( "walk-f", "h1", 8 ), ( "walk-g", "h1", 2 ), ( "walk-f", "h2", 8 ) ]

        seed ( label, bodyHash, at ) =
            appendSigned db { uid = uid label, bodyHash = bodyHash, decision = "refuse", reason = Just "r", reviewedAt = at }

        seedLegacy ( label, bodyHash, at ) =
            Db.exec db "INSERT INTO review (uid, body_hash, decision, reason, reviewed_at) VALUES (?,?,?,?,?)" [ Uid.toSql (uid label), SqlString bodyHash, SqlString "refuse", SqlString "r", SqlInt at ]

        walkKey ( label, bodyHash ) =
            ( Uid.toString (uid label), bodyHash )

        walkUids =
            List.map (\( label, _, _ ) -> Uid.toString (uid label)) (seeded ++ legacy)

        keyDecoder =
            Db.Decode.succeed (\unit bodyHash -> ( unit, bodyHash ))
                |> Db.Decode.required "uid" (Db.Decode.string "uid")
                |> Db.Decode.required "body_hash" (Db.Decode.string "body_hash")
    in
    do
        Task.sequence (List.map seed seeded)
        Task.sequence (List.map seedLegacy legacy)
        verify <- countingVerifier
        walked <- Task.loop 1000 { cursor = HistoryStart, seen = [], pages = 0 } (historyWalkStep verify db)
        logged <- Db.queryDecode db "SELECT uid, body_hash FROM review_log ORDER BY reviewed_at DESC, seq DESC" [] keyDecoder
        legacyRows <- Db.queryDecode db "SELECT uid, body_hash FROM review ORDER BY reviewed_at DESC, uid, body_hash" [] keyDecoder
        Task.succeed
            (walked.seen
                == logged
                ++ legacyRows
                && walked.pages
                > 4
                && List.filter (\( unit, _ ) -> List.member unit walkUids) walked.seen
                == List.map walkKey [ ( "walk-d", "h1" ), ( "walk-a", "h1" ), ( "walk-a", "h2" ), ( "walk-b", "h1" ), ( "walk-c", "h2" ), ( "walk-c", "h1" ), ( "walk-e", "h1" ), ( "walk-f", "h1" ), ( "walk-f", "h2" ), ( "walk-g", "h1" ) ]
            )


-- A History entry's pair, whether or not it counts.
entryKey : ReviewEntry -> ( String, String )
entryKey entry =
    case entry of
        Verified row ->
            ( Uid.toString (LibDb.verifiedUid row), LibDb.verifiedHash row )

        Unverified row ->
            ( Uid.toString row.uid, row.bodyHash )


-- The state one History walk step carries: where the next page starts, the
-- keys read so far, and how many pages were read.
type alias HistoryWalk =
    { cursor : LibDb.HistoryCursor
    , seen : List ( String, String )
    , pages : Int
    }


historyWalkStep : LibDb.Verifier -> Db -> HistoryWalk -> Task.Task Error (Task.Step HistoryWalk HistoryWalk)
historyWalkStep verify db state =
    do
        size <- pageOf 2
        page <- LibDb.historyPage verify db size state.cursor
        let
            next =
                { cursor = state.cursor
                , seen = state.seen ++ List.map entryKey page.rows
                , pages = state.pages + 1
                }
        in
        case page.next of
            Nothing ->
                Task.succeed (Task.Done next)

            Just cursor ->
                Task.succeed (Task.Continue { next | cursor = cursor })


isLastHistoryPage : Maybe LibDb.HistoryCursor -> Bool
isLastHistoryPage next =
    case next of
        Nothing ->
            True

        Just _ ->
            False


-- A page size is parsed before any read: none of no rows, fewer, or past
-- the ceiling has a `PageSize`, so no page read can be asked for one. Both
-- bounds parse, and a one-row page returns at most one row.
historyPageSizeRefused : Db -> Task.Task Error Bool
historyPageSizeRefused db =
    let
        refused rows =
            case PageSize.parse rows of
                Ok _ ->
                    False

                Err e ->
                    Error.kind e == Error.kind (Error.invalidInput "")

        accepted rows =
            case PageSize.parse rows of
                Ok size ->
                    PageSize.toInt size == rows

                Err _ ->
                    False
    in
    do
        one <- pageOf 1
        verify <- countingVerifier
        onePage <- LibDb.historyPage verify db one HistoryStart
        Task.succeed
            (refused 0
                && refused (-1)
                && refused (PageSize.maxRows + 1)
                && accepted 1
                && accepted PageSize.maxRows
                && List.length onePage.rows
                <= 1
            )


-- A page of `rows` rows; a size the parser refuses fails the task.
pageOf : Int -> Task.Task Error PageSize
pageOf rows =
    Task.fromResult (PageSize.parse rows)


-- Each History state has its own text: a load in flight or a failed load
-- never reads as an empty history, and an empty later page never reads as
-- "no reviews yet".
historyStateTextsDistinct : Bool
historyStateTextsDistinct =
    let
        boom =
            Error.unexpected "boom"

        row =
            { entry = Unverified { uid = uid "u-h", bodyHash = "h", reviewedAt = Timestamp.fromUnixMillis 0, why = Legacy }, name = Nothing }

        later =
            HistoryAfter (Timestamp.fromUnixMillis 0) 1

        log =
            Signed Intact
    in
    List.all identity
        [ Queue.historyStatusText HistoryLoading == Just "Loading history…"
        , Queue.historyStatusText (HistoryFailed boom) == Just ("History load failed: " ++ Error.toString boom)
        , Queue.historyStatusText (HistoryLoaded { rows = [], at = HistoryStart, next = Nothing, log = log }) == Just "No reviews yet."
        , Queue.historyStatusText (HistoryLoaded { rows = [], at = later, next = Nothing, log = log }) == Just "No more reviews."
        , Queue.historyStatusText (HistoryLoaded { rows = [ row ], at = HistoryStart, next = Nothing, log = log }) == Nothing
        , Queue.historyStatusText (HistoryLoaded { rows = [ row ], at = later, next = Just later, log = log }) == Nothing
        ]


-- Every History page shape reads in the order of an index: the log's first
-- page scans `review_log_time` from the top and a later log page seeks into
-- it at its cursor; a legacy page seeks into `review_history_order`. None
-- sorts its table. Red without either index, or if a cursor predicate loses
-- its seekable `reviewed_at <=` bound.
historyPagesUseIndex : Db -> Task.Task Error Bool
historyPagesUseIndex db =
    let
        indexed name plan =
            List.any (String.contains ("USING INDEX " ++ name)) plan
                && not (List.any (String.contains "TEMP B-TREE") plan)
    in
    do
        first <- LibDb.historyPlan db HistoryStart
        later <- LibDb.historyPlan db (HistoryAfter (Timestamp.fromUnixMillis 5) 3)
        legacy <- LibDb.historyPlan db (HistoryLegacyAfter (Timestamp.fromUnixMillis 5) (uid "u") "h")
        Task.succeed
            (indexed "review_log_time" first
                && indexed "review_log_time" later
                && List.any (String.startsWith "SEARCH") later
                && indexed "review_history_order" legacy
                && List.any (String.startsWith "SEARCH") legacy
            )


-- A slot's load tickets: each load takes a ticket no earlier load holds, and
-- only the latest ticket settles the slot. Red if a later load could share
-- an earlier load's ticket, so a slower earlier result would replace it.
loadTicketsSettleLatest : Bool
loadTicketsSettleLatest =
    let
        first =
            Queue.nextTicket Queue.firstTicket

        second =
            Queue.nextTicket first
    in
    Queue.isCurrentLoad second second
        && not (Queue.isCurrentLoad first second)
        && not (Queue.isCurrentLoad Queue.firstTicket first)
        && not (Queue.isCurrentLoad second first)


-- A write that fails keeps its own error: a read-only connection makes a
-- new decision fail with SQLite's read-only result code (`SQLITE_READONLY`,
-- 8). A pair that already has a verified row records nothing either way:
-- it is `AlreadyDecided` or the same read-only error. Nothing is recorded
-- and the log's head does not move.
failedWritesKeepTheirError : Task.Task Error Bool
failedWritesKeepTheirError =
    freshDir "ipe-review-failed-writes" |> Task.andThen failedWritesKeepTheirErrorIn


failedWritesKeepTheirErrorIn : String -> Task.Task Error Bool
failedWritesKeepTheirErrorIn base =
    let
        dbPath =
            base ++ "/review.db"
    in
    do
        dir <- Task.fromResult (Path.fromString base)
        File.mkdirAll dir
        removeReviewFiles dbPath
        seen <- attestedFor "ipe-review-failed-writes-index" (uid "u-a")
        fresh <- attestedFor "ipe-review-failed-writes-index" (uid "u-b")
        rw <- migratedReviewAt dbPath
        key <- testMacKey
        LibDb.insertDecision key rw seen Approved
        head <- headTextOf rw
        ro <- openReadOnlyAt dbPath
        outcome <- failedWritesOutcome key rw ro seen fresh head
        removeReviewFiles dbPath
        Task.succeed outcome


failedWritesOutcome : ReviewKey.MacKey -> Db.Db -> Db.Db -> Index.Attested -> Index.Attested -> String -> Task.Task Error Bool
failedWritesOutcome key rw ro seen fresh head =
    let
        failedReadOnly task =
            task
                |> Task.map (\_ -> False)
                |> Task.onError (\e -> Task.succeed (Error.message e == readOnlyWriteError))

        recordedNothing task =
            task
                |> Task.map isAlreadyDecided
                |> Task.onError (\e -> Task.succeed (Error.message e == readOnlyWriteError))
    in
    do
        verify <- countingVerifier
        duplicate <- recordedNothing (LibDb.insertDecision key ro seen Approved)
        freshReview <- failedReadOnly (LibDb.insertDecision key ro fresh Approved)
        kept <- LibDb.findDecision verify rw (uid "u-b") (Index.attest viewB)
        headAfter <- headTextOf rw
        Task.succeed (duplicate && freshReview && not (hasDecision kept) && headAfter == head)


readOnlyWriteError : String
readOnlyWriteError =
    "db: database error [8]"


hasDecision : Maybe ReviewEntry -> Bool
hasDecision m =
    case m of
        Just _ ->
            True

        Nothing ->
            False


-- ── review history ──────────────────────────────────────────────────────
--
-- Two decisions on a scratch review db must come back on the first History
-- page with their columns, and that short page is the last one.
historyRoundtrip : Task.Task Error Bool
historyRoundtrip =
    freshDir "ipe-index-b6-history" |> Task.andThen historyRoundtripIn


historyRoundtripIn : String -> Task.Task Error Bool
historyRoundtripIn base =
    let
        reviewDb =
            base ++ "/review.db"
    in
    removeFileIfAny reviewDb
        |> Task.andThen (\_ -> Task.fromResult (Path.fromString base))
        |> Task.andThen File.mkdirAll
        |> Task.andThen (\_ -> migratedReviewAt reviewDb)
        |> Task.andThen
            (\db ->
                insertBoth "ipe-index-b6-history-index" db
                    |> Task.map (\_ -> db)
            )
        |> Task.andThen
            (\db ->
                countingVerifier
                    |> Task.andThen (\verify -> LibDb.historyPage verify db PageSize.history HistoryStart)
                    |> Task.map
                        (\page ->
                            let
                                rows =
                                    page.rows
                            in
                            isLastHistoryPage page.next
                                && List.length rows
                                == 2
                                && List.member ( uid "u-a", Nothing ) (List.map historyKey rows)
                                && List.member ( uid "u-b", Just "too big" ) (List.map historyKey rows)
                        )
            )
        |> Task.andThen
            (\ok ->
                removeFileIfAny reviewDb
                    |> Task.andThen (\_ -> removeFileIfAny (reviewDb ++ "-wal"))
                    |> Task.andThen (\_ -> removeFileIfAny (reviewDb ++ "-shm"))
                    |> Task.map (\_ -> ok)
            )


-- A History entry's uid and, for a counted refusal, its shown reason; an
-- entry that does not count shows no decision at all.
historyKey : ReviewEntry -> ( Uid, Maybe String )
historyKey entry =
    case entry of
        Verified row ->
            case LibDb.verifiedDecision row of
                StoredApproved ->
                    ( LibDb.verifiedUid row, Nothing )

                StoredRefused reason ->
                    ( LibDb.verifiedUid row, Just (SafeText.toString (LibDb.storedReasonText reason)) )

        Unverified row ->
            ( row.uid, Just "not counted" )


-- Fixture unit u-a approved and u-b refused "too big", each against the
-- `Attested` pair its seeded source re-verifies to.
insertBoth : String -> Db -> Task.Task Error Index.Written
insertBoth scratch db =
    do
        a <- attestedFor scratch (uid "u-a")
        b <- attestedFor scratch (uid "u-b")
        key <- testMacKey
        LibDb.insertDecision key db a Approved
        tooBig <- refuse "too big"
        LibDb.insertDecision key db b tooBig


-- Why a looked-up review entry does not count; Nothing when it counts or
-- no entry exists.
whyOf : Maybe ReviewEntry -> Maybe Unverified
whyOf found =
    case found of
        Just (Unverified row) ->
            Just row.why

        Just (Verified _) ->
            Nothing

        Nothing ->
            Nothing


-- True when the entry found for the pair counts.
isCounted : Maybe ReviewEntry -> Bool
isCounted found =
    case found of
        Just (Verified _) ->
            True

        Just (Unverified _) ->
            False

        Nothing ->
            False


-- The entry the counting verifier finds for a pair.
lookUp : Db -> String -> String -> Task.Task Error (Maybe ReviewEntry)
lookUp db label bodyHash =
    countingVerifier |> Task.andThen (\verify -> LibDb.findDecision verify db (uid label) bodyHash)


-- A signed refusal whose decision is flipped to an approval outside the
-- tool no longer verifies: it reads `Tampered`, and the uid has no counted
-- row. Red if the decision is left out of the row's mac input, or if a row
-- that fails its mac is counted.
flippedDecisionTampered : Db -> Task.Task Error Bool
flippedDecisionTampered db =
    do
        appendSigned db (rawRow "flip-uid" "hF" "refuse" (Just "no"))
        signed <- lookUp db "flip-uid" "hF"
        tamperLog db "UPDATE review_log SET decision = 'approve', reason = NULL WHERE seq = 1" []
        flipped <- lookUp db "flip-uid" "hF"
        verify <- countingVerifier
        latest <- LibDb.findLatestForUid verify db (uid "flip-uid")
        Task.succeed (isCounted signed && whyOf flipped == Just Tampered && latest == Nothing)


-- Every signed column is covered by the mac: an edit outside the tool of
-- the reason, the review time, the body hash or the uid each makes its row
-- read `Tampered` at the pair it now names, while each row counts as
-- written before its edit and an untouched row still counts after them all.
-- The rows are signed with the mac input spelled out in the test, so the
-- counted rows pin the tool's mac input to it: red if any one of the four
-- is left out of the mac input (no row counts as written), or if an edit
-- is not refused.
fieldEditsTampered : Db -> Task.Task Error Bool
fieldEditsTampered db =
    do
        appendSigned db (rawRow "edit-control" "h1" "refuse" (Just "first"))
        reason <- editTampers db (rawRow "edit-reason" "h1" "refuse" (Just "first")) "UPDATE review_log SET reason = 'second' WHERE uid = ?" [] "edit-reason" "h1"
        time <- editTampers db (rawRow "edit-time" "h1" "refuse" (Just "first")) "UPDATE review_log SET reviewed_at = 99 WHERE uid = ?" [] "edit-time" "h1"
        hash <- editTampers db (rawRow "edit-hash" "h1" "approve" Nothing) "UPDATE review_log SET body_hash = 'h2' WHERE uid = ?" [] "edit-hash" "h2"
        unit <- editTampers db (rawRow "edit-uid" "h1" "approve" Nothing) "UPDATE review_log SET uid = ? WHERE uid = ?" [ Uid.toSql (uid "edit-other") ] "edit-other" "h1"
        control <- lookUp db "edit-control" "h1"
        Task.succeed (reason && time && hash && unit && isCounted control)


-- `row` appended signed and counted as written, then `sql` run on it (its
-- uid bound last, after `params`); True when it then reads `Tampered` at
-- the pair `label`, `bodyHash`.
editTampers : Db -> RawRow -> String -> List SqlValue -> String -> String -> Task.Task Error Bool
editTampers db row sql params label bodyHash =
    do
        appendSigned db row
        verify <- countingVerifier
        before <- LibDb.findDecision verify db row.uid row.bodyHash
        tamperLog db sql (params ++ [ Uid.toSql row.uid ])
        after <- lookUp db label bodyHash
        Task.succeed (isCounted before && whyOf after == Just Tampered)


-- An absent reason and an empty one sign differently: changing an
-- approval's reason from NULL to the empty string outside the tool makes
-- it read `Tampered`. Red if the mac input encodes both as the same text.
emptyReasonTampered : Db -> Task.Task Error Bool
emptyReasonTampered db =
    do
        appendSigned db (rawRow "empty-uid" "hE" "approve" Nothing)
        signed <- lookUp db "empty-uid" "hE"
        tamperLog db "UPDATE review_log SET reason = '' WHERE seq = 1" []
        edited <- lookUp db "empty-uid" "hE"
        Task.succeed (isCounted signed && whyOf edited == Just Tampered)


-- A forged entry with a made-up mac, linked into the chain and with the
-- head moved to it, keeps the chain intact but never counts: it reads
-- `Tampered`, and the uid has no counted row. Red if a row is counted on
-- its chain position without its mac being verified.
forgedRowTampered : Db -> Task.Task Error Bool
forgedRowTampered db =
    let
        forged =
            String.repeat 64 "e"
    in
    do
        Db.exec db
            "INSERT INTO review_log (seq, uid, body_hash, decision, reason, reviewed_at, prev, mac) VALUES (1, ?, 'hX', 'approve', NULL, 0, 'genesis', ?)"
            [ Uid.toSql (uid "forged-uid"), SqlString forged ]
        Db.exec db "UPDATE review_log_head SET seq = 1, head = ? WHERE one = 1" [ SqlString forged ]
        head <- LibDb.currentHead db
        verdict <- LibDb.checkChainWithin db PageSize.pairs LibDb.logPageCeiling (Error.conflict "ceiling") head
        found <- lookUp db "forged-uid" "hX"
        verify <- countingVerifier
        latest <- LibDb.findLatestForUid verify db (uid "forged-uid")
        Task.succeed (verdict == Intact && whyOf found == Just Tampered && latest == Nothing)


-- A row signed by the same key for another log (another log id) does not
-- replay into this one: it reads `Tampered`, while the same row signed for
-- this log counts. The counted row pins the tool's mac input to the one the
-- test spells out, log id included: red if the log id is left out of the
-- mac input (the row signed for this log stops counting), or if the row of
-- the other log counts.
crossLogReplayTampered : Db -> Task.Task Error Bool
crossLogReplayTampered db =
    do
        appendSigned db (rawRow "replay-control" "hR" "approve" Nothing)
        control <- lookUp db "replay-control" "hR"
        appendSignedAs db "0123456789abcdef0123456789abcdef" (rawRow "replay-uid" "hR" "approve" Nothing)
        found <- lookUp db "replay-uid" "hR"
        Task.succeed (isCounted control && whyOf found == Just Tampered)


-- Three signed entries, a tamper `edit` applied to them, and the verdict of
-- the chain check up to the head.
chainAfter : Db -> List ( String, List SqlValue ) -> Task.Task Error ChainVerdict
chainAfter db edits =
    do
        appendSigned db (rawRow "chain-1" "h" "approve" Nothing)
        appendSigned db (rawRow "chain-2" "h" "approve" Nothing)
        appendSigned db (rawRow "chain-3" "h" "approve" Nothing)
        Task.sequence (List.map (\( sql, params ) -> tamperLog db sql params) edits)
        head <- LibDb.currentHead db
        LibDb.checkChainWithin db PageSize.pairs LibDb.logPageCeiling (Error.conflict "ceiling") head


-- Reordering two entries or removing a middle one breaks the chain at
-- entry 2, and under the verifier of a broken log the entry before the
-- break — whose own mac still verifies — reads `ChainBroken`, not counted.
-- Red if the walk skips a seq gap, ignores a `prev` mismatch, or if a
-- broken log still counts the rows before its break.
chainBreakUncounts : Db -> Task.Task Error Bool
chainBreakUncounts db =
    do
        verdict <- chainAfter db [ ( "DELETE FROM review_log WHERE seq = 2", [] ) ]
        key <- testReviewKey
        first <- LibDb.findDecision (LibDb.verifier key (Signed verdict)) db (uid "chain-1") "h"
        verify <- countingVerifier
        intactRead <- LibDb.findDecision verify db (uid "chain-1") "h"
        Task.succeed (verdict == BrokenAt 2 && whyOf first == Just ChainBroken && isCounted intactRead)


chainReorderBreaks : Db -> Task.Task Error Bool
chainReorderBreaks db =
    chainAfter db
        [ ( "UPDATE review_log SET seq = 100 WHERE seq = 2", [] )
        , ( "UPDATE review_log SET seq = 2 WHERE seq = 3", [] )
        , ( "UPDATE review_log SET seq = 3 WHERE seq = 100", [] )
        ]
        |> Task.map (\verdict -> verdict == BrokenAt 2)


-- A decision on a broken chain is refused with a conflict naming the entry
-- the chain breaks at, and nothing is inserted. Red if `insertDecision`
-- appends without walking the chain, or walks it and ignores a break.
decideOnBrokenChainRefused : Db -> Task.Task Error Bool
decideOnBrokenChainRefused db =
    do
        chainAfter db [ ( "DELETE FROM review_log WHERE seq = 2", [] ) ]
        before <- logRowCount db
        attested <- attestedFor "ipe-review-broken-decide-index" (uid "u-a")
        key <- testMacKey
        refused <- LibDb.insertDecision key db attested Approved
            |> Task.map (\_ -> False)
            |> Task.onError (\e -> Task.succeed (Error.kind e == Error.kind (Error.conflict "") && String.contains "chain breaks at entry 2" (Error.message e)))
        after <- logRowCount db
        Task.succeed (refused && before == 2 && after == 2)


-- Removing the log's tail and rewinding the head to the new last entry is
-- not detected — the chain is intact again — but fails closed: the earlier
-- entries still count and the removed decision is undecided, never
-- approved. Red if the rewound log stops counting its remaining entries or
-- the removed pair still reads as decided.
truncatedTailFailsClosed : Db -> Task.Task Error Bool
truncatedTailFailsClosed db =
    do
        verdict <- chainAfter db
            [ ( "DELETE FROM review_log WHERE seq = 3", [] )
            , ( "UPDATE review_log_head SET seq = 2, head = (SELECT mac FROM review_log WHERE seq = 2) WHERE one = 1", [] )
            ]
        first <- lookUp db "chain-1" "h"
        second <- lookUp db "chain-2" "h"
        removed <- lookUp db "chain-3" "h"
        Task.succeed (verdict == Intact && isCounted first && isCounted second && removed == Nothing)


-- A row of the legacy review table, written before rows were signed, reads
-- `Legacy` and does not count; deciding its pair again appends a signed
-- log entry that does. Red if a legacy row counts, or if it blocks the
-- pair from being decided again.
legacyRowRedecidable : Db -> Task.Task Error Bool
legacyRowRedecidable db =
    do
        Db.exec db "INSERT INTO review (uid, body_hash, decision, reason, reviewed_at) VALUES (?,?,?,?,?)" [ Uid.toSql (uid "u-a"), SqlString (Index.attest viewA), SqlString "approve", SqlNull (SqlString ""), SqlInt 0 ]
        legacy <- lookUp db "u-a" (Index.attest viewA)
        attested <- attestedFor "ipe-review-legacy-redecide-index" (uid "u-a")
        key <- testMacKey
        written <- LibDb.insertDecision key db attested Approved
        n <- logRowCount db
        redecided <- lookUp db "u-a" (Index.attest viewA)
        Task.succeed (whyOf legacy == Just Legacy && not (isAlreadyDecided written) && n == 1 && isCounted redecided)


reviewLogChecks : Task.Task Error (List ( String, Bool ))
reviewLogChecks =
    Task.sequence
        [ check "drain_cursor is gone after migrate" drainCursorGoneAfterMigrate
        , check "open does not migrate" openDoesNotMigrate
        , check "a duplicate attested decision is already decided" duplicateDecisionAlreadyDecided
        , check "the review log is append-only" (onFreshReview "ipe-review-reviewLogAppendOnly" reviewLogAppendOnly)
        , check "a head compare-and-set from a stale head is refused" (onFreshReview "ipe-review-concurrentHeadCasRefuses" concurrentHeadCasRefuses)
        , check "a flipped decision reads tampered" (onFreshReview "ipe-review-flippedDecisionTampered" flippedDecisionTampered)
        , check "an edit of any signed field reads tampered" (onFreshReview "ipe-review-fieldEditsTampered" fieldEditsTampered)
        , check "an absent reason made empty reads tampered" (onFreshReview "ipe-review-emptyReasonTampered" emptyReasonTampered)
        , check "a forged entry never counts" (onFreshReview "ipe-review-forgedRowTampered" forgedRowTampered)
        , check "a row replayed from another log reads tampered" (onFreshReview "ipe-review-crossLogReplayTampered" crossLogReplayTampered)
        , check "a removed entry breaks the chain and uncounts the rows before it" (onFreshReview "ipe-review-chainBreakUncounts" chainBreakUncounts)
        , check "reordered entries break the chain" (onFreshReview "ipe-review-chainReorderBreaks" chainReorderBreaks)
        , check "a decision on a broken chain is refused and inserts nothing" (onFreshReview "ipe-review-decideOnBrokenChainRefused" decideOnBrokenChainRefused)
        , check "a truncated tail fails closed" (onFreshReview "ipe-review-truncatedTailFailsClosed" truncatedTailFailsClosed)
        , check "a legacy row reads legacy and can be decided again" (onFreshReview "ipe-review-legacyRowRedecidable" legacyRowRedecidable)
        , check "a review file without its log head fails the probe" probeRefusesReviewWithoutHead
        , check "a review file without its append-only guards fails the probe" probeRefusesReviewWithoutGuards
        ]


checks : Task.Task Error (List ( String, Bool ))
checks =
    Task.map2 List.append reviewLogChecks storedRowChecks


storedRowChecks : Task.Task Error (List ( String, Bool ))
storedRowChecks =
    Task.sequence
        [ check "refusal reason is non-blank and bounded" (onFreshReview "ipe-review-reasonBounded" reasonBounded)
        , check "a stored over-long reason decodes and shows its length" (onFreshReview "ipe-review-storedOverlongReasonDecodes" storedOverlongReasonDecodes)
        , check "a stored blank reason decodes as blank" (onFreshReview "ipe-review-storedBlankReasonDecodes" storedBlankReasonDecodes)
        , check "history pages walk every row once in order" (onFreshReview "ipe-review-historyWalkMatchesOrder" historyWalkMatchesOrder)
        , check "a history page below one row is refused" (onFreshReview "ipe-review-historyPageSizeRefused" historyPageSizeRefused)
        , check "history pages read in index order" (onFreshReview "ipe-review-historyPagesUseIndex" historyPagesUseIndex)
        , Task.succeed ( "only the latest load settles a page slot", loadTicketsSettleLatest )
        , Task.succeed ( "history state texts distinguish loading/empty/failed/loaded", historyStateTextsDistinct )
        , check "decision roundtrip" decisionRoundtrip
        , Task.succeed
            ( "history shows the digest, not the scheme"
            , shortHashShown "sha256:0123456789abcdef"
                == "01234567"
                && shortHashShown "deadbeefcafe"
                == "deadbeef"
                && shortHashShown "sha256:"
                == ""
            )
        , Task.succeed
            -- A review row's hash is database text: a bidi override in it
            -- shows as an escape on the History page.
            ( "history hash renders hazards"
            , shortHashShown ("sha256:" ++ codeText 8238 ++ "ab" ++ codeText 27 ++ "c")
                == "\\u{202e}ab\\u{1b}c"
                && shortHashShown ("dead" ++ codeText 8294 ++ "beef")
                == "dead\\u{2066}bee"
            )
        , check "review history roundtrip" historyRoundtrip
        , check "failed writes keep their error" failedWritesKeepTheirError
        ]
