-- An `IPE_INDEX_DB` value carrying hazards is refused by naming the variable,
-- never by echoing the value.
dbRefusalNamesOnlyVariable : Task.Task Error Bool
dbRefusalNamesOnlyVariable =
    do
        cwd <- System.cwd ()
        System.setenv "IPE_INDEX_ROOT" cwd
        refusal <- settingsRefusal ("postgres://" ++ codeText 27 ++ "]0;pwn" ++ codeText 7 ++ "/index")
        Task.succeed
            (refusedFor "IPE_INDEX_DB" refusal
                && not (refusedFor "]0;pwn" refusal)
                && not (refusedFor "postgres://" refusal)
                && (case refusal of
                        Just message ->
                            noHazard message

                        Nothing ->
                            False
                   )
            )


settingsRefusal : String -> Task.Task Error (Maybe String)
settingsRefusal indexDb =
    System.setenv "IPE_INDEX_DB" indexDb
        |> Task.andThen (\_ -> envSettings)
        |> Task.map (\_ -> Nothing)
        |> Task.onError (\e -> Task.succeed (Just (Error.message e)))


settingsRefused : String -> String -> Task.Task Error Bool
settingsRefused indexDb reason =
    settingsRefusal indexDb |> Task.map (refusedFor reason)


-- `IPE_INDEX_DB` values that cannot name a SQLite database stop at the parse,
-- each for its own reason, and no refusal repeats the value it refused.
badIndexDbRefused : Task.Task Error Bool
badIndexDbRefused =
    do
        cwd <- System.cwd ()
        System.setenv "IPE_INDEX_ROOT" cwd
        blank <- settingsRefused "" "is empty"
        otherScheme <- settingsRefused "postgres://localhost/index" "is a URL"
        sqliteUrl <- settingsRefused "sqlite:///tmp/index.db" "is a URL"
        memoryUrl <- settingsRefused "sqlite::memory:" "is a URL"
        noSlashes <- settingsRefused "sqlite:index.db" "is a URL"
        fileNoSlashes <- settingsRefused "file:index.db" "is a URL"
        colon <- settingsRefused "/tmp/a:b.db" "cannot open as written"
        relativeColon <- settingsRefused "a:b.db" "cannot open as written"
        pathAboveRoot <- settingsRefused "/.." "root directory"
        pathDeepAboveRoot <- settingsRefused "/tmp/../../.." "root directory"
        pathRoot <- settingsRefused "/" "root directory"
        secret <- settingsRefusal "postgres://admin:s3cr3t-pw@db/index"
        Task.succeed
            (blank
                && otherScheme
                && sqliteUrl
                && memoryUrl
                && noSlashes
                && fileNoSlashes
                && colon
                && relativeColon
                && pathAboveRoot
                && pathDeepAboveRoot
                && pathRoot
                && refusedFor "IPE_INDEX_DB" secret
                && not (refusedFor "s3cr3t-pw" secret)
                && not (refusedFor "admin" secret)
            )


-- A setting is a file path made absolute once: an absolute path is kept as
-- written, a relative one joins the working directory, and a `+` is a
-- literal `+`. Both databases keep the path their refusals name.
dbSettingParsesOnce : Task.Task Error Bool
dbSettingParsesOnce =
    do
        cwd <- System.cwd ()
        absolute <- Settings.parseIndexDb "/abs/x.db"
        plus <- Settings.parseIndexDb "/t/a+b.db"
        relative <- Settings.parseIndexDb "rel.db"
        review <- Settings.parseReviewDb "/abs/review.db"
        Task.succeed
            (Path.toString absolute.path == "/abs/x.db"
                && Path.toString plus.path == "/t/a+b.db"
                && Path.toString relative.path == cwd ++ "/rel.db"
                && Path.toString review.path == "/abs/review.db"
                && Settings.dbFileName plus.path == "a+b.db"
            )


-- A file name holding `?`, `#`, `%` or `&` names that literal file: the
-- review open creates exactly it, the index read opens the same file, and no
-- file named by the text before the `?` or `#`, or by a percent-decoding,
-- appears. Red if any byte of the setting reaches the driver as URL syntax.
urlMetacharactersNameLiteralFiles : Task.Task Error Bool
urlMetacharactersNameLiteralFiles =
    do
        dir <- freshDir "ipe-settings-literal-db"
        opened <- [ "index.db?mode=ro", "index.db#x", "index%2e.db", "a&b.db" ]
                    |> List.map (literalFileOpened dir)
                    |> Task.sequence
        strays <- [ "index.db", "index..db", "index.db?mode=rwc" ]
                    |> List.map (\name -> Task.fromResult (Path.fromString (dir ++ "/" ++ name)) |> Task.andThen File.exists)
                    |> Task.sequence
        Task.succeed (List.all (\ok -> ok) opened && List.all not strays)


literalFileOpened : String -> String -> Task.Task Error Bool
literalFileOpened dir name =
    let
        file =
            dir ++ "/" ++ name
    in
    do
        review <- Settings.parseReviewDb file
        conn <- Db.open review.open
        Db.exec conn "CREATE TABLE IF NOT EXISTS literal (x INTEGER)" []
        index <- Settings.parseIndexDb file
        reader <- Db.open index.read
        present <- tableExists reader "literal"
        created <- Task.fromResult (Path.fromString file) |> Task.andThen File.exists
        Task.succeed (Path.toString review.path == file && present && created)


-- ── required resources probed before listen ─────────────────────────────
--
-- A nonexistent index file, a database that is not an index, and an
-- unwritable review location each fail their probe naming the variable and
-- the file; a seeded index passes. Red if `probe` stops opening the database
-- or stops naming the variable.
probesNameTheirVariable : Task.Task Error Bool
probesNameTheirVariable =
    do
        at <- freshScratch "ipe-index-probe"
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        good <- probeMessage (envSettings |> Task.andThen Index.probe)
        missing <- missingIndexProbed at
        notIndex <- foreignDbProbed at
        review <- reviewProbed at
        reviewDir <- reviewDirProbed at
        System.setenv "IPE_INDEX_DB" at.indexDb
        cleanupIndex at.indexDb at.repo
        Task.succeed (good == Nothing && missing && notIndex && review && reviewDir)


-- An `IPE_INDEX_ROOT` that is a directory but not the tree the index was
-- built from is refused at startup naming the variable, an indexed path and
-- the fix; the right root passes, and so does the right root with one of
-- its two indexed files deleted. Red if the startup probe stops joining an
-- indexed path under the root.
rootProbeJoinsIndexedPath : Task.Task Error Bool
rootProbeJoinsIndexedPath =
    do
        at <- freshScratch "ipe-index-root-probe"
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        good <- probeMessage (envSettings |> Task.andThen Index.probeRoot)
        removeFileIfAny (at.repo ++ "/src/Main.ipe")
        oneGone <- probeMessage (envSettings |> Task.andThen Index.probeRoot)
        empty <- freshDir "ipe-index-root-probe-empty"
        System.setenv "IPE_INDEX_ROOT" empty
        wrong <- probeMessage (envSettings |> Task.andThen Index.probeRoot)
        System.setenv "IPE_INDEX_ROOT" at.repo
        cleanupIndex at.indexDb at.repo
        Task.succeed
            (good == Nothing
                && oneGone == Nothing
                && Maybe.map (String.startsWith "IPE_INDEX_ROOT ") wrong == Just True
                && maybeContains "ipe:src/" wrong
                && maybeContains empty wrong
                && maybeContains " is not found under " wrong
                && maybeContains "repository root the index was built from" wrong
                && not (maybeContains "os error" wrong)
            )


-- A sampled index path longer than the read window is never joined and
-- reaches the root refusal only as its bounded label: the message carries
-- the truncation marker and stays far below the path's length. Red if the
-- root check reads the raw path column again.
rootProbeBoundsLongPath : Task.Task Error Bool
rootProbeBoundsLongPath =
    do
        at <- freshScratch "ipe-index-root-long"
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        execIndex at.indexDb "UPDATE units SET path = 'ipe:' || replace(hex(zeroblob(3000)), '0', 'a')" []
        long <- probeMessage (envSettings |> Task.andThen Index.probeRoot)
        cleanupIndex at.indexDb at.repo
        Task.succeed
            (Maybe.map (String.startsWith "IPE_INDEX_ROOT ") long == Just True
                && maybeContains " is not found under " long
                && maybeContains " bytes, #" long
                && Maybe.map (\message -> String.length message < 2048) long == Just True
            )


-- An index whose units all carry a tag no configured root binds is refused
-- at startup naming the configured tag, even though the root exists: none
-- of its units could be read. An index with no units passes. Red if the
-- root check samples only bound paths and passes when that sample is empty.
rootProbeRefusesUntaggedIndex : Task.Task Error Bool
rootProbeRefusesUntaggedIndex =
    do
        at <- freshScratch "ipe-index-root-untagged"
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        execIndex at.indexDb "UPDATE units SET path = 'other:' || substr(path, 5)" []
        untagged <- probeMessage (envSettings |> Task.andThen Index.probeRoot)
        execIndex at.indexDb "DELETE FROM units" []
        emptied <- probeMessage (envSettings |> Task.andThen Index.probeRoot)
        cleanupIndex at.indexDb at.repo
        Task.succeed
            (Maybe.map (String.startsWith "IPE_INDEX_DB ") untagged == Just True
                && maybeContains "no index path starts with a configured repo tag" untagged
                && maybeContains "\"ipe:\"" untagged
                && emptied == Nothing
            )


-- A nonexistent index is refused with the build hint and is not created.
missingIndexProbed : Scratch -> Task.Task Error Bool
missingIndexProbed at =
    let
        missingDb =
            at.repo ++ "/no-such-index.db"
    in
    do
        removeFileIfAny missingDb
        System.setenv "IPE_INDEX_DB" missingDb
        message <- probeMessage (envSettings |> Task.andThen Index.probe)
        created <- Task.fromResult (Path.fromString missingDb) |> Task.andThen File.exists
        Task.succeed (probeNames "IPE_INDEX_DB" missingDb message && maybeContains "no file is there" message && maybeContains "ipe-index index" message && not created)


-- A SQLite file with none of the index tables is refused.
foreignDbProbed : Scratch -> Task.Task Error Bool
foreignDbProbed at =
    let
        otherDb =
            at.repo ++ "/not-an-index.db"
    in
    do
        conn <- openFileAt CreateIfMissing otherDb
        Db.exec conn "CREATE TABLE IF NOT EXISTS other (x INTEGER)" []
        System.setenv "IPE_INDEX_DB" otherDb
        message <- probeMessage (envSettings |> Task.andThen Index.probe)
        removeFileIfAny otherDb
        Task.succeed (probeNames "IPE_INDEX_DB" otherDb message && maybeContains "lacks a table" message)


-- A review location under a missing directory is refused with its own fix.
reviewProbed : Scratch -> Task.Task Error Bool
reviewProbed at =
    let
        badReview =
            at.repo ++ "/no-such-dir/review.db"
    in
    do
        System.setenv "IPE_REVIEW_DB" badReview
        message <- probeMessage (envReview |> Task.andThen (LibDb.probe ReadOnly))
        Task.succeed (probeNames "IPE_REVIEW_DB" badReview message && maybeContains "cannot be created there" message && not (maybeContains "ipe-index index" message))


-- A review location that is a directory is refused as a directory, with the
-- fix to name a file, never as a permission the process lacks. Red if the
-- directory reads as the not-permitted refusal its open fails with.
reviewDirProbed : Scratch -> Task.Task Error Bool
reviewDirProbed at =
    let
        dirReview =
            at.repo ++ "/src"
    in
    do
        System.setenv "IPE_REVIEW_DB" dirReview
        message <- probeMessage (envReview |> Task.andThen (LibDb.probe ReadOnly))
        Task.succeed (probeNames "IPE_REVIEW_DB" dirReview message && maybeContains "it is a directory, not a database file" message && not (maybeContains "may not write it" message))


-- A database failure is classified once, by the typed `DbFailure` it carries,
-- into one refusal. With no file at the location, a cause that names no
-- narrower case of its own (`CannotOpen` and every `Unusable` row) is the
-- missing-file refusal; a cause that names its own (locked, not SQLite, not
-- permitted, missing schema) keeps it. A cause this tool names no narrower
-- case for is `Unusable`. Every `DbFailure` has its own row, so a cause left
-- out of the mapping cannot pass, and no row may refuse less than before.
-- Red if any one row of the mapping changes, or a missing file reads as
-- anything else.
dbFailuresClassified : Bool
dbFailuresClassified =
    List.all classifiedAs dbFailureRows
        && List.all classifiedAs (List.map absentRow dbFailureRows)


-- The same row with no file at the location.
absentRow : ( Bool, Db.DbFailure, Settings.DbRefusal ) -> ( Bool, Db.DbFailure, Settings.DbRefusal )
absentRow ( _, failure, expected ) =
    if failure == Db.CannotOpen || expected == Settings.Unusable then
        ( False, failure, Settings.NoDatabaseFile )

    else
        ( False, failure, expected )


-- Each cause with the refusal it names when a file is there.
dbFailureRows : List ( Bool, Db.DbFailure, Settings.DbRefusal )
dbFailureRows =
    [ ( True, Db.CannotOpen, Settings.NotPermitted )
    , ( True, Db.NotADatabase, Settings.NotSqliteFile )
    , ( True, Db.Busy, Settings.Locked )
    , ( True, Db.AccessDenied, Settings.NotPermitted )
    , ( True, Db.ReadOnlyDatabase, Settings.NotPermitted )
    , ( True, Db.InvalidStatement, Settings.MissingSchema )
    , ( True, Db.UniqueViolation, Settings.Unusable )
    , ( True, Db.ForeignKeyViolation, Settings.Unusable )
    , ( True, Db.NotNullViolation, Settings.Unusable )
    , ( True, Db.CheckViolation, Settings.Unusable )
    , ( True, Db.TriggerRaised, Settings.Unusable )
    , ( True, Db.OtherConstraint, Settings.Unusable )
    , ( True, Db.Unreachable, Settings.Unusable )
    , ( True, Db.OtherFailure, Settings.Unusable )
    ]


classifiedAs : ( Bool, Db.DbFailure, Settings.DbRefusal ) -> Bool
classifiedAs ( present, failure, expected ) =
    Settings.dbRefusalOf present (Error.withDetails (Database failure) (Error.unexpected "db failed")) == expected


-- Only the typed cause decides the refusal, never the message: an error that
-- carries no `DbFailure` is `Unusable` (`NoDatabaseFile` with no file), and a
-- message that spells another cause, or a driver code, changes nothing. Red
-- if the message is read, or an error with no `DbFailure` reads as a
-- narrower case.
dbRefusalIgnoresMessage : Bool
dbRefusalIgnoresMessage =
    Settings.dbRefusalOf True (Error.unexpected "db: database error [5]") == Settings.Unusable
        && Settings.dbRefusalOf True (Error.unexpected "db: database error [14]") == Settings.Unusable
        && Settings.dbRefusalOf True (Error.unexpected "pool timed out") == Settings.Unusable
        && Settings.dbRefusalOf False (Error.unexpected "pool timed out") == Settings.NoDatabaseFile
        && Settings.dbRefusalOf True (Error.withDetails (Custom "Busy") (Error.unexpected "db failed")) == Settings.Unusable
        && Settings.dbRefusalOf True (Error.withDetails (Database Db.OtherFailure) (Error.unexpected "db: database error [5]")) == Settings.Unusable
        && Settings.dbRefusalOf True (Error.withDetails (Database Db.CannotOpen) (Error.unexpected "pool timed out")) == Settings.NotPermitted


-- A file that is not a SQLite database is refused as one, at either
-- variable, with that database's own fix and no driver text. Red if an open
-- failure reaches the operator as the driver's message or code.
notSqliteRefused : Task.Task Error Bool
notSqliteRefused =
    do
        base <- freshDir "ipe-db-not-sqlite"
        cwd <- System.cwd ()
        writeFileText (base ++ "/index.db") "plain text, not a database\n"
        writeFileText (base ++ "/review.db") "plain text, not a database\n"
        index <- probeMessage (Settings.parseIndexSettings (base ++ "/index.db") cwd Settings.EnvUnset |> Task.andThen Index.probe)
        review <- probeMessage (Settings.parseReviewDb (base ++ "/review.db") |> Task.andThen (LibDb.probe ReadOnly))
        removeFileIfAny (base ++ "/index.db")
        removeFileIfAny (base ++ "/review.db")
        Task.succeed
            (probeNames "IPE_INDEX_DB" (base ++ "/index.db") index
                && maybeContains "not a SQLite database" index
                && maybeContains "ipe-index index" index
                && probeNames "IPE_REVIEW_DB" (base ++ "/review.db") review
                && maybeContains "not a SQLite database" review
                && maybeContains "review database this tool created" review
            )


-- Each `IPE_INDEX_DB` refusal states its problem and exactly one fix. Red if
-- a problem that carries its own fix gets the generic one appended again.
dbRefusalsStateOneFix : Task.Task Error Bool
dbRefusalsStateOneFix =
    do
        cwd <- System.cwd ()
        System.setenv "IPE_INDEX_ROOT" cwd
        refusals <- [ ""
                    , "postgres://localhost/index"
                    , "sqlite:index.db"
                    , "sqlite:///tmp/index.db?mode=rwc"
                    , "/tmp/a:b.db"
                    , "/"
                    ]
                        |> List.map settingsRefusal
                        |> Task.sequence
        Task.succeed
            (List.all
                (\refusal ->
                    case refusal of
                        Just m ->
                            List.length (String.split "; " m) == 2

                        Nothing ->
                            False
                )
                refusals
            )


-- The environment is read and parsed at startup alone. Every name that can
-- read the environment or the working directory, check a directory, or
-- parse a configured location is counted in every module of `src`, and each
-- module's count must equal its row in `admittedSites`: a new call, a
-- wrapper around an admitted one, a second import of `Ipe.System`, or a read
-- in a new module is red whatever it is spelled as or whatever variable it
-- names. Every use of `Ipe.System` is counted as `System.`, its `getenv*`
-- and `*cwd` readers again by name, and the only admitted import is the
-- exact `import Ipe.System as System`, so an alias or an `exposing` import
-- cannot dodge the count. In `Main`: the environment is read on exactly two
-- code lines — `requireEnv`'s read and `optionalEnv`'s read — and each of
-- `requireEnv` and `optionalEnv` is named only by its declaration and its
-- literal-key calls (two of `requireEnv`, three of `optionalEnv`), so no
-- wrapper can pass either a key. `Settings` exports both
-- parsers and neither the bare `indexSettings` nor `reviewDb`.
startupReadsAdmittedOnly : Task.Task Error Bool
startupReadsAdmittedOnly =
    do
        cwd <- System.cwd ()
        topNames <- readDirAt (cwd ++ "/src")
        libNames <- readDirAt (cwd ++ "/src/Lib")
        sources <- Task.sequence
                    (List.map
                        (\rel -> readLibSource (cwd ++ "/src/" ++ rel) |> Task.map (\text -> ( rel, withoutCommentLines text )))
                        (moduleFiles topNames libNames)
                    )
        settings <- readLibSource (cwd ++ "/src/Lib/Settings.ipe")
        mainSource <- readLibSource (cwd ++ "/src/Main.ipe") |> Task.map withoutCommentLines
        Task.succeed
            (layoutAdmits topNames libNames
                && List.length sources >= 12
                && sitesAdmitted sources
                && mainAdmits mainSource
                && settingsExports settings
            )


readDirAt : String -> Task.Task Error (List String)
readDirAt dir =
    Task.fromResult (Path.fromString dir) |> Task.andThen File.readDir


-- Every module of `src` by its path relative to `src`.
moduleFiles : List String -> List String -> List String
moduleFiles topNames libNames =
    List.filter (String.endsWith ".ipe") topNames
        ++ List.map (\name -> "Lib/" ++ name) (List.filter (String.endsWith ".ipe") libNames)


-- `src` holds `.ipe` modules and the `Lib` directory, and `Lib` holds only
-- `.ipe` modules, so every module is one `moduleFiles` lists. A dot-named
-- entry is admitted: no module path can pass through it.
layoutAdmits : List String -> List String -> Bool
layoutAdmits topNames libNames =
    List.member "Lib" topNames
        && List.all (\name -> name == "Lib" || String.endsWith ".ipe" name || String.startsWith "." name) topNames
        && List.all (\name -> String.endsWith ".ipe" name || String.startsWith "." name) libNames


readLibSource : String -> Task.Task Error String
readLibSource file =
    Task.fromResult (Path.fromString file)
        |> Task.andThen (\path -> File.readFileLimit path (ByteSize.kib 256))


-- The source with every whole-line comment dropped, so prose naming a
-- reader is never counted as a call.
withoutCommentLines : String -> String
withoutCommentLines source =
    String.join "\n" (List.filter (\line -> not (String.startsWith "--" (String.trimStart line))) (String.lines source))


occurrences : String -> String -> Int
occurrences needle text =
    List.length (String.split needle text) - 1


-- Each needle and, for every module admitted to name it, the exact number of
-- times its code does. A module absent from a needle's row names it zero
-- times. `System.` counts every qualified use of the module: `Main`'s two
-- `getenv`s and four `exit`s, `RepoPath`'s `cwd`, `ReviewKey`'s
-- one `getenv` of the review key. `absolute`
-- counts `Path.absolute`, which resolves against the working directory, beside
-- the message texts that name the word. `Ipe.Env` reads
-- the live environment on the native target and `Ipe.Process` can run a
-- child that prints it, so neither is admitted anywhere. `IPE_HTTP_BIND` is
-- read once, by `Main`, and parsed by `Bind.parseBind` alone, called once.
-- The bind proof rests on the runtime resolving the same value: no module
-- installs a host setting (`appWith`) or writes the environment overlay
-- (`setenv`, `unsetenv`, `loadEnv`), by any spelling of the name. The
-- server module is imported by `Main` alone, and `listen` is named only by
-- the tail of `main`, over the `Loopback` proof, and by the refusal's prose,
-- so no other module can listen through an alias or an `exposing` import.
admittedSites : List ( String, List ( String, Int ) )
admittedSites =
    [ ( "Ipe.System", [ ( "Main.ipe", 1 ), ( "Lib/RepoPath.ipe", 1 ), ( "Lib/ReviewKey.ipe", 1 ) ] )
    , ( "Ipe.Ffi", [] )
    , ( "Ipe.Env", [] )
    , ( "Ipe.Process", [] )
    , ( "System.", [ ( "Main.ipe", 6 ), ( "Lib/RepoPath.ipe", 1 ), ( "Lib/ReviewKey.ipe", 1 ) ] )
    , ( "getenv", [ ( "Main.ipe", 2 ), ( "Lib/ReviewKey.ipe", 1 ) ] )
    , ( "cwd", [ ( "Lib/RepoPath.ipe", 3 ) ] )
    , ( "isDir", [ ( "Lib/RepoPath.ipe", 6 ), ( "Lib/Settings.ipe", 1 ) ] )
    , ( "absolute", [ ( "Main.ipe", 2 ), ( "Lib/RepoPath.ipe", 5 ), ( "Lib/Index.ipe", 1 ) ] )
    , ( "absolutize", [ ( "Lib/RepoPath.ipe", 4 ), ( "Lib/Settings.ipe", 1 ) ] )
    , ( "parseRoot", [ ( "Lib/RepoPath.ipe", 3 ), ( "Lib/Settings.ipe", 1 ) ] )
    , ( "parseDbFile", [ ( "Lib/Settings.ipe", 4 ) ] )
    , ( "parseIndexSettings", [ ( "Lib/Settings.ipe", 3 ), ( "Main.ipe", 1 ) ] )
    , ( "parseReviewDb", [ ( "Lib/Settings.ipe", 3 ), ( "Main.ipe", 1 ) ] )
    , ( "readReviewKey", [ ( "Lib/ReviewKey.ipe", 3 ), ( "Main.ipe", 1 ) ] )
    , ( "parseMacKey", [ ( "Lib/ReviewKey.ipe", 4 ) ] )
    , ( "parseBind", [ ( "Lib/Bind.ipe", 3 ), ( "Main.ipe", 1 ) ] )
    , ( "IPE_HTTP_BIND", [ ( "Lib/Bind.ipe", 4 ), ( "Main.ipe", 1 ) ] )
    , ( "appWith", [] )
    , ( "setenv", [] )
    , ( "unsetenv", [] )
    , ( "loadEnv", [] )
    , ( "listen", [ ( "Main.ipe", 1 ), ( "Lib/Bind.ipe", 2 ) ] )
    , ( "Ipe.Server", [ ( "Main.ipe", 1 ) ] )
    , ( "Http.Server", [] )
    ]


admittedCount : String -> List ( String, Int ) -> Int
admittedCount rel admitted =
    case List.find (\( file, _ ) -> file == rel) admitted of
        Just ( _, count ) ->
            count

        Nothing ->
            0


-- Every module names every needle exactly as often as `admittedSites`
-- admits, every admitted module exists (a stale row is drift), and every
-- import of `Ipe.System` is the exact admitted line.
sitesAdmitted : List ( String, String ) -> Bool
sitesAdmitted sources =
    List.all
        (\( needle, admitted ) ->
            List.all (\( rel, text ) -> occurrences needle text == admittedCount rel admitted) sources
                && List.all (\( file, _ ) -> List.any (\( rel, _ ) -> rel == file) sources) admitted
        )
        admittedSites
        && List.all (\( _, text ) -> List.all systemImportAdmitted (String.lines text)) sources


systemImportAdmitted : String -> Bool
systemImportAdmitted line =
    let
        parts =
            String.words line
    in
    List.take 2 parts /= [ "import", "Ipe.System" ] || parts == [ "import", "Ipe.System", "as", "System" ]


-- The scan refuses each way around it: a reader behind an alias or an
-- `exposing` import, `getcwd` beside `cwd`, a wrapper that calls an admitted
-- parser from a request path, a reader in a module outside `src/Lib`, a
-- listen or server import outside `Main`, a listen that is not `main`'s
-- tail or not over the proof-taking `mounts`, a second listen or mount, and a
-- directory the inventory would not read. Red while the scan matches one
-- qualified spelling per reader or reads `src/Lib` alone.
startupScanRefusesEvasions : Task.Task Error Bool
startupScanRefusesEvasions =
    do
        cwd <- System.cwd ()
        topNames <- readDirAt (cwd ++ "/src")
        libNames <- readDirAt (cwd ++ "/src/Lib")
        sources <- Task.sequence
                    (List.map
                        (\rel -> readLibSource (cwd ++ "/src/" ++ rel) |> Task.map (\text -> ( rel, withoutCommentLines text )))
                        (moduleFiles topNames libNames)
                    )
        Task.succeed
            (sitesAdmitted sources
                && evaded sources "Lib/Queue.ipe" "import Ipe.System as Sys\nroot = Sys.getcwd ()"
                && evaded sources "Lib/Queue.ipe" "import Ipe.System exposing (getenvOr)\nraw = getenvOr \"X\" \"\""
                && evaded sources "Lib/RepoPath.ipe" "again = System.getcwd ()"
                && evaded sources "Lib/RepoPath.ipe" "reparse raw = parseRoot raw"
                && evaded sources "Lib/Settings.ipe" "again raw = RepoPath.absolutize raw"
                && evaded sources "Lib/Queue.ipe" "reload = Settings.parseIndexSettings"
                && evaded sources "Migrations.ipe" "import Ipe.System as System\nraw = System.getenvOr \"X\" \"\""
                && evaded sources "Lib/Index.ipe" "fresh = File.isDir"
                && evaded sources "Lib/ReviewKey.ipe" "again = System.getenv \"X\""
                && evaded sources "Lib/Queue.ipe" "rekey = ReviewKey.readReviewKey"
                && evaded sources "Lib/Index.ipe" "fresh = Path.absolute"
                && evaded sources "Lib/Queue.ipe" "import Ipe.Env as Env\nraw = Env.public \"INDEX_DB\""
                && evaded sources "Lib/Queue.ipe" "import Ipe.Process as Process\nraw = Process.run \"printenv\" []"
                && evaded sources "Lib/Queue.ipe" "again = Bind.parseBind (Settings.EnvSet \"0.0.0.0\")"
                && evaded sources "Main.ipe" "rebind = setenv \"X\" \"0.0.0.0\""
                && evaded sources "Lib/Queue.ipe" "unbind = Sys.unsetenv \"X\""
                && evaded sources "Lib/Queue.ipe" "reload = loadEnv \".env\""
                && evaded sources "Lib/Queue.ipe" "app = Web.appWith"
                && evaded sources "Lib/Queue.ipe" "rogue settings = Server.listen 8000 []"
                && evaded sources "Lib/App.ipe" "import Ipe.Http.Server as Http\nrogue = Http.mountApp"
                && evaded sources "Lib/Queue.ipe" "import Ipe.Server.Http as Http\nrogue = Http.mountApp"
                && evaded sources "Main.ipe" "rogue = listen 8000 []"
                && not (sitesAdmitted (List.filter (\( rel, _ ) -> rel /= "Lib/RepoPath.ipe") sources))
                && not (layoutAdmits ("Pages" :: topNames) libNames)
                && not (layoutAdmits topNames ("Extra" :: libNames))
                && not (systemImportAdmitted "import  Ipe.System  as  System exposing (cwd)")
                && mainAdmits (mainCode sources)
                && not (mainAdmits (mainCode sources ++ "\nreread name = requireEnv name \"\""))
                && not (mainAdmits (mainCode sources ++ "\nreread name = optionalEnv name"))
                && not (mainAdmits (String.replace "rawRepos <- optionalEnv \"IPE_INDEX_REPOS\"" "rawRepos <- Task.succeed Settings.EnvUnset" (mainCode sources)))
                && not (mainAdmits (String.replace "rawDb <- requireEnv \"IPE_INDEX_DB\" " "rawDb <- readDb " (mainCode sources) ++ "\nreadDb = requireEnv \"IPE_INDEX_DB\""))
                && not (mainAdmits (String.replace mainTail "        Server.listen 8000 [ Server.mountApp \"/\" (reviewApp settings) ]" (mainCode sources)))
                && not (mainAdmits (String.replace mainTail "        open bind settings" (mainCode sources) ++ "\nopen b s =\n    Server.listen 8000 (mounts b s)"))
                && not (mainAdmits (mainCode sources ++ "\n        Task.succeed ()"))
                && not (mainAdmits (mainCode sources ++ "\nagain = Server.listen 8000 []"))
                && not (mainAdmits (String.replace "mounts : Bind.Loopback -> Settings.AppSettings" "mounts : Settings.AppSettings" (mainCode sources)))
                && not (mainAdmits (String.replace "(reviewApp settings) ]" "(reviewApp settings), Server.mountApp \"/x\" (reviewApp settings) ]" (mainCode sources)))
                && not (mainAdmits (String.replace "        bind <- requireLoopbackBind rawBind\n" "" (mainCode sources) ++ "\nlater raw = requireLoopbackBind raw"))
            )


-- The code of `Main`, empty when the inventory has no `Main`.
mainCode : List ( String, String ) -> String
mainCode sources =
    moduleCode "Main.ipe" sources


-- The code of module `rel`, empty when the inventory has no such module.
moduleCode : String -> List ( String, String ) -> String
moduleCode rel sources =
    case List.find (\( name, _ ) -> name == rel) sources of
        Just ( _, text ) ->
            text

        Nothing ->
            ""


-- The scan refuses `sources` once `extra` is appended to module `rel`.
evaded : List ( String, String ) -> String -> String -> Bool
evaded sources rel extra =
    not (sitesAdmitted (appendTo rel extra sources))


-- `sources` with `extra` appended to the code of module `rel`.
appendTo : String -> String -> List ( String, String ) -> List ( String, String )
appendTo rel extra sources =
    List.map
        (\( name, text ) ->
            if name == rel then
                ( name, text ++ "\n" ++ extra )

            else
                ( name, text )
        )
        sources


mainAdmits : String -> Bool
mainAdmits text =
    let
        envLines =
            List.filter (String.contains "getenv") (String.lines text)
    in
    List.length envLines == 2
        && List.any (String.contains "(System.getenv key)") envLines
        && List.any (String.contains "(System.getenv key |> Task.map Settings.EnvSet)") envLines
        && occurrences "getenv" text == 2
        && occurrences "requireEnv \"" text == 2
        && occurrences "requireEnv" text == 4
        && occurrences "optionalEnv \"" text == 3
        && occurrences "optionalEnv" text == 5
        && occurrences "requireLoopbackBind" text == 3
        && occurrences "Server.listen" text == 1
        && occurrences mountsDefinition text == 1
        && occurrences "mounts" text == 3
        && occurrences "mountApp" text == 1
        && occurrences "requireSettings" text == 3
        && occurrences "parseIndexSettings" text == 1
        && occurrences "parseReviewDb" text == 1
        && List.all (\needle -> occurrences needle text == 0) [ "parseDbFile", "parseRoot", "absolutize", "isDir", "System.cwd" ]
        && mainPinned text


-- `main` opens with the bind's read and its loopback proof, then the two
-- literal-key `requireEnv` reads, the two other literal-key `optionalEnv`
-- reads, the review key's read, the settings parse and, as the block's tail,
-- the listen over the proof-consuming `mounts`, in that order, so a refused
-- bind stops startup before any other read, and a partially applied reader
-- that a request could run cannot take the place of any read.
mainPinned : String -> Bool
mainPinned text =
    case String.split "\nmain =\n    do\n" text of
        [ _, body ] ->
            case List.take 9 (String.lines body) of
                [ rawBindLine, bindLine, dbLine, rootLine, reposLine, reviewLine, keyLine, settingsLine, listenLine ] ->
                    endsBlock (List.drop 9 (String.lines body))
                        && rawBindLine == "        rawBind <- optionalEnv \"IPE_HTTP_BIND\""
                        && bindLine == "        bind <- requireLoopbackBind rawBind"
                        && String.startsWith "        rawDb <- requireEnv \"IPE_INDEX_DB\" \"" dbLine
                        && String.startsWith "        rawRoot <- requireEnv \"IPE_INDEX_ROOT\" \"" rootLine
                        && reposLine == "        rawRepos <- optionalEnv \"IPE_INDEX_REPOS\""
                        && reviewLine == "        rawReview <- optionalEnv \"IPE_REVIEW_DB\""
                        && keyLine == "        key <- requireReviewKey"
                        && settingsLine == "        settings <- requireSettings key rawDb rawRoot rawRepos rawReview"
                        && listenLine == mainTail

                _ ->
                    False

        _ ->
            False


-- `main`'s tail: the one listen, over the routes `mounts` builds.
mainTail : String
mainTail =
    "        Server.listen 8000 (mounts bind settings)"


-- The one mount list, whose `Loopback` parameter makes a listen without a
-- parsed bind fail to type-check.
mountsDefinition : String
mountsDefinition =
    "\nmounts : Bind.Loopback -> Settings.AppSettings -> List Server.Route\nmounts _loopback settings =\n    [ Server.mountApp \"/\" (reviewApp settings) ]\n"


-- True when no line of `rest` continues the block it follows: the first
-- non-blank line, if any, starts a new top-level declaration.
endsBlock : List String -> Bool
endsBlock rest =
    case List.filter (\line -> String.trim line /= "") rest of
        [] ->
            True

        next :: _ ->
            not (String.startsWith " " next)


-- True when the module header exports both parsers and neither the bare
-- `indexSettings` nor `reviewDb`.
settingsExports : String -> Bool
settingsExports source =
    case List.head (String.lines source) of
        Just header ->
            let
                names =
                    List.map (\part -> String.replace ")" "" (String.trim part)) (String.split "," header)
            in
            List.any (\name -> name == "parseIndexSettings") names
                && List.any (\name -> name == "parseReviewDb") names
                && not (List.any (\name -> name == "indexSettings" || name == "reviewDb") names)

        Nothing ->
            False


-- The startup settings never ride in session state. The session `Model` is
-- persisted, and every type it can hold is declared in a module of `src`,
-- so no `type` declaration in `src` may name a settings-carrying type except
-- the declarations that define the settings themselves (`admittedCarriers`).
-- The scan reads each declaration whole (`typeDeclarations`) and judges
-- every word by its unqualified name, so a
-- qualified or wrapped spelling (`Settings.AppSettings`,
-- `Maybe RepoPath.RootMap`) is caught alike. The `Model` is declared in
-- `src/Lib/App.ipe`; its source is scanned for the declaration, and the scan
-- must find `Model` there. Red while the `Model` holds a `settings` field.
settingsNeverInSessionState : Task.Task Error Bool
settingsNeverInSessionState =
    do
        cwd <- System.cwd ()
        topNames <- readDirAt (cwd ++ "/src")
        libNames <- readDirAt (cwd ++ "/src/Lib")
        sources <- Task.sequence
                    (List.map
                        (\rel -> readLibSource (cwd ++ "/src/" ++ rel) |> Task.map (\text -> ( rel, withoutCommentLines text )))
                        (moduleFiles topNames libNames)
                    )
        Task.succeed
            (layoutAdmits topNames libNames
                && stateAdmitted sources
                && not (stateAdmitted (withModelField sources))
                && not (stateAdmitted (appendTo "Main.ipe" "type alias Held =\n    { settings : Settings.AppSettings\n    }" sources))
                && not (stateAdmitted (appendTo "Lib/Queue.ipe" "type Held\n    = Held IndexSettings" sources))
                && not (stateAdmitted (appendTo "Lib/Index.ipe" "type alias Held =\n    { roots : Maybe RepoPath.RootMap }" sources))
                && not (stateAdmitted (appendTo "Lib/Db.ipe" "type Held\n    = Held (List Settings.ReviewFile)" sources))
                && not (stateAdmitted (appendTo "Lib/Queue.ipe" "type Held\n\t= Held IndexSettings" sources))
                && not (stateAdmitted (appendTo "Lib/Queue.ipe" "type Held\n{- note -}\n    = Held IndexSettings" sources))
                && not (stateAdmitted (appendTo "Lib/Queue.ipe" "type\tHeld\n    = Held IndexSettings" sources))
                && not (stateAdmitted (appendTo "Lib/Queue.ipe" "{- note -} type Held\n    = Held IndexSettings" sources))
                && not (stateAdmitted (appendTo "Lib/Queue.ipe" "type Held\n{- note\nend -}\n    = Held IndexSettings" sources))
                && not (stateAdmitted (List.filter (\( rel, _ ) -> rel /= "Lib/App.ipe") sources))
                && statePinned sources
                && not (statePinned (replaceIn "Main.ipe" "init : Web.WebReq -> ( Model, Cmd Msg )" "init : Web.WebReq -> ( ( Model, Settings.AppSettings ), Cmd Msg )" sources))
                && not (statePinned (replaceIn "Lib/View.ipe" "view : Model -> Ui.Element Msg" "view : ( Model, Settings.AppSettings ) -> Ui.Element Msg" sources))
                && not (statePinned (replaceIn "Main.ipe" "        , view = View.view\n" "        , view = View.view settings\n" sources))
                && not (statePinned (replaceIn "Main.ipe" "        , update = App.update settings\n" "        , update = \\msg state -> App.update settings msg state\n" sources))
                && not (statePinned (replaceIn "Lib/App.ipe" "update : Settings.AppSettings -> Msg -> Model -> ( Model, Cmd Msg )" "update : Msg -> ( Model, Settings.AppSettings ) -> ( Model, Cmd Msg )" sources))
                && not (statePinned (appendTo "Lib/Queue.ipe" "other = Web.embed" sources))
                && not (statePinned (replaceIn "Main.ipe" "reviewApp settings =\n    Web.embed\n" "reviewApp settings =\n    let\n        update = \\s msg state -> state\n    in\n    Web.embed\n" sources))
            )


-- The app's session state is `Model`: the app functions carry it by these
-- exact annotations and the one `embed` in `src`, the body of `reviewApp`
-- with no `let` that could shadow them, wires exactly these functions, so
-- the state cannot be a tuple or record that pairs `Model` with the
-- settings, which no `type` declaration would show.
statePinned : List ( String, String ) -> Bool
statePinned sources =
    let
        code =
            mainCode sources
    in
    List.all (\( rel, line ) -> List.member line (String.lines (moduleCode rel sources))) stateAnnotations
        && occurrences stateWiring code == 1
        && List.sum (List.map (\( _, text ) -> occurrences "embed" text) sources) == 1
        && List.sum (List.map (\( _, text ) -> occurrences "mountApp" text) sources) == 1


stateAnnotations : List ( String, String )
stateAnnotations =
    [ ( "Main.ipe", "init : Web.WebReq -> ( Model, Cmd Msg )" )
    , ( "Lib/App.ipe", "update : Settings.AppSettings -> Msg -> Model -> ( Model, Cmd Msg )" )
    , ( "Lib/View.ipe", "view : Model -> Ui.Element Msg" )
    , ( "Main.ipe", "subscriptions : Model -> Sub Msg" )
    ]


stateWiring : String
stateWiring =
    "reviewApp settings =\n    Web.embed\n        { init = init\n        , update = App.update settings\n        , view = View.view\n        , subscriptions = subscriptions\n"


-- `sources` with `old` replaced by `new` in the code of module `rel`.
replaceIn : String -> String -> String -> List ( String, String ) -> List ( String, String )
replaceIn rel old new sources =
    List.map
        (\( name, text ) ->
            if name == rel then
                ( name, String.replace old new text )

            else
                ( name, text )
        )
        sources


-- `sources` with a `settings` field added to the `Model` declaration of
-- `Lib.App`, the shape a session carrying the startup settings takes.
withModelField : List ( String, String ) -> List ( String, String )
withModelField sources =
    List.map
        (\( rel, text ) ->
            if rel == "Lib/App.ipe" then
                ( rel, String.replace "    { page : Page\n" "    { page : Page\n    , settings : Settings.AppSettings\n" text )

            else
                ( rel, text )
        )
        sources


-- The types that carry a configured location, by unqualified name.
settingsCarriers : List String
settingsCarriers =
    [ "AppSettings", "IndexSettings", "IndexFile", "ReviewFile", "DbLocation", "RootMap", "Root", "Binding", "Entry" ]


-- The declarations admitted to name a settings carrier: the ones that
-- define the settings, each in its own module.
admittedCarriers : List ( String, List String )
admittedCarriers =
    [ ( "Lib/Settings.ipe", [ "IndexFile", "ReviewFile", "IndexSettings", "AppSettings" ] )
    , ( "Lib/RepoPath.ipe", [ "Root", "Entry", "Binding", "RootMap" ] )
    ]


-- `Lib.App` declares a `Model`, and no declaration outside `admittedCarriers`
-- names a settings carrier.
stateAdmitted : List ( String, String ) -> Bool
stateAdmitted sources =
    List.any (\( rel, text ) -> rel == "Lib/App.ipe" && List.any (\( name, _ ) -> name == "Model") (typeDeclarations text)) sources
        && List.all
            (\( rel, text ) ->
                List.all
                    (\( name, words ) -> declarationAdmitted rel name || not (List.any namesCarrier words))
                    (typeDeclarations text)
            )
            sources


declarationAdmitted : String -> String -> Bool
declarationAdmitted rel name =
    List.any (\( file, names ) -> file == rel && List.member name names) admittedCarriers


-- A word naming a settings carrier, qualified or not.
namesCarrier : String -> Bool
namesCarrier word =
    case List.head (List.reverse (String.split "." word)) of
        Just last ->
            List.member last settingsCarriers

        Nothing ->
            False


-- A `type` declaration: its name and every word of it.
type alias Declaration =
    ( String, List String )


-- The declarations closed so far, newest first, the one being read, and
-- how many `{-` block comments are open after the last line.
type alias DeclarationScan =
    { closed : List Declaration
    , current : Maybe Declaration
    , depth : Int
    }


-- Every `type` declaration of `text`, from its `type` line up to the next
-- line that starts a top-level item: a line at column 0 that is not inside
-- or opening a block comment. A line indented by a space or a tab, a blank
-- line, and any line of a block comment continue the declaration, so a
-- comment or a tab between a declaration's head and its body cannot end the
-- scan early. A miscounted comment can only add words to a declaration or
-- start a spurious one, never drop a real one.
typeDeclarations : String -> List Declaration
typeDeclarations text =
    let
        scan =
            List.foldl declarationStep { closed = [], current = Nothing, depth = 0 } (String.lines text)
    in
    List.reverse (closeDeclaration scan.current scan.closed)


declarationStep : String -> DeclarationScan -> DeclarationScan
declarationStep line scan =
    let
        depth =
            commentDepthAfter scan.depth line
    in
    if startsDeclaration line then
        { closed = closeDeclaration scan.current scan.closed, current = Just ( declarationName line, typeWords line ), depth = depth }

    else if endsDeclaration scan.depth line then
        { closed = closeDeclaration scan.current scan.closed, current = Nothing, depth = depth }

    else
        case scan.current of
            Just ( name, words ) ->
                { closed = scan.closed, current = Just ( name, words ++ typeWords line ), depth = depth }

            Nothing ->
                { scan | depth = depth }


-- A line at column 0 holding the word `type` anywhere, so a block comment
-- before the keyword cannot hide the declaration.
startsDeclaration : String -> Bool
startsDeclaration line =
    not (indented line) && List.member "type" (String.words line)


-- A line at column 0 outside a block comment, not opening one.
endsDeclaration : Int -> String -> Bool
endsDeclaration depth line =
    depth == 0 && line /= "" && not (indented line) && not (String.startsWith "{-" line)


indented : String -> Bool
indented line =
    String.startsWith " " line || String.startsWith "\t" line


-- The open block-comment count after `line`, never below zero.
commentDepthAfter : Int -> String -> Int
commentDepthAfter depth line =
    let
        next =
            depth + occurrences "{-" line - occurrences "-}" line
    in
    if next < 0 then
        0

    else
        next


closeDeclaration : Maybe Declaration -> List Declaration -> List Declaration
closeDeclaration current closed =
    case current of
        Just declaration ->
            declaration :: closed

        Nothing ->
            closed


-- The word after `type`, or after `type alias`.
declarationName : String -> String
declarationName line =
    afterType (String.words line)
        |> List.filter (\word -> word /= "alias")
        |> List.head
        |> Maybe.withDefault ""


-- The words after the first `type`.
afterType : List String -> List String
afterType words =
    case words of
        word :: rest ->
            if word == "type" then
                rest

            else
                afterType rest

        [] ->
            []


-- The words of one declaration line, with type punctuation read as space.
typeWords : String -> List String
typeWords line =
    String.words (List.foldl (\mark text -> String.replace mark " " text) line [ "->", "{", "}", "(", ")", "[", "]", ",", ":", "|", "=" ])


-- The review key's one decode point refuses every value that is not
-- exactly 64 hex digits — one short, one long, a non-hex digit, empty, and
-- whitespace — each with the one exact `invalidInput` text, which never
-- repeats the value; a valid key in upper and in lower case is one key,
-- signing alike. Red if the length or the digit check is dropped, if the
-- refusal echoes the value, or if case changes the key.
macKeyParseRefuses : Bool
macKeyParseRefuses =
    let
        valid =
            "5c0ffee15dec1dedba5eba11c0de0f0a11c0ffee5ca1ab1e0ddba11fee1900d1"

        expected =
            "IPE_REVIEW_MAC_KEY must be exactly 64 hexadecimal characters (32 random bytes); the value set is not.\n  fix: generate one with `openssl rand -hex 32`."

        refusedExactly raw =
            case ReviewKey.parseMacKey raw of
                Ok _ ->
                    False

                Err e ->
                    Error.message e == expected
                        && Error.kind e == Error.kind (Error.invalidInput "")
                        && (String.trim raw == "" || not (String.contains raw (Error.toString e)))

        signs raw =
            Result.map (\key -> ReviewKey.sign key "message") (ReviewKey.parseMacKey raw)
    in
    List.all refusedExactly
        [ String.dropRight 1 valid
        , valid ++ "a"
        , String.dropRight 1 valid ++ "g"
        , ""
        , String.repeat 64 " "
        , " " ++ String.dropRight 1 valid
        ]
        && signs (String.toUpper valid) == signs valid
        && (case signs valid of
                Ok _ ->
                    True

                Err _ ->
                    False
           )


-- Only a `NotFound` failure reads as read-only, decided by the error's kind
-- and never its text: the runtime's unset key reads as read-only; every other
-- kind refuses with an error naming the variable and never the failure's
-- text, an `Unexpected` failure carrying the old not-set wording included.
-- Red if the kind check is replaced by a text match, if any other kind is
-- read as unset, or if `NotFound` is no longer read as unset (an unset key
-- would then refuse startup).
keyLookupFailsClosed : Task.Task Error Bool
keyLookupFailsClosed =
    do
        System.unsetenv ReviewKey.keyVar
        unset <- ReviewKey.readReviewKey
        Task.succeed
            (keyReadOnly (Ok unset)
                && keyReadOnly (ReviewKey.keyFromLookup (Err Error.notFound))
                && List.all refusesNamingVar
                    [ Error.invalidInput ("environment variable \"" ++ ReviewKey.keyVar ++ "\" is not valid unicode")
                    , Error.unexpected ("environment variable \"" ++ ReviewKey.keyVar ++ "\" is not set")
                    , Error.unexpected "environment variable \"OTHER_KEY\" is not set"
                    , Error.permissionDenied
                    ]
            )


-- A required variable's startup refusal says which way its read failed by
-- the failure's kind, never its text: `NotFound` reads as not set; every
-- other kind, an `Unexpected` failure carrying the not-set wording included,
-- reads as could not be read. Each names the variable, ends with its fix and
-- repeats no byte of the failure. Red if the refusal ignores the kind (a
-- variable set to a value that is not valid Unicode then reads as unset) or
-- echoes the failure.
requiredVarRefusalByKind : Bool
requiredVarRefusalByKind =
    let
        unset =
            EnvLookup.requiredVarRefusal "IPE_INDEX_DB" "fix: set it" Error.notFound
    in
    namesVarAndFix unset
        && String.contains "IPE_INDEX_DB is not set." unset
        && not (String.contains "could not be read" unset)
        && List.all unreadableRefusal
            [ Error.invalidInput "environment variable \"IPE_INDEX_DB\" is set to zq9, not valid Unicode"
            , Error.unexpected "environment variable \"IPE_INDEX_DB\" is not set zq9"
            , Error.withMessage "zq9" Error.permissionDenied
            ]


unreadableRefusal : Error -> Bool
unreadableRefusal failure =
    let
        refusal =
            EnvLookup.requiredVarRefusal "IPE_INDEX_DB" "fix: set it" failure
    in
    namesVarAndFix refusal
        && String.contains "IPE_INDEX_DB could not be read from the environment." refusal
        && not (String.contains "is not set" refusal)


namesVarAndFix : String -> Bool
namesVarAndFix refusal =
    String.startsWith "code-review: required environment variable IPE_INDEX_DB " refusal
        && String.endsWith "\n  fix: set it" refusal
        && not (String.contains "zq9" refusal)
        && not (String.contains "Unicode" refusal)


keyReadOnly : Result Error ReviewKey -> Bool
keyReadOnly found =
    case found of
        Ok ReadOnly ->
            True

        Ok (Signing _) ->
            False

        Err _ ->
            False


refusesNamingVar : Error -> Bool
refusesNamingVar failure =
    case ReviewKey.keyFromLookup (Err failure) of
        Ok _ ->
            False

        Err e ->
            String.contains ReviewKey.keyVar (Error.message e)
                && not (String.contains "unicode" (Error.message e))
                && not (String.contains "OTHER_KEY" (Error.message e))


-- An `IPE_INDEX_REPOS` that is set but unreadable refuses startup, naming the
-- variable; it never reads as unset, which would bind `ipe` alone. Red if the
-- unreadable value falls through to the unset branch.
reposUnreadableRefused : Task.Task Error Bool
reposUnreadableRefused =
    do
        base <- freshDir "ipe-repos-unreadable"
        cwd <- System.cwd ()
        unset <- probeMessage (Settings.parseIndexSettings (base ++ "/index.db") cwd Settings.EnvUnset |> Task.map (\_ -> ()))
        unreadable <- probeMessage (Settings.parseIndexSettings (base ++ "/index.db") cwd Settings.EnvUnreadable |> Task.map (\_ -> ()))
        Task.succeed
            (unset == Nothing
                && maybeContains "IPE_INDEX_REPOS" unreadable
                && maybeContains "not valid Unicode" unreadable
            )


-- An `IPE_REVIEW_DB` that is set but unreadable refuses startup, naming the
-- variable; only an unset one falls back to `review.db`. Red if the
-- unreadable value reads as unset and the server opens `review.db`.
reviewDbUnreadableRefused : Task.Task Error Bool
reviewDbUnreadableRefused =
    do
        unset <- Settings.valueOr "IPE_REVIEW_DB" "review.db" Settings.EnvUnset
        given <- Settings.valueOr "IPE_REVIEW_DB" "review.db" (Settings.EnvSet "/abs/review.db")
        unreadable <- probeMessage (Settings.valueOr "IPE_REVIEW_DB" "review.db" Settings.EnvUnreadable |> Task.map (\_ -> ()))
        Task.succeed
            (unset == "review.db"
                && given == "/abs/review.db"
                && maybeContains "IPE_REVIEW_DB" unreadable
                && maybeContains "not valid Unicode" unreadable
            )


-- The README's environment table lists exactly the variables the server
-- reads: every row names a variable `main` or the review key reads, and every
-- read has its row, each once. Red if a read is added without its row, or a
-- row outlives its read.
readmeEnvTableMatchesReads : Task.Task Error Bool
readmeEnvTableMatchesReads =
    do
        cwd <- System.cwd ()
        readme <- readLibSource (cwd ++ "/README.md")
        mainSource <- readLibSource (cwd ++ "/src/Main.ipe") |> Task.map withoutCommentLines
        Task.succeed
            (envTableAgrees readme mainSource
                && List.length (readmeEnvRows readme) == 6
                && not (envTableAgrees (String.replace "| `IPE_INDEX_REPOS`" "| `UNLISTED`" readme) mainSource)
                && not (envTableAgrees readme (mainSource ++ "\nextra = optionalEnv \"IPE_EXTRA\""))
                && not (envTableAgrees (readme ++ "\n| `IPE_INDEX_DB` | again |") mainSource)
            )


-- The README rows and the reads name the same variables, each once.
envTableAgrees : String -> String -> Bool
envTableAgrees readme mainSource =
    let
        documented =
            readmeEnvRows readme

        reads =
            ReviewKey.keyVar :: mainEnvReads mainSource
    in
    List.sort documented == List.sort reads && List.length (List.unique documented) == List.length documented


-- The variable each environment-table row of the README names.
readmeEnvRows : String -> List String
readmeEnvRows readme =
    String.lines readme
        |> List.filter (String.startsWith "| `IPE_")
        |> List.filterMap (\line -> List.head (List.drop 1 (String.split "`" line)))


-- The literal key of every `requireEnv` and `optionalEnv` call in `main`.
mainEnvReads : String -> List String
mainEnvReads mainSource =
    List.concatMap
        (\reader ->
            String.split (reader ++ " \"") mainSource
                |> List.drop 1
                |> List.filterMap (\chunk -> List.head (String.split "\"" chunk))
        )
        [ "requireEnv", "optionalEnv" ]


-- The bind as `parseBind` reads it, its proof shown as the address.
bindParsed : Settings.EnvValue -> Result BindRefusal String
bindParsed value =
    Result.map Bind.loopbackAddress (Bind.parseBind value)


-- Unset, exactly `127.0.0.1` and exactly `::1` are the binds accepted; unset
-- is the runtime's own default, `127.0.0.1`.
bindAcceptsLoopback : Bool
bindAcceptsLoopback =
    bindParsed Settings.EnvUnset == Ok "127.0.0.1"
        && bindParsed (Settings.EnvSet "127.0.0.1") == Ok "127.0.0.1"
        && bindParsed (Settings.EnvSet "::1") == Ok "::1"


-- Every value outside the accepted set, each refused as `NotLoopback` with
-- the value it read: exposed addresses, the other loopback spellings the
-- parser does not read as addresses, socket, bracket and scope forms,
-- hostnames, and padded or lookalike forms of the accepted two.
refusedBinds : List String
refusedBinds =
    [ "0.0.0.0"
    , "::"
    , "192.168.15.9"
    , "10.0.0.1"
    , "fe80::1"
    , "2001:db8::1"
    , "255.255.255.255"
    , "127.0.0.2"
    , "127.1.2.3"
    , "127.255.255.255"
    , "127.1"
    , "127.000.000.001"
    , "0177.0.0.1"
    , "2130706433"
    , "0:0:0:0:0:0:0:1"
    , "::0:1"
    , "::ffff:127.0.0.1"
    , "::ffff:7f00:1"
    , "[::1]"
    , "[::1]:8000"
    , "127.0.0.1:8000"
    , "::1%lo"
    , "[127.0.0.1]"
    , "localhost"
    , "LOCALHOST"
    , "localhost."
    , "ip6-localhost"
    , "evil.example"
    , " 127.0.0.1"
    , "127.0.0.1 "
    , "127.0.0.1\n"
    , "\t::1"
    , codeText 65297 ++ codeText 65298 ++ codeText 65303 ++ ".0.0.1"
    , "::1" ++ codeText 8203
    ]


bindRefusesOtherValues : Bool
bindRefusesOtherValues =
    List.length refusedBinds == 34
        && List.all (\raw -> bindParsed (Settings.EnvSet raw) == Err (NotLoopback raw)) refusedBinds


-- Set but empty is refused as empty, never read as unset, and a value that
-- cannot be read is refused as unreadable.
bindRefusesEmptyAndUnreadable : Bool
bindRefusesEmptyAndUnreadable =
    bindParsed (Settings.EnvSet "") == Err EmptyBind
        && bindParsed Settings.EnvUnreadable == Err UnreadableBind


-- The refusal's text names the variable, both accepted values and the SSH
-- tunnel, and holds no hazard.
namesBindRemedy : BindRefusal -> Bool
namesBindRemedy refusal =
    let
        shown =
            bindRefusalShown refusal
    in
    List.all (\needle -> String.contains needle shown) [ "IPE_HTTP_BIND", "127.0.0.1", "::1", "ssh -L" ]
        && noHazard shown


bindRefusalShown : BindRefusal -> String
bindRefusalShown refusal =
    SafeText.toString (Bind.refusalText refusal)


-- Every bind refusal names the variable, the two accepted values and the SSH
-- tunnel; a refused value is shown quoted, capped at 64 characters with a
-- `…` mark, and escaped; an unreadable value is never shown.
bindRefusalNamesRemedy : Bool
bindRefusalNamesRemedy =
    let
        long =
            bindRefusalShown (NotLoopback (String.repeat 10000 "a"))

        escaped =
            bindRefusalShown (NotLoopback (codeText 27 ++ "[31m"))
    in
    List.all namesBindRemedy [ EmptyBind, UnreadableBind, NotLoopback "0.0.0.0" ]
        && String.contains "\"0.0.0.0\"" (bindRefusalShown (NotLoopback "0.0.0.0"))
        && not (String.contains "\"" (bindRefusalShown UnreadableBind))
        && not (String.contains "\"" (bindRefusalShown EmptyBind))
        && String.length long < 1000
        && String.contains ("\"" ++ String.repeat 64 "a" ++ "\"…") long
        && not (String.contains (String.repeat 65 "a") long)
        && not (String.contains "…" (bindRefusalShown (NotLoopback (String.repeat 64 "a"))))
        && noHazard escaped
        && String.contains "\"\\u{1b}[31m\"" escaped


-- The rule a refused value is told it broke: it is not one of the accepted
-- spellings, which the text lists.
bindRule : String
bindRule =
    "which is not one of the accepted loopback spellings (127.0.0.1, ::1)"


-- A refusal states the accepted-spelling rule, never a claim about loopback
-- addresses in general: `127.0.0.2` is a loopback address the parser does not
-- read, so it is told the spellings, not that it is no loopback address. The
-- same text refuses an exposed address.
bindRefusalStatesRule : Bool
bindRefusalStatesRule =
    let
        loopbackOther =
            bindRefusalShown (NotLoopback "127.0.0.2")

        exposed =
            bindRefusalShown (NotLoopback "0.0.0.0")
    in
    String.contains ("IPE_HTTP_BIND is \"127.0.0.2\", " ++ bindRule) loopbackOther
        && String.contains ("IPE_HTTP_BIND is \"0.0.0.0\", " ++ bindRule) exposed
        && not (String.contains "not a loopback address" loopbackOther)
        && not (String.contains "not a loopback address" exposed)


-- The text cannot drift from the parser: there are exactly the two accepted
-- spellings, each is accepted as itself, and each appears in the refusal's
-- problem and its remedy, which lists them as `127.0.0.1 or ::1`.
bindRefusalListsAcceptedSpellings : Bool
bindRefusalListsAcceptedSpellings =
    let
        shown =
            bindRefusalShown (NotLoopback "0.0.0.0")
    in
    Bind.acceptedSpellings == [ "127.0.0.1", "::1" ]
        && List.all (\spelling -> bindParsed (Settings.EnvSet spelling) == Ok spelling) Bind.acceptedSpellings
        && List.all (\spelling -> String.contains spelling shown) Bind.acceptedSpellings
        && String.contains ("(" ++ String.join ", " Bind.acceptedSpellings ++ ")") shown
        && String.contains ("set it to " ++ String.join " or " Bind.acceptedSpellings ++ ",") shown


checks : Task.Task Error (List ( String, Bool ))
checks =
    Task.sequence
        [ check "a db file name holding url syntax names that literal file" urlMetacharactersNameLiteralFiles
        , Task.succeed ( "a review key that is not 64 hex digits is refused without echoing it", macKeyParseRefuses )
        , check "only an unset review key reads as read-only; any other read failure refuses" keyLookupFailsClosed
        , Task.succeed ( "a required variable's refusal says by kind whether it is unset or unreadable, never echoing", requiredVarRefusalByKind )
        , check "index db refusal names only the variable" dbRefusalNamesOnlyVariable
        , check "unusable index db locations refused" badIndexDbRefused
        , check "a db setting is a file path made absolute once" dbSettingParsesOnce
        , check "each db refusal states one fix" dbRefusalsStateOneFix
        , check "startup probes name the variable and the file" probesNameTheirVariable
        , Task.succeed ( "a db open failure is classified by its typed failure", dbFailuresClassified )
        , Task.succeed ( "a db refusal never reads the failure's message", dbRefusalIgnoresMessage )
        , check "a file that is not a SQLite database is refused as one" notSqliteRefused
        , check "a root holding none of the index's files is refused at startup" rootProbeJoinsIndexedPath
        , check "an index with no unit under a configured tag is refused at startup" rootProbeRefusesUntaggedIndex
        , check "a sampled index path past the read window reaches the root refusal bounded" rootProbeBoundsLongPath
        , check "the environment is read and parsed only at its startup sites" startupReadsAdmittedOnly
        , check "the startup scan refuses an aliased, wrapped or relocated reader" startupScanRefusesEvasions
        , check "no session state type carries the startup settings" settingsNeverInSessionState
        , check "an unreadable IPE_INDEX_REPOS refuses startup, never reads as unset" reposUnreadableRefused
        , check "an unreadable IPE_REVIEW_DB refuses startup, never reads as unset" reviewDbUnreadableRefused
        , check "the README env table lists exactly the variables the server reads" readmeEnvTableMatchesReads
        , Task.succeed ( "the bind is accepted only unset, exactly 127.0.0.1 or exactly ::1", bindAcceptsLoopback )
        , Task.succeed ( "every other bind spelling is refused as not loopback, naming the value read", bindRefusesOtherValues )
        , Task.succeed ( "an empty bind is refused as empty and an unreadable one as unreadable", bindRefusesEmptyAndUnreadable )
        , Task.succeed ( "a bind refusal names the variable, both accepted values and the SSH tunnel, echoing capped and escaped", bindRefusalNamesRemedy )
        , Task.succeed ( "a bind refusal states the accepted-spelling rule for 127.0.0.2 and 0.0.0.0, never that the value is no loopback address", bindRefusalStatesRule )
        , Task.succeed ( "a bind refusal lists exactly the spellings the parser accepts, each accepted as itself", bindRefusalListsAcceptedSpellings )
        ]
