-- One fixture name asked for twice yields two directories, and the second
-- seed loads its own fresh index. Red when a fixture's paths are a function of
-- its name alone: the second seed then lands where the first one's store was
-- removed, and the connection the runtime still holds for that path keeps the
-- first seed's rows, so the second insert of the same unit hits its primary key.
reseededNameGetsFreshStore : Task.Task Error Bool
reseededNameGetsFreshStore =
    do
        first <- freshScratch "ipe-index-reseed"
        seedIndex first.indexDb first.repo
        cleanupIndex first.indexDb first.repo
        second <- freshScratch "ipe-index-reseed"
        seedIndex second.indexDb second.repo
        r <- loadFirstPage
        cleanupIndex second.indexDb second.repo
        Task.succeed (first.indexDb /= second.indexDb && checkUnits r.total r.units)



-- A check whose task fails is counted as failed under its own name, the line
-- reported for it names the check and carries its error, and the check after
-- it still runs; the error's control bytes reach the line rendered, never raw.
-- Red when an error aborts the run, loses the check's name, or prints raw.
erroringCheckNamedAndCounted : Task.Task Error Bool
erroringCheckNamedAndCounted =
    freshDir "ipe-review-check-report"
        |> Task.andThen (\base -> erroringCheckReportedTo (base ++ "/report.txt"))



erroringCheckReportedTo : String -> Task.Task Error Bool
erroringCheckReportedTo out =
    do
        results <- Task.sequence (reportedProbes out)
        line <- Task.fromResult (Path.fromString out) |> Task.andThen File.readFile
        removeFileIfAny out
        Task.succeed
            (results
                == [ ( "the erroring probe", False ), ( "the probe after it", True ) ]
                && String.contains "the erroring probe" line
                && String.contains "probe-boom" line
                && not (String.contains (codeText 27) line)
            )



-- An erroring check and a passing one after it, each reporting to `out`.
reportedProbes : String -> List (Task.Task Error ( String, Bool ))
reportedProbes out =
    [ checkReporting (writeFileText out) "the erroring probe" (Task.fail (Error.unexpected ("probe-boom" ++ codeText 27)))
    , checkReporting (writeFileText out) "the probe after it" (Task.succeed True)
    ]



checks : Task.Task Error (List ( String, Bool ))
checks =
    Task.sequence
        [ check "one fixture name seeded twice gets two fresh stores" reseededNameGetsFreshStore
        , check "an erroring check is named, counted failed, and the run goes on" erroringCheckNamedAndCounted
        ]
