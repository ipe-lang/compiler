-- Every member of the runtime's `is_log_hazard` set as it stood before the
-- review-display superset: `Cc` 0x00-0x1F and 0x7F-0x9F, U+061C,
-- U+200E-U+200F, U+2028-U+202E (the separators and U+202A-U+202E),
-- U+2066-U+2069. Each stays a display hazard.
hazardMembers : List Int
hazardMembers =
    List.range 0 31
        ++ List.range 127 159
        ++ [ 1564 ]
        ++ List.range 8206 8207
        ++ List.range 8232 8238
        ++ List.range 8294 8297


-- The code point one step outside each range edge of
-- `display_hazard_vectors.json`: printable, so shown verbatim.
hazardNeighbours : List Int
hazardNeighbours =
    [ 32, 126, 161, 172, 174, 846, 848, 1535, 1542, 1563, 1565, 1756, 1758, 1806, 1808, 2191, 2194, 2273, 2275, 4446, 4449, 5759, 5761, 6067, 6070, 6154, 6160, 8191, 8208, 8231, 8240, 8286, 8304, 10239, 10241, 12287, 12289, 12643, 12645, 65023, 65040, 65278, 65280, 65439, 65441, 65519, 65532, 69820, 69822, 69836, 69838, 78895, 78912, 113823, 113828, 119154, 119163, 917503, 921600 ]


-- `render` escapes exactly the hazard set, in `scrub_log_controls`'s spelling,
-- and passes every neighbour through unchanged.
safeTextHazardTable : Bool
safeTextHazardTable =
    List.all
        (\code ->
            SafeText.isHazard (Char.fromCode code)
                && rendered (codeText code)
                /= codeText code
                && noHazard (rendered (codeText code))
                && noHazard (renderedForeign (codeText code))
        )
        hazardMembers
        && List.all
            (\code ->
                not (SafeText.isHazard (Char.fromCode code))
                    && rendered (codeText code)
                    == codeText code
                    && renderedForeign (codeText code)
                    == codeText code
            )
            hazardNeighbours
        && List.all identity
            [ rendered "\n" == "\\n"
            , rendered "\r" == "\\r"
            , rendered "\t" == "\\t"
            , rendered (codeText 0) == "\\u{0}"
            , rendered (codeText 27) == "\\u{1b}"
            , rendered (codeText 127) == "\\u{7f}"
            , rendered (codeText 159) == "\\u{9f}"
            , rendered (codeText 1564) == "\\u{61c}"
            , rendered (codeText 8238) == "\\u{202e}"
            , rendered (codeText 8297) == "\\u{2069}"
            , rendered "src/plain.ipe" == "src/plain.ipe"
            , SafeText.toString (SafeText.quoted ("a" ++ codeText 27)) == "\"a\\u{1b}\""
            ]


-- `SafeText.isHazard` holds on exactly the code points of the shared
-- `display_hazard_vectors.json`, swept over every scalar value in 4096-wide
-- blocks (surrogates have no `Char`). Red if the file is absent, holds fewer
-- than 20 ranges, or the two sets differ at any scalar.
hazardSetMatchesVectors : Task.Task Error Bool
hazardSetMatchesVectors =
    do
        cwd <- System.cwd ()
        ranges <- readCodeRanges (ipeIndexTestFile cwd "display_hazard_vectors.json")
        Task.succeed (List.length ranges >= 20 && List.all (hazardBlockMatches ranges) (List.range 0 271))


hazardBlockMatches : List ( Int, Int ) -> Int -> Bool
hazardBlockMatches ranges block =
    List.all
        (\code -> (code >= 55296 && code <= 57343) || SafeText.isHazard (Char.fromCode code) == inCodeRanges ranges code)
        (List.range (block * 4096) (block * 4096 + 4095))


-- Every endpoint and midpoint of every range of the runtime's
-- `log_hazard_ranges.json` is a display hazard. Red if the tool's set falls
-- below the runtime's log scrub, or if the file is absent or short.
logHazardsAreDisplayHazards : Task.Task Error Bool
logHazardsAreDisplayHazards =
    do
        cwd <- System.cwd ()
        ranges <- readCodeRanges (repoFile cwd "src/runtime/rust/tests/log_hazard_ranges.json")
        Task.succeed
            (List.length ranges
                >= 20
                && List.all
                    (\( lo, hi ) -> List.all (\code -> SafeText.isHazard (Char.fromCode code)) [ lo, (lo + hi) // 2, hi ])
                    ranges
            )


readCodeRanges : String -> Task.Task Error (List ( Int, Int ))
readCodeRanges file =
    do
        path <- Task.fromResult (Path.fromString file)
        text <- File.readFileLimit path (ByteSize.kib 64)
        Task.fromResult (Decode.decodeString (Decode.list codeRangeDecoder) text)


codeRangeDecoder : Decode.Decoder ( Int, Int )
codeRangeDecoder =
    Decode.map2
        (\lo hi -> ( lo, hi ))
        (Decode.field "lo" Decode.int)
        (Decode.field "hi" Decode.int)


inCodeRanges : List ( Int, Int ) -> Int -> Bool
inCodeRanges ranges code =
    List.any (\( lo, hi ) -> code >= lo && code <= hi) ranges


-- One code point per class the review-display set adds beyond the log set
-- renders as `\u{hex}` through `render`, `renderForeign` and
-- `Highlight.tokenText`; a hidden zero-width space makes `admin` look
-- different; U+0020, `é` and `✓` stay verbatim.
invisibleCodepointsRendered : Bool
invisibleCodepointsRendered =
    let
        escaped ( code, spelled ) =
            rendered (codeText code)
                == spelled
                && renderedForeign (codeText code)
                == spelled
                && SafeText.toString (Highlight.tokenText (Plain (codeText code)))
                == spelled
    in
    List.all escaped
        [ ( 173, "\\u{ad}" )
        , ( 847, "\\u{34f}" )
        , ( 4447, "\\u{115f}" )
        , ( 6068, "\\u{17b4}" )
        , ( 6155, "\\u{180b}" )
        , ( 8203, "\\u{200b}" )
        , ( 8205, "\\u{200d}" )
        , ( 8288, "\\u{2060}" )
        , ( 10240, "\\u{2800}" )
        , ( 12644, "\\u{3164}" )
        , ( 65039, "\\u{fe0f}" )
        , ( 65279, "\\u{feff}" )
        , ( 65440, "\\u{ffa0}" )
        , ( 917569, "\\u{e0041}" )
        , ( 917760, "\\u{e0100}" )
        , ( 160, "\\u{a0}" )
        , ( 12288, "\\u{3000}" )
        ]
        && rendered "admin"
        /= rendered ("admin" ++ codeText 8203)
        && List.all (\code -> rendered (codeText code) == codeText code && SafeText.toString (Highlight.tokenText (Plain (codeText code))) == codeText code) [ 32, 233, 10003 ]


-- A real hazard is an `Escaped` segment and the ASCII text spelling its
-- escape is `Verbatim`, although the flat form of the two is one string: the
-- role lives in the segment, so a page can draw the two apart.
segmentsTellEscapeFromText : Bool
segmentsTellEscapeFromText =
    List.all identity
        [ SafeText.segments (SafeText.renderForeign (codeText 8203)) == [ Escaped (Char.fromCode 8203) ]
        , SafeText.segments (SafeText.renderForeign "\\u{200b}") == [ Verbatim "\\u{200b}" ]
        , renderedForeign (codeText 8203) == renderedForeign "\\u{200b}"
        , SafeText.segments (Highlight.tokenText (Comment ("// a" ++ codeText 8238 ++ "b"))) == [ Verbatim "// a", Escaped (Char.fromCode 8238), Verbatim "b" ]
        , SafeText.segments (SafeText.render "a\\b\"") == [ Verbatim "a", Escaped '\\', Verbatim "b", Escaped '"' ]
        , SafeText.segments (SafeText.renderForeign "a\\b\"") == [ Verbatim "a\\b\"" ]
        , SafeText.segments (SafeText.concat [ SafeText.literal "x", SafeText.renderForeign "y", SafeText.literal "", SafeText.render "z" ]) == [ Verbatim "xyz" ]
        , SafeText.segments (SafeText.literal "") == []
        ]


-- Over every hazard member and every display-set neighbour, interleaved with
-- ASCII: an `Escaped` segment holds exactly a hazard, a `Verbatim` segment
-- holds none, and the segments spelled back through `escapeSpelling` give the
-- flat `renderForeign` string, whose spelling of a mixed line is pinned.
segmentsSpellRenderForeign : Bool
segmentsSpellRenderForeign =
    let
        mixed =
            String.concat (List.map (\code -> "a\\" ++ codeText code) (hazardMembers ++ hazardNeighbours))

        segs =
            SafeText.segments (SafeText.renderForeign mixed)

        roleHolds seg =
            case seg of
                Verbatim text ->
                    noHazard text && not (String.isEmpty text)

                Escaped c ->
                    SafeText.isHazard c

        spell seg =
            case seg of
                Verbatim text ->
                    text

                Escaped c ->
                    SafeText.escapeSpelling c
    in
    List.all roleHolds segs
        && List.length (List.filter isEscaped segs)
        == List.length hazardMembers
        && String.concat (List.map spell segs)
        == renderedForeign mixed
        && renderedForeign ("a" ++ codeText 8238 ++ "b\n\\" ++ codeText 9)
        == "a\\u{202e}b\\n\\\\t"


isEscaped : Segment -> Bool
isEscaped seg =
    case seg of
        Verbatim _ ->
            False

        Escaped _ ->
            True


-- `render` escapes a literal `\`, so text spelling an escape cannot pass for
-- the character it names; `renderForeign` leaves `\` alone.
backslashCannotForge : Bool
backslashCannotForge =
    List.all identity
        [ rendered "\\u{1b}" /= rendered (codeText 27)
        , rendered "\\u{1b}" == "\\\\u{1b}"
        , rendered "a\\nb" /= rendered "a\nb"
        , renderedForeign "a\\b" == "a\\b"
        , renderedForeign ("a\\" ++ codeText 27) == "a\\\\u{1b}"
        ]


-- `render` escapes `"`, so a quoted foreign value cannot close its own quotes
-- and fake a boundary in the diagnostic around it.
quoteCannotForgeBoundary : Bool
quoteCannotForgeBoundary =
    List.all identity
        [ rendered "a\"b" == "a\\\"b"
        , SafeText.toString (SafeText.quoted "x\" ok \"y") == "\"x\\\" ok \\\"y\""
        , String.contains "\"ipe:a\\\" has\"" (describeText (MissingTag (quotedLabelOf "ipe:a\" has")))
        , rendered "\\\"" /= rendered "\""
        ]


-- ── text from the index never reaches a page raw ─────────────────────────
--
-- Every displayed index column is `SafeText` from the decode point on, and
-- every source token is rendered by `Highlight.tokenText`. Red if
-- `withView` stops rendering a column (the hazard survives) or `tokenText`
-- returns the raw token.
rlo : String
rlo =
    codeText 8238


indexTextRendered : Task.Task Error Bool
indexTextRendered =
    do
        at <- freshScratch "ipe-index-safe-text"
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        execIndexUnchecked at.indexDb
            "UPDATE units SET name = ?, qualified = ?, kind = ?, facing = ?, purpose = ? WHERE uid = ?"
            [ SqlString ("an" ++ rlo ++ "swer")
            , SqlString ("Lib." ++ rlo ++ "answer")
            , SqlString ("fn" ++ codeText 27)
            , SqlString ("internal" ++ codeText 8294)
            , SqlString ("purpose" ++ codeText 8207 ++ "A")
            , Uid.toSql (uid "u-a")
            ]
        r <- loadFirstPage
        cleanupIndex at.indexDb at.repo
        Task.succeed
            (case List.find (\e -> e.uid == uid "u-a") r.units of
                Just entry ->
                    indexUnitRendered entry.unit

                Nothing ->
                    False
            )


indexUnitRendered : Index.Unit -> Bool
indexUnitRendered u =
    List.all safeShown [ u.name, u.qualified, u.kind, u.facing ]
        && (Maybe.map safeShown u.purpose == Just True)
        && labelText u.qualified
        == "Lib.\\u{202e}answer"


-- Rendered text holds no hazard and spells at least one as an escape.
safeShown : Label -> Bool
safeShown text =
    let
        shown =
            labelText text
    in
    noHazard shown && String.contains "\\u{" shown


-- A source line with bidi overrides, in every highlighter language, and a
-- link label built from such a token, show each override as an escape.
sourceTokensRendered : Bool
sourceTokensRendered =
    let
        line =
            "let ok = \"admin" ++ rlo ++ " " ++ codeText 8294 ++ "\"; // check" ++ codeText 8297 ++ " done"

        shownIn lang =
            String.concat (List.map (\tok -> SafeText.toString (Highlight.tokenText tok)) (Highlight.tokenize lang line))

        label =
            [ Links.internal (Label.fromText Label.labelCap ("Lib." ++ rlo ++ "x")) (Uid.toString (uid "u-x")) ]
                |> List.map (\l -> Label.parts (Links.label l))
    in
    List.all
        (\lang -> noHazard (shownIn lang) && String.contains "\\u{202e}" (shownIn lang) && String.contains "\\u{2066}" (shownIn lang))
        [ Highlight.Rust, Highlight.Shell, Highlight.Ipe, Highlight.Unknown ]
        && label
        == [ [ LabelText "Lib.", LabelEscapes "\\u{202e}", LabelText "x" ] ]


-- ── labels ──────────────────────────────────────────────────────────────
-- Two long paths that agree on their first 300 bytes and differ after them
-- read as different labels, though both drop the same byte count: their
-- markers' hashes differ. Red if the hash stops covering the window past
-- the cap.
labelTruncationIsInjective : Bool
labelTruncationIsInjective =
    let
        prefix =
            String.repeat 300 "a"

        one =
            labelOf (prefix ++ "b" ++ String.repeat 3795 "c")

        other =
            labelOf (prefix ++ "d" ++ String.repeat 3795 "c")
    in
    Label.key one
        /= Label.key other
        && labelText one
        /= labelText other
        && droppedBytes one
        == Just (4096 - Label.capBytes Label.labelCap)
        && droppedBytes other
        == droppedBytes one


-- A hundred adjacent NULs are one escape run, cut at the cap with a marker
-- for the rest. Red if adjacent escapes stop coalescing, one element each.
escapeRunsCoalesce : Bool
escapeRunsCoalesce =
    let
        spelling =
            SafeText.escapeSpelling (Char.fromCode 0)

        kept =
            Label.capBytes Label.labelCap // String.length spelling

        parts =
            Label.parts (labelOf (String.repeat 100 (codeText 0)))
    in
    case parts of
        [ LabelEscapes run, LabelCut dropped _ ] ->
            run == String.repeat kept spelling && dropped == 100 - kept

        _ ->
            False


-- A cap that falls inside a four-byte character drops the whole character:
-- 254 bytes of text and an emoji keep the text and count the emoji's four
-- bytes in the marker. Red if a cut splits a character.
labelCutsOnCharBoundary : Bool
labelCutsOnCharBoundary =
    let
        text =
            String.repeat 254 "a"
    in
    case Label.parts (labelOf (text ++ codeText 128512)) of
        [ LabelText shown, LabelCut dropped _ ] ->
            shown == text && dropped == 4

        _ ->
            False


-- A label within its cap shows all of it, with no marker.
shortLabelUncut : Bool
shortLabelUncut =
    Label.parts (labelOf "ipe:src/lib.rs") == [ LabelText "ipe:src/lib.rs" ]


-- A quoted label escapes `"` and `\` as `SafeText.quoted` does, so a stored
-- path cannot close the quotes the tool draws around it; the same text as a
-- plain label shows them as text. Red if the quoted parse stops escaping
-- either character, or the plain parse starts.
quotedLabelEscapesQuotes : Bool
quotedLabelEscapesQuotes =
    Label.parts (quotedLabelOf "a\"b\\c")
        == [ LabelText "a", LabelEscapes (SafeText.escapeSpelling '"'), LabelText "b", LabelEscapes (SafeText.escapeSpelling '\\'), LabelText "c" ]
        && Label.parts (labelOf "a\"b\\c")
        == [ LabelText "a\"b\\c" ]
        && labelText (quotedLabelOf "x\" ok \"y")
        == String.dropRight 1 (String.dropLeft 1 (SafeText.toString (SafeText.quoted "x\" ok \"y")))


-- A stored path dense with hazards, quoted, still draws at most
-- `elementCeiling` elements and ends in the marker for the rest. Red if the
-- quoted parse stops bounding its escape runs.
quotedLabelBounded : Bool
quotedLabelBounded =
    let
        drawn =
            Label.parts (quotedLabelOf (String.repeat 200 (codeText 27 ++ "\"a")))

        elements =
            List.length (List.filter isElement drawn)
    in
    elements
        <= Label.elementCeiling
        && droppedBytes (quotedLabelOf (String.repeat 200 (codeText 27 ++ "\"a")))
        /= Nothing
        && List.length (List.filter isElement (Label.parts (quotedLabelOf "ipe:src/lib.rs")))
        == 0


isElement : LabelPart -> Bool
isElement part =
    case part of
        LabelText _ ->
            False

        LabelEscapes _ ->
            True

        LabelCut _ _ ->
            True


-- A column is whole only when the window holds all of it: a column of
-- exactly `windowChars` characters (one-byte or two-byte) is whole, one
-- character more is not. A BLOB cell of `2 * windowChars` bytes reads its
-- window of `windowChars` bytes as hex, a text whose byte count equals the
-- whole cell's: it is still not whole. Red if `whole` trusts a cut window.
wholeOnlyWithinWindow : Bool
wholeOnlyWithinWindow =
    let
        at =
            String.repeat Label.windowChars "a"

        wide =
            String.repeat Label.windowChars "é"

        hexOfCutBlob =
            String.repeat Label.windowChars "6c"
    in
    Label.whole { shown = hexOfCutBlob, bytes = 2 * Label.windowChars }
        == Nothing
        && Label.whole (Label.columnOf at)
        == Just at
        && Label.whole (Label.columnOf wide)
        == Just wide
        && Label.whole (Label.columnOf (at ++ "a"))
        == Nothing
        && Label.whole (Label.columnOf (wide ++ "é"))
        == Nothing
        && Label.whole { shown = "a", bytes = 2 }
        == Nothing


-- A column's extent names why its window falls short: a window of
-- `windowChars` characters short of the column's bytes is cut at the
-- window; a shorter window short of them was cut at a NUL byte; a window
-- holding more bytes than the column, or wider than the window, is a BLOB's
-- hex spelling. Red if a NUL cut reads as a long column, or a hex spelling
-- as text.
extentNamesItsCause : Bool
extentNamesItsCause =
    let
        at =
            String.repeat Label.windowChars "a"
    in
    List.map (\column -> extentName (Label.extent column))
        [ Label.columnOf "ipe:src/Main.ipe"
        , Label.columnOf (at ++ "a")
        , { shown = "ipe:src/Ma", bytes = 17 }
        , { shown = "6970653a", bytes = 4 }
        , { shown = String.repeat Label.windowChars "6c", bytes = 2 * Label.windowChars }
        , { shown = at, bytes = Label.windowChars + 1 }
        ]
        == [ "whole ipe:src/Main.ipe", "window", "nul", "not text", "not text", "window" ]


extentName : ColumnExtent -> String
extentName found =
    case found of
        WholeColumn text ->
            "whole " ++ text

        CutAtWindow ->
            "window"

        CutAtNul ->
            "nul"

        NotTextCell ->
            "not text"


droppedBytes : Label -> Maybe Int
droppedBytes label =
    case List.head (List.reverse (Label.parts label)) of
        Just (LabelCut dropped _) ->
            Just dropped

        Just (LabelText _) ->
            Nothing

        Just (LabelEscapes _) ->
            Nothing

        Nothing ->
            Nothing


checks : Task.Task Error (List ( String, Bool ))
checks =
    Task.sequence
        [ Task.succeed ( "safe text escapes the log set and passes each display-set neighbour", safeTextHazardTable )
        , Task.succeed ( "every invisible code point class renders as an escape", invisibleCodepointsRendered )
        , Task.succeed ( "a real hazard is an escaped segment, the text spelling its escape is verbatim", segmentsTellEscapeFromText )
        , Task.succeed ( "segments hold their role and spell back to the flat form", segmentsSpellRenderForeign )
        , Task.succeed ( "a literal backslash cannot forge an escape", backslashCannotForge )
        , Task.succeed ( "a quote cannot forge a quoted boundary", quoteCannotForgeBoundary )
        , check "index text is rendered at the decode point" indexTextRendered
        , Task.succeed ( "source tokens and link labels render bidi visibly", sourceTokensRendered )
        , check "the hazard set equals the shared display-hazard vectors" hazardSetMatchesVectors
        , check "every runtime log hazard is a display hazard" logHazardsAreDisplayHazards
        , Task.succeed ( "two long labels sharing a prefix past the cap read differently", labelTruncationIsInjective )
        , Task.succeed ( "adjacent escapes in a label are one run", escapeRunsCoalesce )
        , Task.succeed ( "a label cut inside a character drops the whole character", labelCutsOnCharBoundary )
        , Task.succeed ( "a label within its cap shows all of it with no marker", shortLabelUncut )
        , Task.succeed ( "a quoted label escapes its quote and backslash", quotedLabelEscapesQuotes )
        , Task.succeed ( "a hazard-dense quoted label draws at most the element ceiling", quotedLabelBounded )
        , Task.succeed ( "a column is whole only within the window", wholeOnlyWithinWindow )
        , Task.succeed ( "a column's extent names why its window falls short", extentNamesItsCause )
        ]
