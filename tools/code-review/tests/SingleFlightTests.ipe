-- Every check drives `Session.step`, the step `App.update` performs for the
-- dispatch `src/Main.ipe` serves, and asserts on the session's in-flight
-- slots and on the effects each step returns: `selectedView`, the one
-- source read shared by the queue card and the unit page, `decision`, the
-- one decision, and the queue, History and standing loads. A task starts
-- only as an effect of the transition that takes its slot, so a step whose
-- effects name no task for a slot started nothing there.
-- ── driving the app ─────────────────────────────────────────────────────
-- `model` after each of `msgs` in turn through `Session.step`, recorded by
-- `TestSupport.record`; `effectsOf` reads the effects the same steps
-- return.
after : Settings.AppSettings -> List Msg -> Model -> Model
after settings msgs model =
    Tuple.first (record settings msgs model)


-- The read in flight and the unit wanted after it, if a read is in flight.
inFlight : Model -> Maybe ( Uid, Maybe Uid )
inFlight model =
    case model.selectedView of
        ViewLoading loading ->
            Just ( Slot.stampKey loading.running, loading.wanted )

        ViewShown _ ->
            Nothing

        NoneSelected ->
            Nothing

        ViewMissing _ ->
            Nothing

        ViewFailed _ _ ->
            Nothing


-- ── slots and stamps, built only by the production starts ──────────────
-- A stamp is minted only by its slot's start function, so every running
-- slot and every completion stamp below comes from a real start on an idle
-- slot. A stamp is its process's epoch and its key, so the stamp a start
-- under `epoch` of `unit` returns here is the one the model's slot holds
-- after the same start.
readingSlot : Epoch -> Uid -> SelectedView
readingSlot epoch unit =
    Tuple.first (Selected.selectView epoch unit NoneSelected)


readStamp : Epoch -> Uid -> Maybe (Stamp Uid)
readStamp epoch unit =
    Tuple.second (Selected.selectView epoch unit NoneSelected)


savingSlot : Epoch -> Uid -> DecisionSlot
savingSlot epoch unit =
    case DecisionSlot.startDecision epoch unit (DecisionIdle PanelClosed) of
        Just ( started, _ ) ->
            started

        Nothing ->
            DecisionIdle PanelClosed


refreshingSlot : Epoch -> Uid -> DecisionSlot
refreshingSlot epoch unit =
    case savingStamp epoch unit of
        Just saving ->
            Maybe.withDefault (DecisionIdle PanelClosed) (DecisionSlot.decisionWritten epoch saving (savingSlot epoch unit))

        Nothing ->
            DecisionIdle PanelClosed


savingStamp : Epoch -> Uid -> Maybe (Stamp Uid)
savingStamp epoch unit =
    Maybe.map Tuple.second (DecisionSlot.startDecision epoch unit (DecisionIdle PanelClosed))


standingReading : Epoch -> Uid -> String -> StandingRead
standingReading epoch unit bodyHash =
    Tuple.first (Standing.standingRequested epoch unit bodyHash StandingUnread)


standingStamp : Epoch -> Uid -> String -> Maybe (Stamp Standing.StandingKey)
standingStamp epoch unit bodyHash =
    Tuple.second (Standing.standingRequested epoch unit bodyHash StandingUnread)


-- The completion `done` of the task stamped `held`, as the messages to
-- send: none when no start made the stamp.
completions : (Stamp key -> result -> Msg) -> Maybe (Stamp key) -> result -> List Msg
completions done held result =
    case held of
        Just arrived ->
            [ done arrived result ]

        Nothing ->
            []


-- The stamp of a load process `epoch` starts on `slot` once its running
-- load, if any, has settled: a load of this process the slot does not
-- hold.
anotherLoad : Epoch -> want -> Slot.LoadSlot want -> Maybe (Stamp Slot.LoadTicket)
anotherLoad epoch want slot =
    let
        ( _, settled, _ ) =
            case Slot.runningLoad slot of
                Just load ->
                    Slot.loadArrived epoch load slot

                Nothing ->
                    ( Settles, slot, Nothing )
    in
    Slot.runningLoad (Tuple.first (Slot.requestLoad Slot.latestWant epoch want settled))


-- The queue's running load returned with `result`.
queueDone : Slot.LoadSlot QueueWant -> Result LoadFailure Queue.QueuePage -> List Msg
queueDone slot result =
    completions PendingLoaded (Slot.runningLoad slot) result


queueLoadedOn : Slot.LoadSlot QueueWant -> Result Error Queue.QueuePage -> List Msg
queueLoadedOn slot result =
    completions App.queueLoaded (Slot.runningLoad slot) result


historyLoadedOn : Slot.LoadSlot HistoryWant -> Result Error History.HistoryPage -> List Msg
historyLoadedOn slot result =
    completions App.historyLoaded (Slot.runningLoad slot) result


-- The read of `unit` run by process `epoch` returned with `result`.
viewDone : Epoch -> Uid -> Result LoadFailure (Maybe Index.UnitView) -> List Msg
viewDone epoch unit result =
    completions SelectedViewLoaded (readStamp epoch unit) result


viewLoadedFor : Epoch -> Uid -> Result Error (Maybe Index.UnitView) -> List Msg
viewLoadedFor epoch unit result =
    completions App.viewLoaded (readStamp epoch unit) result


-- The save of a decision on `unit` run by process `epoch` returned with
-- `result`.
decisionDone : Epoch -> Uid -> Result SaveFailure ( Index.Attested, Index.Written ) -> List Msg
decisionDone epoch unit result =
    completions DecisionSaved (savingStamp epoch unit) result


decisionSavedFor : Epoch -> Uid -> Result Error (Result DecideRefusal ( Index.Attested, Index.Written )) -> List Msg
decisionSavedFor epoch unit result =
    completions App.decisionSaved (savingStamp epoch unit) result


-- The standing read of `unit`'s body `bodyHash` run by process `epoch`
-- returned with `result`.
standingLoadedFor : Epoch -> Uid -> String -> Result Error Standing.Standing -> List Msg
standingLoadedFor epoch unit bodyHash result =
    completions App.standingLoaded (standingStamp epoch unit bodyHash) result


-- ── the effects a step returns ──────────────────────────────────────────
-- The stamp an effect carries for each slot, read by `case`, since a save's
-- effect carries its signing key and is never compared whole. Each match
-- names every constructor, so a new effect is a slot these checks place.
queueStart : Effect -> Maybe (Stamp Slot.LoadTicket)
queueStart effect =
    case effect of
        LoadQueue load _ ->
            Just load

        LoadHistory _ _ ->
            Nothing

        LoadView _ ->
            Nothing

        LoadStanding _ ->
            Nothing

        SaveDecision _ _ _ _ ->
            Nothing


historyStart : Effect -> Maybe (Stamp Slot.LoadTicket)
historyStart effect =
    case effect of
        LoadQueue _ _ ->
            Nothing

        LoadHistory load _ ->
            Just load

        LoadView _ ->
            Nothing

        LoadStanding _ ->
            Nothing

        SaveDecision _ _ _ _ ->
            Nothing


viewStart : Effect -> Maybe (Stamp Uid)
viewStart effect =
    case effect of
        LoadQueue _ _ ->
            Nothing

        LoadHistory _ _ ->
            Nothing

        LoadView read ->
            Just read

        LoadStanding _ ->
            Nothing

        SaveDecision _ _ _ _ ->
            Nothing


standingStart : Effect -> Maybe (Stamp Standing.StandingKey)
standingStart effect =
    case effect of
        LoadQueue _ _ ->
            Nothing

        LoadHistory _ _ ->
            Nothing

        LoadView _ ->
            Nothing

        LoadStanding reading ->
            Just reading

        SaveDecision _ _ _ _ ->
            Nothing


decisionStart : Effect -> Maybe (Stamp Uid)
decisionStart effect =
    case effect of
        LoadQueue _ _ ->
            Nothing

        LoadHistory _ _ ->
            Nothing

        LoadView _ ->
            Nothing

        LoadStanding _ ->
            Nothing

        SaveDecision saving _ _ _ ->
            Just saving


-- The stamp each slot's completion carries, if `msg` is that completion.
queueCompletion : Msg -> Maybe (Stamp Slot.LoadTicket)
queueCompletion msg =
    case msg of
        PendingLoaded stamped _ ->
            Just stamped

        NextPage _ ->
            Nothing

        ApproveRow _ ->
            Nothing

        RefuseStart _ ->
            Nothing

        RefuseDraft _ _ ->
            Nothing

        RefuseCancel _ ->
            Nothing

        RefuseSubmit _ ->
            Nothing

        DecisionSaved _ _ ->
            Nothing

        Navigated _ ->
            Nothing

        ShowQueue ->
            Nothing

        ShowHistory ->
            Nothing

        HistoryPageLoaded _ _ ->
            Nothing

        HistoryNext _ ->
            Nothing

        SelectedViewLoaded _ _ ->
            Nothing

        StandingLoaded _ _ ->
            Nothing

        KeyDown _ _ ->
            Nothing

        SelectUnit _ ->
            Nothing


historyCompletion : Msg -> Maybe (Stamp Slot.LoadTicket)
historyCompletion msg =
    case msg of
        PendingLoaded _ _ ->
            Nothing

        NextPage _ ->
            Nothing

        ApproveRow _ ->
            Nothing

        RefuseStart _ ->
            Nothing

        RefuseDraft _ _ ->
            Nothing

        RefuseCancel _ ->
            Nothing

        RefuseSubmit _ ->
            Nothing

        DecisionSaved _ _ ->
            Nothing

        Navigated _ ->
            Nothing

        ShowQueue ->
            Nothing

        ShowHistory ->
            Nothing

        HistoryPageLoaded stamped _ ->
            Just stamped

        HistoryNext _ ->
            Nothing

        SelectedViewLoaded _ _ ->
            Nothing

        StandingLoaded _ _ ->
            Nothing

        KeyDown _ _ ->
            Nothing

        SelectUnit _ ->
            Nothing


viewCompletion : Msg -> Maybe (Stamp Uid)
viewCompletion msg =
    case msg of
        PendingLoaded _ _ ->
            Nothing

        NextPage _ ->
            Nothing

        ApproveRow _ ->
            Nothing

        RefuseStart _ ->
            Nothing

        RefuseDraft _ _ ->
            Nothing

        RefuseCancel _ ->
            Nothing

        RefuseSubmit _ ->
            Nothing

        DecisionSaved _ _ ->
            Nothing

        Navigated _ ->
            Nothing

        ShowQueue ->
            Nothing

        ShowHistory ->
            Nothing

        HistoryPageLoaded _ _ ->
            Nothing

        HistoryNext _ ->
            Nothing

        SelectedViewLoaded stamped _ ->
            Just stamped

        StandingLoaded _ _ ->
            Nothing

        KeyDown _ _ ->
            Nothing

        SelectUnit _ ->
            Nothing


standingCompletion : Msg -> Maybe (Stamp Standing.StandingKey)
standingCompletion msg =
    case msg of
        PendingLoaded _ _ ->
            Nothing

        NextPage _ ->
            Nothing

        ApproveRow _ ->
            Nothing

        RefuseStart _ ->
            Nothing

        RefuseDraft _ _ ->
            Nothing

        RefuseCancel _ ->
            Nothing

        RefuseSubmit _ ->
            Nothing

        DecisionSaved _ _ ->
            Nothing

        Navigated _ ->
            Nothing

        ShowQueue ->
            Nothing

        ShowHistory ->
            Nothing

        HistoryPageLoaded _ _ ->
            Nothing

        HistoryNext _ ->
            Nothing

        SelectedViewLoaded _ _ ->
            Nothing

        StandingLoaded stamped _ ->
            Just stamped

        KeyDown _ _ ->
            Nothing

        SelectUnit _ ->
            Nothing


decisionCompletion : Msg -> Maybe (Stamp Uid)
decisionCompletion msg =
    case msg of
        PendingLoaded _ _ ->
            Nothing

        NextPage _ ->
            Nothing

        ApproveRow _ ->
            Nothing

        RefuseStart _ ->
            Nothing

        RefuseDraft _ _ ->
            Nothing

        RefuseCancel _ ->
            Nothing

        RefuseSubmit _ ->
            Nothing

        DecisionSaved stamped _ ->
            Just stamped

        Navigated _ ->
            Nothing

        ShowQueue ->
            Nothing

        ShowHistory ->
            Nothing

        HistoryPageLoaded _ _ ->
