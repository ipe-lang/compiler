-- Every effect `msgs` sent to `model` in turn return, in order.
effectsOf : Settings.AppSettings -> List Msg -> Model -> List Effect
effectsOf settings msgs model =
    List.concat (Tuple.second (record settings msgs model))


-- Whether every step of `msgs` sent to `model` returns no effect; vacuous
-- `msgs` count as a start.
startsNothing : Settings.AppSettings -> List Msg -> Model -> Bool
startsNothing settings msgs model =
    not (List.isEmpty msgs) && List.all List.isEmpty (Tuple.second (record settings msgs model))


-- Whether `effects` start exactly the task stamped `held` for the slot
-- `start` reads, and nothing else for it; no stamp held is no start.
startsExactly : (Effect -> Maybe (Stamp key)) -> Maybe (Stamp key) -> List Effect -> Bool
startsExactly start held effects =
    case held of
        Just stamp ->
            List.filterMap start effects == [ stamp ]

        Nothing ->
            False


-- Whether `effects` start no task for the slot `start` reads.
startsNone : (Effect -> Maybe (Stamp key)) -> List Effect -> Bool
startsNone start effects =
    List.isEmpty (List.filterMap start effects)


-- One step from `before` to `next` on `msg`, for the slot `held` reads:
-- its effects carry the slot's new running stamp exactly once when the
-- step took a stamp the slot did not hold or the slot's own completion
-- started its want, and nothing for the slot otherwise; and a slot running
-- under this process's epoch stops running only on its own completion.
slotStepHolds : Epoch -> (Model -> Maybe (Stamp key)) -> (Effect -> Maybe (Stamp key)) -> (Msg -> Maybe (Stamp key)) -> Msg -> Model -> Model -> List Effect -> Bool
slotStepHolds epoch held start completes msg before next effects =
    let
        owned =
            case completes msg of
                Just arrived ->
                    Slot.owns epoch arrived (held before)

                Nothing ->
                    False

        emitted =
            List.filterMap start effects

        wasRunning =
            Slot.running epoch (held before)

        startsOnce =
            case held next of
                Just now ->
                    if held before /= Just now || owned then
                        emitted == [ now ]

                    else
                        List.isEmpty emitted

                Nothing ->
                    List.isEmpty emitted
    in
    startsOnce && (wasRunning == Nothing || Slot.running epoch (held next) == wasRunning || owned)


-- Whether one step holds `slotStepHolds` for all five slots.
stepHolds : Settings.AppSettings -> Msg -> Model -> Model -> List Effect -> Bool
stepHolds settings msg before next effects =
    slotStepHolds settings.epoch (\m -> Slot.runningLoad m.queueLoad) queueStart queueCompletion msg before next effects
        && slotStepHolds settings.epoch (\m -> Slot.runningLoad m.historyLoad) historyStart historyCompletion msg before next effects
        && slotStepHolds settings.epoch (\m -> Selected.runningView m.selectedView) viewStart viewCompletion msg before next effects
        && slotStepHolds settings.epoch (\m -> Standing.runningStanding m.standing) standingStart standingCompletion msg before next effects
        && slotStepHolds settings.epoch (\m -> DecisionSlot.savingStamp m.decision) decisionStart decisionCompletion msg before next effects


-- Whether every step of `msgs` sent to `model` in turn holds `stepHolds`.
effectsOncePerStep : Settings.AppSettings -> List Msg -> Model -> Bool
effectsOncePerStep settings msgs model =
    let
        walked =
            List.foldl
                (\msg ( current, holds ) ->
                    let
                        ( next, effects ) =
                            Session.step settings msg current
                    in
                    ( next, holds && stepHolds settings msg current next effects )
                )
                ( model, True )
                msgs
    in
    Tuple.second walked


-- What the unit page at the model's address shows, by name.
pageTag : Model -> String
pageTag model =
    case model.page of
        UnitPage raw ->
            case Session.unitPageState raw model of
                UnitLoading ->
                    "loading"

                UnitLoaded loaded ->
                    "loaded " ++ TestSupport.uidHex loaded.unit.uid

                UnitNotFound ->
                    "not found"

                UnitFailed _ ->
                    "failed"

                UnitIdRefused ->
                    "refused"

        QueuePage ->
            "queue page"

        HistoryPage ->
            "history page"


unitAt : Uid -> Page
unitAt unit =
    UnitPage (TestSupport.uidHex unit)


queued : Index.UnitView -> Queue.QueuedUnit
queued loaded =
    { unit = loaded.unit, change = New, changed = Nothing, standing = Standing.Undecided }


queuePageOf : List Index.UnitView -> Queue.QueuePage
queuePageOf units =
    { units = List.map queued units
    , total = List.length units
    , unbound = 0
    , dbName = SafeText.literal "index.db"
    , dbBytes = 2048
    , next = Nothing
    , progress = { reviewed = 0, total = List.length units }
    , log = LibDb.ShownProven
    , refusals = []
    , refusalsOpen = 0
    , refusalsUnbound = 0
    }


-- The queue page showing `units`, the first one selected with `view`.
queueModel : List Index.UnitView -> Selected.SelectedView -> Model
queueModel units view =
    { initialModel | queueState = Loaded (queuePageOf units), selectedView = view }


initialModel : Model
initialModel =
    Session.initialModel


-- The queue page showing `units` with card `selected` showing `view`.
cardModel : List Index.UnitView -> Int -> Index.UnitView -> Model
cardModel units selected view =
    let
        shown =
            queueModel units (ViewShown view)
    in
    { shown | selected = selected }


-- A message is baked from the render it was sent from, as a browser sends
-- it. The message a control the render of `drawnFrom` draws for `unit`
-- sends; none when that render draws no decision control for the unit.
drawnOn : Model -> Uid -> (DecisionSlot.DecidableRow -> Msg) -> List Msg
drawnOn drawnFrom unit control =
    case Session.decidableRow drawnFrom unit of
        Just row ->
            [ control row ]

        Nothing ->
            []


-- `key` pressed on the render of `drawnFrom`, carrying the offers it drew.
press : Model -> String -> Msg
press drawnFrom key =
    KeyDown (Session.keyOffers drawnFrom) key


-- The render after Refuse is clicked on `unit` in the render of `drawnFrom`.
refusalOpened : Settings.AppSettings -> Model -> Uid -> Model
refusalOpened settings drawnFrom unit =
    after settings (drawnOn drawnFrom unit RefuseStart) drawnFrom


-- The message a control of the refusal panel the render of `drawnFrom`
-- draws on `unit`'s row sends, carrying the row that render's panel is
-- drawn for; none when that render draws no panel on the unit.
panelOn : Model -> Uid -> (DecisionSlot.DecidableRow -> Msg) -> List Msg
panelOn drawnFrom unit control =
    case Session.keyOffers drawnFrom of
        PanelDrawn (Just row) ->
            if DecisionSlot.rowUid row == unit then
                [ control row ]

            else
                []

        PanelDrawn Nothing ->
            []

        CardsDrawn _ ->
            []

        NothingDrawn ->
            []


-- `text` typed into the refusal panel the render of `drawnFrom` draws on
-- `unit`'s row; none when that render draws no panel on the unit.
draftOn : Model -> Uid -> String -> List Msg
draftOn drawnFrom unit text =
    panelOn drawnFrom unit (\row -> RefuseDraft row text)


-- Cancel clicked on the refusal panel the render of `drawnFrom` draws on
-- `unit`'s row; none when that render draws no panel on the unit.
cancelOn : Model -> Uid -> List Msg
cancelOn drawnFrom unit =
    panelOn drawnFrom unit RefuseCancel


-- Whether `action` is the refuse shortcut, the one that opens a panel.
startsRefusal : KeyAction card panel -> Bool
startsRefusal action =
    case action of
        RefuseSelected _ ->
            True

        ApproveSelected _ ->
            False

        Select _ ->
            False

        ConfirmRefuse _ ->
            False

        CancelRefuse _ ->
            False

        Ignore ->
            False


-- Whether the render of `model` draws an open refusal panel's controls for
-- its keys, so a key pressed on it is read on that panel's row.
panelKeysDrawn : Model -> Bool
panelKeysDrawn model =
    case Session.keyOffers model of
        PanelDrawn (Just _) ->
            True

        PanelDrawn Nothing ->
            False

        CardsDrawn _ ->
            False

        NothingDrawn ->
            False


-- Whether the render of `model` draws a decision control for `unit`, so a
-- message baked from it is not vacuous.
offers : Model -> Uid -> Bool
offers model unit =
    Session.decidableRow model unit /= Nothing


-- `loaded` under another uid, a unit the page shown does not list.
renamed : String -> Index.UnitView -> Index.UnitView
renamed label loaded =
    let
        unit =
            loaded.unit
    in
    { loaded | unit = { unit | uid = uid label } }


-- ── refusals ────────────────────────────────────────────────────────────
-- Unit-page entries made while a read is in flight start no second read: the
-- first entry holds the slot, each later one only records the unit wanted
-- after it, and the read returning starts only the latest. Red if a unit-page
-- entry reads beside the read in flight.
unitEntriesDuringReadCoalesce : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
unitEntriesDuringReadCoalesce settings a b =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        uc =
            uid "u-c"

        first =
            after settings [ Navigated (unitAt ua) ] initialModel

        entered =
            after settings [ Navigated (unitAt ub), Navigated (unitAt uc) ] first

        ( _, startedDuring ) =
            Selected.reloadView settings.epoch ub first.selectedView

        returned =
            after settings (viewDone settings.epoch ua (Ok (Just a))) entered
    in
    inFlight first == Just ( ua, Nothing )
        && startedDuring == Nothing
        && inFlight entered == Just ( ua, Just uc )
        && pageTag entered == "loading"
        && inFlight returned == Just ( uc, Nothing )
        && pageTag returned == "loading"
        && startsExactly viewStart (Selected.runningView first.selectedView) (effectsOf settings [ Navigated (unitAt ua) ] initialModel)
        && startsNone viewStart (effectsOf settings [ Navigated (unitAt ub), Navigated (unitAt uc) ] first)
        && startsExactly viewStart (Selected.runningView returned.selectedView) (effectsOf settings (viewDone settings.epoch ua (Ok (Just a))) entered)


-- The queue card and the unit page read through one slot: a unit page entered
-- while the card's read is in flight waits for it, and so does the card
-- selected after a queue load while the unit page's read is in flight. A
-- selection or key sent on the unit page reads nothing. Red if either page
-- keeps a read slot of its own.
oneReadSlotAcrossPages : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
oneReadSlotAcrossPages settings a b =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        cardReading =
            queueModel [ a, b ] (readingSlot settings.epoch ua)

        onUnitPage =
            after settings [ Navigated (unitAt ub) ] cardReading

        keysOnUnitPage =
            after settings [ SelectUnit 1, press onUnitPage "j", press onUnitPage "a" ] onUnitPage

        unitReading =
            after settings [ Navigated (unitAt ub) ] (queueModel [ a, b ] NoneSelected)

        backOnQueue =
            after settings [ Navigated QueuePage ] unitReading

        queueLoaded =
            after settings (queueDone backOnQueue.queueLoad (Ok (queuePageOf [ a, b ]))) backOnQueue
    in
    inFlight onUnitPage == Just ( ua, Just ub )
        && inFlight keysOnUnitPage == Just ( ua, Just ub )
        && keysOnUnitPage.selected == 0
        && keysOnUnitPage.decision == DecisionIdle PanelClosed
        && inFlight unitReading == Just ( ub, Nothing )
        && inFlight queueLoaded == Just ( ub, Just ua )


-- The unit page shows only a read settled for its own unit: another unit's
-- read returning, a queue load, or a late response leaves it loading, and its
-- own read settles it, missing units included. Red if the unit page shows a
-- view read for another unit, or a queue load clears its read.
unitPageSettlesOnItsOwnRead : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
unitPageSettlesOnItsOwnRead settings a b =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        uc =
            uid "u-c"

        waiting =
            after settings [ Navigated (unitAt ub) ] (queueModel [ a ] (readingSlot settings.epoch ua))

        otherReturned =
            after settings (viewDone settings.epoch ua (Ok (Just a))) waiting

        otherQueueLoad =
            anotherLoad settings.epoch (QueueReload Index.Start) otherReturned.queueLoad

        queueLoaded =
            after settings (completions PendingLoaded otherQueueLoad (Ok (queuePageOf [ a ]))) otherReturned

        ownReturned =
            after settings (viewDone settings.epoch ub (Ok (Just b))) queueLoaded

        lateOther =
            after settings (viewDone settings.epoch ua (Ok (Just a))) ownReturned

        shownElsewhere =
            { ownReturned | page = unitAt ua }

        missing =
            after settings ([ Navigated (unitAt uc) ] ++ viewDone settings.epoch uc (Ok Nothing)) ownReturned

        refused =
            after settings [ Navigated (UnitPage "not-a-unit-id") ] ownReturned
    in
    pageTag waiting == "loading"
        && pageTag otherReturned == "loading"
        && otherQueueLoad /= Nothing
        && inFlight queueLoaded == Just ( ub, Nothing )
        && pageTag ownReturned == ("loaded " ++ TestSupport.uidHex ub)
        && pageTag lateOther == ("loaded " ++ TestSupport.uidHex ub)
        && pageTag shownElsewhere == "loading"
        && pageTag missing == "not found"
        && pageTag refused == "refused"


-- One decision is in flight per session: a decision asked, by button or key,
-- while one is saving starts nothing and leaves the saving one's pending
-- state; a refusal asked then opens no panel, so no draft can be submitted.
-- A save that failed leaves its notice, and the next decision starts and
-- drops it. Red if a second decision, with its source re-read, starts beside
-- the first.
decisionsSingleFlight : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
decisionsSingleFlight settings a b =
    let
        ua =
            a.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        saving =
            after settings (drawnOn shown ua ApproveRow) shown

        pressedAgain =
            after settings (drawnOn shown ua ApproveRow ++ [ press saving "a" ]) saving

        refusing =
            after settings (drawnOn shown ua RefuseStart ++ draftOn (refusalOpened settings shown ua) ua "needs a test" ++ drawnOn shown ua RefuseSubmit) saving

        settled =
            after settings (decisionSavedFor settings.epoch ua (Err (Error.conflict "boom"))) pressedAgain

        next =
            after settings (drawnOn settled ua ApproveRow) settled

        lateOther =
            after settings (decisionSavedFor settings.epoch b.unit.uid (Err (Error.conflict "boom"))) next
    in
    offers shown ua
        && offers settled ua
        && DecisionSlot.startDecision settings.epoch ua (savingSlot settings.epoch ua) == Nothing
        && saving.decision == savingSlot settings.epoch ua
        && pressedAgain.decision == savingSlot settings.epoch ua
        && refusing.decision == savingSlot settings.epoch ua
        && DecisionSlot.openPanel refusing.decision == Nothing
        && DecisionSlot.notSavedOf settled.decision == Just SaveFailed
        && next.decision == savingSlot settings.epoch ua
        && lateOther.decision == savingSlot settings.epoch ua
        && startsExactly decisionStart (DecisionSlot.savingStamp saving.decision) (effectsOf settings (drawnOn shown ua ApproveRow) shown)
        && startsNothing settings (drawnOn shown ua ApproveRow ++ [ press saving "a" ]) saving
        && startsNothing settings (drawnOn shown ua RefuseStart ++ draftOn (refusalOpened settings shown ua) ua "needs a test" ++ drawnOn shown ua RefuseSubmit) saving
        && startsExactly decisionStart (DecisionSlot.savingStamp next.decision) (effectsOf settings (drawnOn settled ua ApproveRow) settled)
        && startsNothing settings (decisionSavedFor settings.epoch b.unit.uid (Err (Error.conflict "boom"))) next


-- The refusal panel opens only on an idle slot, through the busy check a
-- decision start makes: a refusal asked by key or button while a decision
-- is saving leaves the slot as it was, and the rows show the pending state
-- alone, with no reason field or Confirm. A cancel while busy leaves the
-- busy decision. A decision started in another tab closes an open panel; an
-- approval of a row the page offers no decision on is refused before it
-- takes the slot and keeps the panel and its draft; a submit for a row the
-- panel is not open on decides nothing and keeps the draft; a queue load
-- closes the panel. Red if a panel can be open beside a busy decision, or a
-- click or submit for a row other than the panel's discards its draft.
refusalPanelLivesInIdleSlot : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Index.RefusalRow -> Bool
refusalPanelLivesInIdleSlot settings a b file =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        saving =
            after settings (drawnOn shown ua ApproveRow) shown

        keyed =
            after settings [ press saving "r" ] saving

        cancelled =
            after settings (cancelOn (refusalOpened settings shown ua) ua ++ [ press saving "Escape" ]) saving

        secondShown =
            cardModel [ a, b ] 1 b

        otherSaving =
            { secondShown | decision = savingSlot settings.epoch ua }

        otherRefused =
            after settings (drawnOn secondShown ub RefuseStart) otherSaving

        opened =
            after settings (drawnOn shown ua RefuseStart ++ draftOn (refusalOpened settings shown ua) ua "needs a test") shown

        draft =
            { refuseDraft = Draft.draft "needs a test", refuseError = Nothing }

        elsewhere =
            after settings (drawnOn secondShown ub ApproveRow) opened

        strayUnit =
            after settings (drawnOn secondShown ub RefuseSubmit) opened

        strayFile =
            after settings (drawnOn (withRefusal file shown) file.uid RefuseSubmit) opened

        reloading =
            after settings [ Navigated QueuePage ] opened

        reloaded =
            after settings (queueDone reloading.queueLoad (Ok (queuePageOf [ a, b ]))) reloading
    in
    offers shown ua
        && offers secondShown ub
        && offers (withRefusal file shown) file.uid
        && startsRefusal (Keys.keyAction (Session.keyMode (Session.keyOffers saving) saving) "r")
        && keyed == saving
        && keyed.decision == savingSlot settings.epoch ua
        && String.contains "Saving the decision…" (page keyed)
        && not (panelDrawn (page keyed))
        && cancelled.decision == savingSlot settings.epoch ua
        && otherRefused == otherSaving
        && String.contains "Another decision is saving…" (page otherRefused)
        && not (panelDrawn (page otherRefused))
        && DecisionSlot.openPanel opened.decision == Just ( ua, draft )
        && panelDrawn (page opened)
        && DecisionSlot.notSavedOf elsewhere.decision == Just (SaveRefused SourceNotShown)
        && DecisionSlot.openPanel elsewhere.decision == Just ( ua, draft )
        && strayUnit == opened
        && strayFile == opened
        && DecisionSlot.openPanel reloading.decision == Just ( ua, draft )
        && DecisionSlot.openPanel reloaded.decision == Nothing


-- The refusal panel opens only on a row the shown page draws decision
-- controls for, and stays open only while it is drawn: a refusal asked by
-- key or button on a withheld card, on a page whose log is broken, on a
-- uid the page does not list, on a listed unit off the card, or on a file
-- no decision binds leaves the model as it was, and the next key still
-- moves the selection. Selecting another card, moving to the next page,
-- leaving for History, and a source read that settles the card withheld
-- each close the panel, while the same read settling it shown keeps it. A
-- submit for another row or another target, and a draft edit for another
-- row, leave the open panel and its draft as they were. Red if a panel can
-- be open on a row the page does not draw, or a message for one row's panel
-- acts on another's.
refusalPanelOnlyOnOfferedRow : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Index.RefusalRow -> Bool
refusalPanelOnlyOnOfferedRow settings a b file =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        withheld =
            queueModel [ a, b ] (ViewShown { a | view = Stale Drifted })

        withheldKeyed =
            after settings [ press withheld "r" ] withheld

        brokenPage =
            queuePageOf [ a, b ]

        broken =
            { shown | queueState = Loaded { brokenPage | log = LibDb.ShownBroken (LibDb.BreaksAt 2) } }

        brokenKeyed =
            after settings [ press broken "r" ] broken

        blocking =
            withRefusal blockingRow shown

        opened =
            after settings (drawnOn shown ua RefuseStart) shown

        drafted =
            after settings (draftOn opened ua "needs a test") opened

        unlisted =
            renamed "u-unlisted" a

        unlistedShown =
            queueModel [ unlisted ] (ViewShown unlisted)

        secondShown =
            cardModel [ a, b ] 1 b

        fileShown =
            withRefusal file shown

        movedAway =
            after settings [ SelectUnit 1 ] drafted

        nextPage =
            after settings [ NextPage Index.Start ] drafted

        toHistory =
            after settings [ ShowHistory ] drafted

        reading =
            { drafted | selectedView = readingSlot settings.epoch ua }

        readWithheld =
            after settings (viewDone settings.epoch ua (Ok (Just { a | view = Stale Drifted }))) reading

        readShown =
            after settings (viewDone settings.epoch ua (Ok (Just a))) reading
    in
    offers shown ua
        && offers unlistedShown unlisted.unit.uid
        && offers secondShown ub
        && offers fileShown file.uid
        && withheldKeyed == withheld
        && after settings (drawnOn shown ua RefuseStart) withheld == withheld
        && (after settings [ press withheldKeyed "j" ] withheldKeyed).selected == 1
        && brokenKeyed == broken
        && after settings (drawnOn shown ua RefuseStart) broken == broken
        && (after settings [ press brokenKeyed "j" ] brokenKeyed).selected == 1
        && after settings (drawnOn unlistedShown unlisted.unit.uid RefuseStart) shown == shown
        && after settings (drawnOn secondShown ub RefuseStart) shown == shown
        && not (offers blocking (uid "r-blocking"))
        && after settings (drawnOn fileShown file.uid RefuseStart) (withRefusal { file | digest = Nothing } shown) == withRefusal { file | digest = Nothing } shown
        && DecisionSlot.openPanel opened.decision == Just ( ua, { refuseDraft = Draft.empty, refuseError = Nothing } )
        && DecisionSlot.openPanel drafted.decision == Just ( ua, { refuseDraft = Draft.draft "needs a test", refuseError = Nothing } )
        && movedAway.selected == 1
        && DecisionSlot.openPanel movedAway.decision == Nothing
        && nextPage.queueState == Loading
        && DecisionSlot.openPanel nextPage.decision == Nothing
        && toHistory.page == HistoryPage
        && DecisionSlot.openPanel toHistory.decision == Nothing
        && DecisionSlot.openPanel reading.decision /= Nothing
        && Selected.decidableSource ua readWithheld.selectedView == Nothing
        && DecisionSlot.openPanel readWithheld.decision == Nothing
        && DecisionSlot.openPanel readShown.decision == Just ( ua, { refuseDraft = Draft.draft "needs a test", refuseError = Nothing } )
        && after settings (drawnOn secondShown ub RefuseSubmit) drafted == drafted
        && after settings (drawnOn fileShown file.uid RefuseSubmit) drafted == drafted
        && after settings (draftOn (refusalOpened settings secondShown ub) ub "elsewhere") drafted == drafted


-- Whether a rendered page draws the refusal panel's reason field or Confirm.
panelDrawn : String -> Bool
panelDrawn html =
    String.contains "Why refuse?" html || String.contains ">Confirm<" html


-- A decision asked on a row the page offers no decision on, by the same
-- predicate the view draws the row's controls by, is refused before it
-- takes the slot, with the notice saying why: an approval of a listed unit
-- off the card while the panel is open on the card, an acknowledgement of
-- a unit or of a file no decision binds, an approval of a uid the page does
-- not list, the approve key on a withheld card or a page whose log is
-- broken, signed by another key or unkeyed, and an approval or
-- acknowledgement while the queue reloads or after its load failed. None
-- starts a save, each shows its notice, and an open panel keeps its draft;
-- a refusal submitted from the panel and refused before it starts (a server
-- with no signing key) keeps the panel and its draft too. Red if a click
-- that arrived after its row stopped offering a decision takes the slot or
-- discards the panel's draft.
staleDecisionTakesNoSlot : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Index.RefusalRow -> Bool
staleDecisionTakesNoSlot settings a b file =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        draft =
            { refuseDraft = Draft.draft "needs a test", refuseError = Nothing }

        drafted =
            after settings (drawnOn shown ua RefuseStart ++ draftOn (refusalOpened settings shown ua) ua "needs a test") shown

        secondShown =
            cardModel [ a, b ] 1 b

        fileShown =
            withRefusal file shown

        approvedElsewhere =
            after settings (drawnOn secondShown ub ApproveRow) drafted

        ackedUnlisted =
            after settings (drawnOn fileShown file.uid ApproveRow) drafted

        ackedBlocking =
            after settings (drawnOn fileShown file.uid ApproveRow) (withRefusal { file | digest = Nothing } shown)

        withheldModel =
            queueModel [ a, b ] (ViewShown { a | view = Stale Drifted })

        withheld =
            after settings [ press withheldModel "a" ] withheldModel

        brokenPage =
            queuePageOf [ a, b ]

        brokenModel =
            { shown | queueState = Loaded { brokenPage | log = LibDb.ShownBroken (LibDb.BreaksAt 2) } }

        broken =
            after settings [ press brokenModel "a" ] brokenModel

        logged log =
            let
                loggedModel =
                    { shown | queueState = Loaded { brokenPage | log = log } }
            in
            after settings [ press loggedModel "a" ] loggedModel

        absentUnit =
            renamed "absent" a

        absentShown =
            queueModel [ absentUnit ] (ViewShown absentUnit)

        absent =
            after settings (drawnOn absentShown absentUnit.unit.uid ApproveRow) shown

        keyMismatch =
            logged LibDb.ShownKeyMismatch

        unkeyed =
            logged LibDb.ShownUnkeyed

        reloading =
            after settings (drawnOn shown ua ApproveRow) { shown | queueState = Loading }

        reloadingFile =
            after settings (drawnOn fileShown file.uid ApproveRow) { shown | queueState = Loading }

        loadFailed =
            after settings (drawnOn shown ua ApproveRow) { shown | queueState = Failed LoadFailed }

        readOnly =
            { settings | key = ReadOnly }

        refusedSubmit =
            after readOnly (drawnOn shown ua RefuseStart ++ draftOn (refusalOpened settings shown ua) ua "needs a test" ++ drawnOn shown ua RefuseSubmit) shown

        idleNotice failure model =
            DecisionSlot.notSavedOf model.decision == Just failure
                && DecisionSlot.pendingText ua model.decision == Nothing
                && DecisionSlot.pendingText ub model.decision == Nothing
                && String.contains (Html.escapeHtml ("Decision not saved: " ++ Failure.saveFailureText failure)) (page model)
    in
    Session.decidableRow drafted ub == Nothing
        && offers shown ua
        && offers secondShown ub
        && offers fileShown file.uid
        && offers absentShown absentUnit.unit.uid
        && idleNotice (SaveRefused SourceNotShown) approvedElsewhere
        && DecisionSlot.openPanel approvedElsewhere.decision == Just ( ua, draft )
        && panelDrawn (page approvedElsewhere)
        && idleNotice (SaveRefused FileNotQueued) ackedUnlisted
        && DecisionSlot.openPanel ackedUnlisted.decision == Just ( ua, draft )
        && idleNotice (SaveRefused FileNotAcknowledgeable) ackedBlocking
        && idleNotice (SaveRefused SourceNotShown) withheld
        && idleNotice (SaveRefused LogBroken) broken
        && idleNotice (SaveRefused NotQueued) absent
        && idleNotice (SaveRefused LogKeyMismatch) keyMismatch
        && idleNotice SaveReadOnly unkeyed
        && idleNotice (SaveRefused NotQueued) reloading
        && idleNotice (SaveRefused FileNotQueued) reloadingFile
        && idleNotice (SaveRefused NotQueued) loadFailed
        && idleNotice SaveReadOnly refusedSubmit
        && DecisionSlot.openPanel refusedSubmit.decision == Just ( ua, draft )
        && String.contains (Html.escapeHtml ("Decision not saved: " ++ Failure.saveFailureText (SaveRefused LogBroken))) (page broken)


-- A slot left taken by another process, whose completion died with it, is
-- idle: slot ownership is tied to process lifetime. A decision saving under
-- a foreign epoch blocks no decision, by button or refusal, and a decision
-- result from a foreign epoch settles no slot this process owns, while a
-- decision busy under this epoch still refuses a second. A page entry
-- shows a foreign busy decision as idle, so no pending state is left on
-- screen. Red if a persisted busy decision blocks the session or stays
-- shown after a restart, or if any process's result frees this process's
-- slot.
foreignDecisionIsIdle : Settings.AppSettings -> Epoch -> Index.UnitView -> Index.UnitView -> Bool
foreignDecisionIsIdle settings otherEpoch a b =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        stale =
            { shown | decision = savingSlot otherEpoch ub }

        approved =
            after settings (drawnOn shown ua ApproveRow) stale

        opened =
            after settings (drawnOn shown ua RefuseStart) stale

        refused =
            after settings (draftOn (refusalOpened settings shown ua) ua "needs a test" ++ drawnOn shown ua RefuseSubmit) opened

        foreignResult =
            after settings (decisionSavedFor otherEpoch ua (Err (Error.conflict "boom"))) approved

        ownResult =
            after settings (decisionSavedFor settings.epoch ua (Err (Error.conflict "boom"))) foreignResult

        entered =
            after settings [ Navigated QueuePage ] { shown | decision = refreshingSlot otherEpoch ub }

        ownEntered =
            after settings [ Navigated QueuePage ] { shown | decision = refreshingSlot settings.epoch ub }
    in
    offers shown ua
        && Maybe.map Tuple.first (DecisionSlot.startDecision settings.epoch ua (savingSlot otherEpoch ub)) == Just (savingSlot settings.epoch ua)
        && Maybe.map Tuple.first (DecisionSlot.startDecision settings.epoch ua (refreshingSlot otherEpoch ub)) == Just (savingSlot settings.epoch ua)
        && DecisionSlot.startDecision settings.epoch ua (savingSlot settings.epoch ub) == Nothing
        && DecisionSlot.startDecision settings.epoch ua (refreshingSlot settings.epoch ub) == Nothing
        && entered.decision == DecisionIdle PanelClosed
        && ownEntered.decision == refreshingSlot settings.epoch ub
        && approved.decision == savingSlot settings.epoch ua
        && DecisionSlot.openPanel opened.decision == Just ( ua, { refuseDraft = Draft.empty, refuseError = Nothing } )
        && refused.decision == savingSlot settings.epoch ua
        && DecisionSlot.openPanel refused.decision == Nothing
        && foreignResult.decision == savingSlot settings.epoch ua
        && DecisionSlot.notSavedOf ownResult.decision == Just SaveFailed


-- A source read left in flight by another process is `NoneSelected`: a
-- unit-page entry, a queue card selected, a queue load and a History entry
-- each act as on an idle slot, and a read result from a foreign epoch
-- settles no read this process owns, while a read in flight under this
-- epoch still holds the slot. Red if a persisted `ViewLoading` blocks the
-- session after a restart, or if another process's result settles it.
foreignReadIsIdle : Settings.AppSettings -> Epoch -> Index.UnitView -> Index.UnitView -> Bool
foreignReadIsIdle settings otherEpoch a b =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        stale =
            queueModel [ a, b ] (readingSlot otherEpoch ua)

        ownSelected =
            after settings [ SelectUnit 1 ] (queueModel [ a, b ] (readingSlot settings.epoch ua))

        unitEntered =
            after settings [ Navigated (unitAt ub) ] stale

        selected =
            after settings [ SelectUnit 1 ] stale

        reloading =
            after settings [ Navigated QueuePage ] stale

        queueLoaded =
            after settings (queueDone reloading.queueLoad (Ok (queuePageOf [ a, b ]))) reloading

        historyEntered =
            after settings [ Navigated HistoryPage ] stale

        foreignResult =
            after settings (viewDone otherEpoch ub (Ok (Just b))) selected

        ownResult =
            after settings (viewDone settings.epoch ub (Ok (Just b))) foreignResult
    in
    inFlight unitEntered == Just ( ub, Nothing )
        && inFlight selected == Just ( ub, Nothing )
        && inFlight queueLoaded == Just ( ua, Nothing )
        && inFlight historyEntered == Nothing
        && inFlight ownSelected == Just ( ua, Just ub )
        && inFlight foreignResult == Just ( ub, Nothing )
        && inFlight ownResult == Nothing
        && Maybe.map SafeText.toString (Selected.selectedViewStatusText ub ownResult.selectedView) == Nothing


-- A decision asked off the queue page is refused before it takes the slot:
-- it leaves only its notice, which a later decision replaces, and it never
-- replaces a decision already saving. Red if a decision asked on the unit
-- page or History takes the decision slot or drops a busy one.
decisionOffQueueHoldsNoSlot : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
decisionOffQueueHoldsNoSlot settings a b =
    let
        ua =
            a.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        approve =
            drawnOn shown ua ApproveRow

        onUnitPage =
            after settings approve { shown | page = unitAt ua }

        onHistory =
            after settings approve { shown | page = HistoryPage }

        onQueue =
            after settings approve shown

        backOnQueue =
            after settings approve { onUnitPage | page = QueuePage }

        savingThenOff =
            after settings approve { onQueue | page = HistoryPage }
    in
    offers shown ua
        && DecisionSlot.notSavedOf onUnitPage.decision == Just SaveOffQueue
        && DecisionSlot.notSavedOf onHistory.decision == Just SaveOffQueue
        && onQueue.decision == savingSlot settings.epoch ua
        && backOnQueue.decision == savingSlot settings.epoch ua
        && savingThenOff.decision == savingSlot settings.epoch ua


-- ── rendered ────────────────────────────────────────────────────────────
page : Model -> String
page model =
    Html.render (Ui.layout [] (View.view model))


-- A decision saving shows its pending state on the queue card in place of
-- Approve and Refuse, and a second press keeps it; a unit page whose read
-- is still in flight shows loading and none of the unit the slot last
-- showed. Each sits beside the settled form, rendered through the same path.
busyRendered : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
busyRendered settings a b =
    let
        shown =
            queueModel [ a ] (ViewShown a)

        approve =
            drawnOn shown a.unit.uid ApproveRow

        pending =
            page (after settings approve shown)

        busy =
            page (after settings (approve ++ approve) shown)

        idle =
            page shown

        aName =
            labelText a.unit.qualified

        waiting =
            page { shown | page = unitAt b.unit.uid }

        settled =
            page { shown | page = unitAt a.unit.uid }
    in
    offers shown a.unit.uid
        && String.contains "Saving the decision…" pending
        && not (String.contains ">Approve<" pending)
        && String.contains "Saving the decision…" busy
        && not (String.contains "Saving the decision…" idle)
        && String.contains ">Approve<" idle
        && String.contains "Loading unit…" waiting
        && not (String.contains aName waiting)
        && String.contains aName settled
        && not (String.contains "Loading unit…" settled)


-- A save that failed on a busy database is `SaveContended`, and the banner
-- says the index or review database is busy, never the error's kind, code or
-- text, and never only the review database: the index read that re-proves
-- the shown source fails busy alike. Any other failure, the moved-head
-- conflict included, is `SaveFailed`, its banner the fixed text with none of
-- the error's. Red if a save failure's text reaches the model or the page.
saveFailureRendered : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
saveFailureRendered settings a b =
    let
        ua =
            a.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        saving =
            after settings (drawnOn shown ua ApproveRow) shown

        busyText =
            "database is locked [5]"

        busy =
            after settings (decisionSavedFor settings.epoch ua (Err (Error.withDetails (Database Db.Busy) (Error.unexpected busyText)))) saving

        otherText =
            "UNIQUE constraint failed: review_log.seq [2067]"

        other =
            after settings (decisionSavedFor settings.epoch ua (Err (Error.withDetails (Database Db.UniqueViolation) (Error.unexpected otherText)))) saving

        moved =
            after settings (decisionSavedFor settings.epoch ua (Err LibDb.headMoved)) saving

        busyPage =
            page busy

        otherPage =
            page other

        movedPage =
            page moved

        changed =
            after settings (decisionSavedFor settings.epoch ua (Ok (Err SourceChanged))) saving
    in
    saving.decision == savingSlot settings.epoch ua
        && DecisionSlot.notSavedOf busy.decision == Just SaveContended
        && String.contains "the index or review database is busy; try again" busyPage
        && not (String.contains "Unexpected" busyPage)
        && not (String.contains "[5]" busyPage)
        && not (String.contains (Html.escapeHtml busyText) busyPage)
        && DecisionSlot.notSavedOf other.decision == Just SaveFailed
        && String.contains (Html.escapeHtml (Failure.saveFailureText SaveFailed)) otherPage
        && not (String.contains "Unexpected" otherPage)
        && not (String.contains (Html.escapeHtml otherText) otherPage)
        && DecisionSlot.notSavedOf moved.decision == Just SaveFailed
        && String.contains (Html.escapeHtml (Failure.saveFailureText SaveFailed)) movedPage
        && not (String.contains (Html.escapeHtml (Error.message LibDb.headMoved)) movedPage)
        && DecisionSlot.notSavedOf changed.decision == Just (SaveRefused SourceChanged)
        && String.contains (Html.escapeHtml (Failure.saveFailureText (SaveRefused SourceChanged))) (page changed)


-- A decision asked on a server with no signing key is refused before it
-- takes the slot, and the banner says the server is read-only. Red if a
-- read-only server starts a decision or shows any other refusal.
readOnlySaveRefused : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
readOnlySaveRefused settings a b =
    let
        shown =
            queueModel [ a, b ] (ViewShown a)

        refused =
            after { settings | key = ReadOnly } (drawnOn shown a.unit.uid ApproveRow) shown
    in
    offers shown a.unit.uid
        && DecisionSlot.notSavedOf refused.decision == Just SaveReadOnly
        && String.contains ReviewKey.readOnlyText (page refused)


-- ── typed failures ──────────────────────────────────────────────────────
-- A failure's text, standing for an error the runtime raised with a server
-- path in it: no page may show any of it.
marker : String
marker =
    "MARKER-/abs/root"


busyMarker : Error
busyMarker =
    Error.withDetails (Database Db.Busy) (Error.unexpected marker)


plainMarker : Error
plainMarker =
    Error.unexpected marker


limitMarker : Error
limitMarker =
    Error.limitExceeded marker


-- `model`'s page shows `text` and none of the marker error's text.
showsOnly : String -> Model -> Bool
showsOnly text model =
    let
        rendered =
            page model
    in
    String.contains text rendered
        && not (String.contains "MARKER" rendered)
        && not (String.contains "/abs/root" rendered)


queueFailure : QueueState -> Maybe LoadFailure
queueFailure state =
    case state of
        Failed failure ->
            Just failure

        Loading ->
            Nothing

        Loaded _ ->
            Nothing


historyFailure : HistoryState -> Maybe LoadFailure
historyFailure state =
    case state of
        HistoryFailed failure ->
            Just failure

        HistoryLoading ->
            Nothing

        HistoryLoaded _ ->
            Nothing


viewFailure : SelectedView -> Maybe LoadFailure
viewFailure state =
    case state of
        ViewFailed _ failure ->
            Just failure

        ViewLoading _ ->
            Nothing

        ViewShown _ ->
            Nothing

        NoneSelected ->
            Nothing

        ViewMissing _ ->
            Nothing


unitFailure : Model -> Maybe LoadFailure
unitFailure model =
    case model.page of
        UnitPage raw ->
            case Session.unitPageState raw model of
                UnitFailed failure ->
                    Just failure

                UnitLoading ->
                    Nothing

                UnitLoaded _ ->
                    Nothing

                UnitNotFound ->
                    Nothing

                UnitIdRefused ->
                    Nothing

        QueuePage ->
            Nothing

        HistoryPage ->
            Nothing


standingFailure : StandingRead -> Maybe LoadFailure
standingFailure read =
    case read of
        StandingFailed _ _ failure ->
            Just failure

        StandingUnread ->
            Nothing

        StandingShown _ _ _ ->
            Nothing

        StandingReading _ _ ->
            Nothing


-- A queue load's failure is decided from the error's details and kind, never
-- its text: a busy database is `LoadContended`, a ceiling passed
-- `LoadPastLimit`, every other failure `LoadFailed`, and the page shows the
-- case's fixed text. A load that succeeds shows the queue. Red if a cause is
-- read from the message, or the error's text reaches the page.
queueLoadFailureTyped : Settings.AppSettings -> Index.UnitView -> Bool
queueLoadFailureTyped settings a =
    let
        loading =
            after settings [ Navigated QueuePage ] initialModel

        settle result =
            after settings (queueLoadedOn loading.queueLoad result) loading

        busy =
            settle (Err busyMarker)

        plain =
            settle (Err plainMarker)

        limit =
            settle (Err limitMarker)

        succeeded =
            settle (Ok (queuePageOf [ a ]))

        lead =
            "Queue failed to load: "
    in
    queueFailure busy.queueState == Just LoadContended
        && showsOnly (lead ++ Failure.loadFailureText LoadContended) busy
        && queueFailure plain.queueState == Just LoadFailed
        && showsOnly (lead ++ Failure.loadFailureText LoadFailed) plain
        && queueFailure limit.queueState == Just LoadPastLimit
        && showsOnly (lead ++ Failure.loadFailureText LoadPastLimit) limit
        && queueFailure succeeded.queueState == Nothing
        && Maybe.map SafeText.toString (Queue.queueStatusText succeeded.queueState) == Nothing


-- A History load's failure is a typed case alike, its page the case's fixed
-- text. Red if the error's text reaches the History page.
historyLoadFailureTyped : Settings.AppSettings -> Bool
historyLoadFailureTyped settings =
    let
        loading =
            after settings [ Navigated HistoryPage ] initialModel

        settle result =
            after settings (historyLoadedOn loading.historyLoad result) loading

        limit =
            settle (Err limitMarker)

        plain =
            settle (Err plainMarker)

        succeeded =
            settle (Ok { rows = [], at = LibDb.HistoryStart, next = Nothing, log = LibDb.ShownProven })

        lead =
            "History load failed: "
    in
    historyFailure limit.history == Just LoadPastLimit
        && showsOnly (lead ++ Failure.loadFailureText LoadPastLimit) limit
        && historyFailure plain.history == Just LoadFailed
        && showsOnly (lead ++ Failure.loadFailureText LoadFailed) plain
        && historyFailure succeeded.history == Nothing
        && Maybe.map SafeText.toString (History.historyStatusText succeeded.history) == Just "No reviews yet."


-- The queue card's source read that fails settles the slot as a typed case,
-- and the card shows its fixed text. Red if the error's text reaches the
-- card.
viewLoadFailureTyped : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
viewLoadFailureTyped settings a b =
    let
        ua =
            a.unit.uid

        reading =
            queueModel [ a, b ] (readingSlot settings.epoch ua)

        settle result =
            after settings (viewLoadedFor settings.epoch ua result) reading

        plain =
            settle (Err plainMarker)

        busy =
            settle (Err busyMarker)

        succeeded =
            settle (Ok (Just a))

        lead =
            "Source load failed: "
    in
    viewFailure plain.selectedView == Just LoadFailed
        && showsOnly (lead ++ Failure.loadFailureText LoadFailed) plain
        && viewFailure busy.selectedView == Just LoadContended
        && showsOnly (lead ++ Failure.loadFailureText LoadContended) busy
        && viewFailure succeeded.selectedView == Nothing
        && Maybe.map SafeText.toString (Selected.selectedViewStatusText ua succeeded.selectedView) == Nothing


-- The unit page's read that fails shows the case's fixed text. Red if the
-- error's text reaches the unit page.
unitLoadFailureTyped : Settings.AppSettings -> Index.UnitView -> Bool
unitLoadFailureTyped settings a =
    let
        ua =
            a.unit.uid

        entered =
            after settings [ Navigated (unitAt ua) ] initialModel

        settle result =
            after settings (viewLoadedFor settings.epoch ua result) entered

        busy =
            settle (Err busyMarker)

        limit =
            settle (Err limitMarker)

        succeeded =
            settle (Ok (Just a))

        lead =
            "Unit load failed: "
    in
    unitFailure busy == Just LoadContended
        && showsOnly (lead ++ Failure.loadFailureText LoadContended) busy
        && unitFailure limit == Just LoadPastLimit
        && showsOnly (lead ++ Failure.loadFailureText LoadPastLimit) limit
        && unitFailure succeeded == Nothing
        && pageTag succeeded == ("loaded " ++ TestSupport.uidHex ua)


-- The unit page's standing read that fails shows the case's fixed text in
-- place of the review status. Red if the error's text reaches the page.
standingLoadFailureTyped : Settings.AppSettings -> Index.UnitView -> Bool
standingLoadFailureTyped settings a =
    let
        ua =
            a.unit.uid

        shown =
            queueModel [ a ] (ViewShown a)

        ( reading, _ ) =
            Standing.standingRequested settings.epoch ua (Index.storedHash a.unit.attested) StandingUnread

        onUnitPage =
            { shown | page = unitAt ua, standing = reading }

        settle result =
            after settings (standingLoadedFor settings.epoch ua (Index.storedHash a.unit.attested) result) onUnitPage

        busy =
            settle (Err busyMarker)

        plain =
            settle (Err plainMarker)

        succeeded =
            settle (Ok Standing.Undecided)

        lead =
            "Review status read failed: "
    in
    standingFailure busy.standing == Just LoadContended
        && showsOnly (lead ++ Failure.loadFailureText LoadContended) busy
        && standingFailure plain.standing == Just LoadFailed
        && showsOnly (lead ++ Failure.loadFailureText LoadFailed) plain
        && standingFailure succeeded.standing == Nothing
        && not (String.contains lead (page succeeded))


-- A blank refusal draft stays open as a typed case, its panel the case's
-- fixed text; a reason within the ceiling starts the decision, which closes
-- the panel, so the row shows the pending state alone. Red if a refused
-- draft starts a decision or shows any other text, or a started decision
-- leaves the panel drawn.
refuseDraftTyped : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
refuseDraftTyped settings a b =
    let
        ua =
            a.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        submit draft =
            after settings (drawnOn shown ua RefuseStart ++ draftOn (refusalOpened settings shown ua) ua draft ++ drawnOn shown ua RefuseSubmit) shown

        blank =
            submit "   "

        kept =
            submit "needs a test"

        idleOpen draft =
            Maybe.map (\row -> DecisionIdle (PanelOpen row draft)) (Session.decidableRow shown ua)
    in
    Just blank.decision == idleOpen { refuseDraft = Draft.draft "   ", refuseError = Just (DraftRefused ReasonBlank) }
        && String.contains (Failure.refuseFailureText (DraftRefused ReasonBlank)) (page blank)
        && kept.decision == savingSlot settings.epoch ua
        && DecisionSlot.openPanel kept.decision == Nothing
        && String.contains "Saving the decision…" (page kept)
        && not (panelDrawn (page kept))


-- ── the bounded refusal draft ───────────────────────────────────────
-- The model and page after the reviewer types `text` into the refusal panel
-- open on `a`'s card.
typedDraft : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> String -> Model
typedDraft settings a b text =
    let
        shown =
            queueModel [ a, b ] (ViewShown a)
    in
    after settings (drawnOn shown a.unit.uid RefuseStart ++ draftOn (refusalOpened settings shown a.unit.uid) a.unit.uid text) shown


-- The open panel's draft as the model holds it.
heldDraft : Model -> Maybe DecisionSlot.Draft
heldDraft model =
    Maybe.map (\( _, draft ) -> draft) (DecisionSlot.openPanel model.decision)


-- The cut notice for a text of `chars` code points.
cutNotice : Int -> RefuseFailure
cutNotice chars =
    DraftRefused (ReasonOverlong { chars = chars, limit = LibDb.reasonMaxChars })


-- The panel's notice, drawn on the page and held by the model.
noticeDrawn : RefuseFailure -> Model -> Bool
noticeDrawn failure model =
    Maybe.andThen (\draft -> draft.refuseError) (heldDraft model) == Just failure
        && String.contains (Html.escapeHtml (Failure.refuseFailureText failure)) (page model)


-- No refusal notice of either kind is drawn or held.
noNotice : Model -> Bool
noNotice model =
    Maybe.andThen (\draft -> draft.refuseError) (heldDraft model) == Nothing
        && not (String.contains "the rest was cut" (page model))
        && not (String.contains (Failure.refuseFailureText (DraftRefused ReasonBlank)) (page model))


heldText : Model -> Maybe String
heldText model =
    Maybe.map (\draft -> Draft.draftText draft.refuseDraft) (heldDraft model)


-- The reason input as the page draws it: the `<input` tag's own attributes.
reasonInputTag : String -> String
reasonInputTag html =
    case String.split "<input" html of
        _ :: rest :: _ ->
            Maybe.withDefault rest (List.head (String.split ">" rest))

        _ ->
            ""


-- A draft of exactly `reasonMaxChars` characters is held and shown whole,
-- with no notice. Red if the bound cuts at or under the limit.
draftAtLimitKept : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
draftAtLimitKept settings a b =
    let
        atLimit =
            String.repeat LibDb.reasonMaxChars "x"

        typed =
            typedDraft settings a b atLimit
    in
    heldText typed == Just atLimit
        && String.contains ("value=\"" ++ atLimit ++ "\"") (reasonInputTag (page typed))
        && noNotice typed


-- A draft one character past the limit is cut to the limit on the edit
-- itself, and the panel says so with the length it had, before any Confirm;
-- the next edit back under the limit clears the notice. Red if the draft is
-- held whole, or the cut is said only at Confirm or never.
draftPastLimitCutWithNotice : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
draftPastLimitCutWithNotice settings a b =
    let
        atLimit =
            String.repeat LibDb.reasonMaxChars "x"

        typed =
            typedDraft settings a b (atLimit ++ "y")

        shortened =
            after settings (draftOn typed a.unit.uid "needs a test") typed
    in
    heldText typed == Just atLimit
        && noticeDrawn (cutNotice (LibDb.reasonMaxChars + 1)) typed
        && String.contains ("value=\"" ++ atLimit ++ "\"") (reasonInputTag (page typed))
        && not (String.contains (atLimit ++ "y") (page typed))
        && heldText shortened == Just "needs a test"
        && noNotice shortened


-- A draft of 5 MiB is held as the limit's first characters, the page draws
-- no more of it, and the notice names its full length. Red if any layer
-- holds or draws a draft past the limit.
hugeDraftBounded : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
hugeDraftBounded settings a b =
    let
        hugeChars =
            5 * 1024 * 1024

        typed =
            typedDraft settings a b (String.repeat hugeChars "z")
    in
    Maybe.map String.length (heldText typed) == Just LibDb.reasonMaxChars
        && noticeDrawn (cutNotice hugeChars) typed
        && not (String.contains (String.repeat (LibDb.reasonMaxChars + 1) "z") (page typed))


-- A reason of `reasonMaxChars` characters outside the Basic Multilingual
-- Plane, two UTF-16 units each, is held whole with no notice: the draft
-- bound counts characters, not units. The input's `maxlength`, which counts
-- UTF-16 units, admits no value past the reason limit, so the text a focused
-- input shows is never more than the draft holds. Red if the draft bound
-- counts units, or the page bound admits more units than the limit has
-- characters.
astralDraftWithinMaxlength : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
astralDraftWithinMaxlength settings a b =
    let
        astral =
            String.repeat LibDb.reasonMaxChars "😀"

        typed =
            typedDraft settings a b astral
    in
    String.length astral == LibDb.reasonMaxChars
        && heldText typed == Just astral
        && noNotice typed
        && Draft.inputMaxUnits <= LibDb.reasonMaxChars


-- The reason input carries a `maxlength` of the reason limit, derived from
-- the one limit. Red if the page bound is dropped, or drifts from
-- `reasonMaxChars`.
refusePanelMaxlengthFromSsot : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
refusePanelMaxlengthFromSsot settings a b =
    let
        tag =
            reasonInputTag (page (typedDraft settings a b "needs a test"))
    in
    Draft.inputMaxUnits == LibDb.reasonMaxChars
        && String.contains ("maxlength=\"" ++ String.fromInt LibDb.reasonMaxChars ++ "\"") tag
        && String.contains "value=\"needs a test\"" tag


-- Confirm after a cut records the reason the panel shows: the decision
-- starts, and the reason it parses is exactly the kept text. Red if Confirm
-- refuses the shown text, or records more or other than it.
confirmRecordsShownText : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
confirmRecordsShownText settings a b =
    let
        atLimit =
            String.repeat LibDb.reasonMaxChars "x"

        typed =
            typedDraft settings a b (atLimit ++ "tail past the limit")

        confirmed =
            after settings (drawnOn typed a.unit.uid RefuseSubmit) typed

        recorded =
            Maybe.map (\draft -> Draft.draftReason draft.refuseDraft) (heldDraft typed)
    in
    String.contains ("value=\"" ++ atLimit ++ "\"") (reasonInputTag (page typed))
        && (case recorded of
                Just (Ok reason) ->
                    SafeText.toString (LibDb.reasonText reason) == atLimit

                Just (Err _) ->
                    False

                Nothing ->
                    False
           )
        && confirmed.decision == savingSlot settings.epoch a.unit.uid


-- A decision on a unit off the shown queue page is refused as `NotQueued`,
-- one on a queued unit whose source is not the one shown as
-- `SourceNotShown`, an acknowledgement of a file off the page as
-- `FileNotQueued`, and one of a listed file now carrying no digest as
-- `FileNotAcknowledgeable`, each a value decided before any database is
-- opened, and the save's banner the refusal's fixed text, which says
-- nothing was saved rather than that a save failed. Each offer is one a
-- render drew earlier. Red if `decisionPlan` plans a write of a unit or
-- file the reviewer was not shown, a refusal is read as a failure, or a
-- stale click's banner says anything else. A click on a still-queued unit
-- while the queue reloads is refused the same way, so the refusal's text
-- names that cause too. Every offer the gate before the slot admits on
-- these models is one its plan writes, the admitted offers plan exactly
-- the drawn source and digest, and each refused click starts no task.
decisionRefusedBeforeReading : Task.Task Error Bool
decisionRefusedBeforeReading =
    do
        at <- freshScratch "ipe-single-flight-refused"
        seedIndex at.indexDb at.repo
        insertLinkRefusal at.indexDb "a"
        reviewStoreAt at
        settings <- envAppSettings
        a <- loadUnitNow (uid "u-a") |> Task.andThen requireUnit
        b <- loadUnitNow (uid "u-b") |> Task.andThen requireUnit
        file <- linkRow
        offerA <- requireOffer (Session.decidableRow (queueModel [ a, b ] (ViewShown a)) a.unit.uid)
        offerB <- requireOffer (Session.decidableRow (cardModel [ a, b ] 1 b) b.unit.uid)
        offerFile <- requireOffer (Session.decidableRow (withRefusal file (queueModel [ a, b ] (ViewShown a))) file.uid)
        offList <- Task.succeed (Session.decisionPlan (queueModel [ a ] (ViewShown a)) offerB)
        notShown <- Task.succeed (Session.decisionPlan (queueModel [ a, b ] (ViewShown a)) offerB)
        fileOffList <- Task.succeed (Session.decisionPlan (queueModel [ a, b ] (ViewShown a)) offerFile)
        fileBlocking <- Task.succeed (Session.decisionPlan (withRefusal { file | digest = Nothing } (queueModel [ a, b ] (ViewShown a))) offerFile)
        whileReloading <- Task.succeed (Session.decisionPlan (reloadingModel a) offerA)
        cleanupIndex at.indexDb at.repo
        removeFileIfAny at.reviewDb
        Task.succeed
            (staleBannerShown settings (queueModel [ a ] (ViewShown a)) offerB offList (SaveRefused NotQueued) notQueuedText
                && staleBannerShown settings (queueModel [ a, b ] (ViewShown a)) offerFile fileOffList (SaveRefused FileNotQueued) fileNotQueuedText
                && refusalOf offList == Just NotQueued
                && refusalOf notShown == Just SourceNotShown
                && refusalOf fileOffList == Just FileNotQueued
                && refusalOf fileBlocking == Just FileNotAcknowledgeable
                && refusalOf whileReloading == Just NotQueued
                && stillQueuedCauseAdmitted (Failure.saveFailureText (SaveRefused NotQueued))
                && stillQueuedCauseAdmitted (Failure.saveFailureText (SaveRefused FileNotQueued))
                && savedRefusal (Failure.saved (Ok fileBlocking)) == Just FileNotAcknowledgeable
                && savedRefusal (Failure.saved (Ok offList)) == Just NotQueued
                && savedRefusal (Failure.saved (Ok notShown)) == Just SourceNotShown
                && List.all (\( model, offer ) -> planFollowsGate model offer && refusedStartsNoTask settings model offer) [ ( queueModel [ a ] (ViewShown a), offerB ), ( queueModel [ a, b ] (ViewShown a), offerB ), ( queueModel [ a, b ] (ViewShown a), offerFile ), ( withRefusal { file | digest = Nothing } (queueModel [ a, b ] (ViewShown a)), offerFile ), ( reloadingModel a, offerA ) ]
                && admittedAndPlanned (queueModel [ a, b ] (ViewShown a)) offerA (Maybe.map Session.WriteUnit (DecisionSlot.offeredSource offerA (ViewShown a)))
                && admittedAndPlanned (withRefusal file (queueModel [ a, b ] (ViewShown a))) offerFile (Maybe.map (Session.WriteFile file.uid) (DecisionSlot.offeredRefusal offerFile))
            )


-- Whether the gate before the slot, `decidableAs`, refuses `offer` on
-- `model`, or `decisionPlan` plans it: an offer the gate admits is never
-- one its plan refuses, so the plan's refusal in `saveDecision` is reached
-- on no model these checks build. Red if a plan refuses an admitted offer.
planFollowsGate : Model -> DecisionSlot.DecidableRow -> Bool
planFollowsGate model offer =
    case gateOn model offer of
        Ok _ ->
            refusalOf (Session.decisionPlan model offer) == Nothing

        Err _ ->
            True


-- Whether the gate admits `offer` on `model` and its plan is `expected`,
-- the write of exactly what the offer drew. Red if an admitted offer plans
-- a source or digest other than the drawn one.
admittedAndPlanned : Model -> DecisionSlot.DecidableRow -> Maybe Session.DecisionPlan -> Bool
admittedAndPlanned model offer expected =
    case ( gateOn model offer, expected ) of
        ( Ok _, Just plan ) ->
            Session.decisionPlan model offer == Ok plan

        _ ->
            False


gateOn : Model -> DecisionSlot.DecidableRow -> Result SaveFailure DecisionSlot.DecidableRow
gateOn model offer =
    DecisionSlot.decidableAs model.selected model.queueState model.selectedView (DecisionSlot.rowTarget offer) (DecisionSlot.rowUid offer) (Just offer)


-- Whether a click of `offer` on `model`, which the gate or the plan
-- refuses, starts no task: the decision slot takes no save, so no task was
-- started, the step returns no effect, and it holds the notice of why. Red
-- if a refused decision starts a task.
refusedStartsNoTask : Settings.AppSettings -> Model -> DecisionSlot.DecidableRow -> Bool
refusedStartsNoTask settings model offer =
    let
        clicked =
            after settings [ ApproveRow offer ] model
    in
    DecisionSlot.savingStamp clicked.decision == Nothing
        && startsNothing settings [ ApproveRow offer ] model
        && DecisionSlot.notSavedOf clicked.decision /= Nothing


-- The queue page of `a` while it reloads, so no row is listed though `a` is
-- still queued.
reloadingModel : Index.UnitView -> Model
reloadingModel a =
    { initialModel | queueState = Loading, selectedView = ViewShown a }


-- Whether a stale-click refusal's text holds for a row that is still queued
-- but not on the page shown, as a click during a reload or after a page
-- change is: it claims neither that the row left the queue nor that the
-- queue shown is current. Red if the text asserts a cause only some of its
-- producers have.
stillQueuedCauseAdmitted : String -> Bool
stillQueuedCauseAdmitted text =
    String.contains "page changed or was reloading" text
        && not (String.contains "left the queue" text)
        && not (String.contains "is current" text)


-- The fixed texts of the two stale-click refusals, spelled out so the
-- banner check compares against the text itself, not the function that
-- produces it.
notQueuedText : String
notQueuedText =
    "the unit was not on the queue page shown when this click arrived (it was decided, the index no longer lists it, or the page changed or was reloading); nothing was saved"


fileNotQueuedText : String
fileNotQueuedText =
    "the file was not on the queue page shown when this click arrived (it was acknowledged, the index no longer lists it, or the page changed or was reloading); nothing was saved"


-- The banner a stale click on the offer `clicked` leaves, refused at the
-- click before it takes the slot, and kept when a save's late refusal
-- `refused` for it arrives: the not-saved notice of `expected`, whose fixed
-- text is `shown`, and none of the failed-save lead.
staleBannerShown : Settings.AppSettings -> Model -> DecisionSlot.DecidableRow -> Result DecideRefusal plan -> SaveFailure -> String -> Bool
staleBannerShown settings model clicked refused expected shown =
    let
        answered =
            case refused of
                Err refusal ->
                    decisionSavedFor settings.epoch (DecisionSlot.rowUid clicked) (Ok (Err refusal))

                Ok _ ->
                    []

        settled =
            after settings ([ ApproveRow clicked ] ++ answered) model

        html =
            page settled
    in
    not (List.isEmpty answered)
        && DecisionSlot.notSavedOf settled.decision == Just expected
        && Failure.saveFailureText expected == shown
        && String.contains (Html.escapeHtml ("Decision not saved: " ++ shown)) html
        && not (String.contains "Decision save failed" html)


-- A file the index refuses for a blocking reason, so it carries no digest.
blockingRow : Index.RefusalRow
blockingRow =
    { uid = uid "r-blocking"
    , path = labelOf "ipe:src/unreadable.txt"
    , lang = labelOf "other"
    , reason = UnreadableEntry
    , size = Nothing
    , digest = Nothing
    }


-- The offer a render drew, which a check needs to exist.
requireOffer : Maybe DecisionSlot.DecidableRow -> Task.Task Error DecisionSlot.DecidableRow
requireOffer drawn =
    case drawn of
        Just row ->
            Task.succeed row

        Nothing ->
            Task.fail (Error.conflict "a fixture render draws no decision control")


-- An acknowledgeable file, `r-link`, listed in the index at `indexDb` with
-- a well-formed digest whose 64 hex digits all read `digit`.
insertLinkRefusal : String -> String -> Task.Task Error ()
insertLinkRefusal indexDb digit =
    execIndex indexDb
        "INSERT INTO refusals (uid, path, lang, reason, size, digest) VALUES (?, ?, 'other', 'symlink-entry', NULL, ?)"
        [ Uid.toSql (uid "r-link"), SqlString "ipe:src/link.txt", SqlString (linkDigest digit) ]


linkDigest : String -> String
linkDigest digit =
    "refusal-blake3:" ++ String.repeat 64 digit


-- A migrated review store at `at`, the one the environment names, so a
-- page load reads this check's own log.
reviewStoreAt : Scratch -> Task.Task Error ()
reviewStoreAt at =
    System.setenv "IPE_REVIEW_DB" at.reviewDb
        |> Task.andThen (\_ -> migratedReviewAt at.reviewDb)
        |> Task.map (\_ -> ())


-- The `r-link` row as the first queue page lists it, digest included.
linkRow : Task.Task Error Index.RefusalRow
linkRow =
    loadPageNow Index.Start
        |> Task.andThen
            (\loaded ->
                case List.find (\row -> row.uid == uid "r-link") loaded.refusals of
                    Just row ->
                        if row.digest /= Nothing then
                            Task.succeed row

                        else
                            Task.fail (Error.conflict "the fixture file is listed with no digest")

                    Nothing ->
                        Task.fail (Error.conflict "the fixture file is not listed")
            )


-- `model` with `row` listed among its queue page's unreviewable files.
withRefusal : Index.RefusalRow -> Model -> Model
withRefusal row model =
    case model.queueState of
        Loaded loaded ->
            { model | queueState = Loaded { loaded | refusals = row :: loaded.refusals } }

        Loading ->
            model

        Failed _ ->
            model


-- The refusal a settled save carries, if it was refused.
savedRefusal : Result SaveFailure a -> Maybe DecideRefusal
savedRefusal result =
    case result of
        Err (SaveRefused refusal) ->
            Just refusal

        Err _ ->
            Nothing

        Ok _ ->
            Nothing


-- ── harness ─────────────────────────────────────────────────────────────
-- The settings a server would parse for the seeded index, an epoch minted
-- apart from theirs, standing for another process's, the two seeded fixture
-- units and the acknowledgeable file `r-link`, handed to `body`.
withSeeded :
    String
    -> (Settings.AppSettings
        -> Epoch
        -> Index.UnitView
        -> Index.UnitView
        -> Index.RefusalRow
        -> List ( String, Bool ))
    -> Task.Task Error (List ( String, Bool ))
withSeeded name body =
    do
        at <- freshScratch name
        seedIndex at.indexDb at.repo
        insertLinkRefusal at.indexDb "a"
        reviewStoreAt at
        settings <- envAppSettings
        otherEpoch <- Epoch.mint
        a <- loadUnitNow (uid "u-a") |> Task.andThen requireUnit
        b <- loadUnitNow (uid "u-b") |> Task.andThen requireUnit
        file <- linkRow
        cleanupIndex at.indexDb at.repo
        removeFileIfAny at.reviewDb
        Task.succeed (body settings otherEpoch a b file)


requireUnit : Maybe Index.UnitView -> Task.Task Error Index.UnitView
requireUnit found =
    case found of
        Just loaded ->
            Task.succeed loaded

        Nothing ->
            Task.fail (Error.conflict "a fixture unit is missing from the seeded index")


-- A saved decision stays busy until the queue reload that follows it
-- settles, so the row it was made on, still listed until then, offers no
-- control a second decision could land on: a press by button, key or
-- acknowledgement starts nothing, and the card says the queue is
-- refreshing. Another load's result leaves it busy; the reload settling,
-- failed or superseded by a later load, ends it. Red if a decision is idle
-- once written while its row is still listed, or if no later load frees it.
writtenStaysPending : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Index.RefusalRow -> ( Index.Attested, Index.Written ) -> Bool
writtenStaysPending settings a b file pair =
    let
        ua =
            a.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        saving =
            after settings (drawnOn shown ua ApproveRow) shown

        written =
            after settings (decisionDone settings.epoch ua (Ok pair)) saving

        pressed =
            after settings (drawnOn written ua ApproveRow ++ [ press written "a" ] ++ drawnOn (withRefusal file written) file.uid ApproveRow) written

        otherLoad =
            anotherLoad settings.epoch (QueueReload Index.Start) pressed.queueLoad

        olderLoad =
            after settings (completions PendingLoaded otherLoad (Ok (queuePageOf [ a, b ]))) pressed

        reloaded =
            after settings (queueDone written.queueLoad (Ok (queuePageOf [ b ]))) pressed

        reloadFailed =
            after settings (queueLoadedOn written.queueLoad (Err (Error.conflict "boom"))) pressed

        superseding =
            after settings [ Navigated QueuePage ] pressed

        drainReturned =
            after settings (queueDone written.queueLoad (Ok (queuePageOf [ a, b ]))) superseding

        superseded =
            after settings (queueDone drainReturned.queueLoad (Ok (queuePageOf [ b ]))) drainReturned

        writtenPage =
            page written
    in
    offers written ua
        && offers (withRefusal file written) file.uid
        && written.decision == refreshingSlot settings.epoch ua
        && pressed.decision == refreshingSlot settings.epoch ua
        && String.contains "Decision saved; refreshing the queue…" writtenPage
        && not (String.contains ">Approve<" writtenPage)
        && otherLoad /= Nothing
        && olderLoad.decision == refreshingSlot settings.epoch ua
        && reloaded.decision == DecisionIdle PanelClosed
        && reloadFailed.decision == DecisionIdle PanelClosed
        && superseding.decision == refreshingSlot settings.epoch ua
        && drainReturned.decision == refreshingSlot settings.epoch ua
        && superseded.decision == DecisionIdle PanelClosed


-- The notice of a decision that was not saved advises a reload, and the
-- reload clears it: the queue load that a page entry starts, once it
-- succeeds, leaves no notice. A load that fails keeps it. Red if the
-- notice survives the reload its text tells the reviewer to make.
notSavedClearedByReload : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
notSavedClearedByReload settings a b =
    let
        ua =
            a.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        failed =
            after settings (drawnOn shown ua ApproveRow ++ decisionSavedFor settings.epoch ua (Err (Error.conflict "boom"))) shown

        reloading =
            after settings [ Navigated QueuePage ] failed

        reloaded =
            after settings (queueDone reloading.queueLoad (Ok (queuePageOf [ a, b ]))) reloading

        reloadFailed =
            after settings (queueLoadedOn reloading.queueLoad (Err (Error.conflict "boom"))) reloading

        banner =
            Html.escapeHtml ("Decision not saved: " ++ Failure.saveFailureText SaveFailed)
    in
    offers shown ua
        && DecisionSlot.notSavedOf failed.decision == Just SaveFailed
        && String.contains banner (page failed)
        && DecisionSlot.notSavedOf reloading.decision == Just SaveFailed
        && reloaded.decision == DecisionIdle PanelClosed
        && not (String.contains banner (page reloaded))
        && DecisionSlot.notSavedOf reloadFailed.decision == Just SaveFailed


-- Only a reload started after the failure clears its notice: a queue load
-- started while the decision was saving, by a page entry or a reconnect,
-- read the queue before the failure was known, so its result keeps the
-- notice, and the reload after it clears it. Red if a load that predates
-- the failure wipes the notice before the reviewer saw why the decision
-- was not saved.
notSavedOutlivesOlderLoad : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
notSavedOutlivesOlderLoad settings a b =
    let
        ua =
            a.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        enteredWhileSaving =
            after settings (drawnOn shown ua ApproveRow ++ [ Navigated QueuePage ]) shown

        failed =
            after settings (decisionSavedFor settings.epoch ua (Err (Error.conflict "boom"))) enteredWhileSaving

        olderLoaded =
            after settings (queueDone enteredWhileSaving.queueLoad (Ok (queuePageOf [ a, b ]))) failed

        reloading =
            after settings [ Navigated QueuePage ] olderLoaded

        reloaded =
            after settings (queueDone reloading.queueLoad (Ok (queuePageOf [ a, b ]))) reloading

        banner =
            Html.escapeHtml ("Decision not saved: " ++ Failure.saveFailureText SaveFailed)
    in
    offers shown ua
        && DecisionSlot.notSavedOf failed.decision == Just SaveFailed
        && DecisionSlot.notSavedOf olderLoaded.decision == Just SaveFailed
        && String.contains banner (page olderLoaded)
        && reloaded.decision == DecisionIdle PanelClosed
        && not (String.contains banner (page reloaded))


-- A completion the slot does not own leaves the model unchanged, for
-- every one of the five completions: one stamped by another process's
-- start of the same task, one stamped by another start of this process,
-- and one arriving at an idle slot. Each stamp comes from a real start.
-- Red if any completion settles, restarts or clears a slot on a stamp
-- that is not the slot's running one, epoch and key alike, or returns
-- any effect for it.
staleCompletionDropped : Settings.AppSettings -> Epoch -> Index.UnitView -> Index.UnitView -> ( Index.Attested, Index.Written ) -> Bool
staleCompletionDropped settings otherEpoch a b pair =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        hashA =
            Index.storedHash a.unit.attested

        unchangedBy msgs model =
            startsNothing settings msgs model && after settings msgs model == model

        queuePage =
            Ok (queuePageOf [ a ])

        queueWant =
            QueueReload Index.Start

        queueRunning =
            after settings [ Navigated QueuePage ] initialModel

        queueLoad =
            Slot.runningLoad queueRunning.queueLoad

        foreignQueueLoad =
            Slot.runningLoad (Tuple.first (Slot.requestLoad Queue.mergeQueueWant otherEpoch queueWant Slot.idleLoad))

        historyPage =
            Ok { rows = [], at = LibDb.HistoryStart, next = Nothing, log = LibDb.ShownProven }

        historyWant =
            HistoryFrom (historyAfter 1)

        historyRunning =
            after settings [ Navigated HistoryPage ] initialModel

        historyLoad =
            Slot.runningLoad historyRunning.historyLoad

        foreignHistoryLoad =
            Slot.runningLoad (Tuple.first (Slot.requestLoad Slot.latestWant otherEpoch historyWant Slot.idleLoad))

        reading =
            queueModel [ a, b ] (readingSlot settings.epoch ua)

        shownOnUnitPage =
            { reading | selectedView = ViewShown a, page = unitAt ua }

        shown =
            queueModel [ a, b ] (ViewShown a)

        saving =
            { shown | decision = savingSlot settings.epoch ua }

        refreshing =
            { shown | decision = refreshingSlot settings.epoch ua }

        standing =
            { shown | standing = standingReading settings.epoch ua hashA }
    in
    Maybe.map Slot.stampKey foreignQueueLoad == Maybe.map Slot.stampKey queueLoad
        && Maybe.map Slot.stampKey foreignHistoryLoad == Maybe.map Slot.stampKey historyLoad
        && saving.decision /= shown.decision
        && standing.standing /= shown.standing
        && unchangedBy (completions PendingLoaded foreignQueueLoad queuePage) queueRunning
        && unchangedBy (completions PendingLoaded (anotherLoad settings.epoch queueWant queueRunning.queueLoad) queuePage) queueRunning
        && unchangedBy (completions PendingLoaded queueLoad queuePage) initialModel
        && unchangedBy (completions HistoryPageLoaded foreignHistoryLoad historyPage) historyRunning
        && unchangedBy (completions HistoryPageLoaded (anotherLoad settings.epoch historyWant historyRunning.historyLoad) historyPage) historyRunning
        && unchangedBy (completions HistoryPageLoaded historyLoad historyPage) initialModel
        && unchangedBy (viewDone otherEpoch ua (Ok (Just a))) reading
        && unchangedBy (viewDone settings.epoch ub (Ok (Just b))) reading
        && unchangedBy (viewDone settings.epoch ua (Ok (Just a))) shown
        && unchangedBy (viewDone settings.epoch ua (Ok (Just a))) shownOnUnitPage
        && unchangedBy (decisionDone otherEpoch ua (Ok pair)) saving
        && unchangedBy (decisionDone settings.epoch ub (Ok pair)) saving
        && unchangedBy (decisionDone settings.epoch ua (Ok pair)) shown
        && unchangedBy (decisionDone settings.epoch ua (Ok pair)) refreshing
        && unchangedBy (decisionDone settings.epoch ua (Err SaveFailed)) refreshing
        && unchangedBy (completions StandingLoaded (standingStamp otherEpoch ua hashA) (Ok Standing.Undecided)) standing
        && unchangedBy (completions StandingLoaded (standingStamp settings.epoch ua "another body") (Ok Standing.Undecided)) standing
        && unchangedBy (completions StandingLoaded (standingStamp settings.epoch ua hashA) (Ok Standing.Undecided)) shown


-- `msgs` sent to `model` leave its queue load slot as it was, nothing
-- started, no effect returned and nothing wanted; vacuous `msgs` count as
-- a change.
drainsNothing : Settings.AppSettings -> List Msg -> Model -> Bool
drainsNothing settings msgs model =
    let
        saved =
            after settings msgs model
    in
    startsNothing settings msgs model
        && saved.queueLoad == model.queueLoad
        && Slot.runningWant settings.epoch saved.queueLoad == Slot.runningWant settings.epoch model.queueLoad


-- A saved decision's drain is asked only by the save the decision slot
-- runs: a save result whose stamp the slot does not hold, from another
-- process, another unit's save, or a slot already idle or refreshing,
-- leaves the queue's load slot as it was and wants no drain, while the
-- slot's own save wants exactly one, held behind the running load rather
-- than started beside it. Red if an unowned `DecisionSaved Ok` starts or
-- records a drain, or returns a `LoadQueue`.
unownedDecisionSavedDrainsNothing : Settings.AppSettings -> Epoch -> Index.UnitView -> Index.UnitView -> ( Index.Attested, Index.Written ) -> Bool
unownedDecisionSavedDrainsNothing settings otherEpoch a b ( attested, written ) =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        saving =
            { shown | decision = savingSlot settings.epoch ua }

        loading =
            after settings [ Navigated QueuePage ] saving

        refreshing =
            { shown | decision = refreshingSlot settings.epoch ua }

        drain =
            Just (QueueDrain attested written Index.Start)

        owned =
            after settings (decisionDone settings.epoch ua (Ok ( attested, written ))) loading
    in
    drainsNothing settings (decisionDone otherEpoch ua (Ok ( attested, written ))) saving
        && drainsNothing settings (decisionDone settings.epoch ub (Ok ( attested, written ))) saving
        && drainsNothing settings (decisionDone otherEpoch ua (Ok ( attested, written ))) loading
        && drainsNothing settings (decisionDone settings.epoch ub (Ok ( attested, written ))) loading
        && drainsNothing settings (decisionDone settings.epoch ua (Ok ( attested, written ))) shown
        && drainsNothing settings (decisionDone settings.epoch ua (Ok ( attested, written ))) refreshing
        && Slot.runningWant settings.epoch loading.queueLoad == Just Nothing
        && Slot.runningWant settings.epoch owned.queueLoad == Just drain
        && startsNone queueStart (effectsOf settings (decisionDone settings.epoch ua (Ok ( attested, written ))) loading)


-- A decision slot settles a save result only under its own stamp, apart
-- from the gate `Session.step` holds before it: a result another process
-- stamped, one for another unit, or one reaching a slot that is not saving
-- leaves the slot unchanged and wants no reload. Red if `decisionWritten`
-- or `decisionNotSaved` settles a result its slot does not own.
decisionSlotOwnsItsResult : Settings.AppSettings -> Epoch -> Bool
decisionSlotOwnsItsResult settings otherEpoch =
    let
        ua =
            uid "u-a"

        ub =
            uid "u-b"

        latest =
            Slot.firstTicket

        saving =
            savingSlot settings.epoch ua

        refusedOn slot held =
            case held of
                Just arrived ->
                    DecisionSlot.decisionWritten settings.epoch arrived slot == Nothing && DecisionSlot.decisionNotSaved settings.epoch arrived SaveFailed latest slot == slot

                Nothing ->
                    False

        settledOn slot held =
            case held of
                Just arrived ->
                    DecisionSlot.decisionWritten settings.epoch arrived slot == Just (refreshingSlot settings.epoch ua) && DecisionSlot.decisionNotSaved settings.epoch arrived SaveFailed latest slot == DecisionNotSaved SaveFailed latest PanelClosed

                Nothing ->
                    False
    in
    refusedOn saving (savingStamp otherEpoch ua)
        && refusedOn saving (savingStamp settings.epoch ub)
        && refusedOn (savingSlot otherEpoch ua) (savingStamp otherEpoch ua)
        && refusedOn (DecisionIdle PanelClosed) (savingStamp settings.epoch ua)
        && refusedOn (refreshingSlot settings.epoch ua) (savingStamp settings.epoch ua)
        && refreshingSlot settings.epoch ua /= saving
        && settledOn saving (savingStamp settings.epoch ua)


-- The written-decision checks, on a decision really written through
-- `Queue.decide` to a fresh review database, so the app receives the saved
-- result a server's decision returns.
writtenChecks : Task.Task Error (List ( String, Bool ))
writtenChecks =
    do
        at <- freshScratch "ipe-single-flight-written"
        removeFileIfAny at.indexDb
        removeFileIfAny at.reviewDb
        seedIndex at.indexDb at.repo
        insertLinkRefusal at.indexDb "a"
        System.setenv "IPE_REVIEW_DB" at.reviewDb
        db <- migratedReviewAt at.reviewDb
        settings <- envAppSettings
        otherEpoch <- Epoch.mint
        a <- loadUnitNow (uid "u-a") |> Task.andThen requireUnit
        b <- loadUnitNow (uid "u-b") |> Task.andThen requireUnit
        file <- linkRow
        pair <- decideNow db (uid "u-a") Approved
        cleanupIndex at.indexDb at.repo
        removeFileIfAny at.reviewDb
        Task.succeed
            [ ( "a saved decision withholds its row's controls until the queue reload settles", writtenStaysPending settings a b file pair )
            , ( "a decision saved during a queue load stays refreshing until its drain settles", refreshingSettlesOnlyAfterWrite settings a b pair )
            , ( "a wanted drain absorbs a page turn and replaces a wanted reload", drainAbsorbsReload settings pair )
            , ( "a completion its slot does not own leaves the model unchanged, for each of the five completions", staleCompletionDropped settings otherEpoch a b pair )
            , ( "a saved decision whose stamp its slot does not hold drains nothing", unownedDecisionSavedDrainsNothing settings otherEpoch a b pair )
            , ( "a decision slot settles only the save result its own stamp names", decisionSlotOwnsItsResult settings otherEpoch )
            , ( "every step returns each slot's new task once and no other", effectOncePerTransition settings otherEpoch a b pair )
            ]


checks : Task.Task Error (List ( String, Bool ))
checks =
    Task.map2
        (\seeded refused -> seeded ++ [ refused ])
        seededChecks
        (check "a decision off the shown list or source is refused before any read" decisionRefusedBeforeReading)
        |> Task.andThen (\rows -> check "Enter in an unreviewable file's refusal panel submits that file's refusal" enterRefusesOpenFile |> Task.map (\entered -> rows ++ [ entered ]))
        |> Task.andThen (\rows -> check "the session starts no task, and only the interpreter's run and update do" sessionStartsNothing |> Task.map (\scanned -> rows ++ [ scanned ]))
        |> Task.andThen (\rows -> check "every completion stamp in src is minted at its slot's one start" everyStampMintedAtItsStart |> Task.map (\scanned -> rows ++ [ scanned ]))
        |> Task.andThen (\rows -> check "the session's effects are its five slots, within the runtime's session task ceiling" effectSlotsUnderCeiling |> Task.map (\scanned -> rows ++ [ scanned ]))


-- Enter in the refusal panel open on an acknowledgeable file the page lists
-- submits the refusal of that file, through the panel's own row: the save
-- starts on the file. Red if the key submits the unit refusal, which is
-- refused for a file and leaves the panel open with nothing saving.
enterRefusesOpenFile : Task.Task Error Bool
enterRefusesOpenFile =
    do
        at <- freshScratch "ipe-single-flight-enter"
        seedIndex at.indexDb at.repo
        System.setenv "IPE_REVIEW_DB" at.reviewDb
        _ <- migratedReviewAt at.reviewDb
        insertLinkRefusal at.indexDb "a"
        settings <- envAppSettings
        loaded <- loadPageNow Index.Start
        cleanupIndex at.indexDb at.repo
        removeFileIfAny at.reviewDb
        Task.succeed (enteredOnFile settings { initialModel | queueState = Loaded { loaded | log = LibDb.ShownProven } })


enteredOnFile : Settings.AppSettings -> Model -> Bool
enteredOnFile settings listed =
    let
        file =
            uid "r-link"

        drafted =
            after settings (drawnOn listed file RefuseStart ++ draftOn (refusalOpened settings listed file) file "not ours") listed

        entered =
            after settings [ press drafted "Enter" ] drafted
    in
    Maybe.map DecisionSlot.rowTarget (Session.decidableRow listed file) == Just OnRefusal
        && DecisionSlot.openPanel drafted.decision == Just ( file, { refuseDraft = Draft.draft "not ours", refuseError = Nothing } )
        && entered.decision == savingSlot settings.epoch file
        && DecisionSlot.openPanel entered.decision == Nothing


seededChecks : Task.Task Error (List ( String, Bool ))
seededChecks =
    withSeeded "ipe-single-flight"
        (\settings otherEpoch a b file ->
            [ ( "unit-page entries during a source read start no second read", unitEntriesDuringReadCoalesce settings a b )
            , ( "the queue card and the unit page share one source read slot", oneReadSlotAcrossPages settings a b )
            , ( "the unit page settles only on its own unit's read", unitPageSettlesOnItsOwnRead settings a b )
            , ( "a decision asked while one is saving starts no second decision", decisionsSingleFlight settings a b )
            , ( "a decision saving under another process's epoch blocks no decision", foreignDecisionIsIdle settings otherEpoch a b )
            , ( "the refusal panel opens only on an idle decision slot", refusalPanelLivesInIdleSlot settings a b file )
            , ( "the refusal panel opens and stays open only on a row the page offers a decision on", refusalPanelOnlyOnOfferedRow settings a b file )
            , ( "a decision on a row the page offers no decision on takes no slot and keeps the panel", staleDecisionTakesNoSlot settings a b file )
            , ( "a source read in flight under another process's epoch blocks no read", foreignReadIsIdle settings otherEpoch a b )
            , ( "a decision asked off the queue page takes no decision slot", decisionOffQueueHoldsNoSlot settings a b )
            , ( "a refused decision and a unit page awaiting its read render as such", busyRendered settings a b )
            , ( "a failed save is a typed case whose banner holds no error text", saveFailureRendered settings a b )
            , ( "a decision on a read-only server is refused before it takes the slot", readOnlySaveRefused settings a b )
            , ( "a not-saved notice is cleared by the reload it advises", notSavedClearedByReload settings a b )
            , ( "a queue load started before a failed save keeps its notice", notSavedOutlivesOlderLoad settings a b )
            , ( "a failed queue load is a typed case whose page holds no error text", queueLoadFailureTyped settings a )
            , ( "a failed History load is a typed case whose page holds no error text", historyLoadFailureTyped settings )
            , ( "a failed source read is a typed case whose card holds no error text", viewLoadFailureTyped settings a b )
            , ( "a failed unit-page read is a typed case whose page holds no error text", unitLoadFailureTyped settings a )
            , ( "a failed standing read is a typed case whose page holds no error text", standingLoadFailureTyped settings a )
            , ( "a refused refusal draft is a typed case with a fixed text", refuseDraftTyped settings a b )
            , ( "a refusal draft at the reason limit is held and shown whole with no notice", draftAtLimitKept settings a b )
            , ( "a refusal draft past the reason limit is cut on the edit and the panel says so", draftPastLimitCutWithNotice settings a b )
            , ( "a 5 MiB refusal draft is held and drawn only to the reason limit", hugeDraftBounded settings a b )
            , ( "a reason of astral characters at the limit fits the draft, and the input maxlength admits no more than the draft holds", astralDraftWithinMaxlength settings a b )
            , ( "the reason input's maxlength derives from the reason limit", refusePanelMaxlengthFromSsot settings a b )
            , ( "Confirm after a cut records exactly the shown text", confirmRecordsShownText settings a b )
            , ( "a press on an idle queue slot starts exactly one load", idlePressStartsOneLoad settings )
            , ( "presses during a queue load start no second load and want only the last page", queueLoadsSingleFlight settings a )
            , ( "a queue page superseded while loading is dropped and the wanted page settles", supersededQueueResultDropped settings a b )
            , ( "presses during a History load start no second load and want only the last page", historyLoadsSingleFlight settings )
            , ( "source reads settling during a standing read start no second standing read", standingSingleFlight settings a b )
            , ( "a load slot or standing read held under another process's epoch is idle", foreignLoadSlotIdle settings otherEpoch a )
            , ( "a queue load refused with an error frees its slot", ceilingRefusalReleasesSlot settings )
            , ( "a request made while a slot runs returns no task, and the held want starts once", secondRequestHeldNotStarted settings a b )
            ]
        )
        |> Task.andThen (\rows -> writtenChecks |> Task.map (\written -> rows ++ written))
        |> Task.andThen (\rows -> reshownChecks |> Task.map (\reshown -> rows ++ reshown))
        |> Task.onError (\e -> checkReporting Io.println "single-flight fixtures" (Task.fail e) |> Task.map (\failed -> [ failed ]))


-- ── a decision binds what was drawn ─────────────────────────────────────
-- The fixture: `a` and `a2`, the same unit `u-a` before and after its file
-- and index row change under it, so the two views carry different shown
-- digests, and `file` and `file2`, the file `r-link` listed with one digest
-- and then another.
type alias Reshown =
    { settings : Settings.AppSettings
    , a : Index.UnitView
    , a2 : Index.UnitView
    , b : Index.UnitView
    , file : Index.RefusalRow
    , file2 : Index.RefusalRow
    }


-- The queue card selected on `a` whose source read is in flight, and the
-- same card once the read settles with `a2`.
reshownCard : Reshown -> ( Model, Model )
reshownCard r =
    let
        shown =
            queueModel [ r.a, r.b ] (ViewShown r.a)

        reading =
            { shown | selectedView = readingSlot r.settings.epoch r.a.unit.uid }
    in
    ( shown, after r.settings (viewDone r.settings.epoch r.a.unit.uid (Ok (Just r.a2))) reading )


-- An approval drawn on `a` and received after the card's source was read
-- again as `a2` decides nothing: the slot holds the `DrawnChanged` notice,
-- never a save. The approval drawn on the render after the read saves, so
-- the notice's remedy, reading the source again and deciding, clears it.
-- Red if the gate compares the offer's uid and target only.
staleApproveAfterSourceReloadDecidesNothing : Reshown -> Bool
staleApproveAfterSourceReloadDecidesNothing r =
    let
        ua =
            r.a.unit.uid

        ( shown, reloaded ) =
            reshownCard r

        stale =
            after r.settings (drawnOn shown ua ApproveRow) reloaded
    in
    offers shown ua
        && offers reloaded ua
        && Session.decidableRow shown ua /= Session.decidableRow reloaded ua
        && DecisionSlot.notSavedOf stale.decision == Just (SaveRefused DrawnChanged)
        && stale.decision /= savingSlot r.settings.epoch ua
        && String.contains (Html.escapeHtml ("Decision not saved: " ++ Failure.saveFailureText (SaveRefused DrawnChanged))) (page stale)


freshApproveAfterSourceReloadSaves : Reshown -> Bool
freshApproveAfterSourceReloadSaves r =
    let
        ua =
            r.a.unit.uid

        ( shown, reloaded ) =
            reshownCard r

        stale =
            after r.settings (drawnOn shown ua ApproveRow) reloaded

        fresh =
            after r.settings (drawnOn stale ua ApproveRow) stale
    in
    offers stale ua
        && fresh.decision == savingSlot r.settings.epoch ua


-- The approve key carries the offers of the render it was pressed on: a
-- key drawn on `a` and received after the read settled `a2` decides
-- nothing, and so does a key pressed on a render that drew no control for
-- the card (its read in flight) and received once the card offers one. Red
-- if a key decides the model's current offer.
staleKeyApproveDecidesNothing : Reshown -> Bool
staleKeyApproveDecidesNothing r =
    let
        ua =
            r.a.unit.uid

        ( shown, reloaded ) =
            reshownCard r

        reading =
            { shown | selectedView = readingSlot r.settings.epoch ua }

        staleKey =
            after r.settings [ press shown "a" ] reloaded

        undrawnKey =
            after r.settings [ press reading "a" ] reloaded
    in
    offers shown ua
        && not (offers reading ua)
        && DecisionSlot.notSavedOf staleKey.decision == Just (SaveRefused DrawnChanged)
        && DecisionSlot.notSavedOf undrawnKey.decision == Just (SaveRefused DrawnChanged)
        && staleKey.decision /= savingSlot r.settings.epoch ua
        && undrawnKey.decision /= savingSlot r.settings.epoch ua


-- The approve key pressed while `a` was selected never decides `b`, the
-- card selected and shown by the time it arrives. Red if the key reads the
-- model's selection.
keyApproveNeverDecidesUndrawnSelection : Reshown -> Bool
keyApproveNeverDecidesUndrawnSelection r =
    let
        ua =
            r.a.unit.uid

        ub =
            r.b.unit.uid

        shown =
            queueModel [ r.a, r.b ] (ViewShown r.a)

        moved =
            after r.settings [ SelectUnit 1 ] shown

        settled =
            after r.settings (viewDone r.settings.epoch ub (Ok (Just r.b))) moved

        keyed =
            after r.settings [ press shown "a" ] settled
    in
    offers shown ua
        && offers settled ub
        && keyed.decision /= savingSlot r.settings.epoch ub
        && keyed.decision /= savingSlot r.settings.epoch ua
        && DecisionSlot.notSavedOf keyed.decision == Just (SaveRefused SourceNotShown)


-- An acknowledgement drawn on the file's first digest and received after a
-- queue load listed it under another decides nothing; the acknowledgement
-- drawn after the load saves. Red if the gate compares the file's uid and
-- target only.
staleAckAfterDigestChangeDecidesNothing : Reshown -> Bool
staleAckAfterDigestChangeDecidesNothing r =
    let
        fileUid =
            r.file.uid

        listed =
            withRefusal r.file (queueModel [ r.a, r.b ] (ViewShown r.a))

        reloading =
            after r.settings [ Navigated QueuePage ] listed

        changedPage =
            queuePageOf [ r.a, r.b ]

        reloaded =
            after r.settings (queueDone reloading.queueLoad (Ok { changedPage | refusals = [ r.file2 ] })) reloading

        stale =
            after r.settings (drawnOn listed fileUid ApproveRow) reloaded

        fresh =
            after r.settings (drawnOn stale fileUid ApproveRow) stale
    in
    r.file.digest /= r.file2.digest
        && offers listed fileUid
        && offers reloaded fileUid
        && DecisionSlot.notSavedOf stale.decision == Just (SaveRefused DrawnChanged)
        && stale.decision /= savingSlot r.settings.epoch fileUid
        && fresh.decision == savingSlot r.settings.epoch fileUid


-- A refusal drawn on `a` and received after the read settled `a2` opens no
-- panel and says why. Red if the panel opens on an offer whose content
-- changed.
staleRefuseStartOpensNoPanel : Reshown -> Bool
staleRefuseStartOpensNoPanel r =
    let
        ua =
            r.a.unit.uid

        ( shown, reloaded ) =
            reshownCard r

        stale =
            after r.settings (drawnOn shown ua RefuseStart) reloaded

        fresh =
            after r.settings (drawnOn reloaded ua RefuseStart) reloaded
    in
    offers shown ua
        && DecisionSlot.openPanel stale.decision == Nothing
        && DecisionSlot.notSavedOf stale.decision == Just (SaveRefused DrawnChanged)
        && DecisionSlot.openPanel fresh.decision == Just ( ua, { refuseDraft = Draft.empty, refuseError = Nothing } )


-- Enter in the open panel submits only the panel row its render drew: the
-- offers baked from that render save, while offers naming another row, a
-- file, or `a`'s content before the read settled `a2` decide nothing and
-- keep the draft. Red if Confirm binds the model's panel row instead of the
-- drawn one.
confirmRefuseBindsDrawnPanelRow : Reshown -> Bool
confirmRefuseBindsDrawnPanelRow r =
    let
        ua =
            r.a.unit.uid

        ( shown, reloaded ) =
            reshownCard r

        drafted =
            after r.settings (drawnOn reloaded ua RefuseStart ++ draftOn (refusalOpened r.settings reloaded ua) ua "needs a test") reloaded

        fileOffer =
            Session.decidableRow (withRefusal r.file reloaded) r.file.uid

        confirmed =
            after r.settings [ press drafted "Enter" ] drafted

        withPanel panel =
            after r.settings [ KeyDown (Session.PanelDrawn panel) "Enter" ] drafted

        clickedFile =
            after r.settings (drawnOn (withRefusal r.file reloaded) r.file.uid RefuseSubmit) drafted
    in
    panelKeysDrawn drafted
        && fileOffer /= Nothing
        && confirmed.decision == savingSlot r.settings.epoch ua
        && withPanel (Session.decidableRow shown ua) == drafted
        && withPanel fileOffer == drafted
        && clickedFile == drafted
        && DecisionSlot.openPanel drafted.decision == Just ( ua, { refuseDraft = Draft.draft "needs a test", refuseError = Nothing } )


-- A key typed into a refusal panel stays panel input on either side of the
-- panel's drawing: every key but Enter and Escape pressed on a render that
-- drew the panel and received after it closed, and pressed on a render that
-- drew no panel and received after one opened, leaves the model as it was.
-- Red if the key is read by the panel the model holds when it arrives alone,
-- or by the panel its render drew alone.
panelKeysNeverDecideAcrossPanelDrawing : Reshown -> Bool
panelKeysNeverDecideAcrossPanelDrawing r =
    let
        ua =
            r.a.unit.uid

        ( _, reloaded ) =
            reshownCard r

        drafted =
            after r.settings (drawnOn reloaded ua RefuseStart ++ draftOn (refusalOpened r.settings reloaded ua) ua "awkward") reloaded

        cancelled =
            after r.settings (cancelOn drafted ua) drafted

        opened =
            after r.settings (drawnOn reloaded ua RefuseStart) reloaded
    in
    panelKeysDrawn drafted
        && DecisionSlot.openPanel cancelled.decision == Nothing
        && DecisionSlot.openPanel opened.decision /= Nothing
        && List.all (\key -> after r.settings [ press drafted key ] cancelled == cancelled) reasonKeys
        && List.all (\key -> after r.settings [ press reloaded key ] opened == opened) reasonKeys


-- Every key of `allKeys` but the panel's own Enter and Escape.
reasonKeys : List String
reasonKeys =
    List.filter (\key -> key /= "Enter" && key /= "Escape") allKeys


-- A render's key offers follow what it draws: no queue page draws nothing,
-- an open panel draws its row, a panel whose row's shown content moved
-- before any step draws no row, a card whose source read is in flight draws
-- the card with no offer, and a queue still loading draws no card. Across
-- every fixture the offers name a panel row exactly when the page draws the
-- panel's reason field or Confirm. Red if a page gate is dropped, if the
-- keys' panel predicate drifts from the view's, or if it keys the panel by
-- uid alone.
keyOffersFollowTheDrawing : Reshown -> Bool
keyOffersFollowTheDrawing r =
    let
        ua =
            r.a.unit.uid

        ( shown, reloaded ) =
            reshownCard r

        history =
            after r.settings [ ShowHistory ] shown

        unitPage =
            after r.settings [ Navigated (unitAt ua) ] shown

        opened =
            after r.settings (drawnOn shown ua RefuseStart) shown

        reading =
            { shown | selectedView = readingSlot r.settings.epoch ua }

        loading =
            after r.settings [ NextPage Index.Start ] shown

        listed =
            withRefusal r.file reloaded

        fileOpened =
            after r.settings (drawnOn listed r.file.uid RefuseStart) listed

        stale =
            { opened | selectedView = ViewShown r.a2 }
    in
    offers shown ua
        && history.page == HistoryPage
        && loading.queueState == Loading
        && Session.keyOffers history == Session.NothingDrawn
        && Session.keyOffers unitPage == Session.NothingDrawn
        && Session.keyOffers opened == Session.PanelDrawn (Session.decidableRow shown ua)
        && Session.keyOffers reading == Session.CardsDrawn (Just { uid = ua, offer = Nothing })
        && Session.keyOffers loading == Session.CardsDrawn Nothing
        && Session.keyOffers shown == Session.CardsDrawn (Just { uid = ua, offer = Session.decidableRow shown ua })
        && panelKeysDrawn fileOpened
        && Session.keyOffers stale == Session.PanelDrawn Nothing
        && List.all (\m -> panelKeysDrawn m == panelDrawn (page m)) [ shown, reloaded, history, unitPage, opened, stale, reading, loading, listed, fileOpened ]


-- A key's mode over every drawn offer and every receipt: off the queue page
-- at receipt, or with nothing drawn, no key acts; a drawn panel is read as
-- that panel on every queue-page receipt; a drawn card is read as an undrawn
-- panel while a panel is open at receipt, as shortcuts on that card over the
-- cards held, and as nothing while the queue loads. Red if any precedence of
-- `Session.keyMode` moves.
keyModeTable : Reshown -> Bool
keyModeTable r =
    let
        ua =
            r.a.unit.uid

        shown =
            queueModel [ r.a, r.b ] (ViewShown r.a)

        rowA =
            Session.decidableRow shown ua

        cardA =
            { uid = ua, offer = rowA }

        history =
            after r.settings [ ShowHistory ] shown

        opened =
            after r.settings (drawnOn shown ua RefuseStart) shown

        loading =
            after r.settings [ NextPage Index.Start ] shown

        onQueue =
            [ opened, shown, loading ]

        cell =
            \drawn receipt expected -> Just (Session.keyMode drawn receipt) == expected

        dormant =
            Just Keys.Dormant

        onCards =
            \card -> Maybe.map (Keys.OnCards card) (Keys.position 0 2)
    in
    rowA /= Nothing
        && history.page == HistoryPage
        && DecisionSlot.openPanel opened.decision /= Nothing
        && loading.queueState == Loading
        && List.all (\drawn -> cell drawn history dormant) [ Session.NothingDrawn, Session.PanelDrawn rowA, Session.PanelDrawn Nothing, Session.CardsDrawn (Just cardA), Session.CardsDrawn Nothing ]
        && List.all (\receipt -> cell Session.NothingDrawn receipt dormant) onQueue
        && List.all (\receipt -> cell (Session.PanelDrawn rowA) receipt (Just (Keys.InPanel rowA))) onQueue
        && List.all (\receipt -> cell (Session.PanelDrawn Nothing) receipt (Just (Keys.InPanel Nothing))) onQueue
        && cell (Session.CardsDrawn (Just cardA)) opened (Just (Keys.InPanel Nothing))
        && cell (Session.CardsDrawn (Just cardA)) shown (onCards (Just cardA))
        && cell (Session.CardsDrawn (Just cardA)) loading dormant
        && cell (Session.CardsDrawn Nothing) opened (Just (Keys.InPanel Nothing))
        && cell (Session.CardsDrawn Nothing) shown (onCards Nothing)
        && cell (Session.CardsDrawn Nothing) loading dormant


-- Every key pressed on a History render and received on the queue page, or
-- pressed on the queue page and received on History, leaves the model as it
-- was. Red without either page gate.
keysPressedOffTheQueuePageActNowhere : Reshown -> Bool
keysPressedOffTheQueuePageActNowhere r =
    let
        shown =
            queueModel [ r.a, r.b ] (ViewShown r.a)

        history =
            after r.settings [ ShowHistory ] shown
    in
    history.page == HistoryPage
        && (after r.settings [ press shown "j" ] shown).selected == 1
        && List.all (\key -> after r.settings [ press history key ] shown == shown) allKeys
        && List.all (\key -> after r.settings [ press shown key ] history == history) allKeys


-- Escape pressed on a render whose panel was open on `a`, and Cancel drawn
-- on `a`'s panel, each received after the panel moved to the listed file,
-- leave the file's panel and its draft; Escape pressed on the file's panel
-- closes it. Red if a cancel closes whatever panel is open.
staleCancelKeepsAnotherPanel : Reshown -> Bool
staleCancelKeepsAnotherPanel r =
    let
        ua =
            r.a.unit.uid

        fu =
            r.file.uid

        listed =
            withRefusal r.file (queueModel [ r.a, r.b ] (ViewShown r.a))

        onA =
            after r.settings (drawnOn listed ua RefuseStart) listed

        onFile =
            after r.settings (drawnOn onA fu RefuseStart) onA

        fileDrafted =
            after r.settings (draftOn onFile fu "not ours") onFile
    in
    panelKeysDrawn onA
        && DecisionSlot.openPanel fileDrafted.decision == Just ( fu, { refuseDraft = Draft.draft "not ours", refuseError = Nothing } )
        && after r.settings [ press onA "Escape" ] fileDrafted == fileDrafted
        && after r.settings (cancelOn onA ua) fileDrafted == fileDrafted
        && DecisionSlot.openPanel (after r.settings [ press fileDrafted "Escape" ] fileDrafted).decision == Nothing


-- A reason typed into the panel drawn on `a`'s first digest, received after
-- the panel reopened on `a2`, leaves `a2`'s draft empty; the edit typed into
-- the `a2` panel lands. Red if an edit lands by uid alone.
staleDraftEditLandsNowhere : Reshown -> Bool
staleDraftEditLandsNowhere r =
    let
        ua =
            r.a.unit.uid

        ( shown, reloaded ) =
            reshownCard r

        firstOpened =
            refusalOpened r.settings shown ua

        reopened =
            after r.settings (drawnOn reloaded ua RefuseStart) reloaded
    in
    offers shown ua
        && draftOn firstOpened ua "x" /= []
        && Session.decidableRow shown ua /= Session.decidableRow reloaded ua
        && DecisionSlot.openPanel reopened.decision == Just ( ua, { refuseDraft = Draft.empty, refuseError = Nothing } )
        && after r.settings (draftOn firstOpened ua "x") reopened == reopened
        && DecisionSlot.openPanel (after r.settings (draftOn reopened ua "x") reopened).decision == Just ( ua, { refuseDraft = Draft.draft "x", refuseError = Nothing } )


-- Navigation moves from where the selection stands when the key arrives:
-- `j` pressed twice on one render of three cards selects the third, and `g`
-- then selects the first.
navigationComposesBeforeRedraw : Reshown -> Bool
navigationComposesBeforeRedraw r =
    let
        three =
            queueModel [ r.a, r.b, renamed "u-c" r.b ] (ViewShown r.a)

        twice =
            after r.settings [ press three "j", press three "j" ] three
    in
    twice.selected == 2
        && (after r.settings [ press three "g" ] twice).selected == 0


-- Escape pressed on the render before a panel opened, received with the
-- panel open, keeps the panel and its draft; Escape pressed on the panel's
-- render closes it. Red if the receipt panel yields a payload.
escapeBeforePanelDrawnKeepsPanel : Reshown -> Bool
escapeBeforePanelDrawnKeepsPanel r =
    let
        ua =
            r.a.unit.uid

        shown =
            queueModel [ r.a, r.b ] (ViewShown r.a)

        drafted =
            after r.settings (drawnOn shown ua RefuseStart ++ draftOn (refusalOpened r.settings shown ua) ua "needs a test") shown
    in
    DecisionSlot.openPanel drafted.decision == Just ( ua, { refuseDraft = Draft.draft "needs a test", refuseError = Nothing } )
        && after r.settings [ press shown "Escape" ] drafted == drafted
        && DecisionSlot.openPanel (after r.settings [ press drafted "Escape" ] drafted).decision == Nothing


-- `decisionPlan` binds the offer's digest on its own: an offer of `a`
-- planned on a model showing `a2`, and an offer of the file's first digest
-- planned on a page listing the second, are each refused as `DrawnChanged`
-- before any database is opened, the gate before the slot refuses both
-- offers too, and neither click starts a task. Red if the plan reads the
-- model's current source or the page's digest.
reshownPlanRefusals : Result DecideRefusal Session.DecisionPlan -> Result DecideRefusal Session.DecisionPlan -> Bool -> Bool
reshownPlanRefusals unitDrift fileDrift gated =
    refusalOf unitDrift == Just DrawnChanged
        && refusalOf fileDrift == Just DrawnChanged
        && gated


-- Every refusal of a decision before its slot returns no effect: one asked
-- on the unit page or History, one on a read-only server, one whose drawn
-- source was read again since, one on a row the page does not list, and
-- one asked while another decision is saving. The same approval on the
-- page it was drawn on returns exactly one save, the positive control.
-- The plan's own refusal is reached on no model these checks build, which
-- `decidableImpliesPlan` pins. Red if a refused decision returns a task.
refusedDecisionEmitsNoEffect : Reshown -> Bool
refusedDecisionEmitsNoEffect r =
    let
        settings =
            r.settings

        ua =
            r.a.unit.uid

        ub =
            r.b.unit.uid

        shown =
            queueModel [ r.a, r.b ] (ViewShown r.a)

        approve =
            drawnOn shown ua ApproveRow

        ( _, reloaded ) =
            reshownCard r

        saving =
            after settings approve shown

        unlisted =
            drawnOn (cardModel [ r.a, r.b ] 1 r.b) ub ApproveRow
    in
    offers shown ua
        && startsNothing settings approve { shown | page = unitAt ua }
        && startsNothing settings approve { shown | page = HistoryPage }
        && startsNothing { settings | key = ReadOnly } approve shown
        && startsNothing settings approve reloaded
        && startsNothing settings unlisted (queueModel [ r.a ] (ViewShown r.a))
        && startsNothing settings approve saving
        && DecisionSlot.notSavedOf (after settings approve reloaded).decision == Just (SaveRefused DrawnChanged)
        && startsExactly decisionStart (DecisionSlot.savingStamp saving.decision) (effectsOf settings approve shown)


-- Over every model these checks build and every offer any of them draws,
-- an offer the gate before the slot admits is one `decisionPlan` plans, so
-- the plan's refusal in `saveDecision` is a second edge no session reaches
-- first. Red if the gate admits an offer its plan refuses.
decidableImpliesPlan : Reshown -> Bool
decidableImpliesPlan r =
    let
        ( _, reloaded ) =
            reshownCard r

        file =
            r.file

        models =
            [ queueModel [ r.a, r.b ] (ViewShown r.a)
            , cardModel [ r.a, r.b ] 1 r.b
            , queueModel [ r.a ] (ViewShown r.a)
            , queueModel [ r.a2, r.b ] (ViewShown r.a2)
            , reloaded
            , reloadingModel r.a
            , withRefusal r.file (queueModel [ r.a, r.b ] (ViewShown r.a))
            , withRefusal r.file2 (queueModel [ r.a, r.b ] (ViewShown r.a))
            , withRefusal { file | digest = Nothing } (queueModel [ r.a, r.b ] (ViewShown r.a))
            ]

        offersDrawn =
            List.concatMap (\model -> List.filterMap (Session.decidableRow model) [ r.a.unit.uid, r.b.unit.uid, r.file.uid ]) models
    in
    List.length offersDrawn >= 4
        && List.all (\model -> List.all (planFollowsGate model) offersDrawn) models
        && List.any (\model -> List.any (gateAdmits model) offersDrawn) models


gateAdmits : Model -> DecisionSlot.DecidableRow -> Bool
gateAdmits model offer =
    case gateOn model offer of
        Ok _ ->
            True

        Err _ ->
            False


reshownChecks : Task.Task Error (List ( String, Bool ))
reshownChecks =
    do
        at <- freshScratch "ipe-single-flight-reshown"
        seedIndex at.indexDb at.repo
        insertLinkRefusal at.indexDb "a"
        reviewStoreAt at
        settings <- envAppSettings
        a <- loadUnitNow (uid "u-a") |> Task.andThen requireUnit
        b <- loadUnitNow (uid "u-b") |> Task.andThen requireUnit
        file <- linkRow
        execIndex at.indexDb "UPDATE refusals SET digest = ? WHERE uid = ?" [ SqlString (linkDigest "b"), Uid.toSql (uid "r-link") ]
        file2 <- linkRow
        writeFileText (at.repo ++ "/src/Lib.rs") (String.replace "42" "43" fixtureLibRs)
        execIndex at.indexDb "UPDATE units SET body_hash = ? WHERE uid = ?" [ SqlString (Index.attest (String.replace "42" "43" viewA)), Uid.toSql (uid "u-a") ]
        a2 <- loadUnitNow (uid "u-a") |> Task.andThen requireUnit
        offerA <- requireOffer (Session.decidableRow (queueModel [ a, b ] (ViewShown a)) a.unit.uid)
        offerFile <- requireOffer (Session.decidableRow (withRefusal file (queueModel [ a, b ] (ViewShown a))) file.uid)
        unitDrift <- Task.succeed (Session.decisionPlan (queueModel [ a2, b ] (ViewShown a2)) offerA)
        fileDrift <- Task.succeed (Session.decisionPlan (withRefusal file2 (queueModel [ a, b ] (ViewShown a))) offerFile)
        gated <- Task.succeed (List.all (\( model, offer ) -> planFollowsGate model offer && refusedStartsNoTask settings model offer) [ ( queueModel [ a2, b ] (ViewShown a2), offerA ), ( withRefusal file2 (queueModel [ a, b ] (ViewShown a)), offerFile ) ])
        cleanupIndex at.indexDb at.repo
        removeFileIfAny at.reviewDb
        Task.succeed (reshownRows { settings = settings, a = a, a2 = a2, b = b, file = file, file2 = file2 } unitDrift fileDrift gated)


reshownRows : Reshown -> Result DecideRefusal Session.DecisionPlan -> Result DecideRefusal Session.DecisionPlan -> Bool -> List ( String, Bool )
reshownRows r unitDrift fileDrift gated =
    [ ( "an approval drawn before the source was read again decides nothing", staleApproveAfterSourceReloadDecidesNothing r )
    , ( "an approval drawn after the source was read again saves", freshApproveAfterSourceReloadSaves r )
    , ( "the approve key drawn before the source was read again, or with no control drawn, decides nothing", staleKeyApproveDecidesNothing r )
    , ( "the approve key never decides a card selected after it was pressed", keyApproveNeverDecidesUndrawnSelection r )
    , ( "an acknowledgement drawn before the file's digest changed decides nothing", staleAckAfterDigestChangeDecidesNothing r )
    , ( "a refusal drawn before the source was read again opens no panel", staleRefuseStartOpensNoPanel r )
    , ( "Confirm submits only the panel row its render drew", confirmRefuseBindsDrawnPanelRow r )
    , ( "a key typed into a refusal panel records nothing after the panel closes or before it is drawn", panelKeysNeverDecideAcrossPanelDrawing r )
    , ( "a render's key offers follow what it draws", keyOffersFollowTheDrawing r )
    , ( "a key's mode follows the drawn offer and the receipt by precedence", keyModeTable r )
    , ( "a key pressed or received off the queue page acts nowhere", keysPressedOffTheQueuePageActNowhere r )
    , ( "a cancel drawn on one panel keeps another panel open", staleCancelKeepsAnotherPanel r )
    , ( "a reason typed into a panel since reopened lands nowhere", staleDraftEditLandsNowhere r )
    , ( "navigation keys compose before the page redraws", navigationComposesBeforeRedraw r )
    , ( "Escape pressed before a panel was drawn keeps the panel", escapeBeforePanelDrawnKeepsPanel r )
    , ( "a decision plan binds the drawn source and digest before any read", reshownPlanRefusals unitDrift fileDrift gated )
    , ( "every decision refused before its slot returns no effect", refusedDecisionEmitsNoEffect r )
    , ( "every offer the gate before the slot admits is one its plan writes", decidableImpliesPlan r )
    ]


-- ── one task in flight per load slot ────────────────────────────────────
-- The queue, History and standing slots each hold at most one load in
-- flight: a request made while one runs is recorded as wanted, a result
-- arriving with a want held is dropped and the want starts, and a slot
-- owned by another process's epoch is idle.
cursorAfter : Int -> String -> Index.Cursor
cursorAfter at unit =
    Index.After { enqueuedAt = at, uid = uid unit }


historyAfter : Int -> LibDb.HistoryCursor
historyAfter seq =
    LibDb.HistoryAfter (Timestamp.fromUnixMillis seq) seq


-- One press on an idle queue slot starts exactly one load, its ticket the
-- next one: the positive control the single-flight checks compare against.
idlePressStartsOneLoad : Settings.AppSettings -> Bool
idlePressStartsOneLoad settings =
    let
        running =
            after settings [ Navigated QueuePage ] initialModel
    in
    Slot.latestTicket running.queueLoad == Slot.nextTicket (Slot.latestTicket initialModel.queueLoad)
        && Slot.runningWant settings.epoch running.queueLoad == Just Nothing
        && Slot.runningWant settings.epoch initialModel.queueLoad == Nothing
        && startsExactly queueStart (Slot.runningLoad running.queueLoad) (effectsOf settings [ Navigated QueuePage ] initialModel)


-- Pages turned, the queue shown again and a unit page entered while a queue
-- load runs start no second load: the ticket stays the one in flight and
-- only the last page asked for is wanted, and a unit-page entry, which only
-- needs the queue loaded, records nothing. Red if any press starts a load
-- beside the one in flight, or the entry records a want.
queueLoadsSingleFlight : Settings.AppSettings -> Index.UnitView -> Bool
queueLoadsSingleFlight settings a =
    let
        running =
            after settings [ Navigated QueuePage ] initialModel

        inFlightTicket =
            Slot.latestTicket running.queueLoad

        pressed =
            after settings [ ShowQueue, NextPage (cursorAfter 1 "u-a"), NextPage (cursorAfter 2 "u-b") ] running

        entered =
            after settings [ Navigated (unitAt a.unit.uid) ] running
    in
    Slot.latestTicket pressed.queueLoad == inFlightTicket
        && Slot.runningWant settings.epoch pressed.queueLoad == Just (Just (QueueReload (cursorAfter 2 "u-b")))
        && Slot.latestTicket entered.queueLoad == inFlightTicket
        && Slot.runningWant settings.epoch entered.queueLoad == Just Nothing
        && startsNone queueStart (effectsOf settings [ ShowQueue, NextPage (cursorAfter 1 "u-a"), NextPage (cursorAfter 2 "u-b") ] running)
        && startsNone queueStart (effectsOf settings [ Navigated (unitAt a.unit.uid) ] running)


-- The running queue load's page returning while another page is wanted is
-- dropped: the queue stays loading, the wanted load starts under the next
-- ticket, and its page settles the queue. A result under a ticket no longer
-- in flight changes nothing. Red if a superseded page is shown.
supersededQueueResultDropped : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
supersededQueueResultDropped settings a b =
    let
        running =
            after settings [ Navigated QueuePage ] initialModel

        first =
            Slot.latestTicket running.queueLoad

        firstLoad =
            Slot.runningLoad running.queueLoad

        wanting =
            after settings [ NextPage (cursorAfter 2 "u-b") ] running

        dropped =
            after settings (completions PendingLoaded firstLoad (Ok (queuePageOf [ a, b ]))) wanting

        late =
            after settings (completions PendingLoaded firstLoad (Ok (queuePageOf [ a, b ]))) dropped

        settled =
            after settings (queueDone dropped.queueLoad (Ok (queuePageOf [ b ]))) late
    in
    firstLoad /= Nothing
        && dropped.queueState == Loading
        && Slot.latestTicket dropped.queueLoad == Slot.nextTicket first
        && Slot.runningWant settings.epoch dropped.queueLoad == Just Nothing
        && late.queueState == Loading
        && Slot.latestTicket late.queueLoad == Slot.latestTicket dropped.queueLoad
        && settled.queueState == Loaded (queuePageOf [ b ])
        && Slot.runningWant settings.epoch settled.queueLoad == Nothing
        && startsNone queueStart (effectsOf settings [ NextPage (cursorAfter 2 "u-b") ] running)
        && startsExactly queueStart (Slot.runningLoad dropped.queueLoad) (effectsOf settings (completions PendingLoaded firstLoad (Ok (queuePageOf [ a, b ]))) wanting)
        && startsNone queueStart (effectsOf settings (completions PendingLoaded firstLoad (Ok (queuePageOf [ a, b ]))) dropped)
        && startsNone queueStart (effectsOf settings (queueDone dropped.queueLoad (Ok (queuePageOf [ b ]))) late)


-- A decision saved while a queue load runs waits for the drain: the load
-- read before the write returns, is dropped, and the decision stays
-- refreshing with the decided row still offering no control; the drain's
-- page ends it. Red if the page read before the write idles the decision.
refreshingSettlesOnlyAfterWrite : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> ( Index.Attested, Index.Written ) -> Bool
refreshingSettlesOnlyAfterWrite settings a b ( attested, written ) =
    let
        ua =
            a.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        loadingWhileSaving =
            after settings (drawnOn shown ua ApproveRow ++ [ Navigated QueuePage ]) shown

        saved =
            after settings (decisionDone settings.epoch ua (Ok ( attested, written ))) loadingWhileSaving

        preWrite =
            after settings (queueDone loadingWhileSaving.queueLoad (Ok (queuePageOf [ a, b ]))) saved

        drained =
            after settings (queueDone preWrite.queueLoad (Ok (queuePageOf [ b ]))) preWrite
    in
    Slot.runningWant settings.epoch saved.queueLoad == Just (Just (QueueDrain attested written Index.Start))
        && preWrite.decision == refreshingSlot settings.epoch ua
        && not (String.contains ">Approve<" (page preWrite))
        && Slot.runningWant settings.epoch preWrite.queueLoad == Just Nothing
        && drained.decision == DecisionIdle PanelClosed
        && drained.queueState == Loaded (queuePageOf [ b ])
        && startsNone queueStart (effectsOf settings (decisionDone settings.epoch ua (Ok ( attested, written ))) loadingWhileSaving)
        && startsExactly queueStart (Slot.runningLoad preWrite.queueLoad) (effectsOf settings (queueDone loadingWhileSaving.queueLoad (Ok (queuePageOf [ a, b ]))) saved)


-- A wanted drain absorbs a reload asked after it, taking the reload's
-- cursor, and a drain asked after a wanted reload replaces it: no saved
-- decision's drain is lost to a page turn. Red if a reload drops the
-- drain it follows, for each of the four merge pairs. The save is started
-- on the slot, so its own completion is the one that drains.
drainAbsorbsReload : Settings.AppSettings -> ( Index.Attested, Index.Written ) -> Bool
drainAbsorbsReload settings ( attested, written ) =
    let
        c1 =
            cursorAfter 1 "u-a"

        c2 =
            cursorAfter 2 "u-b"

        ua =
            uid "u-a"

        queued =
            after settings [ Navigated QueuePage ] initialModel

        running =
            { queued | decision = savingSlot settings.epoch ua }

        drainThenPage =
            after settings (decisionDone settings.epoch ua (Ok ( attested, written )) ++ [ NextPage c2 ]) running

        pageThenDrain =
            after settings ([ NextPage c2 ] ++ decisionDone settings.epoch ua (Ok ( attested, written ))) running
    in
    Queue.mergeQueueWant (QueueDrain attested written c1) (QueueReload c2) == QueueDrain attested written c2
        && Queue.mergeQueueWant (QueueReload c1) (QueueDrain attested written c2) == QueueDrain attested written c2
        && Queue.mergeQueueWant (QueueDrain attested written c1) (QueueDrain attested written c2) == QueueDrain attested written c2
        && Queue.mergeQueueWant (QueueReload c1) (QueueReload c2) == QueueReload c2
        && Slot.runningWant settings.epoch drainThenPage.queueLoad == Just (Just (QueueDrain attested written c2))
        && Slot.runningWant settings.epoch pageThenDrain.queueLoad == Just (Just (QueueDrain attested written c2))


-- History shown again and paged while a History load runs starts no second
-- load: only the last page asked for is wanted. A result under another
-- ticket changes nothing, the running load's result is dropped for the
-- want, and the want's page settles the History. Red if a press starts a
-- second History load or a superseded page is shown.
historyLoadsSingleFlight : Settings.AppSettings -> Bool
historyLoadsSingleFlight settings =
    let
        running =
            after settings [ Navigated HistoryPage ] initialModel

        first =
            Slot.latestTicket running.historyLoad

        firstLoad =
            Slot.runningLoad running.historyLoad

        otherLoad =
            anotherLoad settings.epoch (HistoryFrom (historyAfter 1)) running.historyLoad

        pressed =
            after settings [ ShowHistory, HistoryNext (historyAfter 1), HistoryNext (historyAfter 2) ] running

        historyPage =
            { rows = [], at = LibDb.HistoryStart, next = Nothing, log = LibDb.ShownProven }

        stale =
            after settings (completions App.historyLoaded otherLoad (Ok historyPage)) pressed

        dropped =
            after settings (completions App.historyLoaded firstLoad (Ok historyPage)) stale

        settled =
            after settings (historyLoadedOn dropped.historyLoad (Ok { historyPage | at = historyAfter 2 })) dropped
    in
    otherLoad /= Nothing
        && Maybe.map Slot.stampKey otherLoad == Just (Slot.nextTicket first)
        && firstLoad /= Nothing
        && Slot.latestTicket pressed.historyLoad == first
        && Slot.runningWant settings.epoch pressed.historyLoad == Just (Just (HistoryFrom (historyAfter 2)))
        && stale.history == HistoryLoading
        && Slot.latestTicket stale.historyLoad == first
        && dropped.history == HistoryLoading
        && Slot.latestTicket dropped.historyLoad == Slot.nextTicket first
        && historyFailure settled.history == Nothing
        && settled.history /= HistoryLoading
        && Slot.runningWant settings.epoch settled.historyLoad == Nothing
        && startsExactly historyStart firstLoad (effectsOf settings [ Navigated HistoryPage ] initialModel)
        && startsNone historyStart (effectsOf settings [ ShowHistory, HistoryNext (historyAfter 1), HistoryNext (historyAfter 2) ] running)
        && startsNothing settings (completions App.historyLoaded otherLoad (Ok historyPage)) pressed
        && startsExactly historyStart (Slot.runningLoad dropped.historyLoad) (effectsOf settings (completions App.historyLoaded firstLoad (Ok historyPage)) stale)
        && startsNone historyStart (effectsOf settings (historyLoadedOn dropped.historyLoad (Ok { historyPage | at = historyAfter 2 })) dropped)


-- Two source reads settling on the unit page while a standing read runs
-- start no second standing read: the second body is wanted, the first
-- read's result is dropped for it, and its own result is shown. Red if a
-- settled source read starts a standing read beside the one in flight, or
-- the first body's standing is shown for the second.
standingSingleFlight : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
standingSingleFlight settings a b =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        hashA =
            Index.storedHash a.unit.attested

        hashB =
            Index.storedHash b.unit.attested

        reading =
            after settings ([ Navigated (unitAt ua) ] ++ viewDone settings.epoch ua (Ok (Just a))) (queueModel [ a, b ] NoneSelected)

        second =
            after settings ([ Navigated (unitAt ub) ] ++ viewDone settings.epoch ub (Ok (Just b))) reading

        firstReturned =
            after settings (standingLoadedFor settings.epoch ua hashA (Ok Standing.Undecided)) second

        stale =
            after settings (standingLoadedFor settings.epoch ua hashA (Ok Standing.Undecided)) firstReturned

        shown =
            after settings (standingLoadedFor settings.epoch ub hashB (Ok Standing.Undecided)) stale
    in
    reading.standing == standingReading settings.epoch ua hashA
        && second.standing == Tuple.first (Standing.standingRequested settings.epoch ub hashB (standingReading settings.epoch ua hashA))
        && firstReturned.standing == standingReading settings.epoch ub hashB
        && stale.standing == standingReading settings.epoch ub hashB
        && shown.standing == StandingShown ub hashB Standing.Undecided
        && startsNone standingStart (effectsOf settings ([ Navigated (unitAt ub) ] ++ viewDone settings.epoch ub (Ok (Just b))) reading)
        && startsExactly standingStart (Standing.runningStanding firstReturned.standing) (effectsOf settings (standingLoadedFor settings.epoch ua hashA (Ok Standing.Undecided)) second)
        && startsNothing settings (standingLoadedFor settings.epoch ua hashA (Ok Standing.Undecided)) firstReturned
        && startsNone standingStart (effectsOf settings (standingLoadedFor settings.epoch ub hashB (Ok Standing.Undecided)) stale)


-- A load slot or standing read held under another process's epoch is idle:
-- a request starts a load, and a result arriving for it is dropped with
-- the slot unchanged. Red if a dead process's slot blocks a load or its
-- result settles this process's slot.
foreignLoadSlotIdle : Settings.AppSettings -> Epoch -> Index.UnitView -> Bool
foreignLoadSlotIdle settings otherEpoch a =
    let
        ( foreignSlot, _ ) =
            Slot.requestLoad Queue.mergeQueueWant otherEpoch (QueueReload Index.Start) Slot.idleLoad

        foreignTicket =
            Slot.latestTicket foreignSlot

        foreignLoad =
            Slot.runningLoad foreignSlot

        ( _, started ) =
            Slot.requestLoad Queue.mergeQueueWant settings.epoch (QueueReload Index.Start) foreignSlot

        ( settle, kept, startedOnArrival ) =
            case foreignLoad of
                Just arrivedLoad ->
                    Slot.loadArrived settings.epoch arrivedLoad foreignSlot

                Nothing ->
                    ( Settles, Slot.idleLoad, Nothing )

        held =
            { initialModel | queueLoad = foreignSlot }

        entered =
            after settings [ Navigated QueuePage ] held

        arrived =
            after settings (completions PendingLoaded foreignLoad (Ok (queuePageOf [ a ]))) held

        ua =
            a.unit.uid

        hashA =
            Index.storedHash a.unit.attested

        foreignRead =
            standingReading otherEpoch ua hashA

        foreignArrived =
            case Standing.runningStanding foreignRead of
                Just reading ->
                    Standing.standingArrived settings.epoch reading (Ok Standing.Undecided) foreignRead

                Nothing ->
                    ( StandingUnread, Nothing )
    in
    Maybe.map (\( load, want ) -> ( Slot.stampKey load, want )) started == Just ( Slot.nextTicket foreignTicket, QueueReload Index.Start )
        && settle == Dropped
        && kept == foreignSlot
        && startedOnArrival == Nothing
        && Slot.latestTicket entered.queueLoad == Slot.nextTicket foreignTicket
        && Slot.runningWant settings.epoch entered.queueLoad == Just Nothing
        && arrived.queueState == Loading
        && foreignLoad /= Nothing
        && startsExactly queueStart (Slot.runningLoad entered.queueLoad) (effectsOf settings [ Navigated QueuePage ] held)
        && startsNothing settings (completions PendingLoaded foreignLoad (Ok (queuePageOf [ a ]))) held
        && Standing.standingRequested settings.epoch ua hashA foreignRead == Standing.standingRequested settings.epoch ua hashA StandingUnread
        && foreignArrived == ( foreignRead, Nothing )


-- A running load answered with an error, the shape a refused task settles
-- with when the session's task ceiling is reached, frees its slot: with no
-- want the queue shows the failure and the next press starts a load; with
-- a want held the want starts. Red if a failed load keeps its slot taken.
ceilingRefusalReleasesSlot : Settings.AppSettings -> Bool
ceilingRefusalReleasesSlot settings =
    let
        running =
            after settings [ Navigated QueuePage ] initialModel

        first =
            Slot.latestTicket running.queueLoad

        firstLoad =
            Slot.runningLoad running.queueLoad

        refused =
            after settings (completions App.queueLoaded firstLoad (Err limitMarker)) running

        pressedAfter =
            after settings [ Navigated QueuePage ] refused

        wanting =
            after settings [ NextPage (cursorAfter 2 "u-b") ] running

        refusedWithWant =
            after settings (completions App.queueLoaded firstLoad (Err limitMarker)) wanting
    in
    queueFailure refused.queueState == Just LoadPastLimit
        && Slot.runningWant settings.epoch refused.queueLoad == Nothing
        && Slot.latestTicket pressedAfter.queueLoad == Slot.nextTicket first
        && refusedWithWant.queueState == Loading
        && Slot.latestTicket refusedWithWant.queueLoad == Slot.nextTicket first
        && Slot.runningWant settings.epoch refusedWithWant.queueLoad == Just Nothing
        && startsNone queueStart (effectsOf settings (completions App.queueLoaded firstLoad (Err limitMarker)) running)
        && startsExactly queueStart (Slot.runningLoad pressedAfter.queueLoad) (effectsOf settings [ Navigated QueuePage ] refused)
        && startsExactly queueStart (Slot.runningLoad refusedWithWant.queueLoad) (effectsOf settings (completions App.queueLoaded firstLoad (Err limitMarker)) wanting)


-- ── each task is an effect of exactly one transition ────────────────────
-- A second request on each of the five slots while the first runs returns
-- no effect for that slot: the queue and History requests are held as the
-- slot's want, a second unit page is recorded as the unit wanted after the
-- read, a second body's standing is held, and a second decision is refused
-- busy. The running task's own completion then starts the held want as
-- exactly one effect, stamped with the slot's new running stamp. Red if a
-- request made while a slot runs returns a task for it, or a held want is
-- started twice or never.
secondRequestHeldNotStarted : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
secondRequestHeldNotStarted settings a b =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        hashA =
            Index.storedHash a.unit.attested

        c2 =
            cursorAfter 2 "u-b"

        historyPage =
            { rows = [], at = LibDb.HistoryStart, next = Nothing, log = LibDb.ShownProven }

        queueRunning =
            after settings [ Navigated QueuePage ] initialModel

        queueWanting =
            after settings [ NextPage c2 ] queueRunning

        queueRestarted =
            after settings (queueDone queueRunning.queueLoad (Ok (queuePageOf [ a ]))) queueWanting

        historyRunning =
            after settings [ Navigated HistoryPage ] initialModel

        historyWanting =
            after settings [ HistoryNext (historyAfter 2) ] historyRunning

        historyRestarted =
            after settings (historyLoadedOn historyRunning.historyLoad (Ok historyPage)) historyWanting

        listed =
            queueModel [ a, b ] NoneSelected

        viewRunning =
            after settings [ Navigated (unitAt ua) ] listed

        viewWanting =
            after settings [ Navigated (unitAt ub) ] viewRunning

        viewRestarted =
            after settings (viewDone settings.epoch ua (Ok (Just a))) viewWanting

        standingRunning =
            after settings (viewDone settings.epoch ua (Ok (Just a))) viewRunning

        secondBody =
            [ Navigated (unitAt ub) ] ++ viewDone settings.epoch ub (Ok (Just b))

        standingWanting =
            after settings secondBody standingRunning

        standingRestarted =
            after settings (standingLoadedFor settings.epoch ua hashA (Ok Standing.Undecided)) standingWanting

        shown =
            queueModel [ a, b ] (ViewShown a)

        approve =
            drawnOn shown ua ApproveRow

        saving =
            after settings approve shown
    in
    startsExactly queueStart (Slot.runningLoad queueRunning.queueLoad) (effectsOf settings [ Navigated QueuePage ] initialModel)
        && startsNone queueStart (effectsOf settings [ NextPage c2, ShowQueue ] queueRunning)
        && Slot.runningWant settings.epoch queueWanting.queueLoad == Just (Just (QueueReload c2))
        && startsExactly queueStart (Slot.runningLoad queueRestarted.queueLoad) (effectsOf settings (queueDone queueRunning.queueLoad (Ok (queuePageOf [ a ]))) queueWanting)
        && startsExactly historyStart (Slot.runningLoad historyRunning.historyLoad) (effectsOf settings [ Navigated HistoryPage ] initialModel)
        && startsNone historyStart (effectsOf settings [ HistoryNext (historyAfter 2), ShowHistory ] historyRunning)
        && Slot.runningWant settings.epoch historyWanting.historyLoad == Just (Just (HistoryFrom (historyAfter 2)))
        && startsExactly historyStart (Slot.runningLoad historyRestarted.historyLoad) (effectsOf settings (historyLoadedOn historyRunning.historyLoad (Ok historyPage)) historyWanting)
        && startsExactly viewStart (Selected.runningView viewRunning.selectedView) (effectsOf settings [ Navigated (unitAt ua) ] listed)
        && startsNone viewStart (effectsOf settings [ Navigated (unitAt ub) ] viewRunning)
        && inFlight viewWanting == Just ( ua, Just ub )
        && startsExactly viewStart (Selected.runningView viewRestarted.selectedView) (effectsOf settings (viewDone settings.epoch ua (Ok (Just a))) viewWanting)
        && startsExactly standingStart (Standing.runningStanding standingRunning.standing) (effectsOf settings (viewDone settings.epoch ua (Ok (Just a))) viewRunning)
        && startsNone standingStart (effectsOf settings secondBody standingRunning)
        && startsExactly standingStart (Standing.runningStanding standingRestarted.standing) (effectsOf settings (standingLoadedFor settings.epoch ua hashA (Ok Standing.Undecided)) standingWanting)
        && startsExactly decisionStart (DecisionSlot.savingStamp saving.decision) (effectsOf settings approve shown)
        && startsNothing settings approve saving
        && saving.decision == savingSlot settings.epoch ua


-- Over the scripted sequences of the single-flight checks, every step
-- returns, for each of the five slots, the slot's new running stamp exactly
-- once when it took a stamp it did not hold or its own completion started
-- its want, and no effect for the slot otherwise; and a slot running under
-- this process's epoch stops running only on its own completion. The
-- scripts cover a press and a page turn on every load slot, a completion
-- owned, superseded, foreign and late, a refused load, a unit page entered
-- twice, a second body's standing, a second decision, a saved decision's
-- drain started and held, and a failed save followed by a new one. Red if
-- a start is returned twice, a step returns a start no transition made, or
-- a slot is cleared without its completion.
effectOncePerTransition : Settings.AppSettings -> Epoch -> Index.UnitView -> Index.UnitView -> ( Index.Attested, Index.Written ) -> Bool
effectOncePerTransition settings otherEpoch a b pair =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        hashA =
            Index.storedHash a.unit.attested

        hashB =
            Index.storedHash b.unit.attested

        listedPage =
            Ok (queuePageOf [ a, b ])

        historyPage =
            Ok { rows = [], at = LibDb.HistoryStart, next = Nothing, log = LibDb.ShownProven }

        queueRunning =
            after settings [ Navigated QueuePage ] initialModel

        queueWanting =
            after settings [ NextPage (cursorAfter 2 "u-b") ] queueRunning

        queueDropped =
            after settings (queueDone queueRunning.queueLoad listedPage) queueWanting

        foreignQueueLoad =
            Slot.runningLoad (Tuple.first (Slot.requestLoad Queue.mergeQueueWant otherEpoch (QueueReload Index.Start) Slot.idleLoad))

        historyRunning =
            after settings [ Navigated HistoryPage ] initialModel

        historyWanting =
            after settings [ HistoryNext (historyAfter 2) ] historyRunning

        listed =
            queueModel [ a, b ] NoneSelected

        unitRead =
            after settings [ Navigated (unitAt ua) ] listed

        unitShown =
            after settings (viewDone settings.epoch ua (Ok (Just a))) unitRead

        standingWanting =
            after settings ([ Navigated (unitAt ub) ] ++ viewDone settings.epoch ub (Ok (Just b))) unitShown

        shown =
            queueModel [ a, b ] (ViewShown a)

        approve =
            drawnOn shown ua ApproveRow

        saving =
            after settings approve shown

        savingLoading =
            after settings [ Navigated QueuePage ] saving

        scripts =
            [ ( initialModel, [ Navigated QueuePage, ShowQueue, NextPage (cursorAfter 1 "u-a"), NextPage (cursorAfter 2 "u-b"), Navigated (unitAt ua) ] )
            , ( queueRunning, queueDone queueRunning.queueLoad listedPage ++ [ Navigated QueuePage ] )
            , ( queueWanting, queueDone queueRunning.queueLoad listedPage )
            , ( queueDropped, queueDone queueRunning.queueLoad listedPage ++ queueDone queueDropped.queueLoad listedPage )
            , ( queueRunning, queueLoadedOn queueRunning.queueLoad (Err limitMarker) ++ [ Navigated QueuePage ] )
            , ( queueRunning, completions PendingLoaded foreignQueueLoad listedPage )
            , ( initialModel, [ Navigated HistoryPage, ShowHistory, HistoryNext (historyAfter 1), HistoryNext (historyAfter 2) ] )
            , ( historyRunning, completions HistoryPageLoaded (Slot.runningLoad historyRunning.historyLoad) historyPage ++ [ ShowHistory ] )
            , ( historyWanting, completions HistoryPageLoaded (Slot.runningLoad historyRunning.historyLoad) historyPage ++ completions HistoryPageLoaded (Slot.runningLoad historyRunning.historyLoad) historyPage )
            , ( listed, [ Navigated (unitAt ua), Navigated (unitAt ub) ] ++ viewDone settings.epoch ua (Ok (Just a)) ++ viewDone settings.epoch ub (Ok (Just b)) )
            , ( unitRead, viewDone otherEpoch ua (Ok (Just a)) ++ viewDone settings.epoch ub (Ok (Just b)) ++ viewDone settings.epoch ua (Ok (Just a)) )
            , ( unitShown, standingLoadedFor settings.epoch ua hashA (Ok Standing.Undecided) ++ [ Navigated QueuePage ] )
            , ( standingWanting, standingLoadedFor settings.epoch ua hashA (Ok Standing.Undecided) ++ standingLoadedFor settings.epoch ua hashA (Ok Standing.Undecided) ++ standingLoadedFor settings.epoch ub hashB (Ok Standing.Undecided) )
            , ( shown, approve ++ approve ++ [ press shown "a" ] )
            , ( saving, decisionDone settings.epoch ua (Ok pair) ++ [ Navigated QueuePage ] )
            , ( savingLoading, decisionDone settings.epoch ua (Ok pair) ++ queueDone savingLoading.queueLoad listedPage )
            , ( saving, decisionDone otherEpoch ua (Ok pair) ++ decisionDone settings.epoch ub (Ok pair) ++ decisionDone settings.epoch ua (Err SaveFailed) ++ approve )
            ]
    in
    List.all (\( model, msgs ) -> not (List.isEmpty msgs) && effectsOncePerStep settings msgs model) scripts


-- ── the session starts nothing ──────────────────────────────────────────
-- `Lib/Session.ipe` returns effects as values and imports neither the Cmd
-- module nor the Task module under any name, so it cannot start a task. A
-- task starts in `src` only through `Cmd.perform`, and a batch is built
-- only through `Cmd.batch`, each only inside `run` and `update` of
-- `Lib/App.ipe`, the interpreter, which builds no model: it holds no
-- record update. `Task.attempt` lowers to the same start, so any use of it
-- is stray, and the Cmd module is imported under its own name exposing
-- nothing, so no other spelling starts a task. Only `src/Main.ipe` imports
-- the interpreter, and only the session and the interpreter name an effect.
-- The modules are lexed as Ipê reads them, so a mention in a comment or a
-- string is no site.
interpreterSites : List String
interpreterSites =
    [ "run", "update" ]


-- The modules, relative to `src`, of the interpreter, the session, and the
-- one module that wires the interpreter into the server.
interpreterModule : String
interpreterModule =
    "Lib/App.ipe"


sessionModule : String
sessionModule =
    "Lib/Session.ipe"


mainModule : String
mainModule =
    "Main.ipe"


-- The modules the session must not import: the ones that start a task.
taskModules : List String
taskModules =
    [ "Ipe.Tea.Web.Cmd", "Ipe.Task" ]


startsTask : String -> Bool
startsTask text =
    List.any (\verb -> text == verb || String.endsWith ("." ++ verb) text) [ "perform", "attempt", "batch" ]


-- Whether `text` names one of `effects`, bare or qualified.
namesEffect : List String -> String -> Bool
namesEffect effects text =
    List.any (\effect -> text == effect || String.endsWith ("." ++ effect) text) effects


-- The declarations of `toks` holding a record update, `{ name |`.
recordUpdates : List TextSinkScanTests.Token -> List String
recordUpdates toks =
    .hits (List.foldl recordUpdateStep { before = noToken, last = noToken, hits = [] } toks)


noToken : TextSinkScanTests.Token
noToken =
    { kind = TextSinkScanTests.Punctuation, text = "", name = "" }


recordUpdateStep : TextSinkScanTests.Token -> { before : TextSinkScanTests.Token, last : TextSinkScanTests.Token, hits : List String } -> { before : TextSinkScanTests.Token, last : TextSinkScanTests.Token, hits : List String }
recordUpdateStep token state =
    let
        hits =
            if state.before.text == "{" && state.last.kind == TextSinkScanTests.WordToken && token.text == "|" then
                state.hits ++ [ token.name ]

            else
                state.hits
    in
    { before = state.last, last = token, hits = hits }


-- What the module at `path` does past the session's boundary, given the
-- session's `effects`: each declaration starting or batching a task
-- outside the interpreter's sites or under another spelling, each Cmd
-- import under another name or exposing its names, each task module the
-- session imports, each interpreter declaration building a model, each
-- import of the interpreter outside `src/Main.ipe`, and each declaration
-- naming an effect outside the session and the interpreter.
sessionBoundaryBreaks : List String -> String -> String -> List String
sessionBoundaryBreaks effects path text =
    let
        lexed =
            TextSinkScanTests.lex text

        starts =
            List.filter (\token -> token.kind == TextSinkScanTests.WordToken && startsTask token.text) lexed.code

        stray =
            List.filter (\token -> not (path == interpreterModule && List.member token.name interpreterSites && (token.text == "Cmd.perform" || token.text == "Cmd.batch"))) starts

        renamed =
            List.filter (\i -> String.endsWith ".Cmd" i.moduleName && (i.qualifier /= "Cmd" || i.opensAll || not (List.isEmpty i.exposed))) lexed.imports

        sessionTasks =
            if path == sessionModule then
                List.filter (\i -> List.member i.moduleName taskModules) lexed.imports

            else
                []

        built =
            if path == interpreterModule then
                recordUpdates lexed.code

            else
                []

        wired =
            if path == mainModule then
                []

            else
                List.filter (\i -> i.moduleName == "Lib.App") lexed.imports

        named =
            if path == sessionModule || path == interpreterModule then
                []

            else
                List.filter (\token -> token.kind == TextSinkScanTests.WordToken && namesEffect effects token.text) lexed.code
    in
    List.map .name stray
        ++ List.map .moduleName renamed
        ++ List.map .moduleName sessionTasks
        ++ built
        ++ List.map .moduleName wired
        ++ List.map .name named
        ++ (if lexed.broken then
                [ "a literal left open" ]

            else
                []
           )


scanFixture : String
scanFixture =
    "module Fixture exposing (run)\n\nimport Ipe.Tea.Web.Cmd as Cmd\n\n\n-- Cmd.perform in a comment starts nothing\nrun settings effect =\n    Cmd.perform task done\n"


sessionFixture : String
sessionFixture =
    "module Lib.Session exposing (step)\n\nimport Lib.Slot as Slot\n\n\n-- Cmd.perform in a comment starts nothing\nstep settings msg model =\n    ( model, [ LoadView read ] )\n"


fixtureEffects : List String
fixtureEffects =
    [ "LoadQueue", "LoadHistory", "LoadView", "LoadStanding", "SaveDecision" ]


-- Red cases: a task started in another definition, one behind a
-- `Cmd.batch`, one through a renamed Cmd import, one through an import
-- exposing `perform`, one through `Task.attempt` (inside a site too), a
-- perform in `Lib/View.ipe`, the session importing the Cmd or the Task
-- module under any name, the interpreter building a model, a module other
-- than `src/Main.ipe` importing the interpreter, and a view naming an
-- effect, bare or qualified.
sessionStartsNothingFixtures : Bool
sessionStartsNothingFixtures =
    sessionBoundaryBreaks fixtureEffects interpreterModule scanFixture == []
        && sessionBoundaryBreaks fixtureEffects sessionModule sessionFixture == []
        && sessionBoundaryBreaks fixtureEffects interpreterModule (scanFixture ++ "\n\nelsewhere model =\n    Cmd.perform task done\n") == [ "elsewhere" ]
        && sessionBoundaryBreaks fixtureEffects interpreterModule (scanFixture ++ "\n\nbatched model =\n    ( model, Cmd.batch [ Cmd.none, Cmd.perform task done ] )\n") == [ "batched", "batched" ]
        && sessionBoundaryBreaks fixtureEffects interpreterModule (String.replace "Cmd.perform task" "Effect.perform task" (String.replace "as Cmd" "as Effect" scanFixture)) == [ "run", "Ipe.Tea.Web.Cmd" ]
        && sessionBoundaryBreaks fixtureEffects interpreterModule (String.replace "as Cmd" "as Cmd exposing (perform)" scanFixture) == [ "Ipe.Tea.Web.Cmd" ]
        && sessionBoundaryBreaks fixtureEffects interpreterModule (scanFixture ++ "\n\nattempted model =\n    ( model, Task.attempt done task )\n") == [ "attempted" ]
        && sessionBoundaryBreaks fixtureEffects interpreterModule (String.replace "Cmd.perform task" "Task.attempt done task" scanFixture) == [ "run" ]
        && sessionBoundaryBreaks fixtureEffects "Lib/View.ipe" scanFixture == [ "run" ]
        && sessionBoundaryBreaks fixtureEffects sessionModule (String.replace "import Lib.Slot as Slot" "import Ipe.Tea.Web.Cmd as Cmd" sessionFixture) == [ "Ipe.Tea.Web.Cmd" ]
        && sessionBoundaryBreaks fixtureEffects sessionModule (String.replace "import Lib.Slot as Slot" "import Ipe.Tea.Web.Cmd as Effects" sessionFixture) == [ "Ipe.Tea.Web.Cmd", "Ipe.Tea.Web.Cmd" ]
        && sessionBoundaryBreaks fixtureEffects sessionModule (String.replace "import Lib.Slot as Slot" "import Ipe.Task exposing (Task)" sessionFixture) == [ "Ipe.Task" ]
        && sessionBoundaryBreaks fixtureEffects interpreterModule (scanFixture ++ "\n\nbuild model =\n    { model | page = next }\n") == [ "build" ]
        && sessionBoundaryBreaks fixtureEffects "Lib/View.ipe" (String.replace "import Lib.Slot as Slot" "import Lib.App as App" (String.replace "module Lib.Session" "module Lib.View" sessionFixture)) == [ "Lib.App", "step" ]
        && sessionBoundaryBreaks fixtureEffects "Lib/View.ipe" (String.replace "LoadView read" "Session.SaveDecision read" sessionFixture) == [ "step" ]


-- The constructors of the `type Effect` declaration in `toks`, in order.
effectConstructors : List TextSinkScanTests.Token -> List String
effectConstructors toks =
    .found (List.foldl effectConstructorStep { previous = "", inEffect = False, found = [] } toks)


effectConstructorStep : TextSinkScanTests.Token -> { previous : String, inEffect : Bool, found : List String } -> { previous : String, inEffect : Bool, found : List String }
effectConstructorStep token state =
    let
        inEffect =
            if token.name /= "type" then
                False

            else if state.previous == "type" then
                token.text == "Effect"

            else
                state.inEffect

        found =
            if inEffect && token.kind == TextSinkScanTests.WordToken && (state.previous == "=" || state.previous == "|") then
                state.found ++ [ token.text ]

            else
                state.found
    in
    { previous = token.text, inEffect = inEffect, found = found }


-- Every module of `src`, read through the text-sink scan's bounded reader,
-- keeps the session's boundary, the session and the interpreter are
-- modules of it, the interpreter defines both its sites, and the fixtures
-- go red. Red if the session can start a task, a task starts outside the
-- interpreter, or the interpreter builds a model.
sessionStartsNothing : Task.Task Error Bool
sessionStartsNothing =
    TextSinkScanTests.srcSources
        |> Task.map
            (\modules ->
                let
                    textOf path =
                        List.filterMap
                            (\( at, text ) ->
                                if at == path then
                                    Just text

                                else
                                    Nothing
                            )
                            modules

                    effects =
                        List.concatMap (\text -> effectConstructors (TextSinkScanTests.lex text).code) (textOf sessionModule)

                    names =
                        List.concatMap (\text -> List.map .name (TextSinkScanTests.lex text).code) (textOf interpreterModule)
                in
                effects == fixtureEffects
                    && List.all (\( path, text ) -> List.isEmpty (sessionBoundaryBreaks effects path text)) modules
                    && List.all (\site -> List.member site names) interpreterSites
                    && sessionStartsNothingFixtures
            )


-- ── the session's effects fit the runtime's ceiling ─────────────────────
-- One step returns at most one effect per slot, so a session holds at most
-- as many tasks in flight as `Effect` has constructors, each a slot. The
-- runtime refuses a session's task past `SESSION_CMD_CEILING`, so the slot
-- count must not exceed it, or a refused start would be the single-flight
-- path the app takes on a slot it holds.
ceilingPrefix : String
ceilingPrefix =
    "pub const SESSION_CMD_CEILING: Cmds = Cmds::new("


-- The value of `SESSION_CMD_CEILING` declared in the Rust source `text`.
sessionCmdCeiling : String -> Maybe Int
sessionCmdCeiling text =
    List.head
        (List.filterMap
            (\line ->
                if String.startsWith ceilingPrefix (String.trim line) then
                    String.toInt (String.replace ");" "" (String.dropLeft (String.length ceilingPrefix) (String.trim line)))

                else
                    Nothing
            )
            (String.lines text)
        )


-- Whether the `Effect` of `session` is exactly the five slots and their
-- count fits the ceiling `budget` declares.
effectsFitCeiling : String -> String -> Bool
effectsFitCeiling session budget =
    let
        effects =
            effectConstructors (TextSinkScanTests.lex session).code
    in
    effects == fixtureEffects
        && (case sessionCmdCeiling budget of
                Just ceiling ->
                    List.length effects <= ceiling

                Nothing ->
                    False
           )


effectFixture : String
effectFixture =
    "module Lib.Session exposing (Effect(..))\n\n\n-- a comment naming LoadElse is no constructor\ntype Effect\n    = LoadQueue (Stamp Slot.LoadTicket) Queue.QueueWant\n    | LoadHistory (Stamp Slot.LoadTicket) History.HistoryWant\n    | LoadView (Stamp Uid)\n    | LoadStanding (Stamp Standing.StandingKey)\n    | SaveDecision (Stamp Uid) MacKey DecisionPlan LibDb.Decision\n\n\ntype alias Other =\n    { field : Int }\n"


budgetFixture : String
budgetFixture =
    "/// The Cmds one session may have in flight.\npub const SESSION_CMD_CEILING: Cmds = Cmds::new(64);\n"


-- The `Effect` of `src/Lib/Session.ipe` is the five slots, under the
-- ceiling `src/runtime/rust/src/web/budget.rs` declares, and the fixtures
-- go red on a sixth constructor, a ceiling below five, and a ceiling that
-- does not parse. Red if the session can hold more tasks than the runtime
-- admits.
effectSlotsUnderCeiling : Task.Task Error Bool
effectSlotsUnderCeiling =
    do
        cwd <- System.cwd ()
        sessionPath <- Task.fromResult (Path.fromString (cwd ++ "/src/Lib/Session.ipe"))
        budgetPath <- Task.fromResult (Path.fromString (repoFile cwd "src/runtime/rust/src/web/budget.rs"))
        session <- File.readFileLimit sessionPath (ByteSize.kib 256)
        budget <- File.readFileLimit budgetPath (ByteSize.kib 256)
        Task.succeed
            (effectsFitCeiling session budget
                && sessionCmdCeiling budget /= Nothing
                && effectsFitCeiling effectFixture budgetFixture
                && not (effectsFitCeiling (String.replace "    | SaveDecision" "    | LoadElse (Stamp Uid)\n    | SaveDecision" effectFixture) budgetFixture)
                && not (effectsFitCeiling effectFixture (String.replace "new(64)" "new(4)" budgetFixture))
                && not (effectsFitCeiling effectFixture (String.replace "new(64)" "new(sixty)" budgetFixture))
            )


-- ── every stamp is minted at its slot's start ───────────────────────────
-- A completion stamp is made only by `Slot.stamp`, and `Slot.stamp` is
-- called only inside each slot's one start definition; `Lib/Slot.ipe`
-- exposes `Stamp` without its constructor, so no other module builds one.
-- The modules are lexed as Ipê reads them, so a mention in a comment or a
-- string is no site.
stampMintSites : List ( String, String )
stampMintSites =
    [ ( "Lib/Slot.ipe", "startLoad" ), ( "Lib/Selected.ipe", "startView" ), ( "Lib/Standing.ipe", "startStanding" ), ( "Lib/DecisionSlot.ipe", "startDecision" ) ]


-- The module, relative to `src`, that defines `Stamp` and `stamp`.
stampModule : String
stampModule =
    "Lib/Slot.ipe"


-- The declarations of the module at `path` that mint a stamp outside its
-- start site, the imports of `Lib.Slot` that expose `stamp`, and the
-- `Stamp` constructor if the stamp module exposes it.
strayStampMints : String -> String -> List String
strayStampMints path text =
    let
        lexed =
            TextSinkScanTests.lex text

        slotImports =
            List.filter (\i -> i.moduleName == "Lib.Slot") lexed.imports

        qualified =
            [ "Lib.Slot.stamp" ] ++ List.map (\i -> i.qualifier ++ ".stamp") slotImports

        sites =
            List.filterMap
                (\( site, name ) ->
                    if site == path then
                        Just name

                    else
                        Nothing
                )
                stampMintSites

        bare =
            path == stampModule

        stray =
            List.filter (\token -> token.kind == TextSinkScanTests.WordToken && (List.member token.text qualified || (bare && token.text == "stamp" && token.name /= "stamp" && token.name /= "module")) && not (List.member token.name sites)) lexed.code

        exposingMint =
            List.filter (\i -> i.opensAll || List.member "stamp" i.exposed) slotImports

        header =
            List.filter (\token -> token.name == "module") lexed.tokens

        constructed =
            if bare then
                .hits (List.foldl constructorStep { name = "", past = False, hits = [] } lexed.code)

            else
                []
    in
    List.map .name stray
        ++ constructed
        ++ List.map .moduleName exposingMint
        ++ (if path == stampModule && opensStamp header then
                [ "Stamp(..)" ]

            else
                []
           )
        ++ (if lexed.broken then
                [ "a literal left open" ]

            else
                []
           )


-- The declarations of the stamp module that may name the `Stamp`
-- constructor past their `=`: the type declarations, `stamp`, the one
-- construction, and `stampKey`, `running` and `owns`, which only match it.
stampConstructorSites : List String
stampConstructorSites =
    [ "type", "stamp", "stampKey", "running", "owns" ]


-- One code token of the stamp module, read in order: a `Stamp` word past
-- the `=` of a declaration not in `stampConstructorSites` builds a stamp
-- outside `stamp`, and its declaration is a hit. A signature names the
-- type before the `=`, so it is no hit.
constructorStep : TextSinkScanTests.Token -> { name : String, past : Bool, hits : List String } -> { name : String, past : Bool, hits : List String }
constructorStep token state =
    let
        past =
            (token.kind == TextSinkScanTests.Punctuation && token.text == "=") || (token.name == state.name && state.past)

        hits =
            if past && token.kind == TextSinkScanTests.WordToken && token.text == "Stamp" && not (List.member token.name stampConstructorSites) then
                state.hits ++ [ token.name ]

            else
                state.hits
    in
    { name = token.name, past = past, hits = hits }


-- Whether a `Stamp` token is followed by `(`, its constructors opened.
opensStamp : List TextSinkScanTests.Token -> Bool
opensStamp toks =
    case toks of
        first :: rest ->
            case rest of
                second :: _ ->
                    (first.text == "Stamp" && second.text == "(") || opensStamp rest

                [] ->
                    False

        [] ->
            False


stampFixture : String
stampFixture =
    "module Fixture exposing (startView)\n\nimport Lib.Slot as Slot\n\n\n-- Slot.stamp in a comment mints nothing\nstartView epoch uid =\n    ( Slot.stamp epoch uid, \"Slot.stamp\" )\n"


slotFixture : String
slotFixture =
    "module Lib.Slot exposing (Stamp, stamp)\n\n\ntype Stamp key\n    = Stamp Epoch key\n\n\nstamp : Epoch -> key -> Stamp key\nstamp epoch key =\n    Stamp epoch key\n\n\nstartLoad epoch latest =\n    stamp epoch latest\n"


-- Red cases: a mint in another definition, qualified, fully qualified or
-- under a renamed import; a start site's name in another module; a mint
-- in the session's `step`; an import
-- exposing `stamp`, by name or by `(..)`; a bare mint in the stamp module
-- outside `startLoad`; the stamp module exposing `Stamp(..)`; and the
-- `Stamp` constructor built in a declaration of the stamp module other
-- than `stamp`, while a signature naming the type is clean.
everyStampMintedAtItsStartFixtures : Bool
everyStampMintedAtItsStartFixtures =
    strayStampMints "Lib/Selected.ipe" stampFixture == []
        && strayStampMints "Lib/Selected.ipe" (stampFixture ++ "\n\nelsewhere epoch uid =\n    Slot.stamp epoch uid\n") == [ "elsewhere" ]
        && strayStampMints "Lib/Selected.ipe" (stampFixture ++ "\n\nelsewhere epoch uid =\n    Lib.Slot.stamp epoch uid\n") == [ "elsewhere" ]
        && strayStampMints "Lib/Session.ipe" (String.replace "Slot.stamp epoch" "S.stamp epoch" (String.replace "as Slot" "as S" stampFixture)) == [ "startView" ]
        && strayStampMints "Lib/Session.ipe" stampFixture == [ "startView" ]
        && strayStampMints "Lib/Session.ipe" (stampFixture ++ "\n\nstep settings msg model =\n    ( model, [ LoadView (Slot.stamp settings.epoch uid) ] )\n") == [ "startView", "step" ]
        && strayStampMints "Lib/Selected.ipe" (String.replace "as Slot" "as Slot exposing (stamp)" stampFixture) == [ "Lib.Slot" ]
        && strayStampMints "Lib/Selected.ipe" (String.replace "as Slot" "as Slot exposing (..)" stampFixture) == [ "Lib.Slot" ]
        && strayStampMints stampModule slotFixture == []
        && strayStampMints stampModule (slotFixture ++ "\n\nother epoch key =\n    stamp epoch key\n") == [ "other" ]
        && strayStampMints stampModule (String.replace "exposing (Stamp," "exposing (Stamp(..)," slotFixture) == [ "Stamp(..)" ]
        && strayStampMints stampModule (slotFixture ++ "\n\nforge : Epoch -> key -> Stamp key\nforge e k =\n    Stamp e k\n") == [ "forge" ]
        && strayStampMints stampModule (slotFixture ++ "\n\nheld : Stamp key -> Maybe (Stamp key)\nheld s =\n    Just s\n") == []


-- Every module of `src`, read through the text-sink scan's bounded reader,
-- mints stamps only at the start sites, every start site is a definition
-- of its module, and the fixtures go red. Red if a completion stamp can be
-- built anywhere but a slot's start.
everyStampMintedAtItsStart : Task.Task Error Bool
everyStampMintedAtItsStart =
    TextSinkScanTests.srcSources
        |> Task.map
            (\modules ->
                List.any (\( path, _ ) -> path == stampModule) modules
                    && List.all (\( path, text ) -> List.isEmpty (strayStampMints path text)) modules
                    && List.all (\( site, name ) -> List.any (\( path, text ) -> path == site && List.any (\token -> token.name == name) (TextSinkScanTests.lex text).code) modules) stampMintSites
                    && everyStampMintedAtItsStartFixtures
            )
