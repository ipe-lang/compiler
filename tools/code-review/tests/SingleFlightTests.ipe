module SingleFlightTests exposing (checks)

import Ipe.Db as Db
import Ipe.Error as Error exposing (Error)
import Ipe.Html as Html
import Ipe.Io as Io
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.String as String
import Ipe.Task as Task
import Ipe.Ui as Ui
import Lib.App as App exposing (DecisionTarget(..), Model, Msg(..), Page(..))
import Lib.Db as LibDb exposing (Decision(..))
import Lib.Epoch as Epoch exposing (Epoch)
import Lib.Failure as Failure exposing (DecideRefusal(..), LoadFailure(..), ReasonRefusal(..), RefuseFailure(..), SaveFailure(..))
import Lib.Index as Index exposing (Change(..), RefusalReason(..))
import Lib.Queue as Queue exposing (DecisionSlot(..), HistoryState(..), QueueState(..), SelectedView(..), StandingRead(..), UnitPageState(..))
import Lib.ReviewKey as ReviewKey exposing (ReviewKey(..))
import Lib.SafeText as SafeText
import Lib.Settings as Settings
import Lib.Uid as Uid exposing (Uid)
import Lib.View as View
import TestSupport exposing (check, checkReporting, cleanupIndex, decideNow, envAppSettings, freshScratch, loadUnitNow, migratedReviewAt, refusalOf, removeFileIfAny, seedIndex, testMacKey, uid, labelOf, labelText)


-- Every check drives the app's own `App.update`, the dispatch `src/Main.ipe`
-- serves, and asserts on the session's two in-flight slots: `selectedView`,
-- the one source read shared by the queue card and the unit page, and
-- `decision`, the one decision. A read or a decision starts only from a slot
-- transition that takes an idle slot, so a slot that stays taken across a
-- second request proves the second request started nothing.
-- ── driving the app ─────────────────────────────────────────────────────
-- `model` after each of `msgs` in turn; the Cmds are dropped, so a read
-- or a decision is in flight exactly while its slot holds it.
after : Settings.AppSettings -> List Msg -> Model -> Model
after settings msgs model =
    List.foldl
        (\msg current ->
            let
                ( next, _ ) =
                    App.update settings msg current
            in
            next
        )
        model
        msgs


-- The read in flight and the unit wanted after it, if a read is in flight.
inFlight : Model -> Maybe ( Uid, Maybe Uid )
inFlight model =
    case model.selectedView of
        ViewLoading loading ->
            Just ( loading.uid, loading.wanted )

        ViewShown _ ->
            Nothing

        NoneSelected ->
            Nothing

        ViewMissing _ ->
            Nothing

        ViewFailed _ _ ->
            Nothing


-- What the unit page at the model's address shows, by name.
pageTag : Model -> String
pageTag model =
    case model.page of
        UnitPage raw ->
            case App.unitPageState raw model of
                UnitLoading ->
                    "loading"

                UnitLoaded loaded ->
                    "loaded " ++ Uid.toString loaded.unit.uid

                UnitNotFound ->
                    "not found"

                UnitFailed _ ->
                    "failed"

                UnitIdRefused ->
                    "refused"

        QueuePage ->
            "queue page"

        HistoryPage ->
            "history page"


unitAt : Uid -> Page
unitAt unit =
    UnitPage (Uid.toString unit)


queued : Index.UnitView -> Queue.QueuedUnit
queued loaded =
    { unit = loaded.unit, change = New, changed = Nothing, standing = Queue.Undecided }


queuePageOf : List Index.UnitView -> Queue.QueuePage
queuePageOf units =
    { units = List.map queued units
    , total = List.length units
    , unbound = 0
    , dbName = SafeText.literal "index.db"
    , dbBytes = 2048
    , next = Nothing
    , progress = { reviewed = 0, total = List.length units }
    , log = LibDb.ShownProven
    , refusals = []
    , refusalsOpen = 0
    , refusalsUnbound = 0
    }


-- The queue page showing `units`, the first one selected with `view`.
queueModel : List Index.UnitView -> Queue.SelectedView -> Model
queueModel units view =
    { initialModel | queueState = Loaded (queuePageOf units), selectedView = view }


initialModel : Model
initialModel =
    App.initialModel


-- ── refusals ────────────────────────────────────────────────────────────
-- Unit-page entries made while a read is in flight start no second read: the
-- first entry holds the slot, each later one only records the unit wanted
-- after it, and the read returning starts only the latest. Red if a unit-page
-- entry reads beside the read in flight.
unitEntriesDuringReadCoalesce : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
unitEntriesDuringReadCoalesce settings a b =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        uc =
            uid "u-c"

        first =
            after settings [ Navigated (unitAt ua) ] initialModel

        entered =
            after settings [ Navigated (unitAt ub), Navigated (unitAt uc) ] first

        ( _, startedDuring ) =
            Queue.reloadView settings.epoch ub first.selectedView

        returned =
            after settings [ SelectedViewLoaded ua settings.epoch (Ok (Just a)) ] entered
    in
    inFlight first
        == Just ( ua, Nothing )
        && startedDuring
        == Nothing
        && inFlight entered
        == Just ( ua, Just uc )
        && pageTag entered
        == "loading"
        && inFlight returned
        == Just ( uc, Nothing )
        && pageTag returned
        == "loading"


-- The queue card and the unit page read through one slot: a unit page entered
-- while the card's read is in flight waits for it, and so does the card
-- selected after a queue load while the unit page's read is in flight. A
-- selection or key sent on the unit page reads nothing. Red if either page
-- keeps a read slot of its own.
oneReadSlotAcrossPages : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
oneReadSlotAcrossPages settings a b =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        cardReading =
            queueModel [ a, b ] (ViewLoading { uid = ua, wanted = Nothing, fresh = True, owner = settings.epoch })

        onUnitPage =
            after settings [ Navigated (unitAt ub) ] cardReading

        keysOnUnitPage =
            after settings [ SelectUnit 1, KeyDown "j", KeyDown "a" ] onUnitPage

        unitReading =
            after settings [ Navigated (unitAt ub) ] (queueModel [ a, b ] NoneSelected)

        backOnQueue =
            after settings [ Navigated QueuePage ] unitReading

        queueLoaded =
            after settings [ PendingLoaded backOnQueue.queueLoad (Ok (queuePageOf [ a, b ])) ] backOnQueue
    in
    inFlight onUnitPage
        == Just ( ua, Just ub )
        && inFlight keysOnUnitPage
        == Just ( ua, Just ub )
        && keysOnUnitPage.selected
        == 0
        && keysOnUnitPage.decision
        == DecisionIdle
        && inFlight unitReading
        == Just ( ub, Nothing )
        && inFlight queueLoaded
        == Just ( ub, Just ua )


-- The unit page shows only a read settled for its own unit: another unit's
-- read returning, a queue load, or a late response leaves it loading, and its
-- own read settles it, missing units included. Red if the unit page shows a
-- view read for another unit, or a queue load clears its read.
unitPageSettlesOnItsOwnRead : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
unitPageSettlesOnItsOwnRead settings a b =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        uc =
            uid "u-c"

        waiting =
            after settings [ Navigated (unitAt ub) ] (queueModel [ a ] (ViewLoading { uid = ua, wanted = Nothing, fresh = True, owner = settings.epoch }))

        otherReturned =
            after settings [ SelectedViewLoaded ua settings.epoch (Ok (Just a)) ] waiting

        queueLoaded =
            after settings [ PendingLoaded otherReturned.queueLoad (Ok (queuePageOf [ a ])) ] otherReturned

        ownReturned =
            after settings [ SelectedViewLoaded ub settings.epoch (Ok (Just b)) ] queueLoaded

        lateOther =
            after settings [ SelectedViewLoaded ua settings.epoch (Ok (Just a)) ] ownReturned

        shownElsewhere =
            { ownReturned | page = unitAt ua }

        missing =
            after settings [ Navigated (unitAt uc), SelectedViewLoaded uc settings.epoch (Ok Nothing) ] ownReturned

        refused =
            after settings [ Navigated (UnitPage "not-a-unit-id") ] ownReturned
    in
    pageTag waiting
        == "loading"
        && pageTag otherReturned
        == "loading"
        && inFlight queueLoaded
        == Just ( ub, Nothing )
        && pageTag ownReturned
        == ("loaded " ++ Uid.toString ub)
        && pageTag lateOther
        == ("loaded " ++ Uid.toString ub)
        && pageTag shownElsewhere
        == "loading"
        && pageTag missing
        == "not found"
        && pageTag refused
        == "refused"


-- One decision is in flight per session: a decision asked, by button or key,
-- while one is saving starts nothing and leaves the saving one's pending
-- state; one asked by refusal says why and keeps the draft. A save that
-- failed leaves its notice, and the next decision starts and drops it. Red
-- if a second decision, with its source re-read, starts beside the first.
decisionsSingleFlight : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
decisionsSingleFlight settings a b =
    let
        ua =
            a.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        saving =
            after settings [ ApproveUnit ua ] shown

        pressedAgain =
            after settings [ ApproveUnit ua, KeyDown "a" ] saving

        refusing =
            after settings [ RefuseStart ua, RefuseDraft "needs a test", RefuseSubmit ua ] saving

        settled =
            after settings [ App.decisionSaved ua settings.epoch (Err (Error.conflict "boom")) ] pressedAgain

        next =
            after settings [ ApproveUnit ua ] settled

        lateOther =
            after settings [ App.decisionSaved b.unit.uid settings.epoch (Err (Error.conflict "boom")) ] next
    in
    Queue.startDecision settings.epoch ua (DecisionSaving ua settings.epoch)
        == Nothing
        && saving.decision
        == DecisionSaving ua settings.epoch
        && pressedAgain.decision
        == DecisionSaving ua settings.epoch
        && refusing.decision
        == DecisionSaving ua settings.epoch
        && refusing.refuseError
        == Just DraftWhileSaving
        && refusing.refusingUid
        == Just ua
        && refusing.refuseDraft
        == "needs a test"
        && Queue.notSavedOf settled.decision
        == Just SaveFailed
        && next.decision
        == DecisionSaving ua settings.epoch
        && lateOther.decision
        == DecisionSaving ua settings.epoch


-- A slot left taken by another process, whose completion died with it, is
-- idle: slot ownership is tied to process lifetime. A decision saving under
-- a foreign epoch blocks no decision, by button or refusal, and a decision
-- result from a foreign epoch settles no slot this process owns, while a
-- decision busy under this epoch still refuses a second. A page entry
-- shows a foreign busy decision as idle, so no pending state is left on
-- screen. Red if a persisted busy decision blocks the session or stays
-- shown after a restart, or if any process's result frees this process's
-- slot.
foreignDecisionIsIdle : Settings.AppSettings -> Epoch -> Index.UnitView -> Index.UnitView -> Bool
foreignDecisionIsIdle settings otherEpoch a b =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        stale =
            { shown | decision = DecisionSaving ub otherEpoch }

        approved =
            after settings [ ApproveUnit ua ] stale

        refused =
            after settings [ RefuseStart ua, RefuseDraft "needs a test", RefuseSubmit ua ] stale

        foreignResult =
            after settings [ App.decisionSaved ua otherEpoch (Err (Error.conflict "boom")) ] approved

        ownResult =
            after settings [ App.decisionSaved ua settings.epoch (Err (Error.conflict "boom")) ] foreignResult

        entered =
            after settings [ Navigated QueuePage ] { shown | decision = DecisionRefreshing ub otherEpoch }

        ownEntered =
            after settings [ Navigated QueuePage ] { shown | decision = DecisionRefreshing ub settings.epoch }
    in
    Queue.startDecision settings.epoch ua (DecisionSaving ub otherEpoch)
        == Just (DecisionSaving ua settings.epoch)
        && Queue.startDecision settings.epoch ua (DecisionRefreshing ub otherEpoch)
        == Just (DecisionSaving ua settings.epoch)
        && Queue.startDecision settings.epoch ua (DecisionSaving ub settings.epoch)
        == Nothing
        && Queue.startDecision settings.epoch ua (DecisionRefreshing ub settings.epoch)
        == Nothing
        && entered.decision
        == DecisionIdle
        && ownEntered.decision
        == DecisionRefreshing ub settings.epoch
        && approved.decision
        == DecisionSaving ua settings.epoch
        && refused.decision
        == DecisionSaving ua settings.epoch
        && refused.refuseError
        == Nothing
        && foreignResult.decision
        == DecisionSaving ua settings.epoch
        && Queue.notSavedOf ownResult.decision
        == Just SaveFailed


-- A source read left in flight by another process is `NoneSelected`: a
-- unit-page entry, a queue card selected, a queue load and a History entry
-- each act as on an idle slot, and a read result from a foreign epoch
-- settles no read this process owns, while a read in flight under this
-- epoch still holds the slot. Red if a persisted `ViewLoading` blocks the
-- session after a restart, or if another process's result settles it.
foreignReadIsIdle : Settings.AppSettings -> Epoch -> Index.UnitView -> Index.UnitView -> Bool
foreignReadIsIdle settings otherEpoch a b =
    let
        ua =
            a.unit.uid

        ub =
            b.unit.uid

        stale =
            queueModel [ a, b ] (ViewLoading { uid = ua, wanted = Nothing, fresh = True, owner = otherEpoch })

        ownSelected =
            after settings [ SelectUnit 1 ] (queueModel [ a, b ] (ViewLoading { uid = ua, wanted = Nothing, fresh = True, owner = settings.epoch }))

        unitEntered =
            after settings [ Navigated (unitAt ub) ] stale

        selected =
            after settings [ SelectUnit 1 ] stale

        reloading =
            after settings [ Navigated QueuePage ] stale

        queueLoaded =
            after settings [ PendingLoaded reloading.queueLoad (Ok (queuePageOf [ a, b ])) ] reloading

        historyEntered =
            after settings [ Navigated HistoryPage ] stale

        foreignResult =
            after settings [ SelectedViewLoaded ub otherEpoch (Ok (Just b)) ] selected

        ownResult =
            after settings [ SelectedViewLoaded ub settings.epoch (Ok (Just b)) ] foreignResult
    in
    inFlight unitEntered
        == Just ( ub, Nothing )
        && inFlight selected
        == Just ( ub, Nothing )
        && inFlight queueLoaded
        == Just ( ua, Nothing )
        && inFlight historyEntered
        == Nothing
        && inFlight ownSelected
        == Just ( ua, Just ub )
        && inFlight foreignResult
        == Just ( ub, Nothing )
        && inFlight ownResult
        == Nothing
        && Maybe.map SafeText.toString (Queue.selectedViewStatusText ub ownResult.selectedView)
        == Nothing


-- A decision asked off the queue page is refused before it takes the slot:
-- it leaves only its notice, which a later decision replaces, and it never
-- replaces a decision already saving. Red if a decision asked on the unit
-- page or History takes the decision slot or drops a busy one.
decisionOffQueueHoldsNoSlot : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
decisionOffQueueHoldsNoSlot settings a b =
    let
        ua =
            a.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        onUnitPage =
            after settings [ ApproveUnit ua ] { shown | page = unitAt ua }

        onHistory =
            after settings [ ApproveUnit ua ] { shown | page = HistoryPage }

        onQueue =
            after settings [ ApproveUnit ua ] shown

        backOnQueue =
            after settings [ ApproveUnit ua ] { onUnitPage | page = QueuePage }

        savingThenOff =
            after settings [ ApproveUnit ua ] { onQueue | page = HistoryPage }
    in
    Queue.notSavedOf onUnitPage.decision
        == Just SaveOffQueue
        && Queue.notSavedOf onHistory.decision
        == Just SaveOffQueue
        && onQueue.decision
        == DecisionSaving ua settings.epoch
        && backOnQueue.decision
        == DecisionSaving ua settings.epoch
        && savingThenOff.decision
        == DecisionSaving ua settings.epoch


-- ── rendered ────────────────────────────────────────────────────────────
page : Model -> String
page model =
    Html.render (Ui.layout [] (View.view model))


-- A decision saving shows its pending state on the queue card in place of
-- Approve and Refuse, and a second press keeps it; a unit page whose read
-- is still in flight shows loading and none of the unit the slot last
-- showed. Each sits beside the settled form, rendered through the same path.
busyRendered : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
busyRendered settings a b =
    let
        shown =
            queueModel [ a ] (ViewShown a)

        pending =
            page (after settings [ ApproveUnit a.unit.uid ] shown)

        busy =
            page (after settings [ ApproveUnit a.unit.uid, ApproveUnit a.unit.uid ] shown)

        idle =
            page shown

        aName =
            labelText a.unit.qualified

        waiting =
            page { shown | page = unitAt b.unit.uid }

        settled =
            page { shown | page = unitAt a.unit.uid }
    in
    String.contains "Saving the decision…" pending
        && not (String.contains ">Approve<" pending)
        && String.contains "Saving the decision…" busy
        && not (String.contains "Saving the decision…" idle)
        && String.contains ">Approve<" idle
        && String.contains "Loading unit…" waiting
        && not (String.contains aName waiting)
        && String.contains aName settled
        && not (String.contains "Loading unit…" settled)


-- A save that failed on a busy database is `SaveContended`, and the banner
-- says the index or review database is busy, never the error's kind, code or
-- text, and never only the review database: the index read that re-proves
-- the shown source fails busy alike. Any other failure, the moved-head
-- conflict included, is `SaveFailed`, its banner the fixed text with none of
-- the error's. Red if a save failure's text reaches the model or the page.
saveFailureRendered : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
saveFailureRendered settings a b =
    let
        ua =
            a.unit.uid

        saving =
            after settings [ ApproveUnit ua ] (queueModel [ a, b ] (ViewShown a))

        busyText =
            "database is locked [5]"

        busy =
            after settings [ App.decisionSaved ua settings.epoch (Err (Error.withDetails (Database Db.Busy) (Error.unexpected busyText))) ] saving

        otherText =
            "UNIQUE constraint failed: review_log.seq [2067]"

        other =
            after settings [ App.decisionSaved ua settings.epoch (Err (Error.withDetails (Database Db.UniqueViolation) (Error.unexpected otherText))) ] saving

        moved =
            after settings [ App.decisionSaved ua settings.epoch (Err LibDb.headMoved) ] saving

        busyPage =
            page busy

        otherPage =
            page other

        movedPage =
            page moved

        changed =
            after settings [ App.decisionSaved ua settings.epoch (Ok (Err SourceChanged)) ] saving
    in
    Queue.notSavedOf busy.decision
        == Just SaveContended
        && String.contains "the index or review database is busy; try again" busyPage
        && not (String.contains "Unexpected" busyPage)
        && not (String.contains "[5]" busyPage)
        && not (String.contains (Html.escapeHtml busyText) busyPage)
        && Queue.notSavedOf other.decision
        == Just SaveFailed
        && String.contains (Html.escapeHtml (Failure.saveFailureText SaveFailed)) otherPage
        && not (String.contains "Unexpected" otherPage)
        && not (String.contains (Html.escapeHtml otherText) otherPage)
        && Queue.notSavedOf moved.decision
        == Just SaveFailed
        && String.contains (Html.escapeHtml (Failure.saveFailureText SaveFailed)) movedPage
        && not (String.contains (Html.escapeHtml (Error.message LibDb.headMoved)) movedPage)
        && Queue.notSavedOf changed.decision
        == Just (SaveRefused SourceChanged)
        && String.contains (Html.escapeHtml (Failure.saveFailureText (SaveRefused SourceChanged))) (page changed)


-- A decision asked on a server with no signing key is refused before it
-- takes the slot, and the banner says the server is read-only. Red if a
-- read-only server starts a decision or shows any other refusal.
readOnlySaveRefused : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
readOnlySaveRefused settings a b =
    let
        refused =
            after { settings | key = ReadOnly } [ ApproveUnit a.unit.uid ] (queueModel [ a, b ] (ViewShown a))
    in
    Queue.notSavedOf refused.decision
        == Just SaveReadOnly
        && String.contains ReviewKey.readOnlyText (page refused)


-- ── typed failures ──────────────────────────────────────────────────────
-- A failure's text, standing for an error the runtime raised with a server
-- path in it: no page may show any of it.
marker : String
marker =
    "MARKER-/abs/root"


busyMarker : Error
busyMarker =
    Error.withDetails (Database Db.Busy) (Error.unexpected marker)


plainMarker : Error
plainMarker =
    Error.unexpected marker


limitMarker : Error
limitMarker =
    Error.limitExceeded marker


-- `model`'s page shows `text` and none of the marker error's text.
showsOnly : String -> Model -> Bool
showsOnly text model =
    let
        rendered =
            page model
    in
    String.contains text rendered
        && not (String.contains "MARKER" rendered)
        && not (String.contains "/abs/root" rendered)


queueFailure : QueueState -> Maybe LoadFailure
queueFailure state =
    case state of
        Failed failure ->
            Just failure

        Loading ->
            Nothing

        Loaded _ ->
            Nothing


historyFailure : HistoryState -> Maybe LoadFailure
historyFailure state =
    case state of
        HistoryFailed failure ->
            Just failure

        HistoryLoading ->
            Nothing

        HistoryLoaded _ ->
            Nothing


viewFailure : SelectedView -> Maybe LoadFailure
viewFailure state =
    case state of
        ViewFailed _ failure ->
            Just failure

        ViewLoading _ ->
            Nothing

        ViewShown _ ->
            Nothing

        NoneSelected ->
            Nothing

        ViewMissing _ ->
            Nothing


unitFailure : Model -> Maybe LoadFailure
unitFailure model =
    case model.page of
        UnitPage raw ->
            case App.unitPageState raw model of
                UnitFailed failure ->
                    Just failure

                UnitLoading ->
                    Nothing

                UnitLoaded _ ->
                    Nothing

                UnitNotFound ->
                    Nothing

                UnitIdRefused ->
                    Nothing

        QueuePage ->
            Nothing

        HistoryPage ->
            Nothing


standingFailure : StandingRead -> Maybe LoadFailure
standingFailure read =
    case read of
        StandingFailed _ _ failure ->
            Just failure

        StandingUnread ->
            Nothing

        StandingShown _ _ _ ->
            Nothing


-- A queue load's failure is decided from the error's details and kind, never
-- its text: a busy database is `LoadContended`, a ceiling passed
-- `LoadPastLimit`, every other failure `LoadFailed`, and the page shows the
-- case's fixed text. A load that succeeds shows the queue. Red if a cause is
-- read from the message, or the error's text reaches the page.
queueLoadFailureTyped : Settings.AppSettings -> Index.UnitView -> Bool
queueLoadFailureTyped settings a =
    let
        loading =
            after settings [ Navigated QueuePage ] initialModel

        settle result =
            after settings [ App.queueLoaded loading.queueLoad result ] loading

        busy =
            settle (Err busyMarker)

        plain =
            settle (Err plainMarker)

        limit =
            settle (Err limitMarker)

        succeeded =
            settle (Ok (queuePageOf [ a ]))

        lead =
            "Queue failed to load: "
    in
    queueFailure busy.queueState
        == Just LoadContended
        && showsOnly (lead ++ Failure.loadFailureText LoadContended) busy
        && queueFailure plain.queueState
        == Just LoadFailed
        && showsOnly (lead ++ Failure.loadFailureText LoadFailed) plain
        && queueFailure limit.queueState
        == Just LoadPastLimit
        && showsOnly (lead ++ Failure.loadFailureText LoadPastLimit) limit
        && queueFailure succeeded.queueState
        == Nothing
        && Maybe.map SafeText.toString (Queue.queueStatusText succeeded.queueState)
        == Nothing


-- A History load's failure is a typed case alike, its page the case's fixed
-- text. Red if the error's text reaches the History page.
historyLoadFailureTyped : Settings.AppSettings -> Bool
historyLoadFailureTyped settings =
    let
        loading =
            after settings [ Navigated HistoryPage ] initialModel

        settle result =
            after settings [ App.historyLoaded loading.historyLoad result ] loading

        limit =
            settle (Err limitMarker)

        plain =
            settle (Err plainMarker)

        succeeded =
            settle (Ok { rows = [], at = LibDb.HistoryStart, next = Nothing, log = LibDb.ShownProven })

        lead =
            "History load failed: "
    in
    historyFailure limit.history
        == Just LoadPastLimit
        && showsOnly (lead ++ Failure.loadFailureText LoadPastLimit) limit
        && historyFailure plain.history
        == Just LoadFailed
        && showsOnly (lead ++ Failure.loadFailureText LoadFailed) plain
        && historyFailure succeeded.history
        == Nothing
        && Maybe.map SafeText.toString (Queue.historyStatusText succeeded.history)
        == Just "No reviews yet."


-- The queue card's source read that fails settles the slot as a typed case,
-- and the card shows its fixed text. Red if the error's text reaches the
-- card.
viewLoadFailureTyped : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
viewLoadFailureTyped settings a b =
    let
        ua =
            a.unit.uid

        reading =
            queueModel [ a, b ] (ViewLoading { uid = ua, wanted = Nothing, fresh = True, owner = settings.epoch })

        settle result =
            after settings [ App.viewLoaded ua settings.epoch result ] reading

        plain =
            settle (Err plainMarker)

        busy =
            settle (Err busyMarker)

        succeeded =
            settle (Ok (Just a))

        lead =
            "Source load failed: "
    in
    viewFailure plain.selectedView
        == Just LoadFailed
        && showsOnly (lead ++ Failure.loadFailureText LoadFailed) plain
        && viewFailure busy.selectedView
        == Just LoadContended
        && showsOnly (lead ++ Failure.loadFailureText LoadContended) busy
        && viewFailure succeeded.selectedView
        == Nothing
        && Maybe.map SafeText.toString (Queue.selectedViewStatusText ua succeeded.selectedView)
        == Nothing


-- The unit page's read that fails shows the case's fixed text. Red if the
-- error's text reaches the unit page.
unitLoadFailureTyped : Settings.AppSettings -> Index.UnitView -> Bool
unitLoadFailureTyped settings a =
    let
        ua =
            a.unit.uid

        entered =
            after settings [ Navigated (unitAt ua) ] initialModel

        settle result =
            after settings [ App.viewLoaded ua settings.epoch result ] entered

        busy =
            settle (Err busyMarker)

        limit =
            settle (Err limitMarker)

        succeeded =
            settle (Ok (Just a))

        lead =
            "Unit load failed: "
    in
    unitFailure busy
        == Just LoadContended
        && showsOnly (lead ++ Failure.loadFailureText LoadContended) busy
        && unitFailure limit
        == Just LoadPastLimit
        && showsOnly (lead ++ Failure.loadFailureText LoadPastLimit) limit
        && unitFailure succeeded
        == Nothing
        && pageTag succeeded
        == ("loaded " ++ Uid.toString ua)


-- The unit page's standing read that fails shows the case's fixed text in
-- place of the review status. Red if the error's text reaches the page.
standingLoadFailureTyped : Settings.AppSettings -> Index.UnitView -> Bool
standingLoadFailureTyped settings a =
    let
        ua =
            a.unit.uid

        shown =
            queueModel [ a ] (ViewShown a)

        onUnitPage =
            { shown | page = unitAt ua }

        settle result =
            after settings [ App.standingLoaded ua (Index.storedHash a.unit.attested) settings.epoch result ] onUnitPage

        busy =
            settle (Err busyMarker)

        plain =
            settle (Err plainMarker)

        succeeded =
            settle (Ok Queue.Undecided)

        lead =
            "Review status read failed: "
    in
    standingFailure busy.standing
        == Just LoadContended
        && showsOnly (lead ++ Failure.loadFailureText LoadContended) busy
        && standingFailure plain.standing
        == Just LoadFailed
        && showsOnly (lead ++ Failure.loadFailureText LoadFailed) plain
        && standingFailure succeeded.standing
        == Nothing
        && not (String.contains lead (page succeeded))


-- A blank or over-long refusal draft stays open as a typed case, its panel
-- the case's fixed text; a reason within the ceiling starts the decision.
-- Red if a refused draft starts a decision or shows any other text.
refuseDraftTyped : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
refuseDraftTyped settings a b =
    let
        ua =
            a.unit.uid

        shown =
            queueModel [ a, b ] (ViewShown a)

        submit draft =
            after settings [ RefuseStart ua, RefuseDraft draft, RefuseSubmit ua ] shown

        blank =
            submit "   "

        overChars =
            LibDb.reasonMaxChars + 1

        overlong =
            submit (String.repeat overChars "x")

        overlongCase =
            DraftRefused (ReasonOverlong { chars = overChars, limit = LibDb.reasonMaxChars })

        kept =
            submit "needs a test"
    in
    blank.refuseError
        == Just (DraftRefused ReasonBlank)
        && blank.decision
        == DecisionIdle
        && String.contains (Failure.refuseFailureText (DraftRefused ReasonBlank)) (page blank)
        && overlong.refuseError
        == Just overlongCase
        && overlong.decision
        == DecisionIdle
        && String.contains (Failure.refuseFailureText overlongCase) (page overlong)
        && kept.refuseError
        == Nothing
        && kept.decision
        == DecisionSaving ua settings.epoch


-- A decision on a unit off the shown queue page is refused as `NotQueued`,
-- one on a queued unit whose source is not the one shown as
-- `SourceNotShown`, an acknowledgement of a file off the page as
-- `FileNotQueued`, and one of a listed file with no digest as
-- `FileNotAcknowledgeable`, each a value decided before any database is
-- opened, and the save's banner the refusal's fixed text. Red if
-- `decisionTask` decides a unit or file the reviewer was not shown, or a
-- refusal is read as a failure.
decisionRefusedBeforeReading : Task.Task Error Bool
decisionRefusedBeforeReading =
    do
        at <- freshScratch "ipe-single-flight-refused"
        seedIndex at.indexDb at.repo
        settings <- envAppSettings
        macKey <- testMacKey
        a <- loadUnitNow (uid "u-a") |> Task.andThen requireUnit
        b <- loadUnitNow (uid "u-b") |> Task.andThen requireUnit
        offList <- App.decisionTask settings macKey (queueModel [ a ] (ViewShown a)) OnUnit b.unit.uid LibDb.Approved
        notShown <- App.decisionTask settings macKey (queueModel [ a, b ] (ViewShown a)) OnUnit b.unit.uid LibDb.Approved
        fileOffList <- App.decisionTask settings macKey (queueModel [ a, b ] (ViewShown a)) OnRefusal (uid "r-blocking") LibDb.Approved
        fileBlocking <- App.decisionTask settings macKey (withRefusal blockingRow (queueModel [ a, b ] (ViewShown a))) OnRefusal (uid "r-blocking") LibDb.Approved
        cleanupIndex at.indexDb at.repo
        Task.succeed
            (refusalOf offList
                == Just NotQueued
                && refusalOf notShown
                == Just SourceNotShown
                && refusalOf fileOffList
                == Just FileNotQueued
                && refusalOf fileBlocking
                == Just FileNotAcknowledgeable
                && savedRefusal (Failure.saved (Ok fileBlocking))
                == Just FileNotAcknowledgeable
                && savedRefusal (Failure.saved (Ok offList))
                == Just NotQueued
                && savedRefusal (Failure.saved (Ok notShown))
                == Just SourceNotShown
            )



-- A file the index refuses for a blocking reason, so it carries no digest.
blockingRow : Index.RefusalRow
blockingRow =
    { uid = uid "r-blocking"
    , path = labelOf "ipe:src/unreadable.txt"
    , lang = "other"
    , reason = UnreadableEntry
    , size = Nothing
    , digest = Nothing
    }


-- `model` with `row` listed among its queue page's unreviewable files.
withRefusal : Index.RefusalRow -> Model -> Model
withRefusal row model =
    case model.queueState of
        Loaded loaded ->
            { model | queueState = Loaded { loaded | refusals = row :: loaded.refusals } }

        Loading ->
            model

        Failed _ ->
            model

-- The refusal a settled save carries, if it was refused.
savedRefusal : Result SaveFailure a -> Maybe DecideRefusal
savedRefusal result =
    case result of
        Err (SaveRefused refusal) ->
            Just refusal

        Err _ ->
            Nothing

        Ok _ ->
            Nothing


-- ── harness ─────────────────────────────────────────────────────────────
-- The settings a server would parse for the seeded index, an epoch minted
-- apart from theirs, standing for another process's, and the two seeded
-- fixture units, handed to `body`.
withSeeded :
    String
    -> (Settings.AppSettings
        -> Epoch
        -> Index.UnitView
        -> Index.UnitView
        -> List ( String, Bool ))
    -> Task.Task Error (List ( String, Bool ))
withSeeded name body =
    do
        at <- freshScratch name
        seedIndex at.indexDb at.repo
        settings <- envAppSettings
        otherEpoch <- Epoch.mint
        a <- loadUnitNow (uid "u-a") |> Task.andThen requireUnit
        b <- loadUnitNow (uid "u-b") |> Task.andThen requireUnit
        cleanupIndex at.indexDb at.repo
        Task.succeed (body settings otherEpoch a b)


requireUnit : Maybe Index.UnitView -> Task.Task Error Index.UnitView
requireUnit found =
    case found of
        Just loaded ->
            Task.succeed loaded

        Nothing ->
            Task.fail (Error.conflict "a fixture unit is missing from the seeded index")


-- A saved decision stays busy until the queue reload that follows it
-- settles, so the row it was made on, still listed until then, offers no
-- control a second decision could land on: a press by button, key or
-- acknowledgement starts nothing, and the card says the queue is
-- refreshing. An older load's result leaves it busy; the reload settling,
-- failed or superseded by a later load, ends it. Red if a decision is idle
-- once written while its row is still listed, or if no later load frees it.
writtenStaysPending : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> ( Index.Attested, Index.Written ) -> Bool
writtenStaysPending settings a b pair =
    let
        ua =
            a.unit.uid

        saving =
            after settings [ ApproveUnit ua ] (queueModel [ a, b ] (ViewShown a))

        written =
            after settings [ DecisionSaved ua settings.epoch (Ok pair) ] saving

        pressed =
            after settings [ ApproveUnit ua, KeyDown "a", AckRefusal ua ] written

        olderLoad =
            after settings [ PendingLoaded saving.queueLoad (Ok (queuePageOf [ a, b ])) ] pressed

        reloaded =
            after settings [ PendingLoaded written.queueLoad (Ok (queuePageOf [ b ])) ] pressed

        reloadFailed =
            after settings [ App.queueLoaded written.queueLoad (Err (Error.conflict "boom")) ] pressed

        superseding =
            after settings [ Navigated QueuePage ] pressed

        superseded =
            after settings [ PendingLoaded written.queueLoad (Ok (queuePageOf [ a, b ])), PendingLoaded superseding.queueLoad (Ok (queuePageOf [ b ])) ] superseding

        writtenPage =
            page written
    in
    written.decision
        == DecisionRefreshing ua settings.epoch
        && pressed.decision
        == DecisionRefreshing ua settings.epoch
        && String.contains "Decision saved; refreshing the queue…" writtenPage
        && not (String.contains ">Approve<" writtenPage)
        && olderLoad.decision
        == DecisionRefreshing ua settings.epoch
        && reloaded.decision
        == DecisionIdle
        && reloadFailed.decision
        == DecisionIdle
        && superseding.decision
        == DecisionRefreshing ua settings.epoch
        && superseded.decision
        == DecisionIdle


-- The notice of a decision that was not saved advises a reload, and the
-- reload clears it: the queue load that a page entry starts, once it
-- succeeds, leaves no notice. A load that fails keeps it. Red if the
-- notice survives the reload its text tells the reviewer to make.
notSavedClearedByReload : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
notSavedClearedByReload settings a b =
    let
        ua =
            a.unit.uid

        failed =
            after settings [ ApproveUnit ua, App.decisionSaved ua settings.epoch (Err (Error.conflict "boom")) ] (queueModel [ a, b ] (ViewShown a))

        reloading =
            after settings [ Navigated QueuePage ] failed

        reloaded =
            after settings [ PendingLoaded reloading.queueLoad (Ok (queuePageOf [ a, b ])) ] reloading

        reloadFailed =
            after settings [ App.queueLoaded reloading.queueLoad (Err (Error.conflict "boom")) ] reloading

        banner =
            Html.escapeHtml ("Decision save failed: " ++ Failure.saveFailureText SaveFailed)
    in
    Queue.notSavedOf failed.decision
        == Just SaveFailed
        && String.contains banner (page failed)
        && Queue.notSavedOf reloading.decision
        == Just SaveFailed
        && reloaded.decision
        == DecisionIdle
        && not (String.contains banner (page reloaded))
        && Queue.notSavedOf reloadFailed.decision
        == Just SaveFailed


-- Only a reload started after the failure clears its notice: a queue load
-- started while the decision was saving, by a page entry or a reconnect,
-- read the queue before the failure was known, so its result keeps the
-- notice, and the reload after it clears it. Red if a load that predates
-- the failure wipes the notice before the reviewer saw why the decision
-- was not saved.
notSavedOutlivesOlderLoad : Settings.AppSettings -> Index.UnitView -> Index.UnitView -> Bool
notSavedOutlivesOlderLoad settings a b =
    let
        ua =
            a.unit.uid

        enteredWhileSaving =
            after settings [ ApproveUnit ua, Navigated QueuePage ] (queueModel [ a, b ] (ViewShown a))

        failed =
            after settings [ App.decisionSaved ua settings.epoch (Err (Error.conflict "boom")) ] enteredWhileSaving

        olderLoaded =
            after settings [ PendingLoaded enteredWhileSaving.queueLoad (Ok (queuePageOf [ a, b ])) ] failed

        reloading =
            after settings [ Navigated QueuePage ] olderLoaded

        reloaded =
            after settings [ PendingLoaded reloading.queueLoad (Ok (queuePageOf [ a, b ])) ] reloading

        banner =
            Html.escapeHtml ("Decision save failed: " ++ Failure.saveFailureText SaveFailed)
    in
    Queue.notSavedOf failed.decision
        == Just SaveFailed
        && Queue.notSavedOf olderLoaded.decision
        == Just SaveFailed
        && String.contains banner (page olderLoaded)
        && reloaded.decision
        == DecisionIdle
        && not (String.contains banner (page reloaded))


-- The written-decision checks, on a decision really written through
-- `Queue.decide` to a fresh review database, so the app receives the saved
-- result a server's decision returns.
writtenChecks : Task.Task Error (List ( String, Bool ))
writtenChecks =
    do
        at <- freshScratch "ipe-single-flight-written"
        removeFileIfAny at.indexDb
        removeFileIfAny at.reviewDb
        seedIndex at.indexDb at.repo
        settings <- envAppSettings
        a <- loadUnitNow (uid "u-a") |> Task.andThen requireUnit
        b <- loadUnitNow (uid "u-b") |> Task.andThen requireUnit
        db <- migratedReviewAt at.reviewDb
        pair <- decideNow db (uid "u-a") Approved
        cleanupIndex at.indexDb at.repo
        removeFileIfAny at.reviewDb
        Task.succeed [ ( "a saved decision withholds its row's controls until the queue reload settles", writtenStaysPending settings a b pair ) ]


checks : Task.Task Error (List ( String, Bool ))
checks =
    Task.map2 (\seeded refused -> seeded ++ [ refused ])
        seededChecks
        (check "a decision off the shown list or source is refused before any read" decisionRefusedBeforeReading)


seededChecks : Task.Task Error (List ( String, Bool ))
seededChecks =
    withSeeded "ipe-single-flight"
        (\settings otherEpoch a b ->
            [ ( "unit-page entries during a source read start no second read", unitEntriesDuringReadCoalesce settings a b )
            , ( "the queue card and the unit page share one source read slot", oneReadSlotAcrossPages settings a b )
            , ( "the unit page settles only on its own unit's read", unitPageSettlesOnItsOwnRead settings a b )
            , ( "a decision asked while one is saving starts no second decision", decisionsSingleFlight settings a b )
            , ( "a decision saving under another process's epoch blocks no decision", foreignDecisionIsIdle settings otherEpoch a b )
            , ( "a source read in flight under another process's epoch blocks no read", foreignReadIsIdle settings otherEpoch a b )
            , ( "a decision asked off the queue page takes no decision slot", decisionOffQueueHoldsNoSlot settings a b )
            , ( "a refused decision and a unit page awaiting its read render as such", busyRendered settings a b )
            , ( "a failed save is a typed case whose banner holds no error text", saveFailureRendered settings a b )
            , ( "a decision on a read-only server is refused before it takes the slot", readOnlySaveRefused settings a b )
            , ( "a not-saved notice is cleared by the reload it advises", notSavedClearedByReload settings a b )
            , ( "a queue load started before a failed save keeps its notice", notSavedOutlivesOlderLoad settings a b )
            , ( "a failed queue load is a typed case whose page holds no error text", queueLoadFailureTyped settings a )
            , ( "a failed History load is a typed case whose page holds no error text", historyLoadFailureTyped settings )
            , ( "a failed source read is a typed case whose card holds no error text", viewLoadFailureTyped settings a b )
            , ( "a failed unit-page read is a typed case whose page holds no error text", unitLoadFailureTyped settings a )
            , ( "a failed standing read is a typed case whose page holds no error text", standingLoadFailureTyped settings a )
            , ( "a refused refusal draft is a typed case with a fixed text", refuseDraftTyped settings a b )
            ]
        )
        |> Task.andThen (\rows -> writtenChecks |> Task.map (\written -> rows ++ written))
        |> Task.onError (\e -> checkReporting Io.println "single-flight fixtures" (Task.fail e) |> Task.map (\failed -> [ failed ]))
