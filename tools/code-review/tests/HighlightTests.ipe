module HighlightTests exposing (checks)

import HighlightFrozen
import Ipe.ByteSize as ByteSize
import Ipe.Char as Char
import Ipe.Error as Error
import Ipe.List as List
import Ipe.String as String
import Ipe.Task as Task
import Ipe.Tuple as Tuple
import Lib.Highlight as Highlight exposing (Lang(..), LeadingMark(..), LineEnds(..), Separator(..), Token(..))
import Lib.Index as Index


-- Each check pins one language's lexical grammar: a delimiter opens a
-- comment or string only in the language whose grammar names it, and a
-- lexeme open at a line's end carries into the next line.
rawText : Token -> String
rawText tok =
    case tok of
        Keyword t ->
            t

        Str t ->
            t

        Comment t ->
            t

        Num t ->
            t

        Ident t ->
            t

        Plain t ->
            t


reassembles : Lang -> String -> Bool
reassembles lang src =
    String.concat (List.map rawText (Highlight.tokenize lang src)) == src


isComment : Token -> Bool
isComment tok =
    case tok of
        Comment _ ->
            True

        Keyword _ ->
            False

        Str _ ->
            False

        Num _ ->
            False

        Ident _ ->
            False

        Plain _ ->
            False


-- The tokens of two consecutive lines, the second lexed with the carry out
-- of the first, as the source view lexes its rows.
twoLines : Lang -> String -> String -> ( List Token, List Token )
twoLines lang first second =
    case Highlight.lexLine lang Highlight.lineStart first of
        ( firstToks, carry ) ->
            case Highlight.lexLine lang carry second of
                ( secondToks, _ ) ->
                    ( firstToks, secondToks )


-- Ipê: `--` opens a line comment that swallows a `//` after it; `//`,
-- `/* */` and `#` are punctuation; `->` opens nothing.
ipeLineComments : Bool
ipeLineComments =
    Highlight.tokenize Ipe "x -- c // d" == [ Ident "x", Plain " ", Comment "-- c // d" ]
        && Highlight.tokenize Ipe "a // b" == [ Ident "a", Plain " ", Plain "/", Plain "/", Plain " ", Ident "b" ]
        && Highlight.tokenize Ipe "/* b */" == [ Plain "/", Plain "*", Plain " ", Ident "b", Plain " ", Plain "*", Plain "/" ]
        && Highlight.tokenize Ipe "a # b" == [ Ident "a", Plain " ", Plain "#", Plain " ", Ident "b" ]
        && Highlight.tokenize Ipe "a -> b" == [ Ident "a", Plain " ", Plain "-", Plain ">", Plain " ", Ident "b" ]


-- Ipê: a nested `{- -}` block comment carries its depth across lines; a
-- `{-|` doc comment does not nest, so it closes at its first `-}`.
ipeBlockComments : Bool
ipeBlockComments =
    twoLines Ipe "{- a {- b" "-} c -} x" == ( [ Comment "{- a {- b" ], [ Comment "-} c -}", Plain " ", Ident "x" ] )
        && Highlight.tokenize Ipe "{-| a {- b -} c" == [ Comment "{-| a {- b -}", Plain " ", Ident "c" ]


-- Ipê: `--` inside a string or after a `'"'` char literal is code, and an
-- unterminated one-line string ends with its line, so the next line's
-- `--` is a comment.
ipeStrings : Bool
ipeStrings =
    Highlight.tokenize Ipe "\"a -- b\" c" == [ Str "\"a -- b\"", Plain " ", Ident "c" ]
        && Highlight.tokenize Ipe "'\"' -- q" == [ Str "'\"'", Plain " ", Comment "-- q" ]
        && twoLines Ipe "\"a" "-- c" == ( [ Plain "\"a" ], [ Comment "-- c" ] )


-- Shell: a `#` at a word start is a comment and swallows a `/*` after it;
-- `/* */` is punctuation on one line or across two; `--` and `$#` open
-- nothing.
shellComments : Bool
shellComments =
    Highlight.tokenize Shell "echo x # c /* d */" == [ Keyword "echo", Plain " ", Ident "x", Plain " ", Comment "# c /* d */" ]
        && Highlight.tokenize Shell "/* x */" == [ Plain "/", Plain "*", Plain " ", Ident "x", Plain " ", Plain "*", Plain "/" ]
        && twoLines Shell "/* a" "b */ # c" == ( [ Plain "/", Plain "*", Plain " ", Ident "a" ], [ Ident "b", Plain " ", Plain "*", Plain "/", Plain " ", Comment "# c" ] )
        && Highlight.tokenize Shell "ls --all" == [ Ident "ls", Plain " ", Plain "-", Plain "-", Ident "all" ]
        && Highlight.tokenize Shell "echo $#" == [ Keyword "echo", Plain " ", Plain "$", Plain "#" ]


-- Shell: a `'…'` string spans lines, so a `#` inside it is no comment and
-- the code after its close is lexed as code.
shellStrings : Bool
shellStrings =
    twoLines Shell "echo 'a # b" "c' # d"
        == ( [ Keyword "echo", Plain " ", Str "'a # b" ], [ Str "c'", Plain " ", Comment "# d" ] )


secondLine : ( List Token, List Token ) -> List Token
secondLine lines =
    case lines of
        ( _, second ) ->
            second


-- Shell: a `$'…'` string takes `\` escapes, so a `\'` in it closes
-- nothing, on its line or across two; a `\$` escapes the `$`, leaving a
-- verbatim `'…'` string.
shellDollarStrings : Bool
shellDollarStrings =
    Highlight.tokenize Shell "echo $'it\\'s' # c" == [ Keyword "echo", Plain " ", Str "$'it\\'s'", Plain " ", Comment "# c" ]
        && twoLines Shell "x=$'a\\'" "b' # c" == ( [ Ident "x", Plain "=", Str "$'a\\'" ], [ Str "b'", Plain " ", Comment "# c" ] )
        && Highlight.tokenize Shell "echo \\$'a\\'" == [ Keyword "echo", Plain " ", Plain "\\$", Str "'a\\'" ]


-- Shell: a `<<` inside `((…))` or `$((…))` is a shift, so the line after it
-- keeps its carry; a `<<` after the arithmetic closes still opens a heredoc,
-- whose body line opens no string past itself.
shellArithmeticShift : Bool
shellArithmeticShift =
    twoLines Shell "x=$((1 << 2)); echo 'a" "b' # c" == ( [ Ident "x", Plain "=", Plain "$", Plain "(", Plain "(", Num "1", Plain " ", Plain "<", Plain "<", Plain " ", Num "2", Plain ")", Plain ")", Plain ";", Plain " ", Keyword "echo", Plain " ", Str "'a" ], [ Str "b'", Plain " ", Comment "# c" ] )
        && secondLine (twoLines Shell "((n <<= (1))); echo 'a" "b' # c") == [ Str "b'", Plain " ", Comment "# c" ]
        && secondLine (twoLines Shell "cat $((1)) <<EOF" "don't") == [ Ident "don", Str "'t" ]


-- Rust: a `'"'` char literal opens no string, so the `//` after it is a
-- comment; `//` inside a string is the string's; `--` and `#` open nothing;
-- a lifetime's `'` is punctuation; block comments nest.
rustComments : Bool
rustComments =
    Highlight.tokenize Rust "let q = '\"'; // c" == [ Keyword "let", Plain " ", Ident "q", Plain " ", Plain "=", Plain " ", Str "'\"'", Plain ";", Plain " ", Comment "// c" ]
        && Highlight.tokenize Rust "\"a // b\" c" == [ Str "\"a // b\"", Plain " ", Ident "c" ]
        && Highlight.tokenize Rust "x -- y" == [ Ident "x", Plain " ", Plain "-", Plain "-", Plain " ", Ident "y" ]
        && Highlight.tokenize Rust "#[test]" == [ Plain "#", Plain "[", Ident "test", Plain "]" ]
        && Highlight.tokenize Rust "&'a str" == [ Plain "&", Plain "'", Ident "a", Plain " ", Ident "str" ]
        && Highlight.tokenize Rust "/* a /* b */ c */ x" == [ Comment "/* a /* b */ c */", Plain " ", Ident "x" ]


-- Rust: a `r#"…"#` raw string closes only at `"#`, on its line or a later
-- one, and a `"…"` string carries across lines; a `//` inside either is
-- the string's.
rustStrings : Bool
rustStrings =
    Highlight.tokenize Rust "r#\"a \" // b\"# c" == [ Str "r#\"a \" // b\"#", Plain " ", Ident "c" ]
        && twoLines Rust "let s = r#\"a" "// b\"# + 1" == ( [ Keyword "let", Plain " ", Ident "s", Plain " ", Plain "=", Plain " ", Str "r#\"a" ], [ Str "// b\"#", Plain " ", Plain "+", Plain " ", Num "1" ] )
        && twoLines Rust "let s = \"a" "// b\";" == ( [ Keyword "let", Plain " ", Ident "s", Plain " ", Plain "=", Plain " ", Str "\"a" ], [ Str "// b\"", Plain ";" ] )


-- A language with no grammar is one Plain token, whole or per line.
unknownIsPlain : Bool
unknownIsPlain =
    Highlight.tokenize Unknown "// a # b -- c {- d" == [ Plain "// a # b -- c {- d" ]
        && twoLines Unknown "/* a" "b */" == ( [ Plain "/* a" ], [ Plain "b */" ] )


-- Lexemes left open at the end of the input close as Plain, in one pass:
-- a 256 KiB unterminated block comment, 64Ki nested `{-` openers, and a raw
-- string open over 64Ki lines (each carried line a Str piece). Red if a
-- step copies its state or the tokens so far per character or per line.
unterminatedAtEof : Bool
unterminatedAtEof =
    let
        block =
            "/* " ++ String.repeat 262144 "a"

        nested =
            String.repeat 65536 "{-"

        raw =
            "r#\"" ++ String.repeat 65536 "a\n"

        rawToks =
            Highlight.tokenize Rust raw
    in
    Highlight.tokenize Rust block == [ Plain block ]
        && Highlight.tokenize Ipe nested == [ Plain nested ]
        && List.length rawToks == 131072
        && not (List.any isComment rawToks)
        && reassembles Rust raw


-- A quarter-mebibyte line in each language tokenizes whole and loses
-- nothing; a mebibyte Ipê line comment is one token.
longLines : Bool
longLines =
    let
        comment =
            "-- " ++ String.repeat 1048573 "x"
    in
    reassembles Ipe (String.repeat 32768 "a -> {b} ")
        && reassembles Shell (String.repeat 32768 "a 'b' \\c ")
        && reassembles Rust (String.repeat 32768 "r\"a\" '\"' ")
        && Highlight.tokenize Ipe comment == [ Comment comment ]


codeText : Int -> String
codeText code =
    String.fromChar (Char.fromCode code)


kindOf : Token -> ( String, String )
kindOf tok =
    case tok of
        Keyword t ->
            ( "keyword", t )

        Str t ->
            ( "str", t )

        Comment t ->
            ( "comment", t )

        Num t ->
            ( "num", t )

        Ident t ->
            ( "ident", t )

        Plain t ->
            ( "plain", t )


frozenLang : Lang -> HighlightFrozen.Lang
frozenLang lang =
    case lang of
        Rust ->
            HighlightFrozen.Rust

        Shell ->
            HighlightFrozen.Shell

        Ipe ->
            HighlightFrozen.Ipe

        Unknown ->
            HighlightFrozen.Unknown


allLangs : List Lang
allLangs =
    [ Rust, Shell, Ipe, Unknown ]


-- Every string of length 0..3 over the characters the grammars branch on.
exhaustiveInputs : List String
exhaustiveInputs =
    let
        alphabet =
            [ "b", "c", "r", "a", "1", "\"", "'", "#", "\\", "/", "*", "-", "{", "}", "|", "$", "<", " ", codeText 9, codeText 13, "\n", codeText 0 ]

        extendAll prefixes =
            List.concatMap (\prefix -> List.map (\c -> prefix ++ c) alphabet) prefixes

        two =
            extendAll alphabet
    in
    List.concat [ [ "" ], alphabet, two, extendAll two ]


wordHeadInputs : List String
wordHeadInputs =
    List.concatMap
        (\head -> [ head, head ++ "\n", head ++ "\nz" ])
        [ "b", "c", "br\"x\"", "cr\"x\"", "b\"x\"", "bx", "brr", "bR\"x\"", "Br\"x\"", "Cr\"x\"", "r#\"x\"#", "br##\"a\"#\"##", "c'x'" ]


handPickedInputs : List String
handPickedInputs =
    let
        nul =
            codeText 0

        rlo =
            codeText 8238
    in
    List.concat
        [ wordHeadInputs
        , [ "\"abc", "'a", "r#\"x", "/* x", "{- x {- y -}", "{-| x", "\"\"\"x", "$'x" ]
        , [ "cat <<EOF", "cat <<-EOF\nbody\n" ++ codeText 9 ++ "EOF\nz", "cat <<EOF\nbody\nEOF\nz", "$((1<<2))" ]
        , [ "a" ++ codeText 13 ++ "\nb", "a" ++ codeText 13 ++ "b", codeText 65279 ++ "fn x" ]
        , [ "\"a" ++ nul ++ "b\"", "// a" ++ nul ++ "b", "-- a" ++ nul ++ "b", "# a" ++ nul ++ "b" ]
        , [ codeText 233, codeText 8364, codeText 128512 ]
        , [ "a" ++ rlo ++ "b", "\"a" ++ rlo ++ "b\"", "-- a" ++ rlo ++ "b", "// a" ++ rlo ++ "b" ]
        , [ "0x1F", "1_000", "1e-3", "1.2.3" ]
        ]


-- Every ordered pair of hand-picked inputs on two lines, so each one is lexed
-- with every other's carry.
pairedInputs : List String
pairedInputs =
    List.concatMap (\first -> List.map (\second -> first ++ "\n" ++ second) handPickedInputs) handPickedInputs


-- Lines that close whatever a lexeme left open, so a carry that differs
-- between the two lexers shows up as different tokens.
flushTail : List String
flushTail =
    [ "\"", "'", "*/ a", "-} b", "\"\"\"", "EOF", "z" ]


sameTokens : Lang -> String -> Bool
sameTokens lang src =
    List.map kindOf (Highlight.tokenize lang src)
        == List.map HighlightFrozen.kindOf (HighlightFrozen.tokenize (frozenLang lang) src)


lexLines : Lang -> List String -> List (List ( String, String ))
lexLines lang lines =
    Tuple.second (List.foldl (lexNext lang) ( Highlight.lineStart, [] ) lines)


lexNext : Lang -> String -> ( Highlight.Carry, List (List ( String, String )) ) -> ( Highlight.Carry, List (List ( String, String )) )
lexNext lang line ( carry, done ) =
    case Highlight.lexLine lang carry line of
        ( toks, next ) ->
            ( next, done ++ [ List.map kindOf toks ] )


frozenLexLines : HighlightFrozen.Lang -> List String -> List (List ( String, String ))
frozenLexLines lang lines =
    Tuple.second (List.foldl (frozenLexNext lang) ( HighlightFrozen.lineStart, [] ) lines)


frozenLexNext : HighlightFrozen.Lang -> String -> ( HighlightFrozen.Carry, List (List ( String, String )) ) -> ( HighlightFrozen.Carry, List (List ( String, String )) )
frozenLexNext lang line ( carry, done ) =
    case HighlightFrozen.lexLine lang carry line of
        ( toks, next ) ->
            ( next, done ++ [ List.map HighlightFrozen.kindOf toks ] )


sameLines : Lang -> String -> Bool
sameLines lang src =
    let
        lines =
            String.split "\n" src ++ flushTail
    in
    lexLines lang lines == frozenLexLines (frozenLang lang) lines


-- The tokens of every input are the frozen lexer's, whole or line by line
-- with the carry between lines. Red if a state split changes any token or
-- any carry, e.g. a raw-string prefix taken for a word that began with `B`.
tokenizeMatchesFrozen : Bool
tokenizeMatchesFrozen =
    List.all (\lang -> List.all (sameTokens lang) (List.concat [ exhaustiveInputs, handPickedInputs, pairedInputs ])) allLangs


lexLineMatchesFrozen : Bool
lexLineMatchesFrozen =
    List.all (\lang -> List.all (sameLines lang) (List.concat [ exhaustiveInputs, handPickedInputs, pairedInputs ])) allLangs


-- One maximal word at the shown-view ceiling: letters only, a `b` then
-- letters (the word-head state then the word state), and digits only. Each is
-- one token of the kind the frozen lexer gives the same shape at 64 characters.
-- Red if a step copies the open word per character (quadratic: never ends).
longWordShape : Int -> Int -> String
longWordShape shape size =
    if shape == 0 then
        String.repeat size "a"

    else if shape == 1 then
        "b" ++ String.repeat (size - 1) "a"

    else
        String.repeat size "1"


longWordIsOneToken : Lang -> Int -> Bool
longWordIsOneToken lang shape =
    let
        long =
            longWordShape shape (ByteSize.toBytes Index.viewByteCeiling)

        expected =
            List.map HighlightFrozen.kindOf (HighlightFrozen.tokenize (frozenLang lang) (longWordShape shape 64))

        got =
            Highlight.tokenize lang long
    in
    List.length expected == 1
        && List.length got == 1
        && List.map (\tok -> Tuple.first (kindOf tok)) got == List.map Tuple.first expected
        && String.concat (List.map rawText got) == long


longWordsLinear : Bool
longWordsLinear =
    List.all (\lang -> List.all (longWordIsOneToken lang) [ 0, 1, 2 ]) allLangs


-- Each token holds at least one character and only a line break adds its own
-- token, so a lex never yields more tokens than the source has characters
-- plus one.
tokenCountBounded : Bool
tokenCountBounded =
    List.all
        (\lang -> List.all (\src -> List.length (Highlight.tokenize lang src) <= String.length src + 1) (exhaustiveInputs ++ handPickedInputs))
        allLangs


-- Each language's layout and path facts are its grammar row's: a CRLF is
-- one line break in Rust and Ipê, only Rust skips a leading byte-order mark,
-- and a path joins with `::` (Rust, `crate` its own root) or `.` (Ipê). A
-- language with no grammar, and shell, hide nothing and spell no path.
languageFacts : Bool
languageFacts =
    List.map factsOf [ Rust, Ipe, Shell, Unknown ]
        == [ "crlf-break mark-skipped :: crate", "crlf-break mark-text .", "cr-text mark-text none", "cr-text mark-text none" ]


factsOf : Lang -> String
factsOf lang =
    let
        layout =
            Highlight.layoutOf lang
    in
    lineEndsName layout.lineEnds ++ " " ++ leadingMarkName layout.leadingMark ++ " " ++ pathName lang


lineEndsName : LineEnds -> String
lineEndsName ends =
    case ends of
        CrlfIsOneBreak ->
            "crlf-break"

        CrIsText ->
            "cr-text"


leadingMarkName : LeadingMark -> String
leadingMarkName mark =
    case mark of
        MarkSkipped ->
            "mark-skipped"

        MarkIsText ->
            "mark-text"


pathName : Lang -> String
pathName lang =
    case Highlight.pathRule lang of
        Just rule ->
            separatorName rule.separator ++ ownRootName rule.ownRoot

        Nothing ->
            "none"


separatorName : Separator -> String
separatorName sep =
    case sep of
        DotSeparator ->
            "."

        DoubleColonSeparator ->
            "::"


ownRootName : Maybe String -> String
ownRootName root =
    case root of
        Just word ->
            " " ++ word

        Nothing ->
            ""


checks : Task.Task Error (List ( String, Bool ))
checks =
    Task.succeed
        [ ( "Ipe -- is a line comment; //, /* and # are not", ipeLineComments )
        , ( "Ipe {- -} nests across lines; {-| does not nest", ipeBlockComments )
        , ( "Ipe -- in a string or after '\"' is code", ipeStrings )
        , ( "shell # is a comment; /* */, -- and $# are not", shellComments )
        , ( "shell '...' spans lines and hides #", shellStrings )
        , ( "shell $'...' takes escapes", shellDollarStrings )
        , ( "shell << in arithmetic is no heredoc", shellArithmeticShift )
        , ( "Rust '\"' opens no string; // in a string is the string's", rustComments )
        , ( "Rust raw and plain strings carry across lines", rustStrings )
        , ( "a language with no grammar is plain", unknownIsPlain )
        , ( "lexemes open at end of input close in one pass", unterminatedAtEof )
        , ( "a quarter-mebibyte line lexes whole in each language", longLines )
        , ( "each language's layout and path facts are its grammar row", languageFacts )
        , ( "tokenize matches the frozen lexer on every corpus input", tokenizeMatchesFrozen )
        , ( "lexLine tokens and carries match the frozen lexer", lexLineMatchesFrozen )
        , ( "one maximal word at the view ceiling lexes as one token", longWordsLinear )
        , ( "a lex yields at most one token per character plus one", tokenCountBounded )
        ]
