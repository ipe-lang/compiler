-- ── bounded, indexed links ──────────────────────────────────────────────
--
-- A unit page's links come from two bounded, indexed lookups: the unit's
-- callgraph edges, and the qualified names its shown references spell under
-- ipe-index's callee rule. The fixture below seeds a scratch index whose one
-- Rust unit `u-src` calls into every case, and one Ipê unit `u-ipe` writes a
-- call with no space before its argument list.
rustLines : List String
rustLines =
    [ "fn caller() {"
    , "    helper();"
    , "    app::util::exact(x);"
    , "    shared();"
    , "    dup::twin();"
    , "    dup::pair();"
    , "    app::links::caller();"
    , "}"
    ]


ipeLines : List String
ipeLines =
    [ "run x ="
    , "    Foo.bar(x)"
    ]


type alias FixtureUnit =
    { uid : String
    , path : String
    , kind : String
    , name : String
    , qualified : String
    , lines : Int
    , hash : String
    }


-- A unit the fixture never loads: its hash attests nothing.
other : String -> String -> String -> String -> FixtureUnit
other label path name qualified =
    { uid = label, path = path, kind = "fn", name = name, qualified = qualified, lines = 1, hash = "unloaded" }


-- In insertion (rowid) order: each duplicate pair puts the unit that must
-- not win first, so a lookup that keeps the first row it reads links it.
fixtureUnits : List FixtureUnit
fixtureUnits =
    [ { uid = "u-src", path = "ipe:src/links.rs", kind = "fn", name = "caller", qualified = "app::links::caller", lines = List.length rustLines, hash = Index.attest (String.join "\n" rustLines) }
    , { uid = "u-ipe", path = "ipe:src/Feature.ipe", kind = "fn", name = "run", qualified = "Feature.run", lines = List.length ipeLines, hash = Index.attest (String.join "\n" ipeLines) }
    , other "u-helper" "ipe:src/links.rs" "helper" "app::links::helper"
    , other "u-exact" "ipe:src/util.rs" "exact" "app::util::exact"
    , other "u-shared" "ipe:src/other.rs" "shared" "app::other::shared"
    , other "u-twin-a" "ipe:src/dup.rs" "twin" "dup::twin"
    , other "u-twin-z" "ipe:src/links.rs" "twin" "dup::twin"
    , other "u-pair-b" "ipe:src/dup.rs" "pair" "dup::pair"
    , other "u-pair-a" "ipe:src/dup2.rs" "pair" "dup::pair"
    , other "u-edge" "ipe:src/edge.rs" "edge" "zzz::edge"
    , other "u-foo" "ipe:src/Foo.ipe" "bar" "Foo.bar"
    ]


insertFixtureUnit : String -> FixtureUnit -> Task.Task Error ()
insertFixtureUnit indexDb u =
    execIndex indexDb
        "INSERT INTO units (uid, path, kind, name, qualified, line_start, line_end, facing, purpose, body_hash, updated_sha) VALUES (?,?,?,?,?,?,?,?,?,?,?)"
        [ Uid.toSql (uid u.uid)
        , SqlString u.path
        , SqlString u.kind
        , SqlString u.name
        , SqlString u.qualified
        , SqlInt 1
        , SqlInt u.lines
        , SqlString "internal"
        , SqlString "purpose"
        , SqlString u.hash
        , SqlString "sha"
        ]


-- `u-src` calls `u-edge`, which its source never names, and itself.
fixtureRows : String -> Task.Task Error ()
fixtureRows indexDb =
    Task.sequence
        (List.map (insertFixtureUnit indexDb) fixtureUnits
            ++ [ execIndex indexDb "INSERT INTO files (path, lang) VALUES (?, ?), (?, ?)" [ SqlString "ipe:src/links.rs", SqlString "rs", SqlString "ipe:src/Feature.ipe", SqlString "ipe" ]
            , execIndex indexDb "INSERT INTO callgraph (caller_uid, callee_uid) VALUES (?, ?), (?, ?)" [ Uid.toSql (uid "u-src"), Uid.toSql (uid "u-edge"), Uid.toSql (uid "u-src"), Uid.toSql (uid "u-src") ]
            ]
        )
        |> Task.map (\_ -> ())


type alias LinksFixture =
    { rust : List String
    , rustHidden : Maybe Hidden
    , ipe : List String
    , plan : List String
    , hugeEdge : List Label
    , longUid : List String
    }


-- The bytes of the stored qualified name of the callee the over-cap check
-- writes: far past the read window, so only a bound applied at the read keeps
-- the link's label small.
hugeQualifiedBytes : Int
hugeQualifiedBytes =
    1024 * 1024


-- The bytes a label's marker counts as dropped, if it was cut.
droppedOf : Label -> Maybe Int
droppedOf label =
    case List.head (List.reverse (Label.parts label)) of
        Just (LabelCut dropped _) ->
            Just dropped

        Just (LabelText _) ->
            Nothing

        Just (LabelEscapes _) ->
            Nothing

        Nothing ->
            Nothing


-- The labels of every link from `found` to fixture unit `label`.
labelsTo : String -> Maybe Index.UnitView -> List Label
labelsTo label found =
    case found of
        Just loaded ->
            List.map Links.label (List.filter (\l -> Links.linkKey l == internalKey label) loaded.links.links)

        Nothing ->
            []


-- The `linkKey` of an internal link to fixture unit `label`.
internalKey : String -> String
internalKey label =
    "i:" ++ Uid.toString (uid label)


keysOf : Maybe Index.UnitView -> List String
keysOf found =
    case found of
        Just loaded ->
            List.map Links.linkKey loaded.links.links

        Nothing ->
            [ "missing" ]


-- The query plan of the candidate lookup `u-src` makes.
candidatePlan : Task.Task Error (List String)
candidatePlan =
    case Index.candidateQuery "ipe:src/links.rs" (uid "u-src") [ "helper", "app::links::helper", "dup::twin" ] of
        ( sql, params ) ->
            indexConn
                |> Task.andThen
                    (\conn ->
                        Db.queryDecode conn
                            ("EXPLAIN QUERY PLAN " ++ sql)
                            params
                            (Db.Decode.succeed identity |> Db.Decode.required "detail" (Db.Decode.string "detail"))
                    )


linksFixture : Task.Task Error LinksFixture
linksFixture =
    do
        at <- freshScratch "links-bounded"
        seedIndex at.indexDb at.repo
        writeFileText (at.repo ++ "/src/links.rs") (String.join "\n" rustLines ++ "\n")
        writeFileText (at.repo ++ "/src/Feature.ipe") (String.join "\n" ipeLines ++ "\n")
        fixtureRows at.indexDb
        rust <- loadUnitNow (uid "u-src")
        ipe <- loadUnitNow (uid "u-ipe")
        plan <- candidatePlan
        execIndexUnchecked at.indexDb "UPDATE units SET qualified = ? WHERE uid = ?" [ SqlString (String.repeat hugeQualifiedBytes "z"), Uid.toSql (uid "u-edge") ]
        huge <- loadUnitNow (uid "u-src")
        execIndexUnchecked at.indexDb "UPDATE units SET uid = uid || 'a' WHERE uid IN (?, ?)" [ Uid.toSql (uid "u-edge"), Uid.toSql (uid "u-exact") ]
        execIndexUnchecked at.indexDb "UPDATE callgraph SET callee_uid = callee_uid || 'a' WHERE callee_uid = ?" [ Uid.toSql (uid "u-edge") ]
        longUid <- loadUnitNow (uid "u-src")
        cleanupIndex at.indexDb at.repo
        removeFileIfAny (at.repo ++ "/src/links.rs")
        removeFileIfAny (at.repo ++ "/src/Feature.ipe")
        Task.succeed { rust = keysOf rust, rustHidden = Maybe.map (\v -> v.links.hidden) rust, ipe = keysOf ipe, plan = plan, hugeEdge = labelsTo "u-edge" huge, longUid = keysOf longUid }


fixtureChecks : LinksFixture -> List ( String, Bool )
fixtureChecks got =
    [ ( "a callgraph edge links the callee", List.member (internalKey "u-edge") got.rust )
    , ( "an exact qualified reference links", List.member (internalKey "u-exact") got.rust )
    , ( "a bare reference links to its own module's unit", List.member (internalKey "u-helper") got.rust )
    , ( "a bare reference never links to another module's unit of the same name", not (List.member (internalKey "u-shared") got.rust) )
    , ( "a duplicate qualified name links the same-path unit, then the lowest uid"
    , List.member (internalKey "u-twin-z") got.rust
        && not (List.member (internalKey "u-twin-a") got.rust)
        && List.member (internalKey "u-pair-a") got.rust
        && not (List.member (internalKey "u-pair-b") got.rust)
    )
    , ( "a unit never links to itself", not (List.member (internalKey "u-src") got.rust) )
    , ( "links are edges first, then references in first-occurrence order, nothing hidden"
    , got.rust
        == [ internalKey "u-edge", internalKey "u-helper", internalKey "u-exact", internalKey "u-twin-z", internalKey "u-pair-a" ]
        && got.rustHidden
        == Just NoneHidden
    )
    , ( "a call written as `Foo.bar(x)` links `Foo.bar`", got.ipe == [ internalKey "u-foo" ] )
    , ( "the candidate query uses i_units_qual", List.any (String.contains "i_units_qual") got.plan )
    , ( "a callee whose stored qualified name is a mebibyte links under a label cut at the read, its marker counting the dropped bytes"
      , List.length got.hugeEdge
            == 1
            && List.all
                (\l ->
                    Label.byteCount l
                        <= Label.capBytes Label.labelCap
                        + Label.markerByteCeiling
                        && droppedOf l
                        == Just (hugeQualifiedBytes - Label.capBytes Label.labelCap)
                )
                got.hugeEdge
      )
    , ( "a callee or a resolved reference whose stored uid is a unit id and one more hex digit is shown unlinked, never linked to the id its first 64 digits spell"
      , not (List.member (internalKey "u-edge") got.longUid)
            && not (List.member (internalKey "u-exact") got.longUid)
            && List.member ("t:" ++ Label.key (Label.fromText Label.labelCap (String.repeat hugeQualifiedBytes "z"))) got.longUid
            && List.member ("t:" ++ Label.key (Label.fromText Label.labelCap "app::util::exact")) got.longUid
            && List.member (internalKey "u-helper") got.longUid
      )
    ]


-- ── pure link rules ─────────────────────────────────────────────────────
-- One bare reference per name, `n` of them, in a Rust unit with no module.
manyNames : Int -> Links.Candidates
manyNames n =
    Links.candidates Highlight.Rust
        (unitNamed "fn" "f" "f")
        (Links.references Highlight.Rust (String.join " " (List.map (\i -> "n" ++ String.fromInt i) (List.range 1 n))))


candidateCeiling : Bool
candidateCeiling =
    let
        over =
            manyNames (Links.linkCandidateCeiling + 44)

        atCeiling =
            manyNames Links.linkCandidateCeiling

        bound =
            case Index.candidateQuery "p" (uid "u") over.names of
                ( _, params ) ->
                    List.length params
    in
    List.length over.names
        == Links.linkCandidateCeiling
        && over.reach
        == Capped
        && bound
        == Links.linkCandidateCeiling
        + 2
        && (Links.assemble { edges = Complete, candidates = over.reach } [] [] []).hidden
        == AtLeast 0
        && List.length atCeiling.names
        == Links.linkCandidateCeiling
        && atCeiling.reach
        == Complete


internalLinks : Int -> List Link
internalLinks n =
    List.map (\i -> Links.internal (Label.fromText Label.labelCap ("q" ++ String.fromInt i)) (Uid.toString (uid ("u" ++ String.fromInt i)))) (List.range 1 n)


linkCeilingCut : Bool
linkCeilingCut =
    let
        complete =
            { edges = Complete, candidates = Complete }

        over =
            Links.assemble complete (internalLinks 60) (internalLinks (Links.linkCeiling + 3)) []

        full =
            Links.assemble complete (internalLinks Links.linkCeiling) [] []

        edgesCut =
            Links.assemble { edges = Capped, candidates = Complete } (internalLinks (Links.linkCeiling + 1)) [] []

        note hidden =
            Maybe.map SafeText.toString (Links.hiddenNote hidden)
    in
    List.length over.links
        == Links.linkCeiling
        && over.hidden
        == Exactly 3
        && note over.hidden
        == Just "+3 more"
        && full.hidden
        == NoneHidden
        && note full.hidden
        == Nothing
        && edgesCut.hidden
        == AtLeast 1
        && note edgesCut.hidden
        == Just "+1 or more"



-- A unit's stored identity as the index read returns it: each column through
-- the same window `Label.columnOf` applies.
unitNamed : String -> String -> String -> Links.UnitName
unitNamed kind name qualified =
    { kind = Label.columnOf kind, name = Label.columnOf name, qualified = Label.columnOf qualified }


firstOccurrence : Bool
firstOccurrence =
    let
        wanted =
            Links.candidates Highlight.Ipe (unitNamed "file" "FILE" "F.FILE") (Links.references Highlight.Ipe "b a b c a")

        resolved =
            Links.resolveCandidates wanted.lookups [ ( "c", Uid.toString (uid "u-c") ), ( "a", Uid.toString (uid "u-a") ), ( "b", Uid.toString (uid "u-b") ) ]

        assembled =
            Links.assemble { edges = Complete, candidates = Complete } [ Links.internal (Label.fromText Label.labelCap "a") (Uid.toString (uid "u-a")) ] resolved (Links.sourceUrls "see https://x.io (https://x.io),")
    in
    wanted.names
        == [ "b", "a", "c" ]
        && List.map Links.linkKey resolved
        == [ internalKey "u-b", internalKey "u-a", internalKey "u-c" ]
        && List.map Links.linkKey assembled.links
        == [ internalKey "u-a", internalKey "u-b", internalKey "u-c", "e:https://x.io" ]


candidateRule : Bool
candidateRule =
    let
        namesFor lang unit refs =
            (Links.candidates lang unit refs).names
    in
    namesFor Highlight.Rust (unitNamed "fn" "caller" "app::links::caller#2") [ Bare "helper" ]
        == [ "helper", "app::links::helper" ]
        && namesFor Highlight.Ipe (unitNamed "fn" "run" "Feature.run") [ Bare "go", Path "Foo.bar" ]
        == [ "go", "Feature.go", "Foo.bar" ]
        && namesFor Highlight.Rust (unitNamed "file" "FILE" "app::links::FILE") [ Bare "helper" ]
        == [ "helper" ]
        && namesFor Highlight.Rust (unitNamed "fn" "other" "app::links::caller") [ Bare "helper" ]
        == [ "helper" ]
        && namesFor Highlight.Rust (unitNamed "fn" "f" "mycrate::m::f") [ Path "crate::util::g" ]
        == [ "mycrate::util::g" ]
        && namesFor Highlight.Ipe (unitNamed "fn" "f" "M.f") [ Path "crate.util.g" ]
        == [ "crate.util.g" ]
        && namesFor Highlight.Shell (unitNamed "fn" "f" "m::f") [ Bare "g", Path "crate::x" ]
        == [ "g", "crate::x" ]
        && namesFor Highlight.Unknown (unitNamed "fn" "f" "m::f") [ Bare "g" ]
        == [ "g" ]


-- A unit whose kind, name or qualified name is longer than the index read's
-- window builds no candidate and reads as capped, so no lookup is ever
-- spelled from a prefix of a name. The same unit with every column exactly at
-- the window builds its candidates. Red if a cut column reaches the rule.
cutNameBuildsNoCandidate : Bool
cutNameBuildsNoCandidate =
    let
        nameAt chars =
            String.repeat chars "c"

        atWindow =
            unitNamed "fn" (nameAt (Label.windowChars - 5)) ("app::" ++ nameAt (Label.windowChars - 5))

        refs =
            [ Bare "helper" ]

        refused unit =
            let
                got =
                    Links.candidates Highlight.Rust unit refs
            in
            List.isEmpty got.names && List.isEmpty got.lookups && got.reach == Capped

        shown =
            Links.candidates Highlight.Rust atWindow refs
    in
    shown.names
        == [ "helper", "app::helper" ]
        && shown.reach
        == Complete
        && refused (unitNamed "fn" (nameAt (Label.windowChars - 5)) ("app::" ++ nameAt (Label.windowChars - 4)))
        && refused (unitNamed "fn" (nameAt (Label.windowChars + 1)) ("app::" ++ nameAt (Label.windowChars - 5)))
        && refused (unitNamed (String.repeat (Label.windowChars + 1) "f") (nameAt (Label.windowChars - 5)) ("app::" ++ nameAt (Label.windowChars - 5)))


-- A Rust `.` is a field or method access, never a path: `a.b.c` names `a`
-- alone and `self.go` names nothing, so no lookup is spent on a name no Rust
-- unit can hold. A `..` range starts no member, so its end still names.
referencesFollowTokens : Bool
referencesFollowTokens =
    Links.references Highlight.Rust "a.b.c x::<T>::new() self.go ::std::io crate::m::f fn Foo::bar.baz a..b"
        == [ Bare "a", Bare "x", Bare "T", Path "crate::m::f", Path "Foo::bar", Bare "a", Bare "b" ]
        && Links.references Highlight.Ipe "Foo.bar(x) model.count"
        == [ Path "Foo.bar", Bare "x", Path "model.count" ]
        && List.isEmpty (Links.references Highlight.Shell "Foo.bar x")
        && List.isEmpty (Links.references Highlight.Unknown "Foo.bar x")


candidateSqlBound : Bool
candidateSqlBound =
    case Index.candidateQuery "ipe:p" (uid "u-self") [ "evil'); DROP TABLE units; --", "b" ] of
        ( sql, params ) ->
            not (String.contains "evil" sql)
                && String.contains "IN (?, ?)" sql
                && params
                == [ SqlString "ipe:p", SqlString "evil'); DROP TABLE units; --", SqlString "b", Uid.toSql (uid "u-self") ]
                && Index.placeholders 3
                == "?, ?, ?"
                && Index.placeholders 0
                == ""


-- One row of ipe-index's `tests/callee_vectors.json`: a caller unit's stored
-- identity, a callee as written, and the names ipe-index's callee rule looks
-- it up as.
type alias CalleeVector =
    { unit : Links.UnitName
    , callee : String
    , candidates : List String
    }


-- Every row's candidates, read through this page's own references and
-- candidate rule, are ipe-index's. Red if the vectors file is absent or empty,
-- or if the two rules drift.
calleeVectorsHold : Task.Task Error Bool
calleeVectorsHold =
    do
        cwd <- System.cwd ()
        path <- Task.fromResult (Path.fromString (ipeIndexTestFile cwd "callee_vectors.json"))
        text <- File.readFileLimit path (ByteSize.kib 16)
        vectors <- Task.fromResult (Decode.decodeString (Decode.list calleeVectorDecoder) text)
        Task.succeed (not (List.isEmpty vectors) && List.all calleeVectorHolds vectors)


calleeVectorHolds : CalleeVector -> Bool
calleeVectorHolds v =
    (Links.candidates Highlight.Rust v.unit (List.take 1 (Links.references Highlight.Rust v.callee))).names == v.candidates


calleeVectorDecoder : Decode.Decoder CalleeVector
calleeVectorDecoder =
    Decode.map3
        (\unit callee wanted -> { unit = unit, callee = callee, candidates = wanted })
        (Decode.map3
            unitNamed
            (Decode.field "kind" Decode.string)
            (Decode.field "name" Decode.string)
            (Decode.field "qualified" Decode.string)
        )
        (Decode.field "callee" Decode.string)
        (Decode.field "candidates" (Decode.list Decode.string))


checks : Task.Task Error (List ( String, Bool ))
checks =
    Task.map2 (\got callee -> ( got, callee )) linksFixture calleeVectorsHold
        |> Task.map
            (\( got, callee ) ->
                [ ( "a source with more distinct references than the candidate ceiling binds only the ceiling and sets hidden to AtLeast", candidateCeiling )
                , ( "candidates match the shared ipe-index callee vectors", callee )
                , ( "links past the link ceiling set hidden to Exactly the cut count", linkCeilingCut )
                , ( "first occurrence wins across candidates, resolved links and urls", firstOccurrence )
                , ( "candidates follow ipe-index's callee rule", candidateRule )
                , ( "a unit name past the index window builds no candidate", cutNameBuildsNoCandidate )
                , ( "references follow the shown tokens", referencesFollowTokens )
                , ( "candidate names are bound, never spliced into the SQL text", candidateSqlBound )
                ]
                    ++ fixtureChecks got
            )
