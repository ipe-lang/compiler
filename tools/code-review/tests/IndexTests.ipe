-- ── ipe-index bridge ───────────────────────────────────────────────────
--
-- Seeds a scratch ipe-index database (units + change_queue) plus two source
-- files, then loads the first queue page and checks the loaded
-- units' metadata and source slices.
indexBridge : Task.Task Error Bool
indexBridge =
    freshDir "ipe-index-b3-test" |> Task.andThen indexBridgeIn


indexBridgeIn : String -> Task.Task Error Bool
indexBridgeIn base =
    let
        repo =
            base ++ "/repo"

        indexDb =
            base ++ "/index.db"
    in
    Task.fromResult (Path.fromString indexDb)
        |> Task.andThen File.remove
        |> Task.onError (\_ -> Task.succeed ())
        |> Task.andThen (\_ -> seedIndex indexDb repo)
        |> Task.andThen (\_ -> loadFirstPage |> Task.map (\r -> checkUnits r.total r.units))
        |> Task.andThen (\ok -> cleanupIndex indexDb repo |> Task.map (\_ -> ok))


-- Seeds the bridge fixture at `name`, runs `mutate`, loads the first page and
-- returns the view tag of each queued unit as `uid=tag`.
viewTagsAfter : String -> (Scratch -> Task.Task Error ()) -> Task.Task Error (List String)
viewTagsAfter name mutate =
    do
        at <- freshScratch name
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        mutate at
        r <- loadFirstPage
        cleanupIndex at.indexDb at.repo
        Task.succeed (List.map (\u -> u.uid ++ "=" ++ viewTag u.view) r.units)


-- True for an `Unreadable` view tag whose rendered error contains `needle`.
unreadableNaming : String -> String -> Bool
unreadableNaming needle tag =
    String.startsWith "unreadable: " tag && String.contains needle tag


-- R1: one line inserted above the unit moves its bytes; the stored hash no
-- longer matches. Red if the hash comparison is removed (the view is shown).
driftedSourceNotShown : Task.Task Error Bool
driftedSourceNotShown =
    viewTagsAfter
        "ipe-index-attest-drift"
        (\at -> writeFileText (at.repo ++ "/src/Lib.rs") ("// inserted above\n" ++ fixtureLibRs))
        |> Task.map (\tags -> List.member "u-a=drifted" tags && List.member "u-b=shown" tags)


-- R2: a span one line past the 10-line file, stored with the hash of the
-- clamped slice so only the range check can refuse it. Red if the range check
-- is removed or clamping comes back.
rangePastFileIsStale : Task.Task Error Bool
rangePastFileIsStale =
    viewTagsAfter "ipe-index-attest-range"
        (\at ->
            execIndex at.indexDb
                "UPDATE units SET line_start = ?, line_end = ?, body_hash = ? WHERE uid = ?"
                [ SqlInt 9, SqlInt 11, SqlString (Index.attest "    7\n}"), SqlString "u-a" ]
        )
        |> Task.map (\tags -> List.member "u-a=range 10" tags)


-- R3: a stored value with no exact `sha256:` prefix is never re-proved, even
-- when it is the right digest. Red if the scheme parse is removed (each
-- value would read as drifted).
legacyHashUnverifiable : Task.Task Error Bool
legacyHashUnverifiable =
    [ Crypto.sha256 viewA
    , "SHA256:" ++ Crypto.sha256 viewA
    , "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"
    ]
        |> List.map
            (\stored ->
                viewTagsAfter
                    "ipe-index-attest-legacy"
                    (\at -> execIndex at.indexDb "UPDATE units SET body_hash = ? WHERE uid = ?" [ SqlString stored, SqlString "u-a" ])
                    |> Task.map (\tags -> List.member "u-a=unverifiable" tags)
            )
        |> Task.sequence
        |> Task.map (List.all identity)


-- R8: one queued unit's file is gone; that unit alone is unreadable, naming
-- its stored path, and the page still loads. Red if the per-unit error
-- capture is removed (the whole page fails).
oneMissingFileIsolated : Task.Task Error Bool
oneMissingFileIsolated =
    viewTagsAfter
        "ipe-index-attest-missing"
        (\at -> removeFileIfAny (at.repo ++ "/src/Main.ipe"))
        |> Task.map
            (\tags ->
                List.member "u-a=shown" tags
                    && List.any (\t -> String.startsWith "u-b=unreadable: " t && String.contains "ipe:src/Main.ipe" t) tags
            )


-- A queued unit whose source file is one byte past the 16 MiB read ceiling
-- is unreadable for that reason, rather than read whole; the page still
-- loads.
oversizedSourceRefused : Task.Task Error Bool
oversizedSourceRefused =
    freshDir "ipe-index-oversized-source" |> Task.andThen oversizedSourceRefusedIn


oversizedSourceRefusedIn : String -> Task.Task Error Bool
oversizedSourceRefusedIn base =
    let
        repo =
            base ++ "/repo"

        indexDb =
            base ++ "/index.db"
    in
    do
        removeFileIfAny indexDb
        seedIndex indexDb repo
        writeFileText (repo ++ "/src/Lib.rs") (String.repeat (16 * 1024 * 1024 + 1) "x")
        r <- loadFirstPage
        cleanupIndex indexDb repo
        Task.succeed (unreadableNaming "16777216-byte limit" (unitViewTag "u-a" r.units))


-- The unit page's data path: a uid that exists loads with its source and
-- qualified name, and links nothing its source does not name; a bogus uid
-- loads Nothing.
unitPageLoad : Task.Task Error Bool
unitPageLoad =
    freshDir "ipe-index-b9-unit" |> Task.andThen unitPageLoadIn


unitPageLoadIn : String -> Task.Task Error Bool
unitPageLoadIn base =
    let
        repo =
            base ++ "/repo"

        indexDb =
            base ++ "/index.db"
    in
    Task.fromResult (Path.fromString indexDb)
        |> Task.andThen File.remove
        |> Task.onError (\_ -> Task.succeed ())
        |> Task.andThen (\_ -> Task.fromResult (Path.fromString base) |> Task.andThen File.mkdirAll)
        |> Task.andThen (\_ -> Task.fromResult (Path.fromString (repo ++ "/src")) |> Task.andThen File.mkdirAll)
        |> Task.andThen (\_ -> writeFileText (repo ++ "/src/Lib.rs") fixtureLibRs)
        |> Task.andThen (\_ -> writeFileText (repo ++ "/src/Main.ipe") fixtureMainIpe)
        |> Task.andThen (\_ -> seedIndexDb indexDb)
        |> Task.andThen (\_ -> setIndexEnv indexDb repo)
        |> Task.andThen
            (\_ ->
                loadUnitNow "u-a"
                    |> Task.andThen
                        (\mb ->
                            case mb of
                                Just loaded ->
                                    Task.succeed
                                        (SafeText.toString loaded.unit.qualified
                                            == "Lib.answer"
                                            && shownTextOf loaded.view
                                            == Just viewA
                                            && List.isEmpty loaded.links.links
                                            && loaded.links.hidden
                                            == Links.NoneHidden
                                        )

                                Nothing ->
                                    Task.succeed False
                        )
            )
        |> Task.andThen
            (\ok ->
                if not ok then
                    Task.succeed False

                else
                    loadUnitNow "u-zz"
                        |> Task.map
                            (\mb ->
                                case mb of
                                    Nothing ->
                                        True

                                    Just _ ->
                                        False
                            )
            )
        |> Task.andThen
            (\ok ->
                Task.sequence
                    [ removeFileIfAny indexDb
                    , removeFileIfAny (indexDb ++ "-wal")
                    , removeFileIfAny (indexDb ++ "-shm")
                    , removeFileIfAny (repo ++ "/src/Lib.rs")
                    , removeFileIfAny (repo ++ "/src/Main.ipe")
                    ]
                    |> Task.map (\_ -> ok)
            )


-- ── shared view/hash vectors ──────────────────────────────────────────────
--
-- The Ipê view rule and attestation agree with ipe-index's on every row of
-- the shared vectors file, and a row ipe-index refuses is refused here too.
-- Red if the trailing-newline drop or the `\r` keep rule changes, or if a
-- range past the file is clamped instead of refused.
type alias HashVector =
    { name : String
    , src : String
    , startLine : Int
    , endLine : Int
    , view : Maybe String
    , hash : Maybe String
    }


viewHashVectors : Task.Task Error Bool
viewHashVectors =
    do
        cwd <- System.cwd ()
        path <- Task.fromResult (Path.fromString (vectorsPath cwd))
        text <- File.readFileLimit path (ByteSize.kib 64)
        vectors <- Task.fromResult (Decode.decodeString (Decode.list vectorDecoder) text)
        Task.succeed (List.length vectors >= 13 && List.all vectorHolds vectors)


vectorDecoder : Decode.Decoder HashVector
vectorDecoder =
    Decode.map3
        (\name src rest ->
            { name = name
            , src = src
            , startLine = rest.startLine
            , endLine = rest.endLine
            , view = rest.view
            , hash = rest.hash
            }
        )
        (Decode.field "name" Decode.string)
        (Decode.field "src" Decode.string)
        (Decode.map4
            (\startLine endLine view hash -> { startLine = startLine, endLine = endLine, view = view, hash = hash })
            (Decode.field "start" Decode.int)
            (Decode.field "end" Decode.int)
            (Decode.field "view" (Decode.nullable Decode.string))
            (Decode.field "hash" (Decode.nullable Decode.string))
        )


vectorHolds : HashVector -> Bool
vectorHolds v =
    case Index.viewText v.startLine v.endLine v.src of
        Ok text ->
            case ( v.view, v.hash ) of
                ( Just view, Just hash ) ->
                    text == view && Index.attest text == hash

                _ ->
                    False

        Err (RangeOutOfFile _) ->
            v.view == Nothing && v.hash == Nothing

        Err _ ->
            False


-- ── metadata-only queue page ───────────────────────────────────────────
--
-- A queue page carries no source (`Index.Unit` has no view to hold one):
-- with both queued units' files gone the page still loads both units, and a
-- unit's own view load is where its unreadable file is reported. Red if a
-- page load fails or drops a unit over a missing file.
pageReadsNoSource : Task.Task Error Bool
pageReadsNoSource =
    do
        at <- freshScratch "ipe-index-page-no-source"
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        removeFileIfAny (at.repo ++ "/src/Lib.rs")
        removeFileIfAny (at.repo ++ "/src/Main.ipe")
        conn <- indexConn
        rows <- pendingRows conn
        settings <- envSettings
        found <- Index.loadView conn settings.roots "u-b"
        cleanupIndex at.indexDb at.repo
        Task.succeed
            (List.map (\r -> r.unit.uid) rows
                == [ "u-a", "u-b" ]
                && String.startsWith "unreadable: " (loadedViewTag found)
            )


loadedViewTag : Maybe Index.UnitView -> String
loadedViewTag found =
    case found of
        Just loaded ->
            viewTag loaded.view

        Nothing ->
            "absent"


-- A unit's highlighting language is its file's language as ipe-index
-- indexed it in `files.lang`; a unit whose file has no `files` row is
-- `Unknown`. Red if the language is taken from anywhere but `files.lang`.
langFromFilesTable : Task.Task Error Bool
langFromFilesTable =
    do
        at <- freshScratch "ipe-index-files-lang"
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        execIndex at.indexDb "INSERT INTO files (path, lang) VALUES (?, ?)" [ SqlString "ipe:src/Lib.rs", SqlString "rs" ]
        conn <- indexConn
        rows <- pendingRows conn
        cleanupIndex at.indexDb at.repo
        Task.succeed (List.map (\r -> r.unit.uid ++ "=" ++ langName r.unit.lang) rows == [ "u-a=Rust", "u-b=Unknown" ])


-- An index with no `files` table stops startup naming `IPE_INDEX_DB`. Red if
-- the probe stops reading the language join a queue page reads.
probeRefusesIndexWithoutFiles : Task.Task Error Bool
probeRefusesIndexWithoutFiles =
    do
        at <- freshScratch "ipe-index-probe-files"
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        execIndex at.indexDb "DROP TABLE files" []
        message <- probeMessage (envSettings |> Task.andThen Index.probe)
        cleanupIndex at.indexDb at.repo
        Task.succeed (probeNames "IPE_INDEX_DB" at.indexDb message)


-- An index without the `open_units` view, or without the `reviewed_stamp`
-- table, stops startup naming `IPE_INDEX_DB`. Red if the probe stops
-- selecting either.
probeRefusesIndexWithoutView : Task.Task Error Bool
probeRefusesIndexWithoutView =
    do
        noView <- probeAfter "ipe-index-probe-view" "DROP VIEW open_units"
        noStamp <- probeAfter "ipe-index-probe-stamp" "DROP TABLE reviewed_stamp"
        Task.succeed (noView && noStamp)


-- The probe of a seeded index after `sql` ran on it: True when it refuses,
-- naming the variable and the file.
probeAfter : String -> String -> Task.Task Error Bool
probeAfter name sql =
    do
        at <- freshScratch name
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        execIndex at.indexDb sql []
        message <- probeMessage (envSettings |> Task.andThen Index.probe)
        cleanupIndex at.indexDb at.repo
        Task.succeed (probeNames "IPE_INDEX_DB" at.indexDb message)


-- A unit with no change_queue row for its current body is still open: it
-- is listed and counted, its change `Unrecorded`. Membership is the current
-- pair against the decided set, never the event log. Red while the page
-- reads `change_queue` as its membership.
unrecordedUnitListed : Task.Task Error Bool
unrecordedUnitListed =
    do
        at <- freshScratch "ipe-index-unrecorded"
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        execIndex at.indexDb "DELETE FROM change_queue WHERE uid = ?" [ SqlString "u-a" ]
        r <- loadFirstPage
        cleanupIndex at.indexDb at.repo
        Task.succeed
            (r.total
                == 2
                && List.map (\e -> e.uid) r.units
                == [ "u-a", "u-b" ]
                && List.all (\e -> e.uid /= "u-a" || isUnrecorded e.change) r.units
                && List.all (\e -> e.uid /= "u-b" || modifiedFrom e.change == Just "oldB") r.units
            )


-- A `modified` row that does not say which hash it replaced fails the page
-- read rather than show a change with no old side. Red if the decoder fills
-- in a missing `old_hash`.
changeDecodeRefusesModifiedWithoutOld : Task.Task Error Bool
changeDecodeRefusesModifiedWithoutOld =
    pageReadFailsAfter "ipe-index-modified-no-old" "UPDATE change_queue SET old_hash = NULL WHERE uid = 'u-b'"


-- An index whose view reports a change kind this reviewer does not know, or
-- an old hash with no change, fails the page read rather than show the unit
-- as some other change. The view is replaced, as a foreign or tampered index
-- could, since the shipped view lists only `new` and `modified`. Red if the
-- decoder has a catch-all arm.
changeDecodeRefusesUnknown : Task.Task Error Bool
changeDecodeRefusesUnknown =
    do
        unknown <- pageReadFailsAfter "ipe-index-change-unknown" (foreignView "'renamed'" "NULL")
        orphanOld <- pageReadFailsAfter "ipe-index-change-orphan-old" (foreignView "NULL" "'h-old'")
        Task.succeed (unknown && orphanOld)


-- A replacement `open_units` view listing every unit with a fixed change and
-- old hash.
foreignView : String -> String -> String
foreignView change oldHash =
    String.concat
        [ "DROP VIEW open_units; CREATE VIEW open_units AS SELECT u.uid, u.path, u.kind, u.name, u.qualified, u.line_start, u.line_end, u.facing, u.purpose, u.body_hash, u.updated_sha, f.lang, "
        , change
        , " AS change, "
        , oldHash
        , " AS old_hash, 0 AS enqueued_at FROM units u LEFT JOIN files f ON f.path = u.path"
        ]


-- True when the first page read fails on a seeded index after `sql` ran.
pageReadFailsAfter : String -> String -> Task.Task Error Bool
pageReadFailsAfter name sql =
    do
        at <- freshScratch name
        removeFileIfAny at.indexDb
        seedIndex at.indexDb at.repo
        execIndexScript at.indexDb sql
        conn <- indexConn
        failed <- pendingRows conn
            |> Task.map (\_ -> False)
            |> Task.onError (\_ -> Task.succeed True)
        cleanupIndex at.indexDb at.repo
        Task.succeed failed


-- Each `;`-separated statement of `sql` run in order on the index.
execIndexScript : String -> String -> Task.Task Error ()
execIndexScript indexDb sql =
    String.split "; " sql
        |> List.map (\stmt -> execIndex indexDb stmt [])
        |> Task.sequence
        |> Task.map (\_ -> ())


-- The first page's rows on `conn`, read through `Index.readSnapshot`, the
-- one reader of a page `Lib.Index` exposes.
pendingRows : Db -> Task.Task Error (List Index.PendingRow)
pendingRows conn =
    Index.readSnapshot conn Index.Start |> Task.map (\snap -> snap.rows)


-- ── one reader of a page ───────────────────────────────────────────────
--
-- A page's rows, its open and unit counts and the index size are read only
-- through `Index.readSnapshot`, in one transaction. `Lib.Index` exposes
-- exactly `indexExposes`, name for name, and no reader in `snapshotReaders`
-- is among them, so a reader of one of them alone, or a wrapper around one
-- under a new name, cannot be exposed without turning this red.
indexExposesOnlySnapshotReader : Task.Task Error Bool
indexExposesOnlySnapshotReader =
    do
        cwd <- System.cwd ()
        path <- Task.fromResult (Path.fromString (cwd ++ "/src/Lib/Index.ipe"))
        source <- File.readFileLimit path (ByteSize.kib 64)
        Task.succeed
            (exposesAdmitted source
                && List.all (\reader -> not (List.member reader indexExposes)) snapshotReaders
                && List.member "readSnapshot" indexExposes
            )


-- The scan refuses each way around it: one of the four readers re-exposed,
-- a wrapper exposed under a new name, an `exposing (..)` header, and a
-- reader on a continuation line of a multi-line header. The same header
-- written over several lines without a reader is admitted, so the
-- multi-line refusal is the reader's. Red while the scan reads only the
-- header's first line or matches a fixed spelling.
indexExposingScanRefusesEvasions : Task.Task Error Bool
indexExposingScanRefusesEvasions =
    let
        multiLine names =
            "module Lib.Index exposing\n    ( " ++ String.join "\n    , " names ++ "\n    )\n\nimport Ipe.Db\n"
    in
    do
        cwd <- System.cwd ()
        path <- Task.fromResult (Path.fromString (cwd ++ "/src/Lib/Index.ipe"))
        source <- File.readFileLimit path (ByteSize.kib 64)
        Task.succeed
            (exposesAdmitted source
                && List.all (\reader -> not (exposesAdmitted (String.replace "readSnapshot," ("readSnapshot, " ++ reader ++ ",") source))) snapshotReaders
                && not (exposesAdmitted (String.replace "readSnapshot," "readSnapshot, pendingPage," source))
                && not (exposesAdmitted "module Lib.Index exposing (..)\n\nimport Ipe.Db\n")
                && exposesAdmitted (multiLine indexExposes)
                && not (exposesAdmitted (multiLine (indexExposes ++ [ "dbBytes" ])))
            )


-- Every name `Lib.Index` exposes, a type's constructors written bare.
indexExposes : List String
indexExposes =
    [ "Attested", "AttestedHash", "ChainHead", "Change", "Cursor", "DecidedPair", "PendingRow", "ShownSource", "Snapshot", "SourceView", "StaleReason", "Unit", "UnitView", "Written", "attest", "attestedHash", "attestedUid", "candidateQuery", "chainHeadDecoder", "chainHeadText", "chainLink", "decidedPairDecoder", "decidedPairKey", "drainDecided", "drainUnit", "loadView", "nameFor", "pageSize", "placeholders", "probe", "readConnection", "readSnapshot", "readStamp", "rebuildReviewed", "reverify", "shortHash", "shownHash", "shownText", "storedHash", "viewText" ]


-- The readers `Index.readSnapshot` runs in its transaction.
snapshotReaders : List String
snapshotReaders =
    [ "loadPendingPage", "countPending", "countUnits", "dbBytes" ]


-- True when the module header of `source` exposes exactly `indexExposes`.
exposesAdmitted : String -> Bool
exposesAdmitted source =
    case exposedNames source of
        Just names ->
            List.all (\name -> List.member name indexExposes) names
                && List.all (\name -> List.member name names) indexExposes

        Nothing ->
            False


-- The names a module header exposes, each constructor list `(..)` dropped.
-- The header is the source up to its first blank line, its lines joined, so
-- a list written over several lines is read whole. Nothing when the source
-- does not open with an `exposing (` header.
exposedNames : String -> Maybe (List String)
exposedNames source =
    let
        header =
            String.join " " (List.map String.trim (String.lines (Maybe.withDefault "" (List.head (String.split "\n\n" source)))))
    in
    case String.split " exposing ( " (String.replace "exposing (" "exposing ( " header) of
        [ start, list ] ->
            if String.startsWith "module " start then
                Just (List.map String.trim (String.split "," (String.replace ")" "" (String.replace "(..)" "" list))))

            else
                Nothing

        _ ->
            Nothing


checks : Task.Task Error (List ( String, Bool ))
checks =
    Task.sequence
        [ check "index bridge loads queued units" indexBridge
        , check "a drifted unit's source is withheld" driftedSourceNotShown
        , check "a span past the file is refused, not clamped" rangePastFileIsStale
        , check "an unprefixed or foreign-scheme hash is unverifiable" legacyHashUnverifiable
        , check "one missing file fails only its unit" oneMissingFileIsolated
        , check "source file past the read ceiling refused" oversizedSourceRefused
        , check "view and attestation match the shared ipe-index vectors" viewHashVectors
        , check "unit page loads by uid, names resolve" unitPageLoad
        , check "a queue page reads no source file; only a unit's view load does" pageReadsNoSource
        , check "a unit's language comes from its file's indexed language" langFromFilesTable
        , check "an index without a files table fails the probe" probeRefusesIndexWithoutFiles
        , check "an index without the open_units view or the stamp fails the probe" probeRefusesIndexWithoutView
        , check "a unit with no change row is still listed" unrecordedUnitListed
        , check "a modified row without its old hash fails the page" changeDecodeRefusesModifiedWithoutOld
        , check "an unknown change kind fails the page" changeDecodeRefusesUnknown
        , check "the page snapshot is the only reader of a page, its counts and size Lib.Index exposes" indexExposesOnlySnapshotReader
        , check "the exposing scan refuses a re-exposed reader, a wrapper, an open list and a multi-line header" indexExposingScanRefusesEvasions
        ]
