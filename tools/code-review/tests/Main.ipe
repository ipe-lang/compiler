import LinksTests
import QueueTests
import RepoPathTests
import SafeTextTests
import SettingsTests
import ViewTests


-- Every test module must contribute at least one check: an empty list from
-- any module is a wiring bug (a split file never wired into the aggregator,
-- or a `checks` that silently returns nothing), not a passing run.
contributesChecks : String -> List ( String, Bool ) -> Task.Task Error (List ( String, Bool ))
contributesChecks moduleName results =
    if List.isEmpty results then
        Task.fail (Error.unexpected (moduleName ++ " contributed no checks"))

    else
        Task.succeed results


gatherChecks : Task.Task Error (List ( String, Bool ))
gatherChecks =
    Task.sequence
        [ HarnessTests.checks |> Task.andThen (contributesChecks "HarnessTests")
        , DbTests.checks |> Task.andThen (contributesChecks "DbTests")
        , ViewTests.checks |> Task.andThen (contributesChecks "ViewTests")
        , IndexTests.checks |> Task.andThen (contributesChecks "IndexTests")
        , QueueTests.checks |> Task.andThen (contributesChecks "QueueTests")
        , LinksTests.checks |> Task.andThen (contributesChecks "LinksTests")
        , SafeTextTests.checks |> Task.andThen (contributesChecks "SafeTextTests")
        , RepoPathTests.checks |> Task.andThen (contributesChecks "RepoPathTests")
        , SettingsTests.checks |> Task.andThen (contributesChecks "SettingsTests")
        ]
        |> Task.map List.concat


report : List ( String, Bool ) -> String
report results =
    List.map
        (\( name, ok ) ->
            (if ok then
                "PASS"

            else
                "FAIL"
            )
                ++ " "
                ++ name
        )
        results
        |> String.join "\n"


finish : List ( String, Bool ) -> Task.Task Error ()
finish results =
    Io.println (report results)
        |> Task.andThen
            (\_ ->
                if List.all (\( _, ok ) -> ok) results then
                    Task.succeed ()

                else
                    System.exit 1
            )


-- Every check opens the stores it reads under a directory of its own
-- (`TestSupport.freshDir`), so the run shares no database between checks.
main : Task.Task Error ()
main =
    gatherChecks
        |> Task.andThen finish
