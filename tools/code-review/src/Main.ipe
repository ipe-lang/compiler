module Main exposing (main)

import Ipe.Error as Error exposing (Error)
import Ipe.Html as Html
import Ipe.Html.Attributes as Attr
import Ipe.Io as Io
import Ipe.List as List
import Ipe.Result as Result exposing (Result)
import Ipe.Server.Http as Server
import Ipe.String as String
import Ipe.System as System
import Ipe.Task as Task
import Ipe.Tea.Web as Web
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import Ipe.Time.Timestamp exposing (Timestamp)
import Ipe.Ui as Ui
import Ipe.Ui.Background as Background
import Ipe.Ui.Border as Border
import Ipe.Ui.Font as Font
import Ipe.Ui.Input as Input
import Lib.Db as LibDb exposing (Decision(..), HistoryCursor(..))
import Lib.Format as Format
import Lib.Highlight as Highlight exposing (Token(..))
import Lib.Index as Index exposing (SourceView(..), StaleReason(..))
import Lib.Keys as Keys exposing (KeyAction(..))
import Lib.Links as Links exposing (Link(..))
import Lib.Queue as Queue exposing (HistoryState(..), QueueState(..), SelectedView(..), UnitPageState(..))
import Lib.SafeText as SafeText exposing (SafeText)
import Lib.Settings as Settings


type Page
    = QueuePage
    | HistoryPage
    | UnitPage String


-- `queueCursor` is where the shown queue page starts; a reload after a
-- decision re-reads that page only. The Model is plain data persisted to the
-- session store; the startup settings are not part of it and reach every
-- handler as its first argument.
type alias Model =
    { page : Page
    , queueState : Queue.QueueState
    , queueCursor : Index.Cursor
    , refusingUid : Maybe String
    , refuseDraft : String
    , refuseError : Maybe Error
    , decisionError : Maybe Error
    , queueLoad : Queue.LoadTicket
    , history : Queue.HistoryState
    , historyLoad : Queue.LoadTicket
    , unitPage : Queue.UnitPageState
    , unitLoad : Queue.LoadTicket
    , selected : Int
    , selectedView : Queue.SelectedView
    }


-- The session's first model. It loads nothing: the route entry that follows
-- `init` on every new session (`onNavigate`) loads the page's data, so the
-- route table is the one place a URL maps to a page.
init : Web.WebReq -> ( Model, Cmd Msg )
init _req =
    ( { page = QueuePage
      , queueState = Loading
      , queueCursor = Index.Start
      , refusingUid = Nothing
      , refuseDraft = ""
      , refuseError = Nothing
      , decisionError = Nothing
      , queueLoad = Queue.firstTicket
      , history = HistoryLoading
      , historyLoad = Queue.firstTicket
      , unitPage = UnitLoading
      , unitLoad = Queue.firstTicket
      , selected = 0
      , selectedView = NoneSelected
      }
    , Cmd.none
    )


-- A page entered, with the Cmd that loads its data: the one entry path, run
-- on every URL entry (first request, reload, link, back and forward,
-- reconnect) through `onNavigate`, and by the header buttons. The queue page
-- reloads the queue; any other page loads the queue too while it is not
-- loaded, since the header shows its progress on every page.
enterPage : Settings.AppSettings -> Page -> Model -> ( Model, Cmd Msg )
enterPage settings page model =
    let
        entered =
            { model | page = page }
    in
    case page of
        QueuePage ->
            loadQueue settings entered.queueCursor entered

        HistoryPage ->
            withQueue settings (loadHistory settings HistoryStart entered)

        UnitPage uid ->
            withQueue settings (loadUnit settings uid entered)


-- The queue page from `cursor`, under the queue's next load ticket; the shown
-- page stays until the result settles it.
loadQueue : Settings.AppSettings -> Index.Cursor -> Model -> ( Model, Cmd Msg )
loadQueue settings cursor model =
    let
        load =
            Queue.nextTicket model.queueLoad
    in
    ( { model | queueCursor = cursor, queueLoad = load }
    , Cmd.perform (Queue.loadPage settings cursor) (PendingLoaded load)
    )


-- An entry, plus a queue load while the queue is not loaded.
withQueue : Settings.AppSettings -> ( Model, Cmd Msg ) -> ( Model, Cmd Msg )
withQueue settings ( model, cmd ) =
    case model.queueState of
        Loaded _ ->
            ( model, cmd )

        Loading ->
            alsoQueue settings cmd model

        Failed _ ->
            alsoQueue settings cmd model


alsoQueue : Settings.AppSettings -> Cmd Msg -> Model -> ( Model, Cmd Msg )
alsoQueue settings cmd model =
    let
        ( queued, queueCmd ) =
            loadQueue settings model.queueCursor model
    in
    ( queued, Cmd.batch [ cmd, queueCmd ] )


-- One History page loaded from `cursor`, under the History slot's next load
-- ticket.
loadHistory : Settings.AppSettings -> LibDb.HistoryCursor -> Model -> ( Model, Cmd Msg )
loadHistory settings cursor model =
    let
        load =
            Queue.nextTicket model.historyLoad
    in
    ( { model | history = HistoryLoading, historyLoad = load }
    , Cmd.perform (Queue.loadHistoryPage settings cursor) (HistoryPageLoaded load)
    )


-- One unit page loaded, under the unit slot's next load ticket.
loadUnit : Settings.AppSettings -> String -> Model -> ( Model, Cmd Msg )
loadUnit settings uid model =
    let
        load =
            Queue.nextTicket model.unitLoad
    in
    ( { model | unitPage = UnitLoading, unitLoad = load }
    , Cmd.perform (Queue.loadUnitView settings.index uid) (UnitViewLoaded load)
    )


type Msg
    = PendingLoaded Queue.LoadTicket (Result Error Queue.QueuePage)
    | NextPage Index.Cursor
    | ApproveUnit String
    | RefuseStart String
    | RefuseDraft String
    | RefuseCancel
    | RefuseSubmit String
    | DecisionSaved String (Result Error ( Index.Attested, Int ))
    | Navigated Page
    | ShowQueue
    | ShowHistory
    | HistoryPageLoaded Queue.LoadTicket (Result Error Queue.HistoryPage)
    | HistoryNext LibDb.HistoryCursor
    | UnitViewLoaded Queue.LoadTicket (Result Error (Maybe Index.UnitView))
    | SelectedViewLoaded String (Result Error (Maybe Index.UnitView))
    | KeyDown String
    | SelectUnit Int


update : Settings.AppSettings -> Msg -> Model -> ( Model, Cmd Msg )
update settings msg model =
    case msg of
        PendingLoaded load result ->
            if Queue.isCurrentLoad load model.queueLoad then
                let
                    loaded =
                        { model | queueState = Queue.stateFromResult result, refusingUid = Nothing }
                in
                viewAfterLoad settings { loaded | selected = clampIndex model.selected (List.length (queueList loaded)) }

            else
                ( model, Cmd.none )

        NextPage cursor ->
            loadQueue settings cursor { model | queueState = Loading, selected = 0 }

        ApproveUnit uid ->
            ( model, saveDecision settings model uid Approved )

        RefuseStart uid ->
            ( { model | refusingUid = Just uid, refuseDraft = "", refuseError = Nothing }, Cmd.none )

        RefuseDraft text ->
            ( { model | refuseDraft = text, refuseError = Nothing }, Cmd.none )

        RefuseCancel ->
            ( { model | refusingUid = Nothing, refuseDraft = "", refuseError = Nothing }, Cmd.none )

        RefuseSubmit uid ->
            submitRefuse settings model uid

        DecisionSaved uid result ->
            case result of
                Ok ( attested, _ ) ->
                    let
                        load =
                            Queue.nextTicket model.queueLoad
                    in
                    ( { model | decisionError = Nothing, queueLoad = load }, drainAndReload settings model attested load )

                Err e ->
                    ( { model | decisionError = Just e }, Cmd.none )

        Navigated page ->
            enterPage settings page model

        ShowQueue ->
            enterPage settings QueuePage model

        ShowHistory ->
            enterPage settings HistoryPage model

        HistoryPageLoaded load result ->
            if Queue.isCurrentLoad load model.historyLoad then
                ( { model | history = Queue.historyStateFromResult result }, Cmd.none )

            else
                ( model, Cmd.none )

        HistoryNext cursor ->
            loadHistory settings cursor model

        UnitViewLoaded load result ->
            if Queue.isCurrentLoad load model.unitLoad then
                ( { model | unitPage = Queue.unitPageFromResult result }, Cmd.none )

            else
                ( model, Cmd.none )

        SelectedViewLoaded uid result ->
            viewStep settings (Queue.viewArrived uid result model.selectedView) model

        KeyDown key ->
            keyActionMsg settings (Keys.keyAction (model.refusingUid /= Nothing) (List.length (queueList model)) model.selected key) model

        SelectUnit i ->
            selectAt settings i model


-- The selected card's view after a queue load: on the queue page the
-- selected unit is read afresh, since the load may follow a decision or a
-- reindex; anywhere else no card is shown, so no source is read.
viewAfterLoad : Settings.AppSettings -> Model -> ( Model, Cmd Msg )
viewAfterLoad settings model =
    case ( model.page, selectedUid model ) of
        ( QueuePage, Just uid ) ->
            viewStep settings (Queue.reloadView uid model.selectedView) model

        ( QueuePage, Nothing ) ->
            ( { model | selectedView = Queue.clearView model.selectedView }, Cmd.none )

        ( HistoryPage, _ ) ->
            ( { model | selectedView = Queue.clearView model.selectedView }, Cmd.none )

        ( UnitPage _, _ ) ->
            ( { model | selectedView = Queue.clearView model.selectedView }, Cmd.none )


-- The queue card at `i` selected, reading its view when it is not shown.
selectAt : Settings.AppSettings -> Int -> Model -> ( Model, Cmd Msg )
selectAt settings i model =
    let
        moved =
            { model | selected = clampIndex i (List.length (queueList model)) }
    in
    case selectedUid moved of
        Just uid ->
            viewStep settings (Queue.selectView uid moved.selectedView) moved

        Nothing ->
            ( moved, Cmd.none )


-- A selected-view transition, with the one read it starts, if any.
viewStep : Settings.AppSettings -> ( Queue.SelectedView, Maybe String ) -> Model -> ( Model, Cmd Msg )
viewStep settings ( state, next ) model =
    ( { model | selectedView = state }, loadViewCmd settings.index next )


loadViewCmd : Settings.IndexSettings -> Maybe String -> Cmd Msg
loadViewCmd settings next =
    case next of
        Just uid ->
            Cmd.perform (Queue.loadUnitView settings uid) (SelectedViewLoaded uid)

        Nothing ->
            Cmd.none


-- Every KeyAction dispatches the same Msg the matching button sends —
-- the buttons remain the single source of truth; the keys are a mirror.
keyActionMsg : Settings.AppSettings -> KeyAction -> Model -> ( Model, Cmd Msg )
keyActionMsg settings action model =
    case action of
        ApproveSelected ->
            case selectedUid model of
                Just uid ->
                    ( model, saveDecision settings model uid Approved )

                Nothing ->
                    ( model, Cmd.none )

        RefuseSelected ->
            case selectedUid model of
                Just uid ->
                    ( { model | refusingUid = Just uid, refuseDraft = "", refuseError = Nothing }, Cmd.none )

                Nothing ->
                    ( model, Cmd.none )

        Select i ->
            selectAt settings i model

        ConfirmRefuse ->
            case model.refusingUid of
                Just uid ->
                    submitRefuse settings model uid

                Nothing ->
                    ( model, Cmd.none )

        CancelRefuse ->
            ( { model | refusingUid = Nothing, refuseDraft = "", refuseError = Nothing }, Cmd.none )

        Ignore ->
            ( model, Cmd.none )


-- The draft is parsed into a bounded `Reason` here, the one point where the
-- reviewer's text enters; a blank or over-long draft stays open with why.
submitRefuse : Settings.AppSettings -> Model -> String -> ( Model, Cmd Msg )
submitRefuse settings model uid =
    case LibDb.parseReason model.refuseDraft of
        Err e ->
            ( { model | refuseError = Just e }, Cmd.none )

        Ok reason ->
            ( { model | refusingUid = Nothing, refuseDraft = "" }, saveDecision settings model uid (Refused reason) )


-- The shown page's units, for selection and decisions; a queue that is not
-- loaded has none to act on. What the view renders comes from
-- `Queue.queueStatusText`, so this list never stands for "empty".
queueList : Model -> List Queue.QueuedUnit
queueList model =
    case model.queueState of
        Loaded page ->
            page.units

        Loading ->
            []

        Failed _ ->
            []


selectedUid : Model -> Maybe String
selectedUid model =
    case List.head (List.drop model.selected (queueList model)) of
        Just q ->
            Just q.unit.uid

        Nothing ->
            Nothing


clampIndex : Int -> Int -> Int
clampIndex i len =
    max 0 (min i (len - 1))


-- Every decision, from a button or a key, goes through `Queue.decide` on the
-- selected unit's shown source, which it re-proves before writing.
saveDecision : Settings.AppSettings -> Model -> String -> LibDb.Decision -> Cmd Msg
saveDecision settings model uid decision =
    Cmd.perform (decisionTask settings model uid decision) (DecisionSaved uid)


decisionTask : Settings.AppSettings -> Model -> String -> LibDb.Decision -> Task.Task Error ( Index.Attested, Int )
decisionTask settings model uid decision =
    case List.find (\q -> q.unit.uid == uid) (queueList model) of
        Just _ ->
            case Queue.decidableSource uid model.selectedView of
                Just shown ->
                    decideOn settings shown decision

                Nothing ->
                    Task.fail (Error.conflict "this unit's source is not shown, so it cannot be decided")

        Nothing ->
            Task.fail (Error.conflict "unit is no longer in the queue")


decideOn : Settings.AppSettings -> Index.ShownSource -> LibDb.Decision -> Task.Task Error ( Index.Attested, Int )
decideOn settings shown decision =
    LibDb.openAt settings.review |> Task.andThen (\db -> Queue.decide settings.index db shown decision)


-- The drain loop: the decision is already saved (DecisionSaved Ok), so the
-- consumed queue entry leaves the index queue under the attested hash the
-- decision was written with. A failure anywhere fails closed with the queue
-- unchanged — the unit stays visible with its badge and the next click
-- retries.
drainAndReload : Settings.AppSettings -> Model -> Index.Attested -> Queue.LoadTicket -> Cmd Msg
drainAndReload settings model attested load =
    Cmd.perform (Queue.drainThenLoad settings attested model.queueCursor) (PendingLoaded load)


header : Model -> Ui.Element Msg
header model =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingEach { top = 12, right = 16, bottom = 12, left = 16 }
        , Ui.spacing 16
        , Ui.centerY
        , Background.color (Ui.rgb 24 24 32)
        , Border.solid
        , Border.color (Ui.rgb 60 60 72)
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        ]
        [ Ui.el [ Font.size 16, Font.bold, Font.color (Ui.rgb 235 235 240) ] (Ui.text "Code review")
        , Ui.el [ Ui.width Ui.fill ] Ui.none
        , navButton (model.page == QueuePage) "Queue" ShowQueue
        , navButton (model.page == HistoryPage) "History" ShowHistory
        , progressEl model
        ]


navButton : Bool -> String -> Msg -> Ui.Element Msg
navButton active label msg =
    Ui.button
        [ Ui.paddingXY 10 5
        , Border.rounded 4
        , Font.size 12
        , Font.bold
        , if active then
            Background.color (Ui.rgb 55 55 70)

        else
            Background.color (Ui.rgb 24 24 32)
        , Font.color (Ui.rgb 200 200 210)
        ]
        { onPress = Just msg, label = Ui.text label }


-- Progress comes from the loaded page, which reads it from the databases; a
-- queue still loading or failed shows none.
progressEl : Model -> Ui.Element Msg
progressEl model =
    case model.queueState of
        Loaded page ->
            progressOf page.progress

        Loading ->
            Ui.none

        Failed _ ->
            Ui.none


progressOf : Queue.Progress -> Ui.Element Msg
progressOf progress =
    let
        k =
            progress.reviewed

        n =
            progress.total
    in
    Ui.column
        [ Ui.width (Ui.px 220), Ui.spacing 4 ]
        [ Ui.el
            [ Font.size 12, Font.color (Ui.rgb 160 160 175) ]
            (Ui.text (String.fromInt k ++ " of " ++ String.fromInt n ++ " reviewed (" ++ Format.percent k n ++ ")"))
        , progressBar k n
        ]


progressBar : Int -> Int -> Ui.Element Msg
progressBar k n =
    if n == 0 then
        Ui.el
            [ Ui.width (Ui.px 220), Ui.height (Ui.px 6), Border.rounded 3, Background.color (Ui.rgb 45 45 58) ]
            Ui.none

    else
        Ui.row
            [ Ui.width (Ui.px 220), Ui.height (Ui.px 6), Border.rounded 3, Background.color (Ui.rgb 45 45 58) ]
            [ Ui.el
                [ Ui.width (Ui.fillPortion k), Ui.height Ui.fill, Border.rounded 3, Background.color (Ui.rgb 102 187 106) ]
                Ui.none
            , Ui.el
                [ Ui.width (Ui.fillPortion (n - k)), Ui.height Ui.fill ]
                Ui.none
            ]


view : Model -> Ui.Element Msg
view model =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.height Ui.fill
        , Background.color (Ui.rgb 16 16 22)
        , Ui.onKeyDown KeyDown
        , Ui.htmlAttribute "tabindex" "0"
        ]
        [ header model
        , Ui.el
            [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.padding 24, Font.color (Ui.rgb 190 190 200) ]
            (pageBody model)
        , urlSync model
        ]


pageBody : Model -> Ui.Element Msg
pageBody model =
    case model.page of
        QueuePage ->
            queueBody model

        HistoryPage ->
            historyBody model

        UnitPage _ ->
            unitPageBody model


queueBody : Model -> Ui.Element Msg
queueBody model =
    Ui.column
        [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 12 ]
        [ decisionErrorBanner model
        , queueStateBody model
        ]


decisionErrorBanner : Model -> Ui.Element Msg
decisionErrorBanner model =
    case model.decisionError of
        Just err ->
            Ui.el [ Font.size 13, Font.color (Ui.rgb 230 120 120) ] (Ui.text ("Decision save failed: " ++ SafeText.toString (SafeText.renderForeign (Error.toString err))))

        Nothing ->
            Ui.none


-- Every state's text comes from `Queue.queueStatusText`, the function the
-- tests pin; a loaded page adds its header and the next-page control.
queueStateBody : Model -> Ui.Element Msg
queueStateBody model =
    case model.queueState of
        Loaded page ->
            Ui.column
                [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 12 ]
                [ Ui.row
                    [ Ui.width Ui.fill, Ui.spacing 16, Ui.centerY ]
                    [ Ui.el [ Font.size 12, Font.color (Ui.rgb 160 160 175) ] (Ui.text (Queue.pageHeaderText page))
                    , nextPageButton page.next
                    ]
                , queueUnits model
                ]

        Loading ->
            queueUnits model

        Failed _ ->
            queueUnits model


nextPageButton : Maybe Index.Cursor -> Ui.Element Msg
nextPageButton next =
    case next of
        Just cursor ->
            navButton False "Next page" (NextPage cursor)

        Nothing ->
            Ui.none


queueUnits : Model -> Ui.Element Msg
queueUnits model =
    case Queue.queueStatusText model.queueState of
        Just text ->
            Ui.text text

        Nothing ->
            Ui.row
                [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 16 ]
                [ queueRail model
                , Ui.column
                    [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 16, Ui.scrollbars ]
                    [ hintLine
                    , case selectedUnit model of
                        Just q ->
                            unitCard model True q

                        Nothing ->
                            Ui.none
                    ]
                ]


-- The left rail is the keyboard-first overview — one button per queued
-- unit, the selected one highlighted; j/k, g and 1-5 move the selection.
queueRail : Model -> Ui.Element Msg
queueRail model =
    Ui.column
        [ Ui.width (Ui.px 280)
        , Ui.height Ui.fill
        , Ui.spacing 4
        , Ui.scrollbars
        ]
        (List.indexedMap (railItem model) (queueList model))


railItem : Model -> Int -> Queue.QueuedUnit -> Ui.Element Msg
railItem model i q =
    let
        selected =
            i == model.selected
    in
    Ui.button
        [ Ui.width Ui.fill
        , Ui.paddingXY 10 7
        , Border.rounded 4
        , Border.solid
        , Border.width 1
        , if selected then
            Border.color (Ui.rgb 130 170 240)

        else
            Border.color (Ui.rgb 40 40 52)
        , if selected then
            Background.color (Ui.rgb 34 34 46)

        else
            Background.color (Ui.rgb 24 24 32)
        ]
        { onPress = Just (SelectUnit i)
        , label = Ui.row
            [ Ui.width Ui.fill, Ui.spacing 6, Ui.centerY ]
            [ Ui.el
                [ Font.size 12, Font.bold, Font.color (Ui.rgb 220 220 230) ]
                (safeText q.unit.qualified)
            , changeBadge q.queued.change
            ]
        }


selectedUnit : Model -> Maybe Queue.QueuedUnit
selectedUnit model =
    List.head (List.drop model.selected (queueList model))


hintLine : Ui.Element Msg
hintLine =
    Ui.el
        [ Font.size 11, Font.color (Ui.rgb 140 140 155) ]
        (Ui.text "a approve · r refuse · j/k move · g top · 1-5 jump · Enter confirm")


-- Every state's text comes from `Queue.historyStatusText`, the function the
-- tests pin; a loaded page with rows adds its cards and the next-page control.
historyBody : Model -> Ui.Element Msg
historyBody model =
    case Queue.historyStatusText model.history of
        Just text ->
            Ui.text text

        Nothing ->
            case model.history of
                HistoryLoaded page ->
                    Ui.column
                        [ Ui.width Ui.fill, Ui.spacing 16, Ui.scrollbars ]
                        (List.map historyCard page.rows ++ [ historyNextButton page.next ])

                HistoryLoading ->
                    Ui.none

                HistoryFailed _ ->
                    Ui.none


historyNextButton : Maybe LibDb.HistoryCursor -> Ui.Element Msg
historyNextButton next =
    case next of
        Just cursor ->
            navButton False "Next page" (HistoryNext cursor)

        Nothing ->
            Ui.none


historyCard : Queue.HistoryRow -> Ui.Element Msg
historyCard row =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 16
        , Ui.spacing 10
        , Background.color (Ui.rgb 24 24 32)
        , Border.rounded 8
        , Border.solid
        , Border.width 1
        , Border.color (Ui.rgb 50 50 62)
        ]
        [ Ui.row
            [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
            [ decisionBadge row.decision
            , Ui.el [ Font.size 14, Font.bold, Font.color (Ui.rgb 235 235 240) ] (safeText (nameOf row))
            , Ui.el
                [ Font.size 12, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ]
                (safeText (Index.shortHash row.bodyHash))
            , Ui.el [ Ui.width Ui.fill ] Ui.none
            , Ui.el
                [ Font.size 12, Font.color (Ui.rgb 150 150 165) ]
                (Ui.text (Format.formatReviewedAt row.reviewedAt))
            ]
        , case row.reason of
            Just r ->
                Ui.el [ Font.size 12, Font.color (Ui.rgb 200 120 120) ] (safeText (LibDb.storedReasonText r))

            Nothing ->
                Ui.none
        ]


nameOf : Queue.HistoryRow -> SafeText
nameOf row =
    case row.name of
        Just n ->
            n

        Nothing ->
            SafeText.renderForeign row.uid


-- The unit page shows the source of one unit with its resolved links —
-- no decision buttons, no change state; the unit is read-only here.
unitPageBody : Model -> Ui.Element Msg
unitPageBody model =
    case model.unitPage of
        UnitLoaded loaded ->
            Ui.column
                [ Ui.width Ui.fill, Ui.spacing 16, Ui.scrollbars ]
                [ unitPageCard loaded ]

        UnitLoading ->
            unitPageStatus model.unitPage

        UnitNotFound ->
            unitPageStatus model.unitPage

        UnitFailed _ ->
            unitPageStatus model.unitPage


unitPageStatus : Queue.UnitPageState -> Ui.Element Msg
unitPageStatus state =
    case Queue.unitPageStatusText state of
        Just text ->
            Ui.text text

        Nothing ->
            Ui.none


unitPageCard : Index.UnitView -> Ui.Element Msg
unitPageCard loaded =
    let
        unit =
            loaded.unit
    in
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 16
        , Ui.spacing 10
        , Background.color (Ui.rgb 24 24 32)
        , Border.rounded 8
        , Border.solid
        , Border.width 1
        , Border.color (Ui.rgb 50 50 62)
        ]
        [ Ui.row
            [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
            [ Ui.el [ Font.size 14, Font.bold, Font.color (Ui.rgb 235 235 240) ] (safeText unit.qualified)
            , chip unit.facing
            , chip unit.kind
            ]
        , Ui.el
            [ Font.size 12, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ]
            (safeText (unitLocation unit))
        , referencesRow loaded.links
        , sourceBlock loaded
        ]


-- A page's links, then the note for the links it holds back.
referencesRow : Links.LinkSet -> Ui.Element Msg
referencesRow set =
    case List.map linkEl set.links ++ hiddenNoteEl set.hidden of
        [] ->
            Ui.none

        items ->
            Ui.wrappedRow [ Ui.spacing 6, Ui.width Ui.fill ] items


hiddenNoteEl : Links.Hidden -> List (Ui.Element Msg)
hiddenNoteEl hidden =
    case Links.hiddenNote hidden of
        Just note ->
            [ safeText note ]

        Nothing ->
            []


-- | Render a link from a fail-closed `LinkTarget` result and a label. On an
-- `Err` (an unsafe / unparseable target) the anchor degrades to the plain label
-- text — the reader still sees it, but no `href` is emitted.
linkOrText : Result Error Ui.LinkTarget -> SafeText -> Ui.Element Msg
linkOrText target labelText =
    case target of
        Ok t ->
            Ui.link
                [ Font.size 12
                , Font.family Font.monospace
                , Font.color (Ui.rgb 130 170 240)
                , Ui.padding 4
                ]
                { url = t, label = safeText labelText }

        Err _ ->
            safeText labelText


linkEl : Links.Link -> Ui.Element Msg
linkEl link =
    case link of
        Internal _ uid ->
            linkOrText (Ui.linkTarget ("/unit/" ++ uid)) (Links.label link)

        External url ->
            linkOrText (Ui.linkTarget url) (Links.label link)


decisionBadge : String -> Ui.Element Msg
decisionBadge d =
    case d of
        "approve" ->
            chipColored (SafeText.literal "✓ Approved") (Ui.rgb 35 120 55)

        "refuse" ->
            chipColored (SafeText.literal "✗ Refused") (Ui.rgb 130 45 45)

        _ ->
            chipColored (SafeText.renderForeign d) (Ui.rgb 40 40 52)


currentPath : Model -> String
currentPath model =
    case model.page of
        QueuePage ->
            "/"

        HistoryPage ->
            "/history"

        UnitPage uid ->
            "/unit/" ++ uid


urlSync : Model -> Ui.Element Msg
urlSync model =
    Ui.html
        (Html.node "div" [ Attr.attribute "data-ipe-path" (currentPath model) ] [])


unitCard : Model -> Bool -> Queue.QueuedUnit -> Ui.Element Msg
unitCard model selected q =
    let
        unit =
            q.unit

        loaded =
            Queue.selectedViewOf unit.uid model.selectedView
    in
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 16
        , Ui.spacing 10
        , Background.color (Ui.rgb 24 24 32)
        , Border.rounded 8
        , Border.solid
        , if selected then
            Border.width 2

        else
            Border.width 1
        , if selected then
            Border.color (Ui.rgb 130 170 240)

        else
            Border.color (Ui.rgb 50 50 62)
        ]
        [ Ui.row
            [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
            [ Ui.el [ Font.size 14, Font.bold, Font.color (Ui.rgb 235 235 240) ] (safeText unit.qualified)
            , changeBadge q.queued.change
            , changedChip q
            , chip unit.facing
            , chip unit.kind
            , Ui.el [ Ui.width Ui.fill ] Ui.none
            , case loaded of
                Just v ->
                    decisionButtons model v

                Nothing ->
                    Ui.none
            ]
        , Ui.el
            [ Font.size 12, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ]
            (safeText (SafeText.concat [ unitLocation unit, maybePurpose unit ]))
        , changedLine q
        , case loaded of
            Just v ->
                Ui.column
                    [ Ui.width Ui.fill, Ui.spacing 10 ]
                    [ referencesRow v.links, sourceBlock v ]

            Nothing ->
                selectedViewStatus unit.uid model.selectedView
        ]


-- The line in place of the selected card's source while its view is not
-- loaded.
selectedViewStatus : String -> Queue.SelectedView -> Ui.Element Msg
selectedViewStatus uid state =
    case Queue.selectedViewStatusText uid state of
        Just text ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 150 150 165) ] (Ui.text text)

        Nothing ->
            Ui.none


-- `path · lines a-b`, from the unit's rendered path.
unitLocation : Index.Unit -> SafeText
unitLocation unit =
    SafeText.concat
        [ unit.path
        , SafeText.literal " · lines "
        , SafeText.render (String.fromInt unit.lineStart)
        , SafeText.literal "-"
        , SafeText.render (String.fromInt unit.lineEnd)
        ]


maybePurpose : Index.Unit -> SafeText
maybePurpose unit =
    case unit.purpose of
        Just p ->
            SafeText.concat [ SafeText.literal " · purpose ", p ]

        Nothing ->
            SafeText.literal ""


changeBadge : String -> Ui.Element Msg
changeBadge change =
    case change of
        "new" ->
            chipColored (SafeText.literal "NEW") (Ui.rgb 35 120 55)

        _ ->
            chipColored (SafeText.literal "MODIFIED") (Ui.rgb 145 95 20)


-- A unit that was already reviewed on an older hash gets an amber
-- "changed" chip at the queue head; unchanged re-queues are hidden entirely.
changedChip : Queue.QueuedUnit -> Ui.Element Msg
changedChip q =
    case q.changed of
        Just _ ->
            chipColored (SafeText.literal "CHANGED") (Ui.rgb 145 95 20)

        Nothing ->
            Ui.none


changedLine : Queue.QueuedUnit -> Ui.Element Msg
changedLine q =
    case q.changed of
        Just old ->
            Ui.el
                [ Font.size 12, Font.color (Ui.rgb 200 160 90) ]
                (safeText (SafeText.concat [ previousLabel old, SafeText.literal " on ", SafeText.render (Format.formatReviewedAt old.reviewedAt) ]))

        Nothing ->
            Ui.none


previousLabel : LibDb.ReviewRow -> SafeText
previousLabel row =
    case row.decision of
        "approve" ->
            SafeText.literal "Previously Approved"

        "refuse" ->
            case row.reason of
                Just r ->
                    SafeText.concat [ SafeText.literal "Previously Refused (", LibDb.storedReasonText r, SafeText.literal ")" ]

                Nothing ->
                    SafeText.literal "Previously Refused"

        other ->
            SafeText.concat [ SafeText.literal "Previously ", SafeText.renderForeign other ]


-- The one sink for text that came from the index, the review database or
-- the environment: it takes only `SafeText`, so such text cannot be shown
-- raw.
safeText : SafeText -> Ui.Element msg
safeText text =
    Ui.text (SafeText.toString text)


chip : SafeText -> Ui.Element Msg
chip label =
    chipColored label (Ui.rgb 40 40 52)


chipColored : SafeText -> Ui.Color -> Ui.Element Msg
chipColored label bg =
    Ui.el
        [ Ui.paddingXY 8 3
        , Background.color bg
        , Border.rounded 4
        , Font.size 11
        , Font.bold
        , Font.color (Ui.rgb 220 220 230)
        ]
        (safeText label)


-- Approve and Refuse exist only for a verified view; any other view shows why
-- it cannot be decided instead.
decisionButtons : Model -> Index.UnitView -> Ui.Element Msg
decisionButtons model loaded =
    case Queue.sourceStatusText loaded.view of
        Just why ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 220 170 90) ] (Ui.text why)

        Nothing ->
            verifiedDecisionButtons model loaded.unit


verifiedDecisionButtons : Model -> Index.Unit -> Ui.Element Msg
verifiedDecisionButtons model unit =
    if model.refusingUid == Just unit.uid then
        refusePanel model unit.uid

    else
        Ui.row
            [ Ui.spacing 8 ]
            [ Ui.button
                [ Ui.paddingXY 10 5
                , Background.color (Ui.rgb 46 160 67)
                , Border.rounded 4
                , Font.size 12
                , Font.bold
                , Font.color (Ui.rgb 10 20 12)
                ]
                { onPress = Just (ApproveUnit unit.uid), label = Ui.text "Approve" }
            , Ui.button
                [ Ui.paddingXY 10 5
                , Background.color (Ui.rgb 165 60 60)
                , Border.rounded 4
                , Font.size 12
                , Font.bold
                , Font.color (Ui.rgb 245 235 235)
                ]
                { onPress = Just (RefuseStart unit.uid), label = Ui.text "Refuse" }
            ]


refusePanel : Model -> String -> Ui.Element Msg
refusePanel model uid =
    Ui.column
        [ Ui.width (Ui.px 240), Ui.spacing 6 ]
        [ Input.text
            [ Ui.width Ui.fill ]
            { label = Input.labelAbove [ Font.size 11 ] (Ui.text "Reason")
            , text = model.refuseDraft
            , onChange = RefuseDraft
            , placeholder = Just (Input.placeholder [ Font.size 12 ] (Ui.text "Why refuse?"))
            }
        , case model.refuseError of
            Just err ->
                Ui.el [ Font.size 11, Font.color (Ui.rgb 220 110 110) ] (safeText (SafeText.renderForeign (Error.message err)))

            Nothing ->
                Ui.none
        , Ui.row
            [ Ui.spacing 8 ]
            [ Ui.button
                [ Ui.paddingXY 10 5
                , Background.color (Ui.rgb 165 60 60)
                , Border.rounded 4
                , Font.size 12
                , Font.bold
                , Font.color (Ui.rgb 245 235 235)
                ]
                { onPress = Just (RefuseSubmit uid), label = Ui.text "Confirm" }
            , Ui.button
                [ Ui.paddingXY 10 5
                , Background.color (Ui.rgb 55 55 70)
                , Border.rounded 4
                , Font.size 12
                , Font.color (Ui.rgb 200 200 210)
                ]
                { onPress = Just RefuseCancel, label = Ui.text "Cancel" }
            ]
        ]


sourceBlock : Index.UnitView -> Ui.Element Msg
sourceBlock loaded =
    Ui.el
        [ Ui.width Ui.fill
        , Ui.height (Ui.px 240)
        , Ui.scrollbars
        , Background.color (Ui.rgb 12 12 18)
        , Border.rounded 4
        , Ui.padding 12
        , Ui.style "direction" "ltr"
        ]
        (Ui.column
            [ Ui.width Ui.fill, Ui.spacing 2 ]
            (case loaded.view of
                Shown shown ->
                    List.map (numberedLine loaded.unit.lang) (Format.numberedLines loaded.unit.lineStart (Index.shownText shown))

                Stale _ ->
                    withheldSource loaded.view

                Unreadable _ ->
                    withheldSource loaded.view
            )
        )


withheldSource : Index.SourceView -> List (Ui.Element Msg)
withheldSource view =
    case Queue.sourceStatusText view of
        Just why ->
            [ Ui.el [ Font.size 12, Font.color (Ui.rgb 220 170 90) ] (Ui.text why) ]

        Nothing ->
            []


numberedLine : Highlight.Lang -> ( Int, String ) -> Ui.Element Msg
numberedLine lang ( n, line ) =
    Ui.row
        [ Ui.width Ui.fill, Ui.spacing 8 ]
        [ Ui.el
            [ Ui.width (Ui.px 40)
            , Font.family Font.monospace
            , Font.size 12
            , Font.color (Ui.rgb 120 120 135)
            , Ui.alignRight
            ]
            (Ui.text (String.fromInt n))
        , Ui.el
            [ Ui.width Ui.fill
            , Font.family Font.monospace
            , Font.size 12
            ]
            (Ui.wrappedRow
                [ Ui.width Ui.fill, Ui.spacing 0 ]
                (List.map tokenEl (Highlight.tokenize lang line))
            )
        ]


tokenEl : Highlight.Token -> Ui.Element Msg
tokenEl tok =
    Ui.el
        ([ Font.family Font.monospace
        , Font.size 12
        , Font.color (tokenColor tok)
        ]
            ++ List.map (\( k, v ) -> Ui.style k v) Highlight.sourceTokenStyle
        )
        (safeText (Highlight.tokenText tok))


tokenColor : Highlight.Token -> Ui.Color
tokenColor tok =
    case tok of
        Keyword _ ->
            Ui.rgb 199 146 234

        Str _ ->
            Ui.rgb 152 195 121

        Comment _ ->
            Ui.rgb 110 110 125

        Num _ ->
            Ui.rgb 209 154 102

        Ident _ ->
            Ui.rgb 205 205 215

        Plain _ ->
            Ui.rgb 205 205 215


subscriptions : Model -> Sub Msg
subscriptions model =
    Sub.none


-- The app over the `settings` parsed at startup, the one value every request
-- reads.
reviewApp : Settings.AppSettings -> Web.WebApp
reviewApp settings =
    Web.embed
        { init = init
        , update = update settings
        , view = view
        , subscriptions = subscriptions
        , routes = [ Web.route "/" QueuePage, Web.route "/history" HistoryPage, Web.route "/unit/:uid" UnitPage ]
        , notFound = QueuePage
        , onNavigate = Navigated
        }


-- Require an environment variable, failing closed with an actionable message
-- when it is unset. `System.getenv` errors on a missing var; the recovery
-- branch names the variable and that variable's own fix, then exits
-- non-zero. The app never falls back to a silent default that would surface
-- later as an opaque SQLITE_CANTOPEN when the index db is not where a bare
-- default points. `key` and `fix` are this tool's own text.
requireEnv : String -> String -> Task Error String
requireEnv key fix =
    Task.onError
        (\_ ->
            do
                Io.eprintln ("code-review: required environment variable " ++ key ++ " is not set.\n  " ++ fix)
                System.exit 1
        )
        (System.getenv key)


-- Parse every configured location, then open and probe each one before
-- serving: the index read-only with every column a page reads, the review
-- database created and migrated, and the root, which the parse already
-- requires to be an existing directory. A relative value resolves against
-- the working directory. Then the index's `reviewed` copy is rebuilt from
-- the review database once, so progress starts exact even after an edit the
-- per-load count check cannot see. Any failure stops startup with a message
-- naming the variable and one fix. Returns the settings, the one value the
-- app serves from.
requireSettings : String -> String -> String -> Task Error Settings.AppSettings
requireSettings rawDb rawRoot rawReview =
    Task.onError
        (\e ->
            do
                Io.eprintln ("code-review: " ++ SafeText.toString (SafeText.renderForeign (Error.message e)))
                System.exit 1
        )
        (do
            index <- Settings.parseIndexSettings rawDb rawRoot
            Index.probe index
            review <- Settings.parseReviewDb rawReview
            LibDb.probe review
            db <- LibDb.openAt review
            Queue.resyncReviewed index db
            Task.succeed { index = index, review = review }
        )


main : Task Error ()
main =
    do
        rawDb <- requireEnv "IPE_INDEX_DB" "Set it to the path or sqlite:// URL of the ipe-index index.db (absolute, or relative to the working directory).\n  Build the index first from the repo root:  tools/scripts/ipe-index index"
        rawRoot <- requireEnv "IPE_INDEX_ROOT" "Set it to the repo root the index's tag:relative paths join to (absolute, or relative to the working directory)."
        settings <- requireSettings rawDb rawRoot (System.getenvOr "IPE_REVIEW_DB" "review.db")
        Server.listen 8000 [ Server.mountApp "/" (reviewApp settings) ]
