module Main exposing (main)

import Ipe.Error as Error exposing (Error)
import Ipe.Io as Io
import Ipe.Server.Http as Server
import Ipe.System as System
import Ipe.Task as Task
import Ipe.Tea.Web as Web
import Ipe.Tea.Web.Cmd as Cmd
import Ipe.Tea.Web.Sub as Sub
import Lib.App as App exposing (Model, Msg(..), Page(..))
import Lib.Db as LibDb
import Lib.EnvLookup as EnvLookup
import Lib.Epoch as Epoch
import Lib.Index as Index
import Lib.Queue as Queue
import Lib.ReviewKey as ReviewKey exposing (ReviewKey(..))
import Lib.SafeText as SafeText
import Lib.Settings as Settings
import Lib.View as View


-- The session's first model; the route entry that follows loads the page.
init : Web.WebReq -> ( Model, Cmd Msg )
init _req =
    ( App.initialModel, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions model =
    Sub.none


-- The app over the `settings` parsed at startup, the one value every request
-- reads.
reviewApp : Settings.AppSettings -> Web.WebApp
reviewApp settings =
    Web.embed
        { init = init
        , update = App.update settings
        , view = View.view
        , subscriptions = subscriptions
        , routes = [ Web.route "/" QueuePage, Web.route "/history" HistoryPage, Web.route "/unit/:uid" UnitPage ]
        , notFound = QueuePage
        , onNavigate = Navigated
        }


-- Require an environment variable, failing closed with an actionable message
-- when it cannot be read. The recovery branch names the variable, says by
-- the failure's kind whether it is not set or could not be read, never
-- repeats the failure's text, adds that variable's own fix, then exits
-- non-zero. The app never falls back to a silent default that would surface
-- later as an opaque SQLITE_CANTOPEN when the index db is not where a bare
-- default points. `key` and `fix` are this tool's own text.
requireEnv : String -> String -> Task Error String
requireEnv key fix =
    Task.onError
        (\e ->
            do
                Io.eprintln (EnvLookup.requiredVarRefusal key fix e)
                System.exit 1
        )
        (System.getenv key)


-- The review-log key, read and parsed once: a malformed value stops startup
-- with its own refusal, which never repeats the value; no value set starts
-- the server read-only, with a notice saying so.
requireReviewKey : Task Error ReviewKey
requireReviewKey =
    Task.onError
        (\e ->
            do
                Io.eprintln ("code-review: " ++ Error.message e)
                System.exit 1
        )
        (ReviewKey.readReviewKey |> Task.andThen announceKey)


announceKey : ReviewKey -> Task Error ReviewKey
announceKey key =
    case key of
        ReadOnly ->
            Io.eprintln ReviewKey.readOnlyNotice |> Task.map (\_ -> key)

        Signing _ ->
            Task.succeed key


-- Parse every configured location, then open and probe each one before
-- serving: the index read-only with every column a page reads, the review
-- database created and migrated, and the root, which the parse requires to
-- be an existing directory and `Index.probeRoot` to hold the index's files.
-- A relative value resolves against the working directory. Then the index's
-- `reviewed` copy is rebuilt from the review database once and stamped with
-- the review log's head under `key`, so the first load already reads a
-- current copy. Any failure stops startup with a message naming the
-- variable and one fix.
-- Last, this process's epoch is minted.
-- Returns the settings, the one value the app serves from.
requireSettings : ReviewKey -> String -> String -> String -> Task Error Settings.AppSettings
requireSettings key rawDb rawRoot rawReview =
    Task.onError
        (\e ->
            do
                Io.eprintln ("code-review: " ++ SafeText.toString (SafeText.renderForeign (Error.message e)))
                System.exit 1
        )
        (do
            index <- Settings.parseIndexSettings rawDb rawRoot
            Index.probe index
            Index.probeRoot index
            review <- Settings.parseReviewDb rawReview
            LibDb.probe review
            db <- LibDb.openAt review
            Queue.resyncReviewed key index db
            epoch <- Epoch.mint
            Task.succeed { index = index, review = review, key = key, epoch = epoch }
        )


main : Task Error ()
main =
    do
        rawDb <- requireEnv "IPE_INDEX_DB" "Set it to the path or sqlite:// URL of the ipe-index index.db (absolute, or relative to the working directory).\n  Build the index first from the repo root:  tools/scripts/ipe-index index"
        rawRoot <- requireEnv "IPE_INDEX_ROOT" "Set it to the repo root the index's tag:relative paths join to (absolute, or relative to the working directory)."
        key <- requireReviewKey
        settings <- requireSettings key rawDb rawRoot (System.getenvOr "IPE_REVIEW_DB" "review.db")
        Server.listen 8000 [ Server.mountApp "/" (reviewApp settings) ]
