module Migrations exposing (all)

import Ipe.Db as Db


-- Applied schema history. `Db.migrate` pins each entry by a checksum of its
-- SQL, so an entry is never edited: a schema change is a new entry. Each
-- table's `PRIMARY KEY` is the one its store in `Lib.Db` declares as its
-- conflict key; the store's conflict writes fail against a table whose key
-- differs, which the review tests exercise.
all : List Db.Migration
all =
    [ { name = "0001_review"
      , sql = """CREATE TABLE review (
    uid         TEXT NOT NULL,
    body_hash   TEXT NOT NULL,
    decision    TEXT NOT NULL CHECK (
                    decision IN ('approve', 'refuse')
                    AND (decision = 'approve'
                         OR (reason IS NOT NULL AND length(trim(reason)) > 0))
                ),
    reason      TEXT,
    reviewed_at INTEGER NOT NULL,
    PRIMARY KEY (uid, body_hash)
);"""
      }
    , { name = "0002_drain_cursor"
      , sql = """CREATE TABLE drain_cursor (
    uid        TEXT NOT NULL,
    body_hash  TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (uid, body_hash)
);"""
      }
    , { name = "0003_review_history_order"
      , sql = "CREATE INDEX review_history_order ON review (reviewed_at DESC, uid, body_hash);"
      }
    , { name = "0004_drop_drain_cursor"
      , sql = "DROP TABLE IF EXISTS drain_cursor;"
      }
    ]
