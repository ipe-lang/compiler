module Lib.View exposing (displayOrderCss, escapeCss, view)

import Ipe.Error as Error exposing (Error)
import Ipe.Html as Html
import Ipe.Html.Attributes as Attr
import Ipe.List as List
import Ipe.Result exposing (Result)
import Ipe.String as String
import Ipe.Ui as Ui
import Ipe.Ui.Background as Background
import Ipe.Ui.Border as Border
import Ipe.Ui.Font as Font
import Ipe.Ui.Input as Input
import Lib.App exposing (Model, Msg(..), Page(..), queueList, selectedUnit)
import Lib.Db as LibDb exposing (StoredDecision(..))
import Lib.Format as Format
import Lib.Highlight as Highlight exposing (Token(..))
import Lib.Index as Index exposing (Change(..), SourceView(..))
import Lib.Links as Links exposing (Link(..))
import Lib.Queue as Queue exposing (HistoryState(..), QueueState(..), UnitPageState(..))
import Lib.SafeText as SafeText exposing (SafeText, Segment(..))
import Lib.Uid exposing (Uid)


header : Model -> Ui.Element Msg
header model =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingEach { top = 12, right = 16, bottom = 12, left = 16 }
        , Ui.spacing 16
        , Ui.centerY
        , Background.color (Ui.rgb 24 24 32)
        , Border.solid
        , Border.color (Ui.rgb 60 60 72)
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        ]
        [ Ui.el [ Font.size 16, Font.bold, Font.color (Ui.rgb 235 235 240) ] (Ui.text "Code review")
        , Ui.el [ Ui.width Ui.fill ] Ui.none
        , navButton (model.page == QueuePage) "Queue" ShowQueue
        , navButton (model.page == HistoryPage) "History" ShowHistory
        , progressEl model
        ]


navButton : Bool -> String -> Msg -> Ui.Element Msg
navButton active label msg =
    Ui.button
        [ Ui.paddingXY 10 5
        , Border.rounded 4
        , Font.size 12
        , Font.bold
        , if active then
            Background.color (Ui.rgb 55 55 70)

        else
            Background.color (Ui.rgb 24 24 32)
        , Font.color (Ui.rgb 200 200 210)
        ]
        { onPress = Just msg, label = Ui.text label }


-- Progress comes from the loaded page, which reads it from the databases; a
-- queue still loading or failed shows none.
progressEl : Model -> Ui.Element Msg
progressEl model =
    case model.queueState of
        Loaded page ->
            progressOf page.progress

        Loading ->
            Ui.none

        Failed _ ->
            Ui.none


progressOf : Queue.Progress -> Ui.Element Msg
progressOf progress =
    let
        k =
            progress.reviewed

        n =
            progress.total
    in
    Ui.column
        [ Ui.width (Ui.px 220), Ui.spacing 4 ]
        [ Ui.el
            [ Font.size 12, Font.color (Ui.rgb 160 160 175) ]
            (Ui.text (String.fromInt k ++ " of " ++ String.fromInt n ++ " reviewed (" ++ Format.percent k n ++ ")"))
        , progressBar k n
        ]


progressBar : Int -> Int -> Ui.Element Msg
progressBar k n =
    if n == 0 then
        Ui.el
            [ Ui.width (Ui.px 220), Ui.height (Ui.px 6), Border.rounded 3, Background.color (Ui.rgb 45 45 58) ]
            Ui.none

    else
        Ui.row
            [ Ui.width (Ui.px 220), Ui.height (Ui.px 6), Border.rounded 3, Background.color (Ui.rgb 45 45 58) ]
            [ Ui.el
                [ Ui.width (Ui.fillPortion k), Ui.height Ui.fill, Border.rounded 3, Background.color (Ui.rgb 102 187 106) ]
                Ui.none
            , Ui.el
                [ Ui.width (Ui.fillPortion (n - k)), Ui.height Ui.fill ]
                Ui.none
            ]


view : Model -> Ui.Element Msg
view model =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.height Ui.fill
        , Background.color (Ui.rgb 16 16 22)
        , Ui.onKeyDown KeyDown
        , Ui.htmlAttribute "tabindex" "0"
        ]
        [ header model
        , Ui.el
            [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.padding 24, Font.color (Ui.rgb 190 190 200) ]
            (pageBody model)
        , urlSync model
        ]


pageBody : Model -> Ui.Element Msg
pageBody model =
    case model.page of
        QueuePage ->
            queueBody model

        HistoryPage ->
            historyBody model

        UnitPage _ ->
            unitPageBody model


queueBody : Model -> Ui.Element Msg
queueBody model =
    Ui.column
        [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 12 ]
        [ decisionErrorBanner model
        , queueStateBody model
        ]


decisionErrorBanner : Model -> Ui.Element Msg
decisionErrorBanner model =
    case model.decisionError of
        Just err ->
            Ui.el [ Font.size 13, Font.color (Ui.rgb 230 120 120) ] (safeText (SafeText.concat [ SafeText.literal "Decision save failed: ", SafeText.renderForeign (Error.toString err) ]))

        Nothing ->
            Ui.none


-- Every state's text comes from `Queue.queueStatusText`, the function the
-- tests pin; a loaded page adds its header and the next-page control.
queueStateBody : Model -> Ui.Element Msg
queueStateBody model =
    case model.queueState of
        Loaded page ->
            Ui.column
                [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 12 ]
                [ Ui.row
                    [ Ui.width Ui.fill, Ui.spacing 16, Ui.centerY ]
                    [ Ui.el [ Font.size 12, Font.color (Ui.rgb 160 160 175) ] (Ui.text (Queue.pageHeaderText page))
                    , nextPageButton page.next
                    ]
                , queueUnits model
                ]

        Loading ->
            queueUnits model

        Failed _ ->
            queueUnits model


nextPageButton : Maybe Index.Cursor -> Ui.Element Msg
nextPageButton next =
    case next of
        Just cursor ->
            navButton False "Next page" (NextPage cursor)

        Nothing ->
            Ui.none


queueUnits : Model -> Ui.Element Msg
queueUnits model =
    case Queue.queueStatusText model.queueState of
        Just text ->
            Ui.text text

        Nothing ->
            Ui.row
                [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 16 ]
                [ queueRail model
                , Ui.column
                    [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 16, Ui.scrollbars ]
                    [ hintLine
                    , case selectedUnit model of
                        Just q ->
                            unitCard model True q

                        Nothing ->
                            Ui.none
                    ]
                ]


-- The left rail is the keyboard-first overview — one button per queued
-- unit, the selected one highlighted; j/k, g and 1-5 move the selection.
queueRail : Model -> Ui.Element Msg
queueRail model =
    Ui.column
        [ Ui.width (Ui.px 280)
        , Ui.height Ui.fill
        , Ui.spacing 4
        , Ui.scrollbars
        ]
        (List.indexedMap (railItem model) (queueList model))


railItem : Model -> Int -> Queue.QueuedUnit -> Ui.Element Msg
railItem model i q =
    let
        selected =
            i == model.selected
    in
    Ui.button
        [ Ui.width Ui.fill
        , Ui.paddingXY 10 7
        , Border.rounded 4
        , Border.solid
        , Border.width 1
        , if selected then
            Border.color (Ui.rgb 130 170 240)

        else
            Border.color (Ui.rgb 40 40 52)
        , if selected then
            Background.color (Ui.rgb 34 34 46)

        else
            Background.color (Ui.rgb 24 24 32)
        ]
        { onPress = Just (SelectUnit i)
        , label = Ui.row
            [ Ui.width Ui.fill, Ui.spacing 6, Ui.centerY ]
            [ Ui.el
                [ Font.size 12, Font.bold, Font.color (Ui.rgb 220 220 230) ]
                (safeText q.unit.qualified)
            , changeBadge q.change
            ]
        }


hintLine : Ui.Element Msg
hintLine =
    Ui.el
        [ Font.size 11, Font.color (Ui.rgb 140 140 155) ]
        (Ui.text "a approve · r refuse · j/k move · g top · 1-5 jump · Enter confirm")


-- Every state's text comes from `Queue.historyStatusText`, the function the
-- tests pin; a loaded page with rows adds its cards and the next-page control.
historyBody : Model -> Ui.Element Msg
historyBody model =
    case Queue.historyStatusText model.history of
        Just text ->
            Ui.text text

        Nothing ->
            case model.history of
                HistoryLoaded page ->
                    Ui.column
                        [ Ui.width Ui.fill, Ui.spacing 16, Ui.scrollbars ]
                        (List.map historyCard page.rows ++ [ historyNextButton page.next ])

                HistoryLoading ->
                    Ui.none

                HistoryFailed _ ->
                    Ui.none


historyNextButton : Maybe LibDb.HistoryCursor -> Ui.Element Msg
historyNextButton next =
    case next of
        Just cursor ->
            navButton False "Next page" (HistoryNext cursor)

        Nothing ->
            Ui.none


historyCard : Queue.HistoryRow -> Ui.Element Msg
historyCard row =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 16
        , Ui.spacing 10
        , Background.color (Ui.rgb 24 24 32)
        , Border.rounded 8
        , Border.solid
        , Border.width 1
        , Border.color (Ui.rgb 50 50 62)
        ]
        [ Ui.row
            [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
            [ decisionBadge row.decision
            , Ui.el [ Font.size 14, Font.bold, Font.color (Ui.rgb 235 235 240) ] (safeText (nameOf row))
            , Ui.el
                [ Font.size 12, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ]
                (safeText (Index.shortHash row.bodyHash))
            , Ui.el [ Ui.width Ui.fill ] Ui.none
            , Ui.el
                [ Font.size 12, Font.color (Ui.rgb 150 150 165) ]
                (Ui.text (Format.formatReviewedAt row.reviewedAt))
            ]
        , case row.decision of
            StoredRefused r ->
                Ui.el [ Font.size 12, Font.color (Ui.rgb 200 120 120) ] (safeText (LibDb.storedReasonText r))

            StoredApproved ->
                Ui.none
        ]


nameOf : Queue.HistoryRow -> SafeText
nameOf row =
    case row.name of
        Just n ->
            n

        Nothing ->
            SafeText.renderForeign (Uid.toString row.uid)


-- The unit page shows the source of one unit with its resolved links —
-- no decision buttons, no change state; the unit is read-only here.
unitPageBody : Model -> Ui.Element Msg
unitPageBody model =
    case model.unitPage of
        UnitLoaded loaded ->
            Ui.column
                [ Ui.width Ui.fill, Ui.spacing 16, Ui.scrollbars ]
                [ unitPageCard loaded ]

        UnitLoading ->
            unitPageStatus model.unitPage

        UnitNotFound ->
            unitPageStatus model.unitPage

        UnitFailed _ ->
            unitPageStatus model.unitPage

        UnitIdRefused ->
            unitPageStatus model.unitPage


unitPageStatus : Queue.UnitPageState -> Ui.Element Msg
unitPageStatus state =
    case Queue.unitPageStatusText state of
        Just text ->
            Ui.text text

        Nothing ->
            Ui.none


unitPageCard : Index.UnitView -> Ui.Element Msg
unitPageCard loaded =
    let
        unit =
            loaded.unit
    in
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 16
        , Ui.spacing 10
        , Background.color (Ui.rgb 24 24 32)
        , Border.rounded 8
        , Border.solid
        , Border.width 1
        , Border.color (Ui.rgb 50 50 62)
        ]
        [ Ui.row
            [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
            [ Ui.el [ Font.size 14, Font.bold, Font.color (Ui.rgb 235 235 240) ] (safeText unit.qualified)
            , chip unit.facing
            , chip unit.kind
            ]
        , Ui.el
            [ Font.size 12, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ]
            (safeText (unitLocation unit))
        , referencesRow loaded.links
        , sourceBlock loaded
        ]


-- A page's links, then the note for the links it holds back.
referencesRow : Links.LinkSet -> Ui.Element Msg
referencesRow set =
    case List.map linkEl set.links ++ hiddenNoteEl set.hidden of
        [] ->
            Ui.none

        items ->
            Ui.wrappedRow [ Ui.spacing 6, Ui.width Ui.fill ] items


hiddenNoteEl : Links.Hidden -> List (Ui.Element Msg)
hiddenNoteEl hidden =
    case Links.hiddenNote hidden of
        Just note ->
            [ safeText note ]

        Nothing ->
            []


-- | Render a link from a fail-closed `LinkTarget` result and a label. On an
-- `Err` (an unsafe / unparseable target) the anchor degrades to the plain label
-- text — the reader still sees it, but no `href` is emitted.
linkOrText : Result Error Ui.LinkTarget -> SafeText -> Ui.Element Msg
linkOrText target labelText =
    case target of
        Ok t ->
            Ui.link
                [ Font.size 12
                , Font.family Font.monospace
                , Font.color (Ui.rgb 130 170 240)
                , Ui.padding 4
                ]
                { url = t, label = safeText labelText }

        Err _ ->
            safeText labelText


linkEl : Links.Link -> Ui.Element Msg
linkEl link =
    case link of
        Internal _ uid ->
            linkOrText (Ui.linkTarget ("/unit/" ++ Uid.toString uid)) (Links.label link)

        External url ->
            linkOrText (Ui.linkTarget url) (Links.label link)

        Unlinked _ ->
            safeText (Links.label link)


decisionBadge : LibDb.StoredDecision -> Ui.Element Msg
decisionBadge d =
    case d of
        StoredApproved ->
            chipColored (SafeText.literal "✓ Approved") (Ui.rgb 35 120 55)

        StoredRefused _ ->
            chipColored (SafeText.literal "✗ Refused") (Ui.rgb 130 45 45)


currentPath : Model -> String
currentPath model =
    case model.page of
        QueuePage ->
            "/"

        HistoryPage ->
            "/history"

        UnitPage uid ->
            "/unit/" ++ uid


urlSync : Model -> Ui.Element Msg
urlSync model =
    Ui.html
        (Html.node "div" [ Attr.attribute "data-ipe-path" (currentPath model) ] [])


unitCard : Model -> Bool -> Queue.QueuedUnit -> Ui.Element Msg
unitCard model selected q =
    let
        unit =
            q.unit

        loaded =
            Queue.selectedViewOf unit.uid model.selectedView
    in
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 16
        , Ui.spacing 10
        , Background.color (Ui.rgb 24 24 32)
        , Border.rounded 8
        , Border.solid
        , if selected then
            Border.width 2

        else
            Border.width 1
        , if selected then
            Border.color (Ui.rgb 130 170 240)

        else
            Border.color (Ui.rgb 50 50 62)
        ]
        [ Ui.row
            [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
            [ Ui.el [ Font.size 14, Font.bold, Font.color (Ui.rgb 235 235 240) ] (safeText unit.qualified)
            , changeBadge q.change
            , changedChip q
            , chip unit.facing
            , chip unit.kind
            , Ui.el [ Ui.width Ui.fill ] Ui.none
            , case loaded of
                Just v ->
                    decisionButtons model v

                Nothing ->
                    Ui.none
            ]
        , Ui.el
            [ Font.size 12, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ]
            (safeText (SafeText.concat [ unitLocation unit, maybePurpose unit ]))
        , changedLine q
        , case loaded of
            Just v ->
                Ui.column
                    [ Ui.width Ui.fill, Ui.spacing 10 ]
                    [ referencesRow v.links, sourceBlock v ]

            Nothing ->
                selectedViewStatus unit.uid model.selectedView
        ]


-- The line in place of the selected card's source while its view is not
-- loaded.
selectedViewStatus : Uid -> Queue.SelectedView -> Ui.Element Msg
selectedViewStatus uid state =
    case Queue.selectedViewStatusText uid state of
        Just text ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 150 150 165) ] (Ui.text text)

        Nothing ->
            Ui.none


-- `path · lines a-b`, from the unit's rendered path.
unitLocation : Index.Unit -> SafeText
unitLocation unit =
    SafeText.concat
        [ unit.path
        , SafeText.literal " · lines "
        , SafeText.render (String.fromInt unit.lineStart)
        , SafeText.literal "-"
        , SafeText.render (String.fromInt unit.lineEnd)
        ]


maybePurpose : Index.Unit -> SafeText
maybePurpose unit =
    case unit.purpose of
        Just p ->
            SafeText.concat [ SafeText.literal " · purpose ", p ]

        Nothing ->
            SafeText.literal ""


changeBadge : Index.Change -> Ui.Element Msg
changeBadge change =
    case change of
        New ->
            chipColored (SafeText.literal "NEW") (Ui.rgb 35 120 55)

        Modified _ ->
            chipColored (SafeText.literal "MODIFIED") (Ui.rgb 145 95 20)

        Unrecorded ->
            chipColored (SafeText.literal "UNRECORDED") (Ui.rgb 90 90 110)


-- A unit that was already reviewed on an older hash gets an amber
-- "changed" chip at the queue head.
changedChip : Queue.QueuedUnit -> Ui.Element Msg
changedChip q =
    case q.changed of
        Just _ ->
            chipColored (SafeText.literal "CHANGED") (Ui.rgb 145 95 20)

        Nothing ->
            Ui.none


changedLine : Queue.QueuedUnit -> Ui.Element Msg
changedLine q =
    case q.changed of
        Just old ->
            Ui.el
                [ Font.size 12, Font.color (Ui.rgb 200 160 90) ]
                (safeText (SafeText.concat [ previousLabel old, SafeText.literal " on ", SafeText.render (Format.formatReviewedAt old.reviewedAt) ]))

        Nothing ->
            Ui.none


previousLabel : LibDb.ReviewRow -> SafeText
previousLabel row =
    case row.decision of
        StoredApproved ->
            SafeText.literal "Previously Approved"

        StoredRefused r ->
            SafeText.concat [ SafeText.literal "Previously Refused (", LibDb.storedReasonText r, SafeText.literal ")" ]


-- The one sink for text that came from the index, the review database or
-- the environment: it takes only `SafeText`, so such text cannot be shown
-- raw. It draws in byte order (`displayOrderCss`) and marks every escape the
-- tool wrote (`escapeCss`), so no text the tool received can pass for one.
safeText : SafeText -> Ui.Element msg
safeText text =
    Ui.html (Html.span [ Attr.style displayOrderCss ] (List.map segmentHtml (SafeText.segments text)))


segmentHtml : Segment -> Html.Html msg
segmentHtml seg =
    case seg of
        Verbatim s ->
            Html.text s

        Escaped c ->
            Html.span [ Attr.attribute "data-review-escape" "true", Attr.style escapeCss ] [ Html.text (SafeText.escapeSpelling c) ]


-- The CSS every untrusted-text element carries: its characters are drawn in
-- byte (logical) order, so strong right-to-left letters cannot reorder the
-- neutral characters around them, and two right-to-left name segments around
-- `::` cannot swap.
displayOrderCss : String
displayOrderCss =
    "unicode-bidi:bidi-override;direction:ltr"


-- The CSS of an escape the tool wrote: a boxed, tinted run that no source
-- character draws like.
escapeCss : String
escapeCss =
    "background-color:#4a3410;border:1px solid #c98a2b;border-radius:2px;color:#ffd27a"


chip : SafeText -> Ui.Element Msg
chip label =
    chipColored label (Ui.rgb 40 40 52)


chipColored : SafeText -> Ui.Color -> Ui.Element Msg
chipColored label bg =
    Ui.el
        [ Ui.paddingXY 8 3
        , Background.color bg
        , Border.rounded 4
        , Font.size 11
        , Font.bold
        , Font.color (Ui.rgb 220 220 230)
        ]
        (safeText label)


-- Approve and Refuse exist only for a verified view; any other view shows why
-- it cannot be decided instead.
decisionButtons : Model -> Index.UnitView -> Ui.Element Msg
decisionButtons model loaded =
    case Queue.sourceStatusText loaded.view of
        Just why ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 220 170 90) ] (Ui.text why)

        Nothing ->
            verifiedDecisionButtons model loaded.unit


verifiedDecisionButtons : Model -> Index.Unit -> Ui.Element Msg
verifiedDecisionButtons model unit =
    if model.refusingUid == Just unit.uid then
        refusePanel model unit.uid

    else
        Ui.row
            [ Ui.spacing 8 ]
            [ Ui.button
                [ Ui.paddingXY 10 5
                , Background.color (Ui.rgb 46 160 67)
                , Border.rounded 4
                , Font.size 12
                , Font.bold
                , Font.color (Ui.rgb 10 20 12)
                ]
                { onPress = Just (ApproveUnit unit.uid), label = Ui.text "Approve" }
            , Ui.button
                [ Ui.paddingXY 10 5
                , Background.color (Ui.rgb 165 60 60)
                , Border.rounded 4
                , Font.size 12
                , Font.bold
                , Font.color (Ui.rgb 245 235 235)
                ]
                { onPress = Just (RefuseStart unit.uid), label = Ui.text "Refuse" }
            ]


refusePanel : Model -> Uid -> Ui.Element Msg
refusePanel model uid =
    Ui.column
        [ Ui.width (Ui.px 240), Ui.spacing 6 ]
        [ Input.text
            [ Ui.width Ui.fill ]
            { label = Input.labelAbove [ Font.size 11 ] (Ui.text "Reason")
            , text = model.refuseDraft
            , onChange = RefuseDraft
            , placeholder = Just (Input.placeholder [ Font.size 12 ] (Ui.text "Why refuse?"))
            }
        , case model.refuseError of
            Just err ->
                Ui.el [ Font.size 11, Font.color (Ui.rgb 220 110 110) ] (safeText (SafeText.renderForeign (Error.message err)))

            Nothing ->
                Ui.none
        , Ui.row
            [ Ui.spacing 8 ]
            [ Ui.button
                [ Ui.paddingXY 10 5
                , Background.color (Ui.rgb 165 60 60)
                , Border.rounded 4
                , Font.size 12
                , Font.bold
                , Font.color (Ui.rgb 245 235 235)
                ]
                { onPress = Just (RefuseSubmit uid), label = Ui.text "Confirm" }
            , Ui.button
                [ Ui.paddingXY 10 5
                , Background.color (Ui.rgb 55 55 70)
                , Border.rounded 4
                , Font.size 12
                , Font.color (Ui.rgb 200 200 210)
                ]
                { onPress = Just RefuseCancel, label = Ui.text "Cancel" }
            ]
        ]


sourceBlock : Index.UnitView -> Ui.Element Msg
sourceBlock loaded =
    Ui.el
        [ Ui.width Ui.fill
        , Ui.height (Ui.px 240)
        , Ui.scrollbars
        , Background.color (Ui.rgb 12 12 18)
        , Border.rounded 4
        , Ui.padding 12
        , Ui.style "direction" "ltr"
        ]
        (Ui.column
            [ Ui.width Ui.fill, Ui.spacing 2 ]
            (case loaded.view of
                Shown shown ->
                    List.map (numberedLine loaded.unit.lang) (Format.numberedLines loaded.unit.lineStart (Index.shownText shown))

                Stale _ ->
                    withheldSource loaded.view

                Unreadable _ ->
                    withheldSource loaded.view
            )
        )


withheldSource : Index.SourceView -> List (Ui.Element Msg)
withheldSource view =
    case Queue.sourceStatusText view of
        Just why ->
            [ Ui.el [ Font.size 12, Font.color (Ui.rgb 220 170 90) ] (Ui.text why) ]

        Nothing ->
            []


numberedLine : Highlight.Lang -> ( Int, String ) -> Ui.Element Msg
numberedLine lang ( n, line ) =
    Ui.row
        [ Ui.width Ui.fill, Ui.spacing 8 ]
        [ Ui.el
            [ Ui.width (Ui.px 40)
            , Font.family Font.monospace
            , Font.size 12
            , Font.color (Ui.rgb 120 120 135)
            , Ui.alignRight
            ]
            (Ui.text (String.fromInt n))
        , Ui.el
            [ Ui.width Ui.fill
            , Font.family Font.monospace
            , Font.size 12
            ]
            (Ui.wrappedRow
                [ Ui.width Ui.fill, Ui.spacing 0 ]
                (List.map tokenEl (Highlight.tokenize lang line))
            )
        ]


tokenEl : Highlight.Token -> Ui.Element Msg
tokenEl tok =
    Ui.el
        [ Font.family Font.monospace
        , Font.size 12
        , Font.color (tokenColor tok)
        ]
        (safeText (Highlight.tokenText tok))


tokenColor : Highlight.Token -> Ui.Color
tokenColor tok =
    case tok of
        Keyword _ ->
            Ui.rgb 199 146 234

        Str _ ->
            Ui.rgb 152 195 121

        Comment _ ->
            Ui.rgb 110 110 125

        Num _ ->
            Ui.rgb 209 154 102

        Ident _ ->
            Ui.rgb 205 205 215

        Plain _ ->
            Ui.rgb 205 205 215
