module Lib.View exposing (codeCss, codeHtml, displayOrderCss, drawnHtml, escapeCss, gutterHtml, lineHtml, view)

import Ipe.Html as Html
import Ipe.Html.Attributes as Attr
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Result as Result exposing (Result)
import Ipe.String as String
import Ipe.Time.Timestamp as Timestamp exposing (Timestamp)
import Ipe.Ui as Ui
import Ipe.Ui.Background as Background
import Ipe.Ui.Border as Border
import Ipe.Ui.Font as Font
import Ipe.Ui.Input as Input
import Lib.App as App exposing (Model, Msg(..), Page(..), queueList)
import Lib.Db as LibDb exposing (LogShown(..), ReviewEntry(..), StoredDecision(..), Unverified(..))
import Lib.Drawn as Drawn exposing (Code(..), DrawnSource, Hue(..), LayoutNote(..), Mode(..), Part(..), Piece(..), Run(..))
import Lib.Failure as Failure exposing (LoadFailure)
import Lib.Format as Format
import Lib.Index as Index exposing (Change(..), SourceView(..))
import Lib.Label as Label exposing (Label, LabelPart(..), LabelPiece(..))
import Lib.Links as Links exposing (Link(..))
import Lib.Queue as Queue exposing (DecisionTarget(..), HistoryLabel(..), HistoryState(..), Place(..), Presence(..), QueueState(..), Standing(..), UnitLabel, UnitPageState(..))
import Lib.ReviewKey as ReviewKey
import Lib.SafeText as SafeText exposing (SafeText, Segment(..))
import Lib.Uid exposing (Uid)


header : Model -> Ui.Element Msg
header model =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingEach { top = 12, right = 16, bottom = 12, left = 16 }
        , Ui.spacing 16
        , Ui.centerY
        , Background.color (Ui.rgb 24 24 32)
        , Border.solid
        , Border.color (Ui.rgb 60 60 72)
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        ]
        [ Ui.el [ Ui.describe (Ui.descHeading 1), Font.size 16, Font.bold, Font.color (Ui.rgb 235 235 240) ] (Ui.text "Code review")
        , Ui.el [ Ui.width Ui.fill ] Ui.none
        , navButton (model.page == QueuePage) (SafeText.literal "Queue") ShowQueue
        , navButton (model.page == HistoryPage) (SafeText.literal "History") ShowHistory
        , progressEl model
        ]


navButton : Bool -> SafeText -> Msg -> Ui.Element Msg
navButton active label msg =
    Ui.button
        [ Ui.paddingXY 10 5
        , Border.rounded 4
        , Font.size 12
        , Font.bold
        , if active then
            Background.color (Ui.rgb 55 55 70)

          else
            Background.color (Ui.rgb 24 24 32)
        , Font.color (Ui.rgb 200 200 210)
        ]
        { onPress = Just msg, label = safeText label }


-- Progress comes from the loaded page, which reads it from the databases; a
-- queue still loading or failed shows none.
progressEl : Model -> Ui.Element Msg
progressEl model =
    case model.queueState of
        Loaded page ->
            progressOf page.progress

        Loading ->
            Ui.none

        Failed _ ->
            Ui.none


progressOf : Queue.Progress -> Ui.Element Msg
progressOf progress =
    let
        k =
            progress.reviewed

        n =
            progress.total
    in
    Ui.column
        [ Ui.width (Ui.px 220), Ui.spacing 4 ]
        [ Ui.el
            [ Font.size 12, Font.color (Ui.rgb 160 160 175) ]
            (safeText (SafeText.literal (String.fromInt k ++ " of " ++ String.fromInt n ++ " reviewed (" ++ Format.percent k n ++ ")")))
        , progressBar k n
        ]


progressBar : Int -> Int -> Ui.Element Msg
progressBar k n =
    if n == 0 then
        Ui.el
            [ Ui.width (Ui.px 220), Ui.height (Ui.px 6), Border.rounded 3, Background.color (Ui.rgb 45 45 58) ]
            Ui.none

    else
        Ui.row
            [ Ui.width (Ui.px 220), Ui.height (Ui.px 6), Border.rounded 3, Background.color (Ui.rgb 45 45 58) ]
            [ Ui.el
                [ Ui.width (Ui.fillPortion k), Ui.height Ui.fill, Border.rounded 3, Background.color (Ui.rgb 102 187 106) ]
                Ui.none
            , Ui.el
                [ Ui.width (Ui.fillPortion (n - k)), Ui.height Ui.fill ]
                Ui.none
            ]


-- The root handles every keyboard shortcut. The client focuses it on first
-- mount (`autofocus`) and, across patches, keeps focus on the same control, or
-- its nearest focusable ancestor when the control is gone, so a key reaches the
-- handler before and after any click, since key events bubble to the root.
view : Model -> Ui.Element Msg
view model =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.height Ui.fill
        , Background.color (Ui.rgb 16 16 22)
        , Ui.onKeyDown KeyDown
        , Ui.htmlAttribute "tabindex" "0"
        , Ui.htmlAttribute "autofocus" ""
        , Ui.htmlAttribute "lang" "en"
        ]
        [ Ui.html (Html.titleNode (pageTitle model))
        , header model
        , Ui.el
            [ Ui.describe Ui.descMain, Ui.width Ui.fill, Ui.height Ui.fill, Ui.padding 24, Font.color (Ui.rgb 190 190 200) ]
            (pageBody model)
        , urlSync model
        ]


-- The document title: the page, then the tool. A title cannot mark an escape
-- or hold byte order, so it holds only this tool's own words: a unit page
-- reads "Unit", never the unit's name.
pageTitle : Model -> String
pageTitle model =
    pageTopic model ++ " · Code review"


pageTopic : Model -> String
pageTopic model =
    case model.page of
        QueuePage ->
            "Queue"

        HistoryPage ->
            "History"

        UnitPage raw ->
            case App.unitPageState raw model of
                UnitLoaded _ ->
                    "Unit"

                UnitLoading ->
                    "Unit"

                UnitNotFound ->
                    "Unit"

                UnitFailed _ ->
                    "Unit"

                UnitIdRefused ->
                    "Unit"


pageBody : Model -> Ui.Element Msg
pageBody model =
    case model.page of
        QueuePage ->
            queueBody model

        HistoryPage ->
            historyBody model

        UnitPage raw ->
            unitPageBody model.standing (App.unitPageState raw model)


queueBody : Model -> Ui.Element Msg
queueBody model =
    Ui.column
        [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 12 ]
        [ notSavedBanner model
        , queueStateBody model
        ]


notSavedBanner : Model -> Ui.Element Msg
notSavedBanner model =
    case Queue.notSavedOf model.decision of
        Just failure ->
            Ui.el [ Font.size 13, Font.color (Ui.rgb 230 120 120) ] (safeText (SafeText.literal ("Decision not saved: " ++ Failure.saveFailureText failure)))

        Nothing ->
            Ui.none


-- Every state's text comes from `Queue.queueStatusText`, the function the
-- tests pin; a loaded page adds its header and the next-page control.
queueStateBody : Model -> Ui.Element Msg
queueStateBody model =
    case model.queueState of
        Loaded page ->
            Ui.column
                [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 12 ]
                [ Ui.row
                    [ Ui.width Ui.fill, Ui.spacing 16, Ui.centerY ]
                    [ Ui.el [ Font.size 12, Font.color (Ui.rgb 160 160 175) ] (safeText (Queue.pageHeaderText page))
                    , nextPageButton page.next
                    ]
                , chainBannerLine page.log
                , refusalBlock model page
                , queueUnits model
                ]

        Loading ->
            queueUnits model

        Failed _ ->
            queueUnits model


-- The open files the index could not review, listed apart from the units.
-- Each card shows the file's escaped path, why the index refused it, its
-- size and its digest's first characters, never a byte of the file. An
-- acknowledgeable file on a page that records decisions offers Acknowledge
-- and Refuse; a blocking one says only a change to the tree closes it.
refusalBlock : Model -> Queue.QueuePage -> Ui.Element Msg
refusalBlock model page =
    if List.isEmpty page.refusals then
        Ui.none

    else
        Ui.column
            [ Ui.width Ui.fill, Ui.spacing 8 ]
            (Ui.el [ Font.size 13, Font.bold, Font.color (Ui.rgb 220 170 90) ] (Ui.text "Unreviewable files")
                :: List.map (\row -> refusalCard (refuseControlsOf model) (App.decidableRow model row.uid) page.log row) page.refusals
            )


refusalCard : RefuseControls -> Maybe Queue.DecidableRow -> LogShown -> Index.RefusalRow -> Ui.Element Msg
refusalCard controls offered shown row =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 12
        , Ui.spacing 6
        , Background.color (Ui.rgb 24 24 32)
        , Border.rounded 8
        , Border.solid
        , Border.width 1
        , Border.color (Ui.rgb 165 110 60)
        ]
        [ Ui.row
            [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
            [ sectionHeading (Ui.el [ Font.size 13, Font.bold, Font.family Font.monospace, Font.color (Ui.rgb 235 235 240) ] (shownLabel [ IndexedLabel row.path ]))
            , Ui.el
                [ Ui.paddingXY 8 3, Background.color (Ui.rgb 40 40 52), Border.rounded 4, Font.size 11, Font.bold, Font.color (Ui.rgb 220 220 230) ]
                (safeText (Queue.refusalReasonText row.reason))
            , Ui.el [ Ui.width Ui.fill ] Ui.none
            , refusalControls controls offered shown row
            ]
        , Ui.row
            [ Ui.spacing 10, Font.size 12, Font.color (Ui.rgb 150 150 165) ]
            [ case row.size of
                Just size ->
                    safeText (SafeText.literal (Format.byteSize size))

                Nothing ->
                    Ui.none
            , case row.digest of
                Just digest ->
                    Ui.el [ Font.family Font.monospace ] (safeText (Index.shortHash (Index.refusalDigestText digest)))

                Nothing ->
                    Ui.none
            ]
        ]


-- Acknowledge and Refuse for a file a decision can bind on a page that
-- records decisions; otherwise why there is no control.
refusalControls : RefuseControls -> Maybe Queue.DecidableRow -> LogShown -> Index.RefusalRow -> Ui.Element Msg
refusalControls controls offered shown row =
    case row.digest of
        Nothing ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 220 170 90) ] (Ui.text "Cannot be acknowledged: fix it in the tree.")

        Just _ ->
            case noDecisionReason shown of
                Just why ->
                    Ui.el [ Font.size 12, Font.color (Ui.rgb 220 170 90) ] (safeText (SafeText.literal why))

                Nothing ->
                    decisionControls controls row.uid offered


nextPageButton : Maybe Index.Cursor -> Ui.Element Msg
nextPageButton next =
    case next of
        Just cursor ->
            navButton False (SafeText.literal "Next page") (NextPage cursor)

        Nothing ->
            Ui.none


-- What the decision controls read of the model: the decision slot, and the
-- row its refusal panel is open on with its draft, read from the slot, which
-- holds a panel only while no decision is busy.
type alias RefuseControls =
    { panel : Maybe ( Queue.DecidableRow, Queue.Draft )
    , decision : Queue.DecisionSlot
    }


refuseControlsOf : Model -> RefuseControls
refuseControlsOf model =
    { panel = Queue.openRow model.decision, decision = model.decision }


queueUnits : Model -> Ui.Element Msg
queueUnits model =
    case Queue.queueStatusText model.queueState of
        Just text ->
            safeText text

        Nothing ->
            let
                labels =
                    Queue.queueLabels (queueList model)

                current =
                    List.head (List.drop model.selected labels)
            in
            Ui.row
                [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 16 ]
                [ queueRail model.selected labels
                , Ui.column
                    [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 16, Ui.scrollbars ]
                    [ hintLine (recordsDecisions model.queueState)
                    , case current of
                        Just ( q, label ) ->
                            unitCard (refuseControlsOf model) (App.decidableRow model q.unit.uid) model.queueState model.selectedView label q

                        Nothing ->
                            Ui.none
                    ]
                ]


-- The left rail is the keyboard-first overview — one button per queued
-- unit, the selected one highlighted; j/k, g and 1-5 move the selection.
queueRail : Int -> List ( Queue.QueuedUnit, UnitLabel ) -> Ui.Element Msg
queueRail selected labels =
    Ui.column
        [ Ui.width (Ui.px 280)
        , Ui.height Ui.fill
        , Ui.spacing 4
        , Ui.scrollbars
        ]
        (List.indexedMap (railItem selected) labels)


railItem : Int -> Int -> ( Queue.QueuedUnit, UnitLabel ) -> Ui.Element Msg
railItem selected i ( q, label ) =
    let
        isSelected =
            i == selected
    in
    Ui.button
        [ Ui.width Ui.fill
        , Ui.paddingXY 10 7
        , Border.rounded 4
        , Border.solid
        , Border.width 1
        , if isSelected then
            Border.color (Ui.rgb 130 170 240)

          else
            Border.color (Ui.rgb 40 40 52)
        , if isSelected then
            Background.color (Ui.rgb 34 34 46)

          else
            Background.color (Ui.rgb 24 24 32)
        ]
        { onPress = Just (SelectUnit i)
        , label =
            Ui.row
                [ Ui.width Ui.fill, Ui.spacing 6, Ui.centerY ]
                [ labelEl 12 label
                , changeBadge q.change
                , railStanding q.standing
                ]
        }


hintLine : Bool -> Ui.Element Msg
hintLine records =
    Ui.el
        [ Font.size 11, Font.color (Ui.rgb 140 140 155) ]
        (if records then
            Ui.text "a approve · r refuse · j/k move · g top · 1-5 jump · Enter confirm"

         else
            Ui.text "j/k move · g top · 1-5 jump"
        )


-- Only a proven log under the server's key records a decision, so a queue
-- page over a broken log, a log another key signed, or a server with no key
-- carries no decision control and no decision shortcut; the save path
-- refuses on its own.
recordsDecisions : Queue.QueueState -> Bool
recordsDecisions queueState =
    case queueState of
        Loaded page ->
            noDecisionReason page.log == Nothing

        Loading ->
            False

        Failed _ ->
            False


-- Why a queue page over this log records no decision; Nothing for a proven
-- log, the only one that records.
noDecisionReason : LogShown -> Maybe String
noDecisionReason shown =
    case shown of
        ShownProven ->
            Nothing

        ShownBroken _ ->
            Just "The review log is not intact, so no decision is recorded until it is restored."

        ShownKeyMismatch ->
            Just ("The review log was signed by a different " ++ ReviewKey.keyVar ++ ", so no decision is recorded.")

        ShownUnkeyed ->
            Just ("Read-only: " ++ ReviewKey.keyVar ++ " is not set, so no decision is recorded.")


-- The log banner of a loaded queue or history page; no banner while the
-- log is proven or the server holds no key.
chainBannerLine : LogShown -> Ui.Element Msg
chainBannerLine shown =
    case Queue.chainBanner shown of
        Just text ->
            Ui.el [ Font.size 13, Font.bold, Font.color (Ui.rgb 230 120 120) ] (safeText text)

        Nothing ->
            Ui.none


-- Every state's text comes from `Queue.historyStatusText`, the function the
-- tests pin; a loaded page with rows adds its cards and the next-page control.
historyBody : Model -> Ui.Element Msg
historyBody model =
    case Queue.historyStatusText model.history of
        Just text ->
            safeText text

        Nothing ->
            case model.history of
                HistoryLoaded page ->
                    Ui.column
                        [ Ui.width Ui.fill, Ui.spacing 16, Ui.scrollbars ]
                        (chainBannerLine page.log :: List.map historyCard page.rows ++ [ historyNextButton page.next ])

                HistoryLoading ->
                    Ui.none

                HistoryFailed _ ->
                    Ui.none


historyNextButton : Maybe LibDb.HistoryCursor -> Ui.Element Msg
historyNextButton next =
    case next of
        Just cursor ->
            navButton False (SafeText.literal "Next page") (HistoryNext cursor)

        Nothing ->
            Ui.none


historyCard : Queue.HistoryRow -> Ui.Element Msg
historyCard row =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 16
        , Ui.spacing 10
        , Background.color (Ui.rgb 24 24 32)
        , Border.rounded 8
        , Border.solid
        , Border.width 1
        , Border.color (Ui.rgb 50 50 62)
        ]
        (case row.entry of
            Verified v ->
                [ historyHeading row (decisionBadge (LibDb.verifiedDecision v)) (LibDb.verifiedHash v) (LibDb.verifiedAt v)
                , case LibDb.verifiedDecision v of
                    StoredRefused r ->
                        Ui.el [ Font.size 12, Font.color (Ui.rgb 200 120 120) ] (safeText (LibDb.storedReasonText r))

                    StoredApproved ->
                        Ui.none
                ]

            Unverified u ->
                [ historyHeading row (unverifiedBadge u.why) u.bodyHash u.reviewedAt ]
        )


historyHeading : Queue.HistoryRow -> Ui.Element Msg -> String -> Timestamp -> Ui.Element Msg
historyHeading row badge bodyHash reviewedAt =
    Ui.row
        [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
        [ badge
        , sectionHeading (historyName row.label)
        , Ui.el
            [ Font.size 12, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ]
            (safeText (Index.shortHash bodyHash))
        , Ui.el [ Ui.width Ui.fill ] Ui.none
        , Ui.el
            [ Font.size 12, Font.color (Ui.rgb 150 150 165) ]
            (safeText (SafeText.literal (Format.formatReviewedAt reviewedAt)))
        ]


-- An unverified row names why it is not counted and carries no decision.
unverifiedBadge : Unverified -> Ui.Element Msg
unverifiedBadge why =
    chipColored (SafeText.literal (unverifiedText why)) (Ui.rgb 110 80 30)


unverifiedText : Unverified -> String
unverifiedText why =
    case why of
        Tampered ->
            "Not counted: this row's signature does not verify"

        Legacy ->
            "Not counted: recorded before rows were signed"

        NoKey ->
            "Not counted: no key to verify it (read-only)"

        ChainBroken ->
            "Not counted: the log's chain breaks before this row"


-- What a History row is called: a unit's label or a file's path, each
-- marked when the index no longer holds it. A row with no name says so in
-- fixed text, never in any text the row carries.
historyName : Queue.HistoryLabel -> Ui.Element Msg
historyName label =
    case label of
        Labelled unit presence ->
            Ui.row [ Ui.spacing 6, Ui.centerY ] (labelEl 14 unit :: presenceEls presence)

        FileLabelled path presence ->
            Ui.row [ Ui.spacing 6, Ui.centerY ] (Ui.el [ Font.size 14, Font.bold, Font.color (Ui.rgb 235 235 240) ] (shownLabel [ IndexedLabel path ]) :: presenceEls presence)

        Unnamed ->
            Ui.el [ Font.size 14, Font.bold, Font.color (Ui.rgb 235 235 240) ] (safeText (SafeText.literal "unit no longer indexed (no verified record of its name)"))


presenceEls : Queue.Presence -> List (Ui.Element Msg)
presenceEls presence =
    case presence of
        Indexed ->
            []

        NoLongerIndexed ->
            [ chipColored (SafeText.literal "no longer indexed") (Ui.rgb 70 70 85) ]


-- The unit page shows the source of one unit with its resolved links —
-- no decision buttons, no change state; the unit is read-only here.
unitPageBody : Queue.StandingRead -> Queue.UnitPageState -> Ui.Element Msg
unitPageBody standing state =
    case state of
        UnitLoaded loaded ->
            Ui.column
                [ Ui.width Ui.fill, Ui.spacing 16, Ui.scrollbars ]
                [ unitPageCard standing loaded ]

        UnitLoading ->
            unitPageStatus state

        UnitNotFound ->
            unitPageStatus state

        UnitFailed _ ->
            unitPageStatus state

        UnitIdRefused ->
            unitPageStatus state


unitPageStatus : Queue.UnitPageState -> Ui.Element Msg
unitPageStatus state =
    case Queue.unitPageStatusText state of
        Just text ->
            safeText text

        Nothing ->
            Ui.none


unitPageCard : Queue.StandingRead -> Index.UnitView -> Ui.Element Msg
unitPageCard standing loaded =
    let
        unit =
            loaded.unit
    in
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 16
        , Ui.spacing 10
        , Background.color (Ui.rgb 24 24 32)
        , Border.rounded 8
        , Border.solid
        , Border.width 1
        , Border.color (Ui.rgb 50 50 62)
        ]
        [ Ui.row
            [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
            [ sectionHeading (labelEl 14 (Queue.unitLabel Named (Index.unitName unit)))
            , labelChip unit.facing
            ]
        , unitStanding (Queue.standingFor unit standing)
        , Ui.el
            [ Font.size 12, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ]
            (shownLabel (unitLocation unit))
        , referencesRow loaded.links
        , sourceBlock loaded
        ]


-- A page's links, then the note for the links it holds back.
referencesRow : Links.LinkSet -> Ui.Element Msg
referencesRow set =
    case List.map linkEl set.links ++ hiddenNoteEl set.hidden of
        [] ->
            Ui.none

        items ->
            Ui.wrappedRow [ Ui.spacing 6, Ui.width Ui.fill ] items


hiddenNoteEl : Links.Hidden -> List (Ui.Element Msg)
hiddenNoteEl hidden =
    case Links.hiddenNote hidden of
        Just note ->
            [ safeText note ]

        Nothing ->
            []


-- | Render a link from a fail-closed `LinkTarget` and its label pieces. With
-- no target (an unsafe / unparseable one, or a URL past the href ceiling)
-- the anchor degrades to the plain label — the reader still sees it, but no
-- `href` is emitted.
linkOrText : Maybe Ui.LinkTarget -> List LabelPiece -> Ui.Element Msg
linkOrText target pieces =
    case target of
        Just t ->
            Ui.link
                [ Font.size 12
                , Font.family Font.monospace
                , Font.color (Ui.rgb 130 170 240)
                , Ui.padding 4
                ]
                { url = t, label = shownLabel pieces }

        Nothing ->
            shownLabel pieces


linkEl : Links.Link -> Ui.Element Msg
linkEl link =
    case link of
        Internal _ uid ->
            linkOrText (Result.toMaybe (Ui.linkTarget ("/unit/" ++ Uid.toString uid))) (linkPieces link)

        External url ->
            linkOrText (Maybe.andThen (\raw -> Result.toMaybe (Ui.linkTarget raw)) (Links.href url)) (linkPieces link)

        Unlinked _ ->
            shownLabel (linkPieces link)


-- A link's mark, then its label.
linkPieces : Links.Link -> List LabelPiece
linkPieces link =
    case Links.mark link of
        Just m ->
            [ ToolText m, IndexedLabel (Links.label link) ]

        Nothing ->
            [ IndexedLabel (Links.label link) ]


-- Where a unit's current body stands in the review log: not reviewed,
-- decided, or a row recorded for it that is not counted. Every standing
-- draws its own badge, so a reopened unit never reads as a fresh one.
standingBadge : Queue.Standing -> Ui.Element Msg
standingBadge standing =
    case standing of
        Undecided ->
            chip (SafeText.literal "Not reviewed")

        Decided d ->
            decisionBadge d

        NotCounted why ->
            unverifiedBadge why


-- The rail names a standing only when a row exists for the current body;
-- the change badge already marks a body no row names.
railStanding : Queue.Standing -> Ui.Element Msg
railStanding standing =
    case standing of
        Undecided ->
            Ui.none

        Decided _ ->
            standingBadge standing

        NotCounted _ ->
            standingBadge standing


-- The unit page's standing line: the badge with a refusal's reason, the
-- failed read, or the read still running for the body shown.
unitStanding : Maybe (Result LoadFailure Queue.Standing) -> Ui.Element Msg
unitStanding read =
    case read of
        Just (Ok standing) ->
            Ui.row
                [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
                [ standingBadge standing
                , standingReason standing
                ]

        Just (Err failure) ->
            Ui.el
                [ Font.size 12, Font.color (Ui.rgb 200 120 120) ]
                (safeText (SafeText.literal ("Review status read failed: " ++ Failure.loadFailureText failure)))

        Nothing ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 150 150 165) ] (Ui.text "Reading review status…")


standingReason : Queue.Standing -> Ui.Element Msg
standingReason standing =
    case standing of
        Decided (StoredRefused r) ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 200 120 120) ] (safeText (LibDb.storedReasonText r))

        Decided StoredApproved ->
            Ui.none

        Undecided ->
            Ui.none

        NotCounted _ ->
            Ui.none


decisionBadge : LibDb.StoredDecision -> Ui.Element Msg
decisionBadge d =
    case d of
        StoredApproved ->
            chipColored (SafeText.literal "✓ Approved") (Ui.rgb 35 120 55)

        StoredRefused _ ->
            chipColored (SafeText.literal "✗ Refused") (Ui.rgb 130 45 45)


currentPath : Model -> String
currentPath model =
    case model.page of
        QueuePage ->
            "/"

        HistoryPage ->
            "/history"

        UnitPage uid ->
            "/unit/" ++ uid


urlSync : Model -> Ui.Element Msg
urlSync model =
    Ui.html
        (Html.node "div" [ Attr.attribute "data-ipe-path" (currentPath model) ] [])


unitCard : RefuseControls -> Maybe Queue.DecidableRow -> Queue.QueueState -> Queue.SelectedView -> UnitLabel -> Queue.QueuedUnit -> Ui.Element Msg
unitCard controls offered queueState selectedView label q =
    let
        unit =
            q.unit

        loaded =
            Queue.selectedViewOf unit.uid selectedView
    in
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 16
        , Ui.spacing 10
        , Background.color (Ui.rgb 24 24 32)
        , Border.rounded 8
        , Border.solid
        , Border.width 2
        , Border.color (Ui.rgb 130 170 240)
        ]
        [ Ui.row
            [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
            [ sectionHeading (labelEl 14 label)
            , changeBadge q.change
            , standingBadge q.standing
            , changedChip q
            , labelChip unit.facing
            , Ui.el [ Ui.width Ui.fill ] Ui.none
            , case loaded of
                Just v ->
                    decisionButtons controls offered queueState v

                Nothing ->
                    Ui.none
            ]
        , Ui.el
            [ Font.size 12, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ]
            (shownLabel (unitLocation unit ++ maybePurpose unit))
        , changedLine q
        , case loaded of
            Just v ->
                Ui.column
                    [ Ui.width Ui.fill, Ui.spacing 10 ]
                    [ referencesRow v.links, sourceBlock v ]

            Nothing ->
                selectedViewStatus unit.uid selectedView
        ]


-- The line in place of the selected card's source while its view is not
-- loaded.
selectedViewStatus : Uid -> Queue.SelectedView -> Ui.Element Msg
selectedViewStatus uid state =
    case Queue.selectedViewStatusText uid state of
        Just text ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 150 150 165) ] (safeText text)

        Nothing ->
            Ui.none


-- A section of a page: the page's one `h1` is the tool's name in the header,
-- and each unit card or history entry opens an `h2`.
sectionHeading : Ui.Element Msg -> Ui.Element Msg
sectionHeading content =
    Ui.el [ Ui.describe (Ui.descHeading 2) ] content


-- A unit's label: its kind, its qualified name and, when the page needs it
-- to tell the unit apart, its location.
labelEl : Int -> UnitLabel -> Ui.Element Msg
labelEl size label =
    Ui.row
        [ Ui.spacing 6, Ui.centerY ]
        ([ Ui.el [ Font.size size, Font.color (Ui.rgb 150 150 165) ] (shownLabel [ IndexedLabel label.kind ])
         , Ui.el [ Font.size size, Font.bold, Font.color (Ui.rgb 235 235 240) ] (shownLabel [ IndexedLabel label.name ])
         ]
            ++ placeEls size label.place
        )


placeEls : Int -> Place -> List (Ui.Element Msg)
placeEls size place =
    case place of
        Named ->
            []

        At path line ->
            [ placeEl size (placeText path line) ]

        AtUnit path line uid ->
            [ placeEl size (placeText path line ++ [ ToolText (SafeText.literal " · "), ToolText (SafeText.renderForeign (Uid.toString uid)) ]) ]


placeEl : Int -> List LabelPiece -> Ui.Element Msg
placeEl size pieces =
    Ui.el [ Font.size size, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ] (shownLabel pieces)


placeText : Label -> Int -> List LabelPiece
placeText path line =
    [ IndexedLabel path, ToolText (SafeText.literal (":" ++ String.fromInt line)) ]


-- `path · lines a-b`, from the unit's path label.
unitLocation : Index.Unit -> List LabelPiece
unitLocation unit =
    [ IndexedLabel unit.path
    , ToolText
        (SafeText.concat
            [ SafeText.literal " · lines "
            , SafeText.render (String.fromInt unit.lineStart)
            , SafeText.literal "-"
            , SafeText.render (String.fromInt unit.lineEnd)
            ]
        )
    ]


maybePurpose : Index.Unit -> List LabelPiece
maybePurpose unit =
    case unit.purpose of
        Just p ->
            [ ToolText (SafeText.literal " · purpose "), IndexedLabel p ]

        Nothing ->
            []


changeBadge : Index.Change -> Ui.Element Msg
changeBadge change =
    case change of
        New ->
            chipColored (SafeText.literal "NEW") (Ui.rgb 35 120 55)

        Modified _ ->
            chipColored (SafeText.literal "MODIFIED") (Ui.rgb 145 95 20)

        Unrecorded ->
            chipColored (SafeText.literal "UNRECORDED") (Ui.rgb 90 90 110)


-- A unit that was already reviewed on an older hash gets an amber
-- "changed" chip at the queue head.
changedChip : Queue.QueuedUnit -> Ui.Element Msg
changedChip q =
    case q.changed of
        Just _ ->
            chipColored (SafeText.literal "CHANGED") (Ui.rgb 145 95 20)

        Nothing ->
            Ui.none


changedLine : Queue.QueuedUnit -> Ui.Element Msg
changedLine q =
    case q.changed of
        Just old ->
            Ui.el
                [ Font.size 12, Font.color (Ui.rgb 200 160 90) ]
                (safeText (SafeText.concat [ previousLabel old, SafeText.literal " on ", SafeText.render (Format.formatReviewedAt (LibDb.verifiedAt old)) ]))

        Nothing ->
            Ui.none


previousLabel : LibDb.VerifiedRow -> SafeText
previousLabel row =
    case LibDb.verifiedDecision row of
        StoredApproved ->
            SafeText.literal "Previously Approved"

        StoredRefused r ->
            SafeText.concat [ SafeText.literal "Previously Refused (", LibDb.storedReasonText r, SafeText.literal ")" ]


-- The one sink for text that came from the index, the review database or
-- the environment: it takes only `SafeText`, so such text cannot be shown
-- raw. It draws in byte order (`displayOrderCss`) and marks every escape the
-- tool wrote (`escapeCss`), so no text the tool received can pass for one.
safeText : SafeText -> Ui.Element msg
safeText text =
    Ui.html (safeTextHtml text)


safeTextHtml : SafeText -> Html.Html msg
safeTextHtml text =
    Html.span [ Attr.style displayOrderCss ] (List.map segmentHtml (SafeText.segments text))


segmentHtml : Segment -> Html.Html msg
segmentHtml seg =
    case seg of
        Verbatim s ->
            Html.text s

        Escaped c ->
            Html.span [ Attr.attribute "data-review-escape" "true", Attr.style escapeCss ] [ Html.text (SafeText.escapeSpelling c) ]


-- The one sink for index labels: like `safeText`, it draws in byte order and
-- marks every escape run, and it marks a truncation marker with `cutCss`, so
-- no label text can pass for a marker the tool wrote.
shownLabel : List LabelPiece -> Ui.Element msg
shownLabel pieces =
    Ui.html (labelHtml pieces)


labelHtml : List LabelPiece -> Html.Html msg
labelHtml pieces =
    Html.span [ Attr.style displayOrderCss ] (List.concatMap shownHtml pieces)


shownHtml : LabelPiece -> List (Html.Html msg)
shownHtml piece =
    case piece of
        IndexedLabel label ->
            List.map labelPartHtml (Label.parts label)

        ToolText text ->
            List.map segmentHtml (SafeText.segments text)


labelPartHtml : LabelPart -> Html.Html msg
labelPartHtml part =
    case part of
        LabelText s ->
            Html.text s

        LabelEscapes s ->
            Html.span [ Attr.attribute "data-review-escape" "true", Attr.style escapeCss ] [ Html.text s ]

        LabelCut dropped hash ->
            Html.span [ Attr.attribute "data-review-cut" "true", Attr.style cutCss ] [ Html.text (Label.markerText dropped hash) ]


-- The CSS every untrusted-text element carries: its characters are drawn in
-- byte (logical) order, so strong right-to-left letters cannot reorder the
-- neutral characters around them, and two right-to-left name segments around
-- `::` cannot swap.
displayOrderCss : String
displayOrderCss =
    "unicode-bidi:bidi-override;direction:ltr"


-- The CSS of an escape the tool wrote: a boxed, tinted run that no source
-- character draws like.
escapeCss : String
escapeCss =
    "background-color:#4a3410;border:1px solid #c98a2b;border-radius:2px;color:#ffd27a"


-- The CSS of a truncation marker the tool wrote: a dashed, dimmed box that
-- neither label text nor an escape draws like.
cutCss : String
cutCss =
    "border:1px dashed #8a8aa0;border-radius:2px;color:#b4b4c8;font-style:italic"


chip : SafeText -> Ui.Element Msg
chip label =
    chipColored label (Ui.rgb 40 40 52)


labelChip : Label -> Ui.Element Msg
labelChip label =
    chipAround (Ui.rgb 40 40 52) (shownLabel [ IndexedLabel label ])


chipColored : SafeText -> Ui.Color -> Ui.Element Msg
chipColored label bg =
    chipAround bg (safeText label)


chipAround : Ui.Color -> Ui.Element Msg -> Ui.Element Msg
chipAround bg content =
    Ui.el
        [ Ui.paddingXY 8 3
        , Background.color bg
        , Border.rounded 4
        , Font.size 11
        , Font.bold
        , Font.color (Ui.rgb 220 220 230)
        ]
        content


-- Approve and Refuse exist only for a verified view on a server that signs
-- decisions; any other view shows why it cannot be decided instead.
decisionButtons : RefuseControls -> Maybe Queue.DecidableRow -> Queue.QueueState -> Index.UnitView -> Ui.Element Msg
decisionButtons controls offered queueState loaded =
    case Queue.sourceStatusText loaded.view of
        Just why ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 220 170 90) ] (shownLabel why)

        Nothing ->
            case queueState of
                Loaded page ->
                    case noDecisionReason page.log of
                        Nothing ->
                            verifiedDecisionButtons controls offered loaded.unit

                        Just why ->
                            Ui.el [ Font.size 12, Font.color (Ui.rgb 220 170 90) ] (safeText (SafeText.literal why))

                Loading ->
                    Ui.none

                Failed _ ->
                    Ui.none


verifiedDecisionButtons : RefuseControls -> Maybe Queue.DecidableRow -> Index.Unit -> Ui.Element Msg
verifiedDecisionButtons controls offered unit =
    decisionControls controls unit.uid offered


-- The one place a row's decision controls are drawn, for a queued unit and
-- an unreviewable file alike: the pending state of row `uid` while a
-- decision is busy, else, when the page offers a decision on it (`offered`,
-- the same row the refusal panel opens on), that row's controls. A row
-- offered under another uid draws none.
decisionControls : RefuseControls -> Uid -> Maybe Queue.DecidableRow -> Ui.Element Msg
decisionControls controls uid offered =
    case Queue.pendingText uid controls.decision of
        Just text ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 150 150 165) ] (safeText text)

        Nothing ->
            case offered of
                Just row ->
                    if Queue.rowUid row == uid then
                        offeredControls controls row

                    else
                        Ui.none

                Nothing ->
                    Ui.none


-- An offered row's controls, each message and label read from the row
-- itself: its open refusal panel, or its approve control beside Refuse.
offeredControls : RefuseControls -> Queue.DecidableRow -> Ui.Element Msg
offeredControls controls row =
    let
        uid =
            Queue.rowUid row
    in
    case controls.panel of
        Just ( open, draft ) ->
            if open == row then
                refusePanel uid draft (submitOf row)

            else
                offeredButtons row

        Nothing ->
            offeredButtons row


-- What a refusal of `row` submits: a unit's refusal or a file's.
submitOf : Queue.DecidableRow -> Msg
submitOf row =
    case Queue.rowTarget row of
        OnUnit ->
            RefuseSubmit (Queue.rowUid row)

        OnRefusal ->
            RefuseRefusalSubmit (Queue.rowUid row)


offeredButtons : Queue.DecidableRow -> Ui.Element Msg
offeredButtons row =
    let
        uid =
            Queue.rowUid row
    in
    Ui.row
        [ Ui.spacing 8 ]
        [ approveOf row
        , refuseButton (SafeText.literal "Refuse") (RefuseStart uid)
        ]


-- The approve control of `row`: Approve on a unit, Acknowledge on a file.
approveOf : Queue.DecidableRow -> Ui.Element Msg
approveOf row =
    case Queue.rowTarget row of
        OnUnit ->
            approveButton (SafeText.literal "Approve") (ApproveUnit (Queue.rowUid row))

        OnRefusal ->
            approveButton (SafeText.literal "Acknowledge") (AckRefusal (Queue.rowUid row))


approveButton : SafeText -> Msg -> Ui.Element Msg
approveButton label msg =
    Ui.button
        [ Ui.paddingXY 10 5
        , Background.color (Ui.rgb 46 160 67)
        , Border.rounded 4
        , Font.size 12
        , Font.bold
        , Font.color (Ui.rgb 10 20 12)
        ]
        { onPress = Just msg, label = safeText label }


refuseButton : SafeText -> Msg -> Ui.Element Msg
refuseButton label msg =
    Ui.button
        [ Ui.paddingXY 10 5
        , Background.color (Ui.rgb 165 60 60)
        , Border.rounded 4
        , Font.size 12
        , Font.bold
        , Font.color (Ui.rgb 245 235 235)
        ]
        { onPress = Just msg, label = safeText label }


-- The refusal reason input of the panel open on `uid` with Confirm, which
-- sends `submit`, and Cancel.
refusePanel : Uid -> Queue.Draft -> Msg -> Ui.Element Msg
refusePanel uid draft submit =
    Ui.column
        [ Ui.width (Ui.px 240), Ui.spacing 6 ]
        [ Input.text
            [ Ui.width Ui.fill ]
            { label = Input.labelAbove [ Font.size 11 ] (Ui.text "Reason")
            , text = draft.refuseDraft
            , onChange = RefuseDraft uid
            , placeholder = Just (Input.placeholder [ Font.size 12 ] (Ui.text "Why refuse?"))
            }
        , case draft.refuseError of
            Just failure ->
                Ui.el [ Font.size 11, Font.color (Ui.rgb 220 110 110) ] (safeText (SafeText.literal (Failure.refuseFailureText failure)))

            Nothing ->
                Ui.none
        , Ui.row
            [ Ui.spacing 8 ]
            [ refuseButton (SafeText.literal "Confirm") submit
            , Ui.button
                [ Ui.paddingXY 10 5
                , Background.color (Ui.rgb 55 55 70)
                , Border.rounded 4
                , Font.size 12
                , Font.color (Ui.rgb 200 200 210)
                ]
                { onPress = Just RefuseCancel, label = Ui.text "Cancel" }
            ]
        ]


sourceBlock : Index.UnitView -> Ui.Element Msg
sourceBlock loaded =
    Ui.el
        [ Ui.width Ui.fill
        , Ui.height (Ui.px 240)
        , Ui.scrollbars
        , Background.color (Ui.rgb 12 12 18)
        , Border.rounded 4
        , Ui.padding 12
        , Ui.style "direction" "ltr"
        ]
        (Ui.column
            [ Ui.width Ui.fill, Ui.spacing 2 ]
            (case loaded.view of
                Shown shown ->
                    shownSource (Index.shownDrawn shown)

                Stale _ ->
                    withheldSource loaded.view

                Unreadable _ ->
                    withheldSource loaded.view

                TooLarge _ ->
                    withheldSource loaded.view
            )
        )


withheldSource : Index.SourceView -> List (Ui.Element Msg)
withheldSource view =
    case Queue.sourceStatusText view of
        Just why ->
            [ Ui.el [ Font.size 12, Font.color (Ui.rgb 220 170 90) ] (shownLabel why) ]

        Nothing ->
            []


-- A shown view: the notes on its file's layout, a note when it is drawn
-- without highlighting, then the drawing the view was proved with.
shownSource : DrawnSource -> List (Ui.Element Msg)
shownSource drawn =
    List.map layoutNoteEl (Drawn.notes drawn) ++ modeNote (Drawn.mode drawn) ++ [ Ui.html (drawnHtml drawn) ]


modeNote : Mode -> List (Ui.Element Msg)
modeNote drawnMode =
    case drawnMode of
        Highlighted ->
            []

        Unhighlighted ->
            [ Ui.el [ Font.size 12, Font.color (Ui.rgb 150 150 165) ] (Ui.text "Shown without highlighting: highlighted, this unit would draw past the review ceiling.") ]


layoutNoteEl : LayoutNote -> Ui.Element Msg
layoutNoteEl note =
    Ui.el [ Font.size 12, Font.color (Ui.rgb 150 150 165) ] (safeText (SafeText.literal (layoutNoteText note)))


layoutNoteText : LayoutNote -> String
layoutNoteText note =
    case note of
        ByteOrderMark ->
            "The file starts with a byte-order mark (U+FEFF), which the compiler skips; it is not drawn."

        CrlfLineEnds ->
            "The file's lines end in CRLF; each \\r before a line break is not drawn."


-- A shown view's drawing: each run of numbered lines as one block of text
-- beside its gutter, and a marker for each run of lines other units cover,
-- which those units' own pages show. It draws exactly the elements
-- `Drawn.elements` counts, each in markup with its style inline.
drawnHtml : DrawnSource -> Html.Html msg
drawnHtml drawn =
    Html.div [ Attr.style "display:flex;flex-direction:column;gap:2px" ] (List.map partHtml (Drawn.parts drawn))


partHtml : Part -> Html.Html msg
partHtml part =
    case part of
        LineRun numbers code ->
            Html.div [ Attr.style "display:flex;gap:8px;font-family:monospace;font-size:12px" ] [ gutterHtml numbers, codeHtml code ]

        CoveredRun ->
            Html.div [ Attr.style "font-family:monospace;font-size:12px;color:rgb(120,120,135)" ] [ Html.text "... lines reviewed as their own units" ]


-- The line numbers of a run, one per line, outside the copied text.
gutterHtml : List Int -> Html.Html msg
gutterHtml numbers =
    Html.div
        [ Attr.style "white-space:pre;text-align:right;user-select:none;flex:none;width:40px;color:rgb(120,120,135)"
        , Attr.attribute "aria-hidden" "true"
        ]
        [ Html.text (String.join "\n" (List.map String.fromInt numbers)) ]


-- A run's lines as one block whose text is the lines joined by newlines, so
-- copying it gives the source as written: its spaces and tabs kept, a
-- coloured run one line element per line. The block draws its text in byte
-- order (`displayOrderCss`); the override holds for every inline element
-- inside it, so no line, run or escape element carries it again.
codeHtml : Code -> Html.Html msg
codeHtml code =
    Html.node "code" [ Attr.style codeCss ] (codeChildren code)


codeCss : String
codeCss =
    "display:block;flex:1;white-space:pre;color:#cdcdd7;" ++ displayOrderCss


codeChildren : Code -> List (Html.Html msg)
codeChildren code =
    case code of
        ColoredLines lines ->
            List.intersperse (Html.text "\n") (List.map lineHtml lines)

        PlainText pieces ->
            List.map pieceHtml pieces


-- One source line as a single run of inline text, so it copies as the
-- source spells it: each run not in the block's own colour an inline span in
-- its colour, its text drawn as the untrusted-text sink split it.
lineHtml : List Run -> Html.Html msg
lineHtml runs =
    Html.span [ Attr.style "white-space:pre" ] (List.concatMap runHtml runs)


runHtml : Run -> List (Html.Html msg)
runHtml run =
    case run of
        Run TextHue pieces ->
            List.map pieceHtml pieces

        Run hue pieces ->
            [ Html.span [ Attr.style (hueCss hue) ] (List.map pieceHtml pieces) ]


-- Text as itself; a run of escapes as one marked element holding each
-- escape's spelling in order.
pieceHtml : Piece -> Html.Html msg
pieceHtml piece =
    case piece of
        Chars s ->
            Html.text s

        Escapes cs ->
            Html.span [ Attr.attribute "data-review-escape" "true", Attr.style escapeCss ] [ Html.text (String.concat (List.map SafeText.escapeSpelling cs)) ]


hueCss : Hue -> String
hueCss hue =
    case hue of
        KeywordHue ->
            "color:#c792ea"

        StringHue ->
            "color:#98c379"

        CommentHue ->
            "color:#6e6e7d"

        NumberHue ->
            "color:#d19a66"

        TextHue ->
            "color:#cdcdd7"
