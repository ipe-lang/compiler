module Lib.View exposing (LayoutNote(..), RowLine(..), codeHtml, displayOrderCss, escapeCss, gutterHtml, layoutLine, layoutNotes, lineHtml, rowLines, view)

import Ipe.Char as Char
import Ipe.Html as Html
import Ipe.Html.Attributes as Attr
import Ipe.List as List
import Ipe.Result as Result exposing (Result)
import Ipe.String as String
import Ipe.Time.Timestamp as Timestamp exposing (Timestamp)
import Ipe.Ui as Ui
import Ipe.Ui.Background as Background
import Ipe.Ui.Border as Border
import Ipe.Ui.Font as Font
import Ipe.Ui.Input as Input
import Lib.App as App exposing (Model, Msg(..), Page(..), queueList)
import Lib.Db as LibDb exposing (LogShown(..), ReviewEntry(..), StoredDecision(..), Unverified(..))
import Lib.Failure as Failure exposing (LoadFailure)
import Lib.Format as Format
import Lib.Highlight as Highlight exposing (Layout, LeadingMark(..), LineEnds(..), Token(..))
import Lib.Index as Index exposing (Change(..), SourceRow(..), SourceView(..))
import Lib.Links as Links exposing (Link(..))
import Lib.Queue as Queue exposing (HistoryState(..), Place(..), QueueState(..), Standing(..), UnitLabel, UnitPageState(..))
import Lib.ReviewKey as ReviewKey
import Lib.SafeText as SafeText exposing (SafeText, Segment(..))
import Lib.Uid exposing (Uid)


header : Model -> Ui.Element Msg
header model =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingEach { top = 12, right = 16, bottom = 12, left = 16 }
        , Ui.spacing 16
        , Ui.centerY
        , Background.color (Ui.rgb 24 24 32)
        , Border.solid
        , Border.color (Ui.rgb 60 60 72)
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        ]
        [ Ui.el [ Ui.describe (Ui.descHeading 1), Font.size 16, Font.bold, Font.color (Ui.rgb 235 235 240) ] (Ui.text "Code review")
        , Ui.el [ Ui.width Ui.fill ] Ui.none
        , navButton (model.page == QueuePage) "Queue" ShowQueue
        , navButton (model.page == HistoryPage) "History" ShowHistory
        , progressEl model
        ]


navButton : Bool -> String -> Msg -> Ui.Element Msg
navButton active label msg =
    Ui.button
        [ Ui.paddingXY 10 5
        , Border.rounded 4
        , Font.size 12
        , Font.bold
        , if active then
            Background.color (Ui.rgb 55 55 70)

        else
            Background.color (Ui.rgb 24 24 32)
        , Font.color (Ui.rgb 200 200 210)
        ]
        { onPress = Just msg, label = Ui.text label }


-- Progress comes from the loaded page, which reads it from the databases; a
-- queue still loading or failed shows none.
progressEl : Model -> Ui.Element Msg
progressEl model =
    case model.queueState of
        Loaded page ->
            progressOf page.progress

        Loading ->
            Ui.none

        Failed _ ->
            Ui.none


progressOf : Queue.Progress -> Ui.Element Msg
progressOf progress =
    let
        k =
            progress.reviewed

        n =
            progress.total
    in
    Ui.column
        [ Ui.width (Ui.px 220), Ui.spacing 4 ]
        [ Ui.el
            [ Font.size 12, Font.color (Ui.rgb 160 160 175) ]
            (Ui.text (String.fromInt k ++ " of " ++ String.fromInt n ++ " reviewed (" ++ Format.percent k n ++ ")"))
        , progressBar k n
        ]


progressBar : Int -> Int -> Ui.Element Msg
progressBar k n =
    if n == 0 then
        Ui.el
            [ Ui.width (Ui.px 220), Ui.height (Ui.px 6), Border.rounded 3, Background.color (Ui.rgb 45 45 58) ]
            Ui.none

    else
        Ui.row
            [ Ui.width (Ui.px 220), Ui.height (Ui.px 6), Border.rounded 3, Background.color (Ui.rgb 45 45 58) ]
            [ Ui.el
                [ Ui.width (Ui.fillPortion k), Ui.height Ui.fill, Border.rounded 3, Background.color (Ui.rgb 102 187 106) ]
                Ui.none
            , Ui.el
                [ Ui.width (Ui.fillPortion (n - k)), Ui.height Ui.fill ]
                Ui.none
            ]


-- The root handles every keyboard shortcut. The client focuses it on first
-- mount (`autofocus`) and, across patches, keeps focus on the same control, or
-- its nearest focusable ancestor when the control is gone, so a key reaches the
-- handler before and after any click, since key events bubble to the root.
view : Model -> Ui.Element Msg
view model =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.height Ui.fill
        , Background.color (Ui.rgb 16 16 22)
        , Ui.onKeyDown KeyDown
        , Ui.htmlAttribute "tabindex" "0"
        , Ui.htmlAttribute "autofocus" ""
        , Ui.htmlAttribute "lang" "en"
        ]
        [ Ui.html (Html.titleNode (pageTitle model))
        , header model
        , Ui.el
            [ Ui.describe Ui.descMain, Ui.width Ui.fill, Ui.height Ui.fill, Ui.padding 24, Font.color (Ui.rgb 190 190 200) ]
            (pageBody model)
        , urlSync model
        ]


-- The document title: the page, then the tool. A unit page names its unit
-- once the unit is loaded.
pageTitle : Model -> String
pageTitle model =
    pageTopic model ++ " · Code review"


pageTopic : Model -> String
pageTopic model =
    case model.page of
        QueuePage ->
            "Queue"

        HistoryPage ->
            "History"

        UnitPage raw ->
            case App.unitPageState raw model of
                UnitLoaded loaded ->
                    SafeText.toString loaded.unit.qualified

                UnitLoading ->
                    "Unit"

                UnitNotFound ->
                    "Unit"

                UnitFailed _ ->
                    "Unit"

                UnitIdRefused ->
                    "Unit"


pageBody : Model -> Ui.Element Msg
pageBody model =
    case model.page of
        QueuePage ->
            queueBody model

        HistoryPage ->
            historyBody model

        UnitPage raw ->
            unitPageBody model.standing (App.unitPageState raw model)


queueBody : Model -> Ui.Element Msg
queueBody model =
    Ui.column
        [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 12 ]
        [ decisionErrorBanner model
        , queueStateBody model
        ]


decisionErrorBanner : Model -> Ui.Element Msg
decisionErrorBanner model =
    case model.decisionError of
        Just failure ->
            Ui.el [ Font.size 13, Font.color (Ui.rgb 230 120 120) ] (safeText (SafeText.concat [ SafeText.literal "Decision save failed: ", SafeText.render (Failure.saveFailureText failure) ]))

        Nothing ->
            Ui.none


-- Every state's text comes from `Queue.queueStatusText`, the function the
-- tests pin; a loaded page adds its header and the next-page control.
queueStateBody : Model -> Ui.Element Msg
queueStateBody model =
    case model.queueState of
        Loaded page ->
            Ui.column
                [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 12 ]
                [ Ui.row
                    [ Ui.width Ui.fill, Ui.spacing 16, Ui.centerY ]
                    [ Ui.el [ Font.size 12, Font.color (Ui.rgb 160 160 175) ] (Ui.text (Queue.pageHeaderText page))
                    , nextPageButton page.next
                    ]
                , chainBannerLine page.log
                , queueUnits model
                ]

        Loading ->
            queueUnits model

        Failed _ ->
            queueUnits model


nextPageButton : Maybe Index.Cursor -> Ui.Element Msg
nextPageButton next =
    case next of
        Just cursor ->
            navButton False "Next page" (NextPage cursor)

        Nothing ->
            Ui.none


queueUnits : Model -> Ui.Element Msg
queueUnits model =
    case Queue.queueStatusText model.queueState of
        Just text ->
            Ui.text text

        Nothing ->
            Ui.row
                [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 16 ]
                [ queueRail model
                , Ui.column
                    [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.spacing 16, Ui.scrollbars ]
                    [ hintLine (recordsDecisions model)
                    , case List.head (List.drop model.selected (Queue.queueLabels (queueList model))) of
                        Just ( q, label ) ->
                            unitCard model label q

                        Nothing ->
                            Ui.none
                    ]
                ]


-- The left rail is the keyboard-first overview — one button per queued
-- unit, the selected one highlighted; j/k, g and 1-5 move the selection.
queueRail : Model -> Ui.Element Msg
queueRail model =
    Ui.column
        [ Ui.width (Ui.px 280)
        , Ui.height Ui.fill
        , Ui.spacing 4
        , Ui.scrollbars
        ]
        (List.indexedMap (railItem model) (Queue.queueLabels (queueList model)))


railItem : Model -> Int -> ( Queue.QueuedUnit, UnitLabel ) -> Ui.Element Msg
railItem model i ( q, label ) =
    let
        selected =
            i == model.selected
    in
    Ui.button
        [ Ui.width Ui.fill
        , Ui.paddingXY 10 7
        , Border.rounded 4
        , Border.solid
        , Border.width 1
        , if selected then
            Border.color (Ui.rgb 130 170 240)

        else
            Border.color (Ui.rgb 40 40 52)
        , if selected then
            Background.color (Ui.rgb 34 34 46)

        else
            Background.color (Ui.rgb 24 24 32)
        ]
        { onPress = Just (SelectUnit i)
        , label = Ui.row
            [ Ui.width Ui.fill, Ui.spacing 6, Ui.centerY ]
            [ labelEl 12 label
            , changeBadge q.change
            , railStanding q.standing
            ]
        }


hintLine : Bool -> Ui.Element Msg
hintLine records =
    Ui.el
        [ Font.size 11, Font.color (Ui.rgb 140 140 155) ]
        (if records then
            Ui.text "a approve · r refuse · j/k move · g top · 1-5 jump · Enter confirm"

        else
            Ui.text "j/k move · g top · 1-5 jump"
        )


-- Only a proven log under the server's key records a decision, so a queue
-- page over a broken log, a log another key signed, or a server with no key
-- carries no decision control and no decision shortcut; the save path
-- refuses on its own.
recordsDecisions : Model -> Bool
recordsDecisions model =
    case model.queueState of
        Loaded page ->
            noDecisionReason page.log == Nothing

        Loading ->
            False

        Failed _ ->
            False


-- Why a queue page over this log records no decision; Nothing for a proven
-- log, the only one that records.
noDecisionReason : LogShown -> Maybe String
noDecisionReason shown =
    case shown of
        ShownProven ->
            Nothing

        ShownBroken _ ->
            Just "The review log is not intact, so no decision is recorded until it is restored."

        ShownKeyMismatch ->
            Just ("The review log was signed by a different " ++ ReviewKey.keyVar ++ ", so no decision is recorded.")

        ShownUnkeyed ->
            Just ("Read-only: " ++ ReviewKey.keyVar ++ " is not set, so no decision is recorded.")


-- The log banner of a loaded queue or history page; no banner while the
-- log is proven or the server holds no key.
chainBannerLine : LogShown -> Ui.Element Msg
chainBannerLine shown =
    case Queue.chainBanner shown of
        Just text ->
            Ui.el [ Font.size 13, Font.bold, Font.color (Ui.rgb 230 120 120) ] (Ui.text text)

        Nothing ->
            Ui.none


-- Every state's text comes from `Queue.historyStatusText`, the function the
-- tests pin; a loaded page with rows adds its cards and the next-page control.
historyBody : Model -> Ui.Element Msg
historyBody model =
    case Queue.historyStatusText model.history of
        Just text ->
            Ui.text text

        Nothing ->
            case model.history of
                HistoryLoaded page ->
                    Ui.column
                        [ Ui.width Ui.fill, Ui.spacing 16, Ui.scrollbars ]
                        (chainBannerLine page.log :: List.map historyCard page.rows ++ [ historyNextButton page.next ])

                HistoryLoading ->
                    Ui.none

                HistoryFailed _ ->
                    Ui.none


historyNextButton : Maybe LibDb.HistoryCursor -> Ui.Element Msg
historyNextButton next =
    case next of
        Just cursor ->
            navButton False "Next page" (HistoryNext cursor)

        Nothing ->
            Ui.none


historyCard : Queue.HistoryRow -> Ui.Element Msg
historyCard row =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 16
        , Ui.spacing 10
        , Background.color (Ui.rgb 24 24 32)
        , Border.rounded 8
        , Border.solid
        , Border.width 1
        , Border.color (Ui.rgb 50 50 62)
        ]
        (case row.entry of
            Verified v ->
                [ historyHeading row (decisionBadge (LibDb.verifiedDecision v)) (LibDb.verifiedHash v) (LibDb.verifiedAt v)
                , case LibDb.verifiedDecision v of
                    StoredRefused r ->
                        Ui.el [ Font.size 12, Font.color (Ui.rgb 200 120 120) ] (safeText (LibDb.storedReasonText r))

                    StoredApproved ->
                        Ui.none
                ]

            Unverified u ->
                [ historyHeading row (unverifiedBadge u.why) u.bodyHash u.reviewedAt ]
        )


historyHeading : Queue.HistoryRow -> Ui.Element Msg -> String -> Timestamp -> Ui.Element Msg
historyHeading row badge bodyHash reviewedAt =
    Ui.row
        [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
        [ badge
        , Ui.el [ Ui.describe (Ui.descHeading 2), Font.size 14, Font.bold, Font.color (Ui.rgb 235 235 240) ] (safeText (nameOf row))
        , Ui.el
            [ Font.size 12, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ]
            (safeText (Index.shortHash bodyHash))
        , Ui.el [ Ui.width Ui.fill ] Ui.none
        , Ui.el
            [ Font.size 12, Font.color (Ui.rgb 150 150 165) ]
            (Ui.text (Format.formatReviewedAt reviewedAt))
        ]


-- An unverified row names why it is not counted and carries no decision.
unverifiedBadge : Unverified -> Ui.Element Msg
unverifiedBadge why =
    chipColored (SafeText.literal (unverifiedText why)) (Ui.rgb 110 80 30)


unverifiedText : Unverified -> String
unverifiedText why =
    case why of
        Tampered ->
            "Not counted: this row's signature does not verify"

        Legacy ->
            "Not counted: recorded before rows were signed"

        NoKey ->
            "Not counted: no key to verify it (read-only)"

        ChainBroken ->
            "Not counted: the log's chain breaks before this row"


nameOf : Queue.HistoryRow -> SafeText
nameOf row =
    case row.name of
        Just n ->
            n

        Nothing ->
            SafeText.renderForeign (Uid.toString (Queue.entryUid row.entry))


-- The unit page shows the source of one unit with its resolved links —
-- no decision buttons, no change state; the unit is read-only here.
unitPageBody : Queue.StandingRead -> Queue.UnitPageState -> Ui.Element Msg
unitPageBody standing state =
    case state of
        UnitLoaded loaded ->
            Ui.column
                [ Ui.width Ui.fill, Ui.spacing 16, Ui.scrollbars ]
                [ unitPageCard standing loaded ]

        UnitLoading ->
            unitPageStatus state

        UnitNotFound ->
            unitPageStatus state

        UnitFailed _ ->
            unitPageStatus state

        UnitIdRefused ->
            unitPageStatus state


unitPageStatus : Queue.UnitPageState -> Ui.Element Msg
unitPageStatus state =
    case Queue.unitPageStatusText state of
        Just text ->
            Ui.text text

        Nothing ->
            Ui.none


unitPageCard : Queue.StandingRead -> Index.UnitView -> Ui.Element Msg
unitPageCard standing loaded =
    let
        unit =
            loaded.unit
    in
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 16
        , Ui.spacing 10
        , Background.color (Ui.rgb 24 24 32)
        , Border.rounded 8
        , Border.solid
        , Border.width 1
        , Border.color (Ui.rgb 50 50 62)
        ]
        [ Ui.row
            [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
            [ sectionHeading (labelEl 14 (Queue.unitLabel Named unit))
            , chip unit.facing
            ]
        , unitStanding (Queue.standingFor unit standing)
        , Ui.el
            [ Font.size 12, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ]
            (safeText (unitLocation unit))
        , referencesRow loaded.links
        , sourceBlock loaded
        ]


-- A page's links, then the note for the links it holds back.
referencesRow : Links.LinkSet -> Ui.Element Msg
referencesRow set =
    case List.map linkEl set.links ++ hiddenNoteEl set.hidden of
        [] ->
            Ui.none

        items ->
            Ui.wrappedRow [ Ui.spacing 6, Ui.width Ui.fill ] items


hiddenNoteEl : Links.Hidden -> List (Ui.Element Msg)
hiddenNoteEl hidden =
    case Links.hiddenNote hidden of
        Just note ->
            [ safeText note ]

        Nothing ->
            []


-- | Render a link from a fail-closed `LinkTarget` and a label. With no target
-- (an unsafe / unparseable one) the anchor degrades to the plain label text —
-- the reader still sees it, but no `href` is emitted.
linkOrText : Maybe Ui.LinkTarget -> SafeText -> Ui.Element Msg
linkOrText target labelText =
    case target of
        Just t ->
            Ui.link
                [ Font.size 12
                , Font.family Font.monospace
                , Font.color (Ui.rgb 130 170 240)
                , Ui.padding 4
                ]
                { url = t, label = safeText labelText }

        Nothing ->
            safeText labelText


linkEl : Links.Link -> Ui.Element Msg
linkEl link =
    case link of
        Internal _ uid ->
            linkOrText (Result.toMaybe (Ui.linkTarget ("/unit/" ++ Uid.toString uid))) (Links.label link)

        External url ->
            linkOrText (Result.toMaybe (Ui.linkTarget url)) (Links.label link)

        Unlinked _ ->
            safeText (Links.label link)


-- Where a unit's current body stands in the review log: not reviewed,
-- decided, or a row recorded for it that is not counted. Every standing
-- draws its own badge, so a reopened unit never reads as a fresh one.
standingBadge : Queue.Standing -> Ui.Element Msg
standingBadge standing =
    case standing of
        Undecided ->
            chip (SafeText.literal "Not reviewed")

        Decided d ->
            decisionBadge d

        NotCounted why ->
            unverifiedBadge why


-- The rail names a standing only when a row exists for the current body;
-- the change badge already marks a body no row names.
railStanding : Queue.Standing -> Ui.Element Msg
railStanding standing =
    case standing of
        Undecided ->
            Ui.none

        Decided _ ->
            standingBadge standing

        NotCounted _ ->
            standingBadge standing


-- The unit page's standing line: the badge with a refusal's reason, the
-- failed read, or the read still running for the body shown.
unitStanding : Maybe (Result LoadFailure Queue.Standing) -> Ui.Element Msg
unitStanding read =
    case read of
        Just (Ok standing) ->
            Ui.row
                [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
                [ standingBadge standing
                , standingReason standing
                ]

        Just (Err failure) ->
            Ui.el
                [ Font.size 12, Font.color (Ui.rgb 200 120 120) ]
                (safeText (SafeText.concat [ SafeText.literal "Review status read failed: ", SafeText.render (Failure.loadFailureText failure) ]))

        Nothing ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 150 150 165) ] (Ui.text "Reading review status…")


standingReason : Queue.Standing -> Ui.Element Msg
standingReason standing =
    case standing of
        Decided (StoredRefused r) ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 200 120 120) ] (safeText (LibDb.storedReasonText r))

        Decided StoredApproved ->
            Ui.none

        Undecided ->
            Ui.none

        NotCounted _ ->
            Ui.none


decisionBadge : LibDb.StoredDecision -> Ui.Element Msg
decisionBadge d =
    case d of
        StoredApproved ->
            chipColored (SafeText.literal "✓ Approved") (Ui.rgb 35 120 55)

        StoredRefused _ ->
            chipColored (SafeText.literal "✗ Refused") (Ui.rgb 130 45 45)


currentPath : Model -> String
currentPath model =
    case model.page of
        QueuePage ->
            "/"

        HistoryPage ->
            "/history"

        UnitPage uid ->
            "/unit/" ++ uid


urlSync : Model -> Ui.Element Msg
urlSync model =
    Ui.html
        (Html.node "div" [ Attr.attribute "data-ipe-path" (currentPath model) ] [])


unitCard : Model -> UnitLabel -> Queue.QueuedUnit -> Ui.Element Msg
unitCard model label q =
    let
        unit =
            q.unit

        loaded =
            Queue.selectedViewOf unit.uid model.selectedView
    in
    Ui.column
        [ Ui.width Ui.fill
        , Ui.padding 16
        , Ui.spacing 10
        , Background.color (Ui.rgb 24 24 32)
        , Border.rounded 8
        , Border.solid
        , Border.width 2
        , Border.color (Ui.rgb 130 170 240)
        ]
        [ Ui.row
            [ Ui.width Ui.fill, Ui.spacing 10, Ui.centerY ]
            [ sectionHeading (labelEl 14 label)
            , changeBadge q.change
            , standingBadge q.standing
            , changedChip q
            , chip unit.facing
            , Ui.el [ Ui.width Ui.fill ] Ui.none
            , case loaded of
                Just v ->
                    decisionButtons model v

                Nothing ->
                    Ui.none
            ]
        , Ui.el
            [ Font.size 12, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ]
            (safeText (SafeText.concat [ unitLocation unit, maybePurpose unit ]))
        , changedLine q
        , case loaded of
            Just v ->
                Ui.column
                    [ Ui.width Ui.fill, Ui.spacing 10 ]
                    [ referencesRow v.links, sourceBlock v ]

            Nothing ->
                selectedViewStatus unit.uid model.selectedView
        ]


-- The line in place of the selected card's source while its view is not
-- loaded.
selectedViewStatus : Uid -> Queue.SelectedView -> Ui.Element Msg
selectedViewStatus uid state =
    case Queue.selectedViewStatusText uid state of
        Just text ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 150 150 165) ] (Ui.text text)

        Nothing ->
            Ui.none


-- A section of a page: the page's one `h1` is the tool's name in the header,
-- and each unit card or history entry opens an `h2`.
sectionHeading : Ui.Element Msg -> Ui.Element Msg
sectionHeading content =
    Ui.el [ Ui.describe (Ui.descHeading 2) ] content


-- A unit's label: its kind, its qualified name and, when the page needs it
-- to tell the unit apart, its location.
labelEl : Int -> UnitLabel -> Ui.Element Msg
labelEl size label =
    Ui.row
        [ Ui.spacing 6, Ui.centerY ]
        ([ Ui.el [ Font.size size, Font.color (Ui.rgb 150 150 165) ] (safeText label.kind)
        , Ui.el [ Font.size size, Font.bold, Font.color (Ui.rgb 235 235 240) ] (safeText label.name)
        ]
            ++ placeEls size label.place
        )


placeEls : Int -> Place -> List (Ui.Element Msg)
placeEls size place =
    case place of
        Named ->
            []

        At path line ->
            [ placeEl size (placeText path line) ]

        AtUnit path line uid ->
            [ placeEl size (SafeText.concat [ placeText path line, SafeText.literal " · ", SafeText.renderForeign (Uid.toString uid) ]) ]


placeEl : Int -> SafeText -> Ui.Element Msg
placeEl size text =
    Ui.el [ Font.size size, Font.family Font.monospace, Font.color (Ui.rgb 150 150 165) ] (safeText text)


placeText : SafeText -> Int -> SafeText
placeText path line =
    SafeText.concat [ path, SafeText.literal (":" ++ String.fromInt line) ]


-- `path · lines a-b`, from the unit's rendered path.
unitLocation : Index.Unit -> SafeText
unitLocation unit =
    SafeText.concat
        [ unit.path
        , SafeText.literal " · lines "
        , SafeText.render (String.fromInt unit.lineStart)
        , SafeText.literal "-"
        , SafeText.render (String.fromInt unit.lineEnd)
        ]


maybePurpose : Index.Unit -> SafeText
maybePurpose unit =
    case unit.purpose of
        Just p ->
            SafeText.concat [ SafeText.literal " · purpose ", p ]

        Nothing ->
            SafeText.literal ""


changeBadge : Index.Change -> Ui.Element Msg
changeBadge change =
    case change of
        New ->
            chipColored (SafeText.literal "NEW") (Ui.rgb 35 120 55)

        Modified _ ->
            chipColored (SafeText.literal "MODIFIED") (Ui.rgb 145 95 20)

        Unrecorded ->
            chipColored (SafeText.literal "UNRECORDED") (Ui.rgb 90 90 110)


-- A unit that was already reviewed on an older hash gets an amber
-- "changed" chip at the queue head.
changedChip : Queue.QueuedUnit -> Ui.Element Msg
changedChip q =
    case q.changed of
        Just _ ->
            chipColored (SafeText.literal "CHANGED") (Ui.rgb 145 95 20)

        Nothing ->
            Ui.none


changedLine : Queue.QueuedUnit -> Ui.Element Msg
changedLine q =
    case q.changed of
        Just old ->
            Ui.el
                [ Font.size 12, Font.color (Ui.rgb 200 160 90) ]
                (safeText (SafeText.concat [ previousLabel old, SafeText.literal " on ", SafeText.render (Format.formatReviewedAt (LibDb.verifiedAt old)) ]))

        Nothing ->
            Ui.none


previousLabel : LibDb.VerifiedRow -> SafeText
previousLabel row =
    case LibDb.verifiedDecision row of
        StoredApproved ->
            SafeText.literal "Previously Approved"

        StoredRefused r ->
            SafeText.concat [ SafeText.literal "Previously Refused (", LibDb.storedReasonText r, SafeText.literal ")" ]


-- The one sink for text that came from the index, the review database or
-- the environment: it takes only `SafeText`, so such text cannot be shown
-- raw. It draws in byte order (`displayOrderCss`) and marks every escape the
-- tool wrote (`escapeCss`), so no text the tool received can pass for one.
safeText : SafeText -> Ui.Element msg
safeText text =
    Ui.html (safeTextHtml text)


safeTextHtml : SafeText -> Html.Html msg
safeTextHtml text =
    Html.span [ Attr.style displayOrderCss ] (List.map segmentHtml (SafeText.segments text))


segmentHtml : Segment -> Html.Html msg
segmentHtml seg =
    case seg of
        Verbatim s ->
            Html.text s

        Escaped c ->
            Html.span [ Attr.attribute "data-review-escape" "true", Attr.style escapeCss ] [ Html.text (SafeText.escapeSpelling c) ]


-- The CSS every untrusted-text element carries: its characters are drawn in
-- byte (logical) order, so strong right-to-left letters cannot reorder the
-- neutral characters around them, and two right-to-left name segments around
-- `::` cannot swap.
displayOrderCss : String
displayOrderCss =
    "unicode-bidi:bidi-override;direction:ltr"


-- The CSS of an escape the tool wrote: a boxed, tinted run that no source
-- character draws like.
escapeCss : String
escapeCss =
    "background-color:#4a3410;border:1px solid #c98a2b;border-radius:2px;color:#ffd27a"


chip : SafeText -> Ui.Element Msg
chip label =
    chipColored label (Ui.rgb 40 40 52)


chipColored : SafeText -> Ui.Color -> Ui.Element Msg
chipColored label bg =
    Ui.el
        [ Ui.paddingXY 8 3
        , Background.color bg
        , Border.rounded 4
        , Font.size 11
        , Font.bold
        , Font.color (Ui.rgb 220 220 230)
        ]
        (safeText label)


-- Approve and Refuse exist only for a verified view on a server that signs
-- decisions; any other view shows why it cannot be decided instead.
decisionButtons : Model -> Index.UnitView -> Ui.Element Msg
decisionButtons model loaded =
    case Queue.sourceStatusText loaded.view of
        Just why ->
            Ui.el [ Font.size 12, Font.color (Ui.rgb 220 170 90) ] (Ui.text why)

        Nothing ->
            case model.queueState of
                Loaded page ->
                    case noDecisionReason page.log of
                        Nothing ->
                            verifiedDecisionButtons model loaded.unit

                        Just why ->
                            Ui.el [ Font.size 12, Font.color (Ui.rgb 220 170 90) ] (Ui.text why)

                Loading ->
                    Ui.none

                Failed _ ->
                    Ui.none


verifiedDecisionButtons : Model -> Index.Unit -> Ui.Element Msg
verifiedDecisionButtons model unit =
    if model.refusingUid == Just unit.uid then
        refusePanel model unit.uid

    else
        Ui.row
            [ Ui.spacing 8 ]
            [ Ui.button
                [ Ui.paddingXY 10 5
                , Background.color (Ui.rgb 46 160 67)
                , Border.rounded 4
                , Font.size 12
                , Font.bold
                , Font.color (Ui.rgb 10 20 12)
                ]
                { onPress = Just (ApproveUnit unit.uid), label = Ui.text "Approve" }
            , Ui.button
                [ Ui.paddingXY 10 5
                , Background.color (Ui.rgb 165 60 60)
                , Border.rounded 4
                , Font.size 12
                , Font.bold
                , Font.color (Ui.rgb 245 235 235)
                ]
                { onPress = Just (RefuseStart unit.uid), label = Ui.text "Refuse" }
            ]


refusePanel : Model -> Uid -> Ui.Element Msg
refusePanel model uid =
    Ui.column
        [ Ui.width (Ui.px 240), Ui.spacing 6 ]
        [ Input.text
            [ Ui.width Ui.fill ]
            { label = Input.labelAbove [ Font.size 11 ] (Ui.text "Reason")
            , text = model.refuseDraft
            , onChange = RefuseDraft
            , placeholder = Just (Input.placeholder [ Font.size 12 ] (Ui.text "Why refuse?"))
            }
        , case model.refuseError of
            Just failure ->
                Ui.el [ Font.size 11, Font.color (Ui.rgb 220 110 110) ] (safeText (SafeText.render (Failure.refuseFailureText failure)))

            Nothing ->
                Ui.none
        , Ui.row
            [ Ui.spacing 8 ]
            [ Ui.button
                [ Ui.paddingXY 10 5
                , Background.color (Ui.rgb 165 60 60)
                , Border.rounded 4
                , Font.size 12
                , Font.bold
                , Font.color (Ui.rgb 245 235 235)
                ]
                { onPress = Just (RefuseSubmit uid), label = Ui.text "Confirm" }
            , Ui.button
                [ Ui.paddingXY 10 5
                , Background.color (Ui.rgb 55 55 70)
                , Border.rounded 4
                , Font.size 12
                , Font.color (Ui.rgb 200 200 210)
                ]
                { onPress = Just RefuseCancel, label = Ui.text "Cancel" }
            ]
        ]


sourceBlock : Index.UnitView -> Ui.Element Msg
sourceBlock loaded =
    Ui.el
        [ Ui.width Ui.fill
        , Ui.height (Ui.px 240)
        , Ui.scrollbars
        , Background.color (Ui.rgb 12 12 18)
        , Border.rounded 4
        , Ui.padding 12
        , Ui.style "direction" "ltr"
        ]
        (Ui.column
            [ Ui.width Ui.fill, Ui.spacing 2 ]
            (case loaded.view of
                Shown shown ->
                    shownSource loaded.unit.lang (Index.shownRows shown)

                Stale _ ->
                    withheldSource loaded.view

                Unreadable _ ->
                    withheldSource loaded.view

                TooLarge _ ->
                    withheldSource loaded.view
            )
        )


withheldSource : Index.SourceView -> List (Ui.Element Msg)
withheldSource view =
    case Queue.sourceStatusText view of
        Just why ->
            [ Ui.el [ Font.size 12, Font.color (Ui.rgb 220 170 90) ] (Ui.text why) ]

        Nothing ->
            []


-- A shown view: the notes on its file's layout, then each run of numbered
-- lines as one block of text, and a marker for each run of lines other units
-- cover, which those units' own pages show.
shownSource : Highlight.Lang -> List SourceRow -> List (Ui.Element Msg)
shownSource lang rows =
    List.map layoutNoteEl (layoutNotes lang rows) ++ List.map sourcePart (sourceParts (rowLines lang rows))


sourcePart : SourcePart -> Ui.Element Msg
sourcePart part =
    case part of
        LineRun run ->
            lineRun run

        CoveredRun ->
            Ui.el
                [ Ui.width Ui.fill
                , Font.family Font.monospace
                , Font.size 12
                , Font.color (Ui.rgb 120 120 135)
                ]
                (Ui.text "... lines reviewed as their own units")


-- Consecutive numbered lines, or one run of covered lines.
type SourcePart
    = LineRun (List ( Int, List Token ))
    | CoveredRun


sourceParts : List RowLine -> List SourcePart
sourceParts lines =
    case List.foldl sourcePartStep ( [], [] ) lines of
        ( run, parts ) ->
            closeRun run parts


sourcePartStep : RowLine -> ( List ( Int, List Token ), List SourcePart ) -> ( List ( Int, List Token ), List SourcePart )
sourcePartStep line ( run, parts ) =
    case line of
        TokenLine n toks ->
            ( run ++ [ ( n, toks ) ], parts )

        CoveredLine ->
            ( [], closeRun run parts ++ [ CoveredRun ] )


closeRun : List ( Int, List Token ) -> List SourcePart -> List SourcePart
closeRun run parts =
    case run of
        [] ->
            parts

        _ ->
            parts ++ [ LineRun run ]


-- A run of lines: the line numbers in a gutter selection and copying skip,
-- beside the lines as one text block.
lineRun : List ( Int, List Token ) -> Ui.Element Msg
lineRun run =
    Ui.row
        [ Ui.width Ui.fill, Ui.spacing 8 ]
        [ Ui.el
            [ Ui.width (Ui.px 40)
            , Font.family Font.monospace
            , Font.size 12
            , Font.color (Ui.rgb 120 120 135)
            ]
            (Ui.html (gutterHtml (List.map (\( n, _ ) -> n) run)))
        , Ui.el
            [ Ui.width Ui.fill
            , Font.family Font.monospace
            , Font.size 12
            ]
            (Ui.html (codeHtml (List.map (\( _, toks ) -> toks) run)))
        ]


-- The line numbers of a run, one per line, outside the copied text.
gutterHtml : List Int -> Html.Html msg
gutterHtml numbers =
    Html.div
        [ Attr.style "white-space:pre;text-align:right;user-select:none"
        , Attr.attribute "aria-hidden" "true"
        ]
        [ Html.text (String.join "\n" (List.map String.fromInt numbers)) ]


-- A run's lines as one block whose text is the lines joined by newlines, so
-- copying it gives the source as written: one line element per line, its
-- spaces and tabs kept.
codeHtml : List (List Token) -> Html.Html msg
codeHtml lines =
    Html.node
        "code"
        [ Attr.style "display:block;white-space:pre" ]
        (List.intersperse (Html.text "\n") (List.map lineHtml lines))


-- What the source view drew as layout rather than as text: a leading
-- byte-order mark the language skips, or CRLF line ends it reads as line
-- breaks.
type LayoutNote
    = ByteOrderMark
    | CrlfLineEnds


layoutNotes : Highlight.Lang -> List SourceRow -> List LayoutNote
layoutNotes lang rows =
    let
        layout =
            Highlight.layoutOf lang
    in
    noteIf (List.any (leadingMarkRow layout) rows) ByteOrderMark ++ noteIf (List.any (crlfRow layout) rows) CrlfLineEnds


noteIf : Bool -> LayoutNote -> List LayoutNote
noteIf present note =
    if present then
        [ note ]

    else
        []


leadingMarkRow : Layout -> SourceRow -> Bool
leadingMarkRow layout row =
    case row of
        Numbered n line ->
            startsWithLayoutMark layout n line

        Covered ->
            False


crlfRow : Layout -> SourceRow -> Bool
crlfRow layout row =
    case row of
        Numbered _ line ->
            endsWithLayoutCr layout line

        Covered ->
            False


layoutNoteEl : LayoutNote -> Ui.Element Msg
layoutNoteEl note =
    Ui.el [ Font.size 12, Font.color (Ui.rgb 150 150 165) ] (Ui.text (layoutNoteText note))


layoutNoteText : LayoutNote -> String
layoutNoteText note =
    case note of
        ByteOrderMark ->
            "The file starts with a byte-order mark (U+FEFF), which the compiler skips; it is not drawn."

        CrlfLineEnds ->
            "The file's lines end in CRLF; each \\r before a line break is not drawn."


-- A shown row with its tokens: a numbered line, or a covered run.
type RowLine
    = TokenLine Int (List Token)
    | CoveredLine


-- The rows of a shown view with each line's tokens. A run of numbered rows
-- is lexed as one text, a line's open lexeme (a block comment, a string that
-- spans lines) carried into the next row, so a comment or string reads the
-- same whatever line it starts on; a covered run starts afresh. Linear in
-- the rows' text.
rowLines : Highlight.Lang -> List SourceRow -> List RowLine
rowLines lang rows =
    case List.foldl (rowLineStep lang (Highlight.layoutOf lang)) ( Highlight.lineStart, [] ) rows of
        ( _, lines ) ->
            lines


rowLineStep : Highlight.Lang -> Layout -> SourceRow -> ( Highlight.Carry, List RowLine ) -> ( Highlight.Carry, List RowLine )
rowLineStep lang layout row ( carry, lines ) =
    case row of
        Numbered n line ->
            case Highlight.lexLine lang carry (layoutLine layout n line) of
                ( toks, next ) ->
                    ( next, lines ++ [ TokenLine n toks ] )

        Covered ->
            ( Highlight.lineStart, lines ++ [ CoveredLine ] )


-- Line `n` without what its language's layout says is not text: the `\r`
-- of a CRLF ending where a CRLF is one line break, and a byte-order mark
-- opening line 1 where the compiler skips it. Where the layout says either
-- is text (shell, where `cd dir\r` names another directory, and a language
-- with no grammar), it stays, drawn as the escape every other hazard is.
layoutLine : Layout -> Int -> String -> String
layoutLine layout n line =
    withoutLineEnd layout (withoutLeadingMark layout n line)


withoutLineEnd : Layout -> String -> String
withoutLineEnd layout line =
    if endsWithLayoutCr layout line then
        String.dropRight 1 line

    else
        line


withoutLeadingMark : Layout -> Int -> String -> String
withoutLeadingMark layout n line =
    if startsWithLayoutMark layout n line then
        String.dropLeft 1 line

    else
        line


endsWithLayoutCr : Layout -> String -> Bool
endsWithLayoutCr layout line =
    crlfIsLineBreak layout.lineEnds && String.endsWith "\r" line


startsWithLayoutMark : Layout -> Int -> String -> Bool
startsWithLayoutMark layout n line =
    n == 1 && skipsLeadingMark layout.leadingMark && String.startsWith byteOrderMark line


byteOrderMark : String
byteOrderMark =
    String.fromChar (Char.fromCode 65279)


skipsLeadingMark : LeadingMark -> Bool
skipsLeadingMark mark =
    case mark of
        MarkSkipped ->
            True

        MarkIsText ->
            False


crlfIsLineBreak : LineEnds -> Bool
crlfIsLineBreak ends =
    case ends of
        CrlfIsOneBreak ->
            True

        CrIsText ->
            False


-- One source line as a single run of inline text, so it copies as the
-- source spells it: each token an inline span in its color, its text drawn
-- through the untrusted-text sink, and each tab drawn as the tab it is.
lineHtml : List Token -> Html.Html msg
lineHtml toks =
    Html.span [ Attr.style "white-space:pre" ] (List.map tokenHtml toks)


tokenHtml : Token -> Html.Html msg
tokenHtml tok =
    Html.span [ Attr.style (tokenCss tok) ] (List.intersperse (Html.text "\t") (List.map safeTextHtml (Highlight.tokenRuns tok)))


tokenCss : Token -> String
tokenCss tok =
    case tok of
        Keyword _ ->
            "color:#c792ea"

        Str _ ->
            "color:#98c379"

        Comment _ ->
            "color:#6e6e7d"

        Num _ ->
            "color:#d19a66"

        Ident _ ->
            "color:#cdcdd7"

        Plain _ ->
            "color:#cdcdd7"
