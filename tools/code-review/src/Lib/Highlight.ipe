module Lib.Highlight exposing (Carry, Lang(..), Token(..), langFor, lexLine, lineStart, tokenRuns, tokenText, tokenize)

import Ipe.Char as Char
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.String as String
import Lib.SafeText as SafeText exposing (SafeText)


-- Server-side syntax highlighting, Ipê-native: a small hand-rolled tokenizer
-- (no lexer, no JS). Coarser than Prism but readable for review display; the
-- custom-element upgrade is a drop-in for the same render slot.
type Lang
    = Rust
    | Shell
    | Ipe
    | Unknown


type Token
    = Keyword String
    | Str String
    | Comment String
    | Num String
    | Ident String
    | Plain String


-- The highlighting language of a file, from the language ipe-index stores
-- in `files.lang`: one arm per stored value, plus one for text outside that
-- vocabulary. A language this tokenizer has no rules for is `Unknown`.
langFor : String -> Lang
langFor stored =
    case stored of
        "rs" ->
            Rust

        "sh" ->
            Shell

        "ipe" ->
            Ipe

        "ts" ->
            Unknown

        "other" ->
            Unknown

        _ ->
            Unknown


-- A token's text as it may be shown: every display hazard (`SafeText.isHazard`)
-- is spelled as a visible escape, so a source line cannot render reordered
-- (Trojan Source) or hide a code point that draws as nothing. `\` and `"` stay
-- as the source wrote them.
tokenText : Token -> SafeText
tokenText tok =
    SafeText.renderForeign (tokenSource tok)


-- A token's text cut at each tab, each piece as `tokenText` shows it. A tab
-- is layout, which a source view draws as a tab between the pieces; every
-- other hazard stays an escape.
tokenRuns : Token -> List SafeText
tokenRuns tok =
    List.map SafeText.renderForeign (String.split "\t" (tokenSource tok))


tokenSource : Token -> String
tokenSource tok =
    case tok of
        Keyword s ->
            s

        Str s ->
            s

        Comment s ->
            s

        Num s ->
            s

        Ident s ->
            s

        Plain s ->
            s


-- One language's lexical grammar: the comment, string and escape forms its
-- source has. The lexer reads only this record, so a delimiter opens
-- something only in a language whose grammar names it: `/*` is plain text
-- in shell and Ipê, `#` in Rust and Ipê, `--` in Rust and shell.
type alias Grammar =
    { lineComment : LineComment
    , blockComment : Maybe BlockRule
    , doubleQuote : DoubleQuote
    , singleQuote : SingleQuote
    , rawStrings : RawStrings
    , bareEscape : BareEscape
    , heredocs : Heredocs
    , words : Words
    }


-- How a line comment opens: a two-character opener (`//`, `--`), or a `#`
-- at the start of a shell word.
type LineComment
    = PairOpens Char Char
    | HashAtWordStart


-- A block comment's delimiters, character by character. Block comments
-- nest; a block opened with the `doc` marker right after its opener is a
-- doc comment, which does not nest (Ipê `{-| -}`).
type alias BlockRule =
    { open1 : Char
    , open2 : Char
    , close1 : Char
    , close2 : Char
    , doc : Maybe Char
    }


-- What a `"` opens: a string with `\` escapes that may span lines (Rust,
-- shell), or one that ends with its line unless it is a `"""…"""` (Ipê).
type DoubleQuote
    = EscapedSpanningLines
    | EscapedOneLineOrTriple


-- What a `'` opens: a char literal (a `'` that closes none is punctuation),
-- or a shell string with no escapes that may span lines.
type SingleQuote
    = CharLiteral
    | VerbatimSpanningLines


-- Whether `r"…"`, `r#"…"#` and their `br`/`cr` forms are raw strings.
type RawStrings
    = NoRawStrings
    | HashRawStrings


-- Whether a `\` outside any string escapes the next character (shell).
type BareEscape
    = NoBareEscape
    | BackslashEscapesNext


-- Whether a `<<` operator starts a heredoc whose body ends at its delimiter
-- line (shell).
type Heredocs
    = NoHeredocs
    | ShellHeredocs


-- Which keyword list a language's words are checked against.
type Words
    = RustWords
    | ShellWords
    | IpeWords


-- The grammar of each language this tokenizer reads; `Unknown` has none,
-- so its text is one Plain token.
grammar : Lang -> Maybe Grammar
grammar lang =
    case lang of
        Rust ->
            Just rustGrammar

        Shell ->
            Just shellGrammar

        Ipe ->
            Just ipeGrammar

        Unknown ->
            Nothing


-- Rust: `//` line and nested `/* */` block comments, `"…"` strings with `\`
-- escapes, `r"…"` and `r#"…"#` raw strings (`br`, `cr` too), `'c'` char
-- literals (a `'` that closes no char literal, as in a lifetime, is
-- punctuation).
rustGrammar : Grammar
rustGrammar =
    { lineComment = PairOpens '/' '/'
    , blockComment = Just { open1 = '/', open2 = '*', close1 = '*', close2 = '/', doc = Nothing }
    , doubleQuote = EscapedSpanningLines
    , singleQuote = CharLiteral
    , rawStrings = HashRawStrings
    , bareEscape = NoBareEscape
    , heredocs = NoHeredocs
    , words = RustWords
    }


-- Shell: a `#` at the start of a word begins a line comment, `'…'` strings
-- without escapes, `"…"` strings with `\` escapes, a `\` escaping the next
-- character, heredocs. Shell has no block comment.
shellGrammar : Grammar
shellGrammar =
    { lineComment = HashAtWordStart
    , blockComment = Nothing
    , doubleQuote = EscapedSpanningLines
    , singleQuote = VerbatimSpanningLines
    , rawStrings = NoRawStrings
    , bareEscape = BackslashEscapesNext
    , heredocs = ShellHeredocs
    , words = ShellWords
    }


-- Ipê: `--` line and nested `{- -}` block comments (a `{-|` doc comment
-- does not nest), `"…"` strings with `\` escapes on one line, `"""…"""`
-- strings, `'c'` char literals.
ipeGrammar : Grammar
ipeGrammar =
    { lineComment = PairOpens '-' '-'
    , blockComment = Just { open1 = '{', open2 = '-', close1 = '-', close2 = '}', doc = Just '|' }
    , doubleQuote = EscapedOneLineOrTriple
    , singleQuote = CharLiteral
    , rawStrings = NoRawStrings
    , bareEscape = NoBareEscape
    , heredocs = NoHeredocs
    , words = IpeWords
    }


-- Tokens a whole source snippet, newlines as `Plain "\n"`. Each line is lexed
-- with the carry out of the line before it, and a lexeme still open at the
-- end of the input degrades to Plain: it claims no color the source does not
-- have. A language with no grammar degrades to a single Plain token:
-- readable, never panics, and no color claims the code does not have.
tokenize : Lang -> String -> List Token
tokenize lang text =
    case grammar lang of
        Nothing ->
            [ Plain text ]

        Just g ->
            case List.foldl (tokenizeStep g) ( lineStart, [], Nothing ) (String.split "\n" text) of
                ( carry, toks, Just last ) ->
                    toks ++ finish g (openLine g carry last)

                ( _, toks, Nothing ) ->
                    toks


-- ( the carry into the held line, the tokens before it, the line read last ):
-- a line is lexed once the next one shows it is not the last.
tokenizeStep : Grammar -> String -> ( Carry, List Token, Maybe String ) -> ( Carry, List Token, Maybe String )
tokenizeStep g line ( carry, toks, held ) =
    case held of
        Nothing ->
            ( carry, toks, Just line )

        Just previous ->
            case lexWith g carry previous of
                ( lineToks, next ) ->
                    ( next, toks ++ lineToks ++ [ Plain "\n" ], Just line )


-- What a source line starts inside: the lexeme open where the line before it
-- ended (a block comment, a string that may span lines, or none), or the
-- body of a shell heredoc, which ends at the line that is its delimiter
-- (after leading tabs, for `<<-`).
type Carry
    = Carry Lexing
    | Heredoc String Bool


-- The carry of a first line, and of a line after a gap in the source.
lineStart : Carry
lineStart =
    Carry (Start AfterSpace)


-- The tokens of one source line (no `\n` in it) and the carry into the line
-- after it. Linear in the line: each character is read once, and a lexeme
-- open at the line's end closes as a piece of its own kind. A heredoc body
-- line is lexed afresh, as the shell code such a body often is, so a quote
-- in it (`don't`) opens nothing past its line.
lexLine : Lang -> Carry -> String -> ( List Token, Carry )
lexLine lang carry line =
    case grammar lang of
        Nothing ->
            ( [ Plain line ], carry )

        Just g ->
            lexWith g carry line


lexWith : Grammar -> Carry -> String -> ( List Token, Carry )
lexWith g carry line =
    case endLine g (openLine g carry line) of
        ( toks, carried ) ->
            ( toks, carryAfter g carry line toks carried )


-- A line read to its end, its last lexeme still open.
openLine : Grammar -> Carry -> String -> Lexer
openLine g carry line =
    case carry of
        Carry lexing ->
            String.foldl (step g) ( lexing, "", [] ) line

        Heredoc _ _ ->
            String.foldl (step g) ( Start AfterSpace, "", [] ) line


carryAfter : Grammar -> Carry -> String -> List Token -> Lexing -> Carry
carryAfter g carry line toks carried =
    case carry of
        Heredoc delimiter stripTabs ->
            if closesHeredoc delimiter stripTabs line then
                lineStart

            else
                Heredoc delimiter stripTabs

        Carry _ ->
            case g.heredocs of
                ShellHeredocs ->
                    case heredocOf toks of
                        Just ( delimiter, stripTabs ) ->
                            Heredoc delimiter stripTabs

                        Nothing ->
                            Carry carried

                NoHeredocs ->
                    Carry carried


closesHeredoc : String -> Bool -> String -> Bool
closesHeredoc delimiter stripTabs line =
    line
        == delimiter
        || (stripTabs
            && String.endsWith delimiter line
            && String.all (\c -> c == tabChar) (String.dropRight (String.length delimiter) line)
        )


-- Where the scan of a shell line for a heredoc operator is: before one,
-- after `<` or `<<` (`True` once `<<-`), in the blanks after the operator,
-- in its delimiter word, or past a delimiter the word's end confirmed. The
-- first heredoc on a line is the one read.
type HereScan
    = Seeking
    | OneLt
    | TwoLt Bool
    | HereGap Bool
    | HereWord String Bool
    | HereFound String Bool


-- What a token is to a heredoc delimiter word: text the word reads as (its
-- quotes and `\` escapes removed), the end of the word, or a token no
-- delimiter can hold (an unclosed or escaped quote), which drops the scan.
type HerePiece
    = Adds String
    | EndsWord
    | NoWord


heredocOf : List Token -> Maybe ( String, Bool )
heredocOf toks =
    case List.foldl hereStep Seeking toks of
        HereFound delimiter stripTabs ->
            Just ( delimiter, stripTabs )

        HereWord delimiter stripTabs ->
            Just ( delimiter, stripTabs )

        Seeking ->
            Nothing

        OneLt ->
            Nothing

        TwoLt _ ->
            Nothing

        HereGap _ ->
            Nothing


hereStep : Token -> HereScan -> HereScan
hereStep tok scan =
    case scan of
        Seeking ->
            if plainIs "<" tok then
                OneLt

            else
                Seeking

        OneLt ->
            if plainIs "<" tok then
                TwoLt False

            else
                Seeking

        TwoLt stripTabs ->
            if plainIs "<" tok then
                Seeking

            else if plainIs "-" tok && not stripTabs then
                TwoLt True

            else
                delimiterStart stripTabs tok

        HereGap stripTabs ->
            delimiterStart stripTabs tok

        HereWord delimiter stripTabs ->
            case herePiece tok of
                Adds more ->
                    HereWord (String.append delimiter more) stripTabs

                EndsWord ->
                    HereFound delimiter stripTabs

                NoWord ->
                    Seeking

        HereFound delimiter stripTabs ->
            HereFound delimiter stripTabs


delimiterStart : Bool -> Token -> HereScan
delimiterStart stripTabs tok =
    if plainIs " " tok || plainIs "\t" tok then
        HereGap stripTabs

    else
        case herePiece tok of
            Adds first ->
                HereWord first stripTabs

            EndsWord ->
                Seeking

            NoWord ->
                Seeking


herePiece : Token -> HerePiece
herePiece tok =
    case tok of
        Ident s ->
            Adds s

        Keyword s ->
            Adds s

        Num s ->
            Adds s

        Str s ->
            quotedPiece s

        Comment _ ->
            EndsWord

        Plain s ->
            if List.member s [ " ", "\t", ";", "|", "&", "(", ")", "<", ">" ] then
                EndsWord

            else if String.startsWith "\\" s then
                Adds (String.dropLeft 1 s)

            else
                Adds s


-- A closed `'…'` string reads as its inside; a closed `"…"` one too when it
-- holds no `\`. Anything else is no delimiter.
quotedPiece : String -> HerePiece
quotedPiece s =
    if String.length s < 2 then
        NoWord

    else if String.startsWith "'" s && String.endsWith "'" s then
        Adds (String.dropRight 1 (String.dropLeft 1 s))

    else if String.startsWith "\"" s && String.endsWith "\"" s && not (String.contains "\\" s) then
        Adds (String.dropRight 1 (String.dropLeft 1 s))

    else
        NoWord


plainIs : String -> Token -> Bool
plainIs text tok =
    case tok of
        Plain s ->
            s == text

        Keyword _ ->
            False

        Str _ ->
            False

        Comment _ ->
            False

        Num _ ->
            False

        Ident _ ->
            False


-- What came before a shell `#`: a `#` starts a comment only at the start of a
-- word.
type Gap
    = AfterSpace
    | AfterText


-- The lexeme the tokenizer is inside, from the characters read so far.
-- One state per partial token, so each character is read exactly once and
-- the run is linear in the source length. Which states a language reaches is
-- its `Grammar`; a block-comment state holds the rule it was opened by, so
-- its delimiters are always that language's.
--
-- No string state reaches a comment state, so no string is drawn as a
-- comment, on any of its lines.
type Lexing
    = Start Gap
    | InNum
    | InWord
    | InRawPrefix
    | InStr
    | InStrEscape
    | InSingle
    | ShellEscape
    | Pending Char
    | InLineComment
    | BlockFresh BlockRule
    | InBlock BlockRule Int
    | BlockOpen1 BlockRule Int
    | BlockClose1 BlockRule Int
    | InDoc BlockRule
    | DocClose1 BlockRule
    | RawHashes Int
    | InRaw Int
    | RawClosing Int Int
    | Quote1
    | Quote2
    | InTriple Int
    | Tick
    | TickChar Char
    | TickEscape
    | TickEscaped


-- ( lexing state, the open lexeme's text, the tokens closed so far ).
type alias Lexer =
    ( Lexing, String, List Token )


step : Grammar -> Char -> Lexer -> Lexer
step g c ( lexing, buf, toks ) =
    case lexing of
        Start gap ->
            begin g gap c toks

        InNum ->
            if isNumChar c then
                ( InNum, extend buf c, toks )

            else
                begin g AfterText c (toks ++ [ Num buf ])

        InWord ->
            if rawPrefixed g buf c then
                ( InRawPrefix, extend buf c, toks )

            else if isWordChar c then
                ( InWord, extend buf c, toks )

            else
                begin g AfterText c (toks ++ [ word g buf ])

        InRawPrefix ->
            if c == '"' then
                ( InRaw 0, extend buf c, toks )

            else if c == '#' then
                ( RawHashes 1, extend buf c, toks )

            else if isWordChar c then
                ( InWord, extend buf c, toks )

            else
                begin g AfterText c (toks ++ [ word g buf ])

        InStr ->
            if c == '"' then
                ( Start AfterText, "", toks ++ [ Str (extend buf c) ] )

            else if c == backslashChar then
                ( InStrEscape, extend buf c, toks )

            else
                ( InStr, extend buf c, toks )

        InStrEscape ->
            ( InStr, extend buf c, toks )

        InSingle ->
            if c == tickChar then
                ( Start AfterText, "", toks ++ [ Str (extend buf c) ] )

            else
                ( InSingle, extend buf c, toks )

        ShellEscape ->
            ( Start AfterText, "", toks ++ [ Plain (extend buf c) ] )

        Pending first ->
            opened g first c buf toks

        InLineComment ->
            ( InLineComment, extend buf c, toks )

        BlockFresh rule ->
            if rule.doc == Just c then
                ( InDoc rule, extend buf c, toks )

            else
                inBlock rule 1 c buf toks

        InBlock rule depth ->
            inBlock rule depth c buf toks

        BlockOpen1 rule depth ->
            if c == rule.open2 then
                ( InBlock rule (depth + 1), extend buf c, toks )

            else
                inBlock rule depth c buf toks

        BlockClose1 rule depth ->
            if c == rule.close2 then
                if depth <= 1 then
                    ( Start AfterText, "", toks ++ [ Comment (extend buf c) ] )

                else
                    ( InBlock rule (depth - 1), extend buf c, toks )

            else
                inBlock rule depth c buf toks

        InDoc rule ->
            if c == rule.close1 then
                ( DocClose1 rule, extend buf c, toks )

            else
                ( InDoc rule, extend buf c, toks )

        DocClose1 rule ->
            if c == rule.close2 then
                ( Start AfterText, "", toks ++ [ Comment (extend buf c) ] )

            else if c == rule.close1 then
                ( DocClose1 rule, extend buf c, toks )

            else
                ( InDoc rule, extend buf c, toks )

        RawHashes hashes ->
            if c == '#' then
                ( RawHashes (hashes + 1), extend buf c, toks )

            else if c == '"' then
                ( InRaw hashes, extend buf c, toks )

            else
                begin g AfterText c (toks ++ [ Plain buf ])

        InRaw hashes ->
            if c == '"' then
                if hashes == 0 then
                    ( Start AfterText, "", toks ++ [ Str (extend buf c) ] )

                else
                    ( RawClosing hashes 0, extend buf c, toks )

            else
                ( InRaw hashes, extend buf c, toks )

        RawClosing hashes seen ->
            if c == '#' then
                if seen + 1 >= hashes then
                    ( Start AfterText, "", toks ++ [ Str (extend buf c) ] )

                else
                    ( RawClosing hashes (seen + 1), extend buf c, toks )

            else if c == '"' then
                ( RawClosing hashes 0, extend buf c, toks )

            else
                ( InRaw hashes, extend buf c, toks )

        Quote1 ->
            if c == '"' then
                ( Quote2, extend buf c, toks )

            else if c == backslashChar then
                ( InStrEscape, extend buf c, toks )

            else
                ( InStr, extend buf c, toks )

        Quote2 ->
            if c == '"' then
                ( InTriple 0, extend buf c, toks )

            else
                begin g AfterText c (toks ++ [ Str buf ])

        InTriple quotes ->
            if c == '"' then
                if quotes >= 2 then
                    ( Start AfterText, "", toks ++ [ Str (extend buf c) ] )

                else
                    ( InTriple (quotes + 1), extend buf c, toks )

            else
                ( InTriple 0, extend buf c, toks )

        Tick ->
            if c == backslashChar then
                ( TickEscape, extend buf c, toks )

            else if c == tickChar then
                ( Start AfterText, "", toks ++ [ Plain (extend buf c) ] )

            else
                ( TickChar c, extend buf c, toks )

        TickChar first ->
            if c == tickChar then
                ( Start AfterText, "", toks ++ [ Str (extend buf c) ] )

            else
                step g c (begin g AfterText first (toks ++ [ Plain "'" ]))

        TickEscape ->
            ( TickEscaped, extend buf c, toks )

        TickEscaped ->
            if c == tickChar then
                ( Start AfterText, "", toks ++ [ Str (extend buf c) ] )

            else
                ( TickEscaped, extend buf c, toks )


-- The state after reading `c` with no lexeme open; `gap` is what came
-- before it.
begin : Grammar -> Gap -> Char -> List Token -> Lexer
begin g gap c toks =
    if Char.isDigit c then
        ( InNum, String.fromChar c, toks )

    else if c == '"' then
        ( stringStart g.doubleQuote, "\"", toks )

    else if c == tickChar then
        ( tickStart g.singleQuote, "'", toks )

    else if opensPair g c then
        ( Pending c, String.fromChar c, toks )

    else if hashComment g.lineComment gap c then
        ( InLineComment, "#", toks )

    else if bareEscapes g.bareEscape c then
        ( ShellEscape, String.fromChar c, toks )

    else if rawOpens g.rawStrings c then
        ( InRawPrefix, "r", toks )

    else if isWordStart c then
        ( InWord, String.fromChar c, toks )

    else
        ( Start (gapAfter c), "", toks ++ [ Plain (String.fromChar c) ] )


stringStart : DoubleQuote -> Lexing
stringStart quote =
    case quote of
        EscapedOneLineOrTriple ->
            Quote1

        EscapedSpanningLines ->
            InStr


tickStart : SingleQuote -> Lexing
tickStart quote =
    case quote of
        VerbatimSpanningLines ->
            InSingle

        CharLiteral ->
            Tick


-- `c` is the first character of a two-character comment opener of the
-- grammar: a pair line-comment opener's, or its block opener's.
opensPair : Grammar -> Char -> Bool
opensPair g c =
    pairLineFirst g.lineComment c || blockFirst g.blockComment c


pairLineFirst : LineComment -> Char -> Bool
pairLineFirst line c =
    case line of
        PairOpens first _ ->
            c == first

        HashAtWordStart ->
            False


blockFirst : Maybe BlockRule -> Char -> Bool
blockFirst block c =
    case block of
        Just rule ->
            c == rule.open1

        Nothing ->
            False


hashComment : LineComment -> Gap -> Char -> Bool
hashComment line gap c =
    case line of
        HashAtWordStart ->
            c == '#' && gap == AfterSpace

        PairOpens _ _ ->
            False


bareEscapes : BareEscape -> Char -> Bool
bareEscapes escape c =
    case escape of
        BackslashEscapesNext ->
            c == backslashChar

        NoBareEscape ->
            False


rawOpens : RawStrings -> Char -> Bool
rawOpens raw c =
    case raw of
        HashRawStrings ->
            c == 'r'

        NoRawStrings ->
            False


-- A word `b` or `c` followed by `r` begins a `br`/`cr` raw string prefix.
rawPrefixed : Grammar -> String -> Char -> Bool
rawPrefixed g buf c =
    case g.rawStrings of
        HashRawStrings ->
            c == 'r' && (buf == "b" || buf == "c")

        NoRawStrings ->
            False


-- The lexeme a two-character opener starts, or the pending character as
-- punctuation when `c` completes no opener of the grammar.
opened : Grammar -> Char -> Char -> String -> List Token -> Lexer
opened g first c buf toks =
    if pairLineOpens g.lineComment first c then
        ( InLineComment, extend buf c, toks )

    else
        case blockOpened g.blockComment first c of
            Just entered ->
                ( entered, extend buf c, toks )

            Nothing ->
                begin g AfterText c (toks ++ [ Plain buf ])


pairLineOpens : LineComment -> Char -> Char -> Bool
pairLineOpens line first c =
    case line of
        PairOpens one two ->
            first == one && c == two

        HashAtWordStart ->
            False


-- The state a block opener `first c` enters: a fresh block when the rule has
-- a doc marker that may follow, else the body one deep.
blockOpened : Maybe BlockRule -> Char -> Char -> Maybe Lexing
blockOpened block first c =
    case block of
        Just rule ->
            if first == rule.open1 && c == rule.open2 then
                case rule.doc of
                    Just _ ->
                        Just (BlockFresh rule)

                    Nothing ->
                        Just (InBlock rule 1)

            else
                Nothing

        Nothing ->
            Nothing


-- One character inside a block comment `depth` deep: it may begin a nested
-- opener or the closer.
inBlock : BlockRule -> Int -> Char -> String -> List Token -> Lexer
inBlock rule depth c buf toks =
    if c == rule.open1 then
        ( BlockOpen1 rule depth, extend buf c, toks )

    else if c == rule.close1 then
        ( BlockClose1 rule depth, extend buf c, toks )

    else
        ( InBlock rule depth, extend buf c, toks )


-- The tokens of a line once its last character is read, and the lexing
-- state the next line starts in. A lexeme that may span lines (a block
-- comment, a Rust or shell string, a raw or triple-quoted string) closes as
-- a piece of its kind and stays open; any other open lexeme closes here.
endLine : Grammar -> Lexer -> ( List Token, Lexing )
endLine g ( lexing, buf, toks ) =
    case lexing of
        Start _ ->
            ( toks, Start AfterSpace )

        InNum ->
            ( toks ++ [ Num buf ], Start AfterSpace )

        InWord ->
            ( toks ++ [ word g buf ], Start AfterSpace )

        InRawPrefix ->
            ( toks ++ [ word g buf ], Start AfterSpace )

        InStr ->
            spanningString g.doubleQuote buf toks

        InStrEscape ->
            spanningString g.doubleQuote buf toks

        InSingle ->
            ( piece (Str buf) toks, InSingle )

        ShellEscape ->
            ( toks ++ [ Plain buf ], Start AfterSpace )

        Pending _ ->
            ( toks ++ [ Plain buf ], Start AfterSpace )

        InLineComment ->
            ( toks ++ [ Comment buf ], Start AfterSpace )

        BlockFresh rule ->
            ( piece (Comment buf) toks, InBlock rule 1 )

        InBlock rule depth ->
            ( piece (Comment buf) toks, InBlock rule depth )

        BlockOpen1 rule depth ->
            ( piece (Comment buf) toks, InBlock rule depth )

        BlockClose1 rule depth ->
            ( piece (Comment buf) toks, InBlock rule depth )

        InDoc rule ->
            ( piece (Comment buf) toks, InDoc rule )

        DocClose1 rule ->
            ( piece (Comment buf) toks, InDoc rule )

        RawHashes _ ->
            ( toks ++ [ Plain buf ], Start AfterSpace )

        InRaw hashes ->
            ( piece (Str buf) toks, InRaw hashes )

        RawClosing hashes _ ->
            ( piece (Str buf) toks, InRaw hashes )

        Quote1 ->
            ( toks ++ [ Plain buf ], Start AfterSpace )

        Quote2 ->
            ( toks ++ [ Str buf ], Start AfterSpace )

        InTriple _ ->
            ( piece (Str buf) toks, InTriple 0 )

        Tick ->
            ( toks ++ [ Plain buf ], Start AfterSpace )

        TickChar _ ->
            ( toks ++ [ Plain buf ], Start AfterSpace )

        TickEscape ->
            ( toks ++ [ Plain buf ], Start AfterSpace )

        TickEscaped ->
            ( toks ++ [ Plain buf ], Start AfterSpace )


-- A `"` string open at a line's end: one that may span lines goes on to the
-- next line; a one-line string ends with its line, unterminated, so it is
-- Plain.
spanningString : DoubleQuote -> String -> List Token -> ( List Token, Lexing )
spanningString quote buf toks =
    case quote of
        EscapedOneLineOrTriple ->
            ( toks ++ [ Plain buf ], Start AfterSpace )

        EscapedSpanningLines ->
            ( piece (Str buf) toks, InStr )


-- `tok` after `toks`, unless it holds no text (a lexeme carried into a line
-- that ends before any of its characters).
piece : Token -> List Token -> List Token
piece tok toks =
    if String.isEmpty (tokenSource tok) then
        toks

    else
        toks ++ [ tok ]


-- Closes the lexeme open at end of input. An unterminated string or block
-- comment degrades to Plain: it claims no color the source does not have.
finish : Grammar -> Lexer -> List Token
finish g ( lexing, buf, toks ) =
    case lexing of
        Start _ ->
            toks

        InNum ->
            toks ++ [ Num buf ]

        InWord ->
            toks ++ [ word g buf ]

        InRawPrefix ->
            toks ++ [ word g buf ]

        InLineComment ->
            toks ++ [ Comment buf ]

        Quote2 ->
            toks ++ [ Str buf ]

        InStr ->
            piece (Plain buf) toks

        InStrEscape ->
            piece (Plain buf) toks

        InSingle ->
            piece (Plain buf) toks

        ShellEscape ->
            piece (Plain buf) toks

        Pending _ ->
            piece (Plain buf) toks

        BlockFresh _ ->
            piece (Plain buf) toks

        InBlock _ _ ->
            piece (Plain buf) toks

        BlockOpen1 _ _ ->
            piece (Plain buf) toks

        BlockClose1 _ _ ->
            piece (Plain buf) toks

        InDoc _ ->
            piece (Plain buf) toks

        DocClose1 _ ->
            piece (Plain buf) toks

        RawHashes _ ->
            piece (Plain buf) toks

        InRaw _ ->
            piece (Plain buf) toks

        RawClosing _ _ ->
            piece (Plain buf) toks

        Quote1 ->
            piece (Plain buf) toks

        InTriple _ ->
            piece (Plain buf) toks

        Tick ->
            piece (Plain buf) toks

        TickChar _ ->
            piece (Plain buf) toks

        TickEscape ->
            piece (Plain buf) toks

        TickEscaped ->
            piece (Plain buf) toks


word : Grammar -> String -> Token
word g w =
    if List.member w (keywords g.words) then
        Keyword w

    else
        Ident w


extend : String -> Char -> String
extend buf c =
    String.append buf (String.fromChar c)


-- The shell gap after a punctuation character: whitespace and the
-- characters that end a shell word leave the next `#` at a word start.
gapAfter : Char -> Gap
gapAfter c =
    if List.member c [ ' ', '\t', '\r', ';', '|', '&', '(', ')', '<', '>' ] then
        AfterSpace

    else
        AfterText


-- The backslash character, derived from a string instead of the `'\\'` char
-- literal (the formatter ICEs on that escape today).
backslashChar : Char
backslashChar =
    Maybe.withDefault ' ' (List.head (String.toList "\\"))


-- The tab character, derived from a string like `backslashChar`.
tabChar : Char
tabChar =
    Maybe.withDefault ' ' (List.head (String.toList "\t"))


-- The single-quote character, derived from a string like `backslashChar`.
tickChar : Char
tickChar =
    Maybe.withDefault ' ' (List.head (String.toList "'"))


isWordStart : Char -> Bool
isWordStart c =
    Char.isAlpha c || c == '_'


isWordChar : Char -> Bool
isWordChar c =
    Char.isAlpha c || Char.isDigit c || c == '_'


isNumChar : Char -> Bool
isNumChar c =
    Char.isDigit c || c == '_' || c == '.'


keywords : Words -> List String
keywords words =
    case words of
        RustWords ->
            [ "fn"
            , "let"
            , "mut"
            , "pub"
            , "struct"
            , "enum"
            , "impl"
            , "match"
            , "if"
            , "else"
            , "for"
            , "while"
            , "return"
            , "use"
            , "mod"
            , "type"
            , "trait"
            , "const"
            , "static"
            , "async"
            , "await"
            , "move"
            , "ref"
            , "unsafe"
            , "where"
            , "loop"
            , "break"
            , "continue"
            , "in"
            , "as"
            , "dyn"
            , "crate"
            , "super"
            , "self"
            , "true"
            , "false"
            ]

        ShellWords ->
            [ "if"
            , "then"
            , "else"
            , "elif"
            , "fi"
            , "for"
            , "while"
            , "do"
            , "done"
            , "case"
            , "esac"
            , "in"
            , "function"
            , "echo"
            , "export"
            , "local"
            , "return"
            , "read"
            , "set"
            , "unset"
            , "cd"
            , "pwd"
            , "true"
            , "false"
            , "null"
            ]

        IpeWords ->
            [ "module"
            , "import"
            , "exposing"
            , "type"
            , "alias"
            , "as"
            , "case"
            , "of"
            , "if"
            , "then"
            , "else"
            , "let"
            , "in"
            ]
