module Lib.Highlight exposing (Lang(..), Token(..), langFor, tokenText, tokenize)

import Ipe.Char as Char
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.String as String
import Lib.SafeText as SafeText exposing (SafeText)


-- Server-side syntax highlighting, Ipê-native: a small hand-rolled tokenizer
-- (no lexer, no JS). Coarser than Prism but readable for review display; the
-- custom-element upgrade is a drop-in for the same render slot.
type Lang
    = Rust
    | Shell
    | Ipe
    | Unknown


type Token
    = Keyword String
    | Str String
    | Comment String
    | Num String
    | Ident String
    | Plain String


-- The highlighting language of a file, from the language ipe-index stores
-- in `files.lang`: one arm per stored value, plus one for text outside that
-- vocabulary. A language this tokenizer has no rules for is `Unknown`.
langFor : String -> Lang
langFor stored =
    case stored of
        "rs" ->
            Rust

        "sh" ->
            Shell

        "ipe" ->
            Ipe

        "ts" ->
            Unknown

        "other" ->
            Unknown

        _ ->
            Unknown


-- A token's text as it may be shown: every display hazard (`SafeText.isHazard`)
-- is spelled as a visible escape, so a source line cannot render reordered
-- (Trojan Source) or hide a code point that draws as nothing. `\` and `"` stay
-- as the source wrote them.
tokenText : Token -> SafeText
tokenText tok =
    SafeText.renderForeign (tokenSource tok)


tokenSource : Token -> String
tokenSource tok =
    case tok of
        Keyword s ->
            s

        Str s ->
            s

        Comment s ->
            s

        Num s ->
            s

        Ident s ->
            s

        Plain s ->
            s


-- Tokens a whole source snippet (newlines come through as Plain). Unknown
-- languages degrade to a single Plain token: readable, never panics, and no
-- color claims the code does not have.
tokenize : Lang -> String -> List Token
tokenize lang text =
    if lang == Unknown then
        [ Plain text ]

    else
        finish lang (String.foldl (step lang) ( Start, "", [] ) text)


-- The lexeme the tokenizer is inside, from the characters read so far.
-- One state per partial token, so each character is read exactly once and
-- the run is linear in the source length.
type Lexing
    = Start
    | InNum
    | InWord
    | InStr
    | InStrEscape
    | AfterSlash
    | InLineComment
    | InBlock
    | InBlockStar


-- ( lexing state, the open lexeme's text, the tokens closed so far ).
type alias Lexer =
    ( Lexing, String, List Token )


step : Lang -> Char -> Lexer -> Lexer
step lang c ( lexing, buf, toks ) =
    case lexing of
        Start ->
            begin c toks

        InNum ->
            if isNumChar c then
                ( InNum, String.append buf (String.fromChar c), toks )

            else
                begin c (toks ++ [ Num buf ])

        InWord ->
            if isWordChar c then
                ( InWord, String.append buf (String.fromChar c), toks )

            else
                begin c (toks ++ [ word lang buf ])

        InStr ->
            if c == '"' then
                ( Start, "", toks ++ [ Str (String.append buf "\"") ] )

            else if c == backslashChar then
                ( InStrEscape, String.append buf (String.fromChar c), toks )

            else
                ( InStr, String.append buf (String.fromChar c), toks )

        InStrEscape ->
            ( InStr, String.append buf (String.fromChar c), toks )

        AfterSlash ->
            if c == '/' then
                ( InLineComment, "//", toks )

            else if c == '*' then
                ( InBlock, "/*", toks )

            else
                begin c (toks ++ [ Plain "/" ])

        InLineComment ->
            if c == '\n' then
                begin c (toks ++ [ Comment buf ])

            else
                ( InLineComment, String.append buf (String.fromChar c), toks )

        InBlock ->
            if c == '*' then
                ( InBlockStar, String.append buf "*", toks )

            else
                ( InBlock, String.append buf (String.fromChar c), toks )

        InBlockStar ->
            if c == '/' then
                ( Start, "", toks ++ [ Comment (String.append buf "/") ] )

            else if c == '*' then
                ( InBlockStar, String.append buf "*", toks )

            else
                ( InBlock, String.append buf (String.fromChar c), toks )


-- The state after reading `c` with no lexeme open.
begin : Char -> List Token -> Lexer
begin c toks =
    if Char.isDigit c then
        ( InNum, String.fromChar c, toks )

    else if c == '"' then
        ( InStr, "\"", toks )

    else if c == '/' then
        ( AfterSlash, "/", toks )

    else if isWordStart c then
        ( InWord, String.fromChar c, toks )

    else
        ( Start, "", toks ++ [ Plain (String.fromChar c) ] )


-- Closes the lexeme open at end of input. An unterminated string or block
-- comment degrades to Plain: it claims no color the source does not have.
finish : Lang -> Lexer -> List Token
finish lang ( lexing, buf, toks ) =
    case lexing of
        Start ->
            toks

        InNum ->
            toks ++ [ Num buf ]

        InWord ->
            toks ++ [ word lang buf ]

        InStr ->
            toks ++ [ Plain buf ]

        InStrEscape ->
            toks ++ [ Plain buf ]

        AfterSlash ->
            toks ++ [ Plain buf ]

        InLineComment ->
            toks ++ [ Comment buf ]

        InBlock ->
            toks ++ [ Plain buf ]

        InBlockStar ->
            toks ++ [ Plain buf ]


word : Lang -> String -> Token
word lang w =
    if List.member w (keywords lang) then
        Keyword w

    else
        Ident w


-- The backslash character, derived from a string instead of the `'\\'` char
-- literal (the formatter ICEs on that escape today).
backslashChar : Char
backslashChar =
    Maybe.withDefault ' ' (List.head (String.toList "\\"))


isWordStart : Char -> Bool
isWordStart c =
    Char.isAlpha c || c == '_'


isWordChar : Char -> Bool
isWordChar c =
    Char.isAlpha c || Char.isDigit c || c == '_'


isNumChar : Char -> Bool
isNumChar c =
    Char.isDigit c || c == '_' || c == '.'


keywords : Lang -> List String
keywords lang =
    case lang of
        Rust ->
            [ "fn"
            , "let"
            , "mut"
            , "pub"
            , "struct"
            , "enum"
            , "impl"
            , "match"
            , "if"
            , "else"
            , "for"
            , "while"
            , "return"
            , "use"
            , "mod"
            , "type"
            , "trait"
            , "const"
            , "static"
            , "async"
            , "await"
            , "move"
            , "ref"
            , "unsafe"
            , "where"
            , "loop"
            , "break"
            , "continue"
            , "in"
            , "as"
            , "dyn"
            , "crate"
            , "super"
            , "self"
            , "true"
            , "false"
            ]

        Shell ->
            [ "if"
            , "then"
            , "else"
            , "elif"
            , "fi"
            , "for"
            , "while"
            , "do"
            , "done"
            , "case"
            , "esac"
            , "in"
            , "function"
            , "echo"
            , "export"
            , "local"
            , "return"
            , "read"
            , "set"
            , "unset"
            , "cd"
            , "pwd"
            , "true"
            , "false"
            , "null"
            ]

        Ipe ->
            [ "module"
            , "import"
            , "exposing"
            , "type"
            , "alias"
            , "as"
            , "case"
            , "of"
            , "if"
            , "then"
            , "else"
            , "let"
            , "in"
            ]

        Unknown ->
            []
