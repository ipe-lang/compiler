module Lib.Db exposing (Decision(..), HistoryCursor(..), HistoryRows, LogRow, Reason, ReviewEntry(..), StoredDecision(..), StoredReason, Unverified(..), UnverifiedRow, VerifiedRow, Verifier, advanceHead, checkChainWithin, countedRows, currentHead, findDecision, findLatestForUid, historyPage, historyPlan, insertDecision, lastSeq, logPageCeiling, logRowsAfter, openAt, parseReason, probe, reasonMaxChars, reasonText, storedReasonText, verifiedAt, verifiedDecision, verifiedHash, verifiedPair, verifiedUid, verifier)

import Ipe.Codec as Codec exposing (Codec(..), ColType(..), Shape(..))
import Ipe.Config as Config
import Ipe.Crypto as Crypto
import Ipe.Db as Db
import Ipe.Db.Decode
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error as Error
import Ipe.Json.Encode as Encode
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task
import Ipe.Time as Time
import Ipe.Time.Timestamp as Timestamp exposing (Timestamp)
import Lib.Index as Index exposing (Attested, ChainVerdict(..), DecidedPair, LogStatus(..))
import Lib.PageSize as PageSize exposing (PageSize)
import Lib.ReviewKey as ReviewKey exposing (MacKey, ReviewKey(..))
import Lib.SafeText as SafeText exposing (SafeText)
import Lib.Settings as Settings exposing (DbLocation, DbRole(..))
import Lib.Uid as Uid exposing (Uid)
import Migrations exposing (all)


type Decision
    = Approved
    | Refused Reason


-- Why a unit was refused: non-blank and at most `reasonMaxChars` characters.
-- Opaque: built only by `parseReason`, the one decode point for the
-- reviewer's text and for a stored reason, so an empty or unbounded reason
-- has no representation. It is shown only through `reasonText`.
type Reason
    = Reason String


-- The longest refusal reason, in characters.
reasonMaxChars : Int
reasonMaxChars =
    500


-- The reviewer's text as a `Reason`, or why it is not one.
parseReason : String -> Result Error Reason
parseReason raw =
    case storedReason raw of
        Valid reason ->
            Ok reason

        Blank _ ->
            Err (Error.invalidInput "a refusal needs a reason")

        Overlong text ->
            Err (Error.invalidInput ("a refusal reason is at most " ++ String.fromInt reasonMaxChars ++ " characters; this one has " ++ String.fromInt (String.length text)))


-- A refusal's reason as the review table holds it. A row written before the
-- reason bound, or edited outside this tool, may hold a reason that is not a
-- `Reason`; it is read as `Overlong` or `Blank`, so no stored reason fails a
-- read and its text is never shown. Opaque: built only by `storedReason`, the one classification of a
-- reason's text, and shown only through `storedReasonText`.
type StoredReason
    = Valid Reason
    | Overlong String
    | Blank String


storedReason : String -> StoredReason
storedReason raw =
    if String.isEmpty (String.trim raw) then
        Blank raw

    else if String.length raw > reasonMaxChars then
        Overlong raw

    else
        Valid (Reason raw)


-- A stored reason as it may be shown: a valid one through `reasonText`, an
-- over-long one by its length only, a blank one as a note.
storedReasonText : StoredReason -> SafeText
storedReasonText stored =
    case stored of
        Valid reason ->
            reasonText reason

        Overlong text ->
            SafeText.concat
                [ SafeText.literal "reason not shown: "
                , SafeText.render (String.fromInt (String.length text))
                , SafeText.literal " characters, over the "
                , SafeText.render (String.fromInt reasonMaxChars)
                , SafeText.literal "-character limit"
                ]

        Blank _ ->
            SafeText.literal "reason not shown: it is blank"


-- A reason as it may be shown, with every control and bidi character escaped.
reasonText : Reason -> SafeText
reasonText reason =
    SafeText.renderForeign (reasonString reason)


reasonString : Reason -> String
reasonString reason =
    case reason of
        Reason r ->
            r


-- A decision as a review row holds it. A refusal carries its stored
-- reason; there is no third form, so a row whose decision column is neither
-- `approve` nor `refuse` is never read as either.
type StoredDecision
    = StoredApproved
    | StoredRefused StoredReason


-- A review-log row whose mac verifies under the operator's key, on a chain
-- that is unbroken through the log's head: the one form of a row that holds
-- a decision, and the only one that counts as decided. Opaque: built only by
-- `entryOf`, so no row is counted without its mac verifying.
type VerifiedRow
    = VerifiedRow { seq : Int, pair : DecidedPair, uid : Uid, bodyHash : String, decision : StoredDecision, reviewedAt : Timestamp }


-- Why a row is not counted: its mac does not verify (`Tampered`); it was
-- recorded in the unsigned `review` table (`Legacy`); this server has no key
-- to verify it (`NoKey`); or the log's chain breaks, so no row of it counts
-- (`ChainBroken`).
type Unverified
    = Tampered
    | Legacy
    | NoKey
    | ChainBroken


-- A row that is not counted: what it names and when, never a decision.
type alias UnverifiedRow =
    { uid : Uid
    , bodyHash : String
    , reviewedAt : Timestamp
    , why : Unverified
    }


-- A review row as every reader returns it. Only `Verified` holds a
-- decision, so code that has not verified a row has none to read.
type ReviewEntry
    = Verified VerifiedRow
    | Unverified UnverifiedRow


verifiedUid : VerifiedRow -> Uid
verifiedUid row =
    case row of
        VerifiedRow r ->
            r.uid


verifiedHash : VerifiedRow -> String
verifiedHash row =
    case row of
        VerifiedRow r ->
            r.bodyHash


verifiedDecision : VerifiedRow -> StoredDecision
verifiedDecision row =
    case row of
        VerifiedRow r ->
            r.decision


verifiedAt : VerifiedRow -> Timestamp
verifiedAt row =
    case row of
        VerifiedRow r ->
            r.reviewedAt


-- The decided pair a verified row names, the one input a refill drains.
verifiedPair : VerifiedRow -> DecidedPair
verifiedPair row =
    case row of
        VerifiedRow r ->
            r.pair


-- How a reader treats the log's rows: verifying each under the key on an
-- unbroken chain (`Counting`), under the key on a broken chain, where a row
-- that verifies still does not count (`Broken`), or with no key, where none
-- counts (`Keyless`). Opaque: built only by `verifier`.
type Verifier
    = Counting MacKey
    | Broken MacKey
    | Keyless


-- The verifier for a server's key and the status the `reviewed` copy was
-- rebuilt under. A key with an unsigned status counts nothing: no copy
-- `stampStatus` accepts has that pairing, and the branch fails closed.
verifier : ReviewKey -> LogStatus -> Verifier
verifier key status =
    case key of
        ReadOnly ->
            Keyless

        Signing macKey ->
            case status of
                Signed Intact ->
                    Counting macKey

                Signed (BrokenAt _) ->
                    Broken macKey

                Unsigned ->
                    Broken macKey


-- One row of the legacy `review` table, parsed. Built only by `fromRecord`;
-- read only to be shown as `Unverified Legacy`, so its decision never
-- counts and is never shown.
type alias LegacyRow =
    { uid : Uid
    , bodyHash : String
    , decision : StoredDecision
    , reviewedAt : Timestamp
    }


-- One row of the legacy `review` table, recorded before rows were signed,
-- as its columns hold it: the store's codec shape, read only through
-- `fromRecord`.
type alias ReviewRecord =
    { uid : String
    , bodyHash : String
    , decision : String
    , reason : Maybe String
    , reviewedAt : Timestamp
    }


makeRecord : String -> String -> String -> Maybe String -> Timestamp -> ReviewRecord
makeRecord uid bodyHash decision reason reviewedAt =
    { uid = uid
    , bodyHash = bodyHash
    , decision = decision
    , reason = reason
    , reviewedAt = reviewedAt
    }


-- The one parser of a stored row. The uid must be a unit id and the
-- decision `approve` or `refuse`; any other row fails, naming the row by its
-- uid and never echoing the column text. A refusal's reason is classified by
-- `storedReason`, a NULL one as blank, so a row breaking the reason bound
-- still reads; an approval's reason column is never read.
fromRecord : ReviewRecord -> Result Error LegacyRow
fromRecord record =
    case Uid.parse record.uid of
        Err _ ->
            Err (Error.unexpected "a review row holds a uid that is not a unit id")

        Ok uid ->
            Result.map
                (\decision -> { uid = uid, bodyHash = record.bodyHash, decision = decision, reviewedAt = record.reviewedAt })
                (storedDecision uid record)


storedDecision : Uid -> ReviewRecord -> Result Error StoredDecision
storedDecision uid record =
    if record.decision == "approve" then
        Ok StoredApproved

    else if record.decision == "refuse" then
        Ok (StoredRefused (storedReason (Maybe.withDefault "" record.reason)))

    else
        Err (Error.unexpected ("review row " ++ Uid.toString uid ++ " holds a decision this reviewer does not know"))


-- A store read's row, parsed.
fromMaybeRecord : Maybe ReviewRecord -> Task.Task Error (Maybe LegacyRow)
fromMaybeRecord found =
    case found of
        Nothing ->
            Task.succeed Nothing

        Just record ->
            Task.fromResult (Result.map Just (fromRecord record))


-- Codec for ReviewRecord. Keys in `SRecord` and JSON object match the DB
-- column names so `Store.fromCodec` derives the correct column list from the
-- shape.
reviewCodec : Codec ReviewRecord
reviewCodec =
    Codec
        { enc = \row ->
            Encode.object
                [ ( "uid", Encode.string row.uid )
                , ( "body_hash", Encode.string row.bodyHash )
                , ( "decision", Encode.string row.decision )
                , ( "reason"
                , case row.reason of
                    Just r ->
                        Encode.string r

                    Nothing ->
                        Encode.null
                )
                , ( "reviewed_at", Codec.toValue Codec.timestamp row.reviewedAt )
                ]
        , mkDec = \_ ->
            Config.map5 makeRecord
                (Config.field "uid" Config.string)
                (Config.field "body_hash" Config.string)
                (Config.field "decision" Config.string)
                (Config.field "reason" (Config.nullable Config.string))
                (Config.field "reviewed_at" (Config.map Timestamp.fromUnixMillis Config.int))
        , shp = SRecord
            [ ( "uid", CText )
            , ( "body_hash", CText )
            , ( "decision", CText )
            , ( "reason", CNull CText )
            , ( "reviewed_at", CTime )
            ]
        }


-- The typed store for the legacy `review` table. `fromCodec` validates every column
-- identifier; the composite key records `PRIMARY KEY (uid, body_hash)`, so the
-- by-key operations fail closed and every access names both key columns. The
-- table itself comes from the hand-written migration, since `createSql` does
-- not render a composite key.
reviewStore : Result Error (Store ReviewRecord)
reviewStore =
    Store.fromCodec "review" reviewCodec
        |> Result.map (\draft -> Store.public (Store.compositePrimaryKey2 .uid .bodyHash draft))


-- A legacy row as every reader shows it: uncounted, with no decision.
legacyEntry : LegacyRow -> ReviewEntry
legacyEntry row =
    Unverified { uid = row.uid, bodyHash = row.bodyHash, reviewedAt = row.reviewedAt, why = Legacy }


-- The startup check of `IPE_REVIEW_DB`: the review database is opened
-- (created when absent) and migrated, its append-only guards are found on
-- the tables they guard, and its log head is read, so an unwritable
-- location, a file whose guards are gone, or one whose head is missing stops
-- the server before it listens, naming the variable, the file and the fix.
-- A driver failure is refused once, through `Settings.openFailure`; a lost
-- guard is its own refusal, since no change of location repairs that log.
probe : DbLocation -> Task.Task Error ()
probe loc =
    do
        db <- openMigrated loc
        requireGuards loc db
        headAt loc db
        Task.succeed ()


openMigrated : DbLocation -> Task.Task Error Db
openMigrated loc =
    openAt loc
        |> Task.andThen (\db -> Task.map (\_ -> db) (migrate db))
        |> Task.onError (Settings.openFailure ReviewDb loc)


headAt : DbLocation -> Db -> Task.Task Error Index.ChainHead
headAt loc db =
    headRows db
        |> Task.onError (Settings.openFailure ReviewDb loc)
        |> Task.andThen (\rows -> Task.mapError (\_ -> Settings.brokenLog loc "its review log has no single head row") (oneHead rows))


-- The triggers that keep the review log append-only, each named with the
-- table it guards. A migrated file can still lose one: a dropped trigger, or
-- the log renamed away and recreated, which carries its triggers to the
-- renamed table.
appendOnlyGuards : List String
appendOnlyGuards =
    [ "review_head_no_delete on review_head"
    , "review_log_head_id_fixed on review_log_head"
    , "review_log_head_no_delete on review_log_head"
    , "review_log_no_delete on review_log"
    , "review_log_no_replace on review_log"
    , "review_log_no_update on review_log"
    , "review_no_delete on review"
    , "review_no_replace on review"
    , "review_no_update on review"
    ]


guardDecoder : Db.Decode.Decoder String
guardDecoder =
    Db.Decode.succeed (\entry -> entry)
        |> Db.Decode.required "guard" (Db.Decode.string "guard")


-- Every guard in `appendOnlyGuards` is present on its table; a file missing
-- one is refused, since its review rows could be rewritten unseen. The MAC
-- on every review-log row is the second, independent layer.
requireGuards : DbLocation -> Db -> Task.Task Error ()
requireGuards loc db =
    do
        present <- presentGuards loc db
        if List.all (\entry -> List.member entry present) appendOnlyGuards then
            Task.succeed ()

        else
            Task.fail (Settings.brokenLog loc "its review log has lost an append-only trigger, so its decisions could be rewritten unseen")


presentGuards : DbLocation -> Db -> Task.Task Error (List String)
presentGuards loc db =
    Db.queryDecode db "SELECT name || ' on ' || tbl_name AS guard FROM sqlite_master WHERE type = 'trigger'" [] guardDecoder
        |> Task.onError (Settings.openFailure ReviewDb loc)


-- The review database at a parsed location, opened through the one review URL
-- builder (`Settings.reviewUrl`); no raw URL reaches the driver. It never
-- migrates: `probe` is the one migrate, run at startup, so a review file
-- deleted under a running server is never silently re-created empty.
openAt : DbLocation -> Task.Task Error Db
openAt loc =
    Db.open "sqlite" (Settings.reviewUrl loc)


migrate : Db -> Task.Task Error (List String)
migrate db =
    Db.migrate db all


-- The most pages of `PageSize.pairs` rows one walk of the review log reads:
-- a bound on one walk's work, never a stack limit — every walk runs at
-- constant stack depth through `Task.loop`.
logPageCeiling : Int
logPageCeiling =
    10000


-- The review log's head: the one `review_log_head` row. A missing or extra
-- row is a failed read, never a default head.
currentHead : Db -> Task.Task Error Index.ChainHead
currentHead db =
    headRows db |> Task.andThen oneHead


headRows : Db -> Task.Task Error (List Index.ChainHead)
headRows db =
    Db.queryDecode db "SELECT log_id, seq, head FROM review_log_head WHERE one = 1" [] Index.chainHeadDecoder


oneHead : List Index.ChainHead -> Task.Task Error Index.ChainHead
oneHead rows =
    case rows of
        [ head ] ->
            Task.succeed head

        _ ->
            Task.fail (Error.unexpected "review_log_head did not return exactly one row")


-- The head moved from `prev` to `next` only if it still reads `prev`: a head
-- another writer moved first fails the move, so two decisions can never
-- both link from the same head.
advanceHead : Db -> Index.ChainHead -> Index.ChainHead -> Task.Task Error ()
advanceHead db prev next =
    do
        moved <- Db.exec db
            "UPDATE review_log_head SET seq = ?, head = ? WHERE one = 1 AND log_id = ? AND seq = ? AND head = ?"
            [ SqlInt (Index.chainSeq next), SqlString (Index.chainMac next), SqlString (Index.chainLogId prev), SqlInt (Index.chainSeq prev), SqlString (Index.chainMac prev) ]
        if moved == 1 then
            Task.succeed ()

        else
            Task.fail headMoved


headMoved : Error
headMoved =
    Error.conflict "the review log's head moved while a decision was recorded; decide again"


-- What a row's mac covers: a domain tag, the log it belongs to, its place in
-- the chain, and every column it records. A NULL reason (`-`) and an empty
-- one (`+`) differ, and `Index.lengthPrefixed` keeps any two field lists
-- apart, so no edit of any column keeps the mac.
macInput : String -> Int -> String -> Uid -> String -> String -> Maybe String -> Int -> String
macInput logId seq prev uid bodyHash decision reason reviewedAt =
    Index.lengthPrefixed
        [ "ipe-code-review/review-row/v1"
        , logId
        , String.fromInt seq
        , prev
        , Uid.toString uid
        , bodyHash
        , decision
        , reasonField reason
        , String.fromInt reviewedAt
        ]


reasonField : Maybe String -> String
reasonField reason =
    case reason of
        Nothing ->
            "-"

        Just r ->
            "+" ++ r


-- One review-log row as its columns hold it, every column read and none
-- trusted: classified only by `entryOf`. Its pair is read through
-- `Index.decidedPairDecoder`, so a uid that is not a unit id fails the read.
type LogRow
    = LogRow { seq : Int, pair : DecidedPair, decision : String, reason : Maybe String, reviewedAt : Int, prev : String, mac : String }


logRowDecoder : Db.Decode.Decoder LogRow
logRowDecoder =
    Db.Decode.map2 logRowOf Index.decidedPairDecoder logColumnsDecoder


logColumnsDecoder : Db.Decode.Decoder { seq : Int, decision : String, reason : Maybe String, reviewedAt : Int, prev : String, mac : String }
logColumnsDecoder =
    Db.Decode.succeed (\seq decision reason reviewedAt prev mac -> { seq = seq, decision = decision, reason = reason, reviewedAt = reviewedAt, prev = prev, mac = mac })
        |> Db.Decode.required "seq" (Db.Decode.int "seq")
        |> Db.Decode.required "decision" (Db.Decode.string "decision")
        |> Db.Decode.required "reason" (Db.Decode.nullable (Db.Decode.string "reason"))
        |> Db.Decode.required "reviewed_at" (Db.Decode.int "reviewed_at")
        |> Db.Decode.required "prev" (Db.Decode.string "prev")
        |> Db.Decode.required "mac" (Db.Decode.string "mac")


logRowOf : DecidedPair -> { seq : Int, decision : String, reason : Maybe String, reviewedAt : Int, prev : String, mac : String } -> LogRow
logRowOf pair cols =
    LogRow { seq = cols.seq, pair = pair, decision = cols.decision, reason = cols.reason, reviewedAt = cols.reviewedAt, prev = cols.prev, mac = cols.mac }


logColumns : String
logColumns =
    "SELECT seq, uid, body_hash, decision, reason, reviewed_at, prev, mac FROM review_log"


-- True exactly when the row's mac, parsed once, is the tag of its columns
-- under `key` in the log `logId`. An unparsable mac never verifies.
rowVerifies : MacKey -> String -> LogRow -> Bool
rowVerifies key logId row =
    case row of
        LogRow r ->
            case Crypto.macFromHex r.mac of
                Nothing ->
                    False

                Just mac ->
                    let
                        ( uid, bodyHash ) =
                            Index.decidedPairKey r.pair
                    in
                    ReviewKey.verifies key (macInput logId r.seq r.prev uid bodyHash r.decision r.reason r.reviewedAt) mac


-- A row's decision column parsed: Nothing for any text but `approve` or
-- `refuse`, which a verified row can only hold if the key signed it.
logDecision : LogRow -> Maybe StoredDecision
logDecision row =
    case row of
        LogRow r ->
            if r.decision == "approve" then
                Just StoredApproved

            else if r.decision == "refuse" then
                Just (StoredRefused (storedReason (Maybe.withDefault "" r.reason)))

            else
                Nothing


-- The one classifier of a review-log row: `Verified` only under a counting
-- verifier, when its mac verifies and its decision parses; otherwise why it
-- is not counted.
entryOf : Verifier -> String -> LogRow -> ReviewEntry
entryOf verify logId row =
    case verify of
        Keyless ->
            unverifiedOf NoKey row

        Broken key ->
            if rowVerifies key logId row then
                unverifiedOf ChainBroken row

            else
                unverifiedOf Tampered row

        Counting key ->
            if rowVerifies key logId row then
                case logDecision row of
                    Just decision ->
                        Verified (verifiedOf decision row)

                    Nothing ->
                        unverifiedOf Tampered row

            else
                unverifiedOf Tampered row


verifiedOf : StoredDecision -> LogRow -> VerifiedRow
verifiedOf decision row =
    case row of
        LogRow r ->
            let
                ( uid, bodyHash ) =
                    Index.decidedPairKey r.pair
            in
            VerifiedRow { seq = r.seq, pair = r.pair, uid = uid, bodyHash = bodyHash, decision = decision, reviewedAt = Timestamp.fromUnixMillis r.reviewedAt }


unverifiedOf : Unverified -> LogRow -> ReviewEntry
unverifiedOf why row =
    case row of
        LogRow r ->
            let
                ( uid, bodyHash ) =
                    Index.decidedPairKey r.pair
            in
            Unverified { uid = uid, bodyHash = bodyHash, reviewedAt = Timestamp.fromUnixMillis r.reviewedAt, why = why }


logSeq : LogRow -> Int
logSeq row =
    case row of
        LogRow r ->
            r.seq


-- One link of the chain as a walk reads it: an entry's seq, the mac it
-- links from, and its own mac.
type alias ChainLink =
    { seq : Int
    , prev : String
    , mac : String
    }


chainLinkDecoder : Db.Decode.Decoder ChainLink
chainLinkDecoder =
    Db.Decode.succeed (\seq prev mac -> { seq = seq, prev = prev, mac = mac })
        |> Db.Decode.required "seq" (Db.Decode.int "seq")
        |> Db.Decode.required "prev" (Db.Decode.string "prev")
        |> Db.Decode.required "mac" (Db.Decode.string "mac")


-- The state one walk step carries: pages read, the seq the next entry must
-- have, and the mac it must link from.
type alias ChainWalk =
    { pagesRead : Int
    , nextSeq : Int
    , prev : String
    }


-- The review log walked in seq order up to `head`: every entry from 1 must
-- follow the one before it and link its mac, and the last must be the head's
-- seq and mac. The verdict names the first entry where that fails. Entries
-- past the head's seq are not read: a decision is recorded with its head
-- move in one transaction, so they are ones a later head covers. At most
-- `ceiling` pages of `size` entries are read; a longer log fails with
-- `refusal`. The walk reads only the chain columns; no mac is verified here.
checkChainWithin : Db -> PageSize -> Int -> Error -> Index.ChainHead -> Task.Task Error ChainVerdict
checkChainWithin db size ceiling refusal head =
    Task.loop (ceiling + 1) { pagesRead = 0, nextSeq = 1, prev = "genesis" } (chainStep db size ceiling refusal head)


chainStep : Db -> PageSize -> Int -> Error -> Index.ChainHead -> ChainWalk -> Task.Task Error (Task.Step ChainWalk ChainVerdict)
chainStep db size ceiling refusal head walk =
    do
        links <- Db.queryDecode db
            "SELECT seq, prev, mac FROM review_log WHERE seq >= ? AND seq <= ? ORDER BY seq LIMIT ?"
            [ SqlInt walk.nextSeq, SqlInt (Index.chainSeq head), SqlInt (PageSize.toInt size) ]
            chainLinkDecoder
        if List.isEmpty links then
            Task.succeed (Task.Done (chainEnd head walk))

        else if walk.pagesRead >= ceiling then
            Task.fail refusal

        else
            case followLinks walk.nextSeq walk.prev links of
                Err brokenAt ->
                    Task.succeed (Task.Done (BrokenAt brokenAt))

                Ok ( nextSeq, prev ) ->
                    if List.length links < PageSize.toInt size then
                        Task.succeed (Task.Done (chainEnd head { pagesRead = walk.pagesRead + 1, nextSeq = nextSeq, prev = prev }))

                    else
                        Task.succeed (Task.Continue { pagesRead = walk.pagesRead + 1, nextSeq = nextSeq, prev = prev })


-- One page of links followed from the expected seq and mac: the seq and mac
-- after the page, or the first entry the chain breaks at. A missing entry
-- breaks at its seq; an entry linking another mac breaks at its own.
followLinks : Int -> String -> List ChainLink -> Result Int ( Int, String )
followLinks nextSeq prev links =
    List.foldl
        (\link walked ->
            case walked of
                Err n ->
                    Err n

                Ok ( expected, mac ) ->
                    if link.seq /= expected then
                        Err expected

                    else if Crypto.constantTimeEqual link.prev mac then
                        Ok ( expected + 1, link.mac )

                    else
                        Err expected
        )
        (Ok ( nextSeq, prev ))
        links


-- The verdict once every entry up to the head's seq is read: intact when
-- the walk ended on the head's seq and mac; otherwise broken at the first
-- missing entry, or at the head's own entry when its mac is not the last
-- entry's.
chainEnd : Index.ChainHead -> ChainWalk -> ChainVerdict
chainEnd head walk =
    let
        lastSeq =
            walk.nextSeq - 1
    in
    if lastSeq < Index.chainSeq head then
        BrokenAt walk.nextSeq

    else if Crypto.constantTimeEqual walk.prev (Index.chainMac head) then
        Intact

    else
        BrokenAt (max 1 lastSeq)


-- The refusal of a decision on a broken chain, naming the first entry it
-- breaks at.
chainBrokenRefusal : Int -> Error
chainBrokenRefusal n =
    Error.conflict
        ("the review log's chain breaks at entry "
            ++ String.fromInt n
            ++ ": a decision was removed, reordered or replaced outside this tool, so no decision is recorded until the log is restored"
        )


decideCeilingRefusal : Error
decideCeilingRefusal =
    Error.invalidInput
        ("the review log holds more than "
            ++ String.fromInt (logPageCeiling * PageSize.toInt PageSize.pairs)
            ++ " decisions, past the "
            ++ String.fromInt logPageCeiling
            ++ "-page ceiling of a chain check; nothing was recorded"
        )


-- At most this many rows are read for one pair or uid: an edit outside this
-- tool can add rows, never make a lookup unbounded.
candidateCeiling : Int
candidateCeiling =
    64


-- A decision is recorded only against an `Attested` pair, the proof that
-- the reviewer was shown exactly those bytes, and only under `key`: a
-- read-only server holds no `MacKey` and cannot call it. A refusal's reason
-- is already a parsed `Reason`, so every decision that reaches the log is
-- well formed. One review transaction reads the head, walks the chain to it
-- and refuses a broken one, inserting nothing; returns `AlreadyDecided` when
-- a row for the pair already verifies, the first verified decision winning;
-- otherwise appends the next entry, signed over every column and linked to
-- the head, and moves the head to it through a compare-and-set that fails,
-- rolling the row back, if the head moved after it was read.
insertDecision : MacKey -> Db -> Attested -> Decision -> Task.Task Error Index.Written
insertDecision key db attested decision =
    do
        now <- Time.unixMillis ()
        Db.withTransaction db (\tx -> recordDecision key tx attested decision (Timestamp.toUnixMillis now))


recordDecision : MacKey -> Db -> Attested -> Decision -> Int -> Task.Task Error Index.Written
recordDecision key tx attested decision at =
    do
        head <- currentHead tx
        verdict <- checkChainWithin tx PageSize.pairs logPageCeiling decideCeilingRefusal head
        case verdict of
            BrokenAt n ->
                Task.fail (chainBrokenRefusal n)

            Intact ->
                do
                    decided <- pairVerifies key tx head (Index.attestedUid attested) (Index.attestedHash attested)
                    if decided then
                        Task.succeed Index.AlreadyDecided

                    else
                        appendDecision key tx head attested decision at


-- True when a row for the pair, up to the head, verifies under `key`.
pairVerifies : MacKey -> Db -> Index.ChainHead -> Uid -> String -> Task.Task Error Bool
pairVerifies key db head uid bodyHash =
    Db.queryDecode db
        (logColumns ++ " WHERE uid = ? AND body_hash = ? AND seq <= ? ORDER BY seq LIMIT ?")
        [ Uid.toSql uid, SqlString bodyHash, SqlInt (Index.chainSeq head), SqlInt candidateCeiling ]
        logRowDecoder
        |> Task.map (List.any (rowVerifies key (Index.chainLogId head)))


appendDecision : MacKey -> Db -> Index.ChainHead -> Attested -> Decision -> Int -> Task.Task Error Index.Written
appendDecision key tx head attested decision at =
    let
        uid =
            Index.attestedUid attested

        bodyHash =
            Index.attestedHash attested

        ( decisionText, reason ) =
            case decision of
                Approved ->
                    ( "approve", Nothing )

                Refused r ->
                    ( "refuse", Just (reasonString r) )

        seq =
            Index.chainSeq head + 1

        prev =
            Index.chainMac head

        mac =
            ReviewKey.sign key (macInput (Index.chainLogId head) seq prev uid bodyHash decisionText reason at)

        next =
            Index.chainNext head mac
    in
    do
        inserted <- Db.exec tx
            "INSERT INTO review_log (seq, uid, body_hash, decision, reason, reviewed_at, prev, mac) VALUES (?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT (seq) DO NOTHING"
            [ SqlInt seq, Uid.toSql uid, SqlString bodyHash, SqlString decisionText, reasonValue reason, SqlTime at, SqlString prev, SqlString mac ]
        if inserted == 1 then
            advanceHead tx head next
                |> Task.map (\_ -> Index.Inserted { prev = Index.signedStamp key head Intact, next = Index.signedStamp key next Intact })

        else
            Task.fail headMoved


reasonValue : Maybe String -> SqlValue
reasonValue reason =
    case reason of
        Nothing ->
            SqlNull (SqlString "")

        Just r ->
            SqlString r


-- One page of the review log in seq order, strictly after entry `after` and
-- up to the head's seq, at most `size` rows: the refill's read. Every value
-- is a bound parameter.
logRowsAfter : Db -> PageSize -> Index.ChainHead -> Int -> Task.Task Error (List LogRow)
logRowsAfter db size head after =
    Db.queryDecode db
        (logColumns ++ " WHERE seq > ? AND seq <= ? ORDER BY seq LIMIT ?")
        [ SqlInt after, SqlInt (Index.chainSeq head), SqlInt (PageSize.toInt size) ]
        logRowDecoder


-- A refill page's rows that count: each classified under `verify` in the
-- head's log, the verified ones kept.
countedRows : Verifier -> Index.ChainHead -> List LogRow -> List VerifiedRow
countedRows verify head rows =
    List.filterMap
        (\row ->
            case entryOf verify (Index.chainLogId head) row of
                Verified v ->
                    Just v

                Unverified _ ->
                    Nothing
        )
        rows


-- The seq of a page's last row, the cursor the next page reads after.
lastSeq : List LogRow -> Maybe Int
lastSeq rows =
    Maybe.map logSeq (List.head (List.reverse rows))


-- The review entry for one (uid, body_hash) pair, if any: its first row that
-- counts, else its latest row that does not, else its legacy row as
-- `Legacy`. A legacy row `fromRecord` refuses fails the read.
findDecision : Verifier -> Db -> Uid -> String -> Task.Task Error (Maybe ReviewEntry)
findDecision verify db uid bodyHash =
    do
        head <- currentHead db
        rows <- Db.queryDecode db
            (logColumns ++ " WHERE uid = ? AND body_hash = ? ORDER BY seq LIMIT ?")
            [ Uid.toSql uid, SqlString bodyHash, SqlInt candidateCeiling ]
            logRowDecoder
        case pickEntry (List.map (entryOf verify (Index.chainLogId head)) rows) of
            Just entry ->
                Task.succeed (Just entry)

            Nothing ->
                findLegacy db uid bodyHash |> Task.map (Maybe.map legacyEntry)


pickEntry : List ReviewEntry -> Maybe ReviewEntry
pickEntry entries =
    case List.find isVerified entries of
        Just entry ->
            Just entry

        Nothing ->
            List.head (List.reverse entries)


isVerified : ReviewEntry -> Bool
isVerified entry =
    case entry of
        Verified _ ->
            True

        Unverified _ ->
            False


findLegacy : Db -> Uid -> String -> Task.Task Error (Maybe LegacyRow)
findLegacy db uid bodyHash =
    case reviewStore of
        Err e ->
            Task.fail e

        Ok store ->
            Store.query store
                |> Store.where (Store.and [ Store.eq .uid (Uid.toString uid), Store.eq .bodyHash bodyHash ])
                |> Store.toMaybe db
                |> Task.andThen fromMaybeRecord


-- The most recent counted row for a uid across all hashes, if any: of its
-- newest `candidateCeiling` rows up to the head, the first that verifies.
-- A row that does not verify, and a legacy row, never stand for a previous
-- review.
findLatestForUid : Verifier -> Db -> Uid -> Task.Task Error (Maybe VerifiedRow)
findLatestForUid verify db uid =
    do
        head <- currentHead db
        rows <- Db.queryDecode db
            (logColumns ++ " WHERE uid = ? AND seq <= ? ORDER BY reviewed_at DESC, seq DESC LIMIT ?")
            [ Uid.toSql uid, SqlInt (Index.chainSeq head), SqlInt candidateCeiling ]
            logRowDecoder
        Task.succeed (List.head (countedRows verify head rows))


-- Where a History page starts: at the newest review-log row; strictly after
-- a review-log row in its page order (reviewed_at descending, then seq
-- descending); or, once the log's rows are listed, strictly after a legacy
-- row in its page order (reviewed_at descending, then uid, then body hash).
-- Each order runs over its table's key, so it is total: no row is skipped or
-- repeated across pages, ties in reviewed_at included.
type HistoryCursor
    = HistoryStart
    | HistoryAfter Timestamp Int
    | HistoryLegacyAfter Timestamp Uid String


-- One page of review entries in the page order, and the cursor of the page
-- after it: Nothing when this page is short, so no table holds more.
type alias HistoryRows =
    { rows : List ReviewEntry
    , next : Maybe HistoryCursor
    }


-- One History page: at most `size` entries from `cursor`, sorted and cut by
-- SQLite, so a page never reads more than its size whatever the tables
-- hold. The review log's rows come first, each classified under `verify`;
-- a page they leave short is filled with legacy rows, shown as `Legacy`.
-- Every value is a bound parameter; a legacy row `fromRecord` refuses fails
-- the page, naming the row.
historyPage : Verifier -> Db -> PageSize -> HistoryCursor -> Task.Task Error HistoryRows
historyPage verify db size cursor =
    case cursor of
        HistoryStart ->
            logHistoryPage verify db (PageSize.toInt size) cursor

        HistoryAfter _ _ ->
            logHistoryPage verify db (PageSize.toInt size) cursor

        HistoryLegacyAfter _ _ _ ->
            legacyPage db (PageSize.toInt size) cursor


logHistoryPage : Verifier -> Db -> Int -> HistoryCursor -> Task.Task Error HistoryRows
logHistoryPage verify db limit cursor =
    do
        head <- currentHead db
        rows <- Db.queryDecode db (historySql cursor) (historyParams limit cursor) logRowDecoder
        logPageOf verify db limit (List.map (entryOf verify (Index.chainLogId head)) rows) rows


-- A full page of log rows ends at its last row; a short one is filled with
-- legacy rows from the newest.
logPageOf : Verifier -> Db -> Int -> List ReviewEntry -> List LogRow -> Task.Task Error HistoryRows
logPageOf verify db limit entries rows =
    if List.length rows < limit then
        legacyPage db (limit - List.length rows) HistoryStart
            |> Task.map (\legacy -> { rows = entries ++ legacy.rows, next = legacy.next })

    else
        Task.succeed { rows = entries, next = Maybe.map (\last -> HistoryAfter (logAt last) (logSeq last)) (List.head (List.reverse rows)) }


logAt : LogRow -> Timestamp
logAt row =
    case row of
        LogRow r ->
            Timestamp.fromUnixMillis r.reviewedAt


-- At most `limit` legacy rows from `cursor` (from the newest for any cursor
-- but `HistoryLegacyAfter`), and the cursor after them.
legacyPage : Db -> Int -> HistoryCursor -> Task.Task Error HistoryRows
legacyPage db limit cursor =
    do
        records <- Db.queryDecode db (legacySql cursor) (legacyParams limit cursor) historyRowDecoder
        rows <- Task.fromResult (Result.traverse fromRecord records)
        Task.succeed { rows = List.map legacyEntry rows, next = legacyNext limit rows }


-- The query plan SQLite chooses for the History page from `cursor`, one
-- detail line per step. The page order is the `review_log_time` index order
-- for the log's rows and the `review_history_order` index order for legacy
-- rows, so a page seeks into an index and reads at most its size, never a
-- whole table nor a sort of it.
historyPlan : Db -> HistoryCursor -> Task.Task Error (List String)
historyPlan db cursor =
    Db.queryDecode db
        ("EXPLAIN QUERY PLAN " ++ planSql cursor)
        (planParams cursor)
        (Db.Decode.succeed identity |> Db.Decode.required "detail" (Db.Decode.string "detail"))


planSql : HistoryCursor -> String
planSql cursor =
    case cursor of
        HistoryStart ->
            historySql cursor

        HistoryAfter _ _ ->
            historySql cursor

        HistoryLegacyAfter _ _ _ ->
            legacySql cursor


planParams : HistoryCursor -> List SqlValue
planParams cursor =
    case cursor of
        HistoryStart ->
            historyParams (PageSize.toInt PageSize.history) cursor

        HistoryAfter _ _ ->
            historyParams (PageSize.toInt PageSize.history) cursor

        HistoryLegacyAfter _ _ _ ->
            legacyParams (PageSize.toInt PageSize.history) cursor


historySql : HistoryCursor -> String
historySql cursor =
    case cursor of
        HistoryAfter _ _ ->
            logColumns ++ " WHERE reviewed_at <= ? AND (reviewed_at < ? OR seq < ?)" ++ historyOrder

        HistoryStart ->
            logColumns ++ historyOrder

        HistoryLegacyAfter _ _ _ ->
            logColumns ++ historyOrder


historyParams : Int -> HistoryCursor -> List SqlValue
historyParams limit cursor =
    case cursor of
        HistoryAfter at seq ->
            [ SqlTime (Timestamp.toUnixMillis at), SqlTime (Timestamp.toUnixMillis at), SqlInt seq, SqlInt limit ]

        HistoryStart ->
            [ SqlInt limit ]

        HistoryLegacyAfter _ _ _ ->
            [ SqlInt limit ]


historyOrder : String
historyOrder =
    " ORDER BY reviewed_at DESC, seq DESC LIMIT ?"


legacySql : HistoryCursor -> String
legacySql cursor =
    case cursor of
        HistoryLegacyAfter _ _ _ ->
            legacyColumns ++ " WHERE reviewed_at <= ? AND (reviewed_at < ? OR (uid, body_hash) > (?, ?))" ++ legacyOrder

        HistoryStart ->
            legacyColumns ++ legacyOrder

        HistoryAfter _ _ ->
            legacyColumns ++ legacyOrder


legacyParams : Int -> HistoryCursor -> List SqlValue
legacyParams limit cursor =
    case cursor of
        HistoryLegacyAfter at uid bodyHash ->
            [ SqlTime (Timestamp.toUnixMillis at), SqlTime (Timestamp.toUnixMillis at), Uid.toSql uid, SqlString bodyHash, SqlInt limit ]

        HistoryStart ->
            [ SqlInt limit ]

        HistoryAfter _ _ ->
            [ SqlInt limit ]


legacyColumns : String
legacyColumns =
    "SELECT uid, body_hash, decision, reason, reviewed_at FROM review"


legacyOrder : String
legacyOrder =
    " ORDER BY reviewed_at DESC, uid, body_hash LIMIT ?"


-- The cursor after a legacy page: the last row's key when the page is full.
legacyNext : Int -> List LegacyRow -> Maybe HistoryCursor
legacyNext limit rows =
    if List.length rows < limit then
        Nothing

    else
        Maybe.map (\row -> HistoryLegacyAfter row.reviewedAt row.uid row.bodyHash) (List.head (List.reverse rows))


historyRowDecoder : Db.Decode.Decoder ReviewRecord
historyRowDecoder =
    Db.Decode.succeed historyRecord
        |> Db.Decode.required "uid" (Db.Decode.string "uid")
        |> Db.Decode.required "body_hash" (Db.Decode.string "body_hash")
        |> Db.Decode.required "decision" (Db.Decode.string "decision")
        |> Db.Decode.required "reason" (Db.Decode.nullable (Db.Decode.string "reason"))
        |> Db.Decode.required "reviewed_at" (Db.Decode.int "reviewed_at")


historyRecord : String -> String -> String -> Maybe String -> Int -> ReviewRecord
historyRecord uid bodyHash decision reason reviewedAt =
    makeRecord uid bodyHash decision reason (Timestamp.fromUnixMillis reviewedAt)
