module Lib.Format exposing (byteSize, formatReviewedAt, percent)

import Ipe.String
import Ipe.Time.Timestamp as Timestamp exposing (Timestamp)


-- Renders an instant as UTC "YYYY-MM-DD HH:MM:SS" via the civil-from-days
-- algorithm (Hinnant). The stdlib's Time.timeString only renders the
-- time-of-day, which is useless across days in a review history. Pure: no
-- kernel calls, so it is testable and stable across platforms.
formatReviewedAt : Timestamp -> String
formatReviewedAt t =
    let
        ms =
            Timestamp.toUnixMillis t

        seconds =
            ms // 1000

        days =
            seconds // 86400

        secOfDay =
            modBy 86400 seconds

        h =
            secOfDay // 3600

        m =
            modBy 60 (secOfDay // 60)

        sec =
            modBy 60 secOfDay

        z =
            days + 719468

        era =
            z // 146097

        doe =
            z - era * 146097

        yoe =
            (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365

        y =
            yoe + era * 400

        doy =
            doe - (365 * yoe + yoe // 4 - yoe // 100)

        mp =
            (5 * doy + 2) // 153

        d =
            doy - (153 * mp + 2) // 5 + 1

        mth =
            if mp < 10 then
                mp + 3

            else
                mp - 9

        yr =
            if mth <= 2 then
                y + 1

            else
                y
    in
    String.fromInt yr
        ++ "-"
        ++ pad2 mth
        ++ "-"
        ++ pad2 d
        ++ " "
        ++ pad2 h
        ++ ":"
        ++ pad2 m
        ++ ":"
        ++ pad2 sec


pad2 : Int -> String
pad2 n =
    String.padLeft 2 '0' (String.fromInt n)


-- Floor percentage of k decided out of n queued; 0% when nothing is queued
-- (a 0/0 division would otherwise be undefined).
percent : Int -> Int -> String
percent k n =
    if n == 0 then
        "0%"

    else
        String.fromInt ((k * 100) // n) ++ "%"


-- Human-readable byte size (e.g. "3.4 MB"), one decimal place above 1 KB.
-- Pure Int arithmetic: the stdlib has no Int -> Float conversion, so the
-- fractional digit is computed via scaled integer division rather than
-- floating point.
byteSize : Int -> String
byteSize n =
    if n < 1024 then
        String.fromInt n ++ " B"

    else if n < 1024 * 1024 then
        oneDecimal n 1024 ++ " KB"

    else if n < 1024 * 1024 * 1024 then
        oneDecimal n (1024 * 1024) ++ " MB"

    else
        oneDecimal n (1024 * 1024 * 1024) ++ " GB"


oneDecimal : Int -> Int -> String
oneDecimal n unit =
    let
        tenths =
            (n * 10 + unit // 2) // unit

        whole =
            tenths // 10

        frac =
            modBy 10 tenths
    in
    String.fromInt whole ++ "." ++ String.fromInt frac
