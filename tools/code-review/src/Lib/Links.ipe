module Lib.Links exposing (Candidates, Hidden(..), Link(..), LinkSet, Reach(..), Reference(..), UnitName, assemble, candidates, hiddenNote, internal, label, linkCandidateCeiling, linkCeiling, linkKey, noLinks, references, resolveCandidates, sourceUrls)

import Ipe.Char as Char
import Ipe.Dict as Dict
import Ipe.List as List
import Ipe.Result as Result exposing (Result(..))
import Ipe.Set as Set
import Ipe.String as String
import Lib.Highlight as Highlight exposing (Lang(..), Token(..))
import Lib.SafeText as SafeText exposing (SafeText)
import Lib.Uid as Uid exposing (Uid)


-- A link a unit page shows. An internal link jumps to the /unit/<uid> page of
-- its target, labelled with the target's qualified name rendered once into
-- `SafeText`; an external link keeps its raw URL for the `href` check, and
-- `label` renders it. `Unlinked` is a target whose stored uid is not a unit
-- id: its name shows as plain text and no address is built from it.
type Link
    = Internal SafeText Uid
    | External String
    | Unlinked SafeText


-- A link to unit `uid`, labelled with its stored qualified name. The stored
-- uid is parsed here, the one point index link rows enter.
internal : String -> String -> Link
internal qualified uid =
    case Uid.parse uid of
        Ok target ->
            Internal (SafeText.renderForeign qualified) target

        Err _ ->
            Unlinked (SafeText.renderForeign qualified)


-- How many links a page holds back. `Exactly n` counts links the page read
-- and did not show; `AtLeast n` is that count when a lookup also stopped at
-- its ceiling, so more links may exist than were read.
type Hidden
    = NoneHidden
    | Exactly Int
    | AtLeast Int


-- The links a page shows and how many it holds back; built by `assemble`.
type alias LinkSet =
    { links : List Link
    , hidden : Hidden
    }


-- Whether a bounded lookup read everything there was, or stopped at its
-- ceiling with more possibly left unread.
type Reach
    = Complete
    | Capped


-- The most links a page shows.
linkCeiling : Int
linkCeiling =
    100


-- The most distinct qualified names one page looks up for its references.
linkCandidateCeiling : Int
linkCandidateCeiling =
    256


noLinks : LinkSet
noLinks =
    { links = [], hidden = NoneHidden }


-- The one constructor of a `LinkSet`. Links come in one order — callgraph
-- edges, then resolved references, then URLs — deduplicated by `linkKey`
-- (the first occurrence wins) and cut at `linkCeiling`. The count held back is
-- exact only when neither the callgraph read nor the candidate list stopped
-- at its ceiling.
assemble : { edges : Reach, candidates : Reach } -> List Link -> List Link -> List Link -> LinkSet
assemble reach edges resolved urls =
    let
        kept =
            dedup (List.concat [ edges, resolved, urls ])

        cut =
            List.length kept - linkCeiling
    in
    { links = List.take linkCeiling kept, hidden = hiddenOf reach cut }


hiddenOf : { edges : Reach, candidates : Reach } -> Int -> Hidden
hiddenOf reach cut =
    case ( reach.edges, reach.candidates ) of
        ( Complete, Complete ) ->
            if cut > 0 then
                Exactly cut

            else
                NoneHidden

        ( Capped, _ ) ->
            AtLeast (max 0 cut)

        ( Complete, Capped ) ->
            AtLeast (max 0 cut)


-- The note a page shows after its links for what it holds back.
hiddenNote : Hidden -> Maybe SafeText
hiddenNote hidden =
    case hidden of
        NoneHidden ->
            Nothing

        Exactly n ->
            Just (SafeText.literal ("+" ++ String.fromInt n ++ " more"))

        AtLeast n ->
            Just (SafeText.literal ("+" ++ String.fromInt n ++ " or more"))


-- A name the shown source spells: a path of two or more segments, exactly as
-- written, or one bare name.
type Reference
    = Path String
    | Bare String


-- A unit's stored identity, from which its own module is read.
type alias UnitName =
    { kind : String
    , name : String
    , qualified : String
    }


-- The references of a shown source, in source order, folded once over the
-- one token stream the page draws, so a link always names a token the reader
-- sees. A reference is a maximal chain of word tokens (identifiers and
-- keywords) joined with no space by a path separator: `.` in Ipê, `::` in
-- Rust. A chain that follows a separator (`x.0.len`, `(a).b`, `::std`, the `::new`
-- after a turbofish) or a Rust `.` (`a.len`, `self.go`) is a member access and
-- names nothing; neither does a lone keyword. A `::<` turbofish ends a chain;
-- a `..` range does not start a member. Shell and unknown languages have no
-- references.
references : Highlight.Lexed -> List Reference
references lexed =
    case Highlight.lexedLang lexed of
        Rust ->
            referencesOf Rust (Highlight.lexedTokens lexed)

        Ipe ->
            referencesOf Ipe (Highlight.lexedTokens lexed)

        Shell ->
            []

        Unknown ->
            []


referencesOf : Lang -> List Token -> List Reference
referencesOf lang tokens =
    case List.foldl (walkToken lang) ( Free, [] ) tokens of
        ( walk, acc ) ->
            closeWalk walk acc


-- A chain of words read so far: its text, its segment count, whether its
-- first word is a keyword, and whether it is a reference at all (a member
-- chain is read only to be skipped).
type alias Chain =
    { text : String
    , segments : Int
    , reserved : Bool
    , keep : Bool
    }


-- Where the reference walk stands after the tokens read so far. The lexer
-- emits punctuation one character per `Plain` token, so a `::` or a `..`
-- arrives as two tokens.
type Walk
    = Free
    | FreeDot
    | FreeColon
    | Member
    | InChain Chain
    | ChainColon Chain
    | ChainSep Chain String


walkToken : Lang -> Token -> ( Walk, List Reference ) -> ( Walk, List Reference )
walkToken lang tok ( walk, acc ) =
    case walk of
        Free ->
            walkFree lang tok acc

        FreeDot ->
            if isPlain "." tok then
                ( Free, acc )

            else
                afterSeparator lang tok acc

        FreeColon ->
            if isPlain ":" tok then
                ( Member, acc )

            else
                walkFree lang tok acc

        Member ->
            afterSeparator lang tok acc

        InChain chain ->
            if isPlain "." tok && lang == Ipe then
                ( ChainSep chain ".", acc )

            else if isPlain "." tok then
                ( FreeDot, emit chain acc )

            else if isPlain ":" tok && lang == Rust then
                ( ChainColon chain, acc )

            else
                walkFree lang tok (emit chain acc)

        ChainColon chain ->
            if isPlain ":" tok then
                ( ChainSep chain "::", acc )

            else
                walkFree lang tok (emit chain acc)

        ChainSep chain sep ->
            case wordOf tok of
                Just w ->
                    ( InChain { text = String.append (String.append chain.text sep) w.text, segments = chain.segments + 1, reserved = chain.reserved, keep = chain.keep }, acc )

                Nothing ->
                    if sep == "." && isPlain "." tok then
                        ( Free, emit chain acc )

                    else
                        walkFree lang tok (emit chain acc)


-- `tok` with no chain open: a word opens a reference chain, a `.` may open a
-- member or a range, a Rust `:` may open a `::` separator.
walkFree : Lang -> Token -> List Reference -> ( Walk, List Reference )
walkFree lang tok acc =
    case wordOf tok of
        Just w ->
            ( InChain { text = w.text, segments = 1, reserved = w.reserved, keep = True }, acc )

        Nothing ->
            if isPlain "." tok then
                ( FreeDot, acc )

            else if isPlain ":" tok && lang == Rust then
                ( FreeColon, acc )

            else
                ( Free, acc )


-- `tok` right after a separator or a member `.`: a word opens a member chain
-- that names nothing; anything else is read afresh.
afterSeparator : Lang -> Token -> List Reference -> ( Walk, List Reference )
afterSeparator lang tok acc =
    case wordOf tok of
        Just w ->
            ( InChain { text = w.text, segments = 1, reserved = w.reserved, keep = False }, acc )

        Nothing ->
            walkFree lang tok acc


-- Ends the walk: a chain still open at the end of input is complete.
closeWalk : Walk -> List Reference -> List Reference
closeWalk walk acc =
    case walk of
        Free ->
            acc

        FreeDot ->
            acc

        FreeColon ->
            acc

        Member ->
            acc

        InChain chain ->
            emit chain acc

        ChainColon chain ->
            emit chain acc

        ChainSep chain _ ->
            emit chain acc


-- A finished chain's reference: a path of two or more segments, or a bare
-- name that is not a keyword. A member chain names nothing.
emit : Chain -> List Reference -> List Reference
emit chain acc =
    if not chain.keep then
        acc

    else if chain.segments > 1 then
        acc ++ [ Path chain.text ]

    else if chain.reserved then
        acc

    else
        acc ++ [ Bare chain.text ]


isPlain : String -> Token -> Bool
isPlain s tok =
    case tok of
        Plain p ->
            p == s

        Keyword _ ->
            False

        Str _ ->
            False

        Comment _ ->
            False

        Num _ ->
            False

        Ident _ ->
            False


wordOf : Token -> Maybe { text : String, reserved : Bool }
wordOf tok =
    case tok of
        Ident s ->
            Just { text = s, reserved = False }

        Keyword s ->
            Just { text = s, reserved = True }

        Str _ ->
            Nothing

        Comment _ ->
            Nothing

        Num _ ->
            Nothing

        Plain _ ->
            Nothing


-- The qualified names a page looks up for its references, under ipe-index's
-- callee rule (`tools/ipe-index/src/extract/treesitter.rs`, pass 2): a path
-- is looked up exactly, with a Rust `crate::` prefix rewritten to the unit's
-- own crate; a bare name is looked up exactly, then in the unit's own module.
-- `lookups` holds each distinct reference's alternatives in that order;
-- `names` holds every distinct alternative, in first-occurrence order. The
-- first reference whose alternatives would carry `names` past
-- `linkCandidateCeiling` is not looked up, nor is any after it, and `reach`
-- says so.
type alias Candidates =
    { lookups : List (List String)
    , names : List String
    , reach : Reach
    }


-- ( whether the ceiling stopped the lookups, every name looked up so far,
-- ( the lookups kept, their names in first-occurrence order ) ).
type alias CandidateAcc =
    ( Reach, Set String, ( List (List String), List String ) )


candidates : Lang -> UnitName -> List Reference -> Candidates
candidates lang unit refs =
    let
        base =
            moduleBase lang unit

        pending =
            List.map (alternatives lang unit base) (distinctReferences refs)
    in
    case List.foldl addCandidate ( Complete, Set.empty, ( [], [] ) ) pending of
        ( reach, _, ( lookups, names ) ) ->
            { lookups = lookups, names = names, reach = reach }


-- One reference's alternatives: kept while the names they add stay within
-- `linkCandidateCeiling`; the first one past it stops every later one.
addCandidate : List String -> CandidateAcc -> CandidateAcc
addCandidate alts ( reach, seen, ( lookups, names ) ) =
    case reach of
        Capped ->
            ( reach, seen, ( lookups, names ) )

        Complete ->
            case distinctNew seen alts of
                ( nowSeen, fresh ) ->
                    if List.length names + List.length fresh > linkCandidateCeiling then
                        ( Capped, seen, ( lookups, names ) )

                    else
                        ( Complete, nowSeen, ( lookups ++ [ alts ], names ++ fresh ) )


-- The names of `alts` not in `seen`, each once, in order, with `seen` grown
-- by them.
distinctNew : Set String -> List String -> ( Set String, List String )
distinctNew seen alts =
    List.foldl keepNewName ( seen, [] ) alts


keepNewName : String -> ( Set String, List String ) -> ( Set String, List String )
keepNewName a ( seen, fresh ) =
    if Set.member a seen then
        ( seen, fresh )

    else
        ( Set.insert a seen, fresh ++ [ a ] )


distinctReferences : List Reference -> List Reference
distinctReferences refs =
    case List.foldl keepNewReference ( Set.empty, [] ) refs of
        ( _, kept ) ->
            kept


keepNewReference : Reference -> ( Set String, List Reference ) -> ( Set String, List Reference )
keepNewReference r ( seen, kept ) =
    if Set.member (referenceKey r) seen then
        ( seen, kept )

    else
        ( Set.insert (referenceKey r) seen, kept ++ [ r ] )


referenceKey : Reference -> String
referenceKey ref =
    case ref of
        Path p ->
            "p:" ++ p

        Bare t ->
            "b:" ++ t


alternatives : Lang -> UnitName -> Maybe String -> Reference -> List String
alternatives lang unit base ref =
    case ref of
        Path p ->
            [ crateRewrite lang unit p ]

        Bare t ->
            case base of
                Just b ->
                    [ t, b ++ separator lang ++ t ]

                Nothing ->
                    [ t ]


-- A Rust `crate::` path names the unit's own crate: the first segment of its
-- qualified name, the crate root ipe-index roots every Rust module path at.
crateRewrite : Lang -> UnitName -> String -> String
crateRewrite lang unit path =
    if lang == Rust && String.startsWith "crate::" path then
        case List.head (String.split "::" unit.qualified) of
            Just root ->
                root ++ "::" ++ String.dropLeft 7 path

            Nothing ->
                path

    else
        path


-- The separator ipe-index joins a module and a unit name with.
separator : Lang -> String
separator lang =
    case lang of
        Ipe ->
            "."

        Rust ->
            "::"

        Shell ->
            "::"

        Unknown ->
            "::"


-- The unit's own module: its qualified name without a trailing `#<digits>`
-- duplicate ordinal, then without `separator ++ name` at its end. A file
-- unit, or a qualified name without that suffix, has none.
moduleBase : Lang -> UnitName -> Maybe String
moduleBase lang unit =
    let
        qualified =
            dropOrdinal unit.qualified

        suffix =
            separator lang ++ unit.name
    in
    if unit.kind == "file" || unit.name == "" then
        Nothing

    else if String.endsWith suffix qualified && String.length qualified > String.length suffix then
        Just (String.dropRight (String.length suffix) qualified)

    else
        Nothing


-- `q#<digits>` is `q`; any other name is itself.
dropOrdinal : String -> String
dropOrdinal qualified =
    case List.reverse (String.split "#" qualified) of
        digits :: first :: restRev ->
            if digits /= "" && String.all Char.isDigit digits then
                String.join "#" (List.reverse (first :: restRev))

            else
                qualified

        _ ->
            qualified


-- The links of `lookups` given the `(qualified, uid)` rows the candidate
-- query returned: each lookup links its first alternative that resolved.
resolveCandidates : List (List String) -> List ( String, String ) -> List Link
resolveCandidates lookups rows =
    let
        found =
            Dict.fromList rows
    in
    List.filterMap (firstResolved found) lookups


firstResolved : Dict String String -> List String -> Maybe Link
firstResolved found alts =
    List.foldl (resolveFirst found) Nothing alts


resolveFirst : Dict String String -> String -> Maybe Link -> Maybe Link
resolveFirst found a resolved =
    case resolved of
        Just link ->
            Just link

        Nothing ->
            case Dict.get a found of
                Just uid ->
                    Just (internal a uid)

                Nothing ->
                    Nothing


-- The http(s) URLs among the words of the shown source's text, comment and
-- string tokens, with the punctuation prose attaches (`(https://a.io/b),`)
-- trimmed from both ends. Collection stops at `linkCandidateCeiling` URLs
-- inside the fold, so a view of many URL-shaped words does bounded work.
sourceUrls : Highlight.Lexed -> List Link
sourceUrls lexed =
    case List.foldl addUrls ( 0, [] ) (Highlight.lexedTokens lexed) of
        ( _, urls ) ->
            urls


addUrls : Token -> ( Int, List Link ) -> ( Int, List Link )
addUrls tok ( count, urls ) =
    if count >= linkCandidateCeiling then
        ( count, urls )

    else
        case urlText tok of
            Just text ->
                List.foldl addUrl ( count, urls ) (String.words text)

            Nothing ->
                ( count, urls )


addUrl : String -> ( Int, List Link ) -> ( Int, List Link )
addUrl word ( count, urls ) =
    let
        trimmed =
            trimPunct word
    in
    if count < linkCandidateCeiling && isUrl trimmed then
        ( count + 1, urls ++ [ External trimmed ] )

    else
        ( count, urls )


-- The text of a token a URL may be read from: prose and literals, never a
-- word or a number.
urlText : Token -> Maybe String
urlText tok =
    case tok of
        Plain s ->
            Just s

        Str s ->
            Just s

        Comment s ->
            Just s

        Keyword _ ->
            Nothing

        Ident _ ->
            Nothing

        Num _ ->
            Nothing


isUrl : String -> Bool
isUrl token =
    String.startsWith "http://" token || String.startsWith "https://" token


trimPunct : String -> String
trimPunct token =
    case String.foldl trimStep ( False, "", "" ) token of
        ( _, kept, _ ) ->
            kept


-- ( whether a non-punctuation character was read, the text kept, the
-- punctuation read since the last kept character ): leading punctuation is
-- never kept, inner punctuation is kept when a later character follows it,
-- trailing punctuation is dropped at the end.
trimStep : Char -> ( Bool, String, String ) -> ( Bool, String, String )
trimStep c ( started, kept, pending ) =
    if isPunct c then
        if started then
            ( True, kept, String.append pending (String.fromChar c) )

        else
            ( False, kept, pending )

    else
        ( True, String.append (String.append kept pending) (String.fromChar c), "" )


isPunct : Char -> Bool
isPunct c =
    case c of
        '\'' ->
            True

        '(' ->
            True

        ')' ->
            True

        '[' ->
            True

        ']' ->
            True

        '{' ->
            True

        '}' ->
            True

        ',' ->
            True

        ';' ->
            True

        '.' ->
            True

        '!' ->
            True

        '?' ->
            True

        '<' ->
            True

        '>' ->
            True

        '"' ->
            True

        '`' ->
            True

        ':' ->
            True

        '-' ->
            True

        '=' ->
            True

        _ ->
            False


-- First occurrence wins: one left-to-right pass keeps a link only when its
-- key is new. The seen set holds each link's comparable `linkKey`.
dedup : List Link -> List Link
dedup links =
    case List.foldl keepFirst ( Set.empty, [] ) links of
        ( _, kept ) ->
            List.reverse kept


keepFirst : Link -> ( Set String, List Link ) -> ( Set String, List Link )
keepFirst link ( seen, kept ) =
    if Set.member (linkKey link) seen then
        ( seen, kept )

    else
        ( Set.insert (linkKey link) seen, link :: kept )


-- The text a link shows, never raw: an internal link's rendered name, an
-- external link's URL with every control and bidi character escaped.
label : Link -> SafeText
label link =
    case link of
        Internal name _ ->
            SafeText.concat [ SafeText.literal "→ ", name ]

        External url ->
            SafeText.concat [ SafeText.literal "↗ ", SafeText.renderForeign url ]

        Unlinked name ->
            name


linkKey : Link -> String
linkKey link =
    case link of
        Internal _ uid ->
            "i:" ++ Uid.toString uid

        External url ->
            "e:" ++ url

        Unlinked name ->
            "t:" ++ SafeText.toString name
