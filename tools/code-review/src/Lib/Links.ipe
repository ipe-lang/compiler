module Lib.Links exposing (Candidates, ExternalUrl, Hidden(..), Link(..), LinkKey(..), LinkSet, Reach(..), Reference(..), UnitName, assemble, candidates, external, hiddenNote, href, hrefByteCeiling, internal, label, linkByteCeiling, linkCandidateCeiling, linkCeiling, linkKey, linkKeyOrder, mark, noLinks, references, resolveCandidates, sourceUrls)

import Ipe.Char as Char
import Ipe.Dict as Dict
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Result as Result exposing (Result(..))
import Ipe.Set as Set
import Ipe.String as String
import Lib.Highlight as Highlight exposing (Lang, PathRule, Separator(..), Token(..))
import Lib.Label as Label exposing (Label, LabelPart(..))
import Lib.SafeText as SafeText exposing (SafeText)
import Lib.Uid as Uid exposing (Uid)


-- A link a unit page shows. An internal link jumps to the /unit/<uid> page of
-- its target, labelled with the target's qualified name as a bounded
-- `Label`; an external link is an `ExternalUrl`. `Unlinked` is a target
-- whose stored uid is not a unit id: its name shows as a label and no
-- address is built from it. Every name a link shows is a `Label`, so a link
-- draws at most `Label.elementCeiling` elements of untrusted text and holds
-- at most `linkByteCeiling` bytes, whatever the index or the source held.
type Link
    = Internal Label Uid
    | External ExternalUrl
    | Unlinked Label


-- A URL the shown source spells: its label, and the raw URL for the `href`
-- check only when it fits `hrefByteCeiling`. Opaque: built only by
-- `external`, so no href past the ceiling has a representation.
type ExternalUrl
    = ExternalUrl { shown : Label, href : Maybe String }


-- The most bytes of a URL a link targets. It is the label cap, so a linked
-- URL always shows whole and a URL the label cuts is shown, never linked.
hrefByteCeiling : Int
hrefByteCeiling =
    Label.capBytes Label.labelCap


-- The most bytes one link holds: its mark, its label at the cap with a
-- marker, and its href.
linkByteCeiling : Int
linkByteCeiling =
    markByteCeiling + Label.capBytes Label.labelCap + Label.markerByteCeiling + hrefByteCeiling


-- The bytes of the longest mark a link shows before its label.
markByteCeiling : Int
markByteCeiling =
    4


-- A link to unit `uid`, labelled with its qualified name as the index read
-- parsed it. The stored uid is parsed here, the one point index link rows
-- enter.
internal : Label -> String -> Link
internal qualified uid =
    case Uid.parse uid of
        Ok target ->
            Internal qualified target

        Err _ ->
            Unlinked qualified


-- An external link to `url`, labelled with it; targeted only when it fits
-- `hrefByteCeiling` and its label shows it whole.
external : String -> Link
external url =
    let
        shown =
            Label.fromText Label.labelCap url
    in
    if Label.textBytes url <= hrefByteCeiling && not (List.any isCut (Label.parts shown)) then
        External (ExternalUrl { shown = shown, href = Just url })

    else
        External (ExternalUrl { shown = shown, href = Nothing })


-- How many links a page holds back. `Exactly n` counts links the page read
-- and did not show; `AtLeast n` is that count when a lookup also stopped at
-- its ceiling, so more links may exist than were read.
type Hidden
    = NoneHidden
    | Exactly Int
    | AtLeast Int


-- The links a page shows and how many it holds back; built by `assemble`.
type alias LinkSet =
    { links : List Link
    , hidden : Hidden
    }


-- Whether a bounded lookup read everything there was, or stopped at its
-- ceiling with more possibly left unread.
type Reach
    = Complete
    | Capped


-- The most links a page shows. Each costs the queue page `Index.linkElements`
-- drawn elements and `linkByteCeiling` bytes twice over, so the count is set
-- where the page still fits its quarter of the session ceiling; a test
-- checks the relation.
linkCeiling : Int
linkCeiling =
    64


-- The most distinct qualified names one page looks up for its references.
linkCandidateCeiling : Int
linkCandidateCeiling =
    256


noLinks : LinkSet
noLinks =
    { links = [], hidden = NoneHidden }


-- The one constructor of a `LinkSet`. Links come in one order — callgraph
-- edges, then resolved references, then URLs — deduplicated by `linkKey`
-- (the first occurrence wins) and cut at `linkCeiling`. The count held back is
-- exact only when neither the callgraph read nor the candidate list stopped
-- at its ceiling.
assemble : { edges : Reach, candidates : Reach } -> List Link -> List Link -> List Link -> LinkSet
assemble reach edges resolved urls =
    let
        kept =
            dedup (List.concat [ edges, resolved, urls ])

        cut =
            List.length kept - linkCeiling
    in
    { links = List.take linkCeiling kept, hidden = hiddenOf reach cut }


hiddenOf : { edges : Reach, candidates : Reach } -> Int -> Hidden
hiddenOf reach cut =
    case ( reach.edges, reach.candidates ) of
        ( Complete, Complete ) ->
            if cut > 0 then
                Exactly cut

            else
                NoneHidden

        ( Capped, _ ) ->
            AtLeast (max 0 cut)

        ( Complete, Capped ) ->
            AtLeast (max 0 cut)


-- The note a page shows after its links for what it holds back.
hiddenNote : Hidden -> Maybe SafeText
hiddenNote hidden =
    case hidden of
        NoneHidden ->
            Nothing

        Exactly n ->
            Just (SafeText.literal ("+" ++ String.fromInt n ++ " more"))

        AtLeast n ->
            Just (SafeText.literal ("+" ++ String.fromInt n ++ " or more"))


-- A name the shown source spells: a path of two or more segments, exactly as
-- written, or one bare name.
type Reference
    = Path String
    | Bare String


-- A unit's stored identity as the index read returns it, each column a
-- bounded window and its byte length, from which its own module is read.
type alias UnitName =
    { kind : Label.Column
    , name : Label.Column
    , qualified : Label.Column
    }


-- A unit's stored identity, every column whole: what the candidate rule
-- reads, built only by `wholeName`.
type alias WholeName =
    { kind : String
    , name : String
    , qualified : String
    }


-- The identity whole, when each window holds its whole column; `Nothing`
-- when any column is longer than its window, so no candidate is ever built
-- from a prefix of a name.
wholeName : UnitName -> Maybe WholeName
wholeName unit =
    case ( Label.whole unit.kind, Label.whole unit.name, Label.whole unit.qualified ) of
        ( Just kind, Just name, Just qualified ) ->
            Just { kind = kind, name = name, qualified = qualified }

        _ ->
            Nothing


-- The references of a shown source, in source order, folded over the tokens
-- the page displays, so a link always names a token the reader sees. A
-- reference is a maximal chain of word tokens (identifiers and keywords)
-- joined with no space by a path separator: `.` in Ipê, `::` in Rust. A
-- chain that follows a separator (`x.0.len`, `(a).b`, `::std`, the `::new`
-- after a turbofish) or a Rust `.` (`a.len`, `self.go`) is a member access and
-- names nothing; neither does a lone keyword. A `::<` turbofish ends a chain;
-- a `..` range does not start a member. A language whose grammar spells no
-- path (shell, and one with no grammar) has no references.
references : Lang -> String -> List Reference
references lang source =
    case Highlight.pathRule lang of
        Just rule ->
            referencesOf rule.separator (Highlight.tokenize lang source)

        Nothing ->
            []


-- One left-to-right pass over the tokens: each token is read once and moves
-- the walk on, so the pass is linear in the tokens.
referencesOf : Separator -> List Token -> List Reference
referencesOf sep tokens =
    case List.foldl (walkToken sep) ( Between, [] ) tokens of
        ( walk, refs ) ->
            closeWalk walk refs


-- What a token is to the walk: a word (identifier or keyword, `True` for a
-- keyword), one of the two separator characters, or anything else.
type Piece
    = Word String Bool
    | Dot
    | Colon
    | Other


pieceOf : Token -> Piece
pieceOf tok =
    case tok of
        Ident s ->
            Word s False

        Keyword s ->
            Word s True

        Plain s ->
            if s == "." then
                Dot

            else if s == ":" then
                Colon

            else
                Other

        Str _ ->
            Other

        Comment _ ->
            Other

        Num _ ->
            Other


-- The chain being read: one that names a reference (its text, its segment
-- count, and whether its first word is a keyword), or a member-access chain
-- that names nothing.
type Head
    = Emit String Int Bool
    | Discard


-- Where the walk is. `Between`: no chain open. `AfterDot`, `AfterColon`,
-- `AfterColons`: a `.`, `:` or `::` read with no chain before it, so a word
-- after it starts a member chain (and a second `.` makes a `..` range).
-- `InChain`: a chain whose last word was just read. `ChainDot`, `ChainColon`,
-- `ChainColons`: a chain followed by `.` (Ipê), `:` or `::` (Rust), which a
-- word extends.
type Walk
    = Between
    | AfterDot
    | AfterColon
    | AfterColons
    | InChain Head
    | ChainDot Head
    | ChainColon Head
    | ChainColons Head


walkToken : Separator -> Token -> ( Walk, List Reference ) -> ( Walk, List Reference )
walkToken sep tok ( walk, refs ) =
    walkPiece sep (pieceOf tok) walk refs


walkPiece : Separator -> Piece -> Walk -> List Reference -> ( Walk, List Reference )
walkPiece sep piece walk refs =
    case walk of
        Between ->
            startAt sep piece refs

        AfterDot ->
            case piece of
                Dot ->
                    ( Between, refs )

                Word _ _ ->
                    ( InChain Discard, refs )

                Colon ->
                    startAt sep Colon refs

                Other ->
                    ( Between, refs )

        AfterColon ->
            case piece of
                Colon ->
                    ( AfterColons, refs )

                Word w reserved ->
                    startAt sep (Word w reserved) refs

                Dot ->
                    startAt sep Dot refs

                Other ->
                    ( Between, refs )

        AfterColons ->
            case piece of
                Word _ _ ->
                    ( InChain Discard, refs )

                Dot ->
                    startAt sep Dot refs

                Colon ->
                    startAt sep Colon refs

                Other ->
                    ( Between, refs )

        InChain head ->
            case piece of
                Dot ->
                    case sep of
                        DotSeparator ->
                            ( ChainDot head, refs )

                        DoubleColonSeparator ->
                            startAt sep Dot (emit head refs)

                Colon ->
                    case sep of
                        DoubleColonSeparator ->
                            ( ChainColon head, refs )

                        DotSeparator ->
                            startAt sep Colon (emit head refs)

                Word w reserved ->
                    startAt sep (Word w reserved) (emit head refs)

                Other ->
                    ( Between, emit head refs )

        ChainDot head ->
            case piece of
                Word w _ ->
                    ( InChain (extend head "." w), refs )

                Dot ->
                    walkPiece sep Dot AfterDot (emit head refs)

                Colon ->
                    walkPiece sep Colon AfterDot (emit head refs)

                Other ->
                    walkPiece sep Other AfterDot (emit head refs)

        ChainColon head ->
            case piece of
                Colon ->
                    ( ChainColons head, refs )

                Word w reserved ->
                    walkPiece sep (Word w reserved) AfterColon (emit head refs)

                Dot ->
                    walkPiece sep Dot AfterColon (emit head refs)

                Other ->
                    walkPiece sep Other AfterColon (emit head refs)

        ChainColons head ->
            case piece of
                Word w _ ->
                    ( InChain (extend head "::" w), refs )

                Dot ->
                    walkPiece sep Dot AfterColons (emit head refs)

                Colon ->
                    walkPiece sep Colon AfterColons (emit head refs)

                Other ->
                    walkPiece sep Other AfterColons (emit head refs)


-- The walk after `piece` with no chain open: a word opens a chain, a `.`
-- (or a `:` where paths join with `::`) may open a separator.
startAt : Separator -> Piece -> List Reference -> ( Walk, List Reference )
startAt sep piece refs =
    case piece of
        Word w reserved ->
            ( InChain (Emit w 1 reserved), refs )

        Dot ->
            ( AfterDot, refs )

        Colon ->
            case sep of
                DoubleColonSeparator ->
                    ( AfterColon, refs )

                DotSeparator ->
                    ( Between, refs )

        Other ->
            ( Between, refs )


extend : Head -> String -> String -> Head
extend head sep w =
    case head of
        Emit text segments reserved ->
            Emit (text ++ sep ++ w) (segments + 1) reserved

        Discard ->
            Discard


-- A closed chain's reference: a path of two or more segments, or a bare
-- name that is no keyword.
emit : Head -> List Reference -> List Reference
emit head refs =
    case head of
        Emit text segments reserved ->
            if segments > 1 then
                refs ++ [ Path text ]

            else if reserved then
                refs

            else
                refs ++ [ Bare text ]

        Discard ->
            refs


closeWalk : Walk -> List Reference -> List Reference
closeWalk walk refs =
    case walk of
        InChain head ->
            emit head refs

        ChainDot head ->
            emit head refs

        ChainColon head ->
            emit head refs

        ChainColons head ->
            emit head refs

        Between ->
            refs

        AfterDot ->
            refs

        AfterColon ->
            refs

        AfterColons ->
            refs


-- The qualified names a page looks up for its references, under ipe-index's
-- callee rule (`tools/ipe-index/src/extract/treesitter.rs`, pass 2): a path
-- is looked up exactly, with a Rust `crate::` prefix rewritten to the unit's
-- own crate; a bare name is looked up exactly, then in the unit's own module.
-- `lookups` holds each distinct reference's alternatives in that order;
-- `names` holds every distinct alternative, in first-occurrence order. The
-- first reference whose alternatives would carry `names` past
-- `linkCandidateCeiling` is not looked up, nor is any after it, and `reach`
-- says so. A unit whose kind, name or qualified name is longer than its
-- window looks nothing up, and `reach` is `Capped`: the page says links may
-- be missing rather than linking from a prefix.
type alias Candidates =
    { lookups : List (List String)
    , names : List String
    , reach : Reach
    }


type alias CandidateAcc =
    { lookups : List (List String)
    , names : List String
    , count : Int
    }


candidates : Lang -> UnitName -> List Reference -> Candidates
candidates lang columns refs =
    case wholeName columns of
        Just unit ->
            candidatesOf lang unit refs

        Nothing ->
            { lookups = [], names = [], reach = Capped }


candidatesOf : Lang -> WholeName -> List Reference -> Candidates
candidatesOf lang unit refs =
    let
        rule =
            Highlight.pathRule lang

        base =
            moduleBase rule unit
    in
    case List.foldl candidateStep (Open Set.empty { lookups = [], names = [], count = 0 }) (List.map (alternatives rule unit base) (distinctReferences refs)) of
        Open _ acc ->
            { lookups = acc.lookups, names = acc.names, reach = Complete }

        Full acc ->
            { lookups = acc.lookups, names = acc.names, reach = Capped }


-- The candidate fold: open, with the names seen so far, or full once a
-- reference's alternatives would pass `linkCandidateCeiling`, after which
-- every later reference is passed over unread.
type CandidateFold
    = Open (Set String) CandidateAcc
    | Full CandidateAcc


candidateStep : List String -> CandidateFold -> CandidateFold
candidateStep alts fold =
    case fold of
        Full acc ->
            Full acc

        Open seen acc ->
            let
                fresh =
                    distinctNew seen alts
            in
            if acc.count + List.length fresh > linkCandidateCeiling then
                Full acc

            else
                Open
                    (List.foldl Set.insert seen fresh)
                    { lookups = acc.lookups ++ [ alts ]
                    , names = acc.names ++ fresh
                    , count = acc.count + List.length fresh
                    }


-- The names of `alts` not in `seen`, each once, in order.
distinctNew : Set String -> List String -> List String
distinctNew seen alts =
    case alts of
        [] ->
            []

        a :: rest ->
            if Set.member a seen then
                distinctNew seen rest

            else
                a :: distinctNew (Set.insert a seen) rest


distinctReferences : List Reference -> List Reference
distinctReferences refs =
    firstByKey referenceKey compare refs


-- The items of `xs` whose key no earlier item has, in their order. One
-- stable sort by key puts each key's items together in input order, the
-- first of each run is kept, and a sort by position restores the order:
-- `O(n log n)`, and no step copies what the walk has built so far.
firstByKey : (a -> k) -> (k -> k -> Order) -> List a -> List a
firstByKey key order xs =
    case List.foldl (keepRunHead order) ( Nothing, [] ) (List.sortWith (\( j, _ ) ( k, _ ) -> order j k) (List.indexedMap (\i x -> ( key x, ( i, x ) )) xs)) of
        ( _, kept ) ->
            List.map (\( _, x ) -> x) (List.sortBy (\( i, _ ) -> i) kept)


keepRunHead : (k -> k -> Order) -> ( k, ( Int, a ) ) -> ( Maybe k, List ( Int, a ) ) -> ( Maybe k, List ( Int, a ) )
keepRunHead order ( k, item ) ( previous, kept ) =
    case previous of
        Just p ->
            if order p k == EQ then
                ( previous, kept )

            else
                ( Just k, item :: kept )

        Nothing ->
            ( Just k, item :: kept )


referenceKey : Reference -> String
referenceKey ref =
    case ref of
        Path p ->
            "p:" ++ p

        Bare t ->
            "b:" ++ t


alternatives : Maybe PathRule -> WholeName -> Maybe String -> Reference -> List String
alternatives rule unit base ref =
    case ref of
        Path p ->
            [ ownRootRewrite rule unit p ]

        Bare t ->
            case ( rule, base ) of
                ( Just r, Just b ) ->
                    [ t, b ++ separatorText r.separator ++ t ]

                ( Just _, Nothing ) ->
                    [ t ]

                ( Nothing, _ ) ->
                    [ t ]


-- A path opening with its language's own-root word and separator (Rust
-- `crate::`) names the unit's own crate: the first segment of its qualified
-- name, the crate root ipe-index roots every module path at. A language
-- with no such word looks every path up as written.
ownRootRewrite : Maybe PathRule -> WholeName -> String -> String
ownRootRewrite rule unit path =
    case rule of
        Just r ->
            case r.ownRoot of
                Just root ->
                    rootedAt (separatorText r.separator) (root ++ separatorText r.separator) unit path

                Nothing ->
                    path

        Nothing ->
            path


rootedAt : String -> String -> WholeName -> String -> String
rootedAt sep prefix unit path =
    if String.startsWith prefix path then
        case List.head (String.split sep unit.qualified) of
            Just ownCrate ->
                ownCrate ++ sep ++ String.dropLeft (String.length prefix) path

            Nothing ->
                path

    else
        path


-- The text a path's segments are joined with, as ipe-index joins a module
-- and a unit name.
separatorText : Separator -> String
separatorText sep =
    case sep of
        DotSeparator ->
            "."

        DoubleColonSeparator ->
            "::"


-- The unit's own module: its qualified name without a trailing `#<digits>`
-- duplicate ordinal, then without `separator ++ name` at its end. A file
-- unit, a qualified name without that suffix, and a language that spells no
-- path have none.
moduleBase : Maybe PathRule -> WholeName -> Maybe String
moduleBase rule unit =
    case rule of
        Just r ->
            moduleUnder (separatorText r.separator) unit

        Nothing ->
            Nothing


moduleUnder : String -> WholeName -> Maybe String
moduleUnder sep unit =
    let
        qualified =
            dropOrdinal unit.qualified

        suffix =
            sep ++ unit.name
    in
    if unit.kind == "file" || unit.name == "" then
        Nothing

    else if String.endsWith suffix qualified && String.length qualified > String.length suffix then
        Just (String.dropRight (String.length suffix) qualified)

    else
        Nothing


-- `q#<digits>` is `q`; any other name is itself.
dropOrdinal : String -> String
dropOrdinal qualified =
    case List.reverse (String.split "#" qualified) of
        digits :: first :: restRev ->
            if digits /= "" && String.all Char.isDigit digits then
                String.join "#" (List.reverse (first :: restRev))

            else
                qualified

        _ ->
            qualified


-- The links of `lookups` given the `(qualified, uid)` rows the candidate
-- query returned: each lookup links its first alternative that resolved. A
-- row whose uid the read did not return whole (`Nothing`) still resolves
-- its name, shown unlinked.
resolveCandidates : List (List String) -> List ( String, Maybe String ) -> List Link
resolveCandidates lookups rows =
    let
        found =
            Dict.fromList rows
    in
    List.filterMap (firstResolved found) lookups


firstResolved : Dict String (Maybe String) -> List String -> Maybe Link
firstResolved found alts =
    case alts of
        [] ->
            Nothing

        a :: rest ->
            case Dict.get a found of
                Just (Just uid) ->
                    Just (internal (Label.fromText Label.labelCap a) uid)

                Just Nothing ->
                    Just (Unlinked (Label.fromText Label.labelCap a))

                Nothing ->
                    firstResolved found rest


-- The http(s) URLs among the source's words, with the punctuation prose
-- attaches (`(https://a.io/b),`) trimmed from both ends.
sourceUrls : String -> List Link
sourceUrls source =
    source
        |> String.words
        |> List.map trimPunct
        |> List.filter isUrl
        |> List.map external


isUrl : String -> Bool
isUrl token =
    String.startsWith "http://" token || String.startsWith "https://" token


-- The word without its leading and trailing punctuation: one pass finds
-- the first and the last character that is not punctuation, and the word is
-- cut between them once, so the cost is linear in the word.
trimPunct : String -> String
trimPunct token =
    case (String.foldl trimStep { at = 0, kept = Nothing } token).kept of
        Just ( start, end ) ->
            String.slice start end token

        Nothing ->
            ""


-- Where `trimPunct` is: the index of the next character, and the span from
-- the first to just past the latest character that is not punctuation.
type alias Trim =
    { at : Int, kept : Maybe ( Int, Int ) }


trimStep : Char -> Trim -> Trim
trimStep c trim =
    if isPunct c then
        { trim | at = trim.at + 1 }

    else
        case trim.kept of
            Just ( start, _ ) ->
                { at = trim.at + 1, kept = Just ( start, trim.at + 1 ) }

            Nothing ->
                { at = trim.at + 1, kept = Just ( trim.at, trim.at + 1 ) }


-- Char literals for quote/backslash escapes crash the formatter (IPE-I0001
-- MalformedChar), so the punctuation set comes from a String instead.
punctChars : List Char
punctChars =
    String.toList "'()[]{},;.!?<>\"`:-="


isPunct : Char -> Bool
isPunct c =
    List.member c punctChars


-- First occurrence wins: a link is kept only when no earlier link has its
-- comparable `linkKey`.
dedup : List Link -> List Link
dedup links =
    firstByKey linkKey linkKeyOrder links


-- The name a link shows, a bounded label: an internal or unlinked target's
-- qualified name, an external link's URL.
label : Link -> Label
label link =
    case link of
        Internal name _ ->
            name

        External (ExternalUrl url) ->
            url.shown

        Unlinked name ->
            name


-- The tool's mark before a link's label: `→` for a unit, `↗` for a URL, none
-- for a name that links nowhere.
mark : Link -> Maybe SafeText
mark link =
    case link of
        Internal _ _ ->
            Just (SafeText.literal "→ ")

        External _ ->
            Just (SafeText.literal "↗ ")

        Unlinked _ ->
            Nothing


-- The raw URL an external link targets, when it fits `hrefByteCeiling`.
href : ExternalUrl -> Maybe String
href url =
    case url of
        ExternalUrl u ->
            u.href


-- A link's dedup key: a unit's uid, a targeted URL whole, or the label of
-- an untargeted URL or an unlinked name, which tells two names apart as far
-- as their labels do. Each kind is a constructor of its own, so keys of two
-- kinds never meet, and a unit's key holds its uid as a `UidKey`, never as
-- text.
type LinkKey
    = InternalKey Uid.UidKey
    | TargetedKey String
    | UntargetedKey String
    | UnlinkedKey String


linkKey : Link -> LinkKey
linkKey link =
    case link of
        Internal _ uid ->
            InternalKey (Uid.key uid)

        External (ExternalUrl url) ->
            case url.href of
                Just raw ->
                    TargetedKey raw

                Nothing ->
                    UntargetedKey (Label.key url.shown)

        Unlinked name ->
            UnlinkedKey (Label.key name)


-- A total order on link keys: by kind, then by the key within its kind.
linkKeyOrder : LinkKey -> LinkKey -> Order
linkKeyOrder a b =
    case compare (keyKind a) (keyKind b) of
        LT ->
            LT

        EQ ->
            withinKind a b

        GT ->
            GT


-- The order of two keys of one kind: `a`'s key against `b`'s, read through
-- the projection of `a`'s kind.
withinKind : LinkKey -> LinkKey -> Order
withinKind a b =
    case a of
        InternalKey x ->
            Maybe.withDefault EQ (Maybe.map (Uid.keyOrder x) (internalOf b))

        TargetedKey x ->
            Maybe.withDefault EQ (Maybe.map (compare x) (textOf b))

        UntargetedKey x ->
            Maybe.withDefault EQ (Maybe.map (compare x) (textOf b))

        UnlinkedKey x ->
            Maybe.withDefault EQ (Maybe.map (compare x) (textOf b))


internalOf : LinkKey -> Maybe Uid.UidKey
internalOf key =
    case key of
        InternalKey x ->
            Just x

        TargetedKey _ ->
            Nothing

        UntargetedKey _ ->
            Nothing

        UnlinkedKey _ ->
            Nothing


textOf : LinkKey -> Maybe String
textOf key =
    case key of
        InternalKey _ ->
            Nothing

        TargetedKey x ->
            Just x

        UntargetedKey x ->
            Just x

        UnlinkedKey x ->
            Just x


keyKind : LinkKey -> Int
keyKind key =
    case key of
        InternalKey _ ->
            0

        TargetedKey _ ->
            1

        UntargetedKey _ ->
            2

        UnlinkedKey _ ->
            3


isCut : LabelPart -> Bool
isCut part =
    case part of
        LabelCut _ _ ->
            True

        LabelText _ ->
            False

        LabelEscapes _ ->
            False
