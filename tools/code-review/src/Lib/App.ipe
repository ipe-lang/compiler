module Lib.App exposing (DecisionTarget(..), Model, Msg(..), Page(..), decisionSaved, decisionTask, historyLoaded, initialModel, queueList, queueLoaded, selectedUid, selectedUnit, standingLoaded, unitPageState, update, viewLoaded)

import Ipe.Error as Error exposing (Error)
import Ipe.List as List
import Ipe.Result exposing (Result(..))
import Ipe.Task as Task
import Ipe.Tea.Web.Cmd as Cmd
import Lib.Db as LibDb exposing (Decision(..), HistoryCursor(..))
import Lib.Epoch exposing (Epoch)
import Lib.Failure as Failure exposing (DecideRefusal(..), LoadFailure, RefuseFailure(..), SaveFailure(..))
import Lib.Index as Index
import Lib.Keys as Keys exposing (KeyAction(..))
import Lib.Queue as Queue exposing (DecisionSlot(..), HistoryState(..), RefusalPanel(..), QueueState(..), SelectedView(..), UnitPageState(..))
import Lib.ReviewKey exposing (MacKey, ReviewKey(..))
import Lib.ServerLog as ServerLog
import Lib.Settings as Settings
import Lib.Uid exposing (Uid)


type Page
    = QueuePage
    | HistoryPage
    | UnitPage String


-- `queueCursor` is where the shown queue page starts; a reload after a
-- decision re-reads that page only. The Model is plain data persisted to the
-- session store; the startup settings are not part of it and reach every
-- handler as its first argument. `selectedView` is the session's one source
-- read slot, read by the queue card and the unit page alike, and `decision`
-- its one decision slot, so a second read or decision in flight has no
-- representation; the slot also holds the notice of a decision that was not
-- saved, so a notice and a busy decision are never both shown, and the
-- refusal panel with its draft, so a panel open beside a busy decision is
-- never shown either. `standing` is the unit page's read of where its shown
-- body stands in the review log. Like every failure the Model holds, each
-- is a typed case that never holds an error's text.
type alias Model =
    { page : Page
    , queueState : Queue.QueueState
    , queueCursor : Index.Cursor
    , queueLoad : Queue.LoadTicket
    , history : Queue.HistoryState
    , historyLoad : Queue.LoadTicket
    , selected : Int
    , selectedView : Queue.SelectedView
    , decision : Queue.DecisionSlot
    , standing : Queue.StandingRead
    }


-- A task's result reaches a `Msg` only through the callbacks below, which
-- turn its failure into a typed case, so no `Msg` holds an error.
type Msg
    = PendingLoaded Queue.LoadTicket (Result LoadFailure Queue.QueuePage)
    | NextPage Index.Cursor
    | ApproveUnit Uid
    | RefuseStart Uid
    | RefuseDraft String
    | RefuseCancel
    | RefuseSubmit Uid
    | AckRefusal Uid
    | RefuseRefusalSubmit Uid
    | DecisionSaved Uid Epoch (Result SaveFailure ( Index.Attested, Index.Written ))
    | Navigated Page
    | ShowQueue
    | ShowHistory
    | HistoryPageLoaded Queue.LoadTicket (Result LoadFailure Queue.HistoryPage)
    | HistoryNext LibDb.HistoryCursor
    | SelectedViewLoaded Uid Epoch (Result LoadFailure (Maybe Index.UnitView))
    | StandingLoaded Uid String Epoch (Result LoadFailure Queue.Standing)
    | KeyDown String
    | SelectUnit Int


-- The callbacks every page task settles through: the one place its error
-- becomes a typed case. The error's own text goes to the server log only,
-- through `ServerLog.logged` on the task.
queueLoaded : Queue.LoadTicket -> Result Error Queue.QueuePage -> Msg
queueLoaded load result =
    PendingLoaded load (Failure.loaded result)


historyLoaded : Queue.LoadTicket -> Result Error Queue.HistoryPage -> Msg
historyLoaded load result =
    HistoryPageLoaded load (Failure.loaded result)


viewLoaded : Uid -> Epoch -> Result Error (Maybe Index.UnitView) -> Msg
viewLoaded uid epoch result =
    SelectedViewLoaded uid epoch (Failure.loaded result)


standingLoaded : Uid -> String -> Epoch -> Result Error Queue.Standing -> Msg
standingLoaded uid bodyHash epoch result =
    StandingLoaded uid bodyHash epoch (Failure.loaded result)


decisionSaved : Uid -> Epoch -> Result Error (Result DecideRefusal ( Index.Attested, Index.Written )) -> Msg
decisionSaved uid epoch result =
    DecisionSaved uid epoch (Failure.saved result)


-- The session's first model. It loads nothing: the route entry that follows
-- `init` on every new session (`onNavigate`) loads the page's data, so the
-- route table is the one place a URL maps to a page.
initialModel : Model
initialModel =
    { page = QueuePage
    , queueState = Loading
    , queueCursor = Index.Start
    , queueLoad = Queue.firstTicket
    , history = HistoryLoading
    , historyLoad = Queue.firstTicket
    , selected = 0
    , selectedView = NoneSelected
    , decision = DecisionIdle PanelClosed
    , standing = Queue.StandingUnread
    }


-- The shown page's units, for selection and decisions; a queue that is not
-- loaded has none to act on. What the view renders comes from
-- `Queue.queueStatusText`, so this list never stands for "empty".
queueList : Model -> List Queue.QueuedUnit
queueList model =
    case model.queueState of
        Loaded page ->
            page.units

        Loading ->
            []

        Failed _ ->
            []


-- The queue card at the selected index, if the shown page has one.
selectedUnit : Model -> Maybe Queue.QueuedUnit
selectedUnit model =
    List.head (List.drop model.selected (queueList model))


selectedUid : Model -> Maybe Uid
selectedUid model =
    case selectedUnit model of
        Just q ->
            Just q.unit.uid

        Nothing ->
            Nothing


-- The unit page's state, from its address and the session's one source slot:
-- an address that names no unit is refused, and any other reads the slot.
unitPageState : String -> Model -> Queue.UnitPageState
unitPageState raw model =
    case Queue.unitPageEntry raw of
        Ok uid ->
            Queue.unitPageOf uid model.selectedView

        Err refused ->
            refused


-- A page entered, with the Cmd that loads its data: the one entry path, run
-- on every URL entry (first request, reload, link, back and forward,
-- reconnect) through `onNavigate`, and by the header buttons. The entry
-- adopts the decision slot for this process, so a busy decision another
-- process left behind shows no pending state. The queue page
-- reloads the queue; any other page loads the queue too while it is not
-- loaded, since the header shows its progress on every page. History shows
-- no source, so it clears the source slot; a read in flight stays recorded.
enterPage : Settings.AppSettings -> Page -> Model -> ( Model, Cmd Msg )
enterPage settings page model =
    let
        entered =
            { model | page = page, decision = Queue.ownedSlot settings.epoch model.decision }
    in
    case page of
        QueuePage ->
            loadQueue settings entered.queueCursor entered

        HistoryPage ->
            withQueue settings (loadHistory settings HistoryStart { entered | selectedView = Queue.clearView settings.epoch entered.selectedView })

        UnitPage raw ->
            case Queue.unitPageEntry raw of
                Ok uid ->
                    withQueue settings (loadUnit settings uid entered)

                Err _ ->
                    ( { entered | selectedView = Queue.clearView settings.epoch entered.selectedView }, Cmd.none )


-- The queue page from `cursor`, under the queue's next load ticket; the shown
-- page stays until the result settles it.
loadQueue : Settings.AppSettings -> Index.Cursor -> Model -> ( Model, Cmd Msg )
loadQueue settings cursor model =
    let
        load =
            Queue.nextTicket model.queueLoad
    in
    ( { model | queueCursor = cursor, queueLoad = load }
    , Cmd.perform (ServerLog.logged "queue load failed" (Queue.loadPage settings cursor)) (queueLoaded load)
    )


-- An entry, plus a queue load while the queue is not loaded.
withQueue : Settings.AppSettings -> ( Model, Cmd Msg ) -> ( Model, Cmd Msg )
withQueue settings ( model, cmd ) =
    case model.queueState of
        Loaded _ ->
            ( model, cmd )

        Loading ->
            alsoQueue settings cmd model

        Failed _ ->
            alsoQueue settings cmd model


alsoQueue : Settings.AppSettings -> Cmd Msg -> Model -> ( Model, Cmd Msg )
alsoQueue settings cmd model =
    let
        ( queued, queueCmd ) =
            loadQueue settings model.queueCursor model
    in
    ( queued, Cmd.batch [ cmd, queueCmd ] )


-- One History page loaded from `cursor`, under the History slot's next load
-- ticket.
loadHistory : Settings.AppSettings -> LibDb.HistoryCursor -> Model -> ( Model, Cmd Msg )
loadHistory settings cursor model =
    let
        load =
            Queue.nextTicket model.historyLoad
    in
    ( { model | history = HistoryLoading, historyLoad = load }
    , Cmd.perform (ServerLog.logged "history load failed" (Queue.loadHistoryPage settings cursor)) (historyLoaded load)
    )


-- The unit page of `uid`, read afresh through the session's one source slot:
-- during a read in flight it is only recorded as wanted, so entries made
-- while a read runs start no second read.
loadUnit : Settings.AppSettings -> Uid -> Model -> ( Model, Cmd Msg )
loadUnit settings uid model =
    viewStep settings (Queue.reloadView settings.epoch uid model.selectedView) model


update : Settings.AppSettings -> Msg -> Model -> ( Model, Cmd Msg )
update settings msg model =
    case msg of
        PendingLoaded load result ->
            if Queue.isCurrentLoad load model.queueLoad then
                let
                    loaded =
                        { model | queueState = Queue.stateFromResult result, decision = Queue.queueSettled load result model.decision }
                in
                viewAfterLoad settings { loaded | selected = clampIndex model.selected (List.length (queueList loaded)) }

            else
                ( model, Cmd.none )

        NextPage cursor ->
            loadQueue settings cursor { model | queueState = Loading, selected = 0 }

        ApproveUnit uid ->
            saveDecision settings model OnUnit uid Approved

        AckRefusal uid ->
            saveDecision settings model OnRefusal uid Approved

        RefuseStart uid ->
            ( { model | decision = Queue.openRefusal settings.epoch uid model.decision }, Cmd.none )

        RefuseDraft text ->
            ( { model | decision = Queue.editDraft text model.decision }, Cmd.none )

        RefuseCancel ->
            ( { model | decision = Queue.closeRefusal model.decision }, Cmd.none )

        RefuseSubmit uid ->
            submitRefuse settings model OnUnit uid

        RefuseRefusalSubmit uid ->
            submitRefuse settings model OnRefusal uid

        DecisionSaved uid epoch result ->
            case result of
                Ok ( attested, written ) ->
                    let
                        load =
                            Queue.nextTicket model.queueLoad
                    in
                    ( { model | decision = Queue.decisionWritten epoch uid model.decision, queueLoad = load }, drainAndReload settings model attested written load )

                Err failure ->
                    ( { model | decision = Queue.decisionNotSaved epoch uid failure model.queueLoad model.decision }, Cmd.none )

        Navigated page ->
            enterPage settings page model

        ShowQueue ->
            enterPage settings QueuePage model

        ShowHistory ->
            enterPage settings HistoryPage model

        HistoryPageLoaded load result ->
            if Queue.isCurrentLoad load model.historyLoad then
                ( { model | history = Queue.historyStateFromResult result }, Cmd.none )

            else
                ( model, Cmd.none )

        HistoryNext cursor ->
            loadHistory settings cursor model

        SelectedViewLoaded uid epoch result ->
            withStanding settings (viewStep settings (Queue.viewArrived epoch uid result model.selectedView) model)

        StandingLoaded uid bodyHash epoch result ->
            if epoch /= settings.epoch then
                ( model, Cmd.none )

            else
                ( { model | standing = Queue.standingArrived uid bodyHash result }, Cmd.none )

        KeyDown key ->
            if model.page == QueuePage then
                keyActionMsg settings (Keys.keyAction (Queue.openPanel model.decision /= Nothing) (List.length (queueList model)) model.selected key) model

            else
                ( model, Cmd.none )

        SelectUnit i ->
            if model.page == QueuePage then
                selectAt settings i model

            else
                ( model, Cmd.none )


-- A source read settled: on the unit page, a shown unit's standing is read
-- for the body shown, so the page says whether that body is decided.
withStanding : Settings.AppSettings -> ( Model, Cmd Msg ) -> ( Model, Cmd Msg )
withStanding settings ( model, cmd ) =
    case model.page of
        UnitPage raw ->
            case unitPageState raw model of
                UnitLoaded loaded ->
                    let
                        bodyHash =
                            Index.storedHash loaded.unit.attested
                    in
                    ( model
                    , Cmd.batch [ cmd, Cmd.perform (ServerLog.logged "standing load failed" (Queue.loadStanding settings loaded.unit.uid bodyHash)) (standingLoaded loaded.unit.uid bodyHash settings.epoch) ]
                    )

                UnitLoading ->
                    ( model, cmd )

                UnitNotFound ->
                    ( model, cmd )

                UnitFailed _ ->
                    ( model, cmd )

                UnitIdRefused ->
                    ( model, cmd )

        QueuePage ->
            ( model, cmd )

        HistoryPage ->
            ( model, cmd )


-- The selected card's view after a queue load: on the queue page the
-- selected unit is read afresh, since the load may follow a decision or a
-- reindex. History shows no source, so the slot is cleared. The unit page
-- owns the slot for its own unit, so a queue load leaves it alone.
viewAfterLoad : Settings.AppSettings -> Model -> ( Model, Cmd Msg )
viewAfterLoad settings model =
    case ( model.page, selectedUid model ) of
        ( QueuePage, Just uid ) ->
            viewStep settings (Queue.reloadView settings.epoch uid model.selectedView) model

        ( QueuePage, Nothing ) ->
            ( { model | selectedView = Queue.clearView settings.epoch model.selectedView }, Cmd.none )

        ( HistoryPage, _ ) ->
            ( { model | selectedView = Queue.clearView settings.epoch model.selectedView }, Cmd.none )

        ( UnitPage _, _ ) ->
            ( model, Cmd.none )


-- The queue card at `i` selected, reading its view when it is not shown.
selectAt : Settings.AppSettings -> Int -> Model -> ( Model, Cmd Msg )
selectAt settings i model =
    let
        moved =
            { model | selected = clampIndex i (List.length (queueList model)) }
    in
    case selectedUid moved of
        Just uid ->
            viewStep settings (Queue.selectView settings.epoch uid moved.selectedView) moved

        Nothing ->
            ( moved, Cmd.none )


-- A source-slot transition, with the one read it starts, if any: the only
-- place a source read is started, its result stamped with this process's
-- epoch.
viewStep : Settings.AppSettings -> ( Queue.SelectedView, Maybe Uid ) -> Model -> ( Model, Cmd Msg )
viewStep settings ( state, next ) model =
    ( { model | selectedView = state }, loadViewCmd settings next )


loadViewCmd : Settings.AppSettings -> Maybe Uid -> Cmd Msg
loadViewCmd settings next =
    case next of
        Just uid ->
            Cmd.perform (ServerLog.logged "source load failed" (Queue.loadUnitView settings.index uid)) (viewLoaded uid settings.epoch)

        Nothing ->
            Cmd.none


-- Every KeyAction dispatches the same Msg the matching button sends —
-- the buttons remain the single source of truth; the keys are a mirror.
keyActionMsg : Settings.AppSettings -> KeyAction -> Model -> ( Model, Cmd Msg )
keyActionMsg settings action model =
    case action of
        ApproveSelected ->
            case selectedUid model of
                Just uid ->
                    saveDecision settings model OnUnit uid Approved

                Nothing ->
                    ( model, Cmd.none )

        RefuseSelected ->
            case selectedUid model of
                Just uid ->
                    ( { model | decision = Queue.openRefusal settings.epoch uid model.decision }, Cmd.none )

                Nothing ->
                    ( model, Cmd.none )

        Select i ->
            selectAt settings i model

        ConfirmRefuse ->
            case Queue.openPanel model.decision of
                Just ( uid, _ ) ->
                    submitRefuse settings model (targetOf model uid) uid

                Nothing ->
                    ( model, Cmd.none )

        CancelRefuse ->
            ( { model | decision = Queue.closeRefusal model.decision }, Cmd.none )

        Ignore ->
            ( model, Cmd.none )


-- The open panel's draft is parsed into a bounded `Reason` here, the one
-- point where the reviewer's text enters; a blank or over-long draft stays
-- open with why. A submit for any row but the one the panel is open on
-- decides nothing and keeps the draft. The panel is closed before the
-- decision is asked, so the decision's own state is what the row shows.
submitRefuse : Settings.AppSettings -> Model -> DecisionTarget -> Uid -> ( Model, Cmd Msg )
submitRefuse settings model target uid =
    case Queue.openPanel model.decision of
        Just ( open, draft ) ->
            if open == uid then
                case LibDb.parseReason draft.refuseDraft of
                    Err refused ->
                        ( { model | decision = Queue.draftRefused (DraftRefused refused) model.decision }, Cmd.none )

                    Ok reason ->
                        saveDecision settings { model | decision = Queue.closeRefusal model.decision } target uid (Refused reason)

            else
                ( model, Cmd.none )

        Nothing ->
            ( model, Cmd.none )


clampIndex : Int -> Int -> Int
clampIndex i len =
    max 0 (min i (len - 1))


-- What a decision is asked on: a queued unit, decided on its shown source,
-- or an unreviewable file the loaded page lists, decided on its digest.
type DecisionTarget
    = OnUnit
    | OnRefusal


-- The target of a decision asked by uid alone (the refusal panel's key):
-- an unreviewable file when the loaded page lists one under `uid`, a unit
-- otherwise.
targetOf : Model -> Uid -> DecisionTarget
targetOf model uid =
    case pageRefusal model uid of
        Just _ ->
            OnRefusal

        Nothing ->
            OnUnit


pageRefusal : Model -> Uid -> Maybe Index.RefusalRow
pageRefusal model uid =
    case model.queueState of
        Loaded page ->
            List.find (\row -> row.uid == uid) page.refusals

        Loading ->
            Nothing

        Failed _ ->
            Nothing


-- Every decision, from a button or a key, takes the session's one decision
-- slot and goes through `Queue.decide` on the selected unit's shown source,
-- or `Queue.decideRefusal` on a listed unreviewable file's digest, each
-- re-proved before writing. A decision asked off the queue page is
-- refused before it takes the slot, and so is one asked on a server with no
-- signing key, each with a notice saying why; one asked while another is
-- busy starts nothing, and that decision's pending state stays shown.
saveDecision : Settings.AppSettings -> Model -> DecisionTarget -> Uid -> LibDb.Decision -> ( Model, Cmd Msg )
saveDecision settings model target uid decision =
    if model.page /= QueuePage then
        ( { model | decision = Queue.decisionRefused settings.epoch SaveOffQueue model.queueLoad model.decision }, Cmd.none )

    else
        case settings.key of
            ReadOnly ->
                ( { model | decision = Queue.decisionRefused settings.epoch SaveReadOnly model.queueLoad model.decision }, Cmd.none )

            Signing macKey ->
                case Queue.startDecision settings.epoch uid model.decision of
                    Just saving ->
                        ( { model | decision = saving }
                        , Cmd.perform (ServerLog.logged "decision save failed" (decisionTask settings macKey model target uid decision)) (decisionSaved uid settings.epoch)
                        )

                    Nothing ->
                        ( model, Cmd.none )


-- The decision on `uid`'s shown source or listed unreviewable file, or its
-- refusal when the unit or file is off the shown queue page, its source is
-- not shown, or the file is one no decision acknowledges, decided before
-- anything is read.
decisionTask : Settings.AppSettings -> MacKey -> Model -> DecisionTarget -> Uid -> LibDb.Decision -> Task.Task Error (Result DecideRefusal ( Index.Attested, Index.Written ))
decisionTask settings macKey model target uid decision =
    case target of
        OnUnit ->
            case List.find (\q -> q.unit.uid == uid) (queueList model) of
                Just _ ->
                    case Queue.decidableSource uid model.selectedView of
                        Just shown ->
                            decideOn settings macKey shown decision

                        Nothing ->
                            Task.succeed (Err SourceNotShown)

                Nothing ->
                    Task.succeed (Err NotQueued)

        OnRefusal ->
            case pageRefusal model uid of
                Just row ->
                    case row.digest of
                        Just digest ->
                            LibDb.openAt settings.review |> Task.andThen (\db -> Queue.decideRefusal macKey settings.index db uid digest decision)

                        Nothing ->
                            Task.succeed (Err FileNotAcknowledgeable)

                Nothing ->
                    Task.succeed (Err FileNotQueued)


decideOn : Settings.AppSettings -> MacKey -> Index.ShownSource -> LibDb.Decision -> Task.Task Error (Result DecideRefusal ( Index.Attested, Index.Written ))
decideOn settings macKey shown decision =
    LibDb.openAt settings.review |> Task.andThen (\db -> Queue.decide macKey settings.index db shown decision)


-- The drain loop: the decision is already saved (DecisionSaved Ok), so the
-- pair enters the index's `reviewed` copy under the attested hash the
-- decision was written with, and the copy's stamp follows the review log's
-- head as the write moved it. A failure anywhere fails closed with the queue
-- unchanged — the unit stays visible with its badge and the next load
-- rebuilds the copy.
drainAndReload : Settings.AppSettings -> Model -> Index.Attested -> Index.Written -> Queue.LoadTicket -> Cmd Msg
drainAndReload settings model attested written load =
    Cmd.perform (ServerLog.logged "queue load failed" (Queue.drainThenLoad settings attested written model.queueCursor)) (queueLoaded load)
