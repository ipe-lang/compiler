module Lib.App exposing (decisionSaved, historyLoaded, queueLoaded, run, standingLoaded, update, viewLoaded)

import Ipe.Error as Error exposing (Error)
import Ipe.List as List
import Ipe.Result exposing (Result(..))
import Ipe.Task as Task
import Ipe.Tea.Web.Cmd as Cmd
import Lib.Db as LibDb
import Lib.Failure as Failure exposing (DecideRefusal)
import Lib.History as History exposing (HistoryWant(..))
import Lib.Index as Index
import Lib.Queue as Queue exposing (QueueWant(..))
import Lib.ReviewKey exposing (MacKey)
import Lib.ServerLog as ServerLog
import Lib.Session as Session exposing (DecisionPlan(..), Effect(..), Model, Msg(..))
import Lib.Settings as Settings
import Lib.Slot as Slot exposing (Stamp)
import Lib.Standing as Standing
import Lib.Uid exposing (Uid)


-- The session's step, with each effect it returns performed: the one place
-- a session task is started. The step builds the model; this only runs
-- what the step asked for.
update : Settings.AppSettings -> Msg -> Model -> ( Model, Cmd Msg )
update settings msg model =
    case Session.step settings msg model of
        ( next, effects ) ->
            ( next, Cmd.batch (List.map (run settings) effects) )


-- The task an effect names, settled through its slot's callback with the
-- stamp the effect carries, copied and never minted here.
run : Settings.AppSettings -> Effect -> Cmd Msg
run settings effect =
    case effect of
        LoadQueue load want ->
            Cmd.perform (ServerLog.logged "queue load failed" (queueTask settings want)) (queueLoaded load)

        LoadHistory load (HistoryFrom cursor) ->
            Cmd.perform (ServerLog.logged "history load failed" (History.loadHistoryPage settings cursor)) (historyLoaded load)

        LoadView read ->
            Cmd.perform (ServerLog.logged "source load failed" (Queue.loadUnitView settings.index (Slot.stampKey read))) (viewLoaded read)

        LoadStanding reading ->
            let
                ( uid, bodyHash ) =
                    Slot.stampKey reading
            in
            Cmd.perform (ServerLog.logged "standing load failed" (Standing.loadStanding settings uid bodyHash)) (standingLoaded reading)

        SaveDecision saving macKey plan decision ->
            Cmd.perform (ServerLog.logged "decision save failed" (decidePlan settings macKey plan decision)) (decisionSaved saving)


-- The callbacks every page task settles through: the one place its error
-- becomes a typed case, so no `Msg` holds an error. The error's own text
-- goes to the server log only, through `ServerLog.logged` on the task. Each
-- carries the stamp of the task it settles, copied from the slot's start,
-- never minted here.
queueLoaded : Stamp Slot.LoadTicket -> Result Error Queue.QueuePage -> Msg
queueLoaded load result =
    PendingLoaded load (Failure.loaded result)


historyLoaded : Stamp Slot.LoadTicket -> Result Error History.HistoryPage -> Msg
historyLoaded load result =
    HistoryPageLoaded load (Failure.loaded result)


viewLoaded : Stamp Uid -> Result Error (Maybe Index.UnitView) -> Msg
viewLoaded read result =
    SelectedViewLoaded read (Failure.loaded result)


standingLoaded : Stamp Standing.StandingKey -> Result Error Standing.Standing -> Msg
standingLoaded read result =
    StandingLoaded read (Failure.loaded result)


decisionSaved : Stamp Uid -> Result Error (Result DecideRefusal ( Index.Attested, Index.Written )) -> Msg
decisionSaved saving result =
    DecisionSaved saving (Failure.saved result)


-- A queue load's read. A drain runs after a decision is already saved
-- (DecisionSaved Ok): the pair enters the index's `reviewed` copy under the
-- attested hash the decision was written with, and the copy's stamp follows
-- the review log's head as the write moved it. A failure anywhere fails
-- closed with the queue unchanged — the unit stays visible with its badge
-- and the next load rebuilds the copy.
queueTask : Settings.AppSettings -> Queue.QueueWant -> Task.Task Error Queue.QueuePage
queueTask settings want =
    case want of
        QueueReload cursor ->
            Queue.loadPage settings cursor

        QueueDrain attested written cursor ->
            Queue.drainThenLoad settings attested written cursor


-- The write `plan` names, as `decision` under `macKey`. It reads no
-- session state: each sink re-proves what the plan carries before writing.
decidePlan : Settings.AppSettings -> MacKey -> DecisionPlan -> LibDb.Decision -> Task.Task Error (Result DecideRefusal ( Index.Attested, Index.Written ))
decidePlan settings macKey plan decision =
    case plan of
        WriteUnit shown ->
            decideOn settings macKey shown decision

        WriteFile uid digest ->
            LibDb.openAt settings.review |> Task.andThen (\db -> Queue.decideRefusal macKey settings.index db uid digest decision)


decideOn : Settings.AppSettings -> MacKey -> Index.ShownSource -> LibDb.Decision -> Task.Task Error (Result DecideRefusal ( Index.Attested, Index.Written ))
decideOn settings macKey shown decision =
    LibDb.openAt settings.review |> Task.andThen (\db -> Queue.decide macKey settings.index db shown decision)
