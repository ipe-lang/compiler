module Lib.App exposing (DecisionPlan(..), KeyCard, KeyOffers(..), Model, Msg(..), Page(..), decidableRow, decisionPlan, decisionSaved, historyLoaded, initialModel, keyMode, keyOffers, queueList, queueLoaded, selectedUid, selectedUnit, standingLoaded, unitPageState, update, viewLoaded)

import Ipe.Error as Error exposing (Error)
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Result exposing (Result(..))
import Ipe.Task as Task
import Ipe.Tea.Web.Cmd as Cmd
import Lib.Db as LibDb exposing (Decision(..), HistoryCursor(..))
import Lib.DecisionSlot as DecisionSlot exposing (DecidableRow, DecisionSlot(..), DecisionTarget(..), RefusalPanel(..))
import Lib.Draft as Draft
import Lib.Failure as Failure exposing (DecideRefusal(..), LoadFailure, RefuseFailure(..), SaveFailure(..))
import Lib.History as History exposing (HistoryState(..), HistoryWant(..))
import Lib.Index as Index
import Lib.Keys as Keys exposing (KeyAction(..))
import Lib.Queue as Queue exposing (QueueState(..), QueueWant(..), UnitPageState(..))
import Lib.ReviewKey exposing (MacKey, ReviewKey(..))
import Lib.Selected as Selected exposing (SelectedView(..))
import Lib.ServerLog as ServerLog
import Lib.Settings as Settings
import Lib.Slot as Slot exposing (Settle(..), Stamp)
import Lib.Standing as Standing
import Lib.Uid exposing (Uid)


type Page
    = QueuePage
    | HistoryPage
    | UnitPage String


-- `queueCursor` is where the queue page last asked for starts, so the shown
-- page's cursor once its load settles; a reload after a decision re-reads
-- that page only. The Model is plain data persisted to the
-- session store; the startup settings are not part of it and reach every
-- handler as its first argument. `selectedView` is the session's one source
-- read slot, read by the queue card and the unit page alike, and `decision`
-- its one decision slot, so a second read or decision in flight has no
-- representation; the slot also holds the notice of a decision that was not
-- saved, so a notice and a busy decision are never both shown, and the
-- refusal panel with its draft, so a panel open beside a busy decision is
-- never shown either. `standing` is the unit page's read of where its shown
-- body stands in the review log, and `queueLoad` and `historyLoad` the queue
-- and History page loads. Each of the five slots holds at most one task in
-- flight, started only by the transition that takes it from idle; a request
-- made while it runs is recorded in the slot, never started. A session
-- therefore runs at most five app tasks at once, under the runtime's
-- per-session ceiling on Cmds in flight (`SESSION_CMD_CEILING`, 64, in
-- `src/runtime/rust/src/web/budget.rs`), so the app's own tasks never fill
-- it; a Cmd the ceiling refuses settles its slot with a failure like any
-- other. Like every failure the Model holds, each is a typed case that never
-- holds an error's text.
type alias Model =
    { page : Page
    , queueState : Queue.QueueState
    , queueCursor : Index.Cursor
    , queueLoad : Slot.LoadSlot Queue.QueueWant
    , history : History.HistoryState
    , historyLoad : Slot.LoadSlot History.HistoryWant
    , selected : Int
    , selectedView : Selected.SelectedView
    , decision : DecisionSlot.DecisionSlot
    , standing : Standing.StandingRead
    }


-- A card a render drew for its keys: the selected card's uid with the offer
-- `decidableRow` makes on it (Nothing when the card draws no control).
type alias KeyCard =
    { uid : Uid, offer : Maybe DecidableRow }


-- What a render drew for its keys: an open refusal panel, with its row when
-- the page draws that panel's controls (the row `offeredControls` draws
-- them for); or the selected card, with the offer `decidableRow` makes on
-- it; or no queue page, where no key acts. The root key handler bakes it, so
-- a key acts only on what that render drew, never on what the model selects
-- when the key arrives.
type KeyOffers
    = PanelDrawn (Maybe DecidableRow)
    | CardsDrawn (Maybe KeyCard)
    | NothingDrawn


keyOffers : Model -> KeyOffers
keyOffers model =
    if model.page /= QueuePage then
        NothingDrawn

    else
        case DecisionSlot.openRow model.decision of
            Just ( open, _ ) ->
                PanelDrawn (drawnPanel model open)

            Nothing ->
                CardsDrawn (Maybe.map (\uid -> { uid = uid, offer = decidableRow model uid }) (selectedUid model))


-- The open panel's row when the page draws its controls: the row the page
-- offers under its uid, only while it is the row the panel is open on (the
-- view's own `open == row` in `offeredControls`).
drawnPanel : Model -> DecidableRow -> Maybe DecidableRow
drawnPanel model open =
    case decidableRow model (DecisionSlot.rowUid open) of
        Just row ->
            if row == open then
                Just row

            else
                Nothing

        Nothing ->
            Nothing


-- A key's mode: no key acts off the queue page (either side); a key is
-- typed into a refusal panel when its render drew one or one is open when it
-- arrives, and only the panel row its render drew can be confirmed or
-- cancelled; otherwise shortcuts act on the card the render drew, and the
-- selection moves from where the model stands, over the cards it holds. A
-- reason typed into a panel that has since closed, or the first letter
-- typed before an opening panel was drawn, therefore records and opens
-- nothing.
keyMode : KeyOffers -> Model -> Keys.KeyMode KeyCard DecidableRow
keyMode offers model =
    if model.page /= QueuePage then
        Keys.Dormant

    else
        case offers of
            NothingDrawn ->
                Keys.Dormant

            PanelDrawn drawn ->
                Keys.InPanel drawn

            CardsDrawn card ->
                case DecisionSlot.openPanel model.decision of
                    Just _ ->
                        Keys.InPanel Nothing

                    Nothing ->
                        case Keys.position model.selected (List.length (queueList model)) of
                            Just at ->
                                Keys.OnCards card at

                            Nothing ->
                                Keys.Dormant


-- A task's result reaches a `Msg` only through the callbacks below, which
-- turn its failure into a typed case, so no `Msg` holds an error.
type Msg
    = PendingLoaded (Stamp Slot.LoadTicket) (Result LoadFailure Queue.QueuePage)
    | NextPage Index.Cursor
    | ApproveRow DecidableRow
    | RefuseStart DecidableRow
    | RefuseDraft DecidableRow String
    | RefuseCancel DecidableRow
    | RefuseSubmit DecidableRow
    | DecisionSaved (Stamp Uid) (Result SaveFailure ( Index.Attested, Index.Written ))
    | Navigated Page
    | ShowQueue
    | ShowHistory
    | HistoryPageLoaded (Stamp Slot.LoadTicket) (Result LoadFailure History.HistoryPage)
    | HistoryNext LibDb.HistoryCursor
    | SelectedViewLoaded (Stamp Uid) (Result LoadFailure (Maybe Index.UnitView))
    | StandingLoaded (Stamp Standing.StandingKey) (Result LoadFailure Standing.Standing)
    | KeyDown KeyOffers String
    | SelectUnit Int


-- The callbacks every page task settles through: the one place its error
-- becomes a typed case. The error's own text goes to the server log only,
-- through `ServerLog.logged` on the task. Each carries the stamp of the
-- task it settles, copied from the slot's start, never minted here.
queueLoaded : Stamp Slot.LoadTicket -> Result Error Queue.QueuePage -> Msg
queueLoaded load result =
    PendingLoaded load (Failure.loaded result)


historyLoaded : Stamp Slot.LoadTicket -> Result Error History.HistoryPage -> Msg
historyLoaded load result =
    HistoryPageLoaded load (Failure.loaded result)


viewLoaded : Stamp Uid -> Result Error (Maybe Index.UnitView) -> Msg
viewLoaded read result =
    SelectedViewLoaded read (Failure.loaded result)


standingLoaded : Stamp Standing.StandingKey -> Result Error Standing.Standing -> Msg
standingLoaded read result =
    StandingLoaded read (Failure.loaded result)


decisionSaved : Stamp Uid -> Result Error (Result DecideRefusal ( Index.Attested, Index.Written )) -> Msg
decisionSaved saving result =
    DecisionSaved saving (Failure.saved result)


-- The session's first model. It loads nothing: the route entry that follows
-- `init` on every new session (`onNavigate`) loads the page's data, so the
-- route table is the one place a URL maps to a page.
initialModel : Model
initialModel =
    { page = QueuePage
    , queueState = Loading
    , queueCursor = Index.Start
    , queueLoad = Slot.idleLoad
    , history = HistoryLoading
    , historyLoad = Slot.idleLoad
    , selected = 0
    , selectedView = NoneSelected
    , decision = DecisionIdle PanelClosed
    , standing = Standing.StandingUnread
    }


-- The shown page's units, for selection and decisions; a queue that is not
-- loaded has none to act on. What the view renders comes from
-- `Queue.queueStatusText`, so this list never stands for "empty".
queueList : Model -> List Queue.QueuedUnit
queueList model =
    case model.queueState of
        Loaded page ->
            page.units

        Loading ->
            []

        Failed _ ->
            []


-- The queue card at the selected index, if the shown page has one.
selectedUnit : Model -> Maybe Queue.QueuedUnit
selectedUnit model =
    List.head (List.drop model.selected (queueList model))


selectedUid : Model -> Maybe Uid
selectedUid model =
    case selectedUnit model of
        Just q ->
            Just q.unit.uid

        Nothing ->
            Nothing


-- The unit page's state, from its address and the session's one source slot:
-- an address that names no unit is refused, and any other reads the slot.
unitPageState : String -> Model -> Queue.UnitPageState
unitPageState raw model =
    case Queue.unitPageEntry raw of
        Ok uid ->
            Queue.unitPageOf uid model.selectedView

        Err refused ->
            refused


-- A page entered, with the Cmd that loads its data: the one entry path, run
-- on every URL entry (first request, reload, link, back and forward,
-- reconnect) through `onNavigate`, and by the header buttons. The entry
-- adopts the decision slot for this process, so a busy decision another
-- process left behind shows no pending state. The queue page
-- reloads the queue; any other page loads the queue too while it is not
-- loaded, since the header shows its progress on every page. History shows
-- no source, so it clears the source slot; a read in flight stays recorded.
enterPage : Settings.AppSettings -> Page -> Model -> ( Model, Cmd Msg )
enterPage settings page model =
    let
        entered =
            { model | page = page, decision = DecisionSlot.ownSlot settings.epoch model.decision }
    in
    case page of
        QueuePage ->
            loadQueue settings entered.queueCursor entered

        HistoryPage ->
            withQueue settings (loadHistory settings HistoryStart { entered | selectedView = Selected.clearView settings.epoch entered.selectedView })

        UnitPage raw ->
            case Queue.unitPageEntry raw of
                Ok uid ->
                    withQueue settings (loadUnit settings uid entered)

                Err _ ->
                    ( { entered | selectedView = Selected.clearView settings.epoch entered.selectedView }, Cmd.none )


-- The queue page from `cursor`, asked of the queue's one load slot: it
-- starts now when the slot is idle, or once the load in flight returns. The
-- shown page stays until a result settles it.
loadQueue : Settings.AppSettings -> Index.Cursor -> Model -> ( Model, Cmd Msg )
loadQueue settings cursor model =
    queueStep settings (Slot.requestLoad Queue.mergeQueueWant settings.epoch (QueueReload cursor) model.queueLoad) { model | queueCursor = cursor }


-- An entry, plus a queue load while the queue is not loaded; a load in
-- flight will settle it, so none is asked for beside it.
withQueue : Settings.AppSettings -> ( Model, Cmd Msg ) -> ( Model, Cmd Msg )
withQueue settings ( model, cmd ) =
    case model.queueState of
        Loaded _ ->
            ( model, cmd )

        Loading ->
            alsoQueue settings cmd model

        Failed _ ->
            alsoQueue settings cmd model


alsoQueue : Settings.AppSettings -> Cmd Msg -> Model -> ( Model, Cmd Msg )
alsoQueue settings cmd model =
    let
        ( queued, queueCmd ) =
            queueStep settings (Slot.ensureLoad Queue.mergeQueueWant settings.epoch (QueueReload model.queueCursor) model.queueLoad) model
    in
    ( queued, Cmd.batch [ cmd, queueCmd ] )


-- A queue-slot transition, with the one load it starts, if any: the only
-- place a queue load is started.
queueStep : Settings.AppSettings -> ( Slot.LoadSlot Queue.QueueWant, Maybe ( Stamp Slot.LoadTicket, Queue.QueueWant ) ) -> Model -> ( Model, Cmd Msg )
queueStep settings ( slot, next ) model =
    case next of
        Just ( load, want ) ->
            ( { model | queueLoad = slot }
            , Cmd.perform (ServerLog.logged "queue load failed" (queueTask settings want)) (queueLoaded load)
            )

        Nothing ->
            ( { model | queueLoad = slot }, Cmd.none )


-- A queue load's read. A drain runs after a decision is already saved
-- (DecisionSaved Ok): the pair enters the index's `reviewed` copy under the
-- attested hash the decision was written with, and the copy's stamp follows
-- the review log's head as the write moved it. A failure anywhere fails
-- closed with the queue unchanged — the unit stays visible with its badge
-- and the next load rebuilds the copy.
queueTask : Settings.AppSettings -> Queue.QueueWant -> Task.Task Error Queue.QueuePage
queueTask settings want =
    case want of
        QueueReload cursor ->
            Queue.loadPage settings cursor

        QueueDrain attested written cursor ->
            Queue.drainThenLoad settings attested written cursor


-- One History page loaded from `cursor`, asked of the History slot's one
-- load slot.
loadHistory : Settings.AppSettings -> LibDb.HistoryCursor -> Model -> ( Model, Cmd Msg )
loadHistory settings cursor model =
    historyStep settings (Slot.requestLoad Slot.latestWant settings.epoch (HistoryFrom cursor) model.historyLoad) { model | history = HistoryLoading }


-- A History-slot transition, with the one load it starts, if any: the only
-- place a History load is started.
historyStep : Settings.AppSettings -> ( Slot.LoadSlot History.HistoryWant, Maybe ( Stamp Slot.LoadTicket, History.HistoryWant ) ) -> Model -> ( Model, Cmd Msg )
historyStep settings ( slot, next ) model =
    case next of
        Just ( load, HistoryFrom cursor ) ->
            ( { model | historyLoad = slot }
            , Cmd.perform (ServerLog.logged "history load failed" (History.loadHistoryPage settings cursor)) (historyLoaded load)
            )

        Nothing ->
            ( { model | historyLoad = slot }, Cmd.none )


-- The unit page of `uid`, read afresh through the session's one source slot:
-- during a read in flight it is only recorded as wanted, so entries made
-- while a read runs start no second read.
loadUnit : Settings.AppSettings -> Uid -> Model -> ( Model, Cmd Msg )
loadUnit settings uid model =
    viewStep settings (Selected.reloadView settings.epoch uid model.selectedView) model


-- Every step ends with the refusal panel closed unless the row it is open
-- on is still one the shown page offers a decision on, so a selection,
-- page or load that stops drawing that row closes its panel at this one
-- point.
update : Settings.AppSettings -> Msg -> Model -> ( Model, Cmd Msg )
update settings msg model =
    let
        ( stepped, cmd ) =
            step settings msg model
    in
    ( shownPanel stepped, cmd )


shownPanel : Model -> Model
shownPanel model =
    case DecisionSlot.openRow model.decision of
        Just ( row, _ ) ->
            if decidableRow model (DecisionSlot.rowUid row) == Just row then
                model

            else
                { model | decision = DecisionSlot.closeRefusal model.decision }

        Nothing ->
            model


-- The row `uid` when the queue page shows it with decision controls: the
-- one predicate the view draws them by and the refusal panel opens by.
decidableRow : Model -> Uid -> Maybe DecidableRow
decidableRow model uid =
    if model.page == QueuePage then
        DecisionSlot.decidableRow model.selected model.queueState model.selectedView uid

    else
        Nothing


-- The slot with the refusal panel open on `uid`, when the shown page offers
-- `target` on it and that offer is the one the render drew (`drawn`). An
-- offer whose content changed, or a row the render drew no control for that
-- the page now offers, opens nothing and says why; any other refusal leaves
-- the model unchanged.
startRefusal : Settings.AppSettings -> DecisionTarget -> Uid -> Maybe DecidableRow -> Model -> ( Model, Cmd Msg )
startRefusal settings target uid drawn model =
    if model.page /= QueuePage then
        ( model, Cmd.none )

    else
        case DecisionSlot.decidableAs model.selected model.queueState model.selectedView target uid drawn of
            Ok row ->
                ( { model | decision = DecisionSlot.openRefusal settings.epoch row model.decision }, Cmd.none )

            Err (SaveRefused DrawnChanged) ->
                ( { model | decision = DecisionSlot.decisionRefused settings.epoch (SaveRefused DrawnChanged) (Slot.latestTicket model.queueLoad) model.decision }, Cmd.none )

            Err _ ->
                ( model, Cmd.none )


step : Settings.AppSettings -> Msg -> Model -> ( Model, Cmd Msg )
step settings msg model =
    case msg of
        PendingLoaded load result ->
            let
                ( settle, slot, next ) =
                    Slot.loadArrived settings.epoch load model.queueLoad

                ( stepped, loadCmd ) =
                    queueStep settings ( slot, next ) model
            in
            case settle of
                Settles ->
                    let
                        loaded =
                            { stepped | queueState = Queue.stateFromResult result, decision = DecisionSlot.queueSettled (Slot.stampKey load) result stepped.decision }

                        ( viewed, viewCmd ) =
                            viewAfterLoad settings { loaded | selected = clampIndex stepped.selected (List.length (queueList loaded)) }
                    in
                    ( viewed, Cmd.batch [ loadCmd, viewCmd ] )

                Dropped ->
                    ( stepped, loadCmd )

        NextPage cursor ->
            loadQueue settings cursor { model | queueState = Loading, selected = 0 }

        ApproveRow row ->
            saveDecision settings model (DecisionSlot.rowTarget row) (DecisionSlot.rowUid row) (Just row) Approved

        RefuseStart row ->
            startRefusal settings (DecisionSlot.rowTarget row) (DecisionSlot.rowUid row) (Just row) model

        RefuseDraft row text ->
            ( { model | decision = onOpenRow row (DecisionSlot.editDraft (DecisionSlot.rowUid row) (Draft.draft text)) model.decision }, Cmd.none )

        RefuseCancel row ->
            ( { model | decision = onOpenRow row DecisionSlot.closeRefusal model.decision }, Cmd.none )

        RefuseSubmit row ->
            submitRefuse settings model row

        DecisionSaved saving result ->
            if Slot.owns settings.epoch saving (DecisionSlot.savingStamp model.decision) then
                case result of
                    Ok ( attested, written ) ->
                        case DecisionSlot.decisionWritten settings.epoch saving model.decision of
                            Just refreshing ->
                                queueStep settings (Slot.requestLoad Queue.mergeQueueWant settings.epoch (QueueDrain attested written model.queueCursor) model.queueLoad) { model | decision = refreshing }

                            Nothing ->
                                ( model, Cmd.none )

                    Err failure ->
                        ( { model | decision = DecisionSlot.decisionNotSaved settings.epoch saving failure (Slot.latestTicket model.queueLoad) model.decision }, Cmd.none )

            else
                ( model, Cmd.none )

        Navigated page ->
            enterPage settings page model

        ShowQueue ->
            enterPage settings QueuePage model

        ShowHistory ->
            enterPage settings HistoryPage model

        HistoryPageLoaded load result ->
            let
                ( settle, slot, next ) =
                    Slot.loadArrived settings.epoch load model.historyLoad

                ( stepped, loadCmd ) =
                    historyStep settings ( slot, next ) model
            in
            case settle of
                Settles ->
                    ( { stepped | history = History.historyStateFromResult result }, loadCmd )

                Dropped ->
                    ( stepped, loadCmd )

        HistoryNext cursor ->
            loadHistory settings cursor model

        SelectedViewLoaded read result ->
            if Slot.owns settings.epoch read (Selected.runningView model.selectedView) then
                withStanding settings (viewStep settings (Selected.viewArrived settings.epoch read result model.selectedView) model)

            else
                ( model, Cmd.none )

        StandingLoaded read result ->
            standingStep settings (Standing.standingArrived settings.epoch read result model.standing) model

        KeyDown offers key ->
            keyActionMsg settings (Keys.keyAction (keyMode offers model) key) model

        SelectUnit i ->
            if model.page == QueuePage then
                selectAt settings i model

            else
                ( model, Cmd.none )


-- A source read settled: on the unit page, a shown unit's standing is asked
-- for the body shown, so the page says whether that body is decided.
withStanding : Settings.AppSettings -> ( Model, Cmd Msg ) -> ( Model, Cmd Msg )
withStanding settings ( model, cmd ) =
    case model.page of
        UnitPage raw ->
            case unitPageState raw model of
                UnitLoaded loaded ->
                    let
                        bodyHash =
                            Index.storedHash loaded.unit.attested

                        ( read, readCmd ) =
                            standingStep settings (Standing.standingRequested settings.epoch loaded.unit.uid bodyHash model.standing) model
                    in
                    ( read, Cmd.batch [ cmd, readCmd ] )

                UnitLoading ->
                    ( model, cmd )

                UnitNotFound ->
                    ( model, cmd )

                UnitFailed _ ->
                    ( model, cmd )

                UnitIdRefused ->
                    ( model, cmd )

        QueuePage ->
            ( model, cmd )

        HistoryPage ->
            ( model, cmd )


-- The selected card's view after a queue load: on the queue page the
-- selected unit is read afresh, since the load may follow a decision or a
-- reindex. History shows no source, so the slot is cleared. The unit page
-- owns the slot for its own unit, so a queue load leaves it alone.
viewAfterLoad : Settings.AppSettings -> Model -> ( Model, Cmd Msg )
viewAfterLoad settings model =
    case ( model.page, selectedUid model ) of
        ( QueuePage, Just uid ) ->
            viewStep settings (Selected.reloadView settings.epoch uid model.selectedView) model

        ( QueuePage, Nothing ) ->
            ( { model | selectedView = Selected.clearView settings.epoch model.selectedView }, Cmd.none )

        ( HistoryPage, _ ) ->
            ( { model | selectedView = Selected.clearView settings.epoch model.selectedView }, Cmd.none )

        ( UnitPage _, _ ) ->
            ( model, Cmd.none )


-- The queue card at `i` selected, reading its view when it is not shown.
selectAt : Settings.AppSettings -> Int -> Model -> ( Model, Cmd Msg )
selectAt settings i model =
    let
        moved =
            { model | selected = clampIndex i (List.length (queueList model)) }
    in
    case selectedUid moved of
        Just uid ->
            viewStep settings (Selected.selectView settings.epoch uid moved.selectedView) moved

        Nothing ->
            ( moved, Cmd.none )


-- A source-slot transition, with the one read it starts, if any: the only
-- place a source read is started, its result carrying the read's stamp.
viewStep : Settings.AppSettings -> ( Selected.SelectedView, Maybe (Stamp Uid) ) -> Model -> ( Model, Cmd Msg )
viewStep settings ( state, next ) model =
    ( { model | selectedView = state }, loadViewCmd settings next )


loadViewCmd : Settings.AppSettings -> Maybe (Stamp Uid) -> Cmd Msg
loadViewCmd settings next =
    case next of
        Just read ->
            Cmd.perform (ServerLog.logged "source load failed" (Queue.loadUnitView settings.index (Slot.stampKey read))) (viewLoaded read)

        Nothing ->
            Cmd.none


-- A standing-slot transition, with the one read it starts, if any: the only
-- place a standing read is started, its result carrying the read's stamp.
standingStep : Settings.AppSettings -> ( Standing.StandingRead, Maybe (Stamp Standing.StandingKey) ) -> Model -> ( Model, Cmd Msg )
standingStep settings ( read, next ) model =
    case next of
        Just reading ->
            let
                ( uid, bodyHash ) =
                    Slot.stampKey reading
            in
            ( { model | standing = read }
            , Cmd.perform (ServerLog.logged "standing load failed" (Standing.loadStanding settings uid bodyHash)) (standingLoaded reading)
            )

        Nothing ->
            ( { model | standing = read }, Cmd.none )


-- `change` applied to the slot only while its refusal panel is open on
-- exactly `row`, the row the message was drawn for; any other slot is kept.
onOpenRow : DecidableRow -> (DecisionSlot.DecisionSlot -> DecisionSlot.DecisionSlot) -> DecisionSlot.DecisionSlot -> DecisionSlot.DecisionSlot
onOpenRow row change slot =
    case DecisionSlot.openRow slot of
        Just ( open, _ ) ->
            if open == row then
                change slot

            else
                slot

        Nothing ->
            slot


-- Every KeyAction does what the matching button's message does; the buttons
-- remain the single source of truth and the keys are a mirror. Each action
-- carries the offer its render drew, so none reads the model's selection.
keyActionMsg : Settings.AppSettings -> KeyAction KeyCard DecidableRow -> Model -> ( Model, Cmd Msg )
keyActionMsg settings action model =
    case action of
        ApproveSelected card ->
            saveDecision settings model OnUnit card.uid card.offer Approved

        RefuseSelected card ->
            startRefusal settings OnUnit card.uid card.offer model

        Select at ->
            selectAt settings (Keys.index at) model

        ConfirmRefuse drawn ->
            submitRefuse settings model drawn

        CancelRefuse drawn ->
            ( { model | decision = onOpenRow drawn DecisionSlot.closeRefusal model.decision }, Cmd.none )

        Ignore ->
            ( model, Cmd.none )


-- The open panel's draft, already cut to the reason limit where it entered
-- (`RefuseDraft`), is parsed into a `Reason` here, so Confirm records the
-- text the panel shows; a blank draft stays open with why. A submit for any
-- offer but the one the panel is open on (another row, or the same row with
-- other content) decides nothing and keeps the draft. The panel closes only
-- when a save starts (the saving state holds no panel); a refused save keeps
-- the panel and the draft.
submitRefuse : Settings.AppSettings -> Model -> DecidableRow -> ( Model, Cmd Msg )
submitRefuse settings model drawn =
    case DecisionSlot.openRow model.decision of
        Just ( row, draft ) ->
            if row == drawn then
                case Draft.draftReason draft.refuseDraft of
                    Err refused ->
                        ( { model | decision = DecisionSlot.draftRefused (DraftRefused refused) model.decision }, Cmd.none )

                    Ok reason ->
                        saveDecision settings model (DecisionSlot.rowTarget drawn) (DecisionSlot.rowUid drawn) (Just drawn) (Refused reason)

            else
                ( model, Cmd.none )

        Nothing ->
            ( model, Cmd.none )


clampIndex : Int -> Int -> Int
clampIndex i len =
    max 0 (min i (len - 1))


pageRefusal : Model -> Uid -> Maybe Index.RefusalRow
pageRefusal model uid =
    case model.queueState of
        Loaded page ->
            List.find (\row -> row.uid == uid) page.refusals

        Loading ->
            Nothing

        Failed _ ->
            Nothing


-- Every decision, from a button or a key, takes the session's one decision
-- slot and goes through `Queue.decide` on the source its offer drew, or
-- `Queue.decideRefusal` on the digest a listed unreviewable file's offer
-- drew, each re-proved before writing. A decision asked off the queue page
-- is refused before it takes the slot, and so is one asked on a server with
-- no signing key, on a row the page does not offer that decision on (the
-- view's own `decidableRow`), with an offer (`drawn`) other than the one
-- the page offers now, or on an offer `decisionPlan` refuses, each with a
-- notice saying why and the refusal panel kept, and no task started; one
-- asked while another is busy starts nothing, and that decision's pending
-- state stays shown.
saveDecision : Settings.AppSettings -> Model -> DecisionTarget -> Uid -> Maybe DecidableRow -> LibDb.Decision -> ( Model, Cmd Msg )
saveDecision settings model target uid drawn decision =
    if model.page /= QueuePage then
        ( { model | decision = DecisionSlot.decisionRefused settings.epoch SaveOffQueue (Slot.latestTicket model.queueLoad) model.decision }, Cmd.none )

    else
        case settings.key of
            ReadOnly ->
                ( { model | decision = DecisionSlot.decisionRefused settings.epoch SaveReadOnly (Slot.latestTicket model.queueLoad) model.decision }, Cmd.none )

            Signing macKey ->
                case DecisionSlot.decidableAs model.selected model.queueState model.selectedView target uid drawn of
                    Ok row ->
                        case decisionPlan model row of
                            Ok plan ->
                                case DecisionSlot.startDecision settings.epoch uid model.decision of
                                    Just ( started, saving ) ->
                                        ( { model | decision = started }
                                        , Cmd.perform (ServerLog.logged "decision save failed" (decidePlan settings macKey plan decision)) (decisionSaved saving)
                                        )

                                    Nothing ->
                                        ( model, Cmd.none )

                            Err refusal ->
                                ( { model | decision = DecisionSlot.decisionRefused settings.epoch (SaveRefused refusal) (Slot.latestTicket model.queueLoad) model.decision }, Cmd.none )

                    Err failure ->
                        ( { model | decision = DecisionSlot.decisionRefused settings.epoch failure (Slot.latestTicket model.queueLoad) model.decision }, Cmd.none )


-- What a decision writes: the source a unit's offer drew, or the digest a
-- listed unreviewable file's offer drew. Built only by `decisionPlan`, so
-- a decision's write carries what the reviewer was shown and nothing read
-- from the session after.
type DecisionPlan
    = WriteUnit Index.ShownSource
    | WriteFile Uid Index.RefusalDigest


-- The plan of a decision on `row`'s drawn source or listed unreviewable
-- file's drawn digest, or its refusal when the unit or file is off the
-- shown queue page, no source is shown, the file carries no digest, or the
-- source or digest shown is no longer the one drawn, decided before
-- anything is read. The source and digest come from the offer, never from
-- the page's current copy.
decisionPlan : Model -> DecidableRow -> Result DecideRefusal DecisionPlan
decisionPlan model row =
    let
        uid =
            DecisionSlot.rowUid row
    in
    case DecisionSlot.offeredRefusal row of
        Nothing ->
            case List.find (\q -> q.unit.uid == uid) (queueList model) of
                Just _ ->
                    case DecisionSlot.offeredSource row model.selectedView of
                        Just shown ->
                            Ok (WriteUnit shown)

                        Nothing ->
                            case Selected.decidableSource uid model.selectedView of
                                Just _ ->
                                    Err DrawnChanged

                                Nothing ->
                                    Err SourceNotShown

                Nothing ->
                    Err NotQueued

        Just digest ->
            case Maybe.map (\listed -> listed.digest) (pageRefusal model uid) of
                Just (Just listed) ->
                    if listed == digest then
                        Ok (WriteFile uid digest)

                    else
                        Err DrawnChanged

                Just Nothing ->
                    Err FileNotAcknowledgeable

                Nothing ->
                    Err FileNotQueued


-- The write `plan` names, as `decision` under `macKey`. It reads no
-- session state: each sink re-proves what the plan carries before writing.
decidePlan : Settings.AppSettings -> MacKey -> DecisionPlan -> LibDb.Decision -> Task.Task Error (Result DecideRefusal ( Index.Attested, Index.Written ))
decidePlan settings macKey plan decision =
    case plan of
        WriteUnit shown ->
            decideOn settings macKey shown decision

        WriteFile uid digest ->
            LibDb.openAt settings.review |> Task.andThen (\db -> Queue.decideRefusal macKey settings.index db uid digest decision)


decideOn : Settings.AppSettings -> MacKey -> Index.ShownSource -> LibDb.Decision -> Task.Task Error (Result DecideRefusal ( Index.Attested, Index.Written ))
decideOn settings macKey shown decision =
    LibDb.openAt settings.review |> Task.andThen (\db -> Queue.decide macKey settings.index db shown decision)
