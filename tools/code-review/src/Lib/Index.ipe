-- One ipe-index unit's metadata, never its source: a queue page lists these
-- without reading a file. Every text column a page shows (`path`, the
-- `tag:relative` form ipe-index stores; `name`; `qualified`; `kind`;
-- `facing`; `purpose`) is a `Label`, read through a bounded window and
-- parsed once in `withRow`, so no index text reaches a page raw or
-- unbounded; `lang` is the language ipe-index stores for the unit's file,
-- read through the same window and parsed for highlighting. `attested` is
-- the stored body hash, read whole or not at all, parsed once.
type alias Unit =
    { uid : Uid
    , path : Label
    , name : Label
    , qualified : Label
    , kind : Label
    , lang : Highlight.Lang
    , lineStart : Int
    , lineEnd : Int
    , facing : Label
    , purpose : Maybe Label
    , attested : AttestedHash
    }


-- One unit with what a page shows of its source: the unit's lines from disk,
-- shown only when they re-hash to `unit.attested`, and the links resolved
-- from a shown view. `loadView` is the one source read that builds it.
type alias UnitView =
    { unit : Unit
    , view : SourceView
    , links : Links.LinkSet
    }


-- The unit columns as they come off the DB, before the source is attached,
-- for one uid under a bound tag. The unit page queries units directly, not
-- through `openColumns`: a decided unit is not open, but its page must still
-- render, so it reads no change. A unit under a tag `roots` does not bind is
-- no unit here, as it is on no page.
unitByUid : RootMap -> Uid -> ( String, List SqlValue )
unitByUid roots uid =
    let
        bound =
            boundTags roots
    in
    ( unitRowSelect ++ " WHERE u.uid = ? AND" ++ bound.sql ++ " LIMIT 1"
    , Uid.toSql uid :: bound.params
    )


-- The columns of one unit row `u` that `coreDecoder` and `shownDecoder`
-- read, joined with its file row.
unitRowSelect : String
unitRowSelect =
    "SELECT " ++ shownColumn "u.uid" "uid" ++ ", u.line_start, u.line_end, " ++ shownColumn "u.body_hash" "body_hash" ++ ", " ++ shownColumn "f.lang" "lang" ++ ", " ++ unitShownColumns ++ " FROM units u" ++ unitFiles


-- The units among `uids` the index holds under a bound tag, read as
-- `loadView` reads one: the names History draws for a decision whose row
-- carries no verified name. Every uid and tag is a bound parameter. One row
-- per uid, at most one per uid asked, so a uid the index holds more than
-- once neither sets the read's size nor crowds another uid out.
liveUnits : Db.Db -> RootMap -> List Uid -> Task.Task Error (List Unit)
liveUnits conn roots uids =
    let
        bound =
            boundTags roots
    in
    if List.isEmpty uids then
        Task.succeed []

    else
        Db.queryDecode conn
            (unitRowSelect ++ " WHERE u.uid COLLATE BINARY IN (" ++ placeholders (List.length uids) ++ ") AND" ++ bound.sql ++ " GROUP BY u.uid COLLATE BINARY ORDER BY u.uid COLLATE BINARY LIMIT ?")
            (List.map Uid.toSql uids ++ bound.params ++ [ SqlInt (List.length uids) ])
            (Db.Decode.map2 withRow coreDecoder shownDecoder)


-- The unreviewable files among `uids` the index holds under a bound tag,
-- each with the label of its stored path, read under `Label.labelCap` as a
-- queue card reads it; one row per uid, as `liveUnits` reads.
liveFiles : Db.Db -> RootMap -> List Uid -> Task.Task Error (List ( Uid, Label ))
liveFiles conn roots uids =
    let
        bound =
            refusalCondition (refusalTags roots)
    in
    if List.isEmpty uids then
        Task.succeed []

    else
        Db.queryDecode conn
            ("SELECT " ++ shownColumn "u.uid" "uid" ++ ", " ++ shownColumn "u.path" "path" ++ " FROM refusals u WHERE u.uid COLLATE BINARY IN (" ++ placeholders (List.length uids) ++ ") AND" ++ bound.sql ++ " GROUP BY u.uid COLLATE BINARY ORDER BY u.uid COLLATE BINARY LIMIT ?")
            (List.map Uid.toSql uids ++ bound.params ++ [ SqlInt (List.length uids) ])
            (Db.Decode.map2 (\fileUid path -> ( fileUid, Label.parse Label.labelCap path )) (wholeUidDecoder "uid") (columnDecoder "path"))


-- A live unit's name, the one a queue card, the unit page and History draw.
unitName : Unit -> UnitName
unitName unit =
    UnitName.live unit.uid { kind = unit.kind, qualified = unit.qualified, path = unit.path, line = unit.lineStart }


-- The one bound-tag membership condition on a unit row `u`, with its bound
-- parameters: the stored path's tag, the text before its first `:`, is one
-- `roots` binds. A path with no `:` reads an empty tag, which no root binds.
-- Every query that lists, counts or looks up units applies it, so no unit
-- under an unbound tag is listed, counted as review work, or loaded. Tags
-- enter only as bound parameters, compared under `BINARY`.
type alias BoundTags =
    { sql : String
    , params : List SqlValue
    }


boundTags : RootMap -> BoundTags
boundTags roots =
    boundTagsAs (\tag -> tag) roots


-- The bound-tag condition with each tag as `spell` writes it in a stored
-- path.
boundTagsAs : (String -> String) -> RootMap -> BoundTags
boundTagsAs spell roots =
    let
        tags =
            List.map (\( tag, _ ) -> SqlString (spell (RepoPath.tagName tag))) (RepoPath.boundRoots roots)
    in
    { sql = " substr(u.path, 1, instr(u.path, ':') - 1) COLLATE BINARY IN (" ++ placeholders (List.length tags) ++ ")"
    , params = tags
    }


-- The unit's file row, for the language ipe-index stored for it: a primary
-- key lookup per unit, and a unit with no file row reads a NULL language.
unitFiles : String
unitFiles =
    " LEFT JOIN files f ON f.path = u.path"


-- The one source read: one unit by uid (decided or not) read on `conn`, its
-- one file read and verified against its tag's root in `roots`, and its
-- links resolved from the view when it is shown. Nothing when no such unit
-- exists. The unit page and the selected queue card both load through it.
loadView : Db.Db -> RootMap -> Uid -> Task.Task Error (Maybe UnitView)
loadView conn roots uid =
    do
        rows <- queryUnit conn roots uid
        case List.head rows of
            Just ( row, shown ) ->
                do
                    view <- viewOf conn roots row shown
                    links <- linksOf conn row shown view
                    Task.succeed (Just { unit = withRow row shown, view = view, links = links })

            Nothing ->
                Task.succeed Nothing


-- A unit row as its core columns and its display columns. No text column
-- of the unit is read whole: the path, names and kind come only through
-- their bounded windows, and a value the app acts on is taken from a window
-- only when `Label.whole` proves it holds the whole column.
queryUnit : Db.Db -> RootMap -> Uid -> Task.Task Error (List ( RowCore, RowShown ))
queryUnit conn roots uid =
    let
        ( sql, params ) =
            unitByUid roots uid
    in
    Db.queryDecode conn sql params (Db.Decode.map2 (\row shown -> ( row, shown )) coreDecoder shownDecoder)


-- Jump links come only from a shown view; a withheld view links nothing and
-- reads no names. A shown view costs two indexed queries, each bounded by a
-- ceiling: the unit's callgraph edges, then the qualified names its
-- references spell under ipe-index's callee rule. The unit never links to
-- itself. The unit's names reach `Links.candidates` only as their windows,
-- and its path is bound only when its window holds the whole path: a view is
-- shown only for such a path, so the other case links nothing.
linksOf : Db.Db -> RowCore -> RowShown -> SourceView -> Task.Task Error Links.LinkSet
linksOf conn row columns view =
    case view of
        Shown shown ->
            case Label.whole columns.path of
                Just path ->
                    let
                        lang =
                            langOf row.lang

                        source =
                            shownText shown

                        wanted =
                            Links.candidates lang { kind = columns.kind, name = columns.name, qualified = columns.qualified } (Links.references lang source)
                    in
                    do
                        edges <- edgeLinks conn row.uid
                        resolved <- candidateRows conn path row.uid wanted.names
                        Task.succeed
                            (Links.assemble
                                { edges = edgeReach edges, candidates = wanted.reach }
                                (List.map edgeLink edges)
                                (Links.resolveCandidates wanted.lookups resolved)
                                (Links.sourceUrls source)
                            )

                Nothing ->
                    Task.succeed Links.noLinks

        Stale _ ->
            Task.succeed Links.noLinks

        Unreadable _ ->
            Task.succeed Links.noLinks

        TooLarge _ ->
            Task.succeed Links.noLinks


-- The callgraph edges ipe-index resolved out of `uid`, one past the link
-- ceiling, so a full read shows that more edges may exist. Each callee's
-- qualified name is read as a bounded window and parsed into its label
-- here, and its uid as a bounded window too, so no edge column reaches the
-- app unbounded. A uid the window does not hold whole links nowhere.
edgeLinks : Db.Db -> Uid -> Task.Task Error (List ( Maybe String, Label ))
edgeLinks conn uid =
    Db.queryDecode conn edgeSql [ Uid.toSql uid, Uid.toSql uid, SqlInt (Links.linkCeiling + 1) ] edgeDecoder


edgeSql : String
edgeSql =
    "SELECT " ++ shownColumn "c.callee_uid" "callee_uid" ++ ", " ++ shownColumn "u.qualified" "qualified" ++ " FROM callgraph c JOIN units u ON u.uid = c.callee_uid WHERE c.caller_uid = ? AND c.callee_uid != ? ORDER BY u.qualified, u.uid LIMIT ?"


edgeLink : ( Maybe String, Label ) -> Links.Link
edgeLink edge =
    case edge of
        ( Just uid, qualified ) ->
            Links.internal qualified uid

        ( Nothing, qualified ) ->
            Links.Unlinked qualified


edgeReach : List a -> Links.Reach
edgeReach edges =
    if List.length edges > Links.linkCeiling then
        Links.Capped

    else
        Links.Complete


edgeDecoder : Db.Decode.Decoder ( Maybe String, Label )
edgeDecoder =
    Db.Decode.map2
        (\callee qualified -> ( Label.whole callee, Label.parse Label.labelCap qualified ))
        (columnDecoder "callee_uid")
        (columnDecoder "qualified")


-- The `(qualified, uid)` row of each candidate name some unit other than
-- the unit `uid` at `path` holds; no names read nothing. A row whose window
-- does not hold its whole qualified name resolves no name; one whose window
-- does not hold its whole uid resolves its name to no unit.
candidateRows : Db.Db -> String -> Uid -> List String -> Task.Task Error (List ( String, Maybe String ))
candidateRows conn path uid names =
    if List.isEmpty names then
        Task.succeed []

    else
        case candidateQuery path uid names of
            ( sql, params ) ->
                Db.queryDecode conn sql params qualifiedDecoder
                    |> Task.map (List.filterMap wholeCandidate)


-- One statement for every candidate name, on `i_units_qual`: at most one row
-- per name, the unit in `path` first, then the lowest uid — ipe-index's own
-- `uid_for_qualified` tie-break, the read bounded by the count of names.
-- Every name is bound; only placeholders and that count enter the SQL
-- text. A row's qualified name and uid are each read as a bounded window,
-- whatever collation the file declares on them.
candidateQuery : String -> Uid -> List String -> ( String, List SqlValue )
candidateQuery path uid names =
    ( "SELECT " ++ shownColumn "qualified" "qualified" ++ ", " ++ shownColumn "uid" "uid" ++ " FROM (SELECT qualified, uid, ROW_NUMBER() OVER (PARTITION BY qualified ORDER BY (path = ?) DESC, uid) AS rn FROM units WHERE qualified IN (" ++ placeholders (List.length names) ++ ") AND uid != ?) WHERE rn = 1 LIMIT " ++ String.fromInt (List.length names)
    , List.concat [ [ SqlString path ], List.map SqlString names, [ Uid.toSql uid ] ]
    )


-- `n` comma-separated `?` placeholders.
placeholders : Int -> String
placeholders n =
    String.join ", " (List.repeat n "?")


qualifiedDecoder : Db.Decode.Decoder ( Label.Column, Label.Column )
qualifiedDecoder =
    Db.Decode.map2 (\q u -> ( q, u )) (columnDecoder "qualified") (columnDecoder "uid")


wholeCandidate : ( Label.Column, Label.Column ) -> Maybe ( String, Maybe String )
wholeCandidate row =
    case row of
        ( qualified, uid ) ->
            Maybe.map (\q -> ( q, Label.whole uid )) (Label.whole qualified)


-- The columns every unit row carries into a `Unit` besides its labels:
-- `bodyHash` is the whole stored hash (a row whose window does not hold all
-- of it fails the read), and `lang` the window of the file's language.
type alias RowCore =
    { uid : Uid
    , lineStart : Int
    , lineEnd : Int
    , bodyHash : String
    , lang : Maybe Label.Column
    }


-- The display columns of a unit row, each read as a bounded window and its
-- byte length (`shownColumn`), so no read returns an unbounded value.
type alias RowShown =
    { path : Label.Column
    , name : Label.Column
    , qualified : Label.Column
    , kind : Label.Column
    , facing : Label.Column
    , purpose : Maybe Label.Column
    }


-- The display columns of a unit row `u`, each under its own name with the
-- `_shown`, `_bytes` and `_window` suffixes `shownDecoder` reads.
unitShownNames : List String
unitShownNames =
    [ "path", "name", "qualified", "kind", "facing", "purpose" ]


unitShownColumns : String
unitShownColumns =
    String.join ", " (List.map (\col -> shownColumn ("u." ++ col) col) unitShownNames)


-- An index column as the app reads it: its first `Label.windowChars`
-- characters, the byte length of the whole value, and, when the cell is
-- stored as text, the byte length of that window, so the database returns
-- a bounded window whatever the column holds and `Label.extent` can tell a
-- faithful window from a hex spelling.
shownColumn : String -> String -> String
shownColumn source alias =
    let
        window =
            "substr(" ++ source ++ ", 1, " ++ String.fromInt Label.windowChars ++ ")"
    in
    window ++ " AS " ++ alias ++ "_shown, length(CAST(" ++ source ++ " AS BLOB)) AS " ++ alias ++ "_bytes, CASE WHEN typeof(" ++ source ++ ") = 'text' THEN length(CAST(" ++ window ++ " AS BLOB)) END AS " ++ alias ++ "_window"


-- The names `shownColumn` gives the display columns, for a query that
-- selects them from a subquery.
unitShownSelect : String
unitShownSelect =
    String.join ", " (List.map shownNames unitShownNames)


-- The three names `shownColumn` gives column `alias`.
shownNames : String -> String
shownNames alias =
    alias ++ "_shown, " ++ alias ++ "_bytes, " ++ alias ++ "_window"


columnDecoder : String -> Db.Decode.Decoder Label.Column
columnDecoder col =
    Db.Decode.succeed (\shown bytes window -> { shown = shown, bytes = bytes, window = window })
        |> Db.Decode.required (col ++ "_shown") (Db.Decode.string (col ++ "_shown"))
        |> Db.Decode.required (col ++ "_bytes") (Db.Decode.int (col ++ "_bytes"))
        |> Db.Decode.required (col ++ "_window") (Db.Decode.nullable (Db.Decode.int (col ++ "_window")))


-- A nullable display column: its window and byte length are NULL together,
-- with no window length, or the read fails.
nullableColumnDecoder : String -> Db.Decode.Decoder (Maybe Label.Column)
nullableColumnDecoder col =
    Db.Decode.andThen
        (\pair ->
            case pair of
                ( ( Just shown, Just bytes ), window ) ->
                    Db.Decode.succeed (Just { shown = shown, bytes = bytes, window = window })

                ( ( Nothing, Nothing ), Nothing ) ->
                    Db.Decode.succeed Nothing

                ( ( Nothing, Nothing ), Just _ ) ->
                    Db.Decode.fail (col ++ " is NULL in its window but not in its window's length")

                ( ( Just _, Nothing ), _ ) ->
                    Db.Decode.fail (col ++ " is NULL in only one of its window and its length")

                ( ( Nothing, Just _ ), _ ) ->
                    Db.Decode.fail (col ++ " is NULL in only one of its window and its length")
        )
        (Db.Decode.succeed (\shown bytes window -> ( ( shown, bytes ), window ))
            |> Db.Decode.required (col ++ "_shown") (Db.Decode.nullable (Db.Decode.string (col ++ "_shown")))
            |> Db.Decode.required (col ++ "_bytes") (Db.Decode.nullable (Db.Decode.int (col ++ "_bytes")))
            |> Db.Decode.required (col ++ "_window") (Db.Decode.nullable (Db.Decode.int (col ++ "_window")))
        )


-- A windowed column the app acts on: its whole text, or the read fails
-- naming the column and how its window fell short, never the value.
wholeColumnDecoder : String -> Db.Decode.Decoder String
wholeColumnDecoder col =
    Db.Decode.andThen (wholeOf col) (columnDecoder col)


-- A nullable windowed column the app acts on: NULL, or its whole text, or
-- the read fails as `wholeColumnDecoder` does.
nullableWholeColumnDecoder : String -> Db.Decode.Decoder (Maybe String)
nullableWholeColumnDecoder col =
    Db.Decode.andThen
        (\column ->
            case column of
                Nothing ->
                    Db.Decode.succeed Nothing

                Just present ->
                    Db.Decode.andThen (\text -> Db.Decode.succeed (Just text)) (wholeOf col present)
        )
        (nullableColumnDecoder col)


-- A windowed column read as a unit id: its whole text parsed by `Uid.parse`,
-- or the read fails naming the column, never the value.
wholeUidDecoder : String -> Db.Decode.Decoder Uid
wholeUidDecoder col =
    Db.Decode.andThen
        (\text ->
            case Uid.parse text of
                Ok uid ->
                    Db.Decode.succeed uid

                Err _ ->
                    Db.Decode.fail ("column " ++ col ++ " holds a value that is not a unit id")
        )
        (wholeColumnDecoder col)


wholeOf : String -> Label.Column -> Db.Decode.Decoder String
wholeOf col column =
    case Label.extent column of
        WholeColumn text ->
            Db.Decode.succeed text

        CutAtWindow ->
            Db.Decode.fail (col ++ " is longer than the " ++ String.fromInt Label.windowChars ++ " characters the index read returns")

        CutAtNul ->
            Db.Decode.fail (col ++ " holds a NUL byte, where the index read stops")

        NotTextCell ->
            Db.Decode.fail (col ++ " is not stored as text")


shownDecoder : Db.Decode.Decoder RowShown
shownDecoder =
    Db.Decode.map2
        (\( path, name, qualified ) ( kind, facing, purpose ) ->
            { path = path, name = name, qualified = qualified, kind = kind, facing = facing, purpose = purpose }
        )
        (Db.Decode.map3 (\p n q -> ( p, n, q )) (columnDecoder "path") (columnDecoder "name") (columnDecoder "qualified"))
        (Db.Decode.map3 (\k f p -> ( k, f, p )) (columnDecoder "kind") (columnDecoder "facing") (nullableColumnDecoder "purpose"))


coreDecoder : Db.Decode.Decoder RowCore
coreDecoder =
    Db.Decode.map3
        (\( uid, lineStart, lineEnd ) bodyHash lang -> { uid = uid, lineStart = lineStart, lineEnd = lineEnd, bodyHash = bodyHash, lang = lang })
        (Db.Decode.succeed (\uid lineStart lineEnd -> ( uid, lineStart, lineEnd ))
            |> Db.Decode.required "uid" (wholeUidDecoder "uid")
            |> Db.Decode.required "line_start" (Db.Decode.int "line_start")
            |> Db.Decode.required "line_end" (Db.Decode.int "line_end")
        )
        (wholeColumnDecoder "body_hash")
        (nullableColumnDecoder "lang")


-- The startup check of `IPE_INDEX_DB`: the index is opened read-only and
-- every column a queue page reads through `openColumns` is selected, with
-- the `reviewed` copy, its `reviewed_stamp` and the `refusals` table, so a
-- missing file, a file that is not an ipe-index database, or one missing a
-- table or a column (an index older than its `refusals` table among them)
-- stops the server before it listens, naming the variable and the file.
probe : IndexSettings -> Task.Task Error ()
probe settings =
    (do
        conn <- readConnection settings
        Db.queryDecode conn (openColumns (boundTags settings.roots) ++ " LIMIT 0") (boundTags settings.roots).params pendingRowDecoder
        Db.queryDecode conn ("SELECT " ++ reviewedPairColumns ++ " FROM reviewed LIMIT 0") [] reviewedPairDecoder
        Db.queryDecode conn ("SELECT " ++ shownColumn "head" "head" ++ " FROM reviewed_stamp LIMIT 0") [] stampDecoder
        Db.queryDecode conn (refusalColumns ++ " 0 = 1 LIMIT 0") [] refusalRowDecoder
        Task.succeed ()
    )
        |> Task.onError (Settings.openFailure IndexDb settings.db.path)


-- The startup check of the configured roots against the repositories the
-- index records (its `repos` table), in one read: the bound tags must be
-- exactly the recorded ones, and each bound root must nest under the same
-- recorded outer tag at the same folded relative path, or under none, as
-- ipe-index recorded from the files' identity. So a root bound under the
-- wrong spelling of a nested directory, or a repository bound nowhere,
-- stops startup instead of leaving units no reviewer can decide. An index
-- with no units and no recorded repositories has nothing to check.
probeRepos : IndexSettings -> Task.Task Error ()
probeRepos settings =
    (do
        conn <- readConnection settings
        Db.withTransaction conn
            (\tx ->
                do
                    recorded <- Db.queryDecode tx reposSql [ SqlInt (RepoPath.maxRoots + 1) ] repoRowDecoder
                    anyUnit <- Db.queryDecode tx anyUnitSql [] anyUnitDecoder
                    Task.succeed ( recorded, anyUnit )
            )
    )
        |> Task.onError (Settings.openFailure IndexDb settings.db.path)
        |> Task.andThen
            (\( recorded, anyUnit ) ->
                case repoSetRefusal settings.roots recorded (not (List.isEmpty anyUnit)) of
                    Nothing ->
                        Task.succeed ()

                    Just refusal ->
                        Task.fail (Error.invalidInput (SafeText.toString (repoSetText refusal)))
            )


-- One row of the index's `repos` table: a tag, and the tag of the nearest
-- declared root enclosing it with its relative path below that root, or
-- neither.
type alias RepoRow =
    { tag : String
    , outer : Maybe String
    , prefix : Maybe String
    }


-- The recorded repositories in tag order, one past the ceiling at most, so
-- an oversized set is seen without reading it whole.
reposSql : String
reposSql =
    "SELECT " ++ shownColumn "tag" "tag" ++ ", " ++ shownColumn "outer" "outer" ++ ", " ++ shownColumn "prefix" "prefix" ++ " FROM repos ORDER BY tag LIMIT ?"


repoRowDecoder : Db.Decode.Decoder RepoRow
repoRowDecoder =
    Db.Decode.succeed (\tag outer prefix -> { tag = tag, outer = outer, prefix = prefix })
        |> Db.Decode.required "tag" (wholeColumnDecoder "tag")
        |> Db.Decode.required "outer" (nullableWholeColumnDecoder "outer")
        |> Db.Decode.required "prefix" (nullableWholeColumnDecoder "prefix")


-- Why the configured roots disagree with the recorded repositories. A bound
-- tag carries the setting that bound it.
type RepoSetRefusal
    = RepoSetTooLarge
    | RepoSetMissing
    | RepoNotIndexed String SafeText
    | RepoNotBound String
    | RepoNestingMismatch String SafeText


-- The first disagreement, checked in order: a set past the ceiling, no
-- set beside units, a bound tag not recorded, a recorded tag not bound, then
-- each bound tag's nesting.
repoSetRefusal : RootMap -> List RepoRow -> Bool -> Maybe RepoSetRefusal
repoSetRefusal roots recorded hasUnits =
    let
        bound =
            RepoPath.boundRoots roots

        recordedRow tag =
            List.find (\row -> row.tag == RepoPath.tagName tag) recorded

        isBound name =
            List.any (\( tag, _ ) -> RepoPath.tagName tag == name) bound

        notIndexed =
            List.find (\( tag, _ ) -> not (List.any (\row -> row.tag == RepoPath.tagName tag) recorded)) bound

        notBound =
            List.find (\row -> not (isBound row.tag)) recorded

        misnested =
            List.find
                (\( tag, _ ) ->
                    case recordedRow tag of
                        Just row ->
                            not (RepoPath.nestingAgrees roots tag row.outer row.prefix)

                        Nothing ->
                            True
                )
                bound
    in
    if List.length recorded > RepoPath.maxRoots then
        Just RepoSetTooLarge

    else if List.isEmpty recorded then
        if hasUnits then
            Just RepoSetMissing

        else
            Nothing

    else
        case notIndexed of
            Just ( tag, root ) ->
                Just (RepoNotIndexed (RepoPath.tagName tag) (RepoPath.rootOrigin tag root))

            Nothing ->
                case notBound of
                    Just row ->
                        Just (RepoNotBound row.tag)

                    Nothing ->
                        Maybe.map (\( tag, root ) -> RepoNestingMismatch (RepoPath.tagName tag) (RepoPath.rootOrigin tag root)) misnested


-- A refusal as diagnostic text; every tag the index stored enters through
-- `SafeText.quoted`.
repoSetText : RepoSetRefusal -> SafeText
repoSetText refusal =
    case refusal of
        RepoSetTooLarge ->
            SafeText.concat
                [ SafeText.literal "IPE_INDEX_DB records more than "
                , SafeText.render (String.fromInt RepoPath.maxRoots)
                , SafeText.literal " repositories, more than ipe-index writes; rebuild it from the repo root with `tools/scripts/ipe-index index`"
                ]

        RepoSetMissing ->
            SafeText.literal "IPE_INDEX_DB holds units but records no repositories: it was built before ipe-index recorded them; rebuild it from the repo root with the current `tools/scripts/ipe-index index`"

        RepoNotIndexed tag origin ->
            SafeText.concat
                [ origin
                , SafeText.literal " binds repo tag "
                , SafeText.quoted tag
                , SafeText.literal ", which IPE_INDEX_DB does not record; remove the binding, or rebuild the index with that repository"
                ]

        RepoNotBound tag ->
            SafeText.concat
                [ SafeText.literal "IPE_INDEX_DB records repo tag "
                , SafeText.quoted tag
                , SafeText.literal ", which no configured root binds, so its units could never be decided; add an IPE_INDEX_REPOS entry `name=/absolute/path` for it, naming the root the index was built from"
                ]

        RepoNestingMismatch tag origin ->
            SafeText.concat
                [ origin
                , SafeText.literal " nests repo tag "
                , SafeText.quoted tag
                , SafeText.literal " otherwise than IPE_INDEX_DB records it: a root encloses it, or sits at a path below that root, that the index does not record; set each root to the directory the index was built from"
                ]


-- The startup check of `IPE_INDEX_ROOT` and every `IPE_INDEX_REPOS` root
-- against the index, per configured root: of the first `rootSample` distinct
-- indexed paths under the root's tag, at least one must join to a file that
-- exists beneath it. A root other than the tree the index was built from
-- holds none of them and is refused naming the variable (the entry, for an
-- `IPE_INDEX_REPOS` root), the first sampled path and the root; a file
-- or two deleted since the last index run does not refuse a right root
-- while another sampled file remains. An index holding units, none under a
-- configured tag, is refused too: none of its units could be read. Only an
-- empty index has nothing to check.
probeRoot : IndexSettings -> Task.Task Error ()
probeRoot settings =
    (do
        conn <- readConnection settings
        samples <- Task.sequence (List.map (rootSampleOf conn) (RepoPath.boundRoots settings.roots))
        anyUnit <- Db.queryDecode conn anyUnitSql [] anyUnitDecoder
        Task.succeed ( samples, anyUnit )
    )
        |> Task.onError (Settings.openFailure IndexDb settings.db.path)
        |> Task.andThen (\( samples, anyUnit ) -> rootsHold settings.roots samples anyUnit)


-- One configured root with the indexed paths sampled under its tag, each
-- read as a bounded window, the setting that named it, and that setting's
-- fix.
type alias RootSample =
    { tag : Tag
    , rootDir : Path
    , origin : SafeText
    , fix : SafeText
    , stored : List Label.Column
    }


rootsHold : RootMap -> List RootSample -> List Int -> Task.Task Error ()
rootsHold roots samples anyUnit =
    if List.all (\sample -> List.isEmpty sample.stored) samples && not (List.isEmpty anyUnit) then
        Task.fail (noTaggedPath (List.map (\sample -> sample.tag) samples))

    else
        Task.sequence (List.map (rootHolds roots) samples)
            |> Task.map (\_ -> ())


rootSampleOf : Db.Db -> ( Tag, Root ) -> Task.Task Error RootSample
rootSampleOf conn ( tag, root ) =
    let
        prefix =
            RepoPath.tagName tag ++ ":"
    in
    Db.queryDecode conn taggedPathsSql [ SqlString prefix, SqlString prefix, SqlInt rootSample, SqlInt rootSample ] (columnDecoder "path")
        |> Task.map (\stored -> { tag = tag, rootDir = RepoPath.rootPath root, origin = RepoPath.rootOrigin tag root, fix = RepoPath.rootFixFor root, stored = stored })


-- Succeeds when the sample is empty or any sampled path joins to a file
-- that exists; a path the map refuses, or whose window does not hold all of
-- it, counts as absent.
rootHolds : RootMap -> RootSample -> Task.Task Error ()
rootHolds roots sample =
    case List.head sample.stored of
        Nothing ->
            Task.succeed ()

        Just first ->
            Task.sequence (List.map (presentUnder roots) sample.stored)
                |> Task.andThen
                    (\present ->
                        if List.member True present then
                            Task.succeed ()

                        else
                            Task.fail (rootMismatch sample (List.length sample.stored) first)
                    )


-- How many distinct indexed paths the root check samples per root.
rootSample : Int
rootSample =
    16


-- The distinct paths under one tag, each as its window and byte length,
-- at most `rootSample` of them, bounded by the outer read as well as the
-- inner: the stored path starts with `tag:`, compared by `substr`, so no
-- character of the tag is a pattern.
taggedPathsSql : String
taggedPathsSql =
    "SELECT " ++ shownColumn "path" "path" ++ " FROM (SELECT DISTINCT path FROM units WHERE substr(path, 1, length(?)) = ? ORDER BY path LIMIT ?) ORDER BY path LIMIT ?"


-- Whether the index holds any unit, read without any of its columns.
anyUnitSql : String
anyUnitSql =
    "SELECT 1 AS one FROM units LIMIT 1"


anyUnitDecoder : Db.Decode.Decoder Int
anyUnitDecoder =
    Db.Decode.succeed (\one -> one)
        |> Db.Decode.required "one" (Db.Decode.int "one")


-- Whether `stored` is a whole path that joins under its root to something
-- that exists.
presentUnder : RootMap -> Label.Column -> Task.Task Error Bool
presentUnder roots stored =
    case Maybe.map (RepoPath.resolve roots) (Label.whole stored) of
        Just (Ok path) ->
            File.exists path |> Task.onError (\_ -> Task.succeed False)

        Just (Err _) ->
            Task.succeed False

        Nothing ->
            Task.succeed False


-- The refusal naming the first sampled path as its bounded quoted label.
rootMismatch : RootSample -> Int -> Label.Column -> Error
rootMismatch sample sampled first =
    Error.invalidInput
        (SafeText.toString
            (Label.piecesText
                [ ToolText
                    (SafeText.concat
                        [ sample.origin
                        , SafeText.literal " holds none of the "
                        , SafeText.render (String.fromInt sampled)
                        , SafeText.literal " indexed files checked: index path \""
                        ]
                    )
                , IndexedLabel (storedPathLabel first)
                , ToolText
                    (SafeText.concat
                        [ SafeText.literal "\" is not found under "
                        , SafeText.quoted (Path.toString sample.rootDir)
                        , SafeText.literal "; "
                        , sample.fix
                        , SafeText.literal ", or re-run `tools/scripts/ipe-index index` if the indexed files have moved"
                        ]
                    )
                ]
            )
        )


noTaggedPath : List Tag -> Error
noTaggedPath tags =
    Error.invalidInput
        (SafeText.toString
            (SafeText.concat
                [ SafeText.literal "IPE_INDEX_DB holds units, but no index path starts with a configured repo tag ("
                , SafeText.concat (List.intersperse (SafeText.literal ", ") (List.map (\tag -> SafeText.quoted (RepoPath.tagName tag ++ ":")) tags))
                , SafeText.literal "); build it from the repo root with `tools/scripts/ipe-index index`, or point IPE_INDEX_DB at the index of this repository"
                ]
            )
        )


-- A `reviewed` pair as the app reads it: both columns windowed, and the
-- read fails unless each window holds its whole column.
reviewedPairColumns : String
reviewedPairColumns =
    shownColumn "uid" "uid" ++ ", " ++ shownColumn "body_hash" "body_hash"


reviewedPairDecoder : Db.Decode.Decoder ( String, String )
reviewedPairDecoder =
    Db.Decode.succeed (\uid hash -> ( uid, hash ))
        |> Db.Decode.required "uid" (wholeColumnDecoder "uid")
        |> Db.Decode.required "body_hash" (wholeColumnDecoder "body_hash")


-- The index database at `settings` opened read-only: the one read
-- connection a page load or lookup opens and then passes to every query it
-- runs, from settings the caller resolved once.
readConnection : IndexSettings -> Task.Task Error Db.Db
readConnection settings =
    Db.open settings.db.read


-- Where a page starts in the `(enqueued_at, uid)` order of `openColumns`: the
-- head, or strictly after the last row of the previous page. `uid` breaks
-- ties on `enqueued_at` (a unit with no queue row orders at 0), so the order
-- is total and no row is skipped or repeated across pages.
type Cursor
    = Start
    | After { enqueuedAt : Int, uid : Uid }


-- An open unit with the `enqueued_at` it is ordered by, so the caller can
-- build the cursor for the following page.
type alias PendingRow =
    { unit : Unit
    , change : Change
    , enqueuedAt : Int
    }


-- What the index recorded about an open unit's current body: a new unit, a
-- modified one with the hash it replaced, or no queue row for this body at
-- all. Membership never depends on it: a unit is open because its current
-- (uid, body_hash) pair is undecided, so a unit whose change event is
-- missing is still listed, as `Unrecorded`.
type Change
    = New
    | Modified { old : String }
    | Unrecorded


-- The `change`/`old_hash` columns of `openColumns`, parsed once. A `modified`
-- row without the hash it replaced, an `old_hash` with no change, and a
-- change kind this reviewer does not know each fail the read rather than
-- being shown as something they are not.
changeDecoder : Db.Decode.Decoder Change
changeDecoder =
    Db.Decode.succeed (\change old -> ( change, old ))
        |> Db.Decode.required "change" (nullableWholeColumnDecoder "change")
        |> Db.Decode.required "old_hash" (nullableWholeColumnDecoder "old_hash")
        |> Db.Decode.andThen (\( change, old ) -> changeOf change old)


changeOf : Maybe String -> Maybe String -> Db.Decode.Decoder Change
changeOf change old =
    case change of
        Nothing ->
            case old of
                Nothing ->
                    Db.Decode.succeed Unrecorded

                Just _ ->
                    Db.Decode.fail "an open unit has an old_hash but no change"

        Just kind ->
            if kind == "new" then
                Db.Decode.succeed New

            else if kind == "modified" then
                case old of
                    Just hash ->
                        Db.Decode.succeed (Modified { old = hash })

                    Nothing ->
                        Db.Decode.fail "a modified unit has no old_hash"

            else
                Db.Decode.fail "an open unit has a change kind this reviewer does not know"


-- The one membership read: the index's current units whose (uid,
-- body_hash) pair is not in the `reviewed` copy, written here over the
-- index's tables rather than read through any view, trigger or other
-- derived object the index file defines, since anyone who can write the
-- file can redefine those. The page and the count share `openMembership`,
-- so the total always counts exactly the rows a page can return. The pairs
-- compare under `BINARY`, whatever collation the file declares. A unit
-- joins its queue row for its current body unless that row is `deleted`,
-- which says nothing about a unit that still stands; any other kind, a
-- missing one included, reaches `changeDecoder`, which fails the read on
-- one this reviewer does not know.
openColumns : BoundTags -> String
openColumns bound =
    "SELECT " ++ shownNames "uid" ++ ", line_start, line_end, " ++ shownNames "body_hash" ++ ", " ++ shownNames "lang" ++ ", " ++ unitShownSelect ++ ", " ++ shownNames "change" ++ ", " ++ shownNames "old_hash" ++ ", enqueued_at FROM (SELECT u.uid AS uid, " ++ shownColumn "u.uid" "uid" ++ ", u.line_start AS line_start, u.line_end AS line_end, " ++ shownColumn "u.body_hash" "body_hash" ++ ", " ++ shownColumn "f.lang" "lang" ++ ", " ++ unitShownColumns ++ ", " ++ shownColumn "q.change" "change" ++ ", " ++ shownColumn "q.old_hash" "old_hash" ++ ", COALESCE(q.enqueued_at, 0) AS enqueued_at FROM units u LEFT JOIN files f ON f.path = u.path LEFT JOIN change_queue q ON q.uid = u.uid AND q.new_hash = u.body_hash AND q.change IS NOT 'deleted' WHERE" ++ openMembership ++ " AND" ++ bound.sql ++ ")"


-- The membership condition on a unit row `u`: no pair of the `reviewed`
-- copy is its (uid, body_hash).
openMembership : String
openMembership =
    " NOT EXISTS (SELECT 1 FROM reviewed r WHERE r.uid = u.uid COLLATE BINARY AND r.body_hash = u.body_hash COLLATE BINARY)"


openOrder : String
openOrder =
    " ORDER BY enqueued_at, uid LIMIT ?"


-- The page query and its bound parameters for `cursor`. Every value is a
-- bound parameter: the bound tags first, the page bound always last.
pendingPageQuery : BoundTags -> PageSize -> Cursor -> ( String, List SqlValue )
pendingPageQuery bound size cursor =
    case cursor of
        Start ->
            ( openColumns bound ++ openOrder, bound.params ++ [ SqlInt (PageSize.toInt size) ] )

        After at ->
            ( openColumns bound ++ " WHERE (enqueued_at, uid) > (?, ?)" ++ openOrder
            , bound.params ++ [ SqlInt at.enqueuedAt, Uid.toSql at.uid, SqlInt (PageSize.toInt size) ]
            )


pendingRowDecoder : Db.Decode.Decoder PendingRow
pendingRowDecoder =
    Db.Decode.map3
        (\core shown ( change, at ) -> { unit = withRow core shown, change = change, enqueuedAt = at })
        coreDecoder
        shownDecoder
        openColumnsDecoder


openColumnsDecoder : Db.Decode.Decoder ( Change, Int )
openColumnsDecoder =
    Db.Decode.andThen
        (\change ->
            Db.Decode.succeed (\at -> ( change, at ))
                |> Db.Decode.required "enqueued_at" (Db.Decode.int "enqueued_at")
        )
        changeDecoder


-- One page of open units at `cursor` read on `conn`, at most `size` rows
-- of metadata. No source file is read: a unit's file is read only by
-- `loadView`, so a unit whose file is missing still lists, and only a failed
-- query fails the page.
loadPendingPage : Db.Db -> BoundTags -> PageSize -> Cursor -> Task.Task Error (List PendingRow)
loadPendingPage conn bound size cursor =
    let
        ( sql, params ) =
            pendingPageQuery bound size cursor
    in
    Db.queryDecode conn sql params pendingRowDecoder


countDecoder : Db.Decode.Decoder Int
countDecoder =
    Db.Decode.succeed (\n -> n)
        |> Db.Decode.required "total" (Db.Decode.int "total")


-- How many units under a bound tag are open, counted over `openMembership`
-- without loading a row. A count query that yields no row is a failed read,
-- never a zero.
countPending : Db.Db -> BoundTags -> Task.Task Error Int
countPending conn bound =
    do
        rows <- Db.queryDecode conn ("SELECT COUNT(*) AS total FROM units u WHERE" ++ openMembership ++ " AND" ++ bound.sql) bound.params countDecoder
        singleInt "COUNT(*) of open units" rows


-- How many units under a bound tag the index holds, open or decided.
countUnits : Db.Db -> BoundTags -> Task.Task Error Int
countUnits conn bound =
    do
        rows <- Db.queryDecode conn ("SELECT COUNT(*) AS total FROM units u WHERE" ++ bound.sql) bound.params countDecoder
        singleInt "COUNT(*) over bound units" rows


-- How many units the index holds under a tag no root binds.
countUnbound : Db.Db -> BoundTags -> Task.Task Error Int
countUnbound conn bound =
    do
        rows <- Db.queryDecode conn ("SELECT COUNT(*) AS total FROM units u WHERE NOT (" ++ bound.sql ++ ")") bound.params countDecoder
        singleInt "COUNT(*) over unbound units" rows


-- How many units the index holds, bound or not.
countAll : Db.Db -> Task.Task Error Int
countAll conn =
    do
        rows <- Db.queryDecode conn "SELECT COUNT(*) AS total FROM units" [] countDecoder
        singleInt "COUNT(*) over units" rows


-- The bound and unbound counts of one read partition every row of the
-- index's `what` table (units, or unreviewable files): a row in neither (a
-- path the tag condition cannot judge) or in both fails the read rather
-- than leave a total that hides it.
partitioned : String -> Int -> Int -> Int -> Task.Task Error ()
partitioned what bound unbound held =
    if bound + unbound == held then
        Task.succeed ()

    else
        Task.fail
            (Error.unexpected
                ("the index's "
                    ++ what
                    ++ " counts do not add up: "
                    ++ String.fromInt bound
                    ++ " under bound repositories and "
                    ++ String.fromInt unbound
                    ++ " under unbound ones, of "
                    ++ String.fromInt held
                    ++ " "
                    ++ what
                    ++ "s"
                )
            )


bytesDecoder : Db.Decode.Decoder Int
bytesDecoder =
    Db.Decode.succeed (\n -> n)
        |> Db.Decode.required "bytes" (Db.Decode.int "bytes")


-- The index database's size in bytes, from SQLite's page count and page
-- size, so the size costs one constant-time query and no file read.
dbBytes : Db.Db -> Task.Task Error Int
dbBytes conn =
    do
        rows <- Db.queryDecode conn "SELECT page_count * page_size AS bytes FROM pragma_page_count(), pragma_page_size()" [] bytesDecoder
        singleInt "the index database size query" rows


singleInt : String -> List Int -> Task.Task Error Int
singleInt what rows =
    case rows of
        [ n ] ->
            Task.succeed n

        _ ->
            Task.fail (Error.unexpected (what ++ " did not return exactly one row"))


-- Why ipe-index could not review a tracked file, one constructor per tag
-- the index's `refusals.reason` column admits. `NotUtf8` and `Oversized`
-- are content reasons: the index read or hashed the file's bytes.
-- `SymlinkEntry`, `GitlinkEntry` and `UnknownMode` carry a digest of the
-- staged entry. Every other reason is blocking: its row carries no digest,
-- so no decision can bind it, and only a change to the tree closes it.
type RefusalReason
    = NotUtf8
    | Oversized
    | SymlinkEntry
    | GitlinkEntry
    | UnknownMode
    | PastHashCeiling
    | NonUtf8Name
    | NotRepoRelative
    | NestedRepository
    | NotRegular
    | UnreadableEntry
    | ReplacedEntry


-- Every reason, in the order of the index schema's `CHECK` list.
refusalReasons : List RefusalReason
refusalReasons =
    [ NotUtf8
    , Oversized
    , SymlinkEntry
    , GitlinkEntry
    , UnknownMode
    , PastHashCeiling
    , NonUtf8Name
    , NotRepoRelative
    , NestedRepository
    , NotRegular
    , UnreadableEntry
    , ReplacedEntry
    ]


-- The tag ipe-index stores for a reason.
refusalTag : RefusalReason -> String
refusalTag reason =
    case reason of
        NotUtf8 ->
            "not-utf8"

        Oversized ->
            "too-large"

        SymlinkEntry ->
            "symlink-entry"

        GitlinkEntry ->
            "gitlink-entry"

        UnknownMode ->
            "unknown-mode"

        PastHashCeiling ->
            "past-hash-ceiling"

        NonUtf8Name ->
            "non-utf8-name"

        NotRepoRelative ->
            "not-repo-relative"

        NestedRepository ->
            "nested-repository"

        NotRegular ->
            "not-regular"

        UnreadableEntry ->
            "unreadable"

        ReplacedEntry ->
            "replaced"


-- Whether a row of this reason carries a digest a decision can bind.
ackable : RefusalReason -> Bool
ackable reason =
    case reason of
        NotUtf8 ->
            True

        Oversized ->
            True

        SymlinkEntry ->
            True

        GitlinkEntry ->
            True

        UnknownMode ->
            True

        PastHashCeiling ->
            False

        NonUtf8Name ->
            False

        NotRepoRelative ->
            False

        NestedRepository ->
            False

        NotRegular ->
            False

        UnreadableEntry ->
            False

        ReplacedEntry ->
            False


parseRefusalReason : String -> Maybe RefusalReason
parseRefusalReason tag =
    List.find (\reason -> refusalTag reason == tag) refusalReasons


-- A refusal row's digest: `refusalScheme` and 64 lowercase hex digits, the
-- one form the index schema admits, a scheme apart from every unit hash.
-- Opaque: built only by `parseRefusalDigest`.
type RefusalDigest
    = RefusalDigest String


refusalScheme : String
refusalScheme =
    "refusal-blake3:"


parseRefusalDigest : String -> Maybe RefusalDigest
parseRefusalDigest stored =
    let
        digits =
            String.dropLeft (String.length refusalScheme) stored
    in
    if String.startsWith refusalScheme stored && String.length digits == 64 && String.all Uid.isLowerHex digits then
        Just (RefusalDigest stored)

    else
        Nothing


-- The stored text of a digest: the hash a decision on its row records.
refusalDigestText : RefusalDigest -> String
refusalDigestText digest =
    case digest of
        RefusalDigest stored ->
            stored


-- One file the index could not review, as a queue page lists it. `path` is
-- the index's escaped `tag:relative` form, read through a bounded window and
-- parsed once into a `Label`; `digest` is
-- Nothing exactly for a blocking reason, so a row no decision can bind has
-- no hash to bind it to. No file byte is ever part of it.
type alias RefusalRow =
    { uid : Uid
    , path : Label
    , lang : Label
    , reason : RefusalReason
    , size : Maybe Int
    , digest : Maybe RefusalDigest
    }


-- A `refusals` row's columns as stored, before its reason and digest are
-- parsed.
type alias RawRefusal =
    { uid : Uid
    , path : Label.Column
    , lang : Label.Column
    , reason : String
    , size : Maybe Int
    , digest : Maybe String
    }


makeRawRefusal : Uid -> Label.Column -> Label.Column -> String -> Maybe Int -> Maybe String -> RawRefusal
makeRawRefusal uid path lang reason size digest =
    { uid = uid
    , path = path
    , lang = lang
    , reason = reason
    , size = size
    , digest = digest
    }


rawRefusalDecoder : Db.Decode.Decoder RawRefusal
rawRefusalDecoder =
    Db.Decode.succeed makeRawRefusal
        |> Db.Decode.required "uid" (wholeUidDecoder "uid")
        |> Db.Decode.required "path" (columnDecoder "path")
        |> Db.Decode.required "lang" (columnDecoder "lang")
        |> Db.Decode.required "reason" (wholeColumnDecoder "reason")
        |> Db.Decode.required "size" (Db.Decode.nullable (Db.Decode.int "size"))
        |> Db.Decode.required "digest" (nullableWholeColumnDecoder "digest")


-- The one decoder of a refusal row. A reason this reviewer does not know, a
-- digest under another scheme, a digest on a blocking reason, a missing
-- digest on an acknowledgeable one, or a negative size fails the read, so
-- no row reaches a page in a state the schema does not admit. The failure
-- names the column, never the value.
refusalRowDecoder : Db.Decode.Decoder RefusalRow
refusalRowDecoder =
    Db.Decode.andThen refusalRowOf rawRefusalDecoder


refusalRowOf : RawRefusal -> Db.Decode.Decoder RefusalRow
refusalRowOf raw =
    case parseRefusalReason raw.reason of
        Nothing ->
            Db.Decode.fail "column reason: not a refusal reason this reviewer knows"

        Just reason ->
            case refusalDigestOf reason raw.digest of
                Err fault ->
                    Db.Decode.fail (digestFaultText fault)

                Ok digest ->
                    if negativeSize raw.size then
                        Db.Decode.fail "column size: a negative size"

                    else
                        Db.Decode.succeed
                            { uid = raw.uid
                            , path = Label.parse Label.labelCap raw.path
                            , lang = Label.parse Label.labelCap raw.lang
                            , reason = reason
                            , size = raw.size
                            , digest = digest
                            }


-- Why a refusal row's digest column does not fit its reason.
type DigestFault
    = NotRefusalDigest
    | DigestOnBlocking
    | NoDigestOnAckable


digestFaultText : DigestFault -> String
digestFaultText fault =
    case fault of
        NotRefusalDigest ->
            "column digest: not a refusal digest"

        DigestOnBlocking ->
            "column digest: a blocking reason with a digest"

        NoDigestOnAckable ->
            "column digest: an acknowledgeable reason with no digest"


refusalDigestOf : RefusalReason -> Maybe String -> Result DigestFault (Maybe RefusalDigest)
refusalDigestOf reason stored =
    case stored of
        Just text ->
            if ackable reason then
                case parseRefusalDigest text of
                    Just digest ->
                        Ok (Just digest)

                    Nothing ->
                        Err NotRefusalDigest

            else
                Err DigestOnBlocking

        Nothing ->
            if ackable reason then
                Err NoDigestOnAckable

            else
                Ok Nothing


negativeSize : Maybe Int -> Bool
negativeSize size =
    case size of
        Just n ->
            n < 0

        Nothing ->
            False


-- A refusal row as a page reads it: every text column as a bounded window
-- (`shownColumn`), never the whole stored value.
refusalColumns : String
refusalColumns =
    "SELECT " ++ refusalColumnList ++ " FROM refusals u WHERE"


refusalColumnList : String
refusalColumnList =
    shownColumn "u.uid" "uid" ++ ", " ++ shownColumn "u.path" "path" ++ ", " ++ shownColumn "u.lang" "lang" ++ ", " ++ shownColumn "u.reason" "reason" ++ ", u.size AS size, " ++ shownColumn "u.digest" "digest"


-- The membership condition on a refusal row `u`: no pair of the `reviewed`
-- copy is its (uid, digest). A blocking row's NULL digest equals no pair,
-- so it is always open.
openRefusalMembership : String
openRefusalMembership =
    " NOT EXISTS (SELECT 1 FROM reviewed r WHERE r.uid = u.uid COLLATE BINARY AND r.body_hash = u.digest COLLATE BINARY)"


-- The bound-tag condition on a refusal row `u`. A refusal's stored path is
-- ipe-index's `shown` escape of the whole tagged name, tag included, so
-- each bound tag is compared as `escapeShown` writes it: a tag holding a
-- `\\` or a character outside printable ASCII is then judged bound exactly
-- when its row's name, read back by `unescapeShown`, has that tag, the one
-- `RepoPath.resolve` joins it under. Its own type, so the units' condition,
-- which compares raw tags, cannot stand in for it.
type RefusalTags
    = RefusalTags BoundTags


refusalTags : RootMap -> RefusalTags
refusalTags roots =
    RefusalTags (boundTagsAs escapeShown roots)


refusalCondition : RefusalTags -> BoundTags
refusalCondition tags =
    case tags of
        RefusalTags bound ->
            bound


-- The first `size` open refusals under a bound tag: every acknowledgeable
-- one before any blocking one, each by path. A blocking row leaves the open
-- set only when the tree is fixed, so listing it first would let enough of
-- them keep an acknowledgeable file off the page for good.
loadRefusalPage : Db.Db -> RefusalTags -> PageSize -> Task.Task Error (List RefusalRow)
loadRefusalPage conn tags size =
    let
        bound =
            refusalCondition tags
    in
    Db.queryDecode conn
        (refusalColumns ++ openRefusalMembership ++ " AND" ++ bound.sql ++ " ORDER BY u.digest IS NULL, u.path COLLATE BINARY, u.uid COLLATE BINARY LIMIT ?")
        (bound.params ++ [ SqlInt (PageSize.toInt size) ])
        refusalRowDecoder


-- How many refusals under a bound tag are open, counted over
-- `openRefusalMembership` without loading a row.
countOpenRefusals : Db.Db -> RefusalTags -> Task.Task Error Int
countOpenRefusals conn tags =
    let
        bound =
            refusalCondition tags
    in
    do
        rows <- Db.queryDecode conn ("SELECT COUNT(*) AS total FROM refusals u WHERE" ++ openRefusalMembership ++ " AND" ++ bound.sql) bound.params countDecoder
        singleInt "COUNT(*) of open refusals" rows


-- How many refusals under a bound tag the index holds, open or decided.
countRefusals : Db.Db -> RefusalTags -> Task.Task Error Int
countRefusals conn tags =
    let
        bound =
            refusalCondition tags
    in
    do
        rows <- Db.queryDecode conn ("SELECT COUNT(*) AS total FROM refusals u WHERE" ++ bound.sql) bound.params countDecoder
        singleInt "COUNT(*) over bound refusals" rows


-- How many refusals the index holds under a tag no root binds: files no
-- page lists and no decision here can bind, said beside the unbound units.
countUnboundRefusals : Db.Db -> RefusalTags -> Task.Task Error Int
countUnboundRefusals conn tags =
    let
        bound =
            refusalCondition tags
    in
    do
        rows <- Db.queryDecode conn ("SELECT COUNT(*) AS total FROM refusals u WHERE NOT (" ++ bound.sql ++ ")") bound.params countDecoder
        singleInt "COUNT(*) over unbound refusals" rows


-- How many refusals the index holds, bound or not.
countAllRefusals : Db.Db -> Task.Task Error Int
countAllRefusals conn =
    do
        rows <- Db.queryDecode conn "SELECT COUNT(*) AS total FROM refusals" [] countDecoder
        singleInt "COUNT(*) over refusals" rows


-- Everything one queue page shows, read in one index transaction, so the
-- page rows, the open count and the unit counts describe the same index
-- state and no write between two reads can make them disagree. The rows,
-- `open` and `units` count only units under a tag `roots` binds; `unbound`
-- counts the rest, and the two must add up to every unit the index holds. The module
-- exposes no other reader of the page, the counts or the size, so no
-- caller can read one of them outside this transaction. `stamp` is the
-- text stamped on the `reviewed` copy when it was last brought up to the
-- review log, or Nothing when the copy has never been stamped or was marked
-- stale; `copy` is the digest under the server's key of every pair the
-- copy holds, or Nothing for a copy longer than any proven log. The caller
-- reads both against the review log's verdict, through `stampStatus` and
-- the digest of the pairs the log walk verified, before trusting the rest.
-- `refusals` are the first open files the index could not review under a
-- bound tag, `refusalsOpen` how many are open and `refusalsAll` how many it
-- holds, read in the same transaction as the units, so an unreviewable file
-- is open review work exactly as a unit is; `refusalsUnbound` counts the
-- unreviewable files under a tag no root binds, and the two must add up to
-- every refusal the index holds, so none is in neither count.
type alias Snapshot =
    { stamp : Maybe String
    , copy : Maybe SetDigest
    , rows : List PendingRow
    , open : Int
    , units : Int
    , unbound : Int
    , bytes : Int
    , refusals : List RefusalRow
    , refusalsOpen : Int
    , refusalsAll : Int
    , refusalsUnbound : Int
    }


readSnapshot : ReviewKey -> RootMap -> Db.Db -> Cursor -> Task.Task Error Snapshot
readSnapshot key roots conn cursor =
    let
        bound =
            boundTags roots

        refused =
            refusalTags roots
    in
    Db.withTransaction conn
        (\tx ->
            do
                stamp <- readStamp tx
                copy <- reviewedDigest key tx
                rows <- loadPendingPage tx bound PageSize.queue cursor
                open <- countPending tx bound
                units <- countUnits tx bound
                unbound <- countUnbound tx bound
                held <- countAll tx
                partitioned "unit" units unbound held
                refusals <- loadRefusalPage tx refused PageSize.queue
                counted <- countRefusalsPartitioned tx refused
                bytes <- dbBytes tx
                Task.succeed
                    { stamp = stamp
                    , copy = copy
                    , rows = rows
                    , open = open
                    , units = units
                    , unbound = unbound
                    , bytes = bytes
                    , refusals = refusals
                    , refusalsOpen = counted.open
                    , refusalsAll = counted.total
                    , refusalsUnbound = counted.unbound
                    }
        )


-- The refusal counts a snapshot carries: the open rows and every row under
-- the bound tags, and the rows under any other tag.
type alias RefusalCounts =
    { open : Int
    , total : Int
    , unbound : Int
    }


-- The refusal counts on `tx`, failed unless the bound and unbound rows are
-- every row the index holds.
countRefusalsPartitioned : Db.Db -> RefusalTags -> Task.Task Error RefusalCounts
countRefusalsPartitioned tx bound =
    do
        open <- countOpenRefusals tx bound
        total <- countRefusals tx bound
        unbound <- countUnboundRefusals tx bound
        held <- countAllRefusals tx
        partitioned "refusal" total unbound held
        Task.succeed { open = open, total = total, unbound = unbound }


-- A decided pair, as the review log stores its uid and body hash, added to
-- a digest: the one framing both the log walk and the copy read use.
digestPair : ReviewKey -> String -> String -> SetDigest -> SetDigest
digestPair key uid bodyHash digest =
    SetDigest.add key (lengthPrefixed [ "ipe-code-review/reviewed-pair/v1", uid, bodyHash ]) digest


-- How far a read of the `reviewed` copy has come: the pages read, the rows
-- read, the last pair read, and the digest so far.
type alias CopyRead =
    { pagesRead : Int
    , rows : Int
    , after : Maybe ( String, String )
    , digest : SetDigest
    }


-- Every pair of the `reviewed` copy on `conn`, in key order, in pages of
-- `PageSize.pairs`, digested under `key`. The digest is a set digest a
-- repeated pair cancels out of, so it is returned only with the proof that
-- every pair it covers is distinct and that it covers every row: `reviewed`
-- is a plain table, so the membership read in the same transaction sees the
-- rows this read saw; no pair repeats in it; every page reads strictly
-- ascending pairs, compared here rather than by any collation the file
-- declares; and the rows read are as many as the table holds. A copy failing
-- any of these, or longer than `PageSize.logPageCeiling` pages, more than
-- any proven log drains, reads Nothing.
reviewedDigest : ReviewKey -> Db.Db -> Task.Task Error (Maybe SetDigest)
reviewedDigest key conn =
    do
        tables <- countOf conn "the reviewed table check" reviewedTableSql
        repeats <- countOf conn "the reviewed repeat check" reviewedRepeatSql
        stored <- countOf conn "COUNT(*) over reviewed" "SELECT COUNT(*) AS total FROM reviewed"
        read <- Task.loop (PageSize.logPageCeiling + 1) { pagesRead = 0, rows = 0, after = Nothing, digest = SetDigest.empty } (copyStep key conn)
        Task.succeed (provenCopy (tables == 1 && repeats == 0) stored read)


-- The digest of a whole copy read, kept only when the copy's checks held
-- and the read covered every stored row.
provenCopy : Bool -> Int -> Maybe CopyRead -> Maybe SetDigest
provenCopy checked stored read =
    case read of
        Just whole ->
            if checked && whole.rows == stored then
                Just whole.digest

            else
                Nothing

        Nothing ->
            Nothing


-- One row exactly when `reviewed` is a plain table: a view or a virtual
-- table could show this read and the membership read different rows.
reviewedTableSql : String
reviewedTableSql =
    "SELECT COUNT(*) AS total FROM sqlite_master WHERE type = 'table' AND lower(name) = 'reviewed' AND sql LIKE 'CREATE TABLE %'"


-- How many (uid, body_hash) pairs the copy holds more than once.
reviewedRepeatSql : String
reviewedRepeatSql =
    "SELECT COUNT(*) AS total FROM (SELECT 1 FROM reviewed GROUP BY uid, body_hash HAVING COUNT(*) > 1)"


-- A count is one row: the read takes two, enough to see a second.
countOf : Db.Db -> String -> String -> Task.Task Error Int
countOf conn what sql =
    do
        rows <- Db.queryDecode conn (sql ++ " LIMIT 2") [] countDecoder
        singleInt what rows


copyStep : ReviewKey -> Db.Db -> CopyRead -> Task.Task Error (Task.Step CopyRead (Maybe CopyRead))
copyStep key conn read =
    do
        rows <- reviewedPage conn read.after
        Task.succeed (copyAfter key read rows)


copyAfter : ReviewKey -> CopyRead -> List ( String, String ) -> Task.Step CopyRead (Maybe CopyRead)
copyAfter key read rows =
    if List.isEmpty rows then
        Task.Done (Just read)

    else if read.pagesRead >= PageSize.logPageCeiling then
        Task.Done Nothing

    else if not (ascending read.after rows) then
        Task.Done Nothing

    else
        let
            next =
                { pagesRead = read.pagesRead + 1
                , rows = read.rows + List.length rows
                , after = List.head (List.reverse rows)
                , digest = List.foldl (\( uid, hash ) d -> digestPair key uid hash d) read.digest rows
                }
        in
        if List.length rows < PageSize.toInt PageSize.pairs then
            Task.Done (Just next)

        else
            Task.Continue next


-- True when every pair of `rows` follows the one before it, the first
-- following `after`, so no pair of one read repeats.
ascending : Maybe ( String, String ) -> List ( String, String ) -> Bool
ascending after rows =
    case List.foldl (\pair last -> Maybe.andThen (\prior -> pairFollows prior pair) last) (Just after) rows of
        Just _ ->
            True

        Nothing ->
            False


pairFollows : Maybe ( String, String ) -> ( String, String ) -> Maybe (Maybe ( String, String ))
pairFollows prior pair =
    case prior of
        Nothing ->
            Just (Just pair)

        Just ( lastUid, lastHash ) ->
            case pair of
                ( uid, hash ) ->
                    if uid > lastUid || (uid == lastUid && hash > lastHash) then
                        Just (Just pair)

                    else
                        Nothing


reviewedPage : Db.Db -> Maybe ( String, String ) -> Task.Task Error (List ( String, String ))
reviewedPage conn after =
    case after of
        Nothing ->
            Db.queryDecode conn ("SELECT " ++ reviewedPairColumns ++ " FROM reviewed ORDER BY uid COLLATE BINARY, body_hash COLLATE BINARY LIMIT ?") [ SqlInt (PageSize.toInt PageSize.pairs) ] reviewedPairDecoder

        Just ( uid, hash ) ->
            Db.queryDecode conn ("SELECT " ++ reviewedPairColumns ++ " FROM reviewed WHERE (uid COLLATE BINARY, body_hash COLLATE BINARY) > (?, ?) ORDER BY uid COLLATE BINARY, body_hash COLLATE BINARY LIMIT ?") [ SqlString uid, SqlString hash, SqlInt (PageSize.toInt PageSize.pairs) ] reviewedPairDecoder


stampDecoder : Db.Decode.Decoder String
stampDecoder =
    Db.Decode.succeed (\head -> head)
        |> Db.Decode.required "head" (wholeColumnDecoder "head")


-- The head stamped on the `reviewed` copy: Nothing when no stamp row
-- exists. More than one row is a failed read, whatever key the file's
-- table declares: the read takes at most two rows, enough to see a second.
readStamp : Db.Db -> Task.Task Error (Maybe String)
readStamp conn =
    do
        rows <- Db.queryDecode conn ("SELECT " ++ shownColumn "head" "head" ++ " FROM reviewed_stamp WHERE one = 1 LIMIT 2") [] stampDecoder
        case rows of
            [] ->
                Task.succeed Nothing

            [ head ] ->
                Task.succeed (Just head)

            _ ->
                Task.fail (Error.unexpected "reviewed_stamp holds more than one row")


-- The review log's head: the log's id, the seq of its last entry (0 while
-- the log is empty), that entry's mac (`genesis` while it is empty) and the
-- key check binding the log to the key that signs it (absent until a
-- signing key adopts the log).
-- Opaque: minted only by `chainHeadDecoder` (a read of the review
-- database's `review_log_head`) and `chainNext` (the head after one more
-- entry), so a head is never built from a count or a bare string.
type ChainHead
    = ChainHead { logId : String, seq : Int, mac : String, keyCheck : Maybe String }


chainHeadDecoder : Db.Decode.Decoder ChainHead
chainHeadDecoder =
    Db.Decode.succeed (\logId seq mac keyCheck -> ChainHead { logId = logId, seq = seq, mac = mac, keyCheck = keyCheck })
        |> Db.Decode.required "log_id" (Db.Decode.string "log_id")
        |> Db.Decode.required "seq" (Db.Decode.int "seq")
        |> Db.Decode.required "head" (Db.Decode.string "head")
        |> Db.Decode.required "key_check" (Db.Decode.nullable (Db.Decode.string "key_check"))


-- The head once the entry whose mac is `mac` is appended at the next seq.
chainNext : ChainHead -> String -> ChainHead
chainNext head mac =
    case head of
        ChainHead h ->
            ChainHead { logId = h.logId, seq = h.seq + 1, mac = mac, keyCheck = h.keyCheck }


-- A head as it is stamped and compared: the log id, the seq and the mac.
chainHeadText : ChainHead -> String
chainHeadText head =
    case head of
        ChainHead h ->
            h.logId ++ ":" ++ String.fromInt h.seq ++ ":" ++ h.mac


-- The id of the log a head belongs to; every entry's mac covers it.
chainLogId : ChainHead -> String
chainLogId head =
    case head of
        ChainHead h ->
            h.logId


-- The seq of the head's last entry, 0 for an empty log.
chainSeq : ChainHead -> Int
chainSeq head =
    case head of
        ChainHead h ->
            h.seq


-- The mac of the head's last entry, `genesis` for an empty log: the `prev`
-- the next entry carries.
chainMac : ChainHead -> String
chainMac head =
    case head of
        ChainHead h ->
            h.mac


-- The key check the head carries, absent on a log no signing key adopted.
chainKeyCheck : ChainHead -> Maybe String
chainKeyCheck head =
    case head of
        ChainHead h ->
            h.keyCheck


-- The parts, each written as its decimal length in code points, `:`, then
-- the part, so no choice of parts can make two different lists produce the
-- same text.
lengthPrefixed : List String -> String
lengthPrefixed parts =
    String.concat (List.map (\part -> String.fromInt (String.length part) ++ ":" ++ part) parts)


-- What a walk of the whole review log found: every entry in seq order from
-- 1, each linking the mac before it, ending at the head; or the first entry
-- at which that fails.
type ChainVerdict
    = Intact
    | BrokenAt Int


-- What the `reviewed` copy was rebuilt under: a signing key and the chain
-- verdict of the log it read, or no key, under which nothing is counted.
type LogStatus
    = Signed ChainVerdict
    | Unsigned


-- The text stamped on the `reviewed` copy: the head it was brought up to
-- and the status it was rebuilt under. Opaque: built only by `signedStamp`
-- and `unsignedStamp`, and read back only through `stampStatus`.
type Stamp
    = Stamp String


stampText : Stamp -> String
stampText stamp =
    case stamp of
        Stamp text ->
            text


-- A stamp under `key`: its mac covers the head and the verdict, so a copy
-- rebuilt under another key, or a verdict written by anything but this
-- tool, never reads as current.
signedStamp : MacKey -> ChainHead -> ChainVerdict -> Stamp
signedStamp key head verdict =
    let
        word =
            verdictWord verdict
    in
    Stamp (ReviewKey.sign key (stampInput head word) ++ " " ++ word ++ " " ++ chainHeadText head)


-- The stamp of a copy rebuilt with no key: it counts nothing.
unsignedStamp : ChainHead -> Stamp
unsignedStamp head =
    Stamp ("read-only " ++ chainHeadText head)


stampInput : ChainHead -> String -> String
stampInput head word =
    lengthPrefixed [ "ipe-code-review/reviewed-stamp/v1", chainHeadText head, word ]


verdictWord : ChainVerdict -> String
verdictWord verdict =
    case verdict of
        Intact ->
            "intact"

        BrokenAt n ->
            "broken-" ++ String.fromInt n


verdictOfWord : String -> Maybe ChainVerdict
verdictOfWord word =
    if word == "intact" then
        Just Intact

    else if String.startsWith "broken-" word then
        String.toInt (String.dropLeft (String.length "broken-") word)
            |> Maybe.andThen positiveEntry

    else
        Nothing


positiveEntry : Int -> Maybe ChainVerdict
positiveEntry n =
    if n >= 1 then
        Just (BrokenAt n)

    else
        Nothing


-- The status a stamp records, when it is the stamp `key` would write for
-- `head`: Nothing for a missing stamp, a stamp of another head, a stamp
-- written under another key or with no key by a signing server, and a
-- signed stamp read by a server with no key. Its mac is parsed once and
-- verified in constant time.
stampStatus : ReviewKey -> ChainHead -> Maybe String -> Maybe LogStatus
stampStatus key head stamp =
    case stamp of
        Nothing ->
            Nothing

        Just text ->
            case key of
                ReadOnly ->
                    if text == stampText (unsignedStamp head) then
                        Just Unsigned

                    else
                        Nothing

                Signing macKey ->
                    signedStatus macKey head text


signedStatus : MacKey -> ChainHead -> String -> Maybe LogStatus
signedStatus key head text =
    case String.split " " text of
        macHex :: word :: rest ->
            if String.join " " rest == chainHeadText head then
                case ( verdictOfWord word, Crypto.macFromHex macHex ) of
                    ( Just verdict, Just mac ) ->
                        if ReviewKey.verifies key (stampInput head word) mac then
                            Just (Signed verdict)

                        else
                            Nothing

                    _ ->
                        Nothing

            else
                Nothing

        _ ->
            Nothing


-- What recording a decision did to the review log: a new entry moved the
-- head, so the copy's stamp moves from `prev` to `next`; or the pair was
-- already decided and nothing moved.
type Written
    = Inserted { prev : Stamp, next : Stamp }
    | AlreadyDecided


-- The review app consumes and clears explicitly: after a unit is decided,
-- one index transaction adds the pair to the `reviewed` copy, deletes the
-- unit's change_queue row for that hash, and moves the copy's stamp along
-- the review log. A new decision moves the stamp from `prev` to `next` only
-- if it still reads `prev`; any other stamp means the copy missed a
-- decision, so the stamp row is deleted and the next load rebuilds the copy
-- rather than vouch for it. An already-decided pair leaves the stamp alone.
-- Returns the count of queue rows deleted. The index is the one `settings`
-- names, resolved once at startup.
drainUnit : IndexSettings -> Attested -> Written -> Task.Task Error Int
drainUnit settings attested written =
    do
        conn <- Db.open settings.db.write
        Db.withTransaction conn
            (\tx ->
                do
                    drained <- drainPair tx (attestedUid attested) (attestedHash attested)
                    moveStamp tx written
                    Task.succeed drained
            )


moveStamp : Db.Db -> Written -> Task.Task Error ()
moveStamp conn written =
    case written of
        AlreadyDecided ->
            Task.succeed ()

        Inserted link ->
            do
                moved <- Db.exec conn "UPDATE reviewed_stamp SET head = ? WHERE one = 1 AND head = ?" [ SqlString (stampText link.next), SqlString (stampText link.prev) ]
                if moved == 1 then
                    Task.succeed ()

                else
                    Db.exec conn "DELETE FROM reviewed_stamp" []
                        |> Task.map (\_ -> ())


-- A decided (uid, body_hash) pair as the review log holds it. Opaque:
-- built only by `decidedPairDecoder`, which `Lib.Db` runs over the log rows
-- whose mac verifies, so a refill drains only pairs read back from them.
type DecidedPair
    = DecidedPair { uid : Uid, hash : String }


-- The one constructor of a `DecidedPair`: a row's `uid` and `body_hash`,
-- the uid parsed once here. A uid that is not a unit id decodes as Nothing,
-- a row with no pair, never a failed read.
decidedPairDecoder : Db.Decode.Decoder (Maybe DecidedPair)
decidedPairDecoder =
    Db.Decode.succeed decidedPairOf
        |> Db.Decode.required "uid" (Db.Decode.string "uid")
        |> Db.Decode.required "body_hash" (Db.Decode.string "body_hash")


decidedPairOf : String -> String -> Maybe DecidedPair
decidedPairOf stored hash =
    case Uid.parse stored of
        Ok uid ->
            Just (DecidedPair { uid = uid, hash = hash })

        Err _ ->
            Nothing


-- A decided pair's key, read-only: the (uid, body_hash) it was decoded from.
decidedPairKey : DecidedPair -> ( Uid, String )
decidedPairKey pair =
    case pair of
        DecidedPair p ->
            ( p.uid, p.hash )


-- One decided pair drained on `conn`, the refill step of `rebuildReviewed`.
-- Atomic only inside the transaction `rebuildReviewed` opens.
drainDecided : Db.Db -> DecidedPair -> Task.Task Error Int
drainDecided conn pair =
    case pair of
        DecidedPair p ->
            drainPair conn p.uid p.hash


-- One decided pair drained on `conn`, the one step both a drain and a
-- rebuild run: the pair is added to `reviewed` (a pair already there is
-- kept, so the first review wins and a re-drain is a no-op), then the
-- change_queue row queued for that hash is deleted. Only the row queued for
-- the decided hash is deleted: a re-index that re-queued the unit under new
-- content keeps its row, so the index's own pending list still names that
-- change. Whether a unit is open never reads this row: `openMembership`
-- compares the current pair with `reviewed`. Returns the count of queue rows
-- deleted. Atomic only inside a transaction the caller opens.
drainPair : Db.Db -> Uid -> String -> Task.Task Error Int
drainPair conn uid hash =
    do
        Db.exec conn "INSERT OR IGNORE INTO reviewed (uid, body_hash) VALUES (?, ?)" [ Uid.toSql uid, SqlString hash ]
        Db.deleteWhere conn
            "change_queue"
            (Sql.and
                (Sql.eq (Sql.column "uid") (Sql.param (Uid.toSql uid)))
                (Sql.eq (Sql.column "new_hash") (Sql.param (SqlString hash)))
            )


-- The `reviewed` copy rebuilt in one index transaction: every row is
-- deleted, `refill` re-adds the decided pairs through `drainDecided` on the
-- transaction's connection it is given and returns the stamp of what it
-- read, and the copy is stamped with it. A failed refill rolls the whole
-- rebuild back, leaving the copy and its stamp as they were. The index is
-- the one `settings` names, resolved once at startup.
rebuildReviewed : IndexSettings -> (Db.Db -> Task.Task Error ( Stamp, a )) -> Task.Task Error a
rebuildReviewed settings refill =
    do
        conn <- Db.open settings.db.write
        Db.withTransaction conn
            (\tx ->
                do
                    Db.exec tx "DELETE FROM reviewed" []
                    refilled <- refill tx
                    Db.exec tx "INSERT OR REPLACE INTO reviewed_stamp (one, head) VALUES (1, ?)" [ SqlString (stampText (Tuple.first refilled)) ]
                    Task.succeed (Tuple.second refilled)
            )


-- The one verification of a unit's source. The stored hash is parsed first,
-- so an unknown scheme refuses before any read; then a stored path longer
-- than its window, cut at a NUL byte or not stored as text is refused under
-- that cause, so no prefix is ever joined; then the stored
-- path is resolved, a span past the line ceiling is withheld before any
-- read, a file unit's child spans are read on `conn`, the file is read and
-- `classifyView` judges the view. Every per-unit cause (refused path,
-- unreadable file, oversized view, bad range, drift) is a `SourceView`
-- state, never a failed task.
viewOf : Db.Db -> RootMap -> RowCore -> RowShown -> Task.Task Error SourceView
viewOf conn roots row columns =
    case provable (parseAttested row.bodyHash) of
        Nothing ->
            Task.succeed (Stale UnverifiableHash)

        Just stored ->
            case Label.extent columns.path of
                CutAtWindow ->
                    Task.succeed (Unreadable (PathPastWindow (storedPathLabel columns.path)))

                CutAtNul ->
                    Task.succeed (Unreadable (PathHoldsNul (storedPathLabel columns.path)))

                NotTextCell ->
                    Task.succeed (Unreadable (PathNotText (storedPathLabel columns.path)))

                WholeColumn storedPath ->
                    case RepoPath.resolve roots storedPath of
                        Err refusal ->
                            Task.succeed (Unreadable (PathRefused refusal))

                        Ok path ->
                            case spanOversize row.lineStart row.lineEnd of
                                Just over ->
                                    Task.succeed (TooLarge over)

                                Nothing ->
                                    do
                                        body <- bodyOf conn row columns.kind storedPath
                                        case body of
                                            Err over ->
                                                Task.succeed (TooLarge over)

                                            Ok covered ->
                                                File.readFileLimit path sourceCeiling
                                                    |> Task.map (classifyView row.uid (langOf row.lang) stored covered)
                                                    |> Task.onError (\_ -> unreadableAt (storedPathLabel columns.path) path)


-- A stored path as a read failure names it: a quoted label, so it is drawn
-- bounded and between quotes it cannot close.
storedPathLabel : Label.Column -> Label
storedPathLabel column =
    Label.parseQuoted Label.labelCap column


-- What `row`'s attestation covers, ipe-index's rule: a file unit (its whole
-- `kind` column is `fileKind`) attests its residual against the spans of
-- every other unit of its file at `storedPath`, read one past
-- `childSpanCeiling` so a full read is refused rather than trusted; every
-- other unit attests its line range.
bodyOf : Db.Db -> RowCore -> Label.Column -> String -> Task.Task Error (Result Oversize Body)
bodyOf conn row kind storedPath =
    if Label.whole kind == Just fileKind then
        Db.queryDecode conn childSpansSql [ SqlString storedPath, SqlInt (childSpanCeiling + 1) ] spanDecoder
            |> Task.map residualBody

    else
        Task.succeed (Ok (LineRange row.lineStart row.lineEnd))


residualBody : List ( Int, Int ) -> Result Oversize Body
residualBody spans =
    if List.length spans > childSpanCeiling then
        Err (ChildSpans { atLeast = List.length spans })

    else
        Ok (Residual spans)


-- The kind ipe-index stores for a whole-file unit.
fileKind : String
fileKind =
    "file"


-- The spans ipe-index reads when it attests a file unit, on `i_units_path`.
childSpansSql : String
childSpansSql =
    "SELECT line_start, line_end FROM units WHERE path = ? AND kind != 'file' LIMIT ?"


spanDecoder : Db.Decode.Decoder ( Int, Int )
spanDecoder =
    Db.Decode.succeed (\first last -> ( first, last ))
        |> Db.Decode.required "line_start" (Db.Decode.int "line_start")
        |> Db.Decode.required "line_end" (Db.Decode.int "line_end")


-- The most child spans a file unit's residual is judged against. A file
-- within `viewLineCeiling` lines holds far fewer units; more is refused.
childSpanCeiling : Int
childSpanCeiling =
    4 * viewLineCeiling


-- Why the read of `stored`'s joined `path` failed, judged by whether
-- anything is there. The read error's own text is never kept, so no OS
-- wording or error number reaches the page.
unreadableAt : Label -> Path -> Task.Task Error SourceView
unreadableAt stored path =
    File.exists path
        |> Task.map (failureFor stored)
        |> Task.onError (\_ -> Task.succeed (Unreadable (CannotRead stored)))


failureFor : Label -> Bool -> SourceView
failureFor stored present =
    if present then
        Unreadable (CannotRead stored)

    else
        Unreadable (NoFile stored)


-- The one rendering of a `ReadFailure`, naming the stored path and the fix:
-- the stored path is the failure's own quoted label, every other piece the
-- tool's text, so no index text and no error text reaches the line.
readFailureText : ReadFailure -> List LabelPiece
readFailureText failure =
    case failure of
        PathRefused refusal ->
            RepoPath.describe refusal

        PathPastWindow stored ->
            storedPathText stored
                (SafeText.concat
                    [ SafeText.literal "is longer than the "
                    , SafeText.render (String.fromInt Label.windowChars)
                    , SafeText.literal " characters the index read returns, so it is never joined; re-run `ipe-index index` from a checkout with shorter paths"
                    ]
                )

        PathHoldsNul stored ->
            storedPathText stored (SafeText.literal "holds a NUL byte, where the index read stops, so it is never joined; re-run `ipe-index index` so the path is stored as the file's name")

        PathNotText stored ->
            storedPathText stored (SafeText.literal "is not stored as text, so it is never joined; re-run `ipe-index index` so the path is stored as the file's name")

        NoFile stored ->
            storedPathText stored (SafeText.literal "names no file under the repository root; re-run `ipe-index index` if the file was moved or deleted")

        CannotRead stored ->
            storedPathText stored
                (SafeText.concat
                    [ SafeText.literal "exists but did not read as text: it is past the "
                    , SafeText.render (String.fromInt (ByteSize.toBytes sourceCeiling))
                    , SafeText.literal "-byte limit, not UTF-8, not a regular file, or not readable by this process"
                    ]
                )


-- `index path "<stored>" <problem>`, the problem the tool's text.
storedPathText : Label -> SafeText -> List LabelPiece
storedPathText stored problem =
    [ ToolText (SafeText.literal "index path \"")
    , IndexedLabel stored
    , ToolText (SafeText.concat [ SafeText.literal "\" ", problem ])
    ]


-- The one judgement of a unit's view, in precedence order: a body past the
-- line ceiling, a range outside `text`, a view past the byte ceiling, a view
-- whose drawing takes more elements than the element ceiling, then the
-- attestation compare. The rows drawn and the text hashed come from one
-- `bodyRows` list, joined by `bodyText`, and the rows are drawn here once, in
-- `lang`: coloured when that fits the element ceiling, else as plain text.
-- `ShownSource` is built only here, so holding one proves the view is within
-- every ceiling, re-hashes to `stored`, and carries the drawing that was
-- counted. An oversized view is never hashed: re-indexing cannot make it
-- shown.
classifyView : Uid -> Highlight.Lang -> String -> Body -> String -> SourceView
classifyView uid lang stored body text =
    let
        lines =
            viewLines text
    in
    case bodyOversize body lines of
        Just over ->
            TooLarge over

        Nothing ->
            case bodyRows body lines of
                Err reason ->
                    Stale reason

                Ok rows ->
                    let
                        view =
                            bodyText body rows

                        size =
                            Bytes.length (Bytes.fromString view)
                    in
                    if size > ByteSize.toBytes viewByteCeiling then
                        TooLarge (ViewBytes { size = ByteSize.bytes size })

                    else
                        case fittingDrawing lang rows of
                            Err over ->
                                TooLarge over

                            Ok drawn ->
                                if bodyAttest body view == stored then
                                    Shown (ShownSource { uid = uid, rows = rows, text = view, hash = stored, drawn = drawn })

                                else
                                    Stale Drifted


-- The rows drawn coloured when that takes at most `viewNodeCeiling`
-- elements, else drawn plain when that does; past both, the plain drawing's
-- count, the fewest elements the view can be drawn in.
fittingDrawing : Highlight.Lang -> List SourceRow -> Result Oversize DrawnSource
fittingDrawing lang rows =
    let
        colored =
            Drawn.highlighted lang rows
    in
    if Drawn.elements colored <= viewNodeCeiling then
        Ok colored

    else
        let
            uncolored =
                Drawn.plain lang rows

            nodes =
                Drawn.elements uncolored
        in
        if nodes <= viewNodeCeiling then
            Ok uncolored

        else
            Err (ViewNodes { nodes = nodes })


-- A line range past the line ceiling, or a file unit whose file is: the
-- residual is judged over every line of the file.
bodyOversize : Body -> List String -> Maybe Oversize
bodyOversize body lines =
    case body of
        LineRange start end ->
            spanOversize start end

        Residual _ ->
            let
                count =
                    List.length lines
            in
            if count > viewLineCeiling then
                Just (SpanLines { lines = count })

            else
                Nothing


-- A span of more than `viewLineCeiling` lines, judged on the indexed range
-- alone. Only a valid range (`1 <= start <= end`) is judged, which keeps
-- `end - start` and its `+ 1` inside `Int` for any stored integers; an invalid
-- range is left to `viewText`, which refuses it.
spanOversize : Int -> Int -> Maybe Oversize
spanOversize start end =
    if 1 <= start && start <= end && end - start >= viewLineCeiling then
        Just (SpanLines { lines = end - start + 1 })

    else
        Nothing


-- The most lines a shown view may have: each line is a drawn row.
viewLineCeiling : Int
viewLineCeiling =
    5000


-- The most UTF-8 bytes a shown view may hold: bytes bound the drawn tokens,
-- which a single long line can multiply without adding rows.
viewByteCeiling : ByteSize
viewByteCeiling =
    ByteSize.kib 256


-- The most elements a shown view's drawing may take. The session's model and
-- its one charged tree are refused past `runtimeSessionCeiling`;
-- `viewNodeCeiling` elements at `elementResidentBytes` each, plus
-- `viewReserve` for every copy of the view's text, fit three quarters of it:
-- (12 MiB - 5 MiB) / 1.5 KiB = 4778 elements, rounded down to 4096 so 1 MiB
-- stays spare; 4096 * 1.5 KiB + 5 MiB = 11 MiB <= 12 MiB. The last quarter
-- holds the queue page's chrome and labels with the session's fixed charge
-- (`queueElementCeiling`), and the 1 MiB spare the model and history. The
-- relation is checked by a test, over numbers mirrored from the runtime.
viewNodeCeiling : Int
viewNodeCeiling =
    4096


-- The most elements a queue page draws besides the selected unit's source:
-- each rail row's chrome and its three labels, each unreviewable file's card
-- and its path, the page's own chrome with the selected card's links, and
-- the selected card's labels. A label draws at most `labelElements`. These
-- elements at `elementResidentBytes` each, plus the labels' bytes in the model
-- and again in the tree, plus `runtimeEntryOverhead`, fit the quarter of
-- `runtimeSessionCeiling` the unit view leaves; a test checks the relation
-- and measures a page of hostile labels against the count.
queueElementCeiling : Int
queueElementCeiling =
    let
        rows =
            PageSize.toInt PageSize.queue
    in
    rows * (railRowChrome + railLabels * labelElements)
        + rows * (refusalRowChrome + labelElements)
        + queuePageChrome
        + cardLabels * labelElements


-- The most bytes the labels of one queue page hold: each unit's five labels
-- and its purpose, and each unreviewable file's path, at their caps with a
-- marker, and every link the selected card shows at `Links.linkByteCeiling`.
queueLabelByteCeiling : Int
queueLabelByteCeiling =
    let
        rows =
            PageSize.toInt PageSize.queue

        label =
            Label.capBytes Label.labelCap + Label.markerByteCeiling

        purpose =
            Label.capBytes Label.purposeCap + Label.markerByteCeiling
    in
    rows * (5 * label + purpose) + rows * label + Links.linkCeiling * Links.linkByteCeiling


-- One drawn label: its wrapping span and at most `Label.elementCeiling`
-- elements inside it.
labelElements : Int
labelElements =
    1 + Label.elementCeiling


-- A rail row's elements besides its labels: the button, its row, the label
-- row, the three label boxes and the two badges, with room to spare.
railRowChrome : Int
railRowChrome =
    12


-- The labels a rail row draws: kind, name and place.
railLabels : Int
railLabels =
    3


-- An unreviewable file's card besides its path: the card, its two rows, the
-- heading, the reason chip, the spacer, the decision controls, the size and
-- the digest, with room to spare.
refusalRowChrome : Int
refusalRowChrome =
    20


-- A queue page's elements outside its rows and the selected card's labels:
-- the header and navigation, the progress, banner and hint lines, the
-- selected card's chrome and open refusal panel, and `linkElements` for each
-- link the card can show.
queuePageChrome : Int
queuePageChrome =
    200 + Links.linkCeiling * linkElements


-- One drawn link: its anchor and the label it wraps, the mark included.
linkElements : Int
linkElements =
    linkAnchor + labelElements


-- The elements a link draws around its label.
linkAnchor : Int
linkAnchor =
    1


-- The labels the selected card draws: kind, name and place in its heading,
-- its facing, its path and its purpose.
cardLabels : Int
cardLabels =
    6


-- The runtime's per-session memory ceiling, mirrored from `SESSION_CEILING`
-- in `src/runtime/rust/src/web/budget.rs`; a test reads that line and fails
-- when the two differ.
runtimeSessionCeiling : ByteSize
runtimeSessionCeiling =
    ByteSize.mib 16


-- The fixed charge the runtime books against every session before its model
-- or tree, mirrored from `ENTRY_OVERHEAD` in
-- `src/runtime/rust/src/web/budget.rs`; a test reads that line and fails when
-- the two differ.
runtimeEntryOverhead : ByteSize
runtimeEntryOverhead =
    ByteSize.kib 256


-- What one drawn element holds resident in the runtime's session tree once
-- stamped, its text and sibling text included, at most `drawnDepthCeiling`
-- deep, in a view of any composition: mirrored from `DRAWN_ELEMENT_BYTES` in
-- `src/runtime/rust/src/web/budget.rs`, whose test measures it on views of
-- this app's shapes at that depth. A test here reads that line and fails when
-- the two differ.
elementResidentBytes : ByteSize
elementResidentBytes =
    ByteSize.bytes 1536


-- The deepest nesting, the root counted, `elementResidentBytes` holds at:
-- mirrored from `DRAWN_ELEMENT_DEPTH` in `src/runtime/rust/src/web/budget.rs`.
-- An element's id spells every ancestor, so a deeper page costs each element
-- more; a test measures how deep the unit page draws its source.
drawnDepthCeiling : Int
drawnDepthCeiling =
    24


-- What a shown view holds besides its counted elements, at most
-- `viewByteCeiling` bytes of text and `viewLineCeiling` lines: the text in
-- the rows and again whole in the model, the drawing's escaped characters
-- at four bytes each with up to as much again of spare capacity, and the
-- tree's escape spelling, six bytes for one source byte; sixteen copies in
-- all, plus each line's row, string and line number.
viewReserve : ByteSize
viewReserve =
    ByteSize.mib 5


-- The largest source file a unit is sliced from; a bigger file under the root
-- is refused rather than read whole into memory.
sourceCeiling : ByteSize
sourceCeiling =
    ByteSize.mib 16


-- The single decode point from a unit row: the stored hash and language are
-- parsed here, and every displayed column is parsed into a bounded `Label`.
withRow : RowCore -> RowShown -> Unit
withRow row shown =
    { uid = row.uid
    , path = Label.parse Label.labelCap shown.path
    , name = Label.parse Label.labelCap shown.name
    , qualified = Label.parse Label.labelCap shown.qualified
    , kind = Label.parse Label.labelCap shown.kind
    , lang = langOf row.lang
    , lineStart = row.lineStart
    , lineEnd = row.lineEnd
    , facing = Label.parse Label.labelCap shown.facing
    , purpose = Maybe.map (Label.parse Label.purposeCap) shown.purpose
    , attested = parseAttested row.bodyHash
    }


-- A stored file language parsed for highlighting; a unit with no file row,
-- or whose language the window does not hold whole, reads as `Unknown`,
-- shown as escaped plain text.
langOf : Maybe Label.Column -> Highlight.Lang
langOf stored =
    case Maybe.andThen Label.whole stored of
        Just lang ->
            Highlight.langFor lang

        Nothing ->
            Highlight.Unknown


-- A stored `body_hash`, parsed once: an attestation this app can re-prove
-- (a line range's under `attestScheme`, a residual's under
-- `residualScheme`), an unreviewable file's digest under `refusalScheme`,
-- which no source view re-proves, or a value under any other scheme (a
-- legacy or unknown hash).
type AttestedHash
    = Sha256 String
    | ResidualSha256 String
    | RefusalBlake3 String
    | UnknownScheme String


parseAttested : String -> AttestedHash
parseAttested stored =
    if String.startsWith attestScheme stored then
        Sha256 stored

    else if String.startsWith residualScheme stored then
        ResidualSha256 stored

    else if String.startsWith refusalScheme stored then
        RefusalBlake3 stored

    else
        UnknownScheme stored


-- The stored text of an attestation this app can re-prove, or `Nothing`
-- for any other scheme.
provable : AttestedHash -> Maybe String
provable attested =
    case attested of
        Sha256 stored ->
            Just stored

        ResidualSha256 stored ->
            Just stored

        RefusalBlake3 _ ->
            Nothing

        UnknownScheme _ ->
            Nothing


-- The stored text, for keying review-db lookups only; never a value to
-- record a decision against.
storedHash : AttestedHash -> String
storedHash attested =
    case attested of
        Sha256 stored ->
            stored

        ResidualSha256 stored ->
            stored

        RefusalBlake3 stored ->
            stored

        UnknownScheme stored ->
            stored


-- The first 8 characters of a stored hash, rendered for display: an
-- attestation shows its digest without the scheme prefix, any other value
-- its leading text. The stored text is database text, so it is rendered.
shortHash : String -> SafeText
shortHash stored =
    SafeText.renderForeign (String.slice 0 8 (hashDigits (parseAttested stored)))


hashDigits : AttestedHash -> String
hashDigits attested =
    case attested of
        Sha256 stored ->
            String.dropLeft (String.length attestScheme) stored

        ResidualSha256 stored ->
            String.dropLeft (String.length residualScheme) stored

        RefusalBlake3 stored ->
            String.dropLeft (String.length refusalScheme) stored

        UnknownScheme other ->
            other


-- Source text proved within every view ceiling and equal to its
-- attestation: the rows, the text they join to, and their drawing whose
-- elements were counted. Opaque: built only by `classifyView`, so holding one
-- means the bytes were measured, the drawing counted and the text re-hashed.
type ShownSource
    = ShownSource { uid : Uid, rows : List SourceRow, text : String, hash : String, drawn : DrawnSource }


shownText : ShownSource -> String
shownText shown =
    case shown of
        ShownSource s ->
            s.text


-- The shown view's rows: the exact list `bodyText` joined and the
-- attestation hashed, so the drawn rows and the hashed rows are one list.
shownRows : ShownSource -> List SourceRow
shownRows shown =
    case shown of
        ShownSource s ->
            s.rows


-- The shown view's drawing, the one `classifyView` counted against
-- `viewNodeCeiling`; the page draws it and never lexes the rows again.
shownDrawn : ShownSource -> DrawnSource
shownDrawn shown =
    case shown of
        ShownSource s ->
            s.drawn


shownHash : ShownSource -> String
shownHash shown =
    case shown of
        ShownSource s ->
            s.hash


-- The one hash a decision or drain may record: the hash of the bytes that
-- were shown, re-proved against the current index row and file, with the
-- name of its subject as that row holds it, the name the decision signs.
-- Opaque: built only by `reverify` and `reverifyRefusal`.
type Attested
    = Attested { uid : Uid, hash : String, name : RecordedName }


attestedUid : Attested -> Uid
attestedUid attested =
    case attested of
        Attested a ->
            a.uid


attestedHash : Attested -> String
attestedHash attested =
    case attested of
        Attested a ->
            a.hash


attestedName : Attested -> RecordedName
attestedName attested =
    case attested of
        Attested a ->
            a.name


-- Re-proves a shown source at decision time: the unit's row is re-read from
-- the index and its file re-hashed through `viewOf`, and the fresh view must
-- be shown under the same hash. A unit gone from the index, a source that
-- changed or became unreadable since it was shown, or one now past a view
-- ceiling is a `DecideRefusal` value, decided from reads alone, so no
-- decision is recorded against bytes the reviewer did not see. So is a unit
-- whose kind, qualified name or path the re-read row does not hold whole
-- within `UnitName.nameMaxChars`: no decision records a cut name. The index and
-- root are the one `settings` value resolved at startup, the tree the page
-- showed the unit from.
reverify : IndexSettings -> ShownSource -> Task.Task Error (Result DecideRefusal Attested)
reverify settings shown =
    case shown of
        ShownSource s ->
            do
                conn <- readConnection settings
                rows <- queryUnit conn settings.roots s.uid
                case List.head rows of
                    Just ( row, columns ) ->
                        viewOf conn settings.roots row columns
                            |> Task.map (confirmShown s.uid s.hash (UnitName.unitFromColumns { kind = columns.kind, qualified = columns.qualified, path = columns.path, line = row.lineStart }))

                    Nothing ->
                        Task.succeed (Err SourceGone)


-- A shown unit that grew past a view ceiling before its decision is
-- `SourcePastCeiling`; any other view but the one shown is `SourceChanged`.
-- The shown view then binds the unit's name, or the name's refusal.
confirmShown : Uid -> String -> Result NameRefusal RecordedName -> SourceView -> Result DecideRefusal Attested
confirmShown uid hash name fresh =
    case fresh of
        Shown now ->
            if shownHash now == hash then
                attestedWith uid hash name

            else
                Err SourceChanged

        Stale _ ->
            Err SourceChanged

        Unreadable _ ->
            Err SourceChanged

        TooLarge _ ->
            Err SourcePastCeiling


-- Re-proves an unreviewable file at decision time, the refusal row's
-- counterpart of `reverify`: its row is re-read by uid, under a bound tag,
-- in a fresh index read, and must still carry `digest`. A row gone, a
-- blocking row (no digest), or another digest is a `DecideRefusal` value,
-- decided from reads alone. A content reason re-probes the file, which must
-- still be refused: a not-UTF-8 file must still fail to read as text within
-- `sourceCeiling`; an oversized one must still hold at least its recorded
-- size, or more than `sourceCeiling`.
-- The app has no bounded byte read to re-hash the file with, so the
-- decision binds the index's digest, and the next index run re-hashes: a
-- changed digest is a new, open pair.
reverifyRefusal : IndexSettings -> Uid -> RefusalDigest -> Task.Task Error (Result DecideRefusal Attested)
reverifyRefusal settings uid digest =
    let
        bound =
            refusalCondition (refusalTags settings.roots)
    in
    do
        conn <- readConnection settings
        rows <- Db.queryDecode conn (refusalColumns ++ " u.uid = ? AND" ++ bound.sql ++ " LIMIT 1") ([ Uid.toSql uid ] ++ bound.params) refusalWithPathDecoder
        case List.head rows of
            Just ( row, column, stored ) ->
                confirmRefusal settings.roots digest row column stored

            Nothing ->
                Task.succeed (Err FileGone)


-- A decision's attestation once its source is re-proved: bound to the name
-- of its subject, or refused when that name cannot be recorded whole.
attestedWith : Uid -> String -> Result NameRefusal RecordedName -> Result DecideRefusal Attested
attestedWith uid hash name =
    case name of
        Ok recorded ->
            Ok (Attested { uid = uid, hash = hash, name = recorded })

        Err PartPastCeiling ->
            Err NamePastCeiling

        Err PartEmpty ->
            Err NameUnreadable

        Err PartNotText ->
            Err NameUnreadable

        Err LineNegative ->
            Err NameUnreadable


-- A refusal row with its stored path column, and the path in the one form
-- `RepoPath.resolve` reads: the path's window when it holds the whole path,
-- else `Nothing`, so no prefix of a long path is ever joined.
refusalWithPathDecoder : Db.Decode.Decoder ( RefusalRow, Label.Column, Maybe String )
refusalWithPathDecoder =
    Db.Decode.map2 (\row column -> ( row, column, Label.whole column )) refusalRowDecoder (columnDecoder "path")


confirmRefusal : RootMap -> RefusalDigest -> RefusalRow -> Label.Column -> Maybe String -> Task.Task Error (Result DecideRefusal Attested)
confirmRefusal roots digest row column stored =
    case row.digest of
        Nothing ->
            Task.succeed (Err FileNotAcknowledgeable)

        Just now ->
            if refusalDigestText now == refusalDigestText digest then
                stillRefused roots row stored
                    |> Task.map (Result.andThen (\_ -> attestedWith row.uid (refusalDigestText now) (UnitName.fileFromColumn column)))

            else
                Task.succeed (Err FileChanged)


-- The re-probe of a refusal row's reason before a decision binds it: a
-- content reason's file must still be refused, an entry reason's digest is
-- of the staged entry and needs no read, and a blocking reason is never
-- decided.
stillRefused : RootMap -> RefusalRow -> Maybe String -> Task.Task Error (Result DecideRefusal ())
stillRefused roots row stored =
    case row.reason of
        NotUtf8 ->
            stillUnreadable roots stored sourceCeiling

        Oversized ->
            case row.size of
                Just size ->
                    if size > 0 then
                        stillUnreadable roots stored (ByteSize.bytes (atMostSourceCeiling (size - 1)))

                    else
                        Task.succeed (Err FileNotReprobed)

                Nothing ->
                    Task.succeed (Err FileNotReprobed)

        SymlinkEntry ->
            Task.succeed (Ok ())

        GitlinkEntry ->
            Task.succeed (Ok ())

        UnknownMode ->
            Task.succeed (Ok ())

        PastHashCeiling ->
            Task.succeed (Err FileNotAcknowledgeable)

        NonUtf8Name ->
            Task.succeed (Err FileNotAcknowledgeable)

        NotRepoRelative ->
            Task.succeed (Err FileNotAcknowledgeable)

        NestedRepository ->
            Task.succeed (Err FileNotAcknowledgeable)

        NotRegular ->
            Task.succeed (Err FileNotAcknowledgeable)

        UnreadableEntry ->
            Task.succeed (Err FileNotAcknowledgeable)

        ReplacedEntry ->
            Task.succeed (Err FileNotAcknowledgeable)


atMostSourceCeiling : Int -> Int
atMostSourceCeiling n =
    if n < ByteSize.toBytes sourceCeiling then
        n

    else
        ByteSize.toBytes sourceCeiling


-- The file at `stored` exists and does not read as text within `cap`. The
-- stored path is the index's escaped form, parsed back to the name it
-- escapes by `unescapeShown`; a path longer than its window (`Nothing`), or
-- one that is not the index's escape of a name, names no file this app can
-- join, so it is never re-probed and never decided.
stillUnreadable : RootMap -> Maybe String -> ByteSize -> Task.Task Error (Result DecideRefusal ())
stillUnreadable roots stored cap =
    case Maybe.map (RepoPath.resolve roots) (Maybe.andThen unescapeShown stored) of
        Just (Ok path) ->
            do
                present <- File.exists path
                if present then
                    File.readFileLimit path cap
                        |> Task.map (\_ -> False)
                        |> Task.onError (\_ -> Task.succeed True)
                        |> Task.map refusedStill

                else
                    Task.succeed (Err FileNotReprobed)

        Just (Err _) ->
            Task.succeed (Err FileNotReprobed)

        Nothing ->
            Task.succeed (Err FileNotReprobed)


-- Where `unescapeShown` stands after the characters read so far: plain
-- text, just past a `\`, just past `\u`, or inside `\u{..}` with the code
-- point and the count of hex digits read; `Malformed` once the text cannot
-- be an escape the index writes. Each carries the name read so far,
-- reversed.
type ShownScan
    = ShownPlain (List Char)
    | ShownSlash (List Char)
    | ShownU (List Char)
    | ShownHex (List Char) Int Int
    | Malformed


-- The name ipe-index's `shown` escape renders as `stored`, its exact
-- inverse: `\\` is a backslash, `\u{h}` the character of code point `h`
-- in lowercase hex without a leading zero, and every other character is a
-- space or a printable ASCII character standing for itself. Anything
-- `shown` never writes is Nothing: a raw character it would have escaped, an
-- escape of a character it writes bare, a code point that is no character,
-- or `\x{..}`, a byte of a name that is not UTF-8, which names no file
-- this app can open. One pass, no recursion.
unescapeShown : String -> Maybe String
unescapeShown stored =
    case String.foldl shownStep (ShownPlain []) stored of
        ShownPlain name ->
            Just (String.fromList (List.reverse name))

        ShownSlash _ ->
            Nothing

        ShownU _ ->
            Nothing

        ShownHex _ _ _ ->
            Nothing

        Malformed ->
            Nothing


shownStep : Char -> ShownScan -> ShownScan
shownStep c scan =
    case scan of
        ShownPlain name ->
            if c == '\\' then
                ShownSlash name

            else if shownBare (Char.toCode c) then
                ShownPlain (c :: name)

            else
                Malformed

        ShownSlash name ->
            if c == '\\' then
                ShownPlain (c :: name)

            else if c == 'u' then
                ShownU name

            else
                Malformed

        ShownU name ->
            if c == '{' then
                ShownHex name 0 0

            else
                Malformed

        ShownHex name code digits ->
            if c == '}' then
                escapedChar name code digits

            else
                case lowerHexValue c of
                    Just value ->
                        if (digits == 1 && code == 0) || digits >= 6 then
                            Malformed

                        else
                            ShownHex name (code * 16 + value) (digits + 1)

                    Nothing ->
                        Malformed

        Malformed ->
            Malformed


-- The character a complete `\u{..}` escape names, when `shown` would have
-- escaped it.
escapedChar : List Char -> Int -> Int -> ShownScan
escapedChar name code digits =
    let
        c =
            Char.fromCode code
    in
    if digits > 0 && Char.toCode c == code && not (shownBare code) && c /= '\\' then
        ShownPlain (c :: name)

    else
        Malformed


-- ipe-index's `shown` escape of `text`, the one `unescapeShown` inverts:
-- `\\` for a backslash, the character itself for a space or printable
-- ASCII, and `\u{h}` in lowercase hex without a leading zero for any other.
escapeShown : String -> String
escapeShown text =
    String.concat (List.map escapeShownChar (String.toList text))


escapeShownChar : Char -> String
escapeShownChar c =
    let
        code =
            Char.toCode c
    in
    if c == '\\' then
        "\\\\"

    else if shownBare code then
        String.fromChar c

    else
        "\\u{" ++ lowerHex code ++ "}"


-- A code point in lowercase hex without a leading zero: at most six digits,
-- as no code point passes 0x10ffff.
lowerHex : Int -> String
lowerHex code =
    let
        digit place written =
            let
                d =
                    modBy 16 (code // place)
            in
            if d == 0 && written == "" then
                written

            else
                written ++ String.slice d (d + 1) "0123456789abcdef"

        digits =
            List.foldl digit "" [ 1048576, 65536, 4096, 256, 16, 1 ]
    in
    if digits == "" then
        "0"

    else
        digits


-- A code point `shown` writes as itself: a space or printable ASCII other
-- than the backslash.
shownBare : Int -> Bool
shownBare code =
    code >= 32 && code <= 126 && code /= 92


lowerHexValue : Char -> Maybe Int
lowerHexValue c =
    let
        code =
            Char.toCode c
    in
    if code >= 48 && code <= 57 then
        Just (code - 48)

    else if code >= 97 && code <= 102 then
        Just (code - 87)

    else
        Nothing


refusedStill : Bool -> Result DecideRefusal ()
refusedStill refused =
    if refused then
        Ok ()

    else
        Err FileReadsAsText


-- Why a unit's source is withheld instead of shown.
type StaleReason
    = Drifted
    | RangeOutOfFile { lineCount : Int }
    | UnverifiableHash


-- Which view ceiling a withheld view passed, with the measure taken.
type Oversize
    = SpanLines { lines : Int }
    | ViewBytes { size : ByteSize }
    | ChildSpans { atLeast : Int }
    | ViewNodes { nodes : Int }


-- What a unit's attestation covers: a span unit its line range (1-based,
-- inclusive), a file unit its residual, the lines no span of another unit
-- of the file covers.
type Body
    = LineRange Int Int
    | Residual (List ( Int, Int ))


-- What the unit page may show of a unit's source: the verified view, a
-- reason it is withheld, why it could not be read, or the
-- ceiling it passed. Only `Shown` holds source text.
type SourceView
    = Shown ShownSource
    | Stale StaleReason
    | Unreadable ReadFailure
    | TooLarge Oversize


-- Why a unit's file was not read: its stored path was refused before any
-- read; the index read did not return all of it (it is longer than the
-- window, it holds a NUL byte where the read stops, or it is not stored as
-- text), so no part of it is ever joined; nothing is at the joined path; or
-- what is there did not read as text within `sourceCeiling`. Each case but a
-- refusal names the stored path as a quoted label; a refusal's `PathError`
-- names it itself.
type ReadFailure
    = PathRefused PathError
    | PathPastWindow Label
    | PathHoldsNul Label
    | PathNotText Label
    | NoFile Label
    | CannotRead Label


-- The scheme prefix of a line range's attestation in `body_hash`.
attestScheme : String
attestScheme =
    "sha256:"


-- The scheme prefix of a file unit's residual attestation in `body_hash`.
-- Any text is the view of some file, so only a scheme of its own keeps a
-- residual's hash apart from every `attestScheme` hash, the whole-file hash
-- an older index stored for the same file unit among them.
residualScheme : String
residualScheme =
    "sha256-residual:"


-- The longest `body_hash` a decision records, in bytes: the longest scheme
-- prefix and a 64-digit hex digest. Every attestation the app records is
-- ASCII and fits it; a review-log cell past it is read as unheld.
attestedHashMaxBytes : Int
attestedHashMaxBytes =
    List.foldl (\scheme longest -> max longest (String.length scheme)) 0 [ attestScheme, residualScheme, refusalScheme ] + 64


-- The attestation of a line range's view: the scheme prefix and the view's
-- lowercase hex SHA-256, the exact form ipe-index stores in
-- `units.body_hash`.
attest : String -> String
attest view =
    attestScheme ++ Crypto.sha256 view


-- The attestation of a file unit's residual, under `residualScheme`.
attestResidual : String -> String
attestResidual residual =
    residualScheme ++ Crypto.sha256 residual


-- The attestation of the text a body names, under that body's scheme.
bodyAttest : Body -> String -> String
bodyAttest body text =
    case body of
        LineRange _ _ ->
            attest text

        Residual _ ->
            attestResidual text


-- A file's lines under the attestation's split rule, shared with ipe-index
-- through the vectors file: split on `\n`, keep `\r`, drop the one empty
-- segment a trailing `\n` leaves. `""` is one empty line.
viewLines : String -> List String
viewLines text =
    let
        segments =
            String.split "\n" text
    in
    if String.endsWith "\n" text then
        List.take (List.length segments - 1) segments

    else
        segments


-- Lines `start..end` (1-based, inclusive) of `text` joined by `\n`. A range
-- outside the file is refused with the file's line count, never clamped.
viewText : Int -> Int -> String -> Result StaleReason String
viewText start end text =
    Result.map rowsText (rangeRows start end (viewLines text))


-- A file's residual under ipe-index's rule, shared through the residual
-- vectors file.
residualText : List ( Int, Int ) -> String -> String
residualText spans text =
    residualRowsText (residualRows spans (viewLines text))


-- The rows a body names in `lines`, the one list both drawn and hashed.
bodyRows : Body -> List String -> Result StaleReason (List SourceRow)
bodyRows body lines =
    case body of
        LineRange start end ->
            rangeRows start end lines

        Residual spans ->
            Ok (residualRows spans lines)


-- The attested text of the rows a body names: a line range's rows joined by
-- `\n`, a residual's rows under `residualRowsText`.
bodyText : Body -> List SourceRow -> String
bodyText body rows =
    case body of
        LineRange _ _ ->
            rowsText rows

        Residual _ ->
            residualRowsText rows


-- The attested text of a line range's rows: each line joined by `\n`.
rowsText : List SourceRow -> String
rowsText rows =
    String.join "\n" (List.map rowText rows)


-- The attested text of a residual's rows: every row written as `\n` and its
-- text, a kept line's text the line and a covered row's text empty. A kept
-- line is never blank, so never empty, and no line holds a `\n`, so the
-- text splits back into exactly one row list: no source line, whatever its
-- bytes, reads as a covered row. No rows is `""`. It is attested by
-- `attestResidual`, whose scheme no line range's or whole file's hash
-- carries.
residualRowsText : List SourceRow -> String
residualRowsText rows =
    String.concat (List.map (\row -> "\n" ++ rowText row) rows)


rowText : SourceRow -> String
rowText row =
    case row of
        Numbered _ line ->
            line

        Covered ->
            ""


rangeRows : Int -> Int -> List String -> Result StaleReason (List SourceRow)
rangeRows start end lines =
    let
        count =
            List.length lines
    in
    if 1 <= start && start <= end && end <= count then
        lines
            |> List.drop (start - 1)
            |> List.take (end - start + 1)
            |> List.indexedMap (\i line -> Numbered (start + i) line)
            |> Ok

    else
        Err (RangeOutOfFile { lineCount = count })


-- The lines no span covers, blank ones dropped, each covered run between two
-- kept lines marked by one `Covered` row. A span covers only its part inside
-- `1..length lines`; an empty or reversed span covers nothing. Linear in the
-- lines after one sort of the spans.
residualRows : List ( Int, Int ) -> List String -> List SourceRow
residualRows spans lines =
    let
        numbered =
            List.indexedMap (\i line -> ( i + 1, line )) lines

        flags =
            coveredFlags (List.length lines) spans
    in
    List.map2 (\covered ( number, line ) -> ( covered, number, line )) flags numbered
        |> List.foldl residualStep ( NoneKept, [] )
        |> residualOf


-- Where the residual fold is: before any kept line, right after a kept
-- line, or past a covered run since the last kept line.
type ResidualAt
    = NoneKept
    | AfterKept
    | CoveredSinceKept


-- ( where the fold is, the rows kept so far in order ): each row is added at
-- the end, so the fold is linear in the lines.
residualStep : ( Bool, Int, String ) -> ( ResidualAt, List SourceRow ) -> ( ResidualAt, List SourceRow )
residualStep ( covered, number, line ) ( at, rows ) =
    if covered then
        ( coveredAfter at, rows )

    else if String.isEmpty (String.trim line) then
        ( at, rows )

    else
        case at of
            CoveredSinceKept ->
                ( AfterKept, rows ++ [ Covered, Numbered number line ] )

            AfterKept ->
                ( AfterKept, rows ++ [ Numbered number line ] )

            NoneKept ->
                ( AfterKept, rows ++ [ Numbered number line ] )


coveredAfter : ResidualAt -> ResidualAt
coveredAfter at =
    case at of
        NoneKept ->
            NoneKept

        AfterKept ->
            CoveredSinceKept

        CoveredSinceKept ->
            CoveredSinceKept


residualOf : ( ResidualAt, List SourceRow ) -> List SourceRow
residualOf ( _, rows ) =
    rows


-- One flag per line of a `count`-line file: whether any span covers it.
coveredFlags : Int -> List ( Int, Int ) -> List Bool
coveredFlags count spans =
    List.filterMap (clampSpan count) spans
        |> List.sortBy Tuple.first
        |> List.foldl coverRun ( 1, [] )
        |> closeRuns count


-- A span cut to `1..count`, or Nothing when no line of it is in range.
clampSpan : Int -> ( Int, Int ) -> Maybe ( Int, Int )
clampSpan count ( start, end ) =
    let
        first =
            max start 1

        last =
            min end count
    in
    if first <= last then
        Just ( first, last )

    else
        Nothing


-- ( the first line no earlier span reached, the flag runs so far in order ),
-- over spans sorted by first line; each run is added at the end, so the fold
-- is linear in the spans.
coverRun : ( Int, Int ) -> ( Int, List (List Bool) ) -> ( Int, List (List Bool) )
coverRun ( first, last ) ( next, runs ) =
    if last < next then
        ( next, runs )

    else
        let
            from =
                max first next
        in
        ( last + 1, runs ++ [ List.repeat (from - next) False, List.repeat (last - from + 1) True ] )


closeRuns : Int -> ( Int, List (List Bool) ) -> List Bool
closeRuns count ( next, runs ) =
    List.concat (runs ++ [ List.repeat (count - next + 1) False ])
