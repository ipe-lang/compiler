module Lib.Index exposing (Attested, AttestedHash(..), ChainHead, Change(..), Cursor(..), DecidedPair, PendingRow, ShownSource, Snapshot, SourceView(..), StaleReason(..), Unit, UnitView, Written(..), attest, attestedHash, attestedUid, candidateQuery, chainHeadDecoder, chainHeadText, chainLink, countPending, countUnits, dbBytes, decidedPairDecoder, decidedPairKey, drainDecided, drainUnit, loadPendingPage, loadView, nameFor, pageSize, placeholders, probe, readConnection, readSnapshot, readStamp, rebuildReviewed, reverify, shortHash, shownHash, shownText, storedHash, viewText)

import Ipe.ByteSize as ByteSize exposing (ByteSize)
import Ipe.Crypto as Crypto
import Ipe.Db
import Ipe.Db.Decode
import Ipe.Db.Sql as Sql
import Ipe.Db.Store as Store exposing (Store)
import Ipe.Error as Error
import Ipe.File as File
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task
import Lib.Highlight as Highlight
import Lib.Links as Links
import Lib.RepoPath as RepoPath exposing (RootMap)
import Lib.SafeText as SafeText exposing (SafeText)
import Lib.Settings as Settings exposing (IndexSettings)


-- One ipe-index unit's metadata, never its source: a queue page lists these
-- without reading a file. Every text column a page shows (`path`, the
-- `tag:relative` form ipe-index stores; `name`; `qualified`; `kind`;
-- `facing`; `purpose`) is `SafeText`, rendered once here, so no index text
-- can reach a page raw; `lang` is the language ipe-index stores for the
-- unit's file, parsed for highlighting. `attested` is the stored body hash,
-- parsed once.
type alias Unit =
    { uid : String
    , path : SafeText
    , name : SafeText
    , qualified : SafeText
    , kind : SafeText
    , lang : Highlight.Lang
    , lineStart : Int
    , lineEnd : Int
    , facing : SafeText
    , purpose : Maybe SafeText
    , attested : AttestedHash
    , updatedSha : String
    }


-- One unit with what a page shows of its source: the unit's lines from disk,
-- shown only when they re-hash to `unit.attested`, and the links resolved
-- from a shown view. `loadView` is the one source read that builds it.
type alias UnitView =
    { unit : Unit
    , view : SourceView
    , links : Links.LinkSet
    }


-- The unit columns as they come off the DB, before the source is attached.
-- The unit page queries units directly, not via `open_units`: a decided
-- unit is not open, but its page must still render, so it reads no change.
unitByUidSql : String
unitByUidSql =
    "SELECT u.uid, u.path, u.name, u.qualified, u.kind, u.line_start, u.line_end, u.facing, u.purpose, u.body_hash, u.updated_sha, f.lang FROM units u" ++ unitFiles ++ " WHERE u.uid = ?"


-- The unit's file row, for the language ipe-index stored for it: a primary
-- key lookup per unit, and a unit with no file row reads a NULL language.
unitFiles : String
unitFiles =
    " LEFT JOIN files f ON f.path = u.path"


-- The one source read: one unit by uid (decided or not) read on `conn`, its
-- one file read and verified against its tag's root in `roots`, and its
-- links resolved from the view when it is shown. Nothing when no such unit
-- exists. The unit page and the selected queue card both load through it.
loadView : Db.Db -> RootMap -> String -> Task.Task Error (Maybe UnitView)
loadView conn roots uid =
    do
        rows <- Db.queryDecode conn unitByUidSql [ SqlString uid ] rowDecoder
        case List.head rows of
            Just row ->
                do
                    view <- viewOf roots row
                    links <- linksOf conn row view
                    Task.succeed (Just { unit = withRow row, view = view, links = links })

            Nothing ->
                Task.succeed Nothing


-- Jump links come only from a shown view; a withheld view links nothing and
-- reads no names. A shown view costs two indexed queries, each bounded by a
-- ceiling: the unit's callgraph edges, then the qualified names its
-- references spell under ipe-index's callee rule. The unit never links to
-- itself.
linksOf : Db.Db -> RowUnit -> SourceView -> Task.Task Error Links.LinkSet
linksOf conn row view =
    case view of
        Shown shown ->
            let
                lang =
                    langOf row.lang

                source =
                    shownText shown

                wanted =
                    Links.candidates lang { kind = row.kind, name = row.name, qualified = row.qualified } (Links.references lang source)
            in
            do
                edges <- edgeLinks conn row.uid
                resolved <- candidateRows conn row wanted.names
                Task.succeed
                    (Links.assemble
                        { edges = edgeReach edges, candidates = wanted.reach }
                        (List.map (\( uid, qualified ) -> Links.internal qualified uid) edges)
                        (Links.resolveCandidates wanted.lookups resolved)
                        (Links.sourceUrls source)
                    )

        Stale _ ->
            Task.succeed Links.noLinks

        Unreadable _ ->
            Task.succeed Links.noLinks


-- The callgraph edges ipe-index resolved out of `uid`, one past the link
-- ceiling, so a full read shows that more edges may exist.
edgeLinks : Db.Db -> String -> Task.Task Error (List ( String, String ))
edgeLinks conn uid =
    Db.queryDecode conn edgeSql [ SqlString uid, SqlString uid, SqlInt (Links.linkCeiling + 1) ] edgeDecoder


edgeSql : String
edgeSql =
    "SELECT c.callee_uid, u.qualified FROM callgraph c JOIN units u ON u.uid = c.callee_uid WHERE c.caller_uid = ? AND c.callee_uid != ? ORDER BY u.qualified, u.uid LIMIT ?"


edgeReach : List a -> Links.Reach
edgeReach edges =
    if List.length edges > Links.linkCeiling then
        Links.Capped

    else
        Links.Complete


edgeDecoder : Db.Decode.Decoder ( String, String )
edgeDecoder =
    Db.Decode.succeed (\callee qualified -> ( callee, qualified ))
        |> Db.Decode.required "callee_uid" (Db.Decode.string "callee_uid")
        |> Db.Decode.required "qualified" (Db.Decode.string "qualified")


-- The `(qualified, uid)` row of each candidate name some unit other than
-- `row` holds; no names read nothing.
candidateRows : Db.Db -> RowUnit -> List String -> Task.Task Error (List ( String, String ))
candidateRows conn row names =
    if List.isEmpty names then
        Task.succeed []

    else
        case candidateQuery row.path row.uid names of
            ( sql, params ) ->
                Db.queryDecode conn sql params qualifiedDecoder


-- One statement for every candidate name, on `i_units_qual`: at most one row
-- per name, the unit in `path` first, then the lowest uid — ipe-index's own
-- `uid_for_qualified` tie-break. Every name is bound; only placeholders enter
-- the SQL text.
candidateQuery : String -> String -> List String -> ( String, List SqlValue )
candidateQuery path uid names =
    ( "SELECT qualified, uid FROM (SELECT qualified, uid, ROW_NUMBER() OVER (PARTITION BY qualified ORDER BY (path = ?) DESC, uid) AS rn FROM units WHERE qualified IN (" ++ placeholders (List.length names) ++ ") AND uid != ?) WHERE rn = 1"
    , List.concat [ [ SqlString path ], List.map SqlString names, [ SqlString uid ] ]
    )


-- `n` comma-separated `?` placeholders.
placeholders : Int -> String
placeholders n =
    String.join ", " (List.repeat n "?")


qualifiedDecoder : Db.Decode.Decoder ( String, String )
qualifiedDecoder =
    Db.Decode.succeed (\q u -> ( q, u ))
        |> Db.Decode.required "qualified" (Db.Decode.string "qualified")
        |> Db.Decode.required "uid" (Db.Decode.string "uid")


type alias RowUnit =
    { uid : String
    , path : String
    , name : String
    , qualified : String
    , kind : String
    , lineStart : Int
    , lineEnd : Int
    , facing : String
    , purpose : Maybe String
    , bodyHash : String
    , updatedSha : String
    , lang : Maybe String
    }


-- The queue row is decoded in two halves of at most ten columns each
-- (`Db.Decode.succeed` lifts at most 10 parameters — IPE-L0121), then merged.
type alias RowA =
    { uid : String
    , path : String
    , name : String
    , qualified : String
    }


type alias RowB =
    { kind : String
    , lineStart : Int
    , lineEnd : Int
    , facing : String
    , purpose : Maybe String
    , bodyHash : String
    , updatedSha : String
    , lang : Maybe String
    }


makeRowA : String -> String -> String -> String -> RowA
makeRowA uid path name qualified =
    { uid = uid
    , path = path
    , name = name
    , qualified = qualified
    }


makeRowB : String -> Int -> Int -> String -> Maybe String -> String -> String -> Maybe String -> RowB
makeRowB kind lineStart lineEnd facing purpose bodyHash updatedSha lang =
    { kind = kind
    , lineStart = lineStart
    , lineEnd = lineEnd
    , facing = facing
    , purpose = purpose
    , bodyHash = bodyHash
    , updatedSha = updatedSha
    , lang = lang
    }


mergeRows : RowA -> RowB -> RowUnit
mergeRows a b =
    { uid = a.uid
    , path = a.path
    , name = a.name
    , qualified = a.qualified
    , kind = b.kind
    , lineStart = b.lineStart
    , lineEnd = b.lineEnd
    , facing = b.facing
    , purpose = b.purpose
    , bodyHash = b.bodyHash
    , updatedSha = b.updatedSha
    , lang = b.lang
    }


rowDecoder : Db.Decode.Decoder RowUnit
rowDecoder =
    Db.Decode.andThen
        (\a -> Db.Decode.map (\b -> mergeRows a b) partBDecoder)
        partADecoder


partADecoder : Db.Decode.Decoder RowA
partADecoder =
    Db.Decode.succeed makeRowA
        |> Db.Decode.required "uid" (Db.Decode.string "uid")
        |> Db.Decode.required "path" (Db.Decode.string "path")
        |> Db.Decode.required "name" (Db.Decode.string "name")
        |> Db.Decode.required "qualified" (Db.Decode.string "qualified")


partBDecoder : Db.Decode.Decoder RowB
partBDecoder =
    Db.Decode.succeed makeRowB
        |> Db.Decode.required "kind" (Db.Decode.string "kind")
        |> Db.Decode.required "line_start" (Db.Decode.int "line_start")
        |> Db.Decode.required "line_end" (Db.Decode.int "line_end")
        |> Db.Decode.required "facing" (Db.Decode.string "facing")
        |> Db.Decode.required "purpose" (Db.Decode.nullable (Db.Decode.string "purpose"))
        |> Db.Decode.required "body_hash" (Db.Decode.string "body_hash")
        |> Db.Decode.required "updated_sha" (Db.Decode.string "updated_sha")
        |> Db.Decode.required "lang" (Db.Decode.nullable (Db.Decode.string "lang"))


-- The startup check of `IPE_INDEX_DB`: the index is opened read-only and
-- every column a queue page reads from the `open_units` view is selected,
-- with the `reviewed` copy and its `reviewed_stamp`, so a missing file, a
-- file that is not an ipe-index database, or one missing the view, a table
-- or a column stops the server before it listens, naming the variable and
-- the file.
probe : IndexSettings -> Task.Task Error ()
probe settings =
    (do
        conn <- readConnection settings
        Db.queryDecode conn (openColumns ++ " LIMIT 0") [] pendingRowDecoder
        Db.queryDecode conn "SELECT uid, body_hash FROM reviewed LIMIT 0" [] reviewedPairDecoder
        Db.queryDecode conn "SELECT head FROM reviewed_stamp LIMIT 0" [] stampDecoder
        Task.succeed ()
    )
        |> Task.mapError (Settings.openFailure "IPE_INDEX_DB" (SafeText.literal "build it from the repo root with `tools/scripts/ipe-index index`, or point IPE_INDEX_DB at an existing index") settings.db)


reviewedPairDecoder : Db.Decode.Decoder ( String, String )
reviewedPairDecoder =
    Db.Decode.succeed (\uid hash -> ( uid, hash ))
        |> Db.Decode.required "uid" (Db.Decode.string "uid")
        |> Db.Decode.required "body_hash" (Db.Decode.string "body_hash")


-- The index database at `settings` opened read-only: the one read
-- connection a page load or lookup opens and then passes to every query it
-- runs, from settings the caller resolved once.
readConnection : IndexSettings -> Task.Task Error Db.Db
readConnection settings =
    Db.open "sqlite" (Settings.indexReadUrl settings.db)


-- The most open units one page load reads. An index can hold tens of
-- thousands of open units, and each loaded unit costs a review-db lookup,
-- so a load is bounded by this constant rather than by the index's size. A
-- page load reads no source file.
pageSize : Int
pageSize =
    200


-- Where a page starts in the `(enqueued_at, uid)` order of `open_units`: the
-- head, or strictly after the last row of the previous page. `uid` breaks
-- ties on `enqueued_at` (a unit with no queue row orders at 0), so the order
-- is total and no row is skipped or repeated across pages.
type Cursor
    = Start
    | After { enqueuedAt : Int, uid : String }


-- An open unit with the `enqueued_at` it is ordered by, so the caller can
-- build the cursor for the following page.
type alias PendingRow =
    { unit : Unit
    , change : Change
    , enqueuedAt : Int
    }


-- What the index recorded about an open unit's current body: a new unit, a
-- modified one with the hash it replaced, or no queue row for this body at
-- all. Membership never depends on it: a unit is open because its current
-- (uid, body_hash) pair is undecided, so a unit whose change event is
-- missing is still listed, as `Unrecorded`.
type Change
    = New
    | Modified { old : String }
    | Unrecorded


-- The `change`/`old_hash` columns of `open_units`, parsed once. A `modified`
-- row without the hash it replaced, an `old_hash` with no change, and a
-- change kind this reviewer does not know each fail the read rather than
-- being shown as something they are not.
changeDecoder : Db.Decode.Decoder Change
changeDecoder =
    Db.Decode.succeed (\change old -> ( change, old ))
        |> Db.Decode.required "change" (Db.Decode.nullable (Db.Decode.string "change"))
        |> Db.Decode.required "old_hash" (Db.Decode.nullable (Db.Decode.string "old_hash"))
        |> Db.Decode.andThen (\( change, old ) -> changeOf change old)


changeOf : Maybe String -> Maybe String -> Db.Decode.Decoder Change
changeOf change old =
    case change of
        Nothing ->
            case old of
                Nothing ->
                    Db.Decode.succeed Unrecorded

                Just _ ->
                    Db.Decode.fail "an open unit has an old_hash but no change"

        Just kind ->
            if kind == "new" then
                Db.Decode.succeed New

            else if kind == "modified" then
                case old of
                    Just hash ->
                        Db.Decode.succeed (Modified { old = hash })

                    Nothing ->
                        Db.Decode.fail "a modified unit has no old_hash"

            else
                Db.Decode.fail "an open unit has a change kind this reviewer does not know"


-- The one membership read: `open_units` is the index's current units whose
-- (uid, body_hash) pair is not in the `reviewed` copy. The page and the
-- count both read it, so the total always counts exactly the rows a page
-- can return.
openColumns : String
openColumns =
    "SELECT uid, path, name, qualified, kind, line_start, line_end, facing, purpose, body_hash, updated_sha, lang, change, old_hash, enqueued_at FROM open_units"


openOrder : String
openOrder =
    " ORDER BY enqueued_at, uid LIMIT ?"


-- The page query and its bound parameters for `cursor`. Every value is a
-- bound parameter; the page bound is always the last one.
pendingPageQuery : Cursor -> ( String, List SqlValue )
pendingPageQuery cursor =
    case cursor of
        Start ->
            ( openColumns ++ openOrder, [ SqlInt pageSize ] )

        After at ->
            ( openColumns ++ " WHERE (enqueued_at, uid) > (?, ?)" ++ openOrder
            , [ SqlInt at.enqueuedAt, SqlString at.uid, SqlInt pageSize ]
            )


pendingRowDecoder : Db.Decode.Decoder ( RowUnit, Change, Int )
pendingRowDecoder =
    Db.Decode.andThen
        (\row -> Db.Decode.map (\( change, at ) -> ( row, change, at )) openColumnsDecoder)
        rowDecoder


openColumnsDecoder : Db.Decode.Decoder ( Change, Int )
openColumnsDecoder =
    Db.Decode.andThen
        (\change ->
            Db.Decode.succeed (\at -> ( change, at ))
                |> Db.Decode.required "enqueued_at" (Db.Decode.int "enqueued_at")
        )
        changeDecoder


-- One page of open units at `cursor` read on `conn`, at most `pageSize`
-- rows of metadata. No source file is read: a unit's file is read only by
-- `loadView`, so a unit whose file is missing still lists, and only a failed
-- query fails the page.
loadPendingPage : Db.Db -> Cursor -> Task.Task Error (List PendingRow)
loadPendingPage conn cursor =
    let
        ( sql, params ) =
            pendingPageQuery cursor
    in
    Db.queryDecode conn sql params pendingRowDecoder
        |> Task.map (List.map (\( row, change, at ) -> { unit = withRow row, change = change, enqueuedAt = at }))


countDecoder : Db.Decode.Decoder Int
countDecoder =
    Db.Decode.succeed (\n -> n)
        |> Db.Decode.required "total" (Db.Decode.int "total")


-- How many units are open, counted over `open_units` without loading a
-- row. A count query that yields no row is a failed read, never a zero.
countPending : Db.Db -> Task.Task Error Int
countPending conn =
    do
        rows <- Db.queryDecode conn "SELECT COUNT(*) AS total FROM open_units" [] countDecoder
        singleInt "COUNT(*) over open_units" rows


-- How many units the index holds, open or decided.
countUnits : Db.Db -> Task.Task Error Int
countUnits conn =
    do
        rows <- Db.queryDecode conn "SELECT COUNT(*) AS total FROM units" [] countDecoder
        singleInt "COUNT(*) over units" rows


bytesDecoder : Db.Decode.Decoder Int
bytesDecoder =
    Db.Decode.succeed (\n -> n)
        |> Db.Decode.required "bytes" (Db.Decode.int "bytes")


-- The index database's size in bytes, from SQLite's page count and page
-- size, so the size costs one constant-time query and no file read.
dbBytes : Db.Db -> Task.Task Error Int
dbBytes conn =
    do
        rows <- Db.queryDecode conn "SELECT page_count * page_size AS bytes FROM pragma_page_count(), pragma_page_size()" [] bytesDecoder
        singleInt "the index database size query" rows


singleInt : String -> List Int -> Task.Task Error Int
singleInt what rows =
    case rows of
        [ n ] ->
            Task.succeed n

        _ ->
            Task.fail (Error.unexpected (what ++ " did not return exactly one row"))


-- Everything one queue page shows, read in one index transaction, so the
-- page rows, the open count and the unit count describe the same index
-- state and no write between two reads can make them disagree. `stamp` is
-- the review-log head the `reviewed` copy was last brought up to, or
-- Nothing when the copy has never been stamped or was marked stale; the
-- caller compares it with the review database's head before trusting the
-- rest.
type alias Snapshot =
    { stamp : Maybe String
    , rows : List PendingRow
    , open : Int
    , units : Int
    , bytes : Int
    }


readSnapshot : Db.Db -> Cursor -> Task.Task Error Snapshot
readSnapshot conn cursor =
    Db.withTransaction conn
        (\tx ->
            do
                stamp <- readStamp tx
                rows <- loadPendingPage tx cursor
                open <- countPending tx
                units <- countUnits tx
                bytes <- dbBytes tx
                Task.succeed { stamp = stamp, rows = rows, open = open, units = units, bytes = bytes }
        )


stampDecoder : Db.Decode.Decoder String
stampDecoder =
    Db.Decode.succeed (\head -> head)
        |> Db.Decode.required "head" (Db.Decode.string "head")


-- The head stamped on the `reviewed` copy: Nothing when no stamp row
-- exists. The table's key admits at most one row, so more than one is a
-- failed read.
readStamp : Db.Db -> Task.Task Error (Maybe String)
readStamp conn =
    do
        rows <- Db.queryDecode conn "SELECT head FROM reviewed_stamp WHERE one = 1" [] stampDecoder
        case rows of
            [] ->
                Task.succeed Nothing

            [ head ] ->
                Task.succeed (Just head)

            _ ->
                Task.fail (Error.unexpected "reviewed_stamp holds more than one row")


-- The identity of the review log: the hash-chain head after its last
-- decision. Opaque: minted only by `chainHeadDecoder` (a read of the review
-- database's `review_head`) and `chainLink` (the next link over a decided
-- pair), so a head is never built from a count or a bare string.
type ChainHead
    = ChainHead String


chainHeadDecoder : Db.Decode.Decoder ChainHead
chainHeadDecoder =
    Db.Decode.succeed (\head -> ChainHead head)
        |> Db.Decode.required "head" (Db.Decode.string "head")


-- A head as it is stored and compared.
chainHeadText : ChainHead -> String
chainHeadText head =
    case head of
        ChainHead text ->
            text


-- The head after `prev` records the decision on (uid, body_hash): the
-- SHA-256 of the three parts, each written as its decimal length, `:`, then
-- the part, so no choice of uid or hash can make two different triples hash
-- the same input.
chainLink : ChainHead -> String -> String -> ChainHead
chainLink prev uid hash =
    ChainHead (Crypto.sha256 (lengthPrefixed [ chainHeadText prev, uid, hash ]))


lengthPrefixed : List String -> String
lengthPrefixed parts =
    String.concat (List.map (\part -> String.fromInt (String.length part) ++ ":" ++ part) parts)


-- What recording a decision did to the review log: a new row moved the head
-- from `prev` to `head`, or the pair was already decided and nothing moved.
type Written
    = Inserted { prev : ChainHead, head : ChainHead }
    | AlreadyDecided


-- The review app consumes and clears explicitly: after a unit is decided,
-- one index transaction adds the pair to the `reviewed` copy, deletes the
-- unit's change_queue row for that hash, and moves the copy's stamp along
-- the review log. A new decision moves the stamp from `prev` to `head` only
-- if it still reads `prev`; any other stamp means the copy missed a
-- decision, so the stamp row is deleted and the next load rebuilds the copy
-- rather than vouch for it. An already-decided pair leaves the stamp alone.
-- Returns the count of queue rows deleted. The index is the one `settings`
-- names, resolved once at startup.
drainUnit : IndexSettings -> Attested -> Written -> Task.Task Error Int
drainUnit settings attested written =
    do
        conn <- Db.open "sqlite" (Settings.indexWriteUrl settings.db)
        Db.withTransaction conn
            (\tx ->
                do
                    drained <- drainPair tx (attestedUid attested) (attestedHash attested)
                    moveStamp tx written
                    Task.succeed drained
            )


moveStamp : Db.Db -> Written -> Task.Task Error ()
moveStamp conn written =
    case written of
        AlreadyDecided ->
            Task.succeed ()

        Inserted link ->
            do
                moved <- Db.exec conn "UPDATE reviewed_stamp SET head = ? WHERE one = 1 AND head = ?" [ SqlString (chainHeadText link.head), SqlString (chainHeadText link.prev) ]
                if moved == 1 then
                    Task.succeed ()

                else
                    Db.exec conn "DELETE FROM reviewed_stamp" []
                        |> Task.map (\_ -> ())


-- A decided (uid, body_hash) pair as the review table holds it. Opaque:
-- built only by `decidedPairDecoder`, which `Lib.Db.decidedPairsAfter` runs
-- over the review table, so a refill drains only pairs read back from it.
type DecidedPair
    = DecidedPair { uid : String, hash : String }


-- The one constructor of a `DecidedPair`: a row's `uid` and `body_hash`.
decidedPairDecoder : Db.Decode.Decoder DecidedPair
decidedPairDecoder =
    Db.Decode.succeed (\uid hash -> DecidedPair { uid = uid, hash = hash })
        |> Db.Decode.required "uid" (Db.Decode.string "uid")
        |> Db.Decode.required "body_hash" (Db.Decode.string "body_hash")


-- A decided pair's key, read-only: the (uid, body_hash) it was decoded from.
decidedPairKey : DecidedPair -> ( String, String )
decidedPairKey pair =
    case pair of
        DecidedPair p ->
            ( p.uid, p.hash )


-- One decided pair drained on `conn`, the refill step of `rebuildReviewed`.
-- Atomic only inside the transaction `rebuildReviewed` opens.
drainDecided : Db.Db -> DecidedPair -> Task.Task Error Int
drainDecided conn pair =
    case pair of
        DecidedPair p ->
            drainPair conn p.uid p.hash


-- One decided pair drained on `conn`, the one step both a drain and a
-- rebuild run: the pair is added to `reviewed` (a pair already there is
-- kept, so the first review wins and a re-drain is a no-op), then the
-- change_queue row queued for that hash is deleted. Only the row queued for
-- the decided hash is deleted: a re-index that re-queued the unit under new
-- content keeps its row, so the index's own pending list still names that
-- change. Whether a unit is open never reads this row: `open_units` compares
-- the current pair with `reviewed`. Returns the count of queue rows
-- deleted. Atomic only inside a transaction the caller opens.
drainPair : Db.Db -> String -> String -> Task.Task Error Int
drainPair conn uid hash =
    do
        Db.exec conn "INSERT OR IGNORE INTO reviewed (uid, body_hash) VALUES (?, ?)" [ SqlString uid, SqlString hash ]
        Db.deleteWhere conn
            "change_queue"
            (Sql.and
                (Sql.eq (Sql.column "uid") (Sql.param (SqlString uid)))
                (Sql.eq (Sql.column "new_hash") (Sql.param (SqlString hash)))
            )


-- The `reviewed` copy rebuilt in one index transaction: every row is
-- deleted, `refill` re-adds the decided pairs through `drainDecided` on the
-- transaction's connection it is given, and the copy is stamped with `head`,
-- the review-log head the caller read before the refill began. A failed
-- refill rolls the whole rebuild back, leaving the copy and its stamp as
-- they were. The index is the one `settings` names, resolved once at
-- startup.
rebuildReviewed : IndexSettings -> ChainHead -> (Db.Db -> Task.Task Error a) -> Task.Task Error a
rebuildReviewed settings head refill =
    do
        conn <- Db.open "sqlite" (Settings.indexWriteUrl settings.db)
        Db.withTransaction conn
            (\tx ->
                do
                    Db.exec tx "DELETE FROM reviewed" []
                    refilled <- refill tx
                    Db.exec tx "INSERT OR REPLACE INTO reviewed_stamp (one, head) VALUES (1, ?)" [ SqlString (chainHeadText head) ]
                    Task.succeed refilled
            )


-- The ipe-index `units` table modelled as a typed store over its explicit
-- columns, so a lookup runs through `Store.findBy` with a bound value rather
-- than a hand-written `WHERE` fragment. The store is read-only here — only
-- queried, never migrated — so its column set need only cover the columns a
-- query reads.
unitsStore : Result Error (Store Store.Row)
unitsStore =
    Store.fromColumns "units"
        [ Store.textColumn "uid"
        , Store.textColumn "qualified"
        ]
        |> Result.map Store.public


-- The unit's qualified name from the units table, rendered for display, if
-- the unit still exists (a decided unit whose source was deleted leaves a
-- review row but no name). The `uid` value is bound as a parameter by
-- `Store.findBy`, never interpolated into SQL text.
nameFor : Db.Db -> String -> Task.Task Error (Maybe SafeText)
nameFor conn uid =
    case unitsStore of
        Err e ->
            Task.fail e

        Ok store ->
            do
                rows <- Store.findBy conn store "uid" (SqlString uid)
                case List.head rows of
                    Just row ->
                        Task.succeed (Maybe.map SafeText.renderForeign (Result.toMaybe (Store.readText "qualified" row)))

                    Nothing ->
                        Task.succeed Nothing


-- The one verification of a unit's source. The stored hash is parsed first,
-- so an unknown scheme refuses before any read; then the stored path is
-- resolved, the file read, the line range checked and the view re-hashed.
-- Only a view whose attestation equals the stored one is `Shown`. Every
-- per-unit cause (refused path, unreadable file, bad range, drift) is a
-- `SourceView` state, never a failed task.
viewOf : RootMap -> RowUnit -> Task.Task Error SourceView
viewOf roots row =
    case parseAttested row.bodyHash of
        UnknownScheme _ ->
            Task.succeed (Stale UnverifiableHash)

        Sha256 stored ->
            case RepoPath.resolve roots row.path of
                Err refusal ->
                    Task.succeed (Unreadable (RepoPath.toError refusal))

                Ok path ->
                    File.readFileLimit path sourceCeiling
                        |> Task.map (\text -> verifyView row.uid stored (viewText row.lineStart row.lineEnd text))
                        |> Task.onError (\e -> Task.succeed (Unreadable (readFailure row.path e)))


-- A read error re-worded to name the stored path it came from.
readFailure : String -> Error -> Error
readFailure stored e =
    Error.withMessage
        (SafeText.toString
            (SafeText.concat
                [ SafeText.literal "index path "
                , SafeText.quoted stored
                , SafeText.literal " could not be read: "
                , SafeText.render (Error.message e)
                ]
            )
        )
        e


verifyView : String -> String -> Result StaleReason String -> SourceView
verifyView uid stored sliced =
    case sliced of
        Err reason ->
            Stale reason

        Ok view ->
            if attest view == stored then
                Shown (ShownSource { uid = uid, text = view, hash = stored })

            else
                Stale Drifted


-- The largest source file a unit is sliced from; a bigger file under the root
-- is refused rather than read whole into memory.
sourceCeiling : ByteSize
sourceCeiling =
    ByteSize.mib 16


-- The single decode point from a raw row: the stored hash and language are
-- parsed here, and every displayed text column is rendered into `SafeText`.
withRow : RowUnit -> Unit
withRow row =
    { uid = row.uid
    , path = SafeText.renderForeign row.path
    , name = SafeText.renderForeign row.name
    , qualified = SafeText.renderForeign row.qualified
    , kind = SafeText.renderForeign row.kind
    , lang = langOf row.lang
    , lineStart = row.lineStart
    , lineEnd = row.lineEnd
    , facing = SafeText.renderForeign row.facing
    , purpose = Maybe.map SafeText.renderForeign row.purpose
    , attested = parseAttested row.bodyHash
    , updatedSha = row.updatedSha
    }


-- A stored file language parsed for highlighting; a unit with no file row
-- reads as `Unknown`, shown as escaped plain text.
langOf : Maybe String -> Highlight.Lang
langOf stored =
    case stored of
        Just lang ->
            Highlight.langFor lang

        Nothing ->
            Highlight.Unknown


-- A stored `body_hash`, parsed once: an attestation this app can re-prove,
-- or a value under any other scheme (a legacy or unknown hash).
type AttestedHash
    = Sha256 String
    | UnknownScheme String


parseAttested : String -> AttestedHash
parseAttested stored =
    if String.startsWith attestScheme stored then
        Sha256 stored

    else
        UnknownScheme stored


-- The stored text, for keying review-db lookups only; never a value to
-- record a decision against.
storedHash : AttestedHash -> String
storedHash attested =
    case attested of
        Sha256 stored ->
            stored

        UnknownScheme stored ->
            stored


-- The first 8 characters of a stored hash, rendered for display: an
-- attestation shows its digest without the scheme prefix, any other value
-- its leading text. The stored text is database text, so it is rendered.
shortHash : String -> SafeText
shortHash stored =
    SafeText.renderForeign (String.slice 0 8 (hashDigits (parseAttested stored)))


hashDigits : AttestedHash -> String
hashDigits attested =
    case attested of
        Sha256 stored ->
            String.dropLeft (String.length attestScheme) stored

        UnknownScheme other ->
            other


-- Source text proved equal to its attestation. Opaque: built only by
-- `viewOf`, so holding one means the bytes were re-hashed.
type ShownSource
    = ShownSource { uid : String, text : String, hash : String }


shownText : ShownSource -> String
shownText shown =
    case shown of
        ShownSource s ->
            s.text


shownHash : ShownSource -> String
shownHash shown =
    case shown of
        ShownSource s ->
            s.hash


-- The one hash a decision or drain may record: the hash of the bytes that
-- were shown, re-proved against the current index row and file. Opaque:
-- built only by `reverify`.
type Attested
    = Attested { uid : String, hash : String }


attestedUid : Attested -> String
attestedUid attested =
    case attested of
        Attested a ->
            a.uid


attestedHash : Attested -> String
attestedHash attested =
    case attested of
        Attested a ->
            a.hash


-- Re-proves a shown source at decision time: the unit's row is re-read from
-- the index and its file re-hashed through `viewOf`, and the fresh view must
-- be shown under the same hash. A unit gone from the index, or a source that
-- changed or became unreadable since it was shown, is a conflict, so no
-- decision is recorded against bytes the reviewer did not see. The index and
-- root are the one `settings` value resolved at startup, the tree the page
-- showed the unit from.
reverify : IndexSettings -> ShownSource -> Task.Task Error Attested
reverify settings shown =
    case shown of
        ShownSource s ->
            do
                conn <- readConnection settings
                rows <- Db.queryDecode conn unitByUidSql [ SqlString s.uid ] rowDecoder
                case List.head rows of
                    Just row ->
                        viewOf settings.roots row
                            |> Task.andThen (confirmShown s.uid s.hash)

                    Nothing ->
                        Task.fail (Error.conflict "unit no longer indexed")


confirmShown : String -> String -> SourceView -> Task.Task Error Attested
confirmShown uid hash fresh =
    case fresh of
        Shown now ->
            if shownHash now == hash then
                Task.succeed (Attested { uid = uid, hash = hash })

            else
                Task.fail sourceChanged

        Stale _ ->
            Task.fail sourceChanged

        Unreadable _ ->
            Task.fail sourceChanged


sourceChanged : Error
sourceChanged =
    Error.conflict "source changed since it was shown; reload"


-- Why a unit's source is withheld instead of shown.
type StaleReason
    = Drifted
    | RangeOutOfFile { lineCount : Int }
    | UnverifiableHash


-- What the unit page may show of a unit's source: the verified view, a
-- reason it is withheld, or the error that kept it from being read.
type SourceView
    = Shown ShownSource
    | Stale StaleReason
    | Unreadable Error


-- The scheme prefix of every attestation ipe-index stores in `body_hash`.
attestScheme : String
attestScheme =
    "sha256:"


-- The attestation of a view: the scheme prefix and the view's lowercase hex
-- SHA-256, the exact form ipe-index stores in `units.body_hash`.
attest : String -> String
attest view =
    attestScheme ++ Crypto.sha256 view


-- A file's lines under the attestation's split rule, shared with ipe-index
-- through the vectors file: split on `\n`, keep `\r`, drop the one empty
-- segment a trailing `\n` leaves. `""` is one empty line.
viewLines : String -> List String
viewLines text =
    let
        segments =
            String.split "\n" text
    in
    if String.endsWith "\n" text then
        List.take (List.length segments - 1) segments

    else
        segments


-- Lines `start..end` (1-based, inclusive) of `text` joined by `\n`. A range
-- outside the file is refused with the file's line count, never clamped.
viewText : Int -> Int -> String -> Result StaleReason String
viewText start end text =
    let
        segments =
            viewLines text

        count =
            List.length segments
    in
    if 1 <= start && start <= end && end <= count then
        segments
            |> List.drop (start - 1)
            |> List.take (end - start + 1)
            |> String.join "\n"
            |> Ok

    else
        Err (RangeOutOfFile { lineCount = count })
