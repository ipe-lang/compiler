module Lib.Keys exposing (KeyAction(..), KeyMode(..), Position, index, keyAction, position)


-- Page-level keyboard shortcuts. The mapping lives here, pure and
-- testable; App only translates each KeyAction into the same Msg the
-- matching button dispatches, so the buttons stay the single source of truth.
-- `card` is what a decision shortcut acts on and `panel` what a refusal
-- panel's Enter and Escape act on; the two are distinct type variables, so a
-- panel row can never stand in for a card, nor a card for a panel row.

-- Where the selection stands among the cards a page holds: `at` within
-- `0 .. count - 1`, `count` at least 1. Opaque: built only by `position`, so
-- an index past the cards or a selection over no cards has no representation.
type Position
    = Position { at : Int, count : Int }


-- The selection `selected` over `count` cards, clamped into them; none when
-- there are no cards.
position : Int -> Int -> Maybe Position
position selected count =
    if count < 1 then
        Nothing

    else
        Just (Position { at = max 0 (min selected (count - 1)), count = count })


index : Position -> Int
index pos =
    case pos of
        Position p ->
            p.at


-- `pos` moved to `i`, clamped into its cards.
moveTo : Int -> Position -> Position
moveTo i pos =
    case pos of
        Position p ->
            Position { at = max 0 (min i (p.count - 1)), count = p.count }


-- How a key is read. `InPanel`: typed into a refusal panel, with the panel
-- row its render drew when it drew one. `OnCards`: a shortcut, with the card
-- its render drew and where the selection stands. `Dormant`: no key acts.
type KeyMode card panel
    = InPanel (Maybe panel)
    | OnCards (Maybe card) Position
    | Dormant


-- Each action carries the payload its mode drew; the buttons send the same
-- messages, so the keys stay a mirror.
type KeyAction card panel
    = ApproveSelected card
    | RefuseSelected card
    | Select Position
    | ConfirmRefuse panel
    | CancelRefuse panel
    | Ignore


keyAction : KeyMode card panel -> String -> KeyAction card panel
keyAction mode key =
    case mode of
        InPanel drawn ->
            panelKey drawn key

        OnCards card at ->
            cardKey card at key

        Dormant ->
            Ignore


-- In a panel only Enter and Escape act, and only on the panel row drawn; a
-- reason's letters are never shortcuts.
panelKey : Maybe panel -> String -> KeyAction card panel
panelKey drawn key =
    case drawn of
        Just row ->
            case key of
                "Enter" ->
                    ConfirmRefuse row

                "Escape" ->
                    CancelRefuse row

                _ ->
                    Ignore

        Nothing ->
            Ignore


cardKey : Maybe card -> Position -> String -> KeyAction card panel
cardKey card at key =
    case key of
        "a" ->
            onCard ApproveSelected card

        "r" ->
            onCard RefuseSelected card

        "j" ->
            Select (moveTo (index at + 1) at)

        "k" ->
            Select (moveTo (index at - 1) at)

        "g" ->
            Select (moveTo 0 at)

        "1" ->
            Select (moveTo 0 at)

        "2" ->
            Select (moveTo 1 at)

        "3" ->
            Select (moveTo 2 at)

        "4" ->
            Select (moveTo 3 at)

        "5" ->
            Select (moveTo 4 at)

        _ ->
            Ignore


onCard : (card -> KeyAction card panel) -> Maybe card -> KeyAction card panel
onCard act card =
    case card of
        Just drawn ->
            act drawn

        Nothing ->
            Ignore
