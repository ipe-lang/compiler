module Lib.SafeText exposing (SafeText, Segment(..), concat, escapeSpelling, isHazard, literal, quoted, render, renderForeign, segments, spelled, toString)

-- Text that is safe to write to an operator's terminal or show on a page:
-- every display-hazard character is spelled out as a visible escape. Untrusted
-- text (index rows, environment values, an error message built from either)
-- enters only through `render`, `quoted` or `renderForeign`; `literal` is for
-- text this tool writes itself, so its callers pass string literals only.
-- `toString` is the one exit, used at a sink. The tool constants `key` and
-- `hint` that `Main.requireEnv` prints are such literals.
--
-- The hazard set is the review-display set: a strict superset of the
-- runtime's log-hazard set (`is_log_hazard`, `src/runtime/rust/src/system.rs`)
-- that adds every code point that renders as nothing or as a plain space.
-- Tests pin it to `tools/ipe-index/tests/display_hazard_vectors.json` (itself
-- pinned to the UCD) and check that it contains the runtime's
-- `log_hazard_ranges.json`. The escapes follow `scrub_log_controls`: `\n`,
-- `\r` and `\t` by name, every other hazard as `\u{hex}` in lowercase. One
-- deliberate deviation: `render` also escapes a literal `\` as `\\`, so
-- untrusted text cannot pre-forge an escape that reads as an innocent
-- character, and a `"` as `\"`, so a `quoted` value cannot close its own
-- quotes. With `\` escaped the mapping stays injective. `renderForeign` leaves
-- `\` and `"` alone: it is the sink-side pass over text that may already be
-- rendered, where doubling every `\` again would garble it. `spelled`
-- escapes every character outside printable ASCII and `\`, but not `"`: it
-- is for source text spelled out in a code block, where no element marks an
-- escape, no quote delimits the text, and `\` alone keeps the mapping
-- injective. Its output is printable ASCII, so no character can draw like
-- a `\` (U+29F5, U+FF3C) and make an escape read as source text.
--
-- A `SafeText` is a list of `Segment`s, so each escape the tool writes keeps
-- its role: `Verbatim` is text exactly as it arrived, `Escaped` a character
-- the tool spelled out. A page draws an `Escaped` segment distinctly from
-- `Verbatim` text, so the six characters `\u{200b}` in `renderForeign` input
-- and a real U+200B never look alike there; `toString` is the flat form for a
-- terminal or log, where `\` is not marked.

import Ipe.Bitwise as Bitwise
import Ipe.Char as Char
import Ipe.List as List
import Ipe.String as String


type SafeText
    = SafeText (List Segment)


type Segment
    = Verbatim String
    | Escaped Char


-- A character that must never reach a terminal or review page raw: the
-- union of Unicode `Cc`, `Cf`, `Zl`, `Zp`, `Zs` except U+0020,
-- `Default_Ignorable_Code_Point` (the whole tag block and the reserved
-- ignorable ranges included) and U+2800 BRAILLE PATTERN BLANK.
isHazard : Char -> Bool
isHazard c =
    let
        code =
            Char.toCode c
    in
    if code >= 32 && code <= 126 then
        False

    else
        List.any (\( lo, hi ) -> code >= lo && code <= hi) hazardRanges


-- The hazard set as sorted, disjoint, inclusive code-point ranges: row for
-- row the `lo`/`hi` of `display_hazard_vectors.json`, whose `why` names each
-- row's Unicode class.
hazardRanges : List ( Int, Int )
hazardRanges =
    [ ( 0, 31 )
    , ( 127, 159 )
    , ( 160, 160 )
    , ( 173, 173 )
    , ( 847, 847 )
    , ( 1536, 1541 )
    , ( 1564, 1564 )
    , ( 1757, 1757 )
    , ( 1807, 1807 )
    , ( 2192, 2193 )
    , ( 2274, 2274 )
    , ( 4447, 4448 )
    , ( 5760, 5760 )
    , ( 6068, 6069 )
    , ( 6155, 6157 )
    , ( 6158, 6158 )
    , ( 6159, 6159 )
    , ( 8192, 8202 )
    , ( 8203, 8207 )
    , ( 8232, 8232 )
    , ( 8233, 8233 )
    , ( 8234, 8238 )
    , ( 8239, 8239 )
    , ( 8287, 8287 )
    , ( 8288, 8292 )
    , ( 8293, 8293 )
    , ( 8294, 8303 )
    , ( 10240, 10240 )
    , ( 12288, 12288 )
    , ( 12644, 12644 )
    , ( 65024, 65039 )
    , ( 65279, 65279 )
    , ( 65440, 65440 )
    , ( 65520, 65528 )
    , ( 65529, 65531 )
    , ( 69821, 69821 )
    , ( 69837, 69837 )
    , ( 78896, 78911 )
    , ( 113824, 113827 )
    , ( 119155, 119162 )
    , ( 917504, 917504 )
    , ( 917505, 917505 )
    , ( 917506, 917535 )
    , ( 917536, 917631 )
    , ( 917632, 921599 )
    ]


-- Untrusted text with every hazard, every `\` and every `"` escaped.
render : String -> SafeText
render raw =
    SafeText (escapeWith HazardsBackslashQuote raw)


-- Untrusted text that may already hold rendered escapes: every hazard is
-- escaped, `\` and `"` are kept as is.
renderForeign : String -> SafeText
renderForeign raw =
    SafeText (escapeWith Hazards raw)


-- Untrusted source text spelled out: every character outside printable
-- ASCII and every `\` escaped, `"` kept as is. Each escape starts with `\`,
-- so no source text spells another, and the text is printable ASCII, so no
-- source character draws like the `\` that starts one.
spelled : String -> SafeText
spelled raw =
    SafeText (escapeWith NonAsciiBackslash raw)


-- Untrusted text rendered and wrapped in double quotes, the form a diagnostic
-- uses to name a foreign value.
quoted : String -> SafeText
quoted raw =
    concat [ literal "\"", render raw, literal "\"" ]


-- Text this tool wrote itself; callers pass a string literal.
literal : String -> SafeText
literal text =
    SafeText (verbatim text)


-- The pieces joined in order; adjacent `Verbatim` text merges into one
-- segment, so a segment boundary always marks an escape. One left-to-right
-- pass, linear in the pieces' segments and text.
concat : List SafeText -> SafeText
concat pieces =
    case List.foldl joinSegment ( "", [] ) (List.concatMap segments pieces) of
        ( pending, done ) ->
            SafeText (flushed pending done)


joinSegment : Segment -> ( String, List Segment ) -> ( String, List Segment )
joinSegment seg ( pending, done ) =
    case seg of
        Verbatim s ->
            ( String.append pending s, done )

        Escaped c ->
            ( "", flushed pending done ++ [ Escaped c ] )


segments : SafeText -> List Segment
segments text =
    case text of
        SafeText segs ->
            segs


-- The flat form: each `Escaped` segment as its `escapeSpelling`.
toString : SafeText -> String
toString text =
    case segments text of
        [ Verbatim s ] ->
            s

        segs ->
            String.concat (List.map segmentString segs)


-- How an escaped character is spelled: `\n`, `\r` and `\t` by name, `\\` and
-- `\"` for the two characters `render` escapes, every hazard as `\u{hex}` in
-- lowercase.
escapeSpelling : Char -> String
escapeSpelling c =
    if c == '\n' then
        "\\n"

    else if c == '\r' then
        "\\r"

    else if c == '\t' then
        "\\t"

    else if c == '\\' then
        "\\\\"

    else if c == '"' then
        "\\\""

    else
        "\\u{" ++ hex (Char.toCode c) ++ "}"


segmentString : Segment -> String
segmentString seg =
    case seg of
        Verbatim s ->
            s

        Escaped c ->
            escapeSpelling c


verbatim : String -> List Segment
verbatim text =
    if String.isEmpty text then
        []

    else
        [ Verbatim text ]


-- Which characters a rendering escapes: the hazards; every character
-- outside printable ASCII, which holds every hazard, and `\`; or the
-- hazards, `\` and `"`.
type EscapeSet
    = Hazards
    | NonAsciiBackslash
    | HazardsBackslashQuote


isPrintableAscii : Char -> Bool
isPrintableAscii c =
    Char.toCode c >= 32 && Char.toCode c <= 126


needsEscape : EscapeSet -> Char -> Bool
needsEscape escapes c =
    case escapes of
        Hazards ->
            isHazard c

        NonAsciiBackslash ->
            not (isPrintableAscii c) || c == '\\'

        HazardsBackslashQuote ->
            isHazard c || c == '\\' || c == '"'


escapeWith : EscapeSet -> String -> List Segment
escapeWith escapes raw =
    if String.any (needsEscape escapes) raw then
        case String.foldl (scanChar escapes) ( "", [] ) raw of
            ( pending, done ) ->
                flushed pending done

    else
        verbatim raw


-- One step of a left-to-right scan: `pending` holds the verbatim text read
-- since the last escape; `done` the segments before it, in order. Both grow
-- at their end in place, so the scan is linear in the text; a segment consed
-- onto the head would copy the whole list each step.
scanChar : EscapeSet -> Char -> ( String, List Segment ) -> ( String, List Segment )
scanChar escapes c ( pending, done ) =
    if needsEscape escapes c then
        ( "", flushed pending done ++ [ Escaped c ] )

    else
        ( String.append pending (String.fromChar c), done )


-- `done` with the verbatim text `pending` after it, when there is any.
flushed : String -> List Segment -> List Segment
flushed pending done =
    if String.isEmpty pending then
        done

    else
        done ++ [ Verbatim pending ]


-- `n` (non-negative) in lowercase hex, no leading zeros. Each step drops one
-- nibble, so a code point (at most 0x10FFFF) takes at most six steps.
hex : Int -> String
hex n =
    if n < 16 then
        hexDigit n

    else
        hex (Bitwise.shiftRightBy 4 n) ++ hexDigit (Bitwise.and 15 n)


hexDigit : Int -> String
hexDigit d =
    String.slice d (d + 1) "0123456789abcdef"
