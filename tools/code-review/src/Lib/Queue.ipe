module Lib.Queue exposing (DecisionSlot(..), HistoryPage, HistoryRow, HistoryState(..), LoadTicket, Progress, QueuePage, QueueState(..), QueuedUnit, ResyncBound, SelectedView(..), UnitPageState(..), clearView, decidableSource, decide, decisionSettled, drainThenLoad, firstTicket, historyStateFromResult, historyStatusText, isCurrentLoad, loadHistoryPage, loadPage, makeResyncBound, nextTicket, loadUnitView, pageHeaderText, queueStatusText, reloadView, resyncBound, resyncPageCeiling, resyncReviewed, resyncReviewedWithin, selectView, selectedViewOf, selectedViewStatusText, sourceStatusText, startDecision, stateFromResult, unitPageEntry, unitPageOf, unitPageStatusText, viewArrived)

import Ipe.ByteSize as ByteSize
import Ipe.Db as Db
import Ipe.Error as Error
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task
import Ipe.Time.Timestamp exposing (Timestamp)
import Lib.Db as LibDb exposing (HistoryCursor(..))
import Lib.Epoch exposing (Epoch)
import Lib.Format as Format
-- `Index.Unit` names `Highlight.Lang` and `Index.UnitView` names
-- `Links.LinkSet`, and an imported alias resolves its qualified names in this
-- module.
import Lib.Highlight as Highlight
import Lib.Index as Index exposing (Oversize(..), SourceView(..), StaleReason(..))
import Lib.Links as Links
import Lib.PageSize as PageSize exposing (PageSize)
import Lib.SafeText as SafeText exposing (SafeText)
import Lib.Settings as Settings exposing (AppSettings, IndexSettings)
import Lib.Uid as Uid exposing (Uid)


-- An open unit plus its resurfacing state. `change` is what the index
-- recorded about its current body. `changed` is Just the previous review
-- when this uid was already decided on an OLDER body hash: the author edited
-- the code after the review, so the unit must be reviewed again.
type alias QueuedUnit =
    { unit : Index.Unit
    , change : Index.Change
    , changed : Maybe LibDb.ReviewRow
    }


-- One loaded page of the queue. `total` counts the whole queue (never this
-- page's length); `next` is the cursor of the following page, Nothing on the
-- last page; `dbName` is the index file's name, rendered once.
type alias QueuePage =
    { units : List QueuedUnit
    , total : Int
    , dbName : SafeText
    , dbBytes : Int
    , next : Maybe Index.Cursor
    , progress : Progress
    }


-- Review progress over the index as it stands, never from a session:
-- `total` counts the index's units and `reviewed` those not open, so a unit
-- is reviewed exactly when its current (uid, body_hash) pair has a decision.
-- Both come from the same read as the page's rows, after the `reviewed`
-- copy is proved current against the review log's head. Deciding a unit
-- moves it from open to reviewed, so `total` holds while the queue drains,
-- and a reload or a second tab reads the same numbers.
type alias Progress =
    { reviewed : Int
    , total : Int
    }


-- How far one rebuild of the `reviewed` copy may read: `pageCeiling` pages
-- of at most `pageSize` decided pairs each. Opaque: built only by
-- `makeResyncBound` and `resyncBound`, so a ceiling below one page, or one
-- whose decision count or loop limit passes the largest `Int`, has no
-- representation and no rebuild re-checks it.
type ResyncBound
    = ResyncBound { pageSize : PageSize, pageCeiling : Int }


-- The largest `Int`.
maxInt : Int
maxInt =
    9223372036854775807


-- `pageCeiling` pages of `size` pairs as a bound. A ceiling below one is
-- refused, and so is one whose `pageCeiling x size` decisions or whose loop
-- limit `pageCeiling + 1` would pass the largest `Int`; the check divides,
-- so it never multiplies past the range it guards.
makeResyncBound : PageSize -> Int -> Result Error ResyncBound
makeResyncBound size pageCeiling =
    if pageCeiling < 1 then
        Err (Error.invalidInput "a review progress rebuild needs a page ceiling of at least 1")

    else if pageCeiling > (maxInt - 1) // PageSize.toInt size then
        Err (Error.invalidInput "a review progress rebuild's page ceiling times its page size passes the largest integer")

    else
        Ok (ResyncBound { pageSize = size, pageCeiling = pageCeiling })


-- The most review-database pages one rebuild reads: a bound on one rebuild
-- transaction's work (`pageCeiling x PageSize.pairs` decisions), never a
-- stack limit — the walk runs at constant stack depth through `Task.loop`.
resyncPageCeiling : Int
resyncPageCeiling =
    10000


resyncBound : ResyncBound
resyncBound =
    ResyncBound { pageSize = PageSize.pairs, pageCeiling = resyncPageCeiling }


boundPageSize : ResyncBound -> PageSize
boundPageSize bound =
    case bound of
        ResyncBound b ->
            b.pageSize


boundCeiling : ResyncBound -> Int
boundCeiling bound =
    case bound of
        ResyncBound b ->
            b.pageCeiling


-- The `reviewed` copy rebuilt from the review database: one index
-- transaction empties it, drains every decided pair, so a pair's undrained
-- queue row leaves too, and stamps the copy with the review-log head read
-- before the refill. A decision recorded during the refill moves the head
-- past that stamp, so the next load rebuilds again rather than trust a copy
-- that may lack it. Returns the count of pairs copied.
resyncReviewed : IndexSettings -> Db.Db -> Task.Task Error Int
resyncReviewed settings db =
    resyncReviewedWithin settings resyncBound db


-- `resyncReviewed` reading at most the bound's page ceiling of pages of its
-- page size of decided pairs. A review database holding more refuses the
-- rebuild and rolls it back, leaving the copy and its stamp as they were.
resyncReviewedWithin : IndexSettings -> ResyncBound -> Db.Db -> Task.Task Error Int
resyncReviewedWithin settings bound db =
    do
        head <- LibDb.currentHead db
        Index.rebuildReviewed settings head (\conn -> refillPages bound db conn)


-- The state one `refillPages` step carries: how many pages have been read,
-- how many pairs have been drained so far, and the cursor the next page
-- reads after.
type alias RefillState =
    { pagesRead : Int
    , copied : Int
    , cursor : Maybe Index.DecidedPair
    }


-- `resyncReviewed` draining the review database at constant stack depth,
-- however many pages it takes. The loop's own ceiling, the page ceiling plus
-- one, is an unreachable backstop (defence in depth): the step itself
-- refuses a non-empty page once `pagesRead` reaches the page ceiling, so the
-- loop's own limit never has a chance to fire.
refillPages : ResyncBound -> Db.Db -> Db.Db -> Task.Task Error Int
refillPages bound db conn =
    Task.loop (boundCeiling bound + 1) { pagesRead = 0, copied = 0, cursor = Nothing } (refillStep bound db conn)


-- One page of decided pairs after `state.cursor`, drained on `conn`: an
-- empty page ends the walk with the pairs copied so far; a non-empty page
-- past the ceiling fails the whole rebuild; otherwise the page drains, then
-- a short page ends the walk and a full page continues from its last pair.
refillStep : ResyncBound -> Db.Db -> Db.Db -> RefillState -> Task.Task Error (Task.Step RefillState Int)
refillStep bound db conn state =
    do
        pairs <- LibDb.decidedPairsAfter db (boundPageSize bound) state.cursor
        if List.isEmpty pairs then
            Task.succeed (Task.Done state.copied)

        else if state.pagesRead >= boundCeiling bound then
            Task.fail (resyncCeilingRefusal bound)

        else
            do
                pairs
                    |> List.map (Index.drainDecided conn)
                    |> Task.sequence
                let
                    copied =
                        state.copied + List.length pairs
                in
                if List.length pairs < PageSize.toInt (boundPageSize bound) then
                    Task.succeed (Task.Done copied)

                else
                    Task.succeed
                        (Task.Continue
                            { pagesRead = state.pagesRead + 1
                            , copied = copied
                            , cursor = List.head (List.reverse pairs)
                            }
                        )


resyncCeilingRefusal : ResyncBound -> Error
resyncCeilingRefusal bound =
    Error.invalidInput
        ("the review database holds more than "
            ++ String.fromInt (boundCeiling bound * PageSize.toInt (boundPageSize bound))
            ++ " decisions, past the "
            ++ String.fromInt (boundCeiling bound)
            ++ "-page ceiling of a review progress rebuild; the progress copy is left unchanged"
        )


-- The queue view's state. An empty queue is only `Loaded` with `total == 0`,
-- so a load in flight or a failed load can never render as empty.
type QueueState
    = Loading
    | Loaded QueuePage
    | Failed Error


-- The number of one load of a page slot (the queue, a History page, a unit
-- page). Each load a slot starts takes the ticket after the slot's latest,
-- and a result settles the slot only under the slot's latest ticket, so a
-- slower earlier load never replaces the result of a later one. Opaque:
-- built only by `firstTicket` and `nextTicket`.
type LoadTicket
    = LoadTicket Int


firstTicket : LoadTicket
firstTicket =
    LoadTicket 0


nextTicket : LoadTicket -> LoadTicket
nextTicket ticket =
    case ticket of
        LoadTicket n ->
            LoadTicket (n + 1)


-- True when a result carrying `load` is the slot's latest load.
isCurrentLoad : LoadTicket -> LoadTicket -> Bool
isCurrentLoad load latest =
    ticketNumber load == ticketNumber latest


ticketNumber : LoadTicket -> Int
ticketNumber ticket =
    case ticket of
        LoadTicket n ->
            n


-- A decided unit as the History page shows it: the review row plus the unit's
-- qualified name resolved from the index db, rendered (Nothing when the unit
-- no longer exists there).
type alias HistoryRow =
    { uid : Uid
    , bodyHash : String
    , decision : LibDb.StoredDecision
    , reviewedAt : Timestamp
    , name : Maybe SafeText
    }


-- One loaded History page: its rows, the cursor it was read from, and the
-- cursor of the page after it (Nothing on the last page).
type alias HistoryPage =
    { rows : List HistoryRow
    , at : LibDb.HistoryCursor
    , next : Maybe LibDb.HistoryCursor
    }


-- The History view's state. An empty history is only `HistoryLoaded` with
-- no rows from `HistoryStart`, so a load in flight or a failed load can
-- never render as "no reviews".
type HistoryState
    = HistoryLoading
    | HistoryLoaded HistoryPage
    | HistoryFailed Error


historyStateFromResult : Result Error HistoryPage -> HistoryState
historyStateFromResult result =
    case result of
        Ok page ->
            HistoryLoaded page

        Err e ->
            HistoryFailed e


-- The one-line text for a History state that has no rows to show; Nothing
-- for a loaded page that holds rows.
historyStatusText : HistoryState -> Maybe String
historyStatusText state =
    case state of
        HistoryLoading ->
            Just "Loading history…"

        HistoryFailed e ->
            Just ("History load failed: " ++ SafeText.toString (SafeText.renderForeign (Error.toString e)))

        HistoryLoaded page ->
            if List.isEmpty page.rows then
                case page.at of
                    HistoryStart ->
                        Just "No reviews yet."

                    HistoryAfter _ _ _ ->
                        Just "No more reviews."

            else
                Nothing


-- One History page from `cursor`, newest first, each row with the unit's
-- qualified name resolved from the index db named by `settings`. At most
-- `PageSize.history` rows are read, and one name lookup runs per row.
loadHistoryPage : AppSettings -> LibDb.HistoryCursor -> Task.Task Error HistoryPage
loadHistoryPage settings cursor =
    do
        db <- LibDb.openAt settings.review
        page <- LibDb.historyPage db PageSize.history cursor
        conn <- Index.readConnection settings.index
        rows <- Task.sequence (List.map (historyRow conn) page.rows)
        Task.succeed { rows = rows, at = cursor, next = page.next }


historyRow : Db.Db -> LibDb.ReviewRow -> Task.Task Error HistoryRow
historyRow conn row =
    Task.map
        (\name ->
            { uid = row.uid
            , bodyHash = row.bodyHash
            , decision = row.decision
            , reviewedAt = row.reviewedAt
            , name = name
            }
        )
        (Index.nameFor conn row.uid)


-- The one way a decision is recorded: only a shown source can be decided,
-- since only a verified view holds a `ShownSource`, and only after
-- `Index.reverify` re-proves it, so the hash written is the hash of the
-- bytes the reviewer saw.
decide : IndexSettings -> Db.Db -> Index.ShownSource -> LibDb.Decision -> Task.Task Error ( Index.Attested, Index.Written )
decide settings db shown decision =
    do
        attested <- Index.reverify settings shown
        written <- LibDb.insertDecision db attested decision
        Task.succeed ( attested, written )


-- The session's one source slot, shared by the selected queue card and the
-- unit page: nothing selected, one read in flight
-- (with the unit wanted once it returns, when the selection moved during the
-- read), the loaded view, no unit with the read's uid, or a failed read. At
-- most one read is in flight: a selection made during a read only records
-- `wanted`, and a response for any uid but the in-flight one is dropped.
-- `fresh` is False once the queue page reloaded or cleared during the read,
-- so its result predates the page and never settles the view: the in-flight
-- unit selected again is read afresh, and with nothing wanted the result is
-- dropped. `owner` is the epoch whose process runs the read: slot ownership
-- is tied to process lifetime, so a read owned by another epoch is
-- `NoneSelected` to every transition.
type SelectedView
    = NoneSelected
    | ViewLoading { uid : Uid, wanted : Maybe Uid, fresh : Bool, owner : Epoch }
    | ViewShown Index.UnitView
    | ViewMissing Uid
    | ViewFailed Uid Error


-- The slot as process `epoch` sees it: a read owned by another epoch has no
-- completion left to settle it, so it is `NoneSelected`.
ownedView : Epoch -> SelectedView -> SelectedView
ownedView epoch state =
    case state of
        ViewLoading loading ->
            if loading.owner == epoch then
                state

            else
                NoneSelected

        ViewShown _ ->
            state

        NoneSelected ->
            state

        ViewMissing _ ->
            state

        ViewFailed _ _ ->
            state


-- `uid` selected in process `epoch`, with the uid to read next, if any.
-- During a read only the wanted unit is recorded; the shown unit selected
-- again reads nothing.
selectView : Epoch -> Uid -> SelectedView -> ( SelectedView, Maybe Uid )
selectView epoch uid state =
    case ownedView epoch state of
        ViewLoading loading ->
            ( ViewLoading { uid = loading.uid, wanted = wantedAfter loading.uid loading.fresh uid, fresh = loading.fresh, owner = loading.owner }, Nothing )

        ViewShown shown ->
            if shown.unit.uid == uid then
                ( ViewShown shown, Nothing )

            else
                startView epoch uid

        NoneSelected ->
            startView epoch uid

        ViewMissing _ ->
            startView epoch uid

        ViewFailed _ _ ->
            startView epoch uid


-- `uid` selected after the queue page reloaded, so its view is read afresh
-- even when it is the one shown; during a read it is read once that read
-- returns.
reloadView : Epoch -> Uid -> SelectedView -> ( SelectedView, Maybe Uid )
reloadView epoch uid state =
    case ownedView epoch state of
        ViewLoading loading ->
            ( ViewLoading { uid = loading.uid, wanted = Just uid, fresh = False, owner = loading.owner }, Nothing )

        ViewShown _ ->
            startView epoch uid

        NoneSelected ->
            startView epoch uid

        ViewMissing _ ->
            startView epoch uid

        ViewFailed _ _ ->
            startView epoch uid


-- No unit to select. A read in flight stays recorded, with nothing wanted
-- after it, so no second read can start beside it, and its result is
-- dropped when it returns.
clearView : Epoch -> SelectedView -> SelectedView
clearView epoch state =
    case ownedView epoch state of
        ViewLoading loading ->
            ViewLoading { uid = loading.uid, wanted = Nothing, fresh = False, owner = loading.owner }

        ViewShown _ ->
            NoneSelected

        NoneSelected ->
            NoneSelected

        ViewMissing _ ->
            NoneSelected

        ViewFailed _ _ ->
            NoneSelected


-- The read of `uid` run by process `epoch` returned with `result`: when
-- another unit was selected meanwhile its read starts, otherwise the result
-- settles the view. A response for any uid but the in-flight one, or from
-- any process but the read's owner, changes nothing.
viewArrived : Epoch -> Uid -> Result Error (Maybe Index.UnitView) -> SelectedView -> ( SelectedView, Maybe Uid )
viewArrived epoch uid result state =
    case state of
        ViewLoading loading ->
            if loading.uid /= uid || loading.owner /= epoch then
                ( state, Nothing )

            else
                case loading.wanted of
                    Just next ->
                        startView epoch next

                    Nothing ->
                        if loading.fresh then
                            ( settledView uid result, Nothing )

                        else
                            ( NoneSelected, Nothing )

        ViewShown _ ->
            ( state, Nothing )

        NoneSelected ->
            ( state, Nothing )

        ViewMissing _ ->
            ( state, Nothing )

        ViewFailed _ _ ->
            ( state, Nothing )


startView : Epoch -> Uid -> ( SelectedView, Maybe Uid )
startView epoch uid =
    ( ViewLoading { uid = uid, wanted = Nothing, fresh = True, owner = epoch }, Just uid )


-- The unit wanted after the in-flight read of `inFlight` when `uid` is
-- selected: nothing when the in-flight unit is selected again and its read
-- is fresh; a read that predates the page reads that unit again.
wantedAfter : Uid -> Bool -> Uid -> Maybe Uid
wantedAfter inFlight fresh uid =
    if inFlight == uid && fresh then
        Nothing

    else
        Just uid


settledView : Uid -> Result Error (Maybe Index.UnitView) -> SelectedView
settledView uid result =
    case result of
        Ok (Just loaded) ->
            ViewShown loaded

        Ok Nothing ->
            ViewMissing uid

        Err e ->
            ViewFailed uid e


-- The loaded view of the selected unit `uid`; Nothing while it loads, when
-- its read failed or found no unit, or when the view is another unit's.
selectedViewOf : Uid -> SelectedView -> Maybe Index.UnitView
selectedViewOf uid state =
    case state of
        ViewShown shown ->
            if shown.unit.uid == uid then
                Just shown

            else
                Nothing

        ViewLoading _ ->
            Nothing

        NoneSelected ->
            Nothing

        ViewMissing _ ->
            Nothing

        ViewFailed _ _ ->
            Nothing


-- The one source a decision on `uid` may be made on: the selected unit's
-- verified view. Nothing for a withheld view, a view not loaded, or another
-- unit's view, so nothing else can reach `decide`.
decidableSource : Uid -> SelectedView -> Maybe Index.ShownSource
decidableSource uid state =
    case selectedViewOf uid state of
        Just loaded ->
            case loaded.view of
                Shown shown ->
                    Just shown

                Stale _ ->
                    Nothing

                Unreadable _ ->
                    Nothing

                TooLarge _ ->
                    Nothing

        Nothing ->
            Nothing


-- The one-line text in place of the selected unit's source while it has no
-- loaded view; Nothing once the view of `uid` is loaded.
selectedViewStatusText : Uid -> SelectedView -> Maybe String
selectedViewStatusText uid state =
    case state of
        ViewShown shown ->
            if shown.unit.uid == uid then
                Nothing

            else
                Just "Loading source…"

        ViewLoading _ ->
            Just "Loading source…"

        NoneSelected ->
            Just "Loading source…"

        ViewMissing _ ->
            Just "This unit is no longer in the index."

        ViewFailed _ e ->
            Just ("Source load failed: " ++ SafeText.toString (SafeText.renderForeign (Error.toString e)))


-- The unit page: loading, the unit with its source and links, no such unit,
-- a failed load, or an address whose unit id is not one. A missing unit is
-- its own state, never shown as still loading.
type UnitPageState
    = UnitLoading
    | UnitLoaded Index.UnitView
    | UnitNotFound
    | UnitFailed Error
    | UnitIdRefused


-- The unit id a unit page's address names, parsed once: an address whose
-- segment is not a unit id is `UnitIdRefused`, so it reaches no query.
unitPageEntry : String -> Result UnitPageState Uid
unitPageEntry raw =
    case Uid.parse raw of
        Ok uid ->
            Ok uid

        Err _ ->
            Err UnitIdRefused


-- The unit page of `uid`, read from the session's one source slot, the same
-- `SelectedView` the queue card reads through, so the two pages never hold
-- two reads in flight. Only a view settled for `uid` itself shows; a read in
-- flight, or a view settled for another unit, is still loading.
unitPageOf : Uid -> SelectedView -> UnitPageState
unitPageOf uid state =
    case state of
        ViewShown shown ->
            if shown.unit.uid == uid then
                UnitLoaded shown

            else
                UnitLoading

        ViewMissing missing ->
            if missing == uid then
                UnitNotFound

            else
                UnitLoading

        ViewFailed failed e ->
            if failed == uid then
                UnitFailed e

            else
                UnitLoading

        ViewLoading _ ->
            UnitLoading

        NoneSelected ->
            UnitLoading


-- The session's one decision slot. A decision re-reads its source to re-prove
-- it, so at most one is in flight: a decision asked while one is saving
-- starts nothing. A saving decision records the epoch whose process runs it:
-- slot ownership is tied to process lifetime, so one owned by another epoch
-- is idle.
type DecisionSlot
    = DecisionIdle
    | DecisionSaving Uid Epoch


-- The slot holding a decision on `uid` run by process `epoch`; Nothing
-- while another decision of that process is saving.
startDecision : Epoch -> Uid -> DecisionSlot -> Maybe DecisionSlot
startDecision epoch uid slot =
    case slot of
        DecisionIdle ->
            Just (DecisionSaving uid epoch)

        DecisionSaving _ owner ->
            if owner == epoch then
                Nothing

            else
                Just (DecisionSaving uid epoch)


-- The decision on `uid` run by process `epoch` settled; a result for any
-- other uid or from any other process leaves the slot.
decisionSettled : Epoch -> Uid -> DecisionSlot -> DecisionSlot
decisionSettled epoch uid slot =
    case slot of
        DecisionSaving saving owner ->
            if saving == uid && owner == epoch then
                DecisionIdle

            else
                slot

        DecisionIdle ->
            DecisionIdle


-- The one-line text for a unit page that has no unit to show; Nothing once
-- the unit is loaded.
unitPageStatusText : UnitPageState -> Maybe String
unitPageStatusText state =
    case state of
        UnitLoading ->
            Just "Loading unit…"

        UnitNotFound ->
            Just "No unit with this id is in the index."

        UnitFailed e ->
            Just ("Unit load failed: " ++ SafeText.toString (SafeText.renderForeign (Error.toString e)))

        UnitIdRefused ->
            Just "This address does not name a unit."

        UnitLoaded _ ->
            Nothing


-- Why a unit's source is withheld, in place of the source and the decision
-- buttons; Nothing only for a verified view.
sourceStatusText : Index.SourceView -> Maybe String
sourceStatusText view =
    case view of
        Shown _ ->
            Nothing

        Stale Drifted ->
            Just "Source changed since it was indexed; re-run `ipe-index index` to review it."

        Stale (RangeOutOfFile r) ->
            Just ("The file now has " ++ String.fromInt r.lineCount ++ " lines, fewer than this unit's range; re-run `ipe-index index` to review it.")

        Stale UnverifiableHash ->
            Just "This unit's hash predates source attestation; re-run `ipe-index index` to verify it."

        Unreadable e ->
            Just ("Source unreadable: " ++ SafeText.toString (SafeText.renderForeign (Error.toString e)))

        TooLarge (SpanLines o) ->
            Just ("This unit spans " ++ String.fromInt o.lines ++ " lines, past the " ++ String.fromInt Index.viewLineCeiling ++ "-line review ceiling." ++ notShownRemedy)

        TooLarge (ViewBytes o) ->
            Just ("This unit's source is " ++ kibText (ByteSize.toBytes o.size) ++ ", past the " ++ kibText (ByteSize.toBytes Index.viewByteCeiling) ++ " review ceiling." ++ notShownRemedy)


-- What a reviewer can do about a view past a ceiling.
notShownRemedy : String
notShownRemedy =
    " It is not shown and cannot be decided here; split the unit to review it."


-- A byte count in whole KiB, rounded up, so a size one byte past a ceiling
-- never reads as the ceiling itself.
kibText : Int -> String
kibText n =
    String.fromInt ((n + 1023) // 1024) ++ " KiB"


-- One unit's view by uid through `Index.loadView`, the one source read the
-- unit page and the selected queue card share (a decided unit is not open,
-- so it queries units directly), on one connection from
-- `settings`. Nothing when no unit has this uid.
loadUnitView : IndexSettings -> Uid -> Task.Task Error (Maybe Index.UnitView)
loadUnitView settings uid =
    do
        conn <- Index.readConnection settings
        Index.loadView conn settings.roots uid


stateFromResult : Result Error QueuePage -> QueueState
stateFromResult result =
    case result of
        Ok page ->
            Loaded page

        Err e ->
            Failed e


-- The one-line text for a state that has no unit list to show; Nothing for a
-- loaded page that holds units.
queueStatusText : QueueState -> Maybe String
queueStatusText state =
    case state of
        Loading ->
            Just "Loading queue…"

        Failed e ->
            Just ("Queue failed to load: " ++ SafeText.toString (SafeText.renderForeign (Error.toString e)))

        Loaded page ->
            if page.total == 0 then
                Just "No units queued."

            else if List.isEmpty page.units then
                Just "No units to review on this page."

            else
                Nothing


-- The queue header: database name, size, and how many of the open units
-- this page shows.
pageHeaderText : QueuePage -> String
pageHeaderText page =
    String.concat
        [ SafeText.toString page.dbName
        , " · "
        , Format.byteSize page.dbBytes
        , " · showing "
        , String.fromInt (List.length page.units)
        , " of "
        , String.fromInt page.total
        ]


-- One page of the queue at `cursor`, as the review app sees it: the open
-- units of the index (its current units whose (uid, body_hash) pair has no
-- decision), with
--
--   * a unit decided on an older hash resurfaced at the head, flagged with
--     its previous review;
--   * never-seen units keeping the index's enqueue order after resurfaced
--     ones.
--
-- Only one page is classified per load, so the resurfaced-first order holds
-- within the page.
--
-- The page rows, the open count, the progress and the database size come
-- from one index read, trusted only when the `reviewed` copy's stamp equals
-- the review log's head: any other stamp (a failed drain, a replaced index
-- or review file, a decision another process recorded) rebuilds the copy
-- and reads once more, and a stamp that still differs fails the load rather
-- than show a stale queue. It never loops. The settings are the value
-- resolved at startup and every index read runs on the one read connection
-- opened from them.
loadPage : AppSettings -> Index.Cursor -> Task.Task Error QueuePage
loadPage settings cursor =
    do
        conn <- Index.readConnection settings.index
        db <- LibDb.openAt settings.review
        snap <- freshSnapshot settings.index conn db cursor
        units <- classify db snap.rows
        Task.succeed
            { units = units
            , total = snap.open
            , dbName = SafeText.renderForeign (Settings.dbFileName settings.index.db)
            , dbBytes = snap.bytes
            , next = nextCursor snap.rows
            , progress = { reviewed = snap.units - snap.open, total = snap.units }
            }


-- The index read at `cursor` under a current stamp: read as is, or once
-- more after one rebuild of the copy; a stamp still behind after the
-- rebuild is a failed load.
freshSnapshot : IndexSettings -> Db.Db -> Db.Db -> Index.Cursor -> Task.Task Error Index.Snapshot
freshSnapshot settings conn db cursor =
    do
        first <- currentSnapshot conn db cursor
        case first of
            Just fresh ->
                Task.succeed fresh

            Nothing ->
                do
                    resyncReviewed settings db
                    second <- currentSnapshot conn db cursor
                    case second of
                        Just fresh ->
                            Task.succeed fresh

                        Nothing ->
                            Task.fail (Error.conflict "the review progress copy is still behind the review database after a rebuild; reload")


-- The index read at `cursor`, Just when the copy's stamp is the review log's
-- current head. The head is read first: a decision recorded after it moves
-- the head on, so a match proves the copy holds every decision up to a head
-- the log really had.
currentSnapshot : Db.Db -> Db.Db -> Index.Cursor -> Task.Task Error (Maybe Index.Snapshot)
currentSnapshot conn db cursor =
    do
        head <- LibDb.currentHead db
        snap <- Index.readSnapshot conn cursor
        if snap.stamp == Just (Index.chainHeadText head) then
            Task.succeed (Just snap)

        else
            Task.succeed Nothing


-- A decided unit drained from the index, then the queue page at `cursor`
-- reloaded. The drain writes the index alone: the review database already
-- holds the decision, and `written` says how it moved the log's head, so
-- the drain moves the copy's stamp the same way.
drainThenLoad : AppSettings -> Index.Attested -> Index.Written -> Index.Cursor -> Task.Task Error QueuePage
drainThenLoad settings attested written cursor =
    Index.drainUnit settings.index attested written |> Task.andThen (\_ -> loadPage settings cursor)


-- A full page may have rows after it; a short page is the last one.
nextCursor : List Index.PendingRow -> Maybe Index.Cursor
nextCursor rows =
    if List.length rows < PageSize.toInt PageSize.queue then
        Nothing

    else
        rows
            |> List.reverse
            |> List.head
            |> Maybe.map (\r -> Index.After { enqueuedAt = r.enqueuedAt, uid = r.unit.uid })


classify : Db.Db -> List Index.PendingRow -> Task.Task Error (List QueuedUnit)
classify db rows =
    rows
        |> List.map (classifyUnit db)
        |> Task.sequence
        |> Task.map prioritize


-- An open unit with the latest review of its uid when that review is of an
-- older body: a review of the current body (one recorded after the page was
-- read) is not a previous review.
classifyUnit : Db.Db -> Index.PendingRow -> Task.Task Error QueuedUnit
classifyUnit db row =
    let
        unit =
            row.unit

        current =
            Index.storedHash unit.attested
    in
    do
        latest <- LibDb.findLatestForUid db unit.uid
        Task.succeed
            { unit = unit
            , change = row.change
            , changed = Maybe.andThen (previousReview current) latest
            }


previousReview : String -> LibDb.ReviewRow -> Maybe LibDb.ReviewRow
previousReview current row =
    if row.bodyHash == current then
        Nothing

    else
        Just row


prioritize : List QueuedUnit -> List QueuedUnit
prioritize classified =
    let
        ( changed, fresh ) =
            partition classified
    in
    changed ++ fresh


-- Stable partition: resurfaced (changed) units first, fresh units after,
-- each group keeping the index's enqueue order.
partition : List QueuedUnit -> ( List QueuedUnit, List QueuedUnit )
partition qs =
    List.foldr
        (\q ( changed, fresh ) ->
            if q.changed == Nothing then
                ( changed, q :: fresh )

            else
                ( q :: changed, fresh )
        )
        ( [], [] )
        qs
