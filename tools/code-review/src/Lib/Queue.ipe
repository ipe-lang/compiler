import Lib.Uid as Uid exposing (Uid)
import Lib.UnitName as UnitName exposing (SignedName(..), UnitName)


-- An open unit plus its resurfacing state. `change` is what the index
-- recorded about its current body. `changed` is Just the previous counted
-- review when this uid was already decided on an OLDER body hash: the author
-- edited the code after the review, so the unit must be reviewed again.
-- `standing` is what the review log holds for its current body: a unit
-- reopened because its decision does not count says why.
type alias QueuedUnit =
    { unit : Index.Unit
    , change : Index.Change
    , changed : Maybe LibDb.VerifiedRow
    , standing : Standing
    }


-- Where a unit's current body stands in the review log, classified as the
-- History classifies its entries: no entry, a decision that counts, or an
-- entry that does not count and why.
type Standing
    = Undecided
    | Decided LibDb.StoredDecision
    | NotCounted LibDb.Unverified


standingOf : Maybe LibDb.ReviewEntry -> Standing
standingOf entry =
    case entry of
        Just found ->
            case found of
                Verified row ->
                    Decided (LibDb.verifiedDecision row)

                Unverified row ->
                    NotCounted row.why

        Nothing ->
            Undecided


-- The unit page's read of its shown body's standing, keyed by the uid and
-- body hash it was read for, so a read for another unit or an older body
-- never stands for the one shown.
type StandingRead
    = StandingUnread
    | StandingShown Uid String Standing
    | StandingFailed Uid String LoadFailure


-- The standing of `uid`'s body `bodyHash`, under one walk of the review log.
loadStanding : AppSettings -> Uid -> String -> Task.Task Error Standing
loadStanding settings uid bodyHash =
    do
        db <- LibDb.openAt settings.review
        state <- LibDb.logVerdict settings.key db
        entry <- LibDb.findDecision (LibDb.verifier state) db uid bodyHash
        Task.succeed (standingOf entry)


standingArrived : Uid -> String -> Result LoadFailure Standing -> StandingRead
standingArrived uid bodyHash result =
    case result of
        Ok standing ->
            StandingShown uid bodyHash standing

        Err e ->
            StandingFailed uid bodyHash e


-- The read's result for `unit`'s current body, Nothing while none is held.
standingFor : Index.Unit -> StandingRead -> Maybe (Result LoadFailure Standing)
standingFor unit read =
    case read of
        StandingUnread ->
            Nothing

        StandingShown uid bodyHash standing ->
            if uid == unit.uid && bodyHash == Index.storedHash unit.attested then
                Just (Ok standing)

            else
                Nothing

        StandingFailed uid bodyHash e ->
            if uid == unit.uid && bodyHash == Index.storedHash unit.attested then
                Just (Err e)

            else
                Nothing


-- What a unit is called on screen: its kind and qualified name, plus as
-- much of its location as tells it apart from every other unit on the same
-- page. Kept as separate typed fields so no two parts can run together.
type alias UnitLabel =
    { kind : Label
    , name : Label
    , place : Place
    }


-- `Named`: no other unit on the page shares the kind and name. `At`: one
-- does, but none also starts at the same path and line. `AtUnit`: even the
-- path and line are shared, so the uid, unique to a unit, settles it.
type Place
    = Named
    | At Label Int
    | AtUnit Label Int Uid


-- The one label builder: every unit label on screen comes from a unit's
-- name (`UnitName`: a live unit's, or one a verified review row signed),
-- never from a raw string or a uid.
unitLabel : Place -> UnitName -> UnitLabel
unitLabel place name =
    { kind = UnitName.kind name, name = UnitName.qualified name, place = place }


-- Each unit of a page with its label; no two labels of one page are equal.
queueLabels : List QueuedUnit -> List ( QueuedUnit, UnitLabel )
queueLabels units =
    let
        tallies =
            talliesOf (List.map (\q -> Index.unitName q.unit) units)
    in
    List.map
        (\q ->
            let
                name =
                    Index.unitName q.unit
            in
            ( q, unitLabel (placeIn tallies name) name )
        )
        units


-- The distinct units of one page under each collision key, counted once
-- for the page so every label reads the same counts.
type alias Tallies =
    { names : Dict String (List Uid)
    , places : Dict String (List Uid)
    }


talliesOf : List UnitName -> Tallies
talliesOf names =
    { names = tally nameKey names, places = tally placeKey names }


placeIn : Tallies -> UnitName -> Place
placeIn tallies name =
    if shared tallies.names (nameKey name) then
        if shared tallies.places (placeKey name) then
            AtUnit (UnitName.path name) (UnitName.line name) (UnitName.uid name)

        else
            At (UnitName.path name) (UnitName.line name)

    else
        Named


-- The distinct uids under each key: one unit named twice on a page (two
-- decisions of it in History) is one unit, never a collision with itself.
tally : (UnitName -> String) -> List UnitName -> Dict String (List Uid)
tally key names =
    List.foldl (\name seen -> Dict.update (key name) (withUid (UnitName.uid name)) seen) Dict.empty names


withUid : Uid -> Maybe (List Uid) -> Maybe (List Uid)
withUid unit seen =
    case seen of
        Nothing ->
            Just [ unit ]

        Just uids ->
            if List.member unit uids then
                Just uids

            else
                Just (unit :: uids)


shared : Dict String (List Uid) -> String -> Bool
shared counts key =
    List.length (Maybe.withDefault [] (Dict.get key counts)) > 1


-- Collision keys over length-prefixed parts of the labels as shown, so no
-- two different part lists spell the same key, and two units whose labels
-- read alike (two long names cut to the same marker among them) count as
-- shared and are told apart further.
nameKey : UnitName -> String
nameKey name =
    keyPart (Label.key (UnitName.kind name)) ++ keyPart (Label.key (UnitName.qualified name))


placeKey : UnitName -> String
placeKey name =
    nameKey name ++ keyPart (Label.key (UnitName.path name)) ++ keyPart (String.fromInt (UnitName.line name))


keyPart : String -> String
keyPart part =
    String.fromInt (String.length part) ++ ":" ++ part


-- One loaded page of the queue. `total` counts the whole queue (never this
-- page's length); `unbound` counts the index's units under a tag no
-- configured root binds, which are in neither the queue nor its progress;
-- `next` is the cursor of the following page, Nothing on the last page;
-- `dbName` is the index file's name, rendered once; `log` is the review
-- log's verdict the page was read under. `refusals` are the first open
-- files the index could not review and `refusalsOpen` counts every open
-- one: open review work the page shows apart from its units.
-- `refusalsUnbound` counts the unreviewable files under a tag no
-- configured root binds, said beside the unbound units.
type alias QueuePage =
    { units : List QueuedUnit
    , total : Int
    , unbound : Int
    , dbName : SafeText
    , dbBytes : Int
    , next : Maybe Index.Cursor
    , progress : Progress
    , log : LogShown
    , refusals : List Index.RefusalRow
    , refusalsOpen : Int
    , refusalsUnbound : Int
    }


-- Review progress over the index as it stands, never from a session:
-- `total` counts the index's units and unreviewable files under a bound
-- tag and `reviewed` those not open, so `reviewed` reaches `total` only
-- when every unit's current (uid, body_hash) pair and every unreviewable
-- file's (uid, digest) pair has a decision.
-- Both come from the same read as the page's rows, after the `reviewed`
-- copy is proved current against the review log's head. Deciding a unit
-- moves it from open to reviewed, so `total` holds while the queue drains,
-- and a reload or a second tab reads the same numbers.
type alias Progress =
    { reviewed : Int
    , total : Int
    }


-- How far one rebuild of the `reviewed` copy may read: `pageCeiling` pages
-- of at most `pageSize` decided pairs each. Opaque: built only by
-- `makeResyncBound` and `resyncBound`, so a ceiling below one page, or one
-- whose decision count or loop limit passes the largest `Int`, has no
-- representation and no rebuild re-checks it.
type ResyncBound
    = ResyncBound { pageSize : PageSize, pageCeiling : Int }


-- The largest `Int`.
maxInt : Int
maxInt =
    9223372036854775807


-- `pageCeiling` pages of `size` pairs as a bound. A ceiling below one is
-- refused, and so is one whose `pageCeiling x size` decisions or whose loop
-- limit `pageCeiling + 1` would pass the largest `Int`; the check divides,
-- so it never multiplies past the range it guards.
makeResyncBound : PageSize -> Int -> Result Error ResyncBound
makeResyncBound size pageCeiling =
    if pageCeiling < 1 then
        Err (Error.invalidInput "a review progress rebuild needs a page ceiling of at least 1")

    else if pageCeiling > (maxInt - 1) // PageSize.toInt size then
        Err (Error.invalidInput "a review progress rebuild's page ceiling times its page size passes the largest integer")

    else
        Ok (ResyncBound { pageSize = size, pageCeiling = pageCeiling })


-- The most review-log pages each pass of one rebuild reads: a bound on one
-- rebuild transaction's work (`pageCeiling x PageSize.pairs` rows), never a
-- stack limit — every walk runs at constant stack depth through `Task.loop`.
resyncPageCeiling : Int
resyncPageCeiling =
    LibDb.logPageCeiling


resyncBound : ResyncBound
resyncBound =
    ResyncBound { pageSize = PageSize.pairs, pageCeiling = resyncPageCeiling }


boundPageSize : ResyncBound -> PageSize
boundPageSize bound =
    case bound of
        ResyncBound b ->
            b.pageSize


boundCeiling : ResyncBound -> Int
boundCeiling bound =
    case bound of
        ResyncBound b ->
            b.pageCeiling


-- The `reviewed` copy rebuilt from the review log under `key`: the log's
-- verdict is taken, then one index transaction empties the copy and, only
-- on a proven head, drains every row up to it whose mac verifies, so a
-- pair's undrained queue row leaves too. The copy is stamped with that head
-- and the verdict, signed under the key, so a log not proven drains nothing
-- and every page shows why. With no key nothing is drained
-- and the copy is stamped read-only. A decision recorded after the verdict
-- moves the head past that stamp, so the next load rebuilds again rather
-- than trust a copy that may lack it. Returns the count of pairs copied.
resyncReviewed : ReviewKey -> IndexSettings -> Db.Db -> Task.Task Error Int
resyncReviewed key settings db =
    resyncReviewedWithin key settings resyncBound db


-- `resyncReviewed` reading at most the bound's page ceiling of pages of its
-- page size of review-log rows in each pass. A review log holding more
-- refuses the rebuild and rolls it back, leaving the copy and its stamp as
-- they were.
resyncReviewedWithin : ReviewKey -> IndexSettings -> ResyncBound -> Db.Db -> Task.Task Error Int
resyncReviewedWithin key settings bound db =
    do
        state <- LibDb.logVerdictWithin key db (boundPageSize bound) (boundCeiling bound) (resyncCeilingRefusal bound)
        rebuildUnder settings bound state db


-- The `reviewed` copy rebuilt in one index transaction under a verdict
-- already taken: emptied, then refilled from the log only on a proven head,
-- and stamped for that verdict. No walk of its own.
rebuildUnder : IndexSettings -> ResyncBound -> LibDb.LogState -> Db.Db -> Task.Task Error Int
rebuildUnder settings bound state db =
    Index.rebuildReviewed settings (\conn -> refillLog bound state db conn)


refillLog : ResyncBound -> LibDb.LogState -> Db.Db -> Db.Db -> Task.Task Error ( Index.Stamp, Int )
refillLog bound state db conn =
    case LibDb.stateVerdict state of
        Proven proven ->
            refillPages (LibDb.verifier state) bound proven db conn
                |> Task.map (\copied -> ( LibDb.copyStamp state, copied ))

        Broken _ ->
            Task.succeed ( LibDb.copyStamp state, 0 )

        KeyMismatch ->
            Task.succeed ( LibDb.copyStamp state, 0 )

        Unkeyed ->
            Task.succeed ( LibDb.copyStamp state, 0 )


-- The state one `refillPages` step carries: how many pages have been read,
-- how many pairs have been drained so far, and the seq the next page reads
-- after.
type alias RefillState =
    { pagesRead : Int
    , copied : Int
    , after : Int
    }


-- The counted rows of the review log drained at constant stack depth,
-- however many pages it takes. The loop's own ceiling, the page ceiling plus
-- one, is an unreachable backstop (defence in depth): the step itself
-- refuses a non-empty page once `pagesRead` reaches the page ceiling, so the
-- loop's own limit never has a chance to fire.
refillPages : LibDb.Verifier -> ResyncBound -> LibDb.ProvenHead -> Db.Db -> Db.Db -> Task.Task Error Int
refillPages verify bound proven db conn =
    Task.loop (boundCeiling bound + 1) { pagesRead = 0, copied = 0, after = 0 } (refillStep verify bound proven db conn)


-- One page of review-log rows after `state.after`, up to the proven head: an empty
-- page ends the walk with the pairs copied so far; a non-empty page past the
-- ceiling fails the whole rebuild; otherwise the page's verified rows drain
-- on `conn`, then a short page ends the walk and a full page continues from
-- its last row.
refillStep : LibDb.Verifier -> ResyncBound -> LibDb.ProvenHead -> Db.Db -> Db.Db -> RefillState -> Task.Task Error (Task.Step RefillState Int)
refillStep verify bound proven db conn state =
    do
        rows <- LibDb.logRowsAfter db (boundPageSize bound) proven state.after
        if List.isEmpty rows then
            Task.succeed (Task.Done state.copied)

        else if state.pagesRead >= boundCeiling bound then
            Task.fail (resyncCeilingRefusal bound)

        else
            let
                counted =
                    LibDb.countedRows verify rows
            in
            do
                counted
                    |> List.map (\row -> Index.drainDecided conn (LibDb.verifiedPair row))
                    |> Task.sequence
                let
                    copied =
                        state.copied + List.length counted
                in
                if List.length rows < PageSize.toInt (boundPageSize bound) then
                    Task.succeed (Task.Done copied)

                else
                    Task.succeed
                        (Task.Continue
                            { pagesRead = state.pagesRead + 1
                            , copied = copied
                            , after = Maybe.withDefault state.after (LibDb.lastSeq rows)
                            }
                        )


resyncCeilingRefusal : ResyncBound -> Error
resyncCeilingRefusal bound =
    Error.limitExceeded
        ("the review database holds more than "
            ++ String.fromInt (boundCeiling bound * PageSize.toInt (boundPageSize bound))
            ++ " decisions, past the "
            ++ String.fromInt (boundCeiling bound)
            ++ "-page ceiling of a review progress rebuild; the progress copy is left unchanged"
        )


-- The queue view's state. An empty queue is only `Loaded` with `total == 0`,
-- so a load in flight or a failed load can never render as empty.
type QueueState
    = Loading
    | Loaded QueuePage
    | Failed LoadFailure


-- The number of one load of a page slot (the queue, a History page, a unit
-- page). Each load a slot starts takes the ticket after the slot's latest,
-- and a result settles the slot only under the slot's latest ticket, so a
-- slower earlier load never replaces the result of a later one. Opaque:
-- built only by `firstTicket` and `nextTicket`.
type LoadTicket
    = LoadTicket Int


firstTicket : LoadTicket
firstTicket =
    LoadTicket 0


nextTicket : LoadTicket -> LoadTicket
nextTicket ticket =
    case ticket of
        LoadTicket n ->
            LoadTicket (n + 1)


-- True when a result carrying `load` is the slot's latest load.
isCurrentLoad : LoadTicket -> LoadTicket -> Bool
isCurrentLoad load latest =
    ticketNumber load == ticketNumber latest


ticketNumber : LoadTicket -> Int
ticketNumber ticket =
    case ticket of
        LoadTicket n ->
            n


-- A review as the History page shows it: the review entry, counted or not,
-- and what it is called.
type alias HistoryRow =
    { entry : LibDb.ReviewEntry
    , label : HistoryLabel
    }


-- What a History row is called. A verified row is called by the name its
-- mac covers, the subject as it was decided, whether or not the index still
-- holds it; any other row only by the live unit or unreviewable file the
-- index holds under its uid, never by text the row itself carries. A row
-- with neither is `Unnamed`. Units are labelled as a queue page labels
-- them, against every other unit the History page names.
type HistoryLabel
    = Labelled UnitLabel Presence
    | FileLabelled Label Presence
    | Unnamed


-- Whether the index still holds a History row's subject under its uid.
type Presence
    = Indexed
    | NoLongerIndexed


-- One loaded History page: its rows, the cursor it was read from, the
-- cursor of the page after it (Nothing on the last page), and the review
-- log's verdict every row was classified under.
type alias HistoryPage =
    { rows : List HistoryRow
    , at : LibDb.HistoryCursor
    , next : Maybe LibDb.HistoryCursor
    , log : LogShown
    }


-- The History view's state. An empty history is only `HistoryLoaded` with
-- no rows from `HistoryStart`, so a load in flight or a failed load can
-- never render as "no reviews".
type HistoryState
    = HistoryLoading
    | HistoryLoaded HistoryPage
    | HistoryFailed LoadFailure


historyStateFromResult : Result LoadFailure HistoryPage -> HistoryState
historyStateFromResult result =
    case result of
        Ok page ->
            HistoryLoaded page

        Err e ->
            HistoryFailed e


-- The one-line text for a History state that has no rows to show; Nothing
-- for a loaded page that holds rows.
historyStatusText : HistoryState -> Maybe SafeText
historyStatusText state =
    case state of
        HistoryLoading ->
            Just (SafeText.literal "Loading history…")

        HistoryFailed failure ->
            Just (SafeText.literal ("History load failed: " ++ Failure.loadFailureText failure))

        HistoryLoaded page ->
            if List.isEmpty page.rows then
                case page.at of
                    HistoryStart ->
                        Just (SafeText.literal "No reviews yet.")

                    HistoryAfter _ _ ->
                        Just (SafeText.literal "No more reviews.")

                    HistoryLegacyAfter _ _ _ ->
                        Just (SafeText.literal "No more reviews.")

            else
                Nothing


-- One History page from `cursor`, newest first, each row classified under
-- the review log's verdict, taken once for the load with the `reviewed`
-- copy proved current for it (rebuilt once when its stamp is not), and
-- named through `historyRows` against the units and unreviewable files the
-- index db named by `settings` holds under the page's uids. At most
-- `PageSize.history` rows are read, and two index reads name them all.
loadHistoryPage : AppSettings -> LibDb.HistoryCursor -> Task.Task Error HistoryPage
loadHistoryPage settings cursor =
    do
        db <- LibDb.openAt settings.review
        conn <- Index.readConnection settings.index
        state <- freshStatus settings conn db
        page <- LibDb.historyPage (LibDb.verifier state) db PageSize.history cursor
        units <- Index.liveUnits conn settings.index.roots (distinctUids page.rows)
        files <- Index.liveFiles conn settings.index.roots (distinctUids page.rows)
        Task.succeed { rows = historyRows units files page.rows, at = cursor, next = page.next, log = LibDb.logShown state }


distinctUids : List LibDb.ReviewEntry -> List Uid
distinctUids entries =
    List.foldr
        (\subject uids ->
            if List.member subject uids then
                uids

            else
                subject :: uids
        )
        []
        (List.filterMap entryUid entries)


-- A History row's subject before its label: a unit's name or a file's path,
-- with whether the index still holds it.
type Subject
    = UnitSubject UnitName Presence
    | FileSubject Label Presence
    | NoSubject


-- Each entry with its label, every unit subject placed against the others
-- of the page.
historyRows : List Index.Unit -> List ( Uid, Label ) -> List LibDb.ReviewEntry -> List HistoryRow
historyRows units files entries =
    let
        subjects =
            List.map (\entry -> ( entry, subjectOf units files entry )) entries

        tallies =
            talliesOf (List.filterMap (\( _, subject ) -> subjectUnit subject) subjects)
    in
    List.map (\( entry, subject ) -> { entry = entry, label = labelOf tallies subject }) subjects


subjectOf : List Index.Unit -> List ( Uid, Label ) -> LibDb.ReviewEntry -> Subject
subjectOf units files entry =
    case entry of
        Verified row ->
            let
                subject =
                    LibDb.verifiedUid row

                presence =
                    presenceOf units files subject
            in
            case UnitName.fromRecorded subject (LibDb.verifiedName row) of
                UnitNamed name ->
                    UnitSubject name presence

                FileNamed path ->
                    FileSubject path presence

        Unverified row ->
            case row.uid of
                Just subject ->
                    liveSubject units files subject

                Nothing ->
                    NoSubject


-- The subject the index holds under `subject`: its unit, else its
-- unreviewable file, else none.
liveSubject : List Index.Unit -> List ( Uid, Label ) -> Uid -> Subject
liveSubject units files subject =
    case List.head (List.filter (\unit -> unit.uid == subject) units) of
        Just unit ->
            UnitSubject (Index.unitName unit) Indexed

        Nothing ->
            case List.head (List.filter (\( fileUid, _ ) -> fileUid == subject) files) of
                Just ( _, path ) ->
                    FileSubject path Indexed

                Nothing ->
                    NoSubject


presenceOf : List Index.Unit -> List ( Uid, Label ) -> Uid -> Presence
presenceOf units files subject =
    if List.any (\unit -> unit.uid == subject) units || List.any (\( fileUid, _ ) -> fileUid == subject) files then
        Indexed

    else
        NoLongerIndexed


subjectUnit : Subject -> Maybe UnitName
subjectUnit subject =
    case subject of
        UnitSubject name _ ->
            Just name

        FileSubject _ _ ->
            Nothing

        NoSubject ->
            Nothing


labelOf : Tallies -> Subject -> HistoryLabel
labelOf tallies subject =
    case subject of
        UnitSubject name presence ->
            Labelled (unitLabel (placeIn tallies name) name) presence

        FileSubject path presence ->
            FileLabelled path presence

        NoSubject ->
            Unnamed


-- The unit id an entry names: Nothing for a row whose uid column holds no
-- unit id, which names no subject.
entryUid : LibDb.ReviewEntry -> Maybe Uid
entryUid entry =
    case entry of
        Verified row ->
            Just (LibDb.verifiedUid row)

        Unverified row ->
            row.uid


-- The review log's verdict, taken once for the load, with the `reviewed`
-- copy's stamp current for it: as read, or after one rebuild of the copy
-- under that same verdict; a stamp still not current after the rebuild is a
-- failed load. The verdict is taken before the stamp is read: a decision
-- recorded after it moves the head on, so a match proves the copy holds
-- every counted decision up to a head the log really had. One walk of the
-- log per load.
freshStatus : AppSettings -> Db.Db -> Db.Db -> Task.Task Error LibDb.LogState
freshStatus settings conn db =
    do
        state <- LibDb.logVerdict settings.key db
        first <- Index.readStamp conn
        if LibDb.copyCurrent state first then
            Task.succeed state

        else
            do
                rebuildUnder settings.index resyncBound state db
                second <- Index.readStamp conn
                if LibDb.copyCurrent state second then
                    Task.succeed state

                else
                    Task.fail stillBehind


stillBehind : Error
stillBehind =
    Error.conflict "the review progress copy is still behind the review database after a rebuild; reload"


-- The banner a page shows when the review log is not proven under the
-- server's key: where it breaks, or that another key signed it; Nothing for a
-- proven log and for a server with no key.
chainBanner : LogShown -> Maybe SafeText
chainBanner shown =
    case shown of
        ShownBroken (BreaksAt n) ->
            Just (SafeText.literal ("The review log's chain breaks at entry " ++ String.fromInt n ++ ": a decision was removed, reordered or replaced outside this tool."))

        ShownBroken (PastHead n) ->
            Just (SafeText.literal ("The review log holds " ++ pastHeadText n ++ " past its head: a decision was added outside this tool."))

        ShownBroken (BeforeFirst n) ->
            Just (SafeText.literal ("The review log holds " ++ pastHeadText n ++ " before its first: a decision was added outside this tool."))

        ShownBroken (RepeatsAt n) ->
            Just (SafeText.literal ("The review log's entry " ++ String.fromInt n ++ " decides a pair an earlier entry decided: a decision was added outside this tool."))

        ShownKeyMismatch ->
            Just (SafeText.literal ("The review log was signed by a different " ++ ReviewKey.keyVar ++ ": no decision in it counts."))

        ShownProven ->
            Nothing

        ShownUnkeyed ->
            Nothing


pastHeadText : Int -> String
pastHeadText n =
    if n == 1 then
        "1 entry"

    else
        String.fromInt n ++ " entries"


-- The one way a decision is recorded: only under a signing key, the
-- `MacKey` a read-only server does not hold; only a shown source can be
-- decided, since only a verified view holds a `ShownSource`; and only after
-- `Index.reverify` re-proves it, so the hash written is the hash of the
-- bytes the reviewer saw. A refusal either step decides is a value.
decide : MacKey -> IndexSettings -> Db.Db -> Index.ShownSource -> LibDb.Decision -> Task.Task Error (Result DecideRefusal ( Index.Attested, Index.Written ))
decide macKey settings db shown decision =
    do
        reverified <- Index.reverify settings shown
        case reverified of
            Ok attested ->
                LibDb.insertDecision macKey db attested decision
                    |> Task.map (Result.map (\written -> ( attested, written )))

            Err refusal ->
                Task.succeed (Err refusal)


-- The one way a decision on an unreviewable file is recorded, `decide`'s
-- counterpart: only under a signing key, the `MacKey` a read-only server
-- does not hold, and only after `Index.reverifyRefusal` re-proves the row
-- still carries `digest`, so the hash written is the digest the reviewer was
-- shown. A refusal either step decides is a value.
decideRefusal : MacKey -> IndexSettings -> Db.Db -> Uid -> Index.RefusalDigest -> LibDb.Decision -> Task.Task Error (Result DecideRefusal ( Index.Attested, Index.Written ))
decideRefusal macKey settings db uid digest decision =
    do
        reverified <- Index.reverifyRefusal settings uid digest
        case reverified of
            Ok attested ->
                LibDb.insertDecision macKey db attested decision
                    |> Task.map (Result.map (\written -> ( attested, written )))

            Err refusal ->
                Task.succeed (Err refusal)


-- The session's one source slot, shared by the selected queue card and the
-- unit page: nothing selected, one read in flight
-- (with the unit wanted once it returns, when the selection moved during the
-- read), the loaded view, no unit with the read's uid, or a failed read. At
-- most one read is in flight: a selection made during a read only records
-- `wanted`, and a response for any uid but the in-flight one is dropped.
-- `fresh` is False once the queue page reloaded or cleared during the read,
-- so its result predates the page and never settles the view: the in-flight
-- unit selected again is read afresh, and with nothing wanted the result is
-- dropped. `owner` is the epoch whose process runs the read: slot ownership
-- is tied to process lifetime, so a read owned by another epoch is
-- `NoneSelected` to every transition.
type SelectedView
    = NoneSelected
    | ViewLoading { uid : Uid, wanted : Maybe Uid, fresh : Bool, owner : Epoch }
    | ViewShown Index.UnitView
    | ViewMissing Uid
    | ViewFailed Uid LoadFailure


-- The slot as process `epoch` sees it: a read owned by another epoch has no
-- completion left to settle it, so it is `NoneSelected`.
ownedView : Epoch -> SelectedView -> SelectedView
ownedView epoch state =
    case state of
        ViewLoading loading ->
            if loading.owner == epoch then
                state

            else
                NoneSelected

        ViewShown _ ->
            state

        NoneSelected ->
            state

        ViewMissing _ ->
            state

        ViewFailed _ _ ->
            state


-- `uid` selected in process `epoch`, with the uid to read next, if any.
-- During a read only the wanted unit is recorded; the shown unit selected
-- again reads nothing.
selectView : Epoch -> Uid -> SelectedView -> ( SelectedView, Maybe Uid )
selectView epoch uid state =
    case ownedView epoch state of
        ViewLoading loading ->
            ( ViewLoading { uid = loading.uid, wanted = wantedAfter loading.uid loading.fresh uid, fresh = loading.fresh, owner = loading.owner }, Nothing )

        ViewShown shown ->
            if shown.unit.uid == uid then
                ( ViewShown shown, Nothing )

            else
                startView epoch uid

        NoneSelected ->
            startView epoch uid

        ViewMissing _ ->
            startView epoch uid

        ViewFailed _ _ ->
            startView epoch uid


-- `uid` selected after the queue page reloaded, so its view is read afresh
-- even when it is the one shown; during a read it is read once that read
-- returns.
reloadView : Epoch -> Uid -> SelectedView -> ( SelectedView, Maybe Uid )
reloadView epoch uid state =
    case ownedView epoch state of
        ViewLoading loading ->
            ( ViewLoading { uid = loading.uid, wanted = Just uid, fresh = False, owner = loading.owner }, Nothing )

        ViewShown _ ->
            startView epoch uid

        NoneSelected ->
            startView epoch uid

        ViewMissing _ ->
            startView epoch uid

        ViewFailed _ _ ->
            startView epoch uid


-- No unit to select. A read in flight stays recorded, with nothing wanted
-- after it, so no second read can start beside it, and its result is
-- dropped when it returns.
clearView : Epoch -> SelectedView -> SelectedView
clearView epoch state =
    case ownedView epoch state of
        ViewLoading loading ->
            ViewLoading { uid = loading.uid, wanted = Nothing, fresh = False, owner = loading.owner }

        ViewShown _ ->
            NoneSelected

        NoneSelected ->
            NoneSelected

        ViewMissing _ ->
            NoneSelected

        ViewFailed _ _ ->
            NoneSelected


-- The read of `uid` run by process `epoch` returned with `result`: when
-- another unit was selected meanwhile its read starts, otherwise the result
-- settles the view. A response for any uid but the in-flight one, or from
-- any process but the read's owner, changes nothing.
viewArrived : Epoch -> Uid -> Result LoadFailure (Maybe Index.UnitView) -> SelectedView -> ( SelectedView, Maybe Uid )
viewArrived epoch uid result state =
    case state of
        ViewLoading loading ->
            if loading.uid /= uid || loading.owner /= epoch then
                ( state, Nothing )

            else
                case loading.wanted of
                    Just next ->
                        startView epoch next

                    Nothing ->
                        if loading.fresh then
                            ( settledView uid result, Nothing )

                        else
                            ( NoneSelected, Nothing )

        ViewShown _ ->
            ( state, Nothing )

        NoneSelected ->
            ( state, Nothing )

        ViewMissing _ ->
            ( state, Nothing )

        ViewFailed _ _ ->
            ( state, Nothing )


startView : Epoch -> Uid -> ( SelectedView, Maybe Uid )
startView epoch uid =
    ( ViewLoading { uid = uid, wanted = Nothing, fresh = True, owner = epoch }, Just uid )


-- The unit wanted after the in-flight read of `inFlight` when `uid` is
-- selected: nothing when the in-flight unit is selected again and its read
-- is fresh; a read that predates the page reads that unit again.
wantedAfter : Uid -> Bool -> Uid -> Maybe Uid
wantedAfter inFlight fresh uid =
    if inFlight == uid && fresh then
        Nothing

    else
        Just uid


settledView : Uid -> Result LoadFailure (Maybe Index.UnitView) -> SelectedView
settledView uid result =
    case result of
        Ok (Just loaded) ->
            ViewShown loaded

        Ok Nothing ->
            ViewMissing uid

        Err e ->
            ViewFailed uid e


-- The loaded view of the selected unit `uid`; Nothing while it loads, when
-- its read failed or found no unit, or when the view is another unit's.
selectedViewOf : Uid -> SelectedView -> Maybe Index.UnitView
selectedViewOf uid state =
    case state of
        ViewShown shown ->
            if shown.unit.uid == uid then
                Just shown

            else
                Nothing

        ViewLoading _ ->
            Nothing

        NoneSelected ->
            Nothing

        ViewMissing _ ->
            Nothing

        ViewFailed _ _ ->
            Nothing


-- The one source a decision on `uid` may be made on: the selected unit's
-- verified view. Nothing for a withheld view, a view not loaded, or another
-- unit's view, so nothing else can reach `decide`.
decidableSource : Uid -> SelectedView -> Maybe Index.ShownSource
decidableSource uid state =
    case selectedViewOf uid state of
        Just loaded ->
            case loaded.view of
                Shown shown ->
                    Just shown

                Stale _ ->
                    Nothing

                Unreadable _ ->
                    Nothing

                TooLarge _ ->
                    Nothing

        Nothing ->
            Nothing


-- The one-line text in place of the selected unit's source while it has no
-- loaded view; Nothing once the view of `uid` is loaded.
selectedViewStatusText : Uid -> SelectedView -> Maybe SafeText
selectedViewStatusText uid state =
    case state of
        ViewShown shown ->
            if shown.unit.uid == uid then
                Nothing

            else
                Just (SafeText.literal "Loading source…")

        ViewLoading _ ->
            Just (SafeText.literal "Loading source…")

        NoneSelected ->
            Just (SafeText.literal "Loading source…")

        ViewMissing _ ->
            Just (SafeText.literal "This unit is no longer in the index.")

        ViewFailed _ failure ->
            Just (SafeText.literal ("Source load failed: " ++ Failure.loadFailureText failure))


-- The unit page: loading, the unit with its source and links, no such unit,
-- a failed load, or an address whose unit id is not one. A missing unit is
-- its own state, never shown as still loading.
type UnitPageState
    = UnitLoading
    | UnitLoaded Index.UnitView
    | UnitNotFound
    | UnitFailed LoadFailure
    | UnitIdRefused


-- The unit id a unit page's address names, parsed once: an address whose
-- segment is not a unit id is `UnitIdRefused`, so it reaches no query.
unitPageEntry : String -> Result UnitPageState Uid
unitPageEntry raw =
    case Uid.parse raw of
        Ok uid ->
            Ok uid

        Err _ ->
            Err UnitIdRefused


-- The unit page of `uid`, read from the session's one source slot, the same
-- `SelectedView` the queue card reads through, so the two pages never hold
-- two reads in flight. Only a view settled for `uid` itself shows; a read in
-- flight, or a view settled for another unit, is still loading.
unitPageOf : Uid -> SelectedView -> UnitPageState
unitPageOf uid state =
    case state of
        ViewShown shown ->
            if shown.unit.uid == uid then
                UnitLoaded shown

            else
                UnitLoading

        ViewMissing missing ->
            if missing == uid then
                UnitNotFound

            else
                UnitLoading

        ViewFailed failed e ->
            if failed == uid then
                UnitFailed e

            else
                UnitLoading

        ViewLoading _ ->
            UnitLoading

        NoneSelected ->
            UnitLoading


-- What a decision is asked on: a queued unit, decided on its shown source,
-- or an unreviewable file the loaded page lists, decided on its digest.
type DecisionTarget
    = OnUnit
    | OnRefusal


-- A row the shown queue page draws decision controls for, with what a
-- decision on it is asked on. Only `decidableRow` builds one, so the view
-- draws a row's controls, and the refusal panel opens, by one predicate.
type DecidableRow
    = DecidableRow Uid DecisionTarget


rowUid : DecidableRow -> Uid
rowUid row =
    case row of
        DecidableRow uid _ ->
            uid


rowTarget : DecidableRow -> DecisionTarget
rowTarget row =
    case row of
        DecidableRow _ target ->
            target


-- The row `uid` as the queue page shows it with card `selected` selected
-- and `view` in the source slot, when it offers a decision: an
-- acknowledgeable file the page lists, or the selected card's unit with its
-- verified source shown, each over a proven log. Nothing for a withheld
-- source, a file no decision binds, a log that records no decision, a page
-- not loaded, or a uid the page does not show.
decidableRow : Int -> QueueState -> SelectedView -> Uid -> Maybe DecidableRow
decidableRow selected state view uid =
    case state of
        Loaded page ->
            case page.log of
                ShownProven ->
                    case List.find (\row -> row.uid == uid) page.refusals of
                        Just row ->
                            Maybe.map (\_ -> DecidableRow uid OnRefusal) row.digest

                        Nothing ->
                            case List.head (List.drop selected page.units) of
                                Just q ->
                                    if q.unit.uid == uid then
                                        Maybe.map (\_ -> DecidableRow uid OnUnit) (decidableSource uid view)

                                    else
                                        Nothing

                                Nothing ->
                                    Nothing

                ShownBroken _ ->
                    Nothing

                ShownKeyMismatch ->
                    Nothing

                ShownUnkeyed ->
                    Nothing

        Loading ->
            Nothing

        Failed _ ->
            Nothing


-- The row `uid` when it offers a decision on `target` by `decidableRow`,
-- the predicate the view draws the row's controls by, or why a decision on
-- it is refused before it starts: a click that arrived after its row
-- stopped offering one.
decidableAs : Int -> QueueState -> SelectedView -> DecisionTarget -> Uid -> Result SaveFailure DecidableRow
decidableAs selected state view target uid =
    case decidableRow selected state view uid of
        Just row ->
            if rowTarget row == target then
                Ok row

            else
                Err (undecidable state target uid)

        Nothing ->
            Err (undecidable state target uid)


-- Why `uid` offers no decision on `target` on the queue page `state`: the
-- log records no decision, the unit's source is not shown, or the unit or
-- file is not one the page offers a decision on.
undecidable : QueueState -> DecisionTarget -> Uid -> SaveFailure
undecidable state target uid =
    case state of
        Loaded page ->
            case page.log of
                ShownProven ->
                    case target of
                        OnUnit ->
                            if List.any (\q -> q.unit.uid == uid) page.units then
                                Failure.SaveRefused Failure.SourceNotShown

                            else
                                Failure.SaveRefused Failure.NotQueued

                        OnRefusal ->
                            case List.find (\row -> row.uid == uid) page.refusals of
                                Just row ->
                                    case row.digest of
                                        Just _ ->
                                            Failure.SaveRefused Failure.FileNotQueued

                                        Nothing ->
                                            Failure.SaveRefused Failure.FileNotAcknowledgeable

                                Nothing ->
                                    Failure.SaveRefused Failure.FileNotQueued

                ShownBroken _ ->
                    Failure.SaveRefused Failure.LogBroken

                ShownKeyMismatch ->
                    Failure.SaveRefused Failure.LogKeyMismatch

                ShownUnkeyed ->
                    Failure.SaveReadOnly

        Loading ->
            notListed target

        Failed _ ->
            notListed target


notListed : DecisionTarget -> SaveFailure
notListed target =
    case target of
        OnUnit ->
            Failure.SaveRefused Failure.NotQueued

        OnRefusal ->
            Failure.SaveRefused Failure.FileNotQueued


-- The session's one decision slot, and what the reviewer sees of it. A
-- decision re-reads its source to re-prove it, so at most one is in flight:
-- a decision asked while one is busy starts nothing. Busy is two cases: the
-- decision is saving, or it is saved and the queue reload that drops its row
-- is still running, so the row's controls stay withheld until the reloaded
-- queue no longer lists it. A busy decision records the epoch whose process
-- runs it: slot ownership is tied to process lifetime, so one owned by
-- another epoch is idle. `DecisionNotSaved` is the notice of the last
-- decision that was not saved, with the queue's latest load ticket when it
-- was raised; the next decision started, or a queue load started after it
-- that succeeds, replaces it, so a reload clears it as its text advises,
-- and a load that read the queue before the failure was known does not.
-- The refusal panel lives only in the two idle cases, so a panel open
-- beside a busy decision, or a draft with no panel, has no representation.
type DecisionSlot
    = DecisionIdle RefusalPanel
    | DecisionSaving Uid Epoch
    | DecisionRefreshing Uid Epoch
    | DecisionNotSaved SaveFailure LoadTicket RefusalPanel


-- The refusal panel of an idle slot: closed, or open on one row the shown
-- page offers a decision on, with its draft.
type RefusalPanel
    = PanelClosed
    | PanelOpen DecidableRow Draft


-- The reviewer's refusal draft, and why it stays open, if it was refused.
type alias Draft =
    { refuseDraft : String, refuseError : Maybe RefuseFailure }


-- The decision on `uid` and the process `epoch` runs it in, while that
-- process has it busy.
busyOwnedBy : Epoch -> DecisionSlot -> Maybe Uid
busyOwnedBy epoch slot =
    case slot of
        DecisionSaving uid owner ->
            if owner == epoch then
                Just uid

            else
                Nothing

        DecisionRefreshing uid owner ->
            if owner == epoch then
                Just uid

            else
                Nothing

        DecisionIdle _ ->
            Nothing

        DecisionNotSaved _ _ _ ->
            Nothing


-- The slot holding a decision on `uid` run by process `epoch`; Nothing
-- while another decision of that process is busy. Starting a decision drops
-- the last one's not-saved notice and closes any open refusal panel.
startDecision : Epoch -> Uid -> DecisionSlot -> Maybe DecisionSlot
startDecision epoch uid slot =
    case busyOwnedBy epoch slot of
        Just _ ->
            Nothing

        Nothing ->
            Just (DecisionSaving uid epoch)


-- The slot with the refusal panel open on `row`, its draft empty, by the
-- same busy check `startDecision` makes: while a decision of process
-- `epoch` is busy the slot is unchanged, and a busy decision another process
-- left behind is idle. Only a row the shown page offers a decision on can
-- hold the panel, so a panel no row draws has no representation.
openRefusal : Epoch -> DecidableRow -> DecisionSlot -> DecisionSlot
openRefusal epoch row slot =
    case busyOwnedBy epoch slot of
        Just _ ->
            slot

        Nothing ->
            withPanel (PanelOpen row { refuseDraft = "", refuseError = Nothing }) (ownedSlot epoch slot)


-- The slot with its refusal panel closed.
closeRefusal : DecisionSlot -> DecisionSlot
closeRefusal slot =
    withPanel PanelClosed slot


-- The draft of the panel open on `uid` replaced by `text`, which clears
-- why it was refused; a slot with no panel open on `uid` is unchanged, so
-- an edit sent for another row's panel writes into none.
editDraft : Uid -> String -> DecisionSlot -> DecisionSlot
editDraft uid text slot =
    case openRow slot of
        Just ( row, _ ) ->
            if rowUid row == uid then
                mapOpenDraft (\_ -> { refuseDraft = text, refuseError = Nothing }) slot

            else
                slot

        Nothing ->
            slot


-- The open panel's draft refused for `failure`; a slot with no open panel
-- is unchanged.
draftRefused : RefuseFailure -> DecisionSlot -> DecisionSlot
draftRefused failure slot =
    mapOpenDraft (\draft -> { draft | refuseError = Just failure }) slot


-- The row the refusal panel is open on, with its draft, if it is open.
openRow : DecisionSlot -> Maybe ( DecidableRow, Draft )
openRow slot =
    case panelOf slot of
        PanelOpen row draft ->
            Just ( row, draft )

        PanelClosed ->
            Nothing


-- The uid of the row the refusal panel is open on, with its draft.
openPanel : DecisionSlot -> Maybe ( Uid, Draft )
openPanel slot =
    Maybe.map (\( row, draft ) -> ( rowUid row, draft )) (openRow slot)


-- The refusal panel the slot holds; a busy slot holds none.
panelOf : DecisionSlot -> RefusalPanel
panelOf slot =
    case slot of
        DecisionIdle panel ->
            panel

        DecisionNotSaved _ _ panel ->
            panel

        DecisionSaving _ _ ->
            PanelClosed

        DecisionRefreshing _ _ ->
            PanelClosed


-- An idle slot holding `panel` in place of its own, its notice kept; a
-- busy slot holds no panel and is unchanged.
withPanel : RefusalPanel -> DecisionSlot -> DecisionSlot
withPanel panel slot =
    case slot of
        DecisionIdle _ ->
            DecisionIdle panel

        DecisionNotSaved failure raisedAt _ ->
            DecisionNotSaved failure raisedAt panel

        DecisionSaving _ _ ->
            slot

        DecisionRefreshing _ _ ->
            slot


mapOpenDraft : (Draft -> Draft) -> DecisionSlot -> DecisionSlot
mapOpenDraft change slot =
    case panelOf slot of
        PanelOpen row draft ->
            withPanel (PanelOpen row (change draft)) slot

        PanelClosed ->
            slot


-- The slot as this process `epoch` owns it: a busy decision another process
-- left behind, whose completion died with it, is idle.
ownedSlot : Epoch -> DecisionSlot -> DecisionSlot
ownedSlot epoch slot =
    case busyOwnedBy epoch slot of
        Just _ ->
            slot

        Nothing ->
            case slot of
                DecisionNotSaved _ _ _ ->
                    slot

                DecisionIdle _ ->
                    slot

                DecisionSaving _ _ ->
                    DecisionIdle PanelClosed

                DecisionRefreshing _ _ ->
                    DecisionIdle PanelClosed


-- The decision on `uid` run by process `epoch` was written: it stays busy
-- until the queue reload that follows settles. A result for any other uid
-- or from any other process leaves the slot.
decisionWritten : Epoch -> Uid -> DecisionSlot -> DecisionSlot
decisionWritten epoch uid slot =
    if isSaving epoch uid slot then
        DecisionRefreshing uid epoch

    else
        slot


-- The decision on `uid` run by process `epoch` was not saved, for
-- `failure`, while `latest` is the queue's latest load. A result for any
-- other uid or from any other process leaves the slot.
decisionNotSaved : Epoch -> Uid -> SaveFailure -> LoadTicket -> DecisionSlot -> DecisionSlot
decisionNotSaved epoch uid failure latest slot =
    if isSaving epoch uid slot then
        DecisionNotSaved failure latest PanelClosed

    else
        slot


isSaving : Epoch -> Uid -> DecisionSlot -> Bool
isSaving epoch uid slot =
    case slot of
        DecisionSaving saving owner ->
            saving == uid && owner == epoch

        DecisionRefreshing _ _ ->
            False

        DecisionIdle _ ->
            False

        DecisionNotSaved _ _ _ ->
            False


-- A decision refused before it started, for `failure`, while `latest` is
-- the queue's latest load: the notice replaces an idle slot or an older
-- notice, keeping its refusal panel, never a busy decision of process
-- `epoch`.
decisionRefused : Epoch -> SaveFailure -> LoadTicket -> DecisionSlot -> DecisionSlot
decisionRefused epoch failure latest slot =
    case busyOwnedBy epoch slot of
        Just _ ->
            slot

        Nothing ->
            DecisionNotSaved failure latest (panelOf slot)


-- The current queue load `load` settled with `result`. The reloaded queue
-- no longer lists a refreshing decision's row, or failed and lists no row,
-- so the decision is done either way; a load started after the not-saved
-- notice that succeeds also clears it, the reload its text advises, while
-- a load started before it read the queue before the failure was known
-- and leaves it. A decision still saving stays: its row is re-proved at
-- the write, and its own result settles it. Every idle slot it settles
-- closes its refusal panel, since the rows it was opened on are re-read.
queueSettled : LoadTicket -> Result e a -> DecisionSlot -> DecisionSlot
queueSettled load result slot =
    case slot of
        DecisionRefreshing _ _ ->
            DecisionIdle PanelClosed

        DecisionNotSaved failure raisedAt _ ->
            case result of
                Ok _ ->
                    if ticketNumber load > ticketNumber raisedAt then
                        DecisionIdle PanelClosed

                    else
                        DecisionNotSaved failure raisedAt PanelClosed

                Err _ ->
                    DecisionNotSaved failure raisedAt PanelClosed

        DecisionSaving _ _ ->
            slot

        DecisionIdle _ ->
            DecisionIdle PanelClosed


-- What a row's decision controls show while a decision is busy, in place of
-- the controls: the row being decided says how far it got, and any other
-- row says what it waits on. Nothing when no decision is busy, where the
-- row offers its controls.
pendingText : Uid -> DecisionSlot -> Maybe SafeText
pendingText uid slot =
    case slot of
        DecisionSaving busy _ ->
            if busy == uid then
                Just (SafeText.literal "Saving the decision…")

            else
                Just (SafeText.literal "Another decision is saving…")

        DecisionRefreshing busy _ ->
            if busy == uid then
                Just (SafeText.literal "Decision saved; refreshing the queue…")

            else
                Just (SafeText.literal "Refreshing the queue after a decision…")

        DecisionIdle _ ->
            Nothing

        DecisionNotSaved _ _ _ ->
            Nothing


-- The not-saved notice the slot holds, if any.
notSavedOf : DecisionSlot -> Maybe SaveFailure
notSavedOf slot =
    case slot of
        DecisionNotSaved failure _ _ ->
            Just failure

        DecisionIdle _ ->
            Nothing

        DecisionSaving _ _ ->
            Nothing

        DecisionRefreshing _ _ ->
            Nothing


-- The one-line text for a unit page that has no unit to show; Nothing once
-- the unit is loaded.
unitPageStatusText : UnitPageState -> Maybe SafeText
unitPageStatusText state =
    case state of
        UnitLoading ->
            Just (SafeText.literal "Loading unit…")

        UnitNotFound ->
            Just (SafeText.literal "No unit with this id is in the index.")

        UnitFailed failure ->
            Just (SafeText.literal ("Unit load failed: " ++ Failure.loadFailureText failure))

        UnitIdRefused ->
            Just (SafeText.literal "This address does not name a unit.")

        UnitLoaded _ ->
            Nothing


-- Why a unit's source is withheld, in place of the source and the decision
-- buttons; Nothing only for a verified view. A line is the tool's text
-- around at most the stored path, which arrives as the failure's own label,
-- so no index column reaches the line but as a `Label`.
sourceStatusText : Index.SourceView -> Maybe (List LabelPiece)
sourceStatusText view =
    case view of
        Shown _ ->
            Nothing

        Stale Drifted ->
            Just [ ToolText (SafeText.literal "Source changed since it was indexed; re-run `ipe-index index` to review it.") ]

        Stale (RangeOutOfFile r) ->
            Just [ ToolText (SafeText.literal ("The file now has " ++ String.fromInt r.lineCount ++ " lines, fewer than this unit's range; re-run `ipe-index index` to review it.")) ]

        Stale UnverifiableHash ->
            Just [ ToolText (SafeText.literal "This unit's hash predates source attestation; re-run `ipe-index index` to verify it.") ]

        Unreadable failure ->
            Just (ToolText (SafeText.literal "Source unreadable: ") :: Index.readFailureText failure)

        TooLarge (SpanLines o) ->
            Just [ ToolText (SafeText.literal ("This unit spans " ++ String.fromInt o.lines ++ " lines, past the " ++ String.fromInt Index.viewLineCeiling ++ "-line review ceiling." ++ notShownRemedy)) ]

        TooLarge (ViewBytes o) ->
            Just [ ToolText (SafeText.literal ("This unit's source is " ++ kibText (ByteSize.toBytes o.size) ++ ", past the " ++ kibText (ByteSize.toBytes Index.viewByteCeiling) ++ " review ceiling." ++ notShownRemedy)) ]

        TooLarge (ChildSpans o) ->
            Just [ ToolText (SafeText.literal ("This file holds at least " ++ String.fromInt o.atLeast ++ " other units, past the " ++ String.fromInt Index.childSpanCeiling ++ "-unit review ceiling. It is not shown and cannot be decided here; split the file to review it.")) ]


-- What a reviewer can do about a view past a ceiling.
notShownRemedy : String
notShownRemedy =
    " It is not shown and cannot be decided here; split the unit to review it."


-- A byte count in whole KiB, rounded up, so a size one byte past a ceiling
-- never reads as the ceiling itself.
kibText : Int -> String
kibText n =
    String.fromInt ((n + 1023) // 1024) ++ " KiB"


-- One unit's view by uid through `Index.loadView`, the one source read the
-- unit page and the selected queue card share (a decided unit is not open,
-- so it queries units directly), on one connection from
-- `settings`. Nothing when no unit has this uid.
loadUnitView : IndexSettings -> Uid -> Task.Task Error (Maybe Index.UnitView)
loadUnitView settings uid =
    do
        conn <- Index.readConnection settings
        Index.loadView conn settings.roots uid


stateFromResult : Result LoadFailure QueuePage -> QueueState
stateFromResult result =
    case result of
        Ok page ->
            Loaded page

        Err e ->
            Failed e


-- The one-line text for a state that has no unit list to show; Nothing for a
-- loaded page that holds units.
queueStatusText : QueueState -> Maybe SafeText
queueStatusText state =
    case state of
        Loading ->
            Just (SafeText.literal "Loading queue…")

        Failed failure ->
            Just (SafeText.literal ("Queue failed to load: " ++ Failure.loadFailureText failure))

        Loaded page ->
            if page.total == 0 && page.refusalsOpen > 0 then
                Just (SafeText.literal ("No units queued, but" ++ refusalsWord page.refusalsOpen ++ " still open." ++ unboundNotice page))

            else if page.total == 0 then
                Just (SafeText.literal ("No units queued." ++ unboundNotice page))

            else if List.isEmpty page.units then
                Just (SafeText.literal ("No units to review on this page." ++ unboundNotice page))

            else
                Nothing


-- The queue header: database name, size, how many of the open units this
-- page shows, how many unreviewable files are open, and how many units it
-- leaves out as unbound.
pageHeaderText : QueuePage -> SafeText
pageHeaderText page =
    SafeText.concat
        [ page.dbName
        , SafeText.literal
            (String.concat
                [ " · "
                , Format.byteSize page.dbBytes
                , " · showing "
                , String.fromInt (List.length page.units)
                , " of "
                , String.fromInt page.total
                , refusalsNotice page
                , unboundNotice page
                ]
            )
        ]


-- The open unreviewable files, said where the queue's counts are; empty
-- when none is open.
refusalsNotice : QueuePage -> String
refusalsNotice page =
    if page.refusalsOpen > 0 then
        " ·" ++ refusalsWord page.refusalsOpen ++ " open"

    else
        ""


-- " 1 unreviewable file" for one, " N unreviewable files" for any other
-- count.
refusalsWord : Int -> String
refusalsWord count =
    if count == 1 then
        " 1 unreviewable file"

    else
        " " ++ String.fromInt count ++ " unreviewable files"


-- The fixed text naming why the index could not review a file.
refusalReasonText : Index.RefusalReason -> SafeText
refusalReasonText reason =
    case reason of
        NotUtf8 ->
            SafeText.literal "Not UTF-8 text"

        Oversized ->
            SafeText.literal "Larger than the index reads as source"

        SymlinkEntry ->
            SafeText.literal "A symbolic link"

        GitlinkEntry ->
            SafeText.literal "A submodule (gitlink) entry"

        UnknownMode ->
            SafeText.literal "A git entry of unknown mode"

        PastHashCeiling ->
            SafeText.literal "Too large to hash"

        NonUtf8Name ->
            SafeText.literal "Its name is not UTF-8"

        NotRepoRelative ->
            SafeText.literal "Its path is not inside the repository"

        NestedRepository ->
            SafeText.literal "Inside a nested repository"

        NotRegular ->
            SafeText.literal "Not a regular file"

        UnreadableEntry ->
            SafeText.literal "Could not be read"

        ReplacedEntry ->
            SafeText.literal "Replaced while the index read it"


-- " unit" for one, " units" for any other count.
unitsWord : Int -> String
unitsWord count =
    if count == 1 then
        " unit"

    else
        " units"


-- The units and the unreviewable files under a tag no configured root
-- binds, left out of the queue and its progress, said where the queue's
-- counts are; empty when none is.
unboundNotice : QueuePage -> String
unboundNotice page =
    unboundPart page.unbound (String.fromInt page.unbound ++ unitsWord page.unbound)
        ++ unboundPart page.refusalsUnbound (String.dropLeft 1 (refusalsWord page.refusalsUnbound))


unboundPart : Int -> String -> String
unboundPart count what =
    if count > 0 then
        " · " ++ what ++ " in unbound repositories not shown"

    else
        ""


-- One page of the queue at `cursor`, as the review app sees it: the open
-- units of the index (its current units whose (uid, body_hash) pair has no
-- decision), with
--
--   * a unit decided on an older hash resurfaced at the head, flagged with
--     its previous review;
--   * never-seen units keeping the index's enqueue order after resurfaced
--     ones.
--
-- Only one page is classified per load, so the resurfaced-first order holds
-- within the page.
--
-- The page rows, the open count, the progress and the database size come
-- from one index read, trusted only when the `reviewed` copy's stamp is the
-- one the server's key would write for the review log's head and the copy
-- holds exactly the pairs the log's walk verified: any other copy (a failed
-- drain, a replaced index or review file, a decision another process
-- recorded, a pair written into the copy directly) rebuilds the copy
-- and reads once more, and a stamp that still differs fails the load rather
-- than show a stale queue. It never loops. The settings are the value
-- resolved at startup and every index read runs on the one read connection
-- opened from them.
loadPage : AppSettings -> Index.Cursor -> Task.Task Error QueuePage
loadPage settings cursor =
    do
        conn <- Index.readConnection settings.index
        db <- LibDb.openAt settings.review
        fresh <- freshSnapshot settings conn db cursor
        pageOf settings db fresh


pageOf : AppSettings -> Db.Db -> ( LibDb.LogState, Index.Snapshot ) -> Task.Task Error QueuePage
pageOf settings db fresh =
    case fresh of
        ( state, snap ) ->
            do
                units <- classify (LibDb.verifier state) db snap.rows
                Task.succeed
                    { units = units
                    , total = snap.open
                    , unbound = snap.unbound
                    , dbName = SafeText.renderForeign (Settings.dbFileName settings.index.db.path)
                    , dbBytes = snap.bytes
                    , next = nextCursor snap.rows
                    , progress =
                        { reviewed = snap.units - snap.open + (snap.refusalsAll - snap.refusalsOpen)
                        , total = snap.units + snap.refusalsAll
                        }
                    , log = LibDb.logShown state
                    , refusals = snap.refusals
                    , refusalsOpen = snap.refusalsOpen
                    , refusalsUnbound = snap.refusalsUnbound
                    }


-- The index read at `cursor` with the review log's verdict, taken once for
-- the load, trusted only when the `reviewed` copy holds for it: a stamp
-- current for the verdict and exactly the pairs of the entries its walk
-- verified. It is read as is, or once more after one rebuild of the copy
-- under that same verdict; a copy that still does not hold is a failed
-- load. A pair written into the copy outside a drain is never counted: the
-- load rebuilds the copy from the log first. The verdict is taken
-- before the index is read: a decision recorded after it moves the head on,
-- so a match proves the copy holds every counted decision up to a head the
-- log really had, and an entry edited, removed or added outside this tool
-- changes the verdict, so the copy is rebuilt on this load. One walk of the
-- log per load.
freshSnapshot : AppSettings -> Db.Db -> Db.Db -> Index.Cursor -> Task.Task Error ( LibDb.LogState, Index.Snapshot )
freshSnapshot settings conn db cursor =
    do
        state <- LibDb.logVerdict settings.key db
        first <- Index.readSnapshot settings.key settings.index.roots conn cursor
        if LibDb.copyHolds state first then
            Task.succeed ( state, first )

        else
            do
                rebuildUnder settings.index resyncBound state db
                second <- Index.readSnapshot settings.key settings.index.roots conn cursor
                if LibDb.copyHolds state second then
                    Task.succeed ( state, second )

                else
                    Task.fail stillBehind


-- A decided unit drained from the index, then the queue page at `cursor`
-- reloaded. The drain writes the index alone: the review database already
-- holds the decision, and `written` says how it moved the log's head, so
-- the drain moves the copy's stamp the same way.
drainThenLoad : AppSettings -> Index.Attested -> Index.Written -> Index.Cursor -> Task.Task Error QueuePage
drainThenLoad settings attested written cursor =
    Index.drainUnit settings.index attested written |> Task.andThen (\_ -> loadPage settings cursor)


-- A full page may have rows after it; a short page is the last one.
nextCursor : List Index.PendingRow -> Maybe Index.Cursor
nextCursor rows =
    if List.length rows < PageSize.toInt PageSize.queue then
        Nothing

    else
        rows
            |> List.reverse
            |> List.head
            |> Maybe.map (\r -> Index.After { enqueuedAt = r.enqueuedAt, uid = r.unit.uid })


classify : LibDb.Verifier -> Db.Db -> List Index.PendingRow -> Task.Task Error (List QueuedUnit)
classify verify db rows =
    rows
        |> List.map (classifyUnit verify db)
        |> Task.sequence
        |> Task.map prioritize


-- An open unit with the latest counted review of its uid when that review
-- is of an older body: a review of the current body (one recorded after the
-- page was read) is not a previous review, and a row that does not count is
-- never one.
classifyUnit : LibDb.Verifier -> Db.Db -> Index.PendingRow -> Task.Task Error QueuedUnit
classifyUnit verify db row =
    let
        unit =
            row.unit

        current =
            Index.storedHash unit.attested
    in
    do
        latest <- LibDb.findLatestForUid verify db unit.uid
        entry <- LibDb.findDecision verify db unit.uid current
        Task.succeed
            { unit = unit
            , change = row.change
            , changed = Maybe.andThen (previousReview current) latest
            , standing = standingOf entry
            }


previousReview : String -> LibDb.VerifiedRow -> Maybe LibDb.VerifiedRow
previousReview current row =
    if LibDb.verifiedHash row == current then
        Nothing

    else
        Just row


prioritize : List QueuedUnit -> List QueuedUnit
prioritize classified =
    let
        ( changed, fresh ) =
            partition classified
    in
    changed ++ fresh


-- Stable partition: resurfaced (changed) units first, fresh units after,
-- each group keeping the index's enqueue order.
partition : List QueuedUnit -> ( List QueuedUnit, List QueuedUnit )
partition qs =
    List.foldr
        (\q ( changed, fresh ) ->
            if q.changed == Nothing then
                ( changed, q :: fresh )

            else
                ( q :: changed, fresh )
        )
        ( [], [] )
        qs
