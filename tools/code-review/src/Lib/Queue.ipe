module Lib.Queue exposing (HistoryPage, HistoryRow, HistoryState(..), LoadTicket, Progress, QueuePage, QueueState(..), QueuedUnit, ResyncBound, SelectedView(..), UnitPageState(..), clearView, decidableSource, decide, drainThenLoad, firstTicket, historyStateFromResult, historyStatusText, isCurrentLoad, loadHistoryPage, loadPage, nextTicket, loadUnitView, pageHeaderText, queueStatusText, reloadView, resyncBound, resyncPageCeiling, resyncReviewed, resyncReviewedWithin, selectView, selectedViewOf, selectedViewStatusText, sourceStatusText, stateFromResult, unitPageFromResult, unitPageStatusText, viewArrived)

import Ipe.Db as Db
import Ipe.Error as Error
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task
import Ipe.Time.Timestamp exposing (Timestamp)
import Lib.Db as LibDb exposing (HistoryCursor(..))
import Lib.Format as Format
-- `Index.Unit` names `Highlight.Lang` and `Index.UnitView` names
-- `Links.LinkSet`, and an imported alias resolves its qualified names in this
-- module.
import Lib.Highlight as Highlight
import Lib.Index as Index exposing (SourceView(..), StaleReason(..))
import Lib.Links as Links
import Lib.SafeText as SafeText exposing (SafeText)
import Lib.Settings as Settings


-- A pending unit plus its resurfacing state. `changed` is Just the previous
-- review when this uid was already decided on an OLDER body hash: the author
-- edited the code after the review, so the unit must be reviewed again.
type alias QueuedUnit =
    { unit : Index.Unit
    , queued : Index.QueuedChange
    , changed : Maybe LibDb.ReviewRow
    }


-- One loaded page of the queue. `total` counts the whole queue (never this
-- page's length); `next` is the cursor of the following page, Nothing on the
-- last page; `dbName` is the index file's name, rendered once.
type alias QueuePage =
    { units : List QueuedUnit
    , total : Int
    , dbName : SafeText
    , dbBytes : Int
    , next : Maybe Index.Cursor
    , progress : Progress
    }


-- Review progress over the index as it stands, never from a session:
-- `reviewed` counts the units whose current body hash has a decision, `total`
-- the units reviewed or still queued. Both are one aggregate over the index's
-- `reviewed` table, the copy of the review database's decided pairs that each
-- drain extends; every load first checks the copy's row count against the
-- review database and rebuilds the copy on a mismatch. Deciding a unit moves
-- it from queued to reviewed, so `total` holds while the queue drains, and a
-- reload or a second tab reads the same numbers.
type alias Progress =
    { reviewed : Int
    , total : Int
    }


-- The progress of the index, read on the index connection `conn`, with the
-- `reviewed` copy checked fresh first: when its row count differs from the
-- decision count of the review database `db` (a decision whose drain failed,
-- a replaced index file, a deleted review row), the copy is rebuilt once and
-- the row read again. It never loops.
currentProgress : Db.Db -> Db.Db -> Task.Task Error Progress
currentProgress conn db =
    do
        first <- Index.loadProgress conn
        decisions <- LibDb.countDecisions db
        if first.mirrored == decisions then
            Task.succeed (progressFrom first)

        else
            do
                resyncReviewed db
                second <- Index.loadProgress conn
                Task.succeed (progressFrom second)


progressFrom : Index.ProgressRow -> Progress
progressFrom row =
    { reviewed = row.reviewed, total = row.total }


-- How far one rebuild of the `reviewed` copy may read: `pageCeiling` pages
-- of at most `pageSize` decided pairs each. A record, so the two counts are
-- named at every call and never swapped.
type alias ResyncBound =
    { pageSize : Int
    , pageCeiling : Int
    }


-- The most review-database pages one rebuild reads: a bound on one rebuild
-- transaction's work (`pageCeiling x pairPageSize` decisions), never a stack
-- limit — the walk runs at constant stack depth through `Task.loop`.
resyncPageCeiling : Int
resyncPageCeiling =
    10000


resyncBound : ResyncBound
resyncBound =
    { pageSize = LibDb.pairPageSize, pageCeiling = resyncPageCeiling }


-- The `reviewed` copy rebuilt from the review database: one index
-- transaction empties it and drains every decided pair, so a pair's
-- undrained queue row leaves too. Returns the count of pairs copied.
resyncReviewed : Db.Db -> Task.Task Error Int
resyncReviewed db =
    resyncReviewedWithin resyncBound db


-- `resyncReviewed` reading at most `bound.pageCeiling` pages of
-- `bound.pageSize` decided pairs. A review database holding more refuses
-- the rebuild and rolls it back, leaving the copy as it was. A bound below
-- one page of one pair is refused before the copy is touched.
resyncReviewedWithin : ResyncBound -> Db.Db -> Task.Task Error Int
resyncReviewedWithin bound db =
    if bound.pageSize < 1 || bound.pageCeiling < 1 then
        Task.fail (Error.invalidInput "a review progress rebuild needs a page size and a page ceiling of at least 1")

    else
        Index.rebuildReviewed (\conn -> refillPages bound db conn)


-- The state one `refillPages` step carries: how many pages have been read,
-- how many pairs have been drained so far, and the cursor the next page
-- reads after.
type alias RefillState =
    { pagesRead : Int
    , copied : Int
    , cursor : Maybe Index.DecidedPair
    }


-- `resyncReviewed` draining the review database at constant stack depth,
-- however many pages it takes. The loop's own ceiling, `bound.pageCeiling +
-- 1`, is an unreachable backstop (defence in depth): the step itself refuses
-- a non-empty page once `pagesRead >= bound.pageCeiling`, so the loop's own
-- limit never has a chance to fire.
refillPages : ResyncBound -> Db.Db -> Db.Db -> Task.Task Error Int
refillPages bound db conn =
    Task.loop (bound.pageCeiling + 1) { pagesRead = 0, copied = 0, cursor = Nothing } (refillStep bound db conn)


-- One page of decided pairs after `state.cursor`, drained on `conn`: an
-- empty page ends the walk with the pairs copied so far; a non-empty page
-- past the ceiling fails the whole rebuild; otherwise the page drains, then
-- a short page ends the walk and a full page continues from its last pair.
refillStep : ResyncBound -> Db.Db -> Db.Db -> RefillState -> Task.Task Error (Task.Step RefillState Int)
refillStep bound db conn state =
    do
        pairs <- LibDb.decidedPairsAfter db bound.pageSize state.cursor
        if List.isEmpty pairs then
            Task.succeed (Task.Done state.copied)

        else if state.pagesRead >= bound.pageCeiling then
            Task.fail (resyncCeilingRefusal bound)

        else
            do
                pairs
                    |> List.map (Index.drainDecided conn)
                    |> Task.sequence
                let
                    copied =
                        state.copied + List.length pairs
                in
                if List.length pairs < bound.pageSize then
                    Task.succeed (Task.Done copied)

                else
                    Task.succeed
                        (Task.Continue
                            { pagesRead = state.pagesRead + 1
                            , copied = copied
                            , cursor = List.head (List.reverse pairs)
                            }
                        )


resyncCeilingRefusal : ResyncBound -> Error
resyncCeilingRefusal bound =
    Error.invalidInput
        ("the review database holds more than "
            ++ String.fromInt (bound.pageCeiling * bound.pageSize)
            ++ " decisions, past the "
            ++ String.fromInt bound.pageCeiling
            ++ "-page ceiling of a review progress rebuild; the progress copy is left unchanged"
        )


-- The queue view's state. An empty queue is only `Loaded` with `total == 0`,
-- so a load in flight or a failed load can never render as empty.
type QueueState
    = Loading
    | Loaded QueuePage
    | Failed Error


-- The number of one load of a page slot (the queue, a History page, a unit
-- page). Each load a slot starts takes the ticket after the slot's latest,
-- and a result settles the slot only under the slot's latest ticket, so a
-- slower earlier load never replaces the result of a later one. Opaque:
-- built only by `firstTicket` and `nextTicket`.
type LoadTicket
    = LoadTicket Int


firstTicket : LoadTicket
firstTicket =
    LoadTicket 0


nextTicket : LoadTicket -> LoadTicket
nextTicket ticket =
    case ticket of
        LoadTicket n ->
            LoadTicket (n + 1)


-- True when a result carrying `load` is the slot's latest load.
isCurrentLoad : LoadTicket -> LoadTicket -> Bool
isCurrentLoad load latest =
    ticketNumber load == ticketNumber latest


ticketNumber : LoadTicket -> Int
ticketNumber ticket =
    case ticket of
        LoadTicket n ->
            n


-- A decided unit as the History page shows it: the review row plus the unit's
-- qualified name resolved from the index db, rendered (Nothing when the unit
-- no longer exists there).
type alias HistoryRow =
    { uid : String
    , bodyHash : String
    , decision : String
    , reason : Maybe LibDb.StoredReason
    , reviewedAt : Timestamp
    , name : Maybe SafeText
    }


-- One loaded History page: its rows, the cursor it was read from, and the
-- cursor of the page after it (Nothing on the last page).
type alias HistoryPage =
    { rows : List HistoryRow
    , at : LibDb.HistoryCursor
    , next : Maybe LibDb.HistoryCursor
    }


-- The History view's state. An empty history is only `HistoryLoaded` with
-- no rows from `HistoryStart`, so a load in flight or a failed load can
-- never render as "no reviews".
type HistoryState
    = HistoryLoading
    | HistoryLoaded HistoryPage
    | HistoryFailed Error


historyStateFromResult : Result Error HistoryPage -> HistoryState
historyStateFromResult result =
    case result of
        Ok page ->
            HistoryLoaded page

        Err e ->
            HistoryFailed e


-- The one-line text for a History state that has no rows to show; Nothing
-- for a loaded page that holds rows.
historyStatusText : HistoryState -> Maybe String
historyStatusText state =
    case state of
        HistoryLoading ->
            Just "Loading history…"

        HistoryFailed e ->
            Just ("History load failed: " ++ SafeText.toString (SafeText.renderForeign (Error.toString e)))

        HistoryLoaded page ->
            if List.isEmpty page.rows then
                case page.at of
                    HistoryStart ->
                        Just "No reviews yet."

                    HistoryAfter _ _ _ ->
                        Just "No more reviews."

            else
                Nothing


-- One History page from `cursor`, newest first, each row with the unit's
-- qualified name resolved from the index db. At most
-- `LibDb.historyPageSize` rows are read, and one name lookup runs per row.
loadHistoryPage : LibDb.HistoryCursor -> Task.Task Error HistoryPage
loadHistoryPage cursor =
    do
        db <- LibDb.open
        page <- LibDb.historyPage db LibDb.historyPageSize cursor
        settings <- Settings.indexSettings
        conn <- Index.readConnection settings
        rows <- Task.sequence (List.map (historyRow conn) page.rows)
        Task.succeed { rows = rows, at = cursor, next = page.next }


historyRow : Db.Db -> LibDb.ReviewRow -> Task.Task Error HistoryRow
historyRow conn row =
    Task.map
        (\name ->
            { uid = row.uid
            , bodyHash = row.bodyHash
            , decision = row.decision
            , reason = row.reason
            , reviewedAt = row.reviewedAt
            , name = name
            }
        )
        (Index.nameFor conn row.uid)


-- The one way a decision is recorded: only a shown source can be decided,
-- since only a verified view holds a `ShownSource`, and only after
-- `Index.reverify` re-proves it, so the hash written is the hash of the
-- bytes the reviewer saw.
decide : Db.Db -> Index.ShownSource -> LibDb.Decision -> Task.Task Error ( Index.Attested, Int )
decide db shown decision =
    do
        attested <- Index.reverify shown
        n <- LibDb.insertDecision db attested decision
        Task.succeed ( attested, n )


-- The selected queue card's source: nothing selected, one read in flight
-- (with the unit wanted once it returns, when the selection moved during the
-- read), the loaded view, no unit with the read's uid, or a failed read. At
-- most one read is in flight: a selection made during a read only records
-- `wanted`, and a response for any uid but the in-flight one is dropped.
-- `fresh` is False once the queue page reloaded or cleared during the read,
-- so its result predates the page and never settles the view: the in-flight
-- unit selected again is read afresh, and with nothing wanted the result is
-- dropped.
type SelectedView
    = NoneSelected
    | ViewLoading { uid : String, wanted : Maybe String, fresh : Bool }
    | ViewShown Index.UnitView
    | ViewMissing String
    | ViewFailed String Error


-- `uid` selected, with the uid to read next, if any. During a read only the
-- wanted unit is recorded; the shown unit selected again reads nothing.
selectView : String -> SelectedView -> ( SelectedView, Maybe String )
selectView uid state =
    case state of
        ViewLoading loading ->
            ( ViewLoading { uid = loading.uid, wanted = wantedAfter loading.uid loading.fresh uid, fresh = loading.fresh }, Nothing )

        ViewShown shown ->
            if shown.unit.uid == uid then
                ( state, Nothing )

            else
                startView uid

        NoneSelected ->
            startView uid

        ViewMissing _ ->
            startView uid

        ViewFailed _ _ ->
            startView uid


-- `uid` selected after the queue page reloaded, so its view is read afresh
-- even when it is the one shown; during a read it is read once that read
-- returns.
reloadView : String -> SelectedView -> ( SelectedView, Maybe String )
reloadView uid state =
    case state of
        ViewLoading loading ->
            ( ViewLoading { uid = loading.uid, wanted = Just uid, fresh = False }, Nothing )

        ViewShown _ ->
            startView uid

        NoneSelected ->
            startView uid

        ViewMissing _ ->
            startView uid

        ViewFailed _ _ ->
            startView uid


-- No unit to select. A read in flight stays recorded, with nothing wanted
-- after it, so no second read can start beside it, and its result is
-- dropped when it returns.
clearView : SelectedView -> SelectedView
clearView state =
    case state of
        ViewLoading loading ->
            ViewLoading { uid = loading.uid, wanted = Nothing, fresh = False }

        ViewShown _ ->
            NoneSelected

        NoneSelected ->
            NoneSelected

        ViewMissing _ ->
            NoneSelected

        ViewFailed _ _ ->
            NoneSelected


-- The read of `uid` returned with `result`: when another unit was selected
-- meanwhile its read starts, otherwise the result settles the view. A
-- response for any uid but the in-flight one changes nothing.
viewArrived : String -> Result Error (Maybe Index.UnitView) -> SelectedView -> ( SelectedView, Maybe String )
viewArrived uid result state =
    case state of
        ViewLoading loading ->
            if loading.uid /= uid then
                ( state, Nothing )

            else
                case loading.wanted of
                    Just next ->
                        startView next

                    Nothing ->
                        if loading.fresh then
                            ( settledView uid result, Nothing )

                        else
                            ( NoneSelected, Nothing )

        ViewShown _ ->
            ( state, Nothing )

        NoneSelected ->
            ( state, Nothing )

        ViewMissing _ ->
            ( state, Nothing )

        ViewFailed _ _ ->
            ( state, Nothing )


startView : String -> ( SelectedView, Maybe String )
startView uid =
    ( ViewLoading { uid = uid, wanted = Nothing, fresh = True }, Just uid )


-- The unit wanted after the in-flight read of `inFlight` when `uid` is
-- selected: nothing when the in-flight unit is selected again and its read
-- is fresh; a read that predates the page reads that unit again.
wantedAfter : String -> Bool -> String -> Maybe String
wantedAfter inFlight fresh uid =
    if inFlight == uid && fresh then
        Nothing

    else
        Just uid


settledView : String -> Result Error (Maybe Index.UnitView) -> SelectedView
settledView uid result =
    case result of
        Ok (Just loaded) ->
            ViewShown loaded

        Ok Nothing ->
            ViewMissing uid

        Err e ->
            ViewFailed uid e


-- The loaded view of the selected unit `uid`; Nothing while it loads, when
-- its read failed or found no unit, or when the view is another unit's.
selectedViewOf : String -> SelectedView -> Maybe Index.UnitView
selectedViewOf uid state =
    case state of
        ViewShown shown ->
            if shown.unit.uid == uid then
                Just shown

            else
                Nothing

        ViewLoading _ ->
            Nothing

        NoneSelected ->
            Nothing

        ViewMissing _ ->
            Nothing

        ViewFailed _ _ ->
            Nothing


-- The one source a decision on `uid` may be made on: the selected unit's
-- verified view. Nothing for a withheld view, a view not loaded, or another
-- unit's view, so nothing else can reach `decide`.
decidableSource : String -> SelectedView -> Maybe Index.ShownSource
decidableSource uid state =
    case selectedViewOf uid state of
        Just loaded ->
            case loaded.view of
                Shown shown ->
                    Just shown

                Stale _ ->
                    Nothing

                Unreadable _ ->
                    Nothing

        Nothing ->
            Nothing


-- The one-line text in place of the selected unit's source while it has no
-- loaded view; Nothing once the view of `uid` is loaded.
selectedViewStatusText : String -> SelectedView -> Maybe String
selectedViewStatusText uid state =
    case state of
        ViewShown shown ->
            if shown.unit.uid == uid then
                Nothing

            else
                Just "Loading source…"

        ViewLoading _ ->
            Just "Loading source…"

        NoneSelected ->
            Just "Loading source…"

        ViewMissing _ ->
            Just "This unit is no longer in the index."

        ViewFailed _ e ->
            Just ("Source load failed: " ++ SafeText.toString (SafeText.renderForeign (Error.toString e)))


-- The unit page: loading, the unit with its source and links, no such unit,
-- or a failed load. A missing unit is its own state, never shown as still
-- loading.
type UnitPageState
    = UnitLoading
    | UnitLoaded Index.UnitView
    | UnitNotFound
    | UnitFailed Error


unitPageFromResult : Result Error (Maybe Index.UnitView) -> UnitPageState
unitPageFromResult result =
    case result of
        Ok (Just loaded) ->
            UnitLoaded loaded

        Ok Nothing ->
            UnitNotFound

        Err e ->
            UnitFailed e


-- The one-line text for a unit page that has no unit to show; Nothing once
-- the unit is loaded.
unitPageStatusText : UnitPageState -> Maybe String
unitPageStatusText state =
    case state of
        UnitLoading ->
            Just "Loading unit…"

        UnitNotFound ->
            Just "No unit with this id is in the index."

        UnitFailed e ->
            Just ("Unit load failed: " ++ SafeText.toString (SafeText.renderForeign (Error.toString e)))

        UnitLoaded _ ->
            Nothing


-- Why a unit's source is withheld, in place of the source and the decision
-- buttons; Nothing only for a verified view.
sourceStatusText : Index.SourceView -> Maybe String
sourceStatusText view =
    case view of
        Shown _ ->
            Nothing

        Stale Drifted ->
            Just "Source changed since it was indexed; re-run `ipe-index index` to review it."

        Stale (RangeOutOfFile r) ->
            Just ("The file now has " ++ String.fromInt r.lineCount ++ " lines, fewer than this unit's range; re-run `ipe-index index` to review it.")

        Stale UnverifiableHash ->
            Just "This unit's hash predates source attestation; re-run `ipe-index index` to verify it."

        Unreadable e ->
            Just ("Source unreadable: " ++ SafeText.toString (SafeText.renderForeign (Error.toString e)))


-- One unit's view by uid through `Index.loadView`, the one source read the
-- unit page and the selected queue card share (decided units have no
-- change_queue row, so it queries units directly), on one connection from
-- one settings resolution. Nothing when no unit has this uid.
loadUnitView : String -> Task.Task Error (Maybe Index.UnitView)
loadUnitView uid =
    do
        settings <- Settings.indexSettings
        conn <- Index.readConnection settings
        Index.loadView conn settings.roots uid


stateFromResult : Result Error QueuePage -> QueueState
stateFromResult result =
    case result of
        Ok page ->
            Loaded page

        Err e ->
            Failed e


-- The one-line text for a state that has no unit list to show; Nothing for a
-- loaded page that holds units.
queueStatusText : QueueState -> Maybe String
queueStatusText state =
    case state of
        Loading ->
            Just "Loading queue…"

        Failed e ->
            Just ("Queue failed to load: " ++ SafeText.toString (SafeText.renderForeign (Error.toString e)))

        Loaded page ->
            if page.total == 0 then
                Just "No units queued."

            else if List.isEmpty page.units then
                Just "No units to review on this page."

            else
                Nothing


-- The queue header: database name, size, and how many of the queued units
-- this page shows.
pageHeaderText : QueuePage -> String
pageHeaderText page =
    String.concat
        [ SafeText.toString page.dbName
        , " · "
        , Format.byteSize page.dbBytes
        , " · showing "
        , String.fromInt (List.length page.units)
        , " of "
        , String.fromInt page.total
        ]


-- One page of the queue at `cursor`, as the review app sees it:
--
--   * a unit whose exact (uid, body_hash) pair was already decided is
--     hidden — the first review of a pair is final and the drain loop
--     already cleared it; a re-queued identical unit is a no-op;
--   * a unit decided on an older hash resurfaced at the head, flagged with
--     its previous review;
--   * never-seen units keep the index's enqueue order after resurfaced ones.
--
-- Only one page of the queue is classified per load, so the resurfaced-first
-- order holds within the page.
--
-- The page also carries the whole-queue count, the database size and the
-- review progress. Progress is read first, so a rebuild of the `reviewed`
-- copy that drains an undrained decided pair is already reflected in the
-- page's rows and count. The index settings are resolved once and every
-- index read runs on the one read connection opened from them.
loadPage : Index.Cursor -> Task.Task Error QueuePage
loadPage cursor =
    do
        settings <- Settings.indexSettings
        conn <- Index.readConnection settings
        db <- LibDb.open
        progress <- currentProgress conn db
        rows <- Index.loadPendingPage conn cursor
        total <- Index.countPending conn
        bytes <- Index.dbBytes conn
        units <- classify db rows
        Task.succeed
            { units = units
            , total = total
            , dbName = SafeText.renderForeign (Settings.dbFileName settings.db)
            , dbBytes = bytes
            , next = nextCursor rows
            , progress = progress
            }


-- A decided unit drained from the index queue, then the queue page at
-- `cursor` reloaded. The drain writes the index alone: the review database
-- already holds the decision, so nothing is written to it here.
drainThenLoad : Index.Attested -> Index.Cursor -> Task.Task Error QueuePage
drainThenLoad attested cursor =
    Index.drainUnit attested |> Task.andThen (\_ -> loadPage cursor)


-- A full page may have rows after it; a short page is the last one.
nextCursor : List Index.PendingRow -> Maybe Index.Cursor
nextCursor rows =
    if List.length rows < Index.pageSize then
        Nothing

    else
        rows
            |> List.reverse
            |> List.head
            |> Maybe.map (\r -> Index.After { enqueuedAt = r.enqueuedAt, uid = r.unit.uid })


classify : Db.Db -> List Index.PendingRow -> Task.Task Error (List QueuedUnit)
classify db rows =
    rows
        |> List.map (classifyUnit db)
        |> Task.sequence
        |> Task.map prioritize


classifyUnit : Db.Db -> Index.PendingRow -> Task.Task Error (Maybe QueuedUnit)
classifyUnit db row =
    let
        unit =
            row.unit
    in
    do
        decided <- LibDb.findDecision db unit.uid (Index.storedHash unit.attested)
        case decided of
            Just _ ->
                Task.succeed Nothing

            Nothing ->
                do
                    old <- LibDb.findLatestForUid db unit.uid
                    Task.succeed (Just { unit = unit, queued = row.queued, changed = old })


prioritize : List (Maybe QueuedUnit) -> List QueuedUnit
prioritize classified =
    let
        ( changed, fresh ) =
            partition (List.concatMap collect classified)
    in
    changed ++ fresh


collect : Maybe QueuedUnit -> List QueuedUnit
collect mb =
    case mb of
        Just q ->
            [ q ]

        Nothing ->
            []


-- Stable partition: resurfaced (changed) units first, fresh units after,
-- each group keeping the index's enqueue order.
partition : List QueuedUnit -> ( List QueuedUnit, List QueuedUnit )
partition qs =
    List.foldr
        (\q ( changed, fresh ) ->
            if q.changed == Nothing then
                ( changed, q :: fresh )

            else
                ( q :: changed, fresh )
        )
        ( [], [] )
        qs
