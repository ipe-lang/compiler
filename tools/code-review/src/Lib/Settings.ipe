module Lib.Settings exposing (AppSettings, DbRefusal(..), DbRole(..), IndexFile, IndexSettings, ReviewFile, brokenLog, dbFileName, dbRefusalOf, ipeTag, openFailure, parseIndexDb, parseIndexSettings, parseReviewDb)

import Ipe.Db as Db exposing (DbFailure(..))
import Ipe.Db.Location as Location exposing (DbLocation, Mode(..))
import Ipe.Error as Error
import Ipe.File as File
import Ipe.List as List
import Ipe.Maybe as Maybe
import Ipe.Path as Path exposing (Path)
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task
import Lib.Epoch exposing (Epoch)
import Lib.RepoPath as RepoPath exposing (PathError, RootMap, Tag)
import Lib.ReviewKey exposing (ReviewKey)
import Lib.SafeText as SafeText exposing (SafeText)


-- The index database: the absolute file a refusal names, and the two typed
-- locations that open it. `read` (`ReadExisting`) lists and can never create
-- or modify the file; `write` (`WriteExisting`) drains and never creates it,
-- so a mistyped location fails instead of draining an empty new database.
-- Both are built once at startup, so no request re-derives either.
type alias IndexFile =
    { path : Path
    , read : DbLocation
    , write : DbLocation
    }


-- The review database: the absolute file a refusal names, and the typed
-- location that opens it, created on first open (`CreateIfMissing`) — the
-- app owns it.
type alias ReviewFile =
    { path : Path
    , open : DbLocation
    }


-- The index configuration, parsed from `IPE_INDEX_DB` and `IPE_INDEX_ROOT`.
type alias IndexSettings =
    { db : IndexFile
    , roots : RootMap
    }


-- Every location the app serves from: the index and the review database,
-- each parsed once at startup, the key that signs and verifies the review
-- log (or `ReadOnly` when none is set), read once at startup, and the epoch
-- of the process serving them, minted once at startup. A request reads this
-- value and never the environment. The key lives here and nowhere else: it
-- never enters the model, a session, a view or a log line.
type alias AppSettings =
    { index : IndexSettings
    , review : ReviewFile
    , key : ReviewKey
    , epoch : Epoch
    }


-- The repo tag `IPE_INDEX_ROOT` binds: `ipe`, the tag of ipe-index's default
-- `--repo ipe:.`. It is the only bound tag, so a unit stored under any other
-- tag is refused as `UnknownTag` rather than read from this root.
ipeTag : Result PathError Tag
ipeTag =
    RepoPath.parseTag "ipe"


-- The one boundary that turns the index environment's text into typed values.
-- `main` reads `IPE_INDEX_DB` and `IPE_INDEX_ROOT` once at startup and parses
-- them here, so a bad value stops the server before it listens. The value it
-- returns is the one every request reads: no request reads the environment or
-- checks the root again, so a request never serves a tree other than the one
-- startup validated.
parseIndexSettings : String -> String -> Task.Task Error IndexSettings
parseIndexSettings rawDb rawRoot =
    do
        db <- parseIndexDb rawDb
        root <- RepoPath.parseRoot rawRoot
        roots <- ipeTag
            |> Result.andThen (\tag -> RepoPath.rootMap [ ( tag, root ) ])
            |> Result.mapError RepoPath.toError
            |> Task.fromResult
        Task.succeed { db = db, roots = roots }


-- The index database from the raw `IPE_INDEX_DB` value.
parseIndexDb : String -> Task.Task Error IndexFile
parseIndexDb raw =
    do
        path <- parseDbFile "IPE_INDEX_DB" raw
        read <- dbLocation "IPE_INDEX_DB" ReadExisting path
        write <- dbLocation "IPE_INDEX_DB" WriteExisting path
        Task.succeed { path = path, read = read, write = write }


-- The review database from the raw `IPE_REVIEW_DB` value `main` reads once
-- at startup (`review.db` in the working directory when unset).
parseReviewDb : String -> Task.Task Error ReviewFile
parseReviewDb raw =
    do
        path <- parseDbFile "IPE_REVIEW_DB" raw
        open <- dbLocation "IPE_REVIEW_DB" CreateIfMissing path
        Task.succeed { path = path, open = open }


-- A database setting is a file path, absolute or relative to the working
-- directory, made absolute here. Blank is refused, and so is a URL or a
-- `sqlite:` or `file:` value, rather than read as a file of that name. Every
-- other byte is literal: the database layer never reads the name as URL
-- syntax. A refusal names the variable, never its value: a mistyped URL can
-- carry a password. Each refusal states its problem and exactly one fix.
parseDbFile : String -> String -> Task.Task Error Path
parseDbFile var raw =
    if String.trim raw == "" then
        Task.fail (Error.invalidInput (dbRefusal var "is empty" dbFix))

    else if String.contains "://" raw || String.startsWith "sqlite:" raw || String.startsWith "file:" raw then
        Task.fail (Error.invalidInput (dbRefusal var "is a URL, not a file path" dbFix))

    else
        RepoPath.absolutize raw
            |> Task.mapError (\_ -> Error.invalidInput (dbRefusal var "is not a valid file path" dbFix))
            |> Task.andThen (toDbFile var)


-- A cleaned absolute path names a database file unless it is the root
-- directory itself, which a `..` climbing past `/` cleans to and which can
-- never be a database file.
toDbFile : String -> Path -> Task.Task Error Path
toDbFile var path =
    if Path.toString path == "/" then
        Task.fail (Error.invalidInput (dbRefusal var "names the root directory, not a database file" dbFix))

    else
        Task.succeed path


-- `path` opened in `mode`. The database layer refuses a file name it cannot
-- open as written, such as one holding a `:`; that refusal is reported by
-- variable name, like every other.
dbLocation : String -> Mode -> Path -> Task.Task Error DbLocation
dbLocation var mode path =
    Location.file mode path
        |> Task.fromResult
        |> Task.mapError (\_ -> Error.invalidInput (dbRefusal var "is a file path the database cannot open as written, such as one holding a `:`" dbFix))


dbRefusal : String -> String -> String -> String
dbRefusal var problem fix =
    String.concat [ var, " ", problem, "; ", fix ]


-- The fix for a refusal whose problem names no more specific one.
dbFix : String
dbFix =
    "set it to the path of a SQLite database file"


-- The database a startup refusal is about, which names its variable and
-- picks the fix that fits it.
type DbRole
    = IndexDb
    | ReviewDb


-- Why a configured database cannot be used, decided once from the typed
-- `DbFailure` its open or startup probe failed with. The failure's message is
-- never read: only the cause it carries decides the case, and no driver text
-- or code is ever shown.
type DbRefusal
    = NoDatabaseFile
    | NotSqliteFile
    | Locked
    | NotPermitted
    | NotAFile
    | MissingSchema
    | Unusable


-- The refusal for a failed open or probe of a database file: whether a file is there
-- and the `DbFailure` the error carries decide the case. An error that
-- carries no `DbFailure` is `Unusable`, never a guess at a narrower case.
dbRefusalOf : Bool -> Error -> DbRefusal
dbRefusalOf present e =
    case e of
        Error _ info ->
            case info.details of
                Just (Database failure) ->
                    refusalOfFailure present failure

                Just (Custom _) ->
                    absentOr present Unusable

                Just (FfiPanic _) ->
                    absentOr present Unusable

                Just (HttpStatus _) ->
                    absentOr present Unusable

                Just (JsonDecode _) ->
                    absentOr present Unusable

                Just (TypeMismatch _) ->
                    absentOr present Unusable

                Nothing ->
                    absentOr present Unusable


-- Every `DbFailure` has its own row, so a cause the driver layer adds is a
-- compile error here until it is given a refusal. A cause this tool names no
-- narrower case for is `Unusable`.
refusalOfFailure : Bool -> DbFailure -> DbRefusal
refusalOfFailure present failure =
    case failure of
        CannotOpen ->
            absentOr present NotPermitted

        NotADatabase ->
            NotSqliteFile

        Busy ->
            Locked

        AccessDenied ->
            NotPermitted

        ReadOnlyDatabase ->
            NotPermitted

        InvalidStatement ->
            MissingSchema

        UniqueViolation ->
            absentOr present Unusable

        ForeignKeyViolation ->
            absentOr present Unusable

        NotNullViolation ->
            absentOr present Unusable

        CheckViolation ->
            absentOr present Unusable

        TriggerRaised ->
            absentOr present Unusable

        OtherConstraint ->
            absentOr present Unusable

        Unreachable ->
            absentOr present Unusable

        OtherFailure ->
            absentOr present Unusable


-- `NoDatabaseFile` when nothing is at the location, `fallback` when a file
-- is there.
absentOr : Bool -> DbRefusal -> DbRefusal
absentOr present fallback =
    if present then
        fallback

    else
        NoDatabaseFile


-- A parsed database file that failed to open or to pass its startup probe,
-- refused as one `DbRefusal`: the variable, the resolved file, the problem
-- and one fix, never the driver's own text or code. A parsed setting is a
-- plain file path (`parseDbFile` refuses a URL, which can carry
-- credentials), so naming it leaks no secret; it is still quoted, since it
-- came from the environment. A directory at the path is `NotAFile` whatever
-- the driver reported, since no access grant makes it a database.
openFailure : DbRole -> Path -> Error -> Task.Task Error a
openFailure role file e =
    locationRefusal file e
        |> Task.andThen (\refusal -> Task.fail (useRefusal role file (refusalProblem role refusal)))


locationRefusal : Path -> Error -> Task.Task Error DbRefusal
locationRefusal file e =
    File.isDir file
        |> Task.onError (\_ -> Task.succeed False)
        |> Task.andThen
            (\directory ->
                if directory then
                    Task.succeed NotAFile

                else
                    File.exists file
                        |> Task.onError (\_ -> Task.succeed True)
                        |> Task.map (\present -> dbRefusalOf present e)
            )


-- A migrated review file that opens and reads but whose log is broken: an
-- append-only trigger gone, or its head row missing. No change of access
-- repairs it, so the fix is a sound copy or a fresh log.
brokenLog : Path -> String -> Error
brokenLog file problem =
    useRefusal ReviewDb file ( problem, "restore it from a copy whose log is intact, or point IPE_REVIEW_DB at a new file to start a fresh log" )


useRefusal : DbRole -> Path -> ( String, String ) -> Error
useRefusal role file ( problem, fix ) =
    Error.invalidInput
        (SafeText.toString
            (SafeText.concat
                [ SafeText.literal (roleVar role)
                , SafeText.literal ": cannot use "
                , SafeText.quoted (Path.toString file)
                , SafeText.literal ": "
                , SafeText.literal problem
                , SafeText.literal "; "
                , SafeText.literal fix
                ]
            )
        )


roleVar : DbRole -> String
roleVar role =
    case role of
        IndexDb ->
            "IPE_INDEX_DB"

        ReviewDb ->
            "IPE_REVIEW_DB"


-- Each refusal's problem and its one fix, per database.
refusalProblem : DbRole -> DbRefusal -> ( String, String )
refusalProblem role refusal =
    case role of
        IndexDb ->
            case refusal of
                NoDatabaseFile ->
                    ( "no file is there", indexBuildFix )

                NotSqliteFile ->
                    ( "it is not a SQLite database, or it is damaged", indexBuildFix )

                Locked ->
                    ( "another process holds a lock on it", "let that process, such as an `ipe-index index` run, finish and start again" )

                NotPermitted ->
                    ( "this process may not open it", "grant read access to the file and its directory, or point IPE_INDEX_DB at a readable copy" )

                NotAFile ->
                    ( "it is a directory, not a database file", "point IPE_INDEX_DB at the index file itself, not the directory holding it" )

                MissingSchema ->
                    ( "it lacks a table, view or column this tool reads", indexBuildFix )

                Unusable ->
                    ( "it could not be opened or read", indexBuildFix )

        ReviewDb ->
            case refusal of
                NoDatabaseFile ->
                    ( "it cannot be created there", reviewWritableFix )

                NotSqliteFile ->
                    ( "it is not a SQLite database, or it is damaged", reviewLogFix )

                Locked ->
                    ( "another process holds a lock on it", "stop the other code-review server using it and start again" )

                NotPermitted ->
                    ( "this process may not write it", reviewWritableFix )

                NotAFile ->
                    ( "it is a directory, not a database file", "point IPE_REVIEW_DB at a file path, such as a `review.db` inside that directory" )

                MissingSchema ->
                    ( "its tables are not this tool's review log", reviewLogFix )

                Unusable ->
                    ( "it could not be opened, migrated or read", reviewWritableFix )


indexBuildFix : String
indexBuildFix =
    "build it from the repo root with `tools/scripts/ipe-index index`, or point IPE_INDEX_DB at an existing index"


reviewWritableFix : String
reviewWritableFix =
    "create its directory and grant this process write access, or point IPE_REVIEW_DB at a writable location"


reviewLogFix : String
reviewLogFix =
    "point IPE_REVIEW_DB at the review database this tool created, or at a new file to start a fresh log"


-- The database file's name without its directory, for display.
dbFileName : Path -> String
dbFileName path =
    Path.base path
