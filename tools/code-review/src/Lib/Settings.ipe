module Lib.Settings exposing (AppSettings, DbLocation, IndexSettings, dbFileName, encodeFilePath, indexReadUrl, indexWriteUrl, ipeTag, openFailure, parseDbLocation, parseIndexSettings, parseReviewDb, reviewUrl)

import Ipe.Encoding as Encoding
import Ipe.Error as Error
import Ipe.Path as Path exposing (Path)
import Ipe.Result as Result exposing (Result(..))
import Ipe.String as String
import Ipe.Task as Task
import Lib.RepoPath as RepoPath exposing (PathError, RootMap, Tag)
import Lib.SafeText as SafeText exposing (SafeText)


-- Where a SQLite database lives: an absolute file path. Every accepted
-- spelling of the setting — a plain path, relative or absolute, or a
-- `sqlite://` URL — is parsed into this one form, so no raw URL reaches the
-- driver and the open mode each URL builder appends is the only one it reads.
-- The path always starts with `/`, so the driver never takes it for a
-- `file:` URI or `:memory:`.
type DbLocation
    = DbFile Path


-- The index configuration, parsed from `IPE_INDEX_DB` and `IPE_INDEX_ROOT`.
type alias IndexSettings =
    { db : DbLocation
    , roots : RootMap
    }


-- Every location the app serves from: the index and the review database,
-- each parsed once at startup. A request reads this value and never the
-- environment.
type alias AppSettings =
    { index : IndexSettings
    , review : DbLocation
    }


-- The repo tag `IPE_INDEX_ROOT` binds: `ipe`, the tag of ipe-index's default
-- `--repo ipe:.`. It is the only bound tag, so a unit stored under any other
-- tag is refused as `UnknownTag` rather than read from this root.
ipeTag : Result PathError Tag
ipeTag =
    RepoPath.parseTag "ipe"


-- The one boundary that turns the index environment's text into typed values.
-- `main` reads `IPE_INDEX_DB` and `IPE_INDEX_ROOT` once at startup and parses
-- them here, so a bad value stops the server before it listens. The value it
-- returns is the one every request reads: no request reads the environment or
-- checks the root again, so a request never serves a tree other than the one
-- startup validated.
parseIndexSettings : String -> String -> Task.Task Error IndexSettings
parseIndexSettings rawDb rawRoot =
    do
        db <- parseDbLocation "IPE_INDEX_DB" rawDb
        root <- RepoPath.parseRoot rawRoot
        roots <- ipeTag
            |> Result.andThen (\tag -> RepoPath.rootMap [ ( tag, root ) ])
            |> Result.mapError RepoPath.toError
            |> Task.fromResult
        Task.succeed { db = db, roots = roots }


-- The review database location from the raw `IPE_REVIEW_DB` value `main`
-- reads once at startup (`review.db` in the working directory when unset).
parseReviewDb : String -> Task.Task Error DbLocation
parseReviewDb raw =
    parseDbLocation "IPE_REVIEW_DB" raw


-- A file path is refused when blank or when it carries `?`, `#` or `%` (each
-- changes meaning inside a URL), and is otherwise made absolute. A
-- `sqlite://` URL is parsed by `parseSqliteUrl`. Any other URL, and a
-- `sqlite:` or `file:` value without `//`, is refused rather than read as a
-- file of that name. A refusal names the variable, never its value: a
-- mistyped URL can carry a password. Each refusal states its problem and
-- exactly one fix.
parseDbLocation : String -> String -> Task.Task Error DbLocation
parseDbLocation var raw =
    if String.trim raw == "" then
        Task.fail (Error.invalidInput (dbRefusal var "is empty" dbFix))

    else if String.startsWith "sqlite://" raw then
        parseSqliteUrl var (String.dropLeft (String.length "sqlite://") raw)

    else if String.contains "://" raw then
        Task.fail (Error.invalidInput (dbRefusal var "is a URL that is not `sqlite://`" dbFix))

    else if String.startsWith "sqlite:" raw || String.startsWith "file:" raw then
        Task.fail (Error.invalidInput (dbRefusal var "is a `sqlite:` or `file:` value without `//`" "write `sqlite:///absolute/path` or a plain file path"))

    else if String.contains "?" raw || String.contains "#" raw || String.contains "%" raw then
        Task.fail (Error.invalidInput (dbRefusal var "is a file path containing `?`, `#` or `%`" "pass it as a percent-encoded `sqlite://` URL instead"))

    else
        RepoPath.absolutize raw
            |> Task.mapError (\_ -> Error.invalidInput (dbRefusal var "is not a valid file path" dbFix))
            |> Task.andThen (toDbFile var)


-- The part of a `sqlite://` URL after the scheme, percent-decoded (RFC 3986,
-- so a `+` stays a `+` and names the same file as the plain path) into an
-- absolute file path. Refused: a query or fragment (a query can set its own
-- `mode`, and the open mode is the app's to choose), a malformed escape, an
-- empty path, and any decoded path not starting with `/` — which covers
-- `:memory:`, a working-directory-relative name, a host, and a nested
-- `file:` or `sqlite:` URI whose own parameters would override the mode.
parseSqliteUrl : String -> String -> Task.Task Error DbLocation
parseSqliteUrl var encoded =
    if String.contains "?" encoded || String.contains "#" encoded then
        Task.fail (Error.invalidInput (dbRefusal var "is a `sqlite://` URL with a query or fragment" "drop it: the app sets the open mode"))

    else
        case Encoding.percentDecode encoded of
            Err _ ->
                Task.fail (Error.invalidInput (dbRefusal var "is a `sqlite://` URL with a malformed percent-escape" dbFix))

            Ok decoded ->
                if decoded == "" then
                    Task.fail (Error.invalidInput (dbRefusal var "is a `sqlite://` URL naming no database" dbFix))

                else if String.startsWith "/" decoded then
                    Path.fromString decoded
                        |> Task.fromResult
                        |> Task.mapError (\_ -> Error.invalidInput (dbRefusal var "is a `sqlite://` URL whose path is not a valid file path" dbFix))
                        |> Task.andThen (toDbFile var)

                else
                    Task.fail (Error.invalidInput (dbRefusal var "is a `sqlite://` URL whose path is not absolute" "write `sqlite:///absolute/path`"))


-- The one step both spellings end in: a cleaned absolute path becomes a
-- `DbLocation` unless it is the root directory itself, which a `..` climbing
-- past `/` cleans to and which can never be a database file.
toDbFile : String -> Path -> Task.Task Error DbLocation
toDbFile var path =
    if Path.toString path == "/" then
        Task.fail (Error.invalidInput (dbRefusal var "names the root directory, not a database file" dbFix))

    else
        Task.succeed (DbFile path)


dbRefusal : String -> String -> String -> String
dbRefusal var problem fix =
    String.concat [ var, " ", problem, "; ", fix ]


-- The fix for a refusal whose problem names no more specific one.
dbFix : String
dbFix =
    "set it to a SQLite file path or a `sqlite://` URL"


-- A parsed location that failed to open or to pass its startup probe: the
-- variable, the resolved file, the cause and one fix. A parsed location is a
-- plain absolute file path (`parseDbLocation` refuses a URL with a host,
-- credentials or a query), so naming it leaks no secret; it is still
-- rendered, since it came from the environment. `var` and `fix` are this
-- tool's own text.
openFailure : String -> SafeText -> DbLocation -> Error -> Error
openFailure var fix loc e =
    Error.withMessage
        (SafeText.toString
            (SafeText.concat
                [ SafeText.literal var
                , SafeText.literal ": cannot open "
                , SafeText.quoted (locationPath loc)
                , SafeText.literal " ("
                , SafeText.render (Error.message e)
                , SafeText.literal "); "
                , fix
                ]
            )
        )
        e


locationPath : DbLocation -> String
locationPath loc =
    case loc of
        DbFile path ->
            Path.toString path


-- The database file's name without its directory, for display.
dbFileName : DbLocation -> String
dbFileName loc =
    case loc of
        DbFile path ->
            Path.base path


-- The URL for `loc` opened in SQLite `mode`. The path is percent-encoded
-- (`%` first, then `?` and `#`), so a working directory holding any of them
-- still names the same file instead of starting a query or fragment or
-- decoding to another name.
urlWithMode : String -> DbLocation -> String
urlWithMode mode loc =
    case loc of
        DbFile path ->
            "sqlite://" ++ encodeFilePath (Path.toString path) ++ "?mode=" ++ mode


encodeFilePath : String -> String
encodeFilePath path =
    path
        |> String.replace "%" "%25"
        |> String.replace "?" "%3F"
        |> String.replace "#" "%23"


-- The index opened read-only (`mode=ro`), so listing can never create or
-- modify it.
indexReadUrl : DbLocation -> String
indexReadUrl loc =
    urlWithMode "ro" loc


-- The index opened read-write (`mode=rw`) for the drain step. `rw` never
-- creates the file, so a mistyped location fails instead of draining an empty
-- new database.
indexWriteUrl : DbLocation -> String
indexWriteUrl loc =
    urlWithMode "rw" loc


-- The review database, created on first open (`mode=rwc`) — the app owns it.
reviewUrl : DbLocation -> String
reviewUrl loc =
    urlWithMode "rwc" loc
